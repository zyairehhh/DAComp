Action: CreateFile(filepath='analysis2.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-098.sqlite')
# Load conversations with all needed fields
query = '''
SELECT 
    c.conversation_id,
    c.conversation_created_at as initiated_at,
    m.first_admin_response_at as first_response_at,
    m.conversation_initiated_type as responder_type,
    c.all_conversation_tags as tags,
    m.time_to_first_response_minutes as resp_minutes,
    m.time_to_first_close_minutes as close_minutes,
    m.time_to_admin_first_close_minutes as admin_close_minutes,
    c.first_close_at,
    c.last_close_at,
    c.conversation_subject,
    c.conversation_rating,
    c.all_conversation_contacts as contact_id,
    m.first_contact_reply_at,
    m.first_assignment_at,
    m.count_total_parts,
    m.count_assignments
FROM intercom__conversation_enhanced c
JOIN intercom__conversation_metrics m ON c.conversation_id = m.conversation_id
'''
df = pd.read_sql(query, conn)
print(f"Total conversations: {len(df)}")
# Parse tags
def extract_tag(tags, key):
    if pd.isna(tags):
        return None
    import re
    match = re.search(rf'{key}:([^|]+)', tags)
    return match.group(1) if match else None

for key in ['intent', 'topic', 'stage', 'segment', 'region', 'lifecycle']:
    df[key] = df['tags'].apply(lambda x: extract_tag(x, key))

# Segment by responder_type
human = df[df['responder_type'] == 'human_first']
bot = df[df['responder_type'] == 'bot_first']
print(f"Human first: {len(human)} ({len(human)/len(df):.2%})")
print(f"Bot first: {len(bot)} ({len(bot)/len(df):.2%})")

# Define funnel stages
# We'll treat each conversation's stage as its final stage.
# Compute conversion rates for each stage
stages = ['demo_booked', 'trial_started', 'trial_activated', 'closed_won', 'expansion_in_flight', 'contacted', 'marketing_qualified', 'proposal_sent']
for stage in stages:
    total_h = len(human)
    conv_h = len(human[human['stage'] == stage])
    rate_h = conv_h / total_h if total_h > 0 else 0
    total_b = len(bot)
    conv_b = len(bot[bot['stage'] == stage])
    rate_b = conv_b / total_b if total_b > 0 else 0
    print(f"{stage}: Human {conv_h}/{total_h} ({rate_h:.3f}) | Bot {conv_b}/{total_b} ({rate_b:.3f})")

# Conditional conversion (contact-level)
# Group by contact_id
def agg_contact(g):
    # decide responder_type: if any conversation bot_first, maybe label as bot-first contact? We'll use first conversation's responder_type.
    return pd.Series({
        'conversation_count': len(g),
        'responder_type': g['responder_type'].iloc[0],
        'stages': list(g['stage'].dropna()),
        'intents': list(g['intent'].dropna()),
        'topics': list(g['topic'].dropna()),
        'region': g['region'].iloc[0] if not pd.isna(g['region'].iloc[0]) else None,
        'segment': g['segment'].iloc[0] if not pd.isna(g['segment'].iloc[0]) else None,
        'lifecycle': g['lifecycle'].iloc[0] if not pd.isna(g['lifecycle'].iloc[0]) else None,
        'demo_booked': 'demo_booked' in g['stage'].values,
        'trial_activated': 'trial_activated' in g['stage'].values,
        'closed_won': 'closed_won' in g['stage'].values
    })

contacts = df.groupby('contact_id').apply(agg_contact).reset_index()
print(f"Unique contacts: {len(contacts)}")

# Conversion rates per contact
human_contacts = contacts[contacts['responder_type'] == 'human_first']
bot_contacts = contacts[contacts['responder_type'] == 'bot_first']
print(f"Human contacts: {len(human_contacts)}")
print(f"Bot contacts: {len(bot_contacts)}")

for metric in ['demo_booked', 'trial_activated', 'closed_won']:
    h_rate = human_contacts[metric].mean()
    b_rate = bot_contacts[metric].mean()
