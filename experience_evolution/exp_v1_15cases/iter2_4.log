ts_quality_data['conversion_ma'] = ts_quality_data['store_listing_conversion_rate'].rolling(window=7).mean()
ts_quality_data['crash_rate_ma'] = ts_quality_data['crash_rate_per_1k'].rolling(window=7).mean()
ts_quality_data['quality_ma'] = ts_quality_data['quality_score'].rolling(window=7).mean()

# Only plot complete data
