```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-022.sqlite')

# Analyze cancellation patterns by vehicle type
query_cancellations = """
SELECT 
    "Vehicle Type",
    COUNT(*) as total_rides,
    SUM(CASE WHEN "Booking Status" = 'Cancelled by Driver' THEN 1 ELSE 0 END) as driver_cancelled,
    SUM(CASE WHEN "Booking Status" = 'Cancelled by Customer' THEN 1 ELSE 0 END) as customer_cancelled,
    SUM(CASE WHEN "Booking Status" = 'Incomplete' THEN 1 ELSE 0 END) as incomplete,
    SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) as completed
FROM sheet1 
WHERE "Vehicle Type" IS NOT NULL
GROUP BY "Vehicle Type"
ORDER BY total_rides DESC
"""

df_cancellations = pd.read_sql_query(query_cancellations, conn)

# Calculate percentages
df_cancellations['driver_cancel_rate'] = df_cancellations['driver_cancelled'] / df_cancellations['total_rides'] * 100
df_cancellations['customer_cancel_rate'] = df_cancellations['customer_cancelled'] / df_cancellations['total_rides'] * 100
df_cancellations['incomplete_rate'] = df_cancellations['incomplete'] / df_cancellations['total_rides'] * 100
df_cancellations['completion_rate'] = df_cancellations['completed'] / df_cancellations['total_rides'] * 100

# Create stacked bar chart for completion rates
plt.figure(figsize=(12, 7))

vehicle_types = df_cancellations['Vehicle Type']
indices = np.arange(len(vehicle_types))
width = 0.6

p1 = plt.bar(indices, df_cancellations['completion_rate'], width, label='Completed', color='green', alpha=0.7)
p2 = plt.bar(indices, df_cancellations['incomplete_rate'], width, bottom=df_cancellations['completion_rate'],
            label='Incomplete', color='orange', alpha=0.7)
p3 = plt.bar(indices, df_cancellations['customer_cancel_rate'], width, 
            bottom=df_cancellations['completion_rate'] + df_cancellations['incomplete_rate'],
            label='Cancelled by Customer', color='red', alpha=0.7)
p4 = plt.bar(indices, df_cancellations['driver_cancel_rate'], width,
            bottom=df_cancellations['completion_rate'] + df_cancellations['incomplete_rate'] + df_cancellations['customer_cancel_rate'],
            label='Cancelled by Driver', color='purple', alpha=0.7)

plt.xlabel('Vehicle Type')
plt.ylabel('Percentage of Total Rides (%)')
plt.title('Ride Status Distribution by Vehicle Type')
plt.xticks(indices, vehicle_types, rotation=45, ha='right')
plt.legend(loc='upper right')
plt.grid(True, alpha=0.3, axis='y')

# Add total count labels on top
for i, total in enumerate(df_cancellations['total_rides']):
    plt.text(i, 102, f'n={total:,}', ha='center', va='bottom', fontsize=8)

plt.tight_layout()
plt.savefig('cancellation_rates_by_vehicle.png', dpi=150, bbox_inches='tight')
plt.close()

# Analyze fare distribution by rating ranges
query_rating_fare = """
SELECT 
    CASE 
        WHEN "Driver Ratings" >= 4.5 THEN '4.5-5.0 (Excellent)'
        WHEN "Driver Ratings" >= 4.0 THEN '4.0-4.5 (Very Good)'
        WHEN "Driver Ratings" >= 3.5 THEN '3.5-4.0 (Good)'
        WHEN "Driver Ratings" >= 3.0 THEN '3.0-3.5 (Fair)'
        ELSE 'Below 3.0 (Poor)'
    END as rating_group,
    "Vehicle Type",
    AVG("Booking Value"/"Ride Distance") as avg_fare_per_km,
    COUNT(*) as ride_count
FROM sheet1 
WHERE "Booking Status" = 'Completed' 
    AND "Booking Value" IS NOT NULL 
    AND "Ride Distance" IS NOT NULL 
    AND "Ride Distance" > 0
    AND "Driver Ratings" IS NOT NULL
GROUP BY rating_group, "Vehicle Type"
HAVING ride_count > 50
ORDER BY rating_group, avg_fare_per_km DESC
"""

df_rating_fare = pd.read_sql_query(query_rating_fare, conn)

# Create grouped bar chart
rating_groups = sorted(df_rating_fare['rating_group'].unique())
vehicle_types_order = df_rating_fare['Vehicle Type'].unique()
n_groups = len(rating_groups)
n_vehicles = len(vehicle_types_order)

fig, ax = plt.subplots(figsize=(14, 7))
bar_width = 0.8 / n_vehicles
index = np.arange(n_groups)

colors = plt.cm.Set3(np.linspace(0, 1, n_vehicles))

for i, vehicle in enumerate(vehicle_types_order):
    vehicle_data = df_rating_fare[df_rating_fare['Vehicle Type'] == vehicle]
    values = []
    for group in rating_groups:
        group_data = vehicle_data[vehicle_data['rating_group'] == group]
        if not group_data.empty:
            values.append(group_data['avg_fare_per_km'].values[0])
        else:
            values.append(0)
    
    ax.bar(index + i * bar_width, values, bar_width, label=vehicle, color=colors[i])

ax.set_xlabel('Driver Rating Group')
ax.set_ylabel('Average Fare per KM (currency units)')
ax.set_title('Fare per KM by Driver Rating Group and Vehicle Type')
ax.set_xticks(index + bar_width * (n_vehicles - 1) / 2)
ax.set_xticklabels(rating_groups, rotation=45, ha='right')
ax.legend(title='Vehicle Type', bbox_to_anchor=(1.05, 1), loc='upper left')
ax.grid(True, alpha=0.3, axis='y')

plt.tight_layout()
plt.savefig('fare_by_rating_group.png', dpi=150, bbox_inches='tight')
plt.close()

conn.close()
print("Plots saved as 'cancellation_rates_by_vehicle.png' and 'fare_by_rating_group.png'")
```
