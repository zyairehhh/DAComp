'''
import sqlite3
import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import r2_score, mean_squared_error
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-070.sqlite')

# Load region-level daily data
region_daily = pd.read_sql_query("""
    SELECT date_day, package_name, region, 
           store_listing_conversion_rate as conv_rate,
           active_devices_last_30_days as region_active_devices,
           average_rating as region_avg_rating,
           rolling_total_average_rating as region_rolling_rating,
           update_events as region_updates
    FROM google_play__country_report
""", conn)
region_daily['date_day'] = pd.to_datetime(region_daily['date_day'])

# Load device-level daily data aggregated across devices per day per package
device_daily = pd.read_sql_query("""
    SELECT date_day, package_name,
           SUM(device_installs) as total_device_installs,
           SUM(device_uninstalls) as total_device_uninstalls,
           SUM(device_upgrades) as total_device_upgrades,
           AVG(average_rating) as avg_device_rating,
           AVG(rolling_total_average_rating) as avg_device_rolling_rating,
           SUM(update_events) as total_device_updates
    FROM google_play__device_report
    GROUP BY date_day, package_name
""", conn)
device_daily['date_day'] = pd.to_datetime(device_daily['date_day'])

# Load global trends
trends_daily = pd.read_sql_query("""
    SELECT date_day, package_name, 
           quality_score, crash_rate_per_1k as crash_rate,
           revenue_per_active_device as rev_per_device,
           daily_installs, daily_revenue, active_devices
    FROM google_play__time_series_trends
""", conn)
trends_daily['date_day'] = pd.to_datetime(trends_daily['date_day'])

# Merge region with trends (global)
df = pd.merge(region_daily, trends_daily, on=['date_day', 'package_name'], how='inner')
# Merge with aggregated device metrics
df = pd.merge(df, device_daily, on=['date_day', 'package_name'], how='inner')

print("Combined dataset shape:", df.shape)
print(df.head())

# Compute market maturity: days since start of data (April 1, 2024)
df['days_since_start'] = (df['date_day'] - pd.Timestamp('2024-04-01')).dt.days
df['month'] = df['date_day'].dt.month  # 4 to 10

# Define user value decay model: predict revenue_per_active_device
# Features: region, conv_rate, region_updates, region_active_devices, region_avg_rating,
#           total_device_installs, total_device_upgrades, quality_score, crash_rate, days_since_start
# Encode region as dummy variables
df = pd.get_dummies(df, columns=['region'], drop_first=True)

# Prepare X and y
X = df[['conv_rate', 'region_updates', 'region_active_devices', 'region_avg_rating',
        'total_device_installs', 'total_device_upgrades', 'quality_score', 'crash_rate',
        'days_since_start', 'region_Europe', 'region_North America', 'region_South America']]
y = df['rev_per_device']

# Remove any rows with NaN
mask = ~X.isna().any(axis=1) & ~y.isna()
X = X[mask]
y = y[mask]

print(f"Sample size after cleaning: {X.shape[0]}")

# Split into training and testing (chronological split: first 80% days)
sorted_indices = df[mask].sort_values('days_since_start').index
train_size = int(0.8 * len(sorted_indices))
train_idx = sorted_indices[:train_size]
test_idx = sorted_indices[train_size:]

X_train, X_test = X.loc[train_idx], X.loc[test_idx]
y_train, y_test = y.loc[train_idx], y.loc[test_idx]

print(f"Train size: {X_train.shape[0]}, Test size: {X_test.shape[0]}")

# Linear regression
lr = LinearRegression()
lr.fit(X_train, y_train)
y_pred = lr.predict(X_test)

r2 = r2_score(y_test, y_pred)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
print("\nLinear Regression Results:")
print(f"R-squared: {r2:.4f}")
print(f"RMSE: {rmse:.6f}")
print("Coefficients:")
for col, coef in zip(X.columns, lr.coef_):
    print(f"  {col}: {coef:.6f}")
print(f"Intercept: {lr.intercept_:.6f}")

# Feature importance (absolute coefficients)
importance = pd.DataFrame({'feature': X.columns, 'coef_abs': np.abs(lr.coef_)})
importance = importance.sort_values('coef_abs', ascending=False)
print("\nFeature Importance (absolute coefficients):")
print(importance)

# Decay analysis: compute revenue_per_active_device trend over time per region
# We'll compute average revenue per device per month per region (though revenue is global)
# But we can still group by region and month to see if there's variation due to region dummy.
region_monthly_rev = df.groupby(['region_Asia', 'region_Europe', 'region_North America', 'region_South America', 'month']).agg({
    'rev_per_device': 'mean',
    'conv_rate': 'mean',
    'quality_score': 'mean',
    'crash_rate': 'mean'
}).reset_index()
print("\nSample region-month revenue averages:")
print(region_monthly_rev.head(20))

# Interaction effect of update frequency on active_devices_last_30_days and rolling_total_average_rating
# Use device-level data aggregated per day per package
device_df = pd.read_sql_query("""
    SELECT d.date_day, d.package_name, d.device,
           d.active_devices_last_30_days as active_devices,
           d.rolling_total_average_rating as rolling_rating,
           d.update_events as device_updates,
           t.quality_score, t.crash_rate_per_1k
    FROM google_play__device_report d
    JOIN google_play__time_series_trends t
    ON d.date_day = t.date_day AND d.package_name = t.package_name
""", conn)
device_df['date_day'] = pd.to_datetime(device_df['date_day'])
device_df['month'] = device_df['date_day'].dt.month

# Aggregate update events per month per device to get update frequency
device_monthly = device_df.groupby(['device', 'month']).agg({
    'device_updates': 'sum',
    'active_devices': 'mean',
    'rolling_rating': 'mean',
    'quality_score': 'mean',
    'crash_rate_per_1k': 'mean'
}).reset_index()
print("\nDevice-month aggregated stats:")
print(device_monthly.head())

# Compute correlation between update frequency (device_updates) and active_devices, rolling_rating
corr_active = device_monthly['device_updates'].corr(device_monthly['active_devices'])
corr_rating = device_monthly['device_updates'].corr(device_monthly['rolling_rating'])
print(f"\nCorrelation between update frequency and active_devices: {corr_active:.4f}")
print(f"Correlation between update frequency and rolling_rating: {corr_rating:.4f}")

# Also compute by device category (maybe grouping)
conn.close()
''')
