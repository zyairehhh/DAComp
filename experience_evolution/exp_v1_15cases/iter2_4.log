ax.set_title('Average Sales by Discount Depth Range', fontsize=16)
ax.set_xticks(x)
ax.set_xticklabels(binned_stats['discount_bin'])

# Add value labels
for i, v in enumerate(binned_stats['avg_sales']):
    ax.text(i, v + max(binned_stats['avg_sales'])*0.01, f'{v:.1f}', ha='center', va='bottom', fontsize=11)

# Add promotion count as secondary axis
