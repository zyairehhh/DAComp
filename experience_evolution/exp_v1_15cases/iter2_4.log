import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
from matplotlib import cm

# Set style
plt.style.use('seaborn-v0_8-whitegrid')

# Connect to the database
conn = sqlite3.connect('dacomp-034.sqlite')

# Read the data
promotions_df = pd.read_sql_query("SELECT * FROM attachment_3", conn)
categories_df = pd.read_sql_query("SELECT * FROM attachment_4", conn)

# Filter for single-item direct price reduction promotions (type 4)
promo_type_4 = promotions_df[promotions_df['promotion_type'] == 4].copy()

# Calculate discount depth
promo_type_4['discount_depth'] = (promo_type_4['pdj_price'] - promo_type_4['promotion_price']) / promo_type_4['pdj_price'] * 100

# Remove any invalid rows
promo_type_4 = promo_type_4.dropna(subset=['discount_depth', 'sale_count', 'pdj_price', 'promotion_price', 'sku_id'])

# Convert sku_id to integer for merging
promo_type_4['sku_id_int'] = promo_type_4['sku_id'].apply(lambda x: int(float(x)) if pd.notna(x) else None)
categories_df['sku_id_int'] = categories_df['sku_id'].astype(int)

# Merge with category data
merged_df = pd.merge(promo_type_4, categories_df, left_on='sku_id_int', right_on='sku_id_int', how='left')

print(f"Total promotions: {len(promo_type_4)}")
print(f"Promotions with category data: {len(merged_df[merged_df['Level 1 Category Name'].notna()])}")
print(f"Average discount depth: {merged_df['discount_depth'].mean():.2f}%")
print(f"Average sales per promotion: {merged_df['sale_count'].mean():.1f} units")

# Create visualizations

# 1. Scatter plot: Discount depth vs Sales (overall) - with correlation
fig, ax = plt.subplots(figsize=(12, 8))
scatter = ax.scatter(merged_df['discount_depth'], merged_df['sale_count'], 
                     alpha=0.5, s=20, c='steelblue', edgecolors='k', linewidth=0.3)
ax.set_xlabel('Discount Depth (%)', fontsize=14)
ax.set_ylabel('Units Sold During Promotion', fontsize=14)
ax.set_title('Discount Depth vs Sales for Single-Item Direct Price Reduction Promotions', fontsize=16)
ax.grid(True, alpha=0.3)

# Add a regression line
z = np.polyfit(merged_df['discount_depth'], merged_df['sale_count'], 1)
p = np.poly1d(z)
x_range = np.linspace(merged_df['discount_depth'].min(), merged_df['discount_depth'].max(), 100)
ax.plot(x_range, p(x_range), "r-", linewidth=2, label=f'Linear trend (slope={z[0]:.2f})')

# Calculate correlation
correlation = merged_df['discount_depth'].corr(merged_df['sale_count'])
ax.text(0.02, 0.98, f'Correlation: {correlation:.3f}', transform=ax.transAxes, 
        fontsize=12, verticalalignment='top', bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))

ax.legend(loc='upper right')
plt.savefig('discount_vs_sales_scatter.png', dpi=300, bbox_inches='tight')
plt.close()

# 2. Discount depth distribution histogram with statistics
fig, ax = plt.subplots(figsize=(12, 8))
n, bins, patches = ax.hist(merged_df['discount_depth'], bins=30, alpha=0.7, color='steelblue', edgecolor='black')
ax.set_xlabel('Discount Depth (%)', fontsize=14)
ax.set_ylabel('Number of Promotions', fontsize=14)
ax.set_title('Distribution of Discount Depth for Single-Item Direct Price Reduction Promotions', fontsize=16)
ax.grid(True, alpha=0.3)

# Add statistics
mean_depth = merged_df['discount_depth'].mean()
median_depth = merged_df['discount_depth'].median()
std_depth = merged_df['discount_depth'].std()

ax.axvline(mean_depth, color='red', linestyle='--', linewidth=2, label=f'Mean: {mean_depth:.1f}%')
ax.axvline(median_depth, color='green', linestyle='--', linewidth=2, label=f'Median: {median_depth:.1f}%')

# Add text box with statistics
stats_text = f'Statistics:\\nMean: {mean_depth:.1f}%\\nMedian: {median_depth:.1f}%\\nStd Dev: {std_depth:.1f}%\\nMin: {merged_df["discount_depth"].min():.1f}%\\nMax: {merged_df["discount_depth"].max():.1f}%'
ax.text(0.98, 0.98, stats_text, transform=ax.transAxes, fontsize=10, 
        verticalalignment='top', horizontalalignment='right',
        bbox=dict(boxstyle='round', facecolor='lightgray', alpha=0.8))

ax.legend(loc='upper left')
plt.savefig('discount_depth_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# 3. Analyze by Level 1 Category (only for rows with category data)
category_df = merged_df[merged_df['Level 1 Category Name'].notna()].copy()

# Get top categories by promotion count
category_counts = category_df['Level 1 Category Name'].value_counts()
top_categories = category_counts.head(10).index.tolist()
top_cat_df = category_df[category_df['Level 1 Category Name'].isin(top_categories)].copy()

print(f"\\nTop 10 Level 1 Categories by promotion count:")
for i, (cat, count) in enumerate(category_counts.head(10).items(), 1):
    print(f"{i}. {cat}: {count} promotions")

# 4. Boxplot of discount depth by category (top 10)
fig, ax = plt.subplots(figsize=(14, 10))
boxplot_data = [top_cat_df[top_cat_df['Level 1 Category Name'] == cat]['discount_depth'].values 
                for cat in top_categories]

positions = range(1, len(top_categories) + 1)
box = ax.boxplot(boxplot_data, positions=positions, patch_artist=True, tick_labels=top_categories)

# Color the boxes
