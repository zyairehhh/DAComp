GROUP BY tps.source_name, ae.candidate_gender
""", conn)

# Pivot
gender_pivot = gender.pivot_table(index='source_name', columns='candidate_gender', values='hires', aggfunc='sum', fill_value=0)
gender_pivot['total_hires'] = gender_pivot.sum(axis=1)
gender_pivot = gender_pivot.reset_index()
gender_pivot['Female_pct'] = gender_pivot['Female'] / gender_pivot['total_hires'] * 100
gender_pivot['Male_pct'] = gender_pivot['Male'] / gender_pivot['total_hires'] * 100

# Race distribution
race = pd.read_sql_query("""
SELECT tps.source_name,
       CASE WHEN ae.candidate_race != 'White' AND ae.candidate_race IS NOT NULL THEN 'Non-white' ELSE 'White' END as race_group,
       COUNT(DISTINCT cs.candidate_id) as hires
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
GROUP BY tps.source_name, race_group
""", conn)
race_pivot = race.pivot_table(index='source_name', columns='race_group', values='hires', aggfunc='sum', fill_value=0)
race_pivot['total_hires'] = race_pivot.sum(axis=1)
race_pivot = race_pivot.reset_index()
race_pivot['Non_white_pct'] = race_pivot['Non-white'] / race_pivot['total_hires'] * 100

# Merge
metrics = gender_pivot[['source_name','total_hires','Female_pct','Male_pct']].merge(
    race_pivot[['source_name','Non_white_pct']], on='source_name', how='outer'
)
print("Historical diversity per source (based on hires):")
print(metrics.to_string(index=False))

# Now simulate using suggested allocation from source_ranking.py
# (load suggested_hires)
source_rank = pd.read_csv('source_ranking_output.csv')  # need to create that
