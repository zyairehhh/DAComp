    ax1.set_xlabel('Date')
    ax1.set_ylabel('Count')
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    ax1.tick_params(axis='x', rotation=45)
    
    # Efficiency ratio
    ax2.plot(df1_recent['date_day'], df1_recent['install_to_uninstall_ratio'], 'b-', linewidth=2)
    ax2.axhline(y=df1_recent['install_to_uninstall_ratio'].mean(), color='r', linestyle='--', 
                label=f'Mean: {df1_recent["install_to_uninstall_ratio"].mean():.2f}')
    ax2.set_title('Install-to-Uninstall Ratio (Acquisition Efficiency)')
    ax2.set_xlabel('Date')
    ax2.set_ylabel('Ratio')
    ax2.legend()
    ax2.grid(True, alpha=0.3)
    ax2.tick_params(axis='x', rotation=45)
    
    plt.tight_layout()
    plt.savefig('acquisition_efficiency.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created: acquisition_efficiency.png")

# 2. Quality vs Conversion analysis
query2 = """
SELECT 
    t.date_day,
    t.quality_score,
    t.crash_rate_per_1k,
    AVG(c.store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__time_series_trends t
LEFT JOIN google_play__country_report c ON t.date_day = c.date_day
WHERE t.quality_score > 0 AND c.store_listing_conversion_rate > 0
GROUP BY t.date_day, t.quality_score, t.crash_rate_per_1k
"""

df2 = pd.read_sql_query(query2, conn)
if len(df2) > 0:
    df2['date_day'] = pd.to_datetime(df2['date_day'])
    
    # Calculate moving averages
    df2['conversion_ma'] = df2['avg_conversion_rate'].rolling(window=7).mean()
    df2['quality_ma'] = df2['quality_score'].rolling(window=7).mean()
    df2['crash_ma'] = df2['crash_rate_per_1k'].rolling(window=7).mean()
    
    fig2, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))
    
    # Quality vs Conversion
    ax1.plot(df2['date_day'], df2['conversion_ma'], 'b-', label='Conversion Rate (7d MA)', alpha=0.8)
    ax1.set_xlabel('Date')
    ax1.set_ylabel('Conversion Rate', color='b')
    ax1.tick_params(axis='y', labelcolor='b')
    
    ax1b = ax1.twinx()
    ax1b.plot(df2['date_day'], df2['quality_ma'], 'g-', label='Quality Score (7d MA)', alpha=0.8)
    ax1b.set_ylabel('Quality Score', color='g')
    ax1b.tick_params(axis='y', labelcolor='g')
    
    ax1.set_title('Conversion Rate vs Quality Score Correlation')
    ax1.grid(True, alpha=0.3)
    ax1.tick_params(axis='x', rotation=45)
    
    # Crash vs Conversion
    ax2.plot(df2['date_day'], df2['conversion_ma'], 'b-', label='Conversion Rate (7d MA)', alpha=0.8)
    ax2.set_xlabel('Date')
    ax2.set_ylabel('Conversion Rate', color='b')
    ax2.tick_params(axis='y', labelcolor='b')
    
    ax2b = ax2.twinx()
    ax2b.plot(df2['date_day'], df2['crash_ma'], 'r-', label='Crash Rate (7d MA)', alpha=0.8)
    ax2b.set_ylabel('Crash Rate per 1k', color='r')
    ax2b.tick_params(axis='y', labelcolor='r')
    
    ax2.set_title('Conversion Rate vs Crash Rate Correlation')
    ax2.grid(True, alpha=0.3)
    ax2.tick_params(axis='x', rotation=45)
    
    plt.tight_layout()
    plt.savefig('quality_vs_conversion.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created: quality_vs_conversion.png")

# 3. Region-Device multi-dimensional analysis
query3 = """
SELECT 
    c.region,
    c.store_listing_conversion_rate,
    c.active_devices_last_30_days,
    c.rolling_total_average_rating
FROM google_play__country_report c
WHERE c.date_day >= '2024-09-01'  # Last ~1.5 months
"""

df3 = pd.read_sql_query(query3, conn)
if len(df3) > 0:
    # Get top regions by active devices
    region_summary = df3.groupby('region').agg({
        'store_listing_conversion_rate': 'mean',
        'active_devices_last_30_days': 'sum',
        'rolling_total_average_rating': 'mean'
    }).reset_index()
    
    # Sort and get top 5 regions
    top_regions = region_summary.nlargest(5, 'active_devices_last_30_days')
    
    fig3, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))
    
    # Bar chart: Conversion rate by region
    x = np.arange(len(top_regions))
    width = 0.35
    
    bars1 = ax1.bar(x - width/2, top_regions['active_devices_last_30_days'], width, 
                   label='Active Devices', color='skyblue', alpha=0.8)
    ax1.set_xlabel('Region')
    ax1.set_ylabel('Active Devices (30 days)', color='skyblue')
    ax1.tick_params(axis='x', rotation=45)
    ax1.set_xticks(x)
    ax1.set_xticklabels(top_regions['region'])
    
    ax1b = ax1.twinx()
    bars2 = ax1b.bar(x + width/2, top_regions['store_listing_conversion_rate'], width,
                    label='Conversion Rate', color='orange', alpha=0.8)
    ax1b.set_ylabel('Conversion Rate', color='orange')
    
    ax1.set_title('Top Regions: Active Devices vs Conversion Rate')
    ax1.grid(True, alpha=0.3, axis='y')
    
    # Scatter: Conversion vs Rating
    scatter = ax2.scatter(top_regions['store_listing_conversion_rate'],
                         top_regions['rolling_total_average_rating'],
                         s=top_regions['active_devices_last_30_days']/100,
                         alpha=0.7,
                         c=top_regions['active_devices_last_30_days'],
                         cmap='viridis',
                         edgecolors='black')
    
    ax2.set_xlabel('Conversion Rate')
    ax2.set_ylabel('Average Rating')
    ax2.set_title('Conversion Rate vs Average Rating (Size = Active Devices)')
    ax2.grid(True, alpha=0.3)
    
    # Add region labels
    for i, row in top_regions.iterrows():
        ax2.annotate(row['region'], 
                    (row['store_listing_conversion_rate'], row['rolling_total_average_rating']),
                    xytext=(5, 5), textcoords='offset points', fontsize=9)
    
    plt.colorbar(scatter, ax=ax2, label='Active Devices')
    plt.tight_layout()
    plt.savefig('region_analysis.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created: region_analysis.png")

# 4. Update frequency analysis
query4 = """
SELECT 
    d.update_events,
    d.active_devices_last_30_days,
    d.rolling_total_average_rating
FROM google_play__device_report d
WHERE d.update_events > 0 AND d.active_devices_last_30_days > 0
"""

df4 = pd.read_sql_query(query4, conn)
if len(df4) > 0:
    # Create update frequency tiers
    df4['update_tier'] = pd.qcut(df4['update_events'], 4, 
                                 labels=['Very Low', 'Low', 'High', 'Very High'])
    
    tier_summary = df4.groupby('update_tier').agg({
        'active_devices_last_30_days': 'mean',
        'rolling_total_average_rating': 'mean'
    }).reset_index()
    
    fig4, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
    
    # Bar chart: Metrics by update tier
    x = np.arange(len(tier_summary))
    width = 0.35
    
    bars1 = ax1.bar(x - width/2, tier_summary['active_devices_last_30_days'], width,
                   color='lightblue', edgecolor='black', alpha=0.8)
    ax1.set_xlabel('Update Frequency Tier')
    ax1.set_ylabel('Avg Active Devices (30 days)')
    ax1.set_xticks(x)
    ax1.set_xticklabels(tier_summary['update_tier'])
    ax1.set_title('Active Devices by Update Frequency')
    ax1.grid(True, alpha=0.3, axis='y')
    
    # Add value labels
    for bar in bars1:
        height = bar.get_height()
        ax1.text(bar.get_x() + bar.get_width()/2., height,
                f'{height:,.0f}', ha='center', va='bottom', fontsize=9)
    
    bars2 = ax2.bar(x - width/2, tier_summary['rolling_total_average_rating'], width,
                   color='salmon', edgecolor='black', alpha=0.8)
    ax2.set_xlabel('Update Frequency Tier')
    ax2.set_ylabel('Avg Rating')
    ax2.set_xticks(x)
    ax2.set_xticklabels(tier_summary['update_tier'])
    ax2.set_title('Average Rating by Update Frequency')
    ax2.grid(True, alpha=0.3, axis='y')
    
    # Add value labels
    for bar in bars2:
        height = bar.get_height()
        ax2.text(bar.get_x() + bar.get_width()/2., height,
                f'{height:.2f}', ha='center', va='bottom', fontsize=9)
    
    plt.tight_layout()
    plt.savefig('update_impact.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created: update_impact.png")

# Close connection
conn.close()
print("All visualizations created successfully!")
