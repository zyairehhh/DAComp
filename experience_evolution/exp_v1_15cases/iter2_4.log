'''
import pandas as pd

# Load filtered campaign IDs and months
df_filtered = pd.read_csv('filtered_campaigns.csv', usecols=['campaign_id', 'year_month'])
# Ensure year_month is string
df_filtered['year_month'] = df_filtered['year_month'].astype(str)

# Load geo report
db_path = 'dacomp-058.sqlite'
import sqlite3
conn = sqlite3.connect(db_path)
df_geo = pd.read_sql_query("SELECT * FROM google_ads__geo_report", conn)
df_geo['year_month'] = df_geo['year_month'].astype(str)
# Merge with filtered
df_geo_filtered = pd.merge(df_geo, df_filtered, on=['campaign_id', 'year_month'], how='inner')
print("Geo rows after filtering:", df_geo_filtered.shape[0])

# Load device report
df_device = pd.read_sql_query("SELECT * FROM google_ads__device_report", conn)
df_device['year_month'] = df_device['year_month'].astype(str)
df_device_filtered = pd.merge(df_device, df_filtered, on=['campaign_id', 'year_month'], how='inner')
print("Device rows after filtering:", df_device_filtered.shape[0])
conn.close()

# Aggregate per geo_target
geo_stats = df_geo_filtered.groupby('geo_target').agg({
    'cost': 'sum',
    'conversions': 'sum',
    'conversion_value': 'sum',
    'impressions': 'sum',
    'clicks': 'sum',
    'campaign_id': 'nunique',
    'year_month': 'nunique'
}).reset_index()
geo_stats.rename(columns={'campaign_id': 'campaign_count', 'year_month': 'month_count'}, inplace=True)
# Compute metrics
geo_stats['roi'] = geo_stats['conversion_value'] / geo_stats['cost']
geo_stats['ctr'] = geo_stats['clicks'] / geo_stats['impressions']
geo_stats['conversion_rate'] = geo_stats['conversions'] / geo_stats['clicks']
geo_stats['cost_per_conversion'] = geo_stats['cost'] / geo_stats['conversions']
geo_stats['quality_score'] = df_geo_filtered.groupby('geo_target')['quality_score'].mean().values
geo_stats['impression_share'] = df_geo_filtered.groupby('geo_target')['impression_share'].mean().values
# Sort by cost descending
geo_stats = geo_stats.sort_values('cost', ascending=False)
print("\\nTop geo targets by cost:")
print(geo_stats[['geo_target', 'cost', 'roi', 'conversion_rate', 'impression_share']].head(10))
geo_stats.to_csv('geo_stats.csv', index=False)

# Aggregate per device_type
device_stats = df_device_filtered.groupby('device_type').agg({
    'cost': 'sum',
    'conversions': 'sum',
    'conversion_value': 'sum',
    'impressions': 'sum',
    'clicks': 'sum',
    'campaign_id': 'nunique',
    'year_month': 'nunique'
}).reset_index()
device_stats.rename(columns={'campaign_id': 'campaign_count', 'year_month': 'month_count'}, inplace=True)
device_stats['roi'] = device_stats['conversion_value'] / device_stats['cost']
device_stats['ctr'] = device_stats['clicks'] / device_stats['impressions']
device_stats['conversion_rate'] = device_stats['conversions'] / device_stats['clicks']
device_stats['cost_per_conversion'] = device_stats['cost'] / device_stats['conversions']
device_stats['quality_score'] = df_device_filtered.groupby('device_type')['quality_score'].mean().values
device_stats['impression_share'] = df_device_filtered.groupby('device_type')['impression_share'].mean().values
device_stats = device_stats.sort_values('cost', ascending=False)
print("\\nDevice type performance:")
print(device_stats[['device_type', 'cost', 'roi', 'conversion_rate', 'impression_share']])
device_stats.to_csv('device_stats.csv', index=False)
''')
