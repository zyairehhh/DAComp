from sklearn.preprocessing import MinMaxScaler

# Invert avg_process_days
df['process_speed'] = 1 / (df['avg_process_days'] + 1)  # add 1 to avoid division by zero

metrics = ['hire_rate', 'interview_rate', 'interview_to_hire_rate', 'efficiency_score', 'avg_quality', 'avg_rating', 'process_speed']
scaler = MinMaxScaler()
df_normalized = pd.DataFrame(scaler.fit_transform(df[metrics]), columns=metrics, index=df.index)

# Weighted composite index
weights = {
    'hire_rate': 0.25,
    'interview_rate': 0.1,
    'interview_to_hire_rate': 0.15,
    'efficiency_score': 0.15,
    'avg_quality': 0.2,
    'avg_rating': 0.1,
    'process_speed': 0.05
}
df['composite_score'] = sum(df_normalized[metric] * weight for metric, weight in weights.items())

# Add cost proxy: assume cost per hire inversely related to composite score? We'll create a cost index based on typical categories.
cost_map = {
    'Headhunter': 5,  # high
    'University Recruiting': 2,  # medium (travel, events)
    'Employee Referral': 1,  # low (bonus)
    'LinkedIn': 3,
    'Indeed': 3,
    'Glassdoor': 3,
    'AngelList': 3,
    'Company Website': 1  # low (organic)
}
df['cost_index'] = df['source_name'].map(cost_map)
df['cost_weighted_score'] = df['composite_score'] / df['cost_index']  # higher means more cost-effective

print(df[['source_name', 'hire_rate', 'avg_process_days', 'avg_quality', 'avg_rating', 'composite_score', 'cost_index', 'cost_weighted_score']].sort_values('cost_weighted_score', ascending=False))

# Save to CSV
df.to_csv('source_composite.csv', index=False)
print("Saved to source_composite.csv")
''')
