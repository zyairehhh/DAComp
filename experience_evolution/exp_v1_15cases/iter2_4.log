```
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib
import sqlite3

# Connect to the database
db_path = "dacomp-078.sqlite"
conn = sqlite3.connect(db_path)

# Load account data
account_df = pd.read_sql_query("SELECT * FROM pendo__account", conn)

# Define features as per Stage1
features = [
    'sum_minutes', 'sum_events', 'count_active_days',
    'count_feature_clicking_visitors', 'count_active_visitors',
    'count_page_viewing_visitors', 'average_daily_minutes',
    'average_daily_events', 'avg_nps_rating'
]

# Compute retention_days based on first_event_on and last_event_on
account_df['first_event_on'] = pd.to_datetime(account_df['first_event_on'])
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['retention_days'] = (account_df['last_event_on'] - account_df['first_event_on']).dt.days
account_df['retention_days'] = account_df['retention_days'].fillna(0).astype(int)

# Fill missing NPS ratings with median
nps_median = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating_filled'] = account_df['avg_nps_rating'].fillna(nps_median)

# Append retention_days and filled NPS to features list
features_with_retention = features + ['retention_days']
features_with_retention.remove('avg_nps_rating')
features_with_retention.append('avg_nps_rating_filled')

# Standardize each feature (z-score) manually
for col in features_with_retention:
    mean = account_df[col].mean()
    std = account_df[col].std()
    account_df[col] = (account_df[col] - mean) / std

# Weighting: engagement features get higher weight (as per report)
# Define engagement features
engagement_features = [
    'sum_minutes', 'sum_events', 'count_active_days',
    'count_feature_clicking_visitors', 'count_active_visitors',
    'count_page_viewing_visitors'
]
other_features = ['average_daily_minutes', 'average_daily_events', 'retention_days', 'avg_nps_rating_filled']

# Apply weights: engagement weight = 1.5, other weight = 1.0
weights = {}
for f in engagement_features:
    weights[f] = 1.5
for f in other_features:
    weights[f] = 1.0

# Compute weighted composite score
account_df['composite_score'] = sum(account_df[f] * weights[f] for f in features_with_retention)

# Determine top 20% high-value threshold
threshold = account_df['composite_score'].quantile(0.8)
account_df['high_value'] = (account_df['composite_score'] >= threshold).astype(int)

# Baseline model scores (sum_minutes, count_active_days)
# Standardized values already; compute equally weighted sum
baseline_features = ['sum_minutes', 'count_active_days']
account_df['baseline_score'] = account_df[baseline_features].sum(axis=1)
baseline_threshold = account_df['baseline_score'].quantile(0.8)
account_df['baseline_high_value'] = (account_df['baseline_score'] >= baseline_threshold).astype(int)

# Multi-dimensional model (10 features equally weighted)
account_df['multi_score'] = account_df[features_with_retention].sum(axis=1)
multi_threshold = account_df['multi_score'].quantile(0.8)
account_df['multi_high_value'] = (account_df['multi_score'] >= multi_threshold).astype(int)

# Compute accuracy manually
actual = account_df['high_value']
def accuracy(pred):
    return (actual == pred).sum() / len(actual)

baseline_accuracy = accuracy(account_df['baseline_high_value'])
multi_accuracy = accuracy(account_df['multi_high_value'])

print(f'Baseline accuracy: {baseline_accuracy:.4f}')
print(f'Multi-dimensional accuracy: {multi_accuracy:.4f}')

# Write these accuracies to a file for reference
with open('accuracies.txt', 'w') as f:
    f.write(f'Baseline (duration+frequency) accuracy: {baseline_accuracy:.3%}\n')
    f.write(f'Multi-dimensional (10-feature) accuracy: {multi_accuracy:.3%}\n')

# Generate visualizations
plt.style.use('seaborn-v0_8-whitegrid')

# 1. Histogram of composite scores with threshold
plt.figure(figsize=(10,6))
plt.hist(account_df['composite_score'], bins=50, alpha=0.7, color='skyblue', edgecolor='black')
plt.axvline(threshold, color='red', linestyle='--', label=f'Top 20% threshold ({threshold:.2f})')
plt.xlabel('Composite Value Score')
plt.ylabel('Number of Accounts')
plt.title('Distribution of Customer Value Scores')
plt.legend()
plt.tight_layout()
plt.savefig('composite_score_distribution.png', dpi=300)
plt.close()

# 2. Bar chart comparing accuracy of baseline vs multi-dimensional model
fig, ax = plt.subplots(figsize=(8,6))
models = ['Baseline (2D)', 'Multi-dimensional (10D)']
accuracies = [baseline_accuracy, multi_accuracy]
bars = ax.bar(models, accuracies, color=['lightcoral', 'lightseagreen'])
ax.set_ylabel('Accuracy', fontsize=12)
ax.set_title('Model Accuracy for Identifying High-Value Customers', fontsize=14)
ax.set_ylim([0, 1])
for bar, acc in zip(bars, accuracies):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2, height + 0.01, f'{acc:.3%}', ha='center', va='bottom', fontsize=11)
# Add a horizontal line at 85% target
ax.axhline(y=0.85, color='gray', linestyle=':', linewidth=2, label='Target accuracy (85%)')
ax.legend()
plt.tight_layout()
plt.savefig('model_accuracy_comparison.png', dpi=300)
plt.close()

# 3. Feature correlations with composite score (as per Stage1 report)
# Compute correlation
correlations = account_df[features_with_retention + ['composite_score']].corr()['composite_score'].drop('composite_score')
correlations_sorted = correlations.sort_values(ascending=False)
plt.figure(figsize=(10,6))
colors = ['steelblue' if x in engagement_features else 'darkorange' for x in correlations_sorted.index]
bars = plt.barh(range(len(correlations_sorted)), correlations_sorted.values, color=colors, edgecolor='black')
plt.yticks(range(len(correlations_sorted)), correlations_sorted.index, fontsize=10)
plt.xlabel('Correlation with Composite Score', fontsize=12)
plt.title('Feature Correlations with Customer Value Score', fontsize=14)
# Add correlation values on bars
for i, v in enumerate(correlations_sorted.values):
    plt.text(v + 0.01, i, f'{v:.3f}', va='center', fontsize=9)
plt.gca().invert_yaxis()
plt.tight_layout()
plt.savefig('feature_correlations.png', dpi=300)
plt.close()

# 4. Scatter plot of baseline vs multi-dimensional scores with high-value highlight
plt.figure(figsize=(10,8))
# Color by ground truth high-value
colors = ['red' if hv == 1 else 'lightgray' for hv in account_df['high_value']]
plt.scatter(account_df['baseline_score'], account_df['multi_score'], c=colors, alpha=0.6, s=20, edgecolors='k', linewidths=0.5)
plt.xlabel('Baseline Score (Duration + Frequency)', fontsize=12)
plt.ylabel('Multi-dimensional Score (10 features)', fontsize=12)
plt.title('Baseline vs Multi-dimensional Scores (Red = High-Value)', fontsize=14)
# Add diagonal line
lims = [account_df['baseline_score'].min(), account_df['baseline_score'].max()]
plt.plot(lims, lims, 'k--', alpha=0.5)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('baseline_vs_multi_scatter.png', dpi=300)
plt.close()

# 5. Confusion matrix for multi-dimensional model
tp = ((actual == 1) & (account_df['multi_high_value'] == 1)).sum()
tn = ((actual == 0) & (account_df['multi_high_value'] == 0)).sum()
fp = ((actual == 0) & (account_df['multi_high_value'] == 1)).sum()
fn = ((actual == 1) & (account_df['multi_high_value'] == 0)).sum()
cm = np.array([[tn, fp], [fn, tp]])
fig, ax = plt.subplots(figsize=(6,6))
im = ax.imshow(cm, cmap='Blues')
ax.set_xticks([0,1])
ax.set_yticks([0,1])
ax.set_xticklabels(['Low-Value', 'High-Value'])
ax.set_yticklabels(['Low-Value', 'High-Value'])
ax.set_xlabel('Predicted')
ax.set_ylabel('Actual')
ax.set_title('Confusion Matrix: Multi-dimensional Model', fontsize=14)
for i in range(2):
    for j in range(2):
        ax.text(j, i, str(cm[i,j]), ha='center', va='center', color='black', fontsize=16)
plt.tight_layout()
plt.savefig('confusion_matrix_multi.png', dpi=300)
plt.close()

print('Visualizations saved.')
