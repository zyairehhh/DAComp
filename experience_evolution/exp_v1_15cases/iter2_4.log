    if years:
        y = int(years[0])
        if y >= 10:
            return '10+ years'
        elif y >= 5:
            return '5+ years'
        elif y >= 3:
            return '3+ years'
        elif y >= 2:
            return '2+ years'
        elif y >= 1:
            return '1+ years'
    # check for 'more than x year'
    more = re.findall(r'more than\s*(\d+)', t)
    if more:
        y = int(more[0])
        if y >= 10:
            return '10+ years'
        elif y >= 5:
            return '5+ years'
        elif y >= 3:
            return '3+ years'
        elif y >= 2:
            return '2+ years'
        elif y >= 1:
            return '1+ years'
    return 'other'

