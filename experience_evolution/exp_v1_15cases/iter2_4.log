import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from datetime import datetime

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Decay patterns of user acquisition cost-efficiency by region-device
# Note: We don't have direct cost data, but we can use conversion rate as proxy for cost-efficiency
# Load country and device data
country_data = pd.read_sql_query("SELECT * FROM google_play__country_report", conn)
device_data = pd.read_sql_query("SELECT * FROM google_play__device_report", conn)

# Convert date
country_data['date_day'] = pd.to_datetime(country_data['date_day'])
device_data['date_day'] = pd.to_datetime(device_data['date_day'])

# Create first visualization: Store listing conversion rate trends by region
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
fig.suptitle('Store Listing Conversion Rate Trends by Region (Apr-Oct 2024)', fontsize=16)

# Get unique regions
regions = country_data['region'].unique()

for i, region in enumerate(regions[:4]):  # Limit to first 4 regions
    ax = axes[i//2, i%2]
    region_data = country_data[country_data['region'] == region]
    
    # Calculate monthly average conversion rate
    region_data['month'] = region_data['date_day'].dt.to_period('M')
    monthly_avg = region_data.groupby('month')['store_listing_conversion_rate'].mean().reset_index()
    monthly_avg['month'] = monthly_avg['month'].astype(str)
    
    ax.plot(monthly_avg['month'], monthly_avg['store_listing_conversion_rate'], 
            marker='o', linewidth=2)
    ax.set_title(f'{region}')
    ax.set_xlabel('Month')
    ax.set_ylabel('Conversion Rate')
    ax.tick_params(axis='x', rotation=45)
    ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('region_conversion_trends.png', dpi=300, bbox_inches='tight')

# 2. Non-linear relationship between store_listing_conversion_rate and quality_score/crash_rate
# We need time series data for this correlation
time_series = pd.read_sql_query("SELECT * FROM google_play__time_series_trends", conn)
time_series['date_day'] = pd.to_datetime(time_series['date_day'])

fig, axes = plt.subplots(1, 2, figsize=(14, 6))
fig.suptitle('Non-linear Relationships: Conversion Rate vs Quality & Crash Metrics', fontsize=14)

# Scatter plot: conversion rate vs quality score
axes[0].scatter(time_series['quality_score'], 
                time_series['revenue_per_active_device'],  # Using revenue as proxy for conversion outcome
                alpha=0.6, s=30)
axes[0].set_xlabel('Quality Score')
axes[0].set_ylabel('Revenue per Active Device')
axes[0].set_title('Quality Score vs Revenue per Device')
axes[0].grid(True, alpha=0.3)

# Add trend line
z = np.polyfit(time_series['quality_score'].dropna(), 
                time_series['revenue_per_active_device'].dropna(), 2)
p = np.poly1d(z)
sorted_indices = np.argsort(time_series['quality_score'].dropna())
axes[0].plot(time_series['quality_score'].dropna().iloc[sorted_indices],
             p(time_series['quality_score'].dropna().iloc[sorted_indices]), 
             'r-', linewidth=2, label='Quadratic Fit')

# Scatter plot: conversion rate vs crash rate
axes[1].scatter(time_series['crash_rate_per_1k'], 
                time_series['revenue_per_active_device'],
                alpha=0.6, s=30)
axes[1].set_xlabel('Crash Rate per 1k')
axes[1].set_ylabel('Revenue per Active Device')
axes[1].set_title('Crash Rate vs Revenue per Device')
axes[1].grid(True, alpha=0.3)

# Add trend line
if len(time_series['crash_rate_per_1k'].dropna()) > 0:
    z2 = np.polyfit(time_series['crash_rate_per_1k'].dropna(), 
                    time_series['revenue_per_active_device'].dropna(), 2)
    p2 = np.poly1d(z2)
    sorted_indices2 = np.argsort(time_series['crash_rate_per_1k'].dropna())
    axes[1].plot(time_series['crash_rate_per_1k'].dropna().iloc[sorted_indices2],
                 p2(time_series['crash_rate_per_1k'].dropna().iloc[sorted_indices2]), 
                 'r-', linewidth=2, label='Quadratic Fit')

plt.tight_layout()
plt.savefig('nonlinear_relationships.png', dpi=300, bbox_inches='tight')

# 3. Multi-dimensional user value decay: active devices over time by device type
# Get top devices by total active devices
top_devices = device_data.groupby('device')['active_devices_last_30_days'].sum().nlargest(6).index.tolist()

fig, ax = plt.subplots(figsize=(12, 6))
for device in top_devices:
    device_ts = device_data[device_data['device'] == device]
    monthly_data = device_ts.groupby(device_ts['date_day'].dt.to_period('M'))['active_devices_last_30_days'].mean()
    ax.plot(monthly_data.index.astype(str), monthly_data.values, marker='o', label=device, linewidth=2)

ax.set_title('Active Devices (30-day) Trend by Top Device Models', fontsize=14)
ax.set_xlabel('Month')
ax.set_ylabel('Active Devices (30-day avg)')
ax.legend(title='Device Model', bbox_to_anchor=(1.05, 1), loc='upper left')
ax.tick_params(axis='x', rotation=45)
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('device_decay_patterns.png', dpi=300, bbox_inches='tight')

# 4. Interaction effect: update events vs metrics
# We need to analyze update events from device report
fig, axes = plt.subplots(1, 2, figsize=(14, 6))
fig.suptitle('App Update Frequency Impact on Key Metrics', fontsize=14)

# Scatter: update events vs active devices
axes[0].scatter(device_data['update_events'], 
                device_data['active_devices_last_30_days'],
                alpha=0.6, s=30)
axes[0].set_xlabel('Update Events (Device Level)')
axes[0].set_ylabel('Active Devices (Last 30 Days)')
axes[0].set_title('Update Frequency vs Active Devices')
axes[0].grid(True, alpha=0.3)

# Scatter: update events vs average rating
axes[1].scatter(device_data['update_events'], 
                device_data['rolling_total_average_rating'],
                alpha=0.6, s=30, c='green')
axes[1].set_xlabel('Update Events (Device Level)')
axes[1].set_ylabel('Rolling Average Rating')
axes[1].set_title('Update Frequency vs User Rating')
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('update_impact_analysis.png', dpi=300, bbox_inches='tight')

# 5. Revenue per active device by market maturity
# Use region data and time to infer maturity
fig, ax = plt.subplots(figsize=(10, 6))

# Calculate cumulative net installs as proxy for market maturity
market_maturity = country_data.groupby(['region', 'date_day'])['net_device_installs'].sum().reset_index()
market_maturity = market_maturity.groupby('region').apply(
    lambda x: x.assign(cumulative_installs=x['net_device_installs'].cumsum())).reset_index(drop=True)

# Scatter plot: market maturity vs revenue efficiency
# We need revenue data - approximate from time series and country data
# For simplicity, use conversion rate as proxy
for region in regions[:4]:
    region_maturity = market_maturity[market_maturity['region'] == region]
    region_revenue_data = country_data[country_data['region'] == region]
    # Merge based on date
    combined = pd.merge(region_maturity, region_revenue_data[['date_day', 'store_listing_conversion_rate']], 
                       on='date_day', how='left')
    ax.scatter(combined['cumulative_installs'], 
               combined['store_listing_conversion_rate'],
               alpha=0.6, s=50, label=region)

ax.set_xlabel('Cumulative Net Installs (Market Maturity Proxy)')
ax.set_ylabel('Store Listing Conversion Rate')
ax.set_title('Conversion Efficiency Across Market Maturity Levels')
ax.legend()
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('market_maturity_efficiency.png', dpi=300, bbox_inches='tight')

conn.close()
print("Visualizations generated successfully!")
```
