'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')

# Load account data
account_df = pd.read_sql_query("SELECT * FROM pendo__account", conn)

# Load visitor-feature to get feature diversity per account
visitor_feature_df = pd.read_sql_query("SELECT visitor_id, feature_id FROM pendo__visitor_feature", conn)
visitor_df = pd.read_sql_query("SELECT visitor_id, account_id FROM pendo__visitor", conn)

# Merge to get account_id for each visitor-feature
vf_with_account = visitor_feature_df.merge(visitor_df, on='visitor_id', how='left')
# Count distinct features per account
features_per_account = vf_with_account.groupby('account_id').agg(
    distinct_features=('feature_id', 'nunique')
).reset_index()

# Merge back to account_df
account_df = account_df.merge(features_per_account, on='account_id', how='left')
account_df['distinct_features'] = account_df['distinct_features'].fillna(0)

# Compute retention days
account_df['first_event_on'] = pd.to_datetime(account_df['first_event_on'])
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['retention_days'] = (account_df['last_event_on'] - account_df['first_event_on']).dt.days
account_df['retention_days'] = account_df['retention_days'].clip(lower=0)

# Fill missing NPS with median
median_nps = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating_filled'] = account_df['avg_nps_rating'].fillna(median_nps)

# Define high-value label: top 20% by composite score
features_for_score = ['sum_minutes', 'sum_events', 'count_active_days',
                      'count_feature_clicking_visitors', 'avg_nps_rating_filled',
                      'distinct_features', 'retention_days']
score_df = account_df[features_for_score].copy()
# Normalize each feature (z-score)
for col in features_for_score:
    score_df[col] = (score_df[col] - score_df[col].mean()) / score_df[col].std()
# Weighting: giving higher weight to engagement metrics
weights = np.array([0.2, 0.2, 0.15, 0.15, 0.1, 0.1, 0.1])
account_df['composite_score'] = score_df.dot(weights)
# Define high-value as top 20%
threshold = account_df['composite_score'].quantile(0.8)
account_df['high_value'] = (account_df['composite_score'] >= threshold).astype(int)
print(f"High-value accounts: {account_df['high_value'].sum()} out of {len(account_df)}")

# Baseline model using only usage duration and frequency
# Compute a baseline score as normalized sum_minutes + normalized count_active_days
baseline_features = ['sum_minutes', 'count_active_days']
baseline_df = account_df[baseline_features].copy()
for col in baseline_features:
    baseline_df[col] = (baseline_df[col] - baseline_df[col].mean()) / baseline_df[col].std()
account_df['baseline_score'] = baseline_df['sum_minutes'] * 0.5 + baseline_df['count_active_days'] * 0.5
# Classify top 20% as predicted high-value
baseline_threshold = account_df['baseline_score'].quantile(0.8)
account_df['pred_baseline'] = (account_df['baseline_score'] >= baseline_threshold).astype(int)
# Compute accuracy
baseline_accuracy = (account_df['pred_baseline'] == account_df['high_value']).mean()
print(f"Baseline model accuracy (2 features): {baseline_accuracy:.2%}")

# Multi-dimensional model using all features
multi_features = ['sum_minutes', 'sum_events', 'count_active_days',
                 'count_feature_clicking_visitors', 'avg_nps_rating_filled',
                 'distinct_features', 'retention_days',
                 'count_active_visitors', 'count_page_viewing_visitors',
                 'average_daily_minutes', 'average_daily_events']
multi_df = account_df[multi_features].copy()
for col in multi_features:
    multi_df[col] = (multi_df[col] - multi_df[col].mean()) / multi_df[col].std()
# Weights could be derived from correlation with composite_score? For simplicity, use equal weight.
weights_multi = np.ones(len(multi_features)) / len(multi_features)
account_df['multi_score'] = multi_df.dot(weights_multi)
multi_threshold = account_df['multi_score'].quantile(0.8)
account_df['pred_multi'] = (account_df['multi_score'] >= multi_threshold).astype(int)
multi_accuracy = (account_df['pred_multi'] == account_df['high_value']).mean()
print(f"Multi-dimensional equal-weight accuracy: {multi_accuracy:.2%}")

# Let's also consider using logistic regression via statsmodels (if installed) or simple correlation.
# Compute correlation matrix to see which features are most related to high_value.
corr_matrix = account_df[multi_features + ['high_value']].corr()
print("\nCorrelation with high_value:")
print(corr_matrix['high_value'].sort_values(ascending=False))

# Use logistic regression manually via gradient descent? Not needed.
# Instead, we can compute a weighted score based on correlation coefficients.
corr_weights = corr_matrix['high_value'].drop('high_value')
# Normalize weights to sum to 1
corr_weights = corr_weights / corr_weights.sum()
account_df['corr_weighted_score'] = multi_df.dot(corr_weights)
corr_threshold = account_df['corr_weighted_score'].quantile(0.8)
account_df['pred_corr'] = (account_df['corr_weighted_score'] >= corr_threshold).astype(int)
corr_accuracy = (account_df['pred_corr'] == account_df['high_value']).mean()
print(f"Correlation-weighted accuracy: {corr_accuracy:.2%}")

# Evaluate if any model reaches >85%
if corr_accuracy >= 0.85:
    print("Goal achieved: accuracy >85% with correlation-weighted model.")
elif multi_accuracy >= 0.85:
    print("Goal achieved: accuracy >85% with equal-weight multi-dimensional model.")
else:
    print("Goal not yet achieved. Need to improve model.")

# Feature importance from correlation
print("\nFeature importance (correlation with high_value):")
for feat, corr in corr_matrix['high_value'].drop('high_value').sort_values(ascending=False).items():
    print(f"{feat}: {corr:.3f}")

conn.close()
''')
