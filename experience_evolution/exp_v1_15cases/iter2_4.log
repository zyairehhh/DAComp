```
import pandas as pd
import numpy as np

df = pd.read_csv('ad_group_metrics.csv')
print('Rows:', len(df))
print(df.head())

# Compute percentiles
ctr_75 = df['ctr'].quantile(0.75)
cvr_25 = df['cvr'].quantile(0.25)
print('75th percentile of CTR:', ctr_75)
print('25th percentile of CVR:', cvr_25)

# Filter problematic ad groups
problematic = df[(df['ctr'] > ctr_75) & (df['cvr'] < cvr_25)]
print('Problematic ad groups count:', len(problematic))
print(problematic.head())
problematic.to_csv('problematic_ad_groups.csv', index=False)

# Compute overall average CVR for expected CVR?
avg_cvr = df['cvr'].mean()
print('Overall average CVR:', avg_cvr)
# Intent Match Ratio = Actual CVR / Expected CVR
# Expected CVR could be overall average or maybe per campaign? Let's use overall avg for now.
problematic['intent_match_ratio'] = problematic['cvr'] / avg_cvr
print(problematic[['ad_group_id', 'ad_group_name', 'ctr', 'cvr', 'intent_match_ratio']].head())
problematic[['ad_group_id', 'ad_group_name', 'ctr', 'cvr', 'intent_match_ratio']].to_csv('problematic_with_ratio.csv', index=False)
```
