import pandas as pd
import numpy as np
import re
import json

df = pd.read_csv('vocational_data.csv')
df = df.dropna(subset=['salary_lower'])
print(f"Analyzing {len(df)} job postings for vocational school graduates.")

# Salary distribution summary
print("Salary lower bound summary statistics:")
print(df['salary_lower'].describe())
percentiles = df['salary_lower'].quantile([0.25, 0.5, 0.75])
print(f"25th percentile: {percentiles[0.25]}")
print(f"50th percentile (median): {percentiles[0.5]}")
print(f"75th percentile: {percentiles[0.75]}")

# Distribution bins (as before)
bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 50000]
labels = ['<2000', '2000-3000', '3000-4000', '4000-5000', '5000-6000', '6000-7000', '7000-8000', '8000-9000', '9000-10000', '10000-15000', '15000-20000', '>20000']
df['salary_bin'] = pd.cut(df['salary_lower'], bins=bins, labels=labels, right=False)
salary_dist = df['salary_bin'].value_counts().sort_index()
print("\\nSalary distribution (lower bound) in bins:")
print(salary_dist)
salary_dist.to_csv('salary_bin_distribution.csv')

# Benefits distribution (top 20 after merging similar)
benefits_text = df['Benefits'].dropna()
def split_benefits(text):
    text = str(text)
    # Normalize Chinese punctuation
    text = text.replace('，', ',').replace('；', ';').replace('、', ',').replace('；', ';')
    # Split by comma or semicolon
    parts = re.split(r'[,;]', text)
    cleaned = [p.strip() for p in parts if p.strip()]
    return cleaned

all_benefits = []
for txt in benefits_text:
    all_benefits.extend(split_benefits(txt))

from collections import Counter
benefits_counter = Counter(all_benefits)
# Manual grouping of similar benefits
group_map = {
    'Five social insurances': 'Five social insurances',
    'Five insurances': 'Five social insurances',
    'Five social insurances and one housing fund': 'Five social insurances and housing fund',
    'housing provident fund': 'Housing provident fund',
    'paid annual leave': 'Paid annual leave',
    'holiday benefits': 'Holiday benefits',
    'performance bonus': 'Performance bonus',
    'overtime pay': 'Overtime pay',
    'professional training': 'Professional training',
    'employee travel': 'Employee travel',
    'meal allowance': 'Meal allowance',
    'double pay at the end of the year': 'Year-end bonus',
    'double salary at the end of the year': 'Year-end bonus',
    'year-end bonus': 'Year-end bonus',
    'commercial insurance': 'Commercial insurance',
    'full attendance bonus': 'Full attendance bonus',
    'business trip allowance': 'Business trip allowance',
    'transportation allowance': 'Transportation allowance',
    'communication allowance': 'Communication allowance',
    'multiple salary adjustments per year': 'Multiple salary adjustments',
    'high-temperature allowance': 'High-temperature allowance',
    'meals provided': 'Meals provided',
    'housing allowance': 'Housing allowance',
    'regular medical check-ups': 'Regular medical check-ups',
    'free shuttle bus': 'Free shuttle bus',
    'flexible working hours': 'Flexible working hours',
    'work uniform': 'Work uniform',
    'and work uniform.': 'Work uniform',
    'and accommodation provided.': 'Accommodation provided',
    'and meals provided.': 'Meals provided',
}
def map_benefit(b):
    b_lower = b.lower()
    for key, group in group_map.items():
        if key.lower() in b_lower:
            return group
    # If no mapping, keep original but standardize case
    return b.capitalize()

grouped_benefits = []
for b in all_benefits:
    grouped_benefits.append(map_benefit(b))
grouped_counter = Counter(grouped_benefits)
top_benefits = grouped_counter.most_common(20)
print("\\nTop 20 benefits (grouped):")
for benefit, count in top_benefits:
    print(f"{benefit}: {count}")

pd.DataFrame(top_benefits, columns=['benefit', 'count']).to_csv('benefits_distribution_grouped.csv', index=False)

# Qualities that increase salary: compute average salary for each factor
# Experience categories (simplified)
def exp_cat_simple(text):
    if not isinstance(text, str):
        return 'unknown'
    t = text.lower()
    if 'no limit' in t:
        return 'no limit'
    if 'fresh' in t:
        return 'fresh graduates'
    if 'year' in t or 'years' in t:
        # extract numeric
        nums = re.findall(r'(\d+)\s*year', t)
        if nums:
            y = int(nums[0])
            if y >= 5:
                return '5+ years'
            elif y >= 3:
                return '3+ years'
            elif y >= 1:
                return '1+ years'
    return 'specific skill/other'

df['exp_simple'] = df['Work Experience Requirement'].apply(exp_cat_simple)
exp_salary = df.groupby('exp_simple')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\\nExperience categories vs salary:")
print(exp_salary)

# Foreign language requirement
def lang_req_simple(text):
    if not isinstance(text, str):
        return 'no requirement'
    t = text.lower()
    if any(word in t for word in ['english', 'japanese', 'spanish', 'french', 'german', 'hokkien', 'cantonese']):
        return 'foreign language required'
    if 'proficiency' in t or 'good' in t or 'required' in t:
        return 'language proficiency required'
    return 'no requirement'

df['lang_simple'] = df['Foreign Language Requirement'].apply(lang_req_simple)
lang_salary = df.groupby('lang_simple')['salary_lower'].agg(['mean', 'median', 'count'])
print("\\nForeign language requirement vs salary:")
print(lang_salary)

# Age requirement
df['age_req'] = df['Age Requirement'].apply(lambda x: 'restricted' if isinstance(x, str) and ('age' in x.lower() or 'years old' in x.lower()) else 'no limit')
age_salary = df.groupby('age_req')['salary_lower'].agg(['mean', 'median', 'count'])
print("\\nAge requirement vs salary:")
print(age_salary)

# Gender requirement
df['gender_req'] = df['Gender Requirement'].apply(lambda x: 'male only' if isinstance(x, str) and 'male' in x.lower() and 'female' not in x.lower() else ('female only' if isinstance(x, str) and 'female' in x.lower() and 'male' not in x.lower() else 'no limit'))
gender_salary = df.groupby('gender_req')['salary_lower'].agg(['mean', 'median', 'count'])
print("\\nGender requirement vs salary:")
print(gender_salary)

# Industry top 10 by count
top10_ind = df['Industry'].value_counts().head(10).index
industry_salary = df[df['Industry'].isin(top10_ind)].groupby('Industry')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\\nTop 10 Industries by count vs salary:")
print(industry_salary)

# Company type top 10
top10_comp = df['Company Type'].value_counts().head(10).index
company_salary = df[df['Company Type'].isin(top10_comp)].groupby('Company Type')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\\nTop 10 Company types vs salary:")
print(company_salary)

# Save summary to CSV
exp_salary.to_csv('experience_salary.csv')
lang_salary.to_csv('language_salary.csv')
age_salary.to_csv('age_salary.csv')
gender_salary.to_csv('gender_salary.csv')
industry_salary.to_csv('industry_salary.csv')
company_salary.to_csv('company_salary.csv')

# Identify qualities that increase salary: define significant if mean diff > 500 yuan and count > 100
print("\\n--- Qualities associated with higher salaries (diff > 500) ---")
# Compare each category against baseline 'no limit' for experience
if 'no limit' in exp_salary.index:
    baseline_mean = exp_salary.loc['no limit', 'mean']
    for cat, row in exp_salary.iterrows():
        if cat != 'no limit' and row['count'] > 100:
            diff = row['mean'] - baseline_mean
            if diff > 500:
                print(f"Experience: {cat} (+{diff:.0f} yuan)")

# Compare language required vs no requirement
if 'no requirement' in lang_salary.index:
    baseline = lang_salary.loc['no requirement', 'mean']
    for cat, row in lang_salary.iterrows():
        if cat != 'no requirement' and row['count'] > 100:
            diff = row['mean'] - baseline
            if diff > 500:
                print(f"Language: {cat} (+{diff:.0f} yuan)")

# Age restricted vs no limit
if 'no limit' in age_salary.index:
    baseline = age_salary.loc['no limit', 'mean']
    for cat, row in age_salary.iterrows():
        if cat != 'no limit' and row['count'] > 100:
            diff = row['mean'] - baseline
            if diff > 500:
                print(f"Age: {cat} (+{diff:.0f} yuan)")

# Gender (likely not)
# Industry: compare each industry to overall mean
overall_mean = df['salary_lower'].mean()
for ind, row in industry_salary.iterrows():
    if row['count'] > 100:
        diff = row['mean'] - overall_mean
        if diff > 500:
            print(f"Industry {ind} (+{diff:.0f} yuan)")
        elif diff < -500:
            print(f"Industry {ind} ({diff:.0f} yuan, lower)")

# Company type
overall_mean = df['salary_lower'].mean()
for ct, row in company_salary.iterrows():
    if row['count'] > 100:
        diff = row['mean'] - overall_mean
        if diff > 500:
            print(f"Company Type {ct} (+{diff:.0f} yuan)")

print("\\nAnalysis complete.")
''')
