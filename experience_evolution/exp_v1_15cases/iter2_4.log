import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import os

# Set English fonts (matplotlib default)
plt.rcParams['font.sans-serif'] = []
plt.rcParams['axes.unicode_minus'] = False

# Connect to database
db_path = "/workspace/dacomp-092.sqlite"
conn = sqlite3.connect(db_path)

# 1. Distribution of customer_margin_volatility with 25% threshold
print("Creating visualization 1: Customer Margin Volatility Distribution...")
df_volatility = pd.read_sql_query("""
    SELECT customer_id, customer_margin_volatility, 
           customer_gross_margin_pct, customer_profit_growth_pct,
           customer_profit_tier
    FROM quickbooks__profitability_analysis
    WHERE customer_margin_volatility IS NOT NULL
""", conn)

df_volatility['high_volatility'] = df_volatility['customer_margin_volatility'] >= 0.252198

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Histogram of volatility
axes[0].hist(df_volatility['customer_margin_volatility'], bins=50, alpha=0.7, color='skyblue', edgecolor='black')
axes[0].axvline(x=0.252198, color='red', linestyle='--', linewidth=2, label='Top 25% threshold')
axes[0].set_xlabel('Customer Margin Volatility')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Distribution of Customer Margin Volatility')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# Scatter: Volatility vs Gross Margin
scatter = axes[1].scatter(df_volatility['customer_margin_volatility'], 
                         df_volatility['customer_gross_margin_pct'],
                         c=df_volatility['high_volatility'].astype(int), 
                         cmap='RdYlBu', alpha=0.6, s=30)
axes[1].axvline(x=0.252198, color='red', linestyle='--', linewidth=1)
axes[1].set_xlabel('Customer Margin Volatility')
axes[1].set_ylabel('Customer Gross Margin %')
axes[1].set_title('Volatility vs Gross Margin (Red = High Volatility)')
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('/workspace/volatility_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# 2. Behavioral analysis: RFM segments and payment behavior of high volatility customers
print("Creating visualization 2: High Volatility Customer Behavioral Analysis...")
df_behavior = pd.read_sql_query("""
    SELECT p.customer_id, p.customer_margin_volatility,
           c.rfm_segment, c.payment_behavior, c.lifecycle_stage,
           c.revenue_trend_correlation, c.credit_grade
    FROM quickbooks__profitability_analysis p
    LEFT JOIN quickbooks__customer_analytics c 
    ON p.customer_id = c.customer_id
    WHERE p.customer_margin_volatility IS NOT NULL
""", conn)

df_behavior['high_volatility'] = df_behavior['customer_margin_volatility'] >= 0.252198

# Get top RFM segments for high volatility customers
rfm_counts = df_behavior[df_behavior['high_volatility']].groupby('rfm_segment').size().sort_values(ascending=False).head(10)
payment_counts = df_behavior[df_behavior['high_volatility']].groupby('payment_behavior').size().sort_values(ascending=False)

fig, axes = plt.subplots(2, 2, figsize=(15, 12))

# RFM Segment distribution
bars1 = axes[0, 0].bar(range(len(rfm_counts)), rfm_counts.values, color='coral')
axes[0, 0].set_xticks(range(len(rfm_counts)))
axes[0, 0].set_xticklabels(rfm_counts.index, rotation=45, ha='right')
axes[0, 0].set_xlabel('RFM Segment')
axes[0, 0].set_ylabel('Count')
axes[0, 0].set_title('Top RFM Segments in High Volatility Customers')
for i, v in enumerate(rfm_counts.values):
    axes[0, 0].text(i, v + 5, str(v), ha='center', fontsize=9)

# Payment Behavior distribution
bars2 = axes[0, 1].bar(range(len(payment_counts)), payment_counts.values, color='lightgreen')
axes[0, 1].set_xticks(range(len(payment_counts)))
axes[0, 1].set_xticklabels(payment_counts.index, rotation=45, ha='right')
axes[0, 1].set_xlabel('Payment Behavior')
axes[0, 1].set_ylabel('Count')
axes[0, 1].set_title('Payment Behavior in High Volatility Customers')
for i, v in enumerate(payment_counts.values):
    axes[0, 1].text(i, v + 2, str(v), ha='center', fontsize=9)

# Revenue trend correlation vs volatility
scatter2 = axes[1, 0].scatter(df_behavior['customer_margin_volatility'], 
                             df_behavior['revenue_trend_correlation'],
                             c=df_behavior['high_volatility'].astype(int), 
                             cmap='coolwarm', alpha=0.6, s=30)
axes[1, 0].axvline(x=0.252198, color='black', linestyle='--', linewidth=1)
axes[1, 0].set_xlabel('Customer Margin Volatility')
axes[1, 0].set_ylabel('Revenue Trend Correlation')
axes[1, 0].set_title('Revenue Trend vs Volatility (Red = High Volatility)')
axes[1, 0].grid(True, alpha=0.3)

# Credit grade distribution for high volatility
credit_counts = df_behavior[df_behavior['high_volatility']].groupby('credit_grade').size().sort_values(ascending=False)
bars3 = axes[1, 1].bar(range(len(credit_counts)), credit_counts.values, color='gold')
axes[1, 1].set_xticks(range(len(credit_counts)))
axes[1, 1].set_xticklabels(credit_counts.index, rotation=45, ha='right')
axes[1, 1].set_xlabel('Credit Grade')
axes[1, 1].set_ylabel('Count')
axes[1, 1].set_title('Credit Grades in High Volatility Customers')
for i, v in enumerate(credit_counts.values):
    axes[1, 1].text(i, v + 2, str(v), ha='center', fontsize=9)

plt.tight_layout()
plt.savefig('/workspace/behavioral_analysis.png', dpi=300, bbox_inches='tight')
plt.close()

# 3. Financial impact: Contribution to business health score
print("Creating visualization 3: Financial Impact Analysis...")
df_financial = pd.read_sql_query("""
    SELECT f.dashboard_month, f.business_health_score, 
           f.collection_rate_percentage, f.total_revenue,
           COUNT(DISTINCT p.customer_id) as high_vol_customers,
           SUM(CASE WHEN p.customer_margin_volatility >= 0.252198 THEN 1 ELSE 0 END) as high_vol_count
    FROM quickbooks__financial_dashboard f
    LEFT JOIN quickbooks__profitability_analysis p ON 1=1
    GROUP BY f.dashboard_month, f.business_health_score, f.collection_rate_percentage, f.total_revenue
    ORDER BY f.dashboard_month
""", conn)

# Add high volatility percentage
df_financial['high_vol_pct'] = (df_financial['high_vol_count'] / df_financial['high_vol_customers'].max()) * 100

fig, axes = plt.subplots(2, 2, figsize=(14, 10))

# Business health score over time
axes[0, 0].plot(df_financial['dashboard_month'], df_financial['business_health_score'], 
               marker='o', color='darkblue', linewidth=2)
axes[0, 0].set_xlabel('Month')
axes[0, 0].set_ylabel('Business Health Score')
axes[0, 0].set_title('Business Health Score Trend')
axes[0, 0].grid(True, alpha=0.3)
axes[0, 0].tick_params(axis='x', rotation=45)

# Collection rate percentage over time
axes[0, 1].plot(df_financial['dashboard_month'], df_financial['collection_rate_percentage'], 
               marker='s', color='green', linewidth=2)
axes[0, 1].set_xlabel('Month')
axes[0, 1].set_ylabel('Collection Rate %')
axes[0, 1].set_title('Collection Rate Percentage Trend')
axes[0, 1].grid(True, alpha=0.3)
axes[0, 1].tick_params(axis='x', rotation=45)

# High volatility customer percentage over time
axes[1, 0].plot(df_financial['dashboard_month'], df_financial['high_vol_pct'], 
               marker='^', color='red', linewidth=2)
axes[1, 0].set_xlabel('Month')
axes[1, 0].set_ylabel('High Volatility Customers %')
axes[1, 0].set_title('Percentage of High Volatility Customers Over Time')
axes[1, 0].grid(True, alpha=0.3)
axes[1, 0].tick_params(axis='x', rotation=45)

# Correlation: High volatility % vs Business Health Score
correlation = np.corrcoef(df_financial['high_vol_pct'], df_financial['business_health_score'])[0, 1]
scatter3 = axes[1, 1].scatter(df_financial['high_vol_pct'], df_financial['business_health_score'], 
                             color='purple', s=100, alpha=0.7)
axes[1, 1].set_xlabel('High Volatility Customers %')
axes[1, 1].set_ylabel('Business Health Score')
axes[1, 1].set_title(f'High Volatility vs Business Health (corr: {correlation:.3f})')
axes[1, 1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('/workspace/financial_impact.png', dpi=300, bbox_inches='tight')
plt.close()

# 4. Risk exposure from balance sheet
print("Creating visualization 4: Balance Sheet Risk Analysis...")
df_balance = pd.read_sql_query("""
    SELECT account_class, account_type, account_sub_type, 
           SUM(amount) as total_amount,
           COUNT(*) as account_count
    FROM quickbooks__balance_sheet 
    WHERE account_class IS NOT NULL 
    GROUP BY account_class, account_type, account_sub_type
    ORDER BY account_class, total_amount DESC
""", conn)

# Filter for relevant account types (focus on receivables)
receivables_accounts = ['Accounts Receivable', 'Current Assets', 'Accounts Payable', 'Current Liabilities']
df_filtered = df_balance[df_balance['account_type'].isin(receivables_accounts)]

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Pie chart of account classes
account_class_totals = df_balance.groupby('account_class')['total_amount'].sum()
axes[0].pie(account_class_totals.values, labels=account_class_totals.index, 
           autopct='%1.1f%%', startangle=90, colors=['lightcoral', 'lightblue', 'lightgreen'])
axes[0].set_title('Balance Sheet Account Class Distribution')

# Bar chart of receivables structure
if not df_filtered.empty:
    bars = axes[1].barh(range(len(df_filtered)), df_filtered['total_amount'].values, color='salmon')
    axes[1].set_yticks(range(len(df_filtered)))
    axes[1].set_yticklabels(df_filtered['account_sub_type'])
    axes[1].set_xlabel('Total Amount')
    axes[1].set_title('Accounts Receivable/Payable Structure')
    axes[1].invert_yaxis()  # Largest on top
    # Add value labels
    for i, v in enumerate(df_filtered['total_amount'].values):
        axes[1].text(v, i, f'${v:,.0f}', va='center', fontsize=9)
else:
    axes[1].text(0.5, 0.5, 'No receivables/payables data found', 
                ha='center', va='center', transform=axes[1].transAxes)
    axes[1].set_title('No Relevant Data Available')

plt.tight_layout()
plt.savefig('/workspace/risk_exposure.png', dpi=300, bbox_inches='tight')
plt.close()

# 5. Multi-dimensional risk rating visualization
print("Creating visualization 5: Risk Rating Model...")
df_risk = pd.read_sql_query("""
    SELECT p.customer_id, p.customer_margin_volatility,
           c.rfm_segment, c.payment_behavior, c.credit_grade,
           c.overall_customer_score, c.risk_assessment,
           p.customer_gross_margin_pct,
           c.revenue_volatility,
           CASE WHEN p.customer_margin_volatility >= 0.252198 THEN 1 ELSE 0 END as high_vol_flag
    FROM quickbooks__profitability_analysis p
    LEFT JOIN quickbooks__customer_analytics c 
    ON p.customer_id = c.customer_id
    WHERE p.customer_margin_volatility IS NOT NULL
    AND c.overall_customer_score IS NOT NULL
    LIMIT 1000  -- Sample for visualization
""", conn)

# Create a simple risk score based on multiple factors
if not df_risk.empty:
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    
    # Risk assessment distribution
    risk_counts = df_risk['risk_assessment'].value_counts()
    axes[0, 0].bar(risk_counts.index, risk_counts.values, color=['red', 'orange', 'yellow', 'green'])
    axes[0, 0].set_xlabel('Risk Assessment')
    axes[0, 0].set_ylabel('Count')
    axes[0, 0].set_title('Customer Risk Assessment Distribution')
    for i, v in enumerate(risk_counts.values):
        axes[0, 0].text(i, v + 5, str(v), ha='center', fontsize=10)
    
    # Scatter: Overall score vs Margin volatility
    scatter4 = axes[0, 1].scatter(df_risk['customer_margin_volatility'], 
                                 df_risk['overall_customer_score'],
                                 c=df_risk['high_vol_flag'], 
                                 cmap='RdYlGn', alpha=0.7, s=50)
    axes[0, 1].set_xlabel('Customer Margin Volatility')
    axes[0, 1].set_ylabel('Overall Customer Score')
    axes[0, 1].set_title('Risk vs Customer Score (Green=Low Vol, Red=High Vol)')
    axes[0, 1].grid(True, alpha=0.3)
    
    # Box plot: Volatility by payment behavior
    payment_groups = []
    payment_labels = []
    for behavior in df_risk['payment_behavior'].unique():
        if behavior and pd.notna(behavior):
            data = df_risk[df_risk['payment_behavior'] == behavior]['customer_margin_volatility']
            if len(data) > 5:  # Only include groups with enough data
                payment_groups.append(data)
                payment_labels.append(behavior)
    
    if payment_groups:
        bp = axes[1, 0].boxplot(payment_groups, labels=payment_labels, patch_artist=True)
        # Color boxes
        colors = ['lightblue', 'lightgreen', 'lightcoral', 'gold']
        for patch, color in zip(bp['boxes'], colors[:len(payment_groups)]):
            patch.set_facecolor(color)
        axes[1, 0].set_xlabel('Payment Behavior')
        axes[1, 0].set_ylabel('Margin Volatility')
        axes[1, 0].set_title('Margin Volatility by Payment Behavior')
        axes[1, 0].tick_params(axis='x', rotation=45)
    
    # Heatmap-style: RFM segment vs Credit Grade for high volatility
    high_vol_df = df_risk[df_risk['high_vol_flag'] == 1]
    if not high_vol_df.empty and 'rfm_segment' in high_vol_df.columns and 'credit_grade' in high_vol_df.columns:
        cross_tab = pd.crosstab(high_vol_df['rfm_segment'], high_vol_df['credit_grade'])
        im = axes[1, 1].imshow(cross_tab.values, cmap='YlOrRd', aspect='auto')
        axes[1, 1].set_xlabel('Credit Grade')
        axes[1, 1].set_ylabel('RFM Segment')
        axes[1, 1].set_title('High Volatility Customers: RFM vs Credit Grade')
        axes[1, 1].set_xticks(range(len(cross_tab.columns)))
        axes[1, 1].set_xticklabels(cross_tab.columns, rotation=45)
        axes[1, 1].set_yticks(range(len(cross_tab.index)))
        axes[1, 1].set_yticklabels(cross_tab.index)
        plt.colorbar(im, ax=axes[1, 1], label='Count')
    else:
        axes[1, 1].text(0.5, 0.5, 'Insufficient data for heatmap', 
                       ha='center', va='center', transform=axes[1, 1].transAxes)
        axes[1, 1].set_title('High Volatility Customers: RFM vs Credit Grade')
    
    plt.tight_layout()
    plt.savefig('/workspace/risk_rating_model.png', dpi=300, bbox_inches='tight')
    plt.close()

conn.close()
print("All visualizations created successfully!")
