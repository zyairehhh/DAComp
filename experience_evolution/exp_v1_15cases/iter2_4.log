import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

def parse_tags(tag_string):
    """Parse tags string into dictionary."""
    if not tag_string:
        return {}
    tags = tag_string.split('|')
    result = {}
    for tag in tags:
        if ':' in tag:
            key, value = tag.split(':', 1)
            result[key] = value
    return result

def main():
    conn = sqlite3.connect('/workspace/dacomp-098.sqlite')
    # Load conversations
    conv_query = """
        SELECT c.*, m.first_admin_response_at, m.time_to_first_response_minutes,
               m.first_contact_reply_at, m.time_to_first_assignment_minutes,
               m.first_assignment_at
        FROM intercom__conversation_enhanced c
        LEFT JOIN intercom__conversation_metrics m ON c.conversation_id = m.conversation_id
    """
    df = pd.read_sql_query(conv_query, conn)
    print(f"Total conversations: {len(df)}")
    
    # Parse tags
    df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
    df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
    df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
    df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
    df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))
    df['lifecycle'] = df['tags_dict'].apply(lambda d: d.get('lifecycle', ''))
    
    # Segment by first responder type
    df['bot_first'] = df['conversation_initiated_type'] == 'bot_first'
    
    # Display distribution
    print("\nStage distribution:")
    print(df['stage'].value_counts(dropna=False).head(20))
    
    # Conversion funnel definition:
    # 1. demo_booked after start conversation
    # 2. trial_activated after demo_booked
    # 3. paid after trial_activated (assuming closed_won = paid)
    
    # Need to track per contact progression. Use contact ID.
    # We'll group by contact and order by conversation_created_at
    # Determine highest stage per contact?
    # Let's first create mapping contact -> list of conversations ordered by date.
    # Since we need to know sequence, we'll load contacts.
    contacts = pd.read_sql_query("SELECT contact_id, all_contact_company_names FROM intercom__contact_enhanced", conn)
    # Merge contact ID from conversation (all_conversation_contacts)
    df['contact_id'] = df['all_conversation_contacts'].str.split(',').str[0]  # might be multiple? but seems single
    # Merge company name
    df = df.merge(contacts, how='left', left_on='contact_id', right_on='contact_id')
    
    # For each contact, order conversations by created_at
    df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
    df.sort_values(['contact_id', 'conversation_created_at'], inplace=True)
    
    # Determine for each contact the sequence of stages
    # We'll compute the first occurrence of each stage
    contact_stages = df.groupby('contact_id').agg({
        'stage': list,
        'conversation_created_at': list,
        'bot_first': lambda x: x.iloc[0] if len(x) > 0 else None
    })
    
    # Compute conversion metrics per bot vs human
    # We'll create a separate DataFrame with one row per contact, with flags for each stage reached.
    contact_max_stage = df.groupby('contact_id').agg({
        'stage': lambda x: x.tolist(),
        'conversation_initiated_type': 'first'
    })
    # Let's compute whether demo_booked ever reached, trial_activated, closed_won.
    contact_max_stage['demo_booked'] = contact_max_stage['stage'].apply(lambda lst: 'demo_booked' in lst)
    contact_max_stage['trial_activated'] = contact_max_stage['stage'].apply(lambda lst: 'trial_activated' in lst)
    contact_max_stage['trial_started'] = contact_max_stage['stage'].apply(lambda lst: 'trial_started' in lst)
    contact_max_stage['closed_won'] = contact_max_stage['stage'].apply(lambda lst: 'closed_won' in lst)
    
    # Count conversations per contact
    conv_counts = df.groupby('contact_id').size().rename('conversation_count')
    contact_max_stage = contact_max_stage.join(conv_counts)
    
    # Split by first responder type (bot_first vs human_first)
    # We'll use the first conversation's initiation type.
    contact_first_type = df.groupby('contact_id')['conversation_initiated_type'].first()
    contact_max_stage['first_response_type'] = contact_first_type
    bot_contacts = contact_max_stage[contact_max_stage['first_response_type'] == 'bot_first']
    human_contacts = contact_max_stage[contact_max_stage['first_response_type'] == 'human_first']
    
    # Compute conversion rates
    def compute_rates(df_sub):
        total = len(df_sub)
        demo = df_sub['demo_booked'].sum()
        trial = df_sub['trial_activated'].sum()
        closed = df_sub['closed_won'].sum()
        # rate stage1: demo / total
        rate1 = demo / total if total > 0 else 0
        # rate stage2: trial / demo (if demo>0)
        rate2 = trial / demo if demo > 0 else 0
        # rate stage3: closed / trial (if trial>0)
        rate3 = closed / trial if trial > 0 else 0
        return total, demo, trial, closed, rate1, rate2, rate3
    
    total_bot, demo_bot, trial_bot, closed_bot, r1_bot, r2_bot, r3_bot = compute_rates(bot_contacts)
    total_human, demo_human, trial_human, closed_human, r1_human, r2_human, r3_human = compute_rates(human_contacts)
    
    print("\n=== Conversion Rates by First Response Type ===")
    print(f"Bot-first contacts: {total_bot}")
    print(f"  Demo booked rate: {r1_bot:.2%} ({demo_bot}/{total_bot})")
    print(f"  Trial activation rate (given demo): {r2_bot:.2%} ({trial_bot}/{demo_bot})")
    print(f"  Paid conversion rate (given trial): {r3_bot:.2%} ({closed_bot}/{trial_bot})")
    print(f"Human-first contacts: {total_human}")
    print(f"  Demo booked rate: {r1_human:.2%} ({demo_human}/{total_human})")
    print(f"  Trial activation rate (given demo): {r2_human:.2%} ({trial_human}/{demo_human})")
    print(f"  Paid conversion rate (given trial): {r3_human:.2%} ({closed_human}/{trial_human})")
    
    # Compute stage durations (average days between events)
    # For each contact, we need timestamps of first demo_booked, first trial_activated, first closed_won
    # We'll create a DataFrame of events
    events = []
    for contact_id, group in df.groupby('contact_id'):
        # sort by date
        group = group.sort_values('conversation_created_at')
        # find first occurrence of each stage
        demo_row = group[group['stage'] == 'demo_booked'].head(1)
        trial_row = group[group['stage'] == 'trial_activated'].head(1)
        closed_row = group[group['stage'] == 'closed_won'].head(1)
        # get timestamps
        demo_ts = demo_row['conversation_created_at'].iloc[0] if not demo_row.empty else None
        trial_ts = trial_row['conversation_created_at'].iloc[0] if not trial_row.empty else None
        closed_ts = closed_row['conversation_created_at'].iloc[0] if not closed_row.empty else None
        # first response type from first conversation
        first_type = group['conversation_initiated_type'].iloc[0]
        events.append({
            'contact_id': contact_id,
            'first_response_type': first_type,
            'demo_ts': demo_ts,
            'trial_ts': trial_ts,
            'closed_ts': closed_ts
        })
    events_df = pd.DataFrame(events)
    
    # Compute intervals in days
    events_df['demo_to_trial_days'] = (events_df['trial_ts'] - events_df['demo_ts']).dt.total_seconds() / (24*3600)
    events_df['trial_to_closed_days'] = (events_df['closed_ts'] - events_df['trial_ts']).dt.total_seconds() / (24*3600)
    
    # Compute averages per group
    bot_events = events_df[events_df['first_response_type'] == 'bot_first']
    human_events = events_df[events_df['first_response_type'] == 'human_first']
    
    avg_demo_to_trial_bot = bot_events['demo_to_trial_days'].mean(skipna=True)
    avg_trial_to_closed_bot = bot_events['trial_to_closed_days'].mean(skipna=True)
    avg_demo_to_trial_human = human_events['demo_to_trial_days'].mean(skipna=True)
    avg_trial_to_closed_human = human_events['trial_to_closed_days'].mean(skipna=True)
    
    print("\n=== Average Stage Durations (days) ===")
    print(f"Bot-first: demo to trial: {avg_demo_to_trial_bot:.2f} days")
    print(f"Bot-first: trial to closed: {avg_trial_to_closed_bot:.2f} days")
    print(f"Human-first: demo to trial: {avg_demo_to_trial_human:.2f} days")
    print(f"Human-first: trial to closed: {avg_trial_to_closed_human:.2f} days")
    
    # Also compute time from conversation start to demo booked (first response to booking) using time_to_first_response_minutes? Not straightforward.
    # But we have first_admin_response_at and conversation_created_at. We can compute time to first response.
    df['time_to_first_response_days'] = df['time_to_first_response_minutes'] / (24*60)
    bot_df = df[df['bot_first'] == True]
    human_df = df[df['bot_first'] == False]
    avg_response_time_bot = bot_df['time_to_first_response_days'].mean(skipna=True)
    avg_response_time_human = human_df['time_to_first_response_days'].mean(skipna=True)
    print("\n=== Average Time to First Response (days) ===")
    print(f"Bot-first: {avg_response_time_bot:.3f} days")
    print(f"Human-first: {avg_response_time_human:.3f} days")
    
    # Additional analysis by intent, segment, region, lifecycle
    # For each dimension, compute conversion rates for bot vs human
    dimensions = ['intent', 'segment', 'region', 'lifecycle']
    for dim in dimensions:
        print(f"\n=== Conversion rates by {dim} and first response type ===")
        for val in df[dim].unique():
            if pd.isna(val) or val == '':
                continue
            subset = df[df[dim] == val]
            # get unique contacts in this subset
            contact_ids = subset['contact_id'].unique()
            contact_sub = contact_max_stage[contact_max_stage.index.isin(contact_ids)]
            bot_sub = contact_sub[contact_sub['first_response_type'] == 'bot_first']
            human_sub = contact_sub[contact_sub['first_response_type'] == 'human_first']
            total_b = len(bot_sub)
            total_h = len(human_sub)
            if total_b + total_h == 0:
                continue
            demo_b = bot_sub['demo_booked'].sum()
            trial_b = bot_sub['trial_activated'].sum()
            closed_b = bot_sub['closed_won'].sum()
            demo_h = human_sub['demo_booked'].sum()
            trial_h = human_sub['trial_activated'].sum()
            closed_h = human_sub['closed_won'].sum()
            rate1_b = demo_b / total_b if total_b > 0 else 0
            rate1_h = demo_h / total_h if total_h > 0 else 0
            print(f"{dim}: {val}")
            print(f"  Bot: contacts={total_b}, demo rate={rate1_b:.2%}, trial rate={trial_b/demo_b:.2% if demo_b>0 else 'N/A'}, paid rate={closed_b/trial_b:.2% if trial_b>0 else 'N/A'}")
            print(f"  Human: contacts={total_h}, demo rate={rate1_h:.2%}, trial rate={trial_h/demo_h:.2% if demo_h>0 else 'N/A'}, paid rate={closed_h/trial_h:.2% if trial_h>0 else 'N/A'}")
    
    conn.close()
    print("\nAnalysis complete.")

if __name__ == '__main__':
    main()
