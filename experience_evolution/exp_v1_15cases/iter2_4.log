# Now compute contribution to business_health_score and collection_rate_percentage from financial_dashboard
# Need to link customers to financial_dashboard? Financial dashboard is aggregated per month, not per customer.
# However we can approximate impact by comparing months where high-volatility customers contributed more revenue vs others.
# Let's compute total revenue from high-volatility customers per month and correlate with business_health_score.
# First, get monthly total revenue per high-volatility customer group and other customers.
dashboard_query = """
SELECT dashboard_month, total_revenue, business_health_score, collection_rate_percentage
FROM quickbooks__financial_dashboard
ORDER BY dashboard_month;
"""
dashboard_df = pd.read_sql_query(dashboard_query, conn)
print("\nFinancial dashboard sample:")
print(dashboard_df.head())

# Revenue from high-volatility customers per month
monthly_high_vol_rev_query = """
SELECT strftime('%Y-%m', transaction_date) AS month, SUM(invoice_total) AS high_vol_revenue
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({})
GROUP BY month
""".format(','.join(['?'] * len(customer_ids)))
monthly_high_vol_rev = pd.read_sql_query(monthly_high_vol_rev_query, conn, params=customer_ids)
