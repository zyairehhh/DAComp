import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib
import seaborn as sns

# Set style
plt.style.use('seaborn-v0_8-darkgrid')
matplotlib.rcParams['font.family'] = 'sans-serif'
matplotlib.rcParams['font.size'] = 10

# Load computed data
df = pd.read_csv('user_scores.csv')

# Create a color palette
tier_colors = {'Low-Value': '#FF6B6B', 'Medium-Value': '#FFD166', 'High-Value': '#06D6A0'}

# Visualization 7: Composite Score Distribution by Tier
fig, ax = plt.subplots(figsize=(10, 6))

# Create violin plot
violin_parts = ax.violinplot([
    df[df['value_tier'] == 'Low-Value']['composite_score'],
    df[df['value_tier'] == 'Medium-Value']['composite_score'],
    df[df['value_tier'] == 'High-Value']['composite_score']
], showmeans=True, showmedians=True)

# Color the violins
for i, pc in enumerate(violin_parts['bodies']):
    pc.set_facecolor(list(tier_colors.values())[i])
    pc.set_edgecolor('black')
    pc.set_alpha(0.7)

# Customize the plot
ax.set_title('Composite Score Distribution by Value Tier', fontsize=14, fontweight='bold')
ax.set_ylabel('Composite Score (0-100)', fontsize=12)
ax.set_xlabel('Value Tier', fontsize=12)
ax.set_xticks([1, 2, 3])
ax.set_xticklabels(['Low-Value', 'Medium-Value', 'High-Value'])
ax.grid(True, alpha=0.3)

# Add tier thresholds as horizontal lines
low_threshold = df['composite_score'].quantile(0.33)
high_threshold = df['composite_score'].quantile(0.66)
ax.axhline(y=low_threshold, color='gray', linestyle='--', alpha=0.5, label=f'Low/Medium Threshold: {low_threshold:.1f}')
ax.axhline(y=high_threshold, color='gray', linestyle='--', alpha=0.5, label=f'Medium/High Threshold: {high_threshold:.1f}')

ax.legend()
plt.tight_layout()
plt.savefig('score_distribution_by_tier.png', dpi=300, bbox_inches='tight')
plt.close()

# Visualization 8: Behavioral Metrics Swarm Plot (simplified to box plot for clarity)
fig, axes = plt.subplots(2, 2, figsize=(12, 10))
metrics_to_plot = ['total_count_surveys', 'completion_rate', 'avg_survey_progress_pct', 'cross_channel_score']
metric_names = ['Total Surveys', 'Completion Rate', 'Average Progress (%)', 'Cross-Channel Score']
y_labels = ['Count', 'Rate (0-1)', 'Percentage', 'Binary (0/1)']

for idx, (metric, name, ylabel) in enumerate(zip(metrics_to_plot, metric_names, y_labels)):
    ax = axes[idx // 2, idx % 2]
    
    # Prepare data for box plot
    plot_data = []
    for tier in ['Low-Value', 'Medium-Value', 'High-Value']:
        plot_data.append(df[df['value_tier'] == tier][metric])
    
    # Create box plot
    bp = ax.boxplot(plot_data, patch_artist=True, 
                   boxprops=dict(facecolor='lightgray', alpha=0.7),
                   medianprops=dict(color='red', linewidth=2),
                   whiskerprops=dict(color='black'),
                   capprops=dict(color='black'),
                   flierprops=dict(marker='o', markersize=3, alpha=0.5))
    
    # Color the boxes
    for i, patch in enumerate(bp['boxes']):
        patch.set_facecolor(list(tier_colors.values())[i])
    
    ax.set_title(name, fontsize=12, fontweight='bold')
    ax.set_ylabel(ylabel)
    ax.set_xlabel('Value Tier')
    ax.set_xticks([1, 2, 3])
    ax.set_xticklabels(['Low', 'Medium', 'High'])
    
    # Add mean markers
    for i, tier in enumerate(['Low-Value', 'Medium-Value', 'High-Value']):
        mean_val = df[df['value_tier'] == tier][metric].mean()
        ax.plot(i+1, mean_val, 'D', markersize=8, color='blue', label='Mean' if i == 0 else '')

fig.suptitle('Behavioral Metrics Distribution by Value Tier', fontsize=14, fontweight='bold', y=0.98)
plt.tight_layout(rect=[0, 0, 1, 0.96])
plt.savefig('metrics_distribution_by_tier.png', dpi=300, bbox_inches='tight')
plt.close()

# Visualization 9: Transition Probability Heatmap (Conceptual)
fig, ax = plt.subplots(figsize=(8, 6))

# Create a conceptual heatmap showing transition probabilities
transition_matrix = np.array([
    [0.7, 0.25, 0.05],   # From Low-Value
    [0.15, 0.6, 0.25],    # From Medium-Value
    [0.05, 0.2, 0.75]     # From High-Value
])

# Create heatmap
im = ax.imshow(transition_matrix, cmap='YlOrRd', vmin=0, vmax=1)

# Add text annotations
for i in range(3):
    for j in range(3):
        text = ax.text(j, i, f'{transition_matrix[i, j]:.2f}',
                      ha="center", va="center", color="black", fontweight='bold')

# Set labels
ax.set_title('Conceptual Transition Probability Matrix', fontsize=14, fontweight='bold')
ax.set_xlabel('To Tier', fontsize=12)
ax.set_ylabel('From Tier', fontsize=12)
ax.set_xticks([0, 1, 2])
ax.set_yticks([0, 1, 2])
ax.set_xticklabels(['Low', 'Medium', 'High'])
ax.set_yticklabels(['Low', 'Medium', 'High'])

# Add colorbar
cbar = plt.colorbar(im, ax=ax)
cbar.set_label('Transition Probability', rotation=270, labelpad=15)

plt.tight_layout()
plt.savefig('transition_probability_matrix.png', dpi=300, bbox_inches='tight')
plt.close()

print("Additional visualizations created successfully!")
''')
