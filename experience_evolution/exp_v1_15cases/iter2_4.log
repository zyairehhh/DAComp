'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

completed = df[df['Booking Status'] == 'Completed']
completed = completed.dropna(subset=['Booking Value', 'Ride Distance'])
completed['Booking Value'] = pd.to_numeric(completed['Booking Value'], errors='coerce')
completed['Ride Distance'] = pd.to_numeric(completed['Ride Distance'], errors='coerce')
completed = completed[(completed['Booking Value'] > 0) & (completed['Ride Distance'] > 0)]
completed['fare_per_km'] = completed['Booking Value'] / completed['Ride Distance']
completed['Driver Ratings'] = pd.to_numeric(completed['Driver Ratings'], errors='coerce')

print("Average fare per km:", completed['fare_per_km'].mean())
print("Median fare per km:", completed['fare_per_km'].median())
print("Count of completed rides:", completed.shape[0])

avg_by_vehicle = completed.groupby('Vehicle Type')['fare_per_km'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nBy Vehicle Type:")
print(avg_by_vehicle)

# rating groups
completed['rating_group'] = pd.cut(completed['Driver Ratings'], bins=[0,1,2,3,4,5], labels=['0-1','1-2','2-3','3-4','4-5'])
rating_stats = completed.groupby('rating_group')['fare_per_km'].agg(['mean', 'median', 'count'])
print("\nBy Rating Group:")
print(rating_stats)

# correlation
print("\nCorrelation between Driver Rating and fare per km:", completed['Driver Ratings'].corr(completed['fare_per_km']))
''')

