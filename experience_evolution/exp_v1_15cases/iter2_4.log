import pandas as pd
import sqlite3
conn = sqlite3.connect('dacomp-067.sqlite')

# Get source metrics from talent_pipeline
df = pd.read_sql_query("""
SELECT source_id, source_name, total_applications, total_hires, hire_rate, interview_rate,
       interview_to_hire_rate, avg_process_days, efficiency_score,
       applications_with_interviews
FROM greenhouse__talent_pipeline_simplified
WHERE application_year=2024 AND application_quarter=4
""", conn)

# Compute retention rates per stage? Not available, skip.

# Get candidate quality (quality score) per source
quality = pd.read_sql_query("""
SELECT tps.source_name, AVG(cs.candidate_quality_score) as avg_quality
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
GROUP BY tps.source_name
""", conn)
df = df.merge(quality, on='source_name', how='left')

# Get average interview rating per source
rating = pd.read_sql_query("""
SELECT tps.source_name, AVG(scd.rating) as avg_rating
FROM greenhouse__interview_scorecard_detail scd
JOIN greenhouse__interview_enhanced ie ON scd.scorecard_id = ie.scorecard_id
JOIN greenhouse__application_enhanced ae ON ie.application_id = ae.application_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE scd.rating IS NOT NULL
GROUP BY tps.source_name
""", conn)
df = df.merge(rating, on='source_name', how='left')

# Diversity representation (non-white) per source
div = pd.read_sql_query("""
SELECT tps.source_name,
       SUM(CASE WHEN ae.candidate_gender = 'female' THEN 1 ELSE 0 END) as female_apps,
       SUM(CASE WHEN ae.candidate_gender = 'male' THEN 1 ELSE 0 END) as male_apps,
       SUM(CASE WHEN ae.candidate_race != 'White' AND ae.candidate_race IS NOT NULL THEN 1 ELSE 0 END) as non_white_apps
FROM greenhouse__application_enhanced ae
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
GROUP BY tps.source_name
""", conn)
div['female_rate'] = div['female_apps'] / (div['female_apps'] + div['male_apps'] + 1e-9) * 100
div['non_white_rate'] = div['non_white_apps'] / (div['female_apps'] + div['male_apps'] + 1e-9) * 100
df = df.merge(div[['source_name','female_rate','non_white_rate']], on='source_name', how='left')

# Cost per hire estimates
cost_map = {'Headhunter':20, 'University Recruiting':5, 'Employee Referral':2,
            'LinkedIn':0.5, 'Indeed':0.5, 'Glassdoor':0.5, 'AngelList':0.5, 'Company Website':0.1}
df['cost_per_hire'] = df['source_name'].map(cost_map)
df['current_cost'] = df['total_hires'] * df['cost_per_hire']

# Normalize metrics for composite score (higher is better)
def norm(s):
    return (s - s.min()) / (s.max() - s.min() + 1e-9)

df['hire_rate_norm'] = norm(df['hire_rate'])
df['interview_rate_norm'] = norm(df['interview_rate'])
df['interview_to_hire_norm'] = norm(df['interview_to_hire_rate'])
df['efficiency_norm'] = norm(df['efficiency_score'])
df['process_speed_norm'] = norm(1 / df['avg_process_days'])
df['quality_norm'] = norm(df['avg_quality'])
df['rating_norm'] = norm(df['avg_rating'])
df['female_norm'] = norm(df['female_rate'])
df['non_white_norm'] = norm(df['non_white_rate'])
df['cost_norm'] = norm(1 / df['cost_per_hire'])  # invert cost

# Weighted composite
weights = {
    'hire_rate_norm': 0.15,
    'interview_rate_norm': 0.1,
    'interview_to_hire_norm': 0.1,
    'efficiency_norm': 0.1,
    'process_speed_norm': 0.1,
    'quality_norm': 0.15,
    'rating_norm': 0.15,
    'female_norm': 0.1,
    'non_white_norm': 0.05,
    'cost_norm': 0.1
}
df['composite_score'] = sum(df[w] * weight for w, weight in weights.items())

# Rank sources
df = df.sort_values('composite_score', ascending=False)
print("Source ranking:")
print(df[['source_name','total_hires','cost_per_hire','current_cost','avg_rating','female_rate','non_white_rate','composite_score']].to_string(index=False))
''')
