import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo_market_analysis for the app
query = """
SELECT region, country,
       avg_transaction_value,
       average_revenue_per_user,
       overall_market_score,
       app_quality_score,
       store_performance_score,
       avg_daily_revenue,
       avg_active_devices,
       revenue_last_30_days,
       weekly_growth_rate,
       market_maturity_level,
       investment_recommendation,
       opportunity_type
FROM google_play__geo_market_analysis
WHERE package_name = 'com.dev.photoeditor'
"""
df = pd.read_sql_query(query, conn)

# Compute daily revenue per active device
df['daily_rev_per_device'] = df['avg_daily_revenue'] / df['avg_active_devices']

# Group by region
region_group = df.groupby('region').agg(
    countries=('country', 'count'),
    avg_transaction_value_mean=('avg_transaction_value', 'mean'),
    avg_transaction_value_min=('avg_transaction_value', 'min'),
    avg_transaction_value_max=('avg_transaction_value', 'max'),
    arpu_mean=('average_revenue_per_user', 'mean'),
    overall_market_score_mean=('overall_market_score', 'mean'),
    app_quality_score_mean=('app_quality_score', 'mean'),
    store_performance_score_mean=('store_performance_score', 'mean'),
    total_revenue_last_30_days=('revenue_last_30_days', 'sum'),
    avg_weekly_growth_rate=('weekly_growth_rate', 'mean'),
    daily_rev_per_device_mean=('daily_rev_per_device', 'mean'),
    avg_active_devices_sum=('avg_active_devices', 'sum')
).reset_index()

print("Region-level aggregates:")
print(region_group.round(2))

# Identify top markets with avg_transaction_value > 7
# Actually all except Indonesia? Indonesia has 6.85 < 7. So top markets: avg_transaction_value > 7
top_markets = df[df['avg_transaction_value'] > 7]
low_markets = df[df['avg_transaction_value'] <= 7]  # includes Indonesia and maybe others? Actually Indonesia <=7, but also all others >7 except? Let's compute.
print("\nTop markets (avg_transaction_value > $7):")
print(top_markets[['country', 'region', 'avg_transaction_value', 'overall_market_score']])
print("\nLow markets (avg_transaction_value <= $7):")
print(low_markets[['country', 'region', 'avg_transaction_value', 'overall_market_score']])

# Compare performance scores between top and low markets
print("\nPerformance comparison between top and low markets:")
print("Top markets average overall_market_score:", top_markets['overall_market_score'].mean())
print("Low markets average overall_market_score:", low_markets['overall_market_score'].mean())
print("Top markets average app_quality_score:", top_markets['app_quality_score'].mean())
print("Low markets average app_quality_score:", low_markets['app_quality_score'].mean())
print("Top markets average store_performance_score:", top_markets['store_performance_score'].mean())
print("Low markets average store_performance_score:", low_markets['store_performance_score'].mean())

# Analyze correlation between avg_transaction_value and overall_market_score
corr = df[['avg_transaction_value', 'average_revenue_per_user', 'overall_market_score', 'app_quality_score']].corr()
print("\nCorrelation matrix:")
print(corr)

# Compute overall performance trend over time
query2 = """
SELECT date_day, overall_performance_score, research_budget_usd
FROM google_play__comprehensive_performance_dashboard
WHERE package_name = 'com.dev.photoeditor'
ORDER BY date_day
"""
df_trend = pd.read_sql_query(query2, conn)
print("\nMonthly performance score and budget:")
print(df_trend)

# Compute monthly average of regional scores? Not available.

# Let's also look at finance_report to see revenue trends per region over time? But we need to aggregate.
# Let's compute total revenue per region from finance_report over the past 12 months.
query3 = """
SELECT region, SUM(net_amount) as total_net_revenue, COUNT(DISTINCT country_short) as countries
FROM google_play__finance_report
WHERE package_name = 'com.dev.photoeditor'
    AND date_day >= '2024-01-01'  # approximate 12 months
GROUP BY region
"""
df_finance = pd.read_sql_query(query3, conn)
print("\nTotal revenue per region (from finance_report):")
print(df_finance.round(2))

conn.close()
''')
