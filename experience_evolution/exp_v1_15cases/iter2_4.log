'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re

# Connect to the database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Filter for vocational school graduates
voc_df = df[df['Education Requirement'].str.contains('Vocational school', na=False, case=False)].copy()

# Extract salary
def extract_salary_bounds(salary_str):
    if pd.isna(salary_str):
        return None, None
    numbers = re.findall(r'[\d,]+\.?\d*', salary_str.replace(',', ''))
    if not numbers:
        return None, None
    nums = [int(float(num)) for num in numbers if float(num) < 100000]
    if len(nums) >= 2:
        lower = min(nums[:2])
        upper = max(nums[:2])
        if lower > 0 and upper <= 30000 and lower <= upper:
            return lower, upper
    return None, None

bounds = voc_df['Salary Range'].apply(extract_salary_bounds)
voc_df.loc[:, 'salary_lower'] = bounds.apply(lambda x: x[0] if x else None)
voc_df.loc[:, 'salary_upper'] = bounds.apply(lambda x: x[1] if x else None)
voc_df.loc[:, 'salary_mid'] = voc_df.apply(lambda row: (row['salary_lower'] + row['salary_upper']) / 2 
                                    if row['salary_lower'] and row['salary_upper'] else None, axis=1)

# Remove rows with missing salary
salary_df = voc_df.dropna(subset=['salary_lower', 'salary_upper']).copy()

# 1. Foreign language requirement analysis
def simplify_language(req):
    if pd.isna(req):
        return 'None'
    req = str(req).lower()
    if 'english' in req:
        return 'English required'
    elif 'chinese' in req:
        return 'Chinese required'
    elif 'japanese' in req:
        return 'Japanese required'
    elif 'hokkien' in req:
        return 'Hokkien required'
    elif 'spanish' in req:
        return 'Spanish required'
    elif 'canton' in req:
        return 'Cantonese required'
    elif 'other' in req:
        return 'Other language'
    else:
        return 'None'

salary_df.loc[:, 'language_simple'] = salary_df['Foreign Language Requirement'].apply(simplify_language)
language_salary = salary_df.groupby('language_simple')['salary_mid'].agg(['mean', 'count']).sort_values('mean', ascending=False)

plt.figure(figsize=(10, 6))
bars = plt.bar(language_salary.index, language_salary['mean'], alpha=0.7)
plt.xlabel('Foreign Language Requirement')
plt.ylabel('Average Monthly Salary (RMB)')
plt.title('Average Salary by Foreign Language Requirement\nfor Vocational School Graduates')
plt.xticks(rotation=45, ha='right')
# Add count labels
for i, (idx, row) in enumerate(language_salary.iterrows()):
    plt.text(i, row['mean'] + 50, f'n={int(row["count"])}', ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('language_salary.png', dpi=150)
print("Saved language_salary.png")

# 2. Gender requirement analysis (clean up)
def simplify_gender(gender):
    if pd.isna(gender):
        return 'None'
    g = str(gender).lower().strip()
    if g == 'male':
        return 'Male only'
    elif g == 'female':
        return 'Female only'
    elif 'gender' in g or '男女' in g or '不限' in g:
        return 'Any gender'
    else:
        return 'Not specified'

salary_df.loc[:, 'gender_clean'] = salary_df['Gender Requirement'].apply(simplify_gender)
gender_salary = salary_df.groupby('gender_clean')['salary_mid'].agg(['mean', 'count']).sort_values('mean', ascending=False)

plt.figure(figsize=(10, 6))
bars = plt.bar(gender_salary.index, gender_salary['mean'], alpha=0.7)
plt.xlabel('Gender Requirement')
plt.ylabel('Average Monthly Salary (RMB)')
plt.title('Average Salary by Gender Requirement\nfor Vocational School Graduates')
plt.xticks(rotation=45, ha='right')
# Add count labels
for i, (idx, row) in enumerate(gender_salary.iterrows()):
    plt.text(i, row['mean'] + 50, f'n={int(row["count"])}', ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('gender_salary_clean.png', dpi=150)
print("Saved gender_salary_clean.png")

# 3. Employment type analysis
def simplify_employment(emp):
    if pd.isna(emp):
        return 'Unknown'
    e = str(emp).lower()
    if 'full' in e:
        return 'Full-time'
    elif 'part' in e:
        return 'Part-time'
    elif 'intern' in e:
        return 'Internship'
    else:
        return 'Other'

salary_df.loc[:, 'employment_clean'] = salary_df['Employment Type'].apply(simplify_employment)
employment_salary = salary_df.groupby('employment_clean')['salary_mid'].agg(['mean', 'count']).sort_values('mean', ascending=False)

plt.figure(figsize=(10,6))
bars = plt.bar(employment_salary.index, employment_salary['mean'], alpha=0.7)
plt.xlabel('Employment Type')
plt.ylabel('Average Monthly Salary (RMB)')
plt.title('Average Salary by Employment Type\nfor Vocational School Graduates')
plt.xticks(rotation=45, ha='right')
for i, (idx, row) in enumerate(employment_salary.iterrows()):
    plt.text(i, row['mean'] + 50, f'n={int(row["count"])}', ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('employment_salary.png', dpi=150)
print("Saved employment_salary.png")

# Print key insights
print("=== Key Insights ===")
print(f"Total vocational school jobs with salary data: {len(salary_df)}")
print("\n1. Language Requirement Impact:")
for lang, data in language_salary.iterrows():
    print(f"   {lang}: {data['mean']:.0f} RMB (n={int(data['count'])})")
print("\n2. Gender Requirement Impact:")
for gender, data in gender_salary.iterrows():
    print(f"   {gender}: {data['mean']:.0f} RMB (n={int(data['count'])})")
print("\n3. Employment Type Impact:")
for emp, data in employment_salary.iterrows():
    print(f"   {emp}: {data['mean']:.0f} RMB (n={int(data['count'])})")
''')
