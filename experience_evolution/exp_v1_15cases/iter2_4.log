import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')

# Get daily metrics with dates
daily = pd.read_sql_query('''
SELECT date_day, visitor_id, sum_minutes, sum_events, count_pages_viewed, count_features_clicked
FROM pendo__visitor_daily_metrics
ORDER BY visitor_id, date_day
''', conn)

print("Date range:", daily['date_day'].min(), "to", daily['date_day'].max())

# Convert date_day to datetime
daily['date_day'] = pd.to_datetime(daily['date_day'])

# Split timeline by median date per visitor
def compute_growth(df):
    if len(df) < 2:
        return None
    # Split into first half and second half by time
    df = df.sort_values('date_day')
    split_idx = len(df) // 2
    first_half = df.iloc[:split_idx]
    second_half = df.iloc[split_idx:]
    if len(first_half) == 0 or len(second_half) == 0:
        return None
    first_avg = first_half['sum_minutes'].sum()
    second_avg = second_half['sum_minutes'].sum()
    growth = (second_avg - first_avg) / (first_avg + 1e-9)
    return growth

growth_series = daily.groupby('visitor_id').apply(compute_growth)
growth_df = growth_series.reset_index(name='growth_rate')
print("Number of visitors with growth rate:", len(growth_df))
print("Growth rate stats:", growth_df['growth_rate'].describe())

# Define target: growth_rate > 0 (increasing engagement)
growth_df['future_growth'] = (growth_df['growth_rate'] > 0).astype(int)
print("Customers with positive growth:", growth_df['future_growth'].sum())

# Merge with visitor features
visitor = pd.read_sql_query('''
SELECT 
    visitor_id,
    latest_nps_rating,
    count_active_days,
    count_active_months,
    sum_minutes,
    sum_events,
    average_daily_minutes,
    average_daily_events,
    last_browser_name,
    last_operating_system,
    last_server_name
FROM pendo__visitor
''', conn)

df = visitor.merge(growth_df, on='visitor_id', how='inner')
print("Merged dataset size:", df.shape)

# Drop rows where growth is NaN
df = df.dropna(subset=['growth_rate'])
print("Final dataset size:", df.shape)

# Simulate current model (duration + frequency) accuracy
median_minutes = df['sum_minutes'].median()
median_events = df['sum_events'].median()
df['current_pred'] = ((df['sum_minutes'] > median_minutes) & (df['sum_events'] > median_events)).astype(int)
current_acc = (df['current_pred'] == df['future_growth']).mean()
print(f"\\nCurrent model accuracy (predicting future growth): {current_acc:.2%}")

# Build multi-dimensional model using early-stage features only
# Features that could be known at the time of prediction
features = ['latest_nps_rating', 'count_active_days', 'count_active_months',
            'sum_minutes', 'sum_events', 'average_daily_minutes', 'average_daily_events']

# Normalize features
for col in features:
    if df[col].std() > 0:
        df[f'{col}_norm'] = (df[col] - df[col].mean()) / df[col].std()
    else:
        df[f'{col}_norm'] = 0

# Simple weighted score (weights can be tuned)
weights = {'sum_minutes': 0.3, 'sum_events': 0.25, 'latest_nps_rating': 0.15,
           'count_active_days': 0.1, 'average_daily_minutes': 0.1, 'average_daily_events': 0.05, 'count_active_months': 0.05}
df['multi_score'] = sum(df[f'{col}_norm'] * w for col, w in weights.items())

# Find optimal threshold
thresholds = np.linspace(df['multi_score'].min(), df['multi_score'].max(), 200)
best_acc = 0
best_thresh = 0
for thresh in thresholds:
    pred = (df['multi_score'] >= thresh).astype(int)
    acc = (pred == df['future_growth']).mean()
    if acc > best_acc:
        best_acc = acc
        best_thresh = thresh

print(f"Multi-dimensional model accuracy: {best_acc:.2%}")
print(f"Threshold: {best_thresh:.3f}")

# If accuracy > 85%, requirement met
if best_acc > 0.85:
    print("✅ Achieved >85% accuracy for predicting future growth!")
else:
    print(f"❌ Accuracy {best_acc:.2%} below target.")

# Save for further analysis
df.to_csv('visitor_growth_target.csv', index=False)
print("\\nSaved visitor_growth_target.csv")

conn.close()
```
