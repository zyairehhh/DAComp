import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

# Connect to database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1 WHERE \"Education Requirement\" = 'Vocational school or above'", conn)
conn.close()

print(f"Total rows for vocational school or above: {len(df)}")

# Helper to extract numeric salary lower bound
def extract_salary_lower(sal_str):
    if isinstance(sal_str, str):
        # Find first number before hyphen or single number
        match = re.search(r'(\d+[\.,]?\d*)\s*[-~]\s*(\d+[\.,]?\d*)', sal_str)
        if match:
            lower = match.group(1).replace(',', '').replace('.', '')
            try:
                return int(lower)
            except:
                pass
        # If no hyphen, find standalone number
        match = re.search(r'(\d+[\.,]?\d*)', sal_str)
        if match:
            val = match.group(1).replace(',', '').replace('.', '')
            try:
                return int(val)
            except:
                pass
    return None

df['salary_lower'] = df['Salary Range'].apply(extract_salary_lower)

# Remove rows with missing salary
df_salary = df.dropna(subset=['salary_lower'])
print(f"Rows with parsable salary: {len(df_salary)}")

# 1. Starting salary distribution histogram
plt.figure(figsize=(10,6))
n, bins, patches = plt.hist(df_salary['salary_lower'], bins=50, edgecolor='black', alpha=0.7, color='skyblue')
plt.axvline(df_salary['salary_lower'].mean(), color='red', linestyle='--', label=f'Mean: {df_salary["salary_lower"].mean():.0f}')
plt.axvline(df_salary['salary_lower'].median(), color='green', linestyle='--', label=f'Median: {df_salary["salary_lower"].median():.0f}')
plt.xlabel('Monthly Salary Lower Bound (RMB)')
plt.ylabel('Frequency')
plt.title('Distribution of Starting Salaries for Vocational School Graduates')
plt.legend()
plt.grid(axis='y', alpha=0.5)
plt.savefig('salary_distribution_filtered.png', dpi=300, bbox_inches='tight')
plt.close()

# 2. Benefits distribution - top 10 (as in Stage1)
benefits_text = df['Benefits'].dropna().astype(str).tolist()
benefit_counts = {}
separators = ['、', ',', '，', ';', '；', 'and', '及', '以及', ' ']
for text in benefits_text:
    for sep in separators:
        text = text.replace(sep, '|')
    items = [item.strip() for item in text.split('|') if item.strip()]
    for item in items:
        if item in benefit_counts:
            benefit_counts[item] += 1
        else:
            benefit_counts[item] = 1

sorted_benefits = sorted(benefit_counts.items(), key=lambda x: x[1], reverse=True)
top10 = sorted_benefits[:10]
benefit_names = [b[0] for b in top10]
benefit_counts_vals = [b[1] for b in top10]

# Mapping Chinese benefit names to English
mapping = {
    '五险': 'Five social insurances',
    '带薪年假': 'Paid annual leave',
    '节日福利': 'Holiday benefits',
    '绩效奖金': 'Performance bonus',
    '全勤奖': 'Full attendance bonus',
    '年终奖': 'Year‑end bonus',
    '员工旅游': 'Employee travel',
    '住房公积金': 'Housing provident fund',
    '专业培训': 'Professional training',
    '加班补助': 'Overtime pay',
    '五险一金': 'Five social insurances + housing fund',
    '双休': 'Weekends off',
    '包吃': 'Meals provided',
    '包住': 'Accommodation provided',
    '交通补助': 'Transportation allowance',
    '通讯补贴': 'Communication allowance',
    '股票期权': 'Stock options',
    '定期体检': 'Regular health checkup',
    '补充医疗保险': 'Supplementary medical insurance',
    '弹性工作': 'Flexible work hours'
}
benefit_names_en = []
for name in benefit_names:
    found = False
    for key, val in mapping.items():
        if key in name:
            benefit_names_en.append(val)
            found = True
            break
    if not found:
        benefit_names_en.append(name)

plt.figure(figsize=(12,6))
bars = plt.barh(benefit_names_en, benefit_counts_vals, color='steelblue')
plt.xlabel('Count of Job Postings')
plt.title('Top 10 Benefits for Vocational School Graduates')
plt.gca().invert_yaxis()
for bar, count in zip(bars, benefit_counts_vals):
    plt.text(bar.get_width() + 10, bar.get_y() + bar.get_height()/2, str(count), va='center')
plt.savefig('benefits_top10_filtered.png', dpi=300, bbox_inches='tight')
plt.close()

# 3. Work Experience categories
def classify_experience(exp):
    if isinstance(exp, str):
        if '经验' in exp and '不限' not in exp and '无经验' not in exp:
            return 'Specific skill / other experience'
        elif '应届' in exp or '毕业生' in exp:
            return 'Fresh graduates'
        elif '不限' in exp or '无经验' in exp or '经验不限' in exp:
            return 'No limit'
        else:
            return 'Other'
    else:
        return 'Missing'

df_salary['exp_category'] = df_salary['Work Experience Requirement'].apply(classify_experience)
exp_salary = df_salary.groupby('exp_category')['salary_lower'].agg(['mean', 'count']).reset_index()
exp_salary = exp_salary[exp_salary['count'] >= 100]

plt.figure(figsize=(8,5))
bars = plt.bar(exp_salary['exp_category'], exp_salary['mean'], color=['blue','orange','green','red'])
plt.ylabel('Mean Monthly Salary (RMB)')
plt.title('Mean Starting Salary by Work Experience Requirement')
plt.xticks(rotation=15)
for bar, mean_val in zip(bars, exp_salary['mean']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 50, f'{mean_val:.0f}', ha='center', va='bottom')
plt.savefig('exp_salary_filtered.png', dpi=300, bbox_inches='tight')
plt.close()

# 4. Industry salary comparison (top industries by mean salary)
industry_salary = df_salary.groupby('Industry')['salary_lower'].agg(['mean', 'count']).reset_index()
industry_salary = industry_salary[industry_salary['count'] >= 100].sort_values('mean', ascending=False)
top10_industry = industry_salary.head(10)
bottom5_industry = industry_salary.tail(5)

plt.figure(figsize=(12,6))
bars = plt.barh(top10_industry['Industry'], top10_industry['mean'], color='forestgreen')
plt.xlabel('Mean Monthly Salary (RMB)')
plt.title('Top 10 Industries by Mean Salary (>=100 postings)')
plt.gca().invert_yaxis()
for bar, mean_val in zip(bars, top10_industry['mean']):
    plt.text(bar.get_width() + 50, bar.get_y() + bar.get_height()/2, f'{mean_val:.0f}', va='center')
plt.savefig('industry_salary_top_filtered.png', dpi=300, bbox_inches='tight')
plt.close()

# 5. Company Type salary comparison
company_salary = df_salary.groupby('Company Type')['salary_lower'].agg(['mean', 'count']).reset_index()
company_salary = company_salary[company_salary['count'] >= 100].sort_values('mean', ascending=False)

plt.figure(figsize=(10,5))
bars = plt.bar(company_salary['Company Type'], company_salary['mean'], color='purple')
plt.ylabel('Mean Monthly Salary (RMB)')
plt.title('Mean Starting Salary by Company Type (>=100 postings)')
plt.xticks(rotation=45, ha='right')
for bar, mean_val in zip(bars, company_salary['mean']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 50, f'{mean_val:.0f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('company_type_salary_filtered.png', dpi=300, bbox_inches='tight')
plt.close()

# 6. Salary premiums for key categories
overall_mean = df_salary['salary_lower'].mean()
categories = []
means = []
counts = []
# Specific skill
spec = exp_salary[exp_salary['exp_category'] == 'Specific skill / other experience']
if not spec.empty:
    categories.append('Specific skill')
    means.append(spec['mean'].values[0])
    counts.append(spec['count'].values[0])
# Fresh graduates
fresh = exp_salary[exp_salary['exp_category'] == 'Fresh graduates']
if not fresh.empty:
    categories.append('Fresh graduates')
    means.append(fresh['mean'].values[0])
    counts.append(fresh['count'].values[0])
# Automotive & auto parts
auto_ind = df_salary[df_salary['Industry'].str.contains('汽车', na=False)]
if len(auto_ind) >= 100:
    categories.append('Automotive & auto parts')
    means.append(auto_ind['salary_lower'].mean())
    counts.append(len(auto_ind))
# Architecture & Engineering
arch_ind = df_salary[df_salary['Industry'].str.contains('建筑|工程', na=False)]
if len(arch_ind) >= 100:
    categories.append('Architecture & Engineering')
    means.append(arch_ind['salary_lower'].mean())
    counts.append(len(arch_ind))
# Hotels/Tourism
hotel_ind = df_salary[df_salary['Industry'].str.contains('酒店|旅游', na=False)]
if len(hotel_ind) >= 100:
    categories.append('Hotels/Tourism')
    means.append(hotel_ind['salary_lower'].mean())
    counts.append(len(hotel_ind))
# Listed companies
listed = df_salary[df_salary['Company Type'].str.contains('上市', na=False)]
if len(listed) >= 100:
    categories.append('Listed companies')
    means.append(listed['salary_lower'].mean())
    counts.append(len(listed))
# State-owned enterprises
soe = df_salary[df_salary['Company Type'].str.contains('国企', na=False)]
if len(soe) >= 100:
    categories.append('State-owned enterprises')
    means.append(soe['salary_lower'].mean())
    counts.append(len(soe))

premium_df = pd.DataFrame({'Category': categories, 'Mean Salary': means, 'Count': counts})
premium_df['Diff from Overall Mean'] = premium_df['Mean Salary'] - overall_mean

plt.figure(figsize=(12,6))
bars = plt.bar(premium_df['Category'], premium_df['Diff from Overall Mean'], color=['green' if x>0 else 'red' for x in premium_df['Diff from Overall Mean']])
plt.ylabel('Salary Difference from Overall Mean (RMB)')
plt.title('Salary Premium/Penalty for Key Categories')
plt.axhline(y=0, color='black', linestyle='-', linewidth=0.8)
plt.xticks(rotation=30, ha='right')
for bar, diff in zip(bars, premium_df['Diff from Overall Mean']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + (20 if diff>0 else -30), f'{diff:+.0f}', ha='center', va='bottom' if diff>0 else 'top')
plt.tight_layout()
plt.savefig('salary_premiums_filtered.png', dpi=300, bbox_inches='tight')
plt.close()

