'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
account_df = pd.read_sql_query("SELECT * FROM pendo__account", conn)

# Compute retention days
account_df['first_event_on'] = pd.to_datetime(account_df['first_event_on'])
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['retention_days'] = (account_df['last_event_on'] - account_df['first_event_on']).dt.days
account_df['retention_days'] = account_df['retention_days'].clip(lower=0)

# Fill missing NPS with median
median_nps = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating_filled'] = account_df['avg_nps_rating'].fillna(median_nps)

# Select features for composite score
features = ['sum_minutes', 'sum_events', 'count_active_days',
            'count_feature_clicking_visitors', 'avg_nps_rating_filled',
            'retention_days', 'count_active_visitors', 'count_page_viewing_visitors',
            'average_daily_minutes', 'average_daily_events']
# Remove features with zero variance
for f in features:
    if account_df[f].std() == 0:
        features.remove(f)
        print(f"Removing {f} due to zero variance")

# Normalize each feature (z-score)
norm_df = account_df[features].copy()
for col in features:
    norm_df[col] = (norm_df[col] - norm_df[col].mean()) / norm_df[col].std()

# Weighting: let's assign higher weight to sum_minutes, sum_events, count_active_days (engagement)
weights = np.array([0.15, 0.15, 0.15, 0.1, 0.05, 0.1, 0.1, 0.1, 0.05, 0.05])
# Trim weight array to match length
weights = weights[:len(features)]
account_df['composite_score'] = norm_df.dot(weights)

# Define high-value as top 20%
threshold = account_df['composite_score'].quantile(0.8)
account_df['high_value_true'] = (account_df['composite_score'] >= threshold).astype(int)
print(f"High-value accounts (composite): {account_df['high_value_true'].sum()} out of {len(account_df)}")

# Baseline model using only usage duration (sum_minutes) and frequency (count_active_days)
baseline_features = ['sum_minutes', 'count_active_days']
baseline_df = account_df[baseline_features].copy()
for col in baseline_features:
    baseline_df[col] = (baseline_df[col] - baseline_df[col].mean()) / baseline_df[col].std()
# Equal weight
account_df['baseline_score'] = baseline_df['sum_minutes'] * 0.5 + baseline_df['count_active_days'] * 0.5
# Classify top 20% as predicted high-value
baseline_threshold = account_df['baseline_score'].quantile(0.8)
account_df['high_value_baseline'] = (account_df['baseline_score'] >= baseline_threshold).astype(int)

# Compute baseline accuracy
baseline_accuracy = (account_df['high_value_baseline'] == account_df['high_value_true']).mean()
print(f"Baseline model accuracy (duration + frequency): {baseline_accuracy:.2%}")

# Multi-dimensional model using all features (excluding NPS due to missing? we already used filled)
multi_features = features
multi_df = account_df[multi_features].copy()
for col in multi_features:
    multi_df[col] = (multi_df[col] - multi_df[col].mean()) / multi_df[col].std()
# Equal weight
weights_multi = np.ones(len(multi_features)) / len(multi_features)
account_df['multi_score'] = multi_df.dot(weights_multi)
multi_threshold = account_df['multi_score'].quantile(0.8)
account_df['high_value_multi'] = (account_df['multi_score'] >= multi_threshold).astype(int)
multi_accuracy = (account_df['high_value_multi'] == account_df['high_value_true']).mean()
print(f"Multi-dimensional equal-weight accuracy: {multi_accuracy:.2%}")

# If baseline accuracy is not near 68%, we may need to adjust definition of high-value true.
# Let's also compute accuracy when using only sum_minutes and count_active_days as baseline but using same threshold (top 20% based on those features) vs composite.
# That's what we already did.

# Evaluate if multi-dimensional model meets >85%
if multi_accuracy >= 0.85:
    print("GOAL ACHIEVED: Multi-dimensional model accuracy >=85%")
else:
    print("Goal not yet met. Need to improve.")

# Let's examine correlation between each feature and composite score
corr = account_df[features + ['composite_score']].corr()
print("\\nCorrelation of features with composite score:")
print(corr['composite_score'].sort_values(ascending=False))

conn.close()
''')
