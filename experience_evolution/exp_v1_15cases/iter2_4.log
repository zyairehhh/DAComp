'''
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import sqlite3

# Connect to SQLite database
conn = sqlite3.connect('dacomp-058.sqlite')

# Load campaign report (monthly data)
campaign_report = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)
campaigns = pd.read_sql_query("SELECT * FROM campaigns", conn)

# Merge with campaign metadata
campaign_data = pd.merge(campaign_report, campaigns, on='campaign_id', how='left')
# Rename duplicate columns: keep _x (from campaign_report) for consistency
campaign_data.rename(columns={
    'campaign_type_x': 'campaign_type',
    'bidding_strategy_x': 'bidding_strategy',
    'industry_x': 'industry',
    'campaign_name_x': 'campaign_name'
}, inplace=True)
# Drop the _y duplicates
campaign_data.drop(columns=['campaign_name_y', 'campaign_type_y', 'bidding_strategy_y', 'industry_y'], inplace=True, errors='ignore')

# Filter for monthly cost > $1000 and ROI < 0.8? Actually ROI is roas? Let's examine.
# I'll define ROI as roas (return on ad spend). Screening criteria: cost > 1000 and roas < 0.8
# But we need to compute monthly cost per campaign (already cost column is cost per month)
# We'll apply filter to unhealthy campaigns for health score modeling.
unhealthy = campaign_data[(campaign_data['cost'] > 1000) & (campaign_data['roas'] < 0.8)]
print(f"Unhealthy monthly records: {len(unhealthy)}")
print(f"Unique campaigns in unhealthy: {unhealthy['campaign_id'].nunique()}")

# For health score, we need to aggregate per campaign across all months (or average).
# Let's compute average metrics per campaign (including all months) for unhealthy campaigns.
campaign_agg = campaign_data.groupby('campaign_id').agg({
    'cost': 'mean',
    'roas': 'mean',
    'conversion_rate': 'mean',
    'quality_score': 'mean',
    'impression_share': 'mean',
    'ctr': 'mean',
    'cpc': 'mean',
    'cost_per_conversion': 'mean',
    'conversion_value': 'mean',
    'conversions': 'mean',
    'campaign_type': 'first',
    'bidding_strategy': 'first',
    'industry': 'first'
}).reset_index()

# Note: avg_position not in campaign_report; it's in keyword_report.
# Let's compute avg_position per campaign from keyword_report.
keyword_report = pd.read_sql_query("SELECT * FROM google_ads__keyword_report", conn)
keyword_agg = keyword_report.groupby('campaign_id')['avg_position'].mean().reset_index()
keyword_agg = keyword_agg.rename(columns={'avg_position': 'avg_position_campaign'})

# Merge avg_position
campaign_agg = pd.merge(campaign_agg, keyword_agg, on='campaign_id', how='left')
campaign_agg['avg_position_campaign'] = campaign_agg['avg_position_campaign'].fillna(10)  # default high (worse)

# Now we have metrics for all campaigns.
# Define health score components (normalized 0-1, higher is better)
# Cost Efficiency (40%): lower cost per conversion is better. Use inverse.
# We'll use roas (higher is better) and cost_per_conversion (lower). We'll normalize each.
# Let's compute normalized roas: (roas - min) / (max - min)
max_roas = campaign_agg['roas'].max()
min_roas = campaign_agg['roas'].min()
campaign_agg['roas_norm'] = (campaign_agg['roas'] - min_roas) / (max_roas - min_roas)

# Normalized cost per conversion (inverse)
max_cpc = campaign_agg['cost_per_conversion'].max()
min_cpc = campaign_agg['cost_per_conversion'].min()
campaign_agg['cpc_inv_norm'] = 1 - ((campaign_agg['cost_per_conversion'] - min_cpc) / (max_cpc - min_cpc))

# Cost Efficiency = 0.5*roas_norm + 0.5*cpc_inv_norm (or adjust)
campaign_agg['cost_efficiency'] = 0.5 * campaign_agg['roas_norm'] + 0.5 * campaign_agg['cpc_inv_norm']

# Conversion Quality (35%): conversion_rate and quality_score
campaign_agg['conv_rate_norm'] = (campaign_agg['conversion_rate'] - campaign_agg['conversion_rate'].min()) / (campaign_agg['conversion_rate'].max() - campaign_agg['conversion_rate'].min())
campaign_agg['quality_score_norm'] = (campaign_agg['quality_score'] - campaign_agg['quality_score'].min()) / (campaign_agg['quality_score'].max() - campaign_agg['quality_score'].min())
campaign_agg['conversion_quality'] = 0.5 * campaign_agg['conv_rate_norm'] + 0.5 * campaign_agg['quality_score_norm']

# Competitiveness (25%): impression_share, ctr, avg_position (inverse because lower avg_position is better)
campaign_agg['imp_share_norm'] = campaign_agg['impression_share'] / 100  # assume 0-100
campaign_agg['ctr_norm'] = campaign_agg['ctr'] / campaign_agg['ctr'].max()
# avg_position: lower is better, normalize inversely
max_pos = campaign_agg['avg_position_campaign'].max()
min_pos = campaign_agg['avg_position_campaign'].min()
campaign_agg['avg_pos_inv_norm'] = 1 - ((campaign_agg['avg_position_campaign'] - min_pos) / (max_pos - min_pos))
campaign_agg['competitiveness'] = 0.4 * campaign_agg['imp_share_norm'] + 0.4 * campaign_agg['ctr_norm'] + 0.2 * campaign_agg['avg_pos_inv_norm']

# Overall health score weighted sum
campaign_agg['health_score'] = 0.4 * campaign_agg['cost_efficiency'] + 0.35 * campaign_agg['conversion_quality'] + 0.25 * campaign_agg['competitiveness']

# Assign risk level: quintiles or thresholds
campaign_agg['risk_level'] = pd.qcut(campaign_agg['health_score'], q=5, labels=['Very High', 'High', 'Medium', 'Low', 'Very Low'])

# Add campaign_type, bidding_strategy, industry for segmentation
# They are already in campaign_agg from 'first'.

print("Health score computed for all campaigns.")
