# Compute gap for each template
df_template_pivot = df_template.pivot(index='template_name', columns='responder_type', values='demo_rate')
df_template_pivot = df_template_pivot.dropna()
df_template_pivot['gap'] = df_template_pivot['human'] - df_template_pivot['bot']
# Get top 5 by total leads
df_template_total = df_template.groupby('template_name')['total_leads'].sum().sort_values(ascending=False).head(5)
top_templates = df_template_total.index.tolist()
df_top = df_template_pivot.loc[top_templates].reset_index()
# Plot
fig, ax = plt.subplots(figsize=(10,5))
x = np.arange(len(top_templates))
bars_bot = ax.bar(x - width/2, df_top['bot'], width, label='Bot First', color='tab:blue')
bars_human = ax.bar(x + width/2, df_top['human'], width, label='Human First', color='tab:orange')
ax.set_xticks(x)
ax.set_xticklabels(top_templates, rotation=15, ha='right')
ax.set_ylabel('Demo Book Rate')
ax.set_title('Demo Book Rate for Top 5 Templates by Conversation Volume')
ax.legend()
# Add value labels
for bars in [bars_bot, bars_human]:
    for bar in bars:
        height = bar.get_height()
        ax.annotate(f'{height:.1%}', xy=(bar.get_x() + bar.get_width() / 2, height),
                    xytext=(0,3), textcoords="offset points", ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('/workspace/template_demo_rates.png', dpi=300)
plt.close()

print("Plots saved.")
