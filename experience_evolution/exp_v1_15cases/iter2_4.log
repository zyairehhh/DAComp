import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/workspace/dacomp-060.sqlite')

# Load ad group report
df = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)

# Compute CTR and CVR
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
# Replace inf/nan with 0
df['CTR'] = df['CTR'].replace([np.inf, -np.inf], np.nan).fillna(0)
df['CVR'] = df['CVR'].replace([np.inf, -np.inf], np.nan).fillna(0)

# Determine percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

print(f"75th percentile CTR: {ctr_75}")
print(f"25th percentile CVR: {cvr_25}")

# Filter problematic ad groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)]
print(f"Number of problematic ad groups: {len(problematic)}")
if len(problematic) > 0:
    print("\nFirst few problematic ad groups:")
    print(problematic[['ad_group_name', 'campaign_name', 'CTR', 'CVR', 'clicks', 'impressions', 'conversions']].head())
else:
    print("No ad groups meet criteria.")

# Compute expected CVR as overall average CVR (excluding zeros?)
overall_cvr = df.loc[df['clicks']>0, 'CVR'].mean()
problematic['expected_cvr'] = overall_cvr
problematic['intent_match_ratio'] = problematic['CVR'] / overall_cvr
print(f"\nOverall average CVR (clicks>0): {overall_cvr}")
print("\nIntent match ratio for problematic ad groups:")
print(problematic[['ad_group_name', 'CVR', 'expected_cvr', 'intent_match_ratio']].head())

# Save problematic groups for later analysis
problematic.to_csv('problematic_ad_groups.csv', index=False)

# Also compute metrics for visualization
# 1. Distribution of CTR vs CVR scatter
# 2. Histogram of CTR and CVR
# 3. Top problematic ad groups by spend

conn.close()
