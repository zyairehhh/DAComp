    ax1.plot(df1_recent['date_day'], df1_recent['daily_uninstalls'], 'r-', label='Uninstalls', alpha=0.7)
    ax1.set_title('Daily Installs vs Uninstalls (Last 6 Months)')
    ax1.set_xlabel('Date')
    ax1.set_ylabel('Count')
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    ax1.tick_params(axis='x', rotation=45)
    
    # Efficiency ratio
    ax2.plot(df1_recent['date_day'], df1_recent['install_to_uninstall_ratio'], 'b-', linewidth=2)
    ax2.axhline(y=df1_recent['install_to_uninstall_ratio'].mean(), color='r', linestyle='--', 
                label=f'Mean: {df1_recent["install_to_uninstall_ratio"].mean():.2f}')
    ax2.set_title('Install-to-Uninstall Ratio (Acquisition Efficiency)')
