import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-067.sqlite')

# Get hires per source with gender and race
query = """
SELECT tps.source_name,
       ae.candidate_gender,
       ae.candidate_race,
       COUNT(DISTINCT cs.candidate_id) as hire_count
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
  AND ae.candidate_gender IS NOT NULL
  AND ae.candidate_race IS NOT NULL
GROUP BY tps.source_name, ae.candidate_gender, ae.candidate_race
"""
df_diversity = pd.read_sql_query(query, conn)

# Compute total hires per source
df_total = df_diversity.groupby('source_name')['hire_count'].sum().reset_index()

# Compute female (assuming 'Female' label)
df_female = df_diversity[df_diversity['candidate_gender'].str.contains('Female', case=False, na=False)]
df_female_sum = df_female.groupby('source_name')['hire_count'].sum().reset_index()
df_female_sum.columns = ['source_name', 'female_hires']

# Compute non-white (assuming race not 'White')
non_white_categories = ['Black or African American', 'Hispanic or Latino', 'Asian', 'American Indian or Alaska Native', 'Native Hawaiian or Other Pacific Islander', 'Two or more races', 'Not Specified', 'Other']
df_non_white = df_diversity[df_diversity['candidate_race'].isin(non_white_categories)]
df_non_white_sum = df_non_white.groupby('source_name')['hire_count'].sum().reset_index()
df_non_white_sum.columns = ['source_name', 'non_white_hires']

# Merge
df = df_total.merge(df_female_sum, on='source_name', how='left')
df = df.merge(df_non_white_sum, on='source_name', how='left')
df['female_hires'] = df['female_hires'].fillna(0)
df['non_white_hires'] = df['non_white_hires'].fillna(0)

df['female_representation'] = df['female_hires'] / df['hire_count'] * 100
df['non_white_representation'] = df['non_white_hires'] / df['hire_count'] * 100

print(df[['source_name', 'hire_count', 'female_representation', 'non_white_representation']])
df.to_csv('diversity_per_source.csv', index=False)
```

