import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-092.sqlite')

# Step 1: Identify high-volatility customers (top 25% avg margin volatility)
query = """
SELECT customer_id,
       AVG(customer_margin_volatility) as avg_margin_volatility,
       COUNT(*) as invoice_count
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql(query, conn)
threshold = df_cust_vol['avg_margin_volatility'].quantile(0.75)
high_vol_customers = df_cust_vol[df_cust_vol['avg_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers count: {len(high_vol_customers)}")

# Step 2: For these customers, compute coefficient of variation of gross_profit over past 12 months
# Determine max date
max_date = pd.read_sql("SELECT MAX(transaction_date) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'][0]
max_date = pd.to_datetime(max_date)
cutoff_date = max_date - pd.DateOffset(months=12)
print(f"Max date: {max_date}")
print(f"Cutoff date (past 12 months): {cutoff_date}")

# Get transactions of high-volatility customers in the past 12 months
query = f"""
SELECT customer_id, gross_profit, transaction_date
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({','.join(['?']*len(high_vol_customers))})
  AND transaction_date >= ?
"""
params = high_vol_customers + [cutoff_date.strftime('%Y-%m-%d')]
df_recent = pd.read_sql(query, conn, params=params)
print(f"Transactions in past 12 months for high-volatility customers: {df_recent.shape[0]}")

# Compute coefficient of variation per customer
if df_recent.shape[0] > 0:
    cv_df = df_recent.groupby('customer_id')['gross_profit'].apply(
        lambda x: x.std() / x.mean() if x.mean() != 0 else np.nan
    ).reset_index(name='cv_gross_profit')
    print(f"Coefficient of variation computed for {cv_df.shape[0]} customers")
    print(cv_df.head())
else:
    print("No transactions in past 12 months.")
    cv_df = pd.DataFrame(columns=['customer_id', 'cv_gross_profit'])

# Step 3: Variance of quarter-over-quarter invoice_total growth rate per customer
# First, get quarterly aggregated invoice_total per customer
query = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as quarterly_invoice_total
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({})
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
""".format(','.join(['?']*len(high_vol_customers)))

df_quarterly = pd.read_sql(query, conn, params=high_vol_customers)
print(f"Quarterly aggregates rows: {df_quarterly.shape[0]}")

# For each customer, compute growth rate between consecutive quarters
def compute_growth_variance(df):
    if df.shape[0] < 2:
        return np.nan
    df = df.sort_values(['revenue_year', 'revenue_quarter'])
    df['prev_total'] = df['quarterly_invoice_total'].shift(1)
    df['growth_rate'] = (df['quarterly_invoice_total'] - df['prev_total']) / df['prev_total']
    growth_rates = df['growth_rate'].dropna()
    if len(growth_rates) == 0:
        return np.nan
    return growth_rates.var()

growth_var = df_quarterly.groupby('customer_id').apply(compute_growth_variance).reset_index(name='var_qoq_growth')
print(growth_var.head())

# Merge results
metrics = pd.merge(cv_df, growth_var, on='customer_id', how='outer')
print(metrics.head(10))
print(metrics.describe())
```

