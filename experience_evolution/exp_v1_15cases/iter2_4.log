fig, ax = plt.subplots(figsize=(10,8))
cax = ax.matshow(corr_matrix, cmap='coolwarm', vmin=-1, vmax=1)
fig.colorbar(cax)
plt.xticks(range(len(corr_matrix.columns)), corr_matrix.columns, rotation=45)
plt.yticks(range(len(corr_matrix.columns)), corr_matrix.columns)
plt.title('Correlation Matrix of Health Metrics')
for i in range(len(corr_matrix.columns)):
    for j in range(len(corr_matrix.columns)):
        text = ax.text(j, i, f'{corr_matrix.iloc[i, j]:.2f}', ha='center', va='center', color='black', fontsize=8)
plt.savefig('correlation_matrix.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 9: Geographic distribution (top 10 geo_targets) health score
geo_report = pd.read_sql_query("SELECT * FROM google_ads__geo_report", conn)
# Merge with health scores
geo_campaign = geo_report.groupby(['geo_target', 'campaign_id']).agg({
    'cost': 'sum',
    'roas': 'mean'
}).reset_index()
geo_campaign = geo_campaign.merge(campaign_agg[['campaign_id', 'health_score']], on='campaign_id')
geo_agg = geo_campaign.groupby('geo_target')['health_score'].mean().reset_index().sort_values('health_score', ascending=False)
top_geo = geo_agg.head(10)
plt.figure(figsize=(10,6))
plt.barh(top_geo['geo_target'], top_geo['health_score'], color='mediumseagreen')
plt.xlabel('Average Health Score')
plt.title('Top 10 Geographic Targets by Average Campaign Health Score')
plt.gca().invert_yaxis()
plt.grid(axis='x', linestyle='--', alpha=0.7)
plt.savefig('top_geo_health_score.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 10: Device type health score
device_report = pd.read_sql_query("SELECT * FROM google_ads__device_report", conn)
device_campaign = device_report.groupby(['device_type', 'campaign_id']).agg({
    'cost': 'sum',
    'roas': 'mean'
}).reset_index()
device_campaign = device_campaign.merge(campaign_agg[['campaign_id', 'health_score']], on='campaign_id')
device_agg = device_campaign.groupby('device_type')['health_score'].mean().reset_index().sort_values('health_score')
plt.figure(figsize=(8,5))
plt.bar(device_agg['device_type'], device_agg['health_score'], color='gold')
plt.xlabel('Device Type')
plt.ylabel('Average Health Score')
plt.title('Average Health Score by Device Type')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.savefig('health_score_by_device_type.png', dpi=300, bbox_inches='tight')
plt.close()

conn.close()
print("All plots saved.")
''')
