-- Parse tags and create a temporary view for analysis
CREATE TEMPORARY VIEW parsed_conversations AS
SELECT 
    conversation_id,
    conversation_created_at,
    conversation_initiated_type,
    all_conversation_tags,
    all_conversation_contacts AS contact_id,
    -- extract stage
    CASE 
        WHEN instr(all_conversation_tags, 'stage:') > 0 
        THEN substr(all_conversation_tags, 
                    instr(all_conversation_tags, 'stage:') + 6,
                    instr(substr(all_conversation_tags, instr(all_conversation_tags, 'stage:') + 6), '|') - 1)
        ELSE ''
    END AS stage,
    -- extract intent
    CASE 
        WHEN instr(all_conversation_tags, 'intent:') > 0 
        THEN substr(all_conversation_tags, 
                    instr(all_conversation_tags, 'intent:') + 7,
                    instr(substr(all_conversation_tags, instr(all_conversation_tags, 'intent:') + 7), '|') - 1)
        ELSE ''
    END AS intent,
    -- extract segment
    CASE 
        WHEN instr(all_conversation_tags, 'segment:') > 0 
        THEN substr(all_conversation_tags, 
                    instr(all_conversation_tags, 'segment:') + 8,
                    instr(substr(all_conversation_tags, instr(all_conversation_tags, 'segment:') + 8), '|') - 1)
        ELSE ''
    END AS segment,
    -- extract region
    CASE 
        WHEN instr(all_conversation_tags, 'region:') > 0 
        THEN substr(all_conversation_tags, 
                    instr(all_conversation_tags, 'region:') + 7,
                    instr(substr(all_conversation_tags, instr(all_conversation_tags, 'region:') + 7), '|') - 1)
        ELSE ''
    END AS region,
    -- extract lifecycle
    CASE 
        WHEN instr(all_conversation_tags, 'lifecycle:') > 0 
        THEN substr(all_conversation_tags, 
                    instr(all_conversation_tags, 'lifecycle:') + 10,
                    instr(substr(all_conversation_tags, instr(all_conversation_tags, 'lifecycle:') + 10), '|') - 1)
        ELSE ''
    END AS lifecycle
FROM intercom__conversation_enhanced;
```
