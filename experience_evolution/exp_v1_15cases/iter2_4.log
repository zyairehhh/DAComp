import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re
import matplotlib.pyplot as plt
from collections import Counter
import ast

# Connect to the database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

print("Total rows:", len(df))

# Filter for vocational school graduates
voc_df = df[df['Education Requirement'].str.contains('Vocational school', na=False, case=False)]
print("Vocational school jobs count:", len(voc_df))

# Function to extract salary bounds
def extract_salary_bounds(salary_str):
    if pd.isna(salary_str):
        return None, None
    # Find all numbers in the string
    numbers = re.findall(r'[\d,]+\.?\d*', salary_str.replace(',', ''))
    if not numbers:
        return None, None
    # Convert to integers
    nums = [int(float(num)) for num in numbers if float(num) < 100000]  # filter unrealistic numbers
    if len(nums) >= 2:
        # Often first two numbers are the range
        lower = min(nums[:2])
        upper = max(nums[:2])
        return lower, upper
    else:
        return None, None

# Extract salary bounds
bounds = voc_df['Salary Range'].apply(extract_salary_bounds)
voc_df['salary_lower'] = bounds.apply(lambda x: x[0] if x else None)
voc_df['salary_upper'] = bounds.apply(lambda x: x[1] if x else None)
voc_df['salary_mid'] = voc_df.apply(lambda row: (row['salary_lower'] + row['salary_upper']) / 2 
                                    if row['salary_lower'] and row['salary_upper'] else None, axis=1)

# Remove rows with missing salary
salary_df = voc_df.dropna(subset=['salary_lower', 'salary_upper'])
print("Jobs with valid salary range:", len(salary_df))

# 1. Starting Salary Distribution (histogram)
plt.figure(figsize=(10, 6))
plt.hist(salary_df['salary_mid'].dropna(), bins=50, alpha=0.7, edgecolor='black')
plt.xlabel('Monthly Salary (RMB)')
plt.ylabel('Frequency')
plt.title('Distribution of Starting Salaries for Vocational School Graduates')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('salary_distribution.png', dpi=150)
print("Saved salary_distribution.png")

# 2. Benefits distribution (top benefits)
# Split benefits by common separators
def split_benefits(benefit_str):
    if pd.isna(benefit_str):
        return []
    # Common separators: comma, space, slash, Chinese full-width comma 、
    separators = [',', '，', '、', ';', '；', ' ', '/']
    result = str(benefit_str)
    for sep in separators:
        result = result.replace(sep, '|')
    parts = [p.strip() for p in result.split('|') if p.strip()]
    return parts

all_benefits = []
for b in voc_df['Benefits'].dropna():
    all_benefits.extend(split_benefits(b))

# Count benefits
benefit_counts = Counter(all_benefits)
# Get top 20 benefits
top_benefits = benefit_counts.most_common(20)

# Plot benefits distribution
plt.figure(figsize=(12, 8))
benefits_names = [b[0] for b in top_benefits]
benefits_counts = [b[1] for b in top_benefits]
y_pos = np.arange(len(benefits_names))
plt.barh(y_pos, benefits_counts, alpha=0.7)
plt.yticks(y_pos, benefits_names, fontsize=9)
plt.xlabel('Count')
plt.title('Top 20 Benefits Offered for Vocational School Graduates')
plt.gca().invert_yaxis()
plt.tight_layout()
plt.savefig('benefits_distribution.png', dpi=150)
print("Saved benefits_distribution.png")

# 3. Factors affecting salary
# Analyze correlation between salary and other factors
# Work Experience Requirement
experience_mapping = {
    'No limit': 0,
    'No limit ': 0,
    'No experience required': 0,
    '1 year': 1,
    '2 years': 2,
    '3 years': 3,
    '4 years': 4,
    '5 years': 5,
    '6 years': 6,
    '7 years': 7,
    '8 years': 8,
    '9 years': 9,
    '10 years': 10,
}

def extract_experience_years(exp_str):
    if pd.isna(exp_str):
        return None
    exp_str = str(exp_str)
    # Try to map known values
    for key, val in experience_mapping.items():
        if key in exp_str:
            return val
    # Try to find number pattern
    match = re.search(r'(\d+)\s*year', exp_str, re.IGNORECASE)
    if match:
        return int(match.group(1))
    # Check for 'experienced' or '有经验'
    if 'experience' in exp_str.lower() or '有经验' in exp_str or 'experienced' in exp_str.lower():
        return 5  # approximate
    return None

salary_df['experience_years'] = salary_df['Work Experience Requirement'].apply(extract_experience_years)

# Gender requirement vs salary
gender_groups = salary_df.groupby('Gender Requirement')['salary_mid'].mean().dropna()
gender_groups = gender_groups.sort_values(ascending=False)

plt.figure(figsize=(10, 6))
gender_groups.plot(kind='bar', alpha=0.7)
plt.xlabel('Gender Requirement')
plt.ylabel('Average Monthly Salary (RMB)')
plt.title('Average Salary by Gender Requirement for Vocational School Graduates')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('gender_salary.png', dpi=150)
print("Saved gender_salary.png")

# Industry vs salary (top industries)
# Extract first industry if multiple
def get_first_industry(ind_str):
    if pd.isna(ind_str):
        return None
    # Split by common separators
    parts = re.split(r'[,，/]', str(ind_str))
    if parts:
        return parts[0].strip()
    return None

salary_df['industry_category'] = salary_df['Industry'].apply(get_first_industry)
industry_salary = salary_df.groupby('industry_category')['salary_mid'].mean().dropna().sort_values(ascending=False).head(15)

plt.figure(figsize=(12, 8))
industry_salary.plot(kind='barh', alpha=0.7)
plt.xlabel('Average Monthly Salary (RMB)')
plt.title('Top 15 Industries by Average Salary for Vocational School Graduates')
plt.gca().invert_yaxis()
plt.tight_layout()
plt.savefig('industry_salary.png', dpi=150)
print("Saved industry_salary.png")

# Create combined report
print("\n=== Analysis Summary ===")
print(f"Total vocational school jobs: {len(voc_df)}")
print(f"Jobs with valid salary data: {len(salary_df)}")
print(f"Average salary midpoint: {salary_df['salary_mid'].mean():.2f} RMB")
print(f"Median salary midpoint: {salary_df['salary_mid'].median():.2f} RMB")
print(f"Salary range: {salary_df['salary_lower'].min():.0f} - {salary_df['salary_upper'].max():.0f} RMB")

# Top benefits
print("\nTop 5 Benefits:")
for benefit, count in top_benefits[:5]:
    print(f"  {benefit}: {count}")
```
