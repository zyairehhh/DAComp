import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

# Connect to database
conn = sqlite3.connect('dacomp-035.sqlite')

query = """
WITH dept_users AS (
    SELECT "User ID", Department
    FROM user_information_table
),
login_dept AS (
    SELECT l."Login Record ID", u.Department
    FROM login_records_table l
    JOIN dept_users u ON l."User ID" = u."User ID"
),
abnormal_dept AS (
    SELECT a."Anomaly ID", a."Login Record ID", a."Risk Level", 
           a."Confirmation Status", a."Anomaly Type", a."Anomaly Score",
           u.Department
    FROM abnormal_logins_table a
    JOIN login_dept l ON a."Login Record ID" = l."Login Record ID"
    JOIN dept_users u ON l.Department = u.Department
)
SELECT 
    Department,
    COUNT(DISTINCT l."Login Record ID") AS total_logins,
    COUNT(DISTINCT a."Anomaly ID") AS abnormal_logins,
    ROUND(100.0 * COUNT(DISTINCT a."Anomaly ID") / COUNT(DISTINCT l."Login Record ID"), 1) AS abnormal_rate,
    ROUND(100.0 * SUM(CASE WHEN a."Confirmation Status" = 'Confirmed' THEN 1 ELSE 0 END) / COUNT(DISTINCT a."Anomaly ID"), 1) AS confirmed_abnormal_pct,
    ROUND(100.0 * SUM(CASE WHEN a."Risk Level" IN ('Severe', 'High') THEN 1 ELSE 0 END) / COUNT(DISTINCT a."Anomaly ID"), 1) AS high_risk_abnormal_pct,
    (SELECT COUNT(DISTINCT "User ID") FROM dept_users WHERE Department = u.Department) AS total_users,
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN a."Risk Level" IN ('Severe', 'High') THEN u."User ID" END) / 
        (SELECT COUNT(DISTINCT "User ID") FROM dept_users WHERE Department = u.Department), 1) AS high_risk_user_pct,
    ROUND(100.0 * SUM(CASE WHEN a."Anomaly Type" = 'Remote Login' THEN 1 ELSE 0 END) / COUNT(DISTINCT a."Anomaly ID"), 1) AS remote_login_pct,
    ROUND(AVG(a."Anomaly Score"), 1) AS avg_anomaly_score
FROM login_dept l
LEFT JOIN abnormal_dept a ON l."Login Record ID" = a."Login Record ID"
JOIN dept_users u ON l.Department = u.Department
GROUP BY u.Department
ORDER BY u.Department;
"""

df = pd.read_sql_query(query, conn)
print(df)
conn.close()
```
