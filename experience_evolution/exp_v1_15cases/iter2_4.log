best_geo = geo_stats.loc[geo_stats['roi'].idxmax()]
# Device insights
worst_device = device_stats.loc[device_stats['roi'].idxmin()]
best_device = device_stats.loc[device_stats['roi'].idxmax()]

# Trend insights: month with highest cost growth
monthly['year_month'] = pd.to_datetime(monthly['year_month'])
max_growth = monthly.loc[monthly['cost_mom_pct'].idxmax()]
min_growth = monthly.loc[monthly['cost_mom_pct'].idxmin()]

