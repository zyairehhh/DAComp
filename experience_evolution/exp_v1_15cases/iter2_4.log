'''
import pandas as pd
import sqlite3
import numpy as np

# Load problematic ad groups
problematic = pd.read_csv('problematic_ad_groups.csv')

# Compute keyword match type performance for problematic
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter2/dacomp-060/stage1_env/dacomp-060.sqlite')
keyword_query = """
SELECT 
    ad_group_id,
    keyword_match_type,
    SUM(clicks) AS clicks,
    SUM(impressions) AS impressions,
    SUM(conversions) AS conversions,
    SUM(spend) AS spend,
    SUM(conversions_value) AS conversions_value
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
keyword_df = pd.read_sql_query(keyword_query, conn)
problematic_keywords = keyword_df[keyword_df['ad_group_id'].isin(problematic['ad_group_id'])]
match_summary = problematic_keywords.groupby('keyword_match_type').agg({
    'clicks':'sum',
    'impressions':'sum',
    'conversions':'sum',
    'spend':'sum',
    'conversions_value':'sum'
}).reset_index()
match_summary['CTR'] = match_summary['clicks'] / match_summary['impressions']
match_summary['CVR'] = match_summary['conversions'] / match_summary['clicks']
match_summary['CPC'] = match_summary['spend'] / match_summary['clicks']
match_summary['CPA'] = match_summary['spend'] / match_summary['conversions']
match_summary['ROAS'] = match_summary['conversions_value'] / match_summary['spend']

# Overall keyword match performance
overall_keyword = pd.read_sql_query("SELECT keyword_match_type, SUM(clicks) AS clicks, SUM(impressions) AS impressions, SUM(conversions) AS conversions, SUM(spend) AS spend, SUM(conversions_value) AS conversions_value FROM google_ads__keyword_report GROUP BY keyword_match_type", conn)
overall_keyword['CTR'] = overall_keyword['clicks'] / overall_keyword['impressions']
overall_keyword['CVR'] = overall_keyword['conversions'] / overall_keyword['clicks']
overall_keyword['CPC'] = overall_keyword['spend'] / overall_keyword['clicks']
overall_keyword['CPA'] = overall_keyword['spend'] / overall_keyword['conversions']
overall_keyword['ROAS'] = overall_keyword['conversions_value'] / overall_keyword['spend']

# Search term quality: top search terms with clicks but no conversions
search_query = """
SELECT search_term, SUM(clicks) AS clicks, SUM(conversions) AS conversions, SUM(spend) AS spend
FROM google_ads__search_term_report
WHERE ad_group_id IN ({})
GROUP BY search_term
HAVING SUM(conversions) = 0 AND SUM(clicks) > 0
ORDER BY SUM(clicks) DESC
LIMIT 10
""".format(','.join(["'{}'".format(id) for id in problematic['ad_group_id'].head(100).tolist()]))
search_no_conv = pd.read_sql_query(search_query, conn)
conn.close()

# Intent Match Ratio distribution
intent_desc = problematic['Intent_Match_Ratio'].describe()
worst = problematic.sort_values('Intent_Match_Ratio').head(10)

# Read existing stage1.md to keep structure? We'll create a new comprehensive markdown.
with open('/workspace/stage1.md', 'w') as f:
    f.write("# Stage 1 Analysis: High-CTR Low-CVR Ad Groups\n")
    f.write("## Executive Summary\n")
    f.write(f"- **75th percentile CTR**: 0.0382\n")
    f.write(f"- **25th percentile CVR**: 0.0333\n")
    f.write(f"- **Number of problematic ad groups**: {len(problematic)}\n")
    f.write(f"- **Expected CVR (weighted average)**: 0.0553\n")
    f.write(f"- **Average Intent Match Ratio**: {problematic['Intent_Match_Ratio'].mean():.4f}\n")
    f.write("\n## Characteristics of Problematic Ad Groups\n")
    f.write("### Ad Group Type Distribution\n")
    f.write(problematic['ad_group_type'].value_counts(dropna=False).to_string() + "\n")
    f.write("\n### Status Distribution\n")
    f.write(problematic['status'].value_counts(dropna=False).to_string() + "\n")
    f.write("\n### Top Campaigns (by count)\n")
    f.write(problematic['campaign_name'].value_counts().head(10).to_string() + "\n")
    f.write("\n### Top Accounts (by count)\n")
    f.write(problematic['account_name'].value_counts().head(10).to_string() + "\n")
    f.write("\n### Average Metrics (Problematic vs Overall)\n")
    f.write("| Metric | Overall | Problematic |\n")
    f.write("|--------|---------|-------------|\n")
    overall_ctr = 0.028337
    overall_cvr = 0.055343
    overall_cpc = 2.7626
    overall_cpa = 49.9978
    overall_roas = 2.2174
    f.write(f"| CTR | {overall_ctr:.4f} | {problematic['CTR'].mean():.4f} |\n")
    f.write(f"| CVR | {overall_cvr:.4f} | {problematic['CVR'].mean():.4f} |\n")
    f.write(f"| Intent Match Ratio | - | {problematic['Intent_Match_Ratio'].mean():.4f} |\n")
    f.write(f"| CPC | {overall_cpc:.4f} | {problematic['CPC'].mean():.4f} |\n")
    f.write(f"| CPA | {overall_cpa:.4f} | {problematic['CPA'].mean():.4f} |\n")
    f.write(f"| ROAS | {overall_roas:.4f} | {problematic['ROAS'].mean():.4f} |\n")
    f.write("\n## Keyword Match Type Analysis\n")
    f.write("### Performance within Problematic Ad Groups\n")
    f.write(match_summary.to_markdown(index=False) + "\n")
    f.write("\n### Overall Performance (All Ad Groups)\n")
    f.write(overall_keyword.to_markdown(index=False) + "\n")
    f.write("\nKey Insights:\n")
    f.write("- Broad match and broad match modifier have slightly lower CVR compared to exact and phrase among problematic ad groups.\n")
