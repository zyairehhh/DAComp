import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import re

# Connect to database
conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation_enhanced with tags
query = """
SELECT conversation_id, conversation_initiated_type, all_conversation_tags,
       all_conversation_contacts
FROM intercom__conversation_enhanced
"""
df = pd.read_sql_query(query, conn)

# Parse tags into columns
def parse_tag(tag_str, key):
    if not isinstance(tag_str, str):
        return None
    pattern = rf'{key}:([^|]+)'
    match = re.search(pattern, tag_str)
    if match:
        return match.group(1).strip()
    else:
        return None

df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))

# Load conversation_metrics for time metrics
query_metrics = """
SELECT conversation_id, time_to_first_response_minutes, time_to_first_close_minutes
FROM intercom__conversation_metrics
"""
metrics_df = pd.read_sql_query(query_metrics, conn)
df = df.merge(metrics_df, on='conversation_id', how='left')

conn.close()

# Filter out rows where conversation_initiated_type is missing
df = df[df['conversation_initiated_type'].notna()]
df['conversation_initiated_type'] = df['conversation_initiated_type'].str.strip()

print("Data loaded.")

# Helper functions
def conversion_rate(df, condition):
    total = df.shape[0]
    converted = condition(df).sum()
    return total, converted, converted/total if total>0 else 0

# Overall funnel performance
human = df[df['conversation_initiated_type']=='human_first']
bot = df[df['conversation_initiated_type']=='bot_first']

print(f"Human-first conversations: {human.shape[0]}")
print(f"Bot-first conversations: {bot.shape[0]}")

demo_booked = lambda d: d['stage'] == 'demo_booked'
trial_activated = lambda d: d['stage'] == 'trial_activated'
closed_won = lambda d: d['stage'] == 'closed_won'

h_total, h_demo, h_demo_rate = conversion_rate(human, demo_booked)
_, h_trial, h_trial_rate = conversion_rate(human, trial_activated)
_, h_paid, h_paid_rate = conversion_rate(human, closed_won)

b_total, b_demo, b_demo_rate = conversion_rate(bot, demo_booked)
_, b_trial, b_trial_rate = conversion_rate(bot, trial_activated)
_, b_paid, b_paid_rate = conversion_rate(bot, closed_won)

# Save overall conversion rates for plotting
overall_data = {
    'Human': [h_demo_rate, h_trial_rate, h_paid_rate],
    'Bot': [b_demo_rate, b_trial_rate, b_paid_rate]
}
print("Overall conversion rates computed.")
