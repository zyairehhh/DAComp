import pandas as pd
import sqlite3
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-067.sqlite')

# Check if we have interview duration data
duration_query = """
SELECT 
    sourced_from_type,
    AVG(duration_interview_minutes) as avg_interview_minutes,
    COUNT(*) as interview_count
FROM greenhouse__interview_enhanced AS i
JOIN greenhouse__application_enhanced AS a ON i.application_id = a.application_id
WHERE sourced_from_type IS NOT NULL AND duration_interview_minutes IS NOT NULL
GROUP BY sourced_from_type
HAVING interview_count > 10
"""
duration_df = pd.read_sql_query(duration_query, conn)

if not duration_df.empty:
    plt.figure(figsize=(10, 6))
    plt.bar(duration_df['sourced_from_type'], duration_df['avg_interview_minutes'])
    plt.xlabel('Sourcing Channel')
    plt.ylabel('Average Interview Duration (minutes)')
    plt.title('Interview Time Efficiency by Sourcing Channel')
    plt.grid(True, alpha=0.3, axis='y')
    
    # Add duration labels
    for i, duration in enumerate(duration_df['avg_interview_minutes']):
        plt.text(i, duration + 1, f'{duration:.0f} min', ha='center', va='bottom')
    
    plt.tight_layout()
    plt.savefig('interview_duration_by_channel.png', dpi=300, bbox_inches='tight')
    print("Generated interview_duration_by_channel.png")
else:
    print("No duration data available")

# Check for hiring manager alignment impact
hm_query = """
SELECT 
    has_interviewed_w_hiring_manager,
    COUNT(*) as count,
    AVG(CASE WHEN status = 'hired' THEN 1.0 ELSE 0 END) * 100 as hire_rate,
    AVG(count_interviews) as avg_interviews
FROM greenhouse__application_enhanced
WHERE has_interviewed_w_hiring_manager IS NOT NULL
GROUP BY has_interviewed_w_hiring_manager
"""
hm_df = pd.read_sql_query(hm_query, conn)

if not hm_df.empty:
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
    
    # Hire rate comparison
    labels = ['No HM Interview', 'HM Interview']
    hire_rates = hm_df['hire_rate'].values
    ax1.bar(labels, hire_rates)
    ax1.set_ylabel('Hire Rate (%)')
    ax1.set_title('Hire Rate by Hiring Manager Interview')
    ax1.grid(True, alpha=0.3, axis='y')
    
    for i, rate in enumerate(hire_rates):
        ax1.text(i, rate + 0.5, f'{rate:.1f}%', ha='center', va='bottom')
    
    # Interview count comparison
    interview_counts = hm_df['avg_interviews'].values
    ax2.bar(labels, interview_counts)
    ax2.set_ylabel('Average Number of Interviews')
    ax2.set_title('Interview Rounds by Hiring Manager Interview')
    ax2.grid(True, alpha=0.3, axis='y')
    
    for i, count in enumerate(interview_counts):
        ax2.text(i, count + 0.05, f'{count:.1f}', ha='center', va='bottom')
    
    plt.tight_layout()
    plt.savefig('hiring_manager_impact.png', dpi=300, bbox_inches='tight')
    print("Generated hiring_manager_impact.png")

conn.close()
''')
