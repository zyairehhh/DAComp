fig, axes = plt.subplots(2, 2, figsize=(12, 10))
metrics_to_plot = ['total_count_surveys', 'completion_rate', 'avg_survey_progress_pct', 'cross_channel_score']
metric_names = ['Total Surveys', 'Completion Rate', 'Average Progress (%)', 'Cross-Channel Score']
y_labels = ['Count', 'Rate (0-1)', 'Percentage', 'Binary (0/1)']

for idx, (metric, name, ylabel) in enumerate(zip(metrics_to_plot, metric_names, y_labels)):
    ax = axes[idx // 2, idx % 2]
    
    # Prepare data for box plot
    plot_data = []
    for tier in ['Low-Value', 'Medium-Value', 'High-Value']:
        plot_data.append(df[df['value_tier'] == tier][metric])
    
    # Create box plot
    bp = ax.boxplot(plot_data, patch_artist=True, 
                   boxprops=dict(facecolor='lightgray', alpha=0.7),
                   medianprops=dict(color='red', linewidth=2),
                   whiskerprops=dict(color='black'),
                   capprops=dict(color='black'),
                   flierprops=dict(marker='o', markersize=3, alpha=0.5))
    
    # Color the boxes
    for i, patch in enumerate(bp['boxes']):
        patch.set_facecolor(list(tier_colors.values())[i])
    
    ax.set_title(name, fontsize=12, fontweight='bold')
    ax.set_ylabel(ylabel)
    ax.set_xlabel('Value Tier')
