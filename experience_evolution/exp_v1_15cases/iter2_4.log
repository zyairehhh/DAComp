import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-022.sqlite')

# 1. Vehicle Type Comparison
query1 = """
SELECT 
    "Vehicle Type",
    COUNT(*) as total_rides,
    SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) as completed,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" ELSE NULL END) as avg_fare,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" / "Ride Distance" ELSE NULL END) as avg_per_km_fare,
    (SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) * 1.0 / COUNT(*)) as completion_rate
FROM 
    sheet1 
GROUP BY 
    "Vehicle Type"
ORDER BY 
    avg_per_km_fare DESC
"""
df1 = pd.read_sql_query(query1, conn)
print("=== Vehicle Type Performance ===")
print(df1.to_string(index=False))

# 2. Hourly patterns summary
query2 = """
SELECT 
    CAST(substr("Time", 1, 2) AS INTEGER) as hour,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare,
    COUNT(*) as rides
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    hour
ORDER BY 
    avg_per_km_fare DESC
"""
df2 = pd.read_sql_query(query2, conn)
print("\n=== Hourly Average Per‑KM Fare (All Vehicles) ===")
print(df2.to_string(index=False))

# 3. Top pickup locations
query3 = """
