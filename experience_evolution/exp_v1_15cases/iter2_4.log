# Filter for single-item direct price reduction promotions (type 4)
promo_type_4 = promotions_df[promotions_df['promotion_type'] == 4].copy()

# Calculate discount depth
promo_type_4['discount_depth'] = (promo_type_4['pdj_price'] - promo_type_4['promotion_price']) / promo_type_4['pdj_price'] * 100

# Remove any invalid rows (should already be clean based on earlier analysis)
promo_type_4 = promo_type_4.dropna(subset=['discount_depth', 'sale_count', 'pdj_price', 'promotion_price', 'sku_id'])

# Convert sku_id to string for merging
promo_type_4['sku_id'] = promo_type_4['sku_id'].astype(str)
categories_df['sku_id'] = categories_df['sku_id'].astype(str)

# Merge with category data
merged_df = pd.merge(promo_type_4, categories_df, on='sku_id', how='left')

print(f"Total promotions with category data: {len(merged_df[merged_df['Level 1 Category Name'].notna()])}")
print(f"Promotions without category data: {len(merged_df[merged_df['Level 1 Category Name'].isna()])}")

# Create visualizations

