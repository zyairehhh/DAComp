```python
import pandas as pd
import numpy as np

# Load data
df = pd.read_csv('contacts.csv')
print(f"Total contacts: {len(df)}")
print(df.head())

# Calculate completion rate
df['completion_rate'] = df['total_count_completed_surveys'] / df['total_count_surveys'].replace(0, np.nan)
df['completion_rate'].fillna(0, inplace=True)

# Cross-channel activity: 1 if both email and SMS sent >0 else 0
df['cross_channel'] = ((df['count_surveys_sent_email'] > 0) & (df['count_surveys_sent_sms'] > 0)).astype(int)

# Participation frequency: total surveys sent
# Normalize to 0-100 using min-max scaling based on entire population
min_freq = df['total_count_surveys'].min()
max_freq = df['total_count_surveys'].max()
df['freq_score_raw'] = (df['total_count_surveys'] - min_freq) / (max_freq - min_freq)
df['freq_score'] = df['freq_score_raw'] * 100

# Completion rate normalization (0-100)
df['completion_score_raw'] = df['completion_rate']
df['completion_score'] = df['completion_rate'] * 100  # already 0-1

# Cross-channel score (binary) -> 0 or 100
df['cross_channel_score'] = df['cross_channel'] * 100

# Weighted composite score
weights = {'freq': 0.4, 'completion': 0.4, 'cross_channel': 0.2}
df['composite_score'] = (
    df['freq_score'] * weights['freq'] +
    df['completion_score'] * weights['completion'] +
    df['cross_channel_score'] * weights['cross_channel']
)

print("Score distribution:")
print(df[['freq_score','completion_score','cross_channel_score','composite_score']].describe())

# Define value segments based on composite score percentiles
# We'll define power_users (top 5%), high_value (next 15%), medium_value (next 30%), low_value (next 30%), one_time (bottom 20%)
percentiles = df['composite_score'].quantile([0.95, 0.8, 0.5, 0.2])
print("\nPercentiles (95%, 80%, 50%, 20%):")
print(percentiles)

def assign_segment(score, p95, p80, p50, p20):
    if score >= p95:
        return 'power_user'
    elif score >= p80:
        return 'high_value'
    elif score >= p50:
        return 'medium_value'
    elif score >= p20:
        return 'low_value'
    else:
        return 'one_time'

df['value_segment'] = df['composite_score'].apply(
    assign_segment,
    args=(percentiles.iloc[0], percentiles.iloc[1], percentiles.iloc[2], percentiles.iloc[3])
)

print("\nSegment counts:")
print(df['value_segment'].value_counts())

# Save to CSV for further analysis
df.to_csv('contacts_with_scores.csv', index=False)
print("\nSaved contacts_with_scores.csv")
```
