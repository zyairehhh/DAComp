import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import os

# Connect to database
conn = sqlite3.connect('dacomp-069.sqlite')

# 1. Monthly overall performance score and research budget for 2024
query = """
SELECT 
    strftime('%Y-%m', date_day) as month,
    overall_performance_score,
    research_budget_usd
FROM google_play__comprehensive_performance_dashboard
WHERE strftime('%Y', date_day) = '2024'
GROUP BY month
ORDER BY month
"""
df_monthly = pd.read_sql_query(query, conn)
df_monthly['month'] = pd.to_datetime(df_monthly['month'])

# 2. Regional performance from geo_market_analysis (use latest snapshot? We'll assume the table is aggregated across time)
query_region = """
SELECT 
    region,
    AVG(avg_active_devices) as avg_active_devices,
    AVG(overall_market_score) as avg_market_score,
    AVG(app_quality_score) as avg_app_quality_score,
    AVG(avg_daily_revenue) as avg_daily_revenue,
    AVG(avg_transaction_value) as avg_transaction_value,
    COUNT(DISTINCT country) as country_count
FROM google_play__geo_market_analysis
GROUP BY region
ORDER BY avg_market_score DESC
"""
df_region = pd.read_sql_query(query_region, conn)

# 3. Country-level data for scatter plots
query_country = """
SELECT 
    country,
    region,
    avg_transaction_value,
    overall_market_score,
    app_quality_score
FROM google_play__geo_market_analysis
"""
df_country = pd.read_sql_query(query_country, conn)

# 4. High vs low revenue markets: split at $7
high_rev = df_country[df_country['avg_transaction_value'] > 7]
low_rev = df_country[df_country['avg_transaction_value'] <= 7]

# Close connection
conn.close()

# Plot 1: Monthly overall performance score and research budget
fig1, ax1 = plt.subplots(figsize=(10, 6))
ax1.plot(df_monthly['month'], df_monthly['overall_performance_score'], marker='o', linewidth=2, label='Overall Performance Score')
ax1.set_xlabel('Month (2024)')
ax1.set_ylabel('Overall Performance Score', color='blue')
ax1.tick_params(axis='y', labelcolor='blue')
ax1.set_title('Monthly Overall Performance Score Trend')
ax1.grid(True, alpha=0.3)

ax2 = ax1.twinx()
ax2.plot(df_monthly['month'], df_monthly['research_budget_usd'], marker='s', color='red', linewidth=2, label='Research Budget (USD)')
ax2.set_ylabel('Research Budget (USD)', color='red')
ax2.tick_params(axis='y', labelcolor='red')

# Combine legends
lines1, labels1 = ax1.get_legend_handles_labels()
lines2, labels2 = ax2.get_legend_handles_labels()
ax1.legend(lines1 + lines2, labels1 + labels2, loc='upper right')

plt.tight_layout()
plt.savefig('monthly_score_budget.png', dpi=300)
plt.close()

# Plot 2: Regional market score vs app quality score (bar chart)
fig2, ax = plt.subplots(figsize=(10, 6))
x = range(len(df_region))
width = 0.35
bars1 = ax.bar(x, df_region['avg_market_score'], width, label='Avg Market Score', color='steelblue')
bars2 = ax.bar([i + width for i in x], df_region['avg_app_quality_score'], width, label='Avg App Quality Score', color='lightcoral')
ax.set_xlabel('Region')
ax.set_ylabel('Score')
ax.set_title('Regional Market Score vs App Quality Score')
ax.set_xticks([i + width/2 for i in x])
ax.set_xticklabels(df_region['region'], rotation=0)
ax.legend()
ax.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('regional_scores.png', dpi=300)
plt.close()

# Plot 3: Scatter of avg transaction value vs market score, colored by region
fig3, ax = plt.subplots(figsize=(10, 6))
scatter = ax.scatter(df_country['avg_transaction_value'], df_country['overall_market_score'], c=pd.Categorical(df_country['region']).codes, cmap='tab20', alpha=0.7, s=100)
ax.set_xlabel('Average Transaction Value ($)')
ax.set_ylabel('Overall Market Score')
ax.set_title('Transaction Value vs Market Score by Region')
# Add a legend for regions
regions = df_country['region'].unique()
for i, region in enumerate(regions):
    ax.scatter([], [], color=plt.cm.tab20(i), label=region)
ax.legend(title='Region')
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('transaction_vs_market.png', dpi=300)
plt.close()

# Plot 4: Same but vs app quality score
fig4, ax = plt.subplots(figsize=(10, 6))
scatter = ax.scatter(df_country['avg_transaction_value'], df_country['app_quality_score'], c=pd.Categorical(df_country['region']).codes, cmap='tab20', alpha=0.7, s=100)
ax.set_xlabel('Average Transaction Value ($)')
ax.set_ylabel('App Quality Score')
ax.set_title('Transaction Value vs App Quality Score by Region')
for i, region in enumerate(regions):
    ax.scatter([], [], color=plt.cm.tab20(i), label=region)
ax.legend(title='Region')
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('transaction_vs_quality.png', dpi=300)
plt.close()

# Plot 5: Bar comparison Indonesia vs high-revenue group average
high_rev_avg_market = high_rev['overall_market_score'].mean()
high_rev_avg_quality = high_rev['app_quality_score'].mean()
indonesia = df_country[df_country['country'] == 'Indonesia']
if not indonesia.empty:
    indo_market = indonesia['overall_market_score'].values[0]
    indo_quality = indonesia['app_quality_score'].values[0]
else:
    # fallback: low_rev group
    indo_market = low_rev['overall_market_score'].mean()
    indo_quality = low_rev['app_quality_score'].mean()

categories = ['Market Score', 'App Quality Score']
high_vals = [high_rev_avg_market, high_rev_avg_quality]
low_vals = [indo_market, indo_quality]

fig5, ax = plt.subplots(figsize=(8, 6))
x = range(len(categories))
width = 0.35
ax.bar(x, high_vals, width, label='High Revenue (>$7) Avg', color='darkgreen')
ax.bar([i + width for i in x], low_vals, width, label='Indonesia (≤$7)', color='darkorange')
ax.set_xlabel('Metric')
ax.set_ylabel('Score')
ax.set_title('Performance Comparison: High Revenue Markets vs Indonesia')
ax.set_xticks([i + width/2 for i in x])
ax.set_xticklabels(categories)
ax.legend()
ax.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('high_vs_low_revenue.png', dpi=300)
plt.close()

print("Plots generated.")
```
