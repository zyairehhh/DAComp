                                     sample['rolling_total_average_rating'],
                                     alpha=0.6, s=50, edgecolors='black')
        axes2[0, 1].set_xlabel('Conversion Rate')
        axes2[0, 1].set_ylabel('Average Rating')
        axes2[0, 1].set_title('Conversion Rate vs Average Rating Relationship')
        
        # Add quadratic trend line
        if len(sample) > 3:
            x = sample['store_listing_conversion_rate']
            y = sample['rolling_total_average_rating']
            z = np.polyfit(x, y, 2)
            p = np.poly1d(z)
            x_sorted = np.sort(x)
            axes2[0, 1].plot(x_sorted, p(x_sorted), 'r--', alpha=0.8, label='Quadratic Trend')
            axes2[0, 1].legend()
    else:
        axes2[0, 1].text(0.5, 0.5, 'Insufficient data\nfor scatter analysis',
                        ha='center', va='center', transform=axes2[0, 1].transAxes)
        axes2[0, 1].set_title('Conversion Rate vs Rating')
    
    axes2[0, 1].grid(True, alpha=0.3)
    
    # Subplot 3: Crash Rate vs Conversion
    if len(df_quality) > 7:
        df_quality['crash_ma'] = df_quality['crash_rate_per_1k'].rolling(window=7).mean()
        df_quality['conversion_ma'] = df_quality['avg_conversion_rate'].rolling(window=7).mean()
        plot_data = df_quality.dropna(subset=['conversion_ma', 'crash_ma'])
        
        axes2[1, 0].plot(plot_data['date_day'], plot_data['conversion_ma'], 'b-', label='Conv Rate (7d MA)', alpha=0.8)
        axes2[1, 0].set_xlabel('Date')
        axes2[1, 0].set_ylabel('Conversion Rate', color='b')
        axes2[1, 0].tick_params(axis='y', labelcolor='b')
        
        ax2_3b = axes2[1, 0].twinx()
