import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect("dacomp-058.sqlite")
# Load the filtered dataset we saved
df_filtered = pd.read_csv('filtered_campaigns_with_scores.csv')

# Summarize by campaign_type
type_summary = df_filtered.groupby('campaign_type').agg(
    count=('campaign_id', 'size'),
    avg_health=('health_score', 'mean'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean'),
    risk_high=('risk_level', lambda x: (x == 'High').sum()),
    risk_medium=('risk_level', lambda x: (x == 'Medium').sum()),
    risk_low=('risk_level', lambda x: (x == 'Low').sum())
).reset_index()
print("=== Performance by Campaign Type ===")
print(type_summary)

# Summarize by bidding_strategy
bid_summary = df_filtered.groupby('bidding_strategy').agg(
    count=('campaign_id', 'size'),
    avg_health=('health_score', 'mean'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean')
).reset_index()
print("\n=== Performance by Bidding Strategy ===")
print(bid_summary)

# Summarize by industry
industry_summary = df_filtered.groupby('industry').agg(
    count=('campaign_id', 'size'),
    avg_health=('health_score', 'mean'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean')
).reset_index()
print("\n=== Performance by Industry ===")
print(industry_summary)

conn.close()
```
