We need to define a target variable for high-value customers. The current model uses usage duration and frequency, but we need to improve accuracy. We can hypothesize that high-value customers are those with high engagement (sum_minutes, sum_events), high NPS (>=9 promoters), high feature usage, etc. Let's examine the distribution of NPS ratings among high-engagement users.

Action: CreateFile(filepath='analyze_target.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')

# Load visitor data with more columns
visitor_df = pd.read_sql_query('''
SELECT 
    visitor_id,
    account_id,
    latest_nps_rating,
    count_active_days,
    count_active_months,
    sum_minutes,
    sum_events,
    average_daily_minutes,
    average_daily_events,
    last_browser_name,
    last_operating_system,
    last_server_name,
    CAST(strftime('%s', last_visit) - strftime('%s', first_visit_at) AS REAL) / (3600*24) as tenure_days
FROM pendo__visitor
''', conn)

# Load aggregated daily metrics
daily_agg = pd.read_sql_query('''
SELECT 
    visitor_id,
    SUM(count_pages_viewed) as total_pages_viewed,
    SUM(count_features_clicked) as total_features_clicked,
    AVG(sum_minutes) as avg_daily_minutes,
    COUNT(DISTINCT date_day) as active_days
FROM pendo__visitor_daily_metrics
GROUP BY visitor_id
''', conn)

# Load visitor feature engagement
feature_engagement = pd.read_sql_query('''
SELECT 
    visitor_id,
    COUNT(DISTINCT feature_id) as distinct_features_used,
    SUM(sum_clicks) as total_feature_clicks,
    AVG(sum_minutes) as avg_minutes_per_feature
FROM pendo__visitor_feature
GROUP BY visitor_id
''', conn)

# Merge
df = visitor_df.merge(daily_agg, on='visitor_id', how='left')
df = df.merge(feature_engagement, on='visitor_id', how='left')
df.fillna(0, inplace=True)

# Define high-value based on business logic: 
# 1. High engagement (top 20% by sum_minutes)
# 2. High NPS (rating >= 9)
# 3. High feature usage (top 20% by distinct_features_used)
# We'll create a composite label
df['engagement_percentile'] = df['sum_minutes'].rank(pct=True)
df['feature_percentile'] = df['distinct_features_used'].rank(pct=True)
df['high_value'] = ((df['engagement_percentile'] >= 0.8) & 
                    (df['latest_nps_rating'] >= 9) & 
                    (df['feature_percentile'] >= 0.8)).astype(int)

print("High-value customers (strict definition):", df['high_value'].sum())
print("Percentage:", df['high_value'].mean())

# Alternative: Use clustering to identify high-value segment
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

features = ['sum_minutes', 'sum_events', 'latest_nps_rating', 
            'distinct_features_used', 'total_feature_clicks',
            'total_pages_viewed', 'count_active_days']
X = df[features].fillna(0)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# K-means with 3 clusters
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
df['cluster'] = kmeans.fit_predict(X_scaled)

# Identify which cluster is high-value (likely highest sum_minutes)
cluster_stats = df.groupby('cluster')[['sum_minutes', 'sum_events', 'latest_nps_rating', 'distinct_features_used']].mean()
print("\nCluster means:")
print(cluster_stats)

# Assume cluster with highest sum_minutes is high-value
high_value_cluster = cluster_stats['sum_minutes'].idxmax()
df['high_value_cluster'] = (df['cluster'] == high_value_cluster).astype(int)
print(f"\nHigh-value cluster {high_value_cluster} size:", df['high_value_cluster'].sum())

# Compare with simple percentile
print("\nOverlap between strict definition and cluster definition:")
print(pd.crosstab(df['high_value'], df['high_value_cluster']))

# Save with labels
df.to_csv('visitor_with_labels.csv', index=False)
print("\nSaved visitor_with_labels.csv")

conn.close()
''')
