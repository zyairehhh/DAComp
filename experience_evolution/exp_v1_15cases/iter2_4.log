'''
import pandas as pd

# Load health scores (has core_diagnosis)
health = pd.read_csv('campaign_health_scores.csv')
# Load high risk campaigns
high_risk = pd.read_csv('high_risk_campaigns.csv')
# Merge
high_risk = pd.merge(high_risk, health[['campaign_id', 'year_month', 'core_diagnosis', 'health_score', 'risk_level']], on=['campaign_id', 'year_month'], how='left')
# Sort by cost descending
top10 = high_risk.sort_values('cost', ascending=False).head(10)

# Load dimensional stats
dim_campaign = pd.read_csv('dim_campaign_type.csv')
dim_bidding = pd.read_csv('dim_bidding.csv')
dim_industry = pd.read_csv('dim_industry.csv')
geo_stats = pd.read_csv('geo_stats.csv')
device_stats = pd.read_csv('device_stats.csv')
monthly = pd.read_csv('monthly_trends.csv')
seasonal = pd.read_csv('seasonal_patterns.csv')

# Compute risk counts
risk_counts = health['risk_level'].value_counts()
total = health.shape[0]

# Write markdown
with open('stage1.md', 'w') as f:
    f.write('# Campaign Health Assessment & Optimization System\\n\\n')
    f.write('## Executive Summary\\n')
    f.write(f'This analysis evaluates Google Ads campaigns with monthly cost > $1,000 and ROAS < 0.8, identified as high-cost, low-return campaigns. We developed a three-dimensional health score model (Cost Efficiency 40%, Conversion Quality 35%, Competitiveness 25%) to assess {total} campaign-month records from Feb 2023 to Jun 2024.\\n\\n')
    f.write('**Key findings:**\\n')
    f.write(f'- {risk_counts.get("Critical",0)} campaigns are at **Critical** risk, {risk_counts.get("High",0)} at **High** risk.\\n')
    low_health = health[health["health_score"] < 50].shape[0]
    f.write(f'- {low_health} ({low_health/total:.1%}) of campaigns have health scores below 50 (poor performance).\\n')
    # Get best/worst campaign type
    best_campaign = dim_campaign.loc[dim_campaign["health_score"].idxmax()]
    worst_campaign = dim_campaign.loc[dim_campaign["health_score"].idxmin()]
    f.write(f'- **{best_campaign["campaign_type"]}** campaigns perform best (avg health score {best_campaign["health_score"]:.1f}), while **{worst_campaign["campaign_type"]}** campaigns are the worst (avg health score {worst_campaign["health_score"]:.1f}).\\n')
    best_bid = dim_bidding.loc[dim_bidding["health_score"].idxmax()]
    worst_bid = dim_bidding.loc[dim_bidding["health_score"].idxmin()]
    f.write(f'- **{best_bid["bidding_strategy"]}** bidding strategy yields the highest health score ({best_bid["health_score"]:.1f}); {worst_bid["bidding_strategy"]} is the lowest ({worst_bid["health_score"]:.1f}).\\n')
    best_ind = dim_industry.loc[dim_industry["health_score"].idxmax()]
    worst_ind = dim_industry.loc[dim_industry["health_score"].idxmin()]
    f.write(f'- **{best_ind["industry"]}** industry campaigns show the strongest health ({best_ind["health_score"]:.1f}); **{worst_ind["industry"]}** campaigns are the weakest ({worst_ind["health_score"]:.1f}).\\n')
    best_geo = geo_stats.loc[geo_stats["roi"].idxmax()]
    worst_geo = geo_stats.loc[geo_stats["roi"].idxmin()]
    f.write(f'- Geographic distribution: **{best_geo["geo_target"]}** delivers the highest ROI ({best_geo["roi"]:.2f}), while **{worst_geo["geo_target"]}** has the lowest ROI ({worst_geo["roi"]:.2f}) among high‑cost campaigns.\\n')
    best_dev = device_stats.loc[device_stats["roi"].idxmax()]
    worst_dev = device_stats.loc[device_stats["roi"].idxmin()]
    f.write(f'- Device performance: **{best_dev["device_type"]}** traffic achieves the highest ROI ({best_dev["roi"]:.2f}), slightly ahead of Desktop and Mobile.\\n')
    monthly["year_month"] = pd.to_datetime(monthly["year_month"])
    max_growth = monthly.loc[monthly["cost_mom_pct"].idxmax()]
    f.write(f'- Trend analysis shows the largest month‑over‑month cost increase occurred in {max_growth["year_month"].strftime("%B %Y")} ({max_growth["cost_mom_pct"]:.1f}%).\\n')
    seasonal_max = seasonal.loc[seasonal["cost"].idxmax()]
    seasonal_conv = seasonal.loc[seasonal["conversions"].idxmax()]
    f.write(f'- Seasonal patterns indicate advertising costs peak in **Month {int(seasonal_max["month"])}** (average ${seasonal_max["cost"]:,.0f}), while conversions are highest in **Month {int(seasonal_conv["month"])}**.\\n\\n')
    
    f.write('## Methodology\\n')
    f.write('1. **Screening criteria**: Monthly cost > $1,000 and ROAS < 0.8.\\n')
    f.write('2. **Health Score Model**:\\n')
    f.write('   - *Cost Efficiency (40%)*: ROAS (higher better) and cost‑per‑conversion (lower better), each normalized to percentile rank.\\n')
    f.write('   - *Conversion Quality (35%)*: Conversion rate and quality score, normalized.\\n')
    f.write('   - *Competitiveness (25%)*: Impression share and CTR, normalized.\\n')
    f.write('3. **Risk levels**: Critical (<25), High (25‑49), Medium (50‑74), Low (≥75).\\n')
    f.write('4. **Trend analysis**: Month‑over‑month and year‑over‑year growth rates, seasonal averages.\\n\\n')
    
