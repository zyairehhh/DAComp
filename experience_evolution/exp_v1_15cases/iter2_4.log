import pandas as pd
import numpy as np

# Load data
risk_df = pd.read_csv('customer_risk_ratings.csv')
high_vol = risk_df[risk_df['high_volatility'] == True]
others = risk_df[risk_df['high_volatility'] == False]

print("=== HIGH-VOLATILITY CUSTOMER ANALYSIS ===")
print(f"Count: {len(high_vol)}")
print(f"Average customer_margin_volatility: {high_vol['avg_volatility'].mean():.4f}")
print(f"Coefficient of variation of gross_profit (mean): {high_vol['coeff_var'].mean():.4f}")
print(f"Variance of quarter-over-quarter invoice_total growth rate (mean): {high_vol['growth_variance'].mean():.4f}")
print("\nBehavioral breakdown:")
print("RFM segments:")
print(high_vol['rfm_segment'].value_counts())
print("\nPayment behavior:")
print(high_vol['payment_behavior'].value_counts())
print("\nLifecycle stages:")
print(high_vol['lifecycle_stage'].value_counts())
print("\nRisk rating distribution:")
print(high_vol['risk_rating'].value_counts())

print("\n=== COMPARISON WITH OTHER CUSTOMERS ===")
print(f"Count: {len(others)}")
print(f"Average customer_margin_volatility: {others['avg_volatility'].mean():.4f}")
print(f"Coefficient of variation (mean): {others['coeff_var'].mean():.4f}")
print(f"Growth variance (mean): {others['growth_variance'].mean():.4f}")
print("\nRFM segments:")
print(others['rfm_segment'].value_counts())
print("\nRisk rating distribution:")
print(others['risk_rating'].value_counts())

# Load financial dashboard correlation results from explore_behavior.py output (we can recompute)
import sqlite3
conn = sqlite3.connect('dacomp-092.sqlite')
# Get high-volatility customer IDs
high_vol_ids = high_vol['customer_id'].tolist()

# Revenue share correlation
dashboard_query = """
SELECT dashboard_month, total_revenue, business_health_score, collection_rate_percentage
FROM quickbooks__financial_dashboard
ORDER BY dashboard_month;
"""
dashboard_df = pd.read_sql_query(dashboard_query, conn)
monthly_high_vol_rev_query = """
SELECT strftime('%Y-%m', transaction_date) AS month, SUM(invoice_total) AS high_vol_revenue
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({})
GROUP BY month
""".format(','.join(['?'] * len(high_vol_ids)))
monthly_high_vol_rev = pd.read_sql_query(monthly_high_vol_rev_query, conn, params=high_vol_ids)
monthly_high_vol_rev['dashboard_month'] = pd.to_datetime(monthly_high_vol_rev['month'] + '-01')
dashboard_df['dashboard_month'] = pd.to_datetime(dashboard_df['dashboard_month'])
merged_dash = pd.merge(dashboard_df, monthly_high_vol_rev, on='dashboard_month', how='left')
merged_dash['high_vol_revenue'].fillna(0, inplace=True)
merged_dash['high_vol_share'] = merged_dash['high_vol_revenue'] / merged_dash['total_revenue']
corr_health = merged_dash['high_vol_share'].corr(merged_dash['business_health_score'])
corr_collection = merged_dash['high_vol_share'].corr(merged_dash['collection_rate_percentage'])
print(f"\nCorrelation between high-vol share and business_health_score: {corr_health:.3f}")
print(f"Correlation between high-vol share and collection_rate_percentage: {corr_collection:.3f}")

# Accounts receivable structure
balance_query = """
SELECT account_sub_type, SUM(amount) AS total_amount
FROM quickbooks__balance_sheet
WHERE account_type = 'Accounts Receivable'
GROUP BY account_sub_type
"""
balance_df = pd.read_sql_query(balance_query, conn)
print("\nAccounts Receivable Aging:")
print(balance_df)
total_ar = balance_df['total_amount'].sum()
balance_df['share'] = balance_df['total_amount'] / total_ar
print(balance_df[['account_sub_type', 'share']])

# High-volatility customers' share of outstanding balance
outstanding_total = risk_df['total_outstanding'].sum()
high_vol_outstanding = high_vol['total_outstanding'].sum()
print(f"\nHigh-volatility customers account for {high_vol_outstanding/outstanding_total:.1%} of total outstanding balance.")

