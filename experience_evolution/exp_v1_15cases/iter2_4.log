WITH dept_total AS (
    SELECT u.Department, COUNT(l.'Login Record ID') as total_logins
    FROM login_records_table l
    LEFT JOIN user_information_table u ON l.'User ID' = u.'User ID'
    GROUP BY u.Department
),
dept_abnormal AS (
    SELECT u.Department, COUNT(a.'Anomaly ID') as abnormal_logins
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a.'Login Record ID' = l.'Login Record ID'
    JOIN user_information_table u ON l.'User ID' = u.'User ID'
    GROUP BY u.Department
)
SELECT 
    dt.Department,
    dt.total_logins,
    da.abnormal_logins,
    ROUND(da.abnormal_logins * 100.0 / dt.total_logins, 2) as abnormal_rate_percent,
    (SELECT COUNT(*) FROM user_information_table uu WHERE uu.Department = dt.Department) as user_count
FROM dept_total dt
JOIN dept_abnormal da ON dt.Department = da.Department
ORDER BY abnormal_rate_percent DESC;
", output="direct")
