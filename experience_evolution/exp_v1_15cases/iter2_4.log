# Merge using the integer version
merged_df = pd.merge(promotions_df, categories_df, left_on='sku_id_int', right_on='sku_id_int', how='left')

print(f"\nMerged data shape: {merged_df.shape}")
print(f"Rows with category data: {merged_df['Level 1 Category Name'].notna().sum()}")

