# Query url report
query = """
SELECT ad_group_id, base_url,
       SUM(clicks) as clicks, SUM(impressions) as impressions,
       SUM(conversions) as conversions
FROM google_ads__url_report
GROUP BY ad_group_id, base_url
"""
url_df = pd.read_sql_query(query, conn)
url_df['is_problematic'] = url_df['ad_group_id'].isin(problematic_ids)

# Aggregate by base_url and problematic flag
url_summary = url_df.groupby(['is_problematic', 'base_url']).agg({
    'clicks': 'sum',
    'impressions': 'sum',
    'conversions': 'sum'
}).reset_index()
url_summary['ctr'] = url_summary['clicks'] / url_summary['impressions']
url_summary['cvr'] = url_summary['conversions'] / url_summary['clicks']
url_summary['cvr'].fillna(0, inplace=True)

# For each group (problematic vs not), get top 5 base_url by clicks
top_problematic = url_summary[url_summary['is_problematic'] == True].sort_values('clicks', ascending=False).head(10)
top_non_problematic = url_summary[url_summary['is_problematic'] == False].sort_values('clicks', ascending=False).head(10)
print('Top landing pages for problematic groups:')
print(top_problematic[['base_url', 'clicks', 'ctr', 'cvr']])
print('\\nTop landing pages for non-problematic groups:')
print(top_non_problematic[['base_url', 'clicks', 'ctr', 'cvr']])
''')
