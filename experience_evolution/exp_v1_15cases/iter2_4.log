'''
import pandas as pd
import matplotlib.pyplot as plt
import sqlite3

conn = sqlite3.connect('dacomp-067.sqlite')
# Load diversity_metrics table
div = pd.read_sql_query("SELECT * FROM greenhouse__diversity_metrics", conn)

# Prepare data for bar chart: gender hires
gender_hires = [div['female_hires'].iloc[0], div['male_hires'].iloc[0]]
gender_labels = ['Female', 'Male']
gender_rates = [div['female_hire_rate'].iloc[0], div['male_hire_rate'].iloc[0]]

fig, axes = plt.subplots(1, 2, figsize=(12,5))

# Bar for hire counts
axes[0].bar(gender_labels, gender_hires, color=['pink', 'lightblue'])
axes[0].set_title('Number of Hires by Gender (2024 Q4)', fontsize=14)
axes[0].set_ylabel('Hire Count', fontsize=12)
for i, v in enumerate(gender_hires):
    axes[0].text(i, v+50, str(v), ha='center')

# Bar for hire rates
axes[1].bar(gender_labels, gender_rates, color=['pink', 'lightblue'])
axes[1].set_title('Hire Rate (%) by Gender', fontsize=14)
axes[1].set_ylabel('Hire Rate (%)', fontsize=12)
for i, v in enumerate(gender_rates):
    axes[1].text(i, v+0.5, f'{v:.1f}%', ha='center')

plt.tight_layout()
plt.savefig('gender_diversity.png', dpi=300)
plt.close()

# Race diversity
race_hires = [div['non_white_hires'].iloc[0], div['white_hires'].iloc[0]]
race_labels = ['Non-White', 'White']
race_rates = [div['non_white_hire_rate'].iloc[0], div['white_hire_rate'].iloc[0]]

fig, axes = plt.subplots(1, 2, figsize=(12,5))
axes[0].bar(race_labels, race_hires, color=['orange', 'gray'])
axes[0].set_title('Number of Hires by Race', fontsize=14)
axes[0].set_ylabel('Hire Count', fontsize=12)
for i, v in enumerate(race_hires):
    axes[0].text(i, v+50, str(v), ha='center')

axes[1].bar(race_labels, race_rates, color=['orange', 'gray'])
axes[1].set_title('Hire Rate (%) by Race', fontsize=14)
axes[1].set_ylabel('Hire Rate (%)', fontsize=12)
for i, v in enumerate(race_rates):
    axes[1].text(i, v+0.5, f'{v:.1f}%', ha='center')

plt.tight_layout()
plt.savefig('race_diversity.png', dpi=300)
plt.close()

# Show that diversity targets are met
target_female = 40
target_nonwhite = 30
female_rep = div['female_hire_representation'].iloc[0]
nonwhite_rep = div['non_white_hire_representation'].iloc[0]

fig, ax = plt.subplots(figsize=(8,5))
ax.bar(['Female Hire %', 'Non‑White Hire %'], [female_rep, nonwhite_rep], color=['lightgreen', 'lightgreen'])
ax.axhline(y=target_female, color='red', linestyle='--', label=f'Target ({target_female}%)')
ax.axhline(y=target_nonwhite, color='blue', linestyle='--', label=f'Target ({target_nonwhite}%)')
ax.set_ylabel('Percentage of Hires (%)', fontsize=12)
ax.set_title('Diversity Targets vs Actual Representation', fontsize=14)
ax.legend()
for i, v in enumerate([female_rep, nonwhite_rep]):
    ax.text(i, v+1, f'{v:.1f}%', ha='center')
plt.tight_layout()
plt.savefig('diversity_targets.png', dpi=300)
plt.close()

print("Diversity plots saved.")
''')
