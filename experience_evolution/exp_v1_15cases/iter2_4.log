import numpy as np
from datetime import datetime, timedelta

print("Creating visualizations...")

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Time series decay analysis
query1 = "SELECT date_day, daily_installs, daily_uninstalls, daily_revenue, revenue_per_active_device FROM google_play__time_series_trends ORDER BY date_day"
