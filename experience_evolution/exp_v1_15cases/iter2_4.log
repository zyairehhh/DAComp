import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-092.sqlite')

# Get high-volatility customer IDs
query = """
SELECT customer_id,
       AVG(customer_margin_volatility) as avg_margin_volatility
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql(query, conn)
threshold = df_cust_vol['avg_margin_volatility'].quantile(0.75)
high_vol_ids = df_cust_vol[df_cust_vol['avg_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers: {len(high_vol_ids)}")

# Get customer_analytics for these IDs
query = f"""
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
       lifecycle_stage, customer_value_segment, credit_grade, risk_assessment,
       avg_monthly_revenue, total_invoice_amount, outstanding_balance
FROM quickbooks__customer_analytics
WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
"""
df_cust_analytics = pd.read_sql(query, conn, params=high_vol_ids)
print(df_cust_analytics.head())
print(f"Rows matched: {df_cust_analytics.shape[0]}")

# Summarize
print("\nRFM Segment distribution:")
print(df_cust_analytics['rfm_segment'].value_counts())
print("\nPayment behavior distribution:")
print(df_cust_analytics['payment_behavior'].value_counts())
print("\nLifecycle stage distribution:")
print(df_cust_analytics['lifecycle_stage'].value_counts())
print("\nRevenue trend correlation stats:")
print(df_cust_analytics['revenue_trend_correlation'].describe())
```
