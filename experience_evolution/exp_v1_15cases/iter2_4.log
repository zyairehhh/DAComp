'''
import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

conn = sqlite3.connect('dacomp-098.sqlite')
# Load conversations with tags and metrics
query = '''
SELECT 
    c.conversation_id,
    c.conversation_created_at as initiated_at,
    m.first_admin_response_at as first_response_at,
    m.conversation_initiated_type as responder_type,
    c.all_conversation_tags as tags,
    m.time_to_first_response_minutes as resp_minutes,
    m.time_to_first_close_minutes as close_minutes,
    m.time_to_admin_first_close_minutes as admin_close_minutes,
    c.first_close_at,
    c.last_close_at,
    c.conversation_subject,
    c.conversation_rating,
    c.all_conversation_contacts as contact_id
FROM intercom__conversation_enhanced c
JOIN intercom__conversation_metrics m ON c.conversation_id = m.conversation_id
'''
df = pd.read_sql(query, conn)
print(f"Total conversations: {len(df)}")
# Parse tags
def extract_tag(tags, key):
    if pd.isna(tags):
        return None
    import re
    match = re.search(rf'{key}:([^|]+)', tags)
    return match.group(1) if match else None

for key in ['intent', 'topic', 'stage', 'segment', 'region', 'lifecycle']:
    df[key] = df['tags'].apply(lambda x: extract_tag(x, key))

# Define funnel stages
df['stage_group'] = df['stage']

# Segment by responder_type
human = df[df['responder_type'] == 'human_first']
bot = df[df['responder_type'] == 'bot_first']
print("Human first count:", len(human))
print("Bot first count:", len(bot))

# Overall conversion rates (conversation -> demo booked)
def conversion_rate(df, stage_target):
    total = len(df)
    converted = len(df[df['stage_group'] == stage_target])
    return total, converted, converted / total if total > 0 else 0

# We'll compute for each stage
stages = ['demo_booked', 'trial_started', 'trial_activated', 'closed_won', 'expansion_in_flight']
for stage in stages:
    total_h, conv_h, rate_h = conversion_rate(human, stage)
    total_b, conv_b, rate_b = conversion_rate(bot, stage)
    print(f"Stage {stage}: Human total {total_h}, converted {conv_h}, rate {rate_h:.3f}")
    print(f"Stage {stage}: Bot total {total_b}, converted {conv_b}, rate {rate_b:.3f}")

# Conditional conversion: demo_booked -> trial_activated
# We need per contact sequence; for simplicity compute probability of being at trial_activated given demo_booked (maybe same conversation?).
# This is flawed; we need per contact analysis.

# Let's attempt per contact analysis: group by contact_id, aggregate stages across conversations.
# Keep only contacts with at least one conversation.
contacts = df.groupby('contact_id').agg({
    'conversation_id': 'count',
    'responder_type': lambda x: x.iloc[0],  # maybe first conversation responder? we treat each conversation separately.
    'stage_group': list,
    'intent': list,
    'topic': list,
    'region': lambda x: x.iloc[0] if not pd.isna(x.iloc[0]) else None,
    'segment': lambda x: x.iloc[0] if not pd.isna(x.iloc[0]) else None,
    'lifecycle': lambda x: x.iloc[0] if not pd.isna(x.iloc[0]) else None
}).reset_index()
contacts = contacts.rename(columns={'conversation_id': 'conversation_count'})
print(f"Unique contacts: {len(contacts)}")
print(contacts.head())

# Compute funnel per contact: if any conversation stage is demo_booked, mark as demo_booked; trial_activated, etc.
def has_stage(contact_stages, target):
    if isinstance(contact_stages, list):
        return target in contact_stages
    return False

for stage in stages:
    contacts[stage] = contacts['stage_group'].apply(lambda x: has_stage(x, stage))

# Now compute conversion rates per responder_type (need responder_type per contact: choose the most frequent? Use first responder type for simplicity)
contacts['responder_type'] = contacts['responder_type']  # already from agg

# Now compute conditional conversion: demo_booked -> trial_activated -> closed_won
# For contacts who have demo_booked, proportion that have trial_activated
human_contacts = contacts[contacts['responder_type'] == 'human_first']
bot_contacts = contacts[contacts['responder_type'] == 'bot_first']

for stage_seq in [('demo_booked', 'trial_activated'), ('trial_activated', 'closed_won')]:
    prev, next_stage = stage_seq
    # Human
    total_h = human_contacts[human_contacts[prev]].shape[0]
    converted_h = human_contacts[human_contacts[prev] & human_contacts[next_stage]].shape[0]
    rate_h = converted_h / total_h if total_h > 0 else 0
    # Bot
    total_b = bot_contacts[bot_contacts[prev]].shape[0]
    converted_b = bot_contacts[bot_contacts[prev] & bot_contacts[next_stage]].shape[0]
    rate_b = converted_b / total_b if total_b > 0 else 0
    print(f"Conversion from {prev} to {next_stage}: Human {rate_h:.3f} ({converted_h}/{total_h}), Bot {rate_b:.3f} ({converted_b}/{total_b})")

# Stage durations: we need timestamps per stage; not available.
# We'll output basic stats for each responder_type
print("\n--- Average response times ---")
print(f"Human: avg response minutes {human['resp_minutes'].mean():.2f}")
print(f"Bot: avg response minutes {bot['resp_minutes'].mean():.2f}")
print(f"Human: avg time to first close {human['close_minutes'].mean():.2f}")
print(f"Bot: avg time to first close {bot['close_minutes'].mean():.2f}")

# Analyze by intent and topic
print("\n--- Intent distribution ---")
for intent_val in df['intent'].dropna().unique():
    subset = df[df['intent'] == intent_val]
    human_sub = subset[subset['responder_type'] == 'human_first']
    bot_sub = subset[subset['responder_type'] == 'bot_first']
    print(f"Intent {intent_val}: Human {len(human_sub)} ({len(human_sub)/len(subset):.3f}), Bot {len(bot_sub)} ({len(bot_sub)/len(subset):.3f})")
    # conversion rate to demo_booked per intent
    for stage in ['demo_booked', 'trial_activated']:
        hr = len(human_sub[human_sub['stage_group'] == stage]) / len(human_sub) if len(human_sub) > 0 else 0
        br = len(bot_sub[bot_sub['stage_group'] == stage]) / len(bot_sub) if len(bot_sub) > 0 else 0
        print(f"  Stage {stage}: Human {hr:.3f}, Bot {br:.3f}")

print("\n--- Topic distribution ---")
for topic_val in df['topic'].dropna().unique():
    subset = df[df['topic'] == topic_val]
    human_sub = subset[subset['responder_type'] == 'human_first']
    bot_sub = subset[subset['responder_type'] == 'bot_first']
    print(f"Topic {topic_val}: Human {len(human_sub)} ({len(human_sub)/len(subset):.3f}), Bot {len(bot_sub)} ({len(bot_sub)/len(subset):.3f})")

conn.close()
''')
