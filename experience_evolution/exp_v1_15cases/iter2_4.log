import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('./dacomp-069.sqlite')

# 1. Regional retention rates bar chart
df_region = pd.read_sql_query("""
    SELECT region, 
           AVG(day_1_retention_rate) as d1,
           AVG(day_7_retention_rate) as d7,
           AVG(day_30_retention_rate) as d30
    FROM google_play__geo_market_analysis 
    WHERE package_name='com.dev.photoeditor'
    GROUP BY region
""", conn)
df_region.set_index('region', inplace=True)
ax = df_region.plot(kind='bar', figsize=(10,6))
plt.title('Average Retention Rates by Region (com.dev.photoeditor)')
plt.xlabel('Region')
plt.ylabel('Retention Rate')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('retention_by_region.png')
plt.close()

# 2. Regional churn rates
df_churn = pd.read_sql_query("""
    SELECT region, AVG(daily_churn_rate) as avg_churn
    FROM google_play__geo_market_analysis 
    WHERE package_name='com.dev.photoeditor'
    GROUP BY region
    ORDER BY avg_churn DESC
""", conn)
plt.figure(figsize=(8,5))
plt.bar(df_churn['region'], df_churn['avg_churn'])
plt.title('Average Daily Churn Rate by Region')
plt.xlabel('Region')
plt.ylabel('Churn Rate')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('churn_by_region.png')
plt.close()

# 3. Divergence: daily net revenue over time for high ARPU vs low ARPU markets
# Define high ARPU: >7, low ARPU: <=7 (only ID)
high_markets = pd.read_sql_query("""
    SELECT country FROM google_play__geo_market_analysis 
    WHERE package_name='com.dev.photoeditor' AND average_revenue_per_user > 7
""", conn)['country'].tolist()
low_markets = pd.read_sql_query("""
    SELECT country FROM google_play__geo_market_analysis 
    WHERE package_name='com.dev.photoeditor' AND average_revenue_per_user <= 7
""", conn)['country'].tolist()

# Get finance data aggregated by date and country
df_fin = pd.read_sql_query("""
    SELECT date_day, country_long, net_amount
    FROM google_play__finance_report 
    WHERE package_name='com.dev.photoeditor'
""", conn)
df_fin['date_day'] = pd.to_datetime(df_fin['date_day'])

# Group by date and sum net_amount for high and low markets
high_mask = df_fin['country_long'].isin(high_markets)
low_mask = df_fin['country_long'].isin(low_markets)

high_rev = df_fin[high_mask].groupby('date_day')['net_amount'].sum()
low_rev = df_fin[low_mask].groupby('date_day')['net_amount'].sum()

plt.figure(figsize=(12, 6))
plt.plot(high_rev.index, high_rev.values, label=f'High ARPU Markets (>$7, n={len(high_markets)})', linewidth=2)
plt.plot(low_rev.index, low_rev.values, label=f'Low ARPU Markets (<=$7, n={len(low_markets)})', linewidth=2)
plt.title('Daily Net Revenue Divergence: High vs Low ARPU Markets')
plt.xlabel('Date')
plt.ylabel('Net Revenue ($)')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig('revenue_divergence_high_low.png')
plt.close()

# 4. Market performance score vs ARPU with region coloring (already done, but we can add thresholds)
df_market = pd.read_sql_query("""
    SELECT country, region, average_revenue_per_user, overall_market_score
    FROM google_play__geo_market_analysis 
    WHERE package_name='com.dev.photoeditor'
""", conn)
fig, ax = plt.subplots(figsize=(10,6))
for region in df_market['region'].unique():
    subset = df_market[df_market['region']==region]
    ax.scatter(subset['average_revenue_per_user'], subset['overall_market_score'], label=region, s=100)
ax.axvline(x=7, color='gray', linestyle='--', label='$7 ARPU Threshold')
ax.axvline(x=3, color='lightgray', linestyle='--', label='$3 ARPU Threshold')
ax.set_xlabel('Average Revenue Per User ($)')
ax.set_ylabel('Overall Market Score')
ax.set_title('Market Performance vs ARPU (with CFO thresholds)')
ax.legend()
ax.grid(True)
fig.tight_layout()
fig.savefig('performance_vs_arpu_thresholds.png')
plt.close()

conn.close()
print("Additional plots generated.")
```

