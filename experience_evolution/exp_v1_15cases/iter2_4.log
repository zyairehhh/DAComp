'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo_market_analysis
query = """
SELECT region, country,
       avg_active_devices,
       revenue_last_30_days,
       overall_market_score,
       app_quality_score,
       store_performance_score,
       avg_transaction_value,
       average_revenue_per_user
FROM google_play__geo_market_analysis
WHERE package_name = 'com.dev.photoeditor'
"""
df = pd.read_sql_query(query, conn)

# Total revenue and active devices across all markets
total_revenue = df['revenue_last_30_days'].sum()
total_devices = df['avg_active_devices'].sum()

print(f"Total revenue last 30 days: ${total_revenue:,.2f}")
print(f"Total active devices: {total_devices:,.0f}")

# Contribution per region
region_sum = df.groupby('region').agg(
    revenue=('revenue_last_30_days', 'sum'),
    devices=('avg_active_devices', 'sum'),
    avg_market_score=('overall_market_score', 'mean'),
    avg_app_quality=('app_quality_score', 'mean'),
    avg_store_perf=('store_performance_score', 'mean'),
    count=('country', 'count')
).reset_index()

region_sum['revenue_share'] = region_sum['revenue'] / total_revenue
region_sum['device_share'] = region_sum['devices'] / total_devices

print("\nRegion contributions:")
print(region_sum.round(3))

# Identify underperforming regions (market score below overall average)
overall_avg_score = df['overall_market_score'].mean()
print(f"\nOverall average market score: {overall_avg_score:.2f}")

underperforming = region_sum[region_sum['avg_market_score'] < overall_avg_score]
print("\nUnderperforming regions (below average market score):")
print(underperforming[['region', 'avg_market_score', 'revenue_share', 'device_share']])

# Compare high revenue vs low revenue markets using avg_transaction_value >7 vs <=7
high = df[df['avg_transaction_value'] > 7]
low = df[df['avg_transaction_value'] <= 7]

print(f"\nHigh revenue markets (avg_transaction_value > $7): {len(high)} countries")
print(f"Low revenue markets (avg_transaction_value <= $7): {len(low)} countries")
print("High markets average overall_market_score:", high['overall_market_score'].mean())
print("Low markets average overall_market_score:", low['overall_market_score'].mean())
print("High markets average app_quality_score:", high['app_quality_score'].mean())
print("Low markets average app_quality_score:", low['app_quality_score'].mean())

# Correlation between revenue metrics and performance scores
corr = df[['avg_transaction_value', 'average_revenue_per_user', 'overall_market_score', 'app_quality_score', 'store_performance_score']].corr()
print("\nCorrelation matrix:")
print(corr.round(3))

# Check if research budget increased while performance declined
query_trend = """
SELECT date_day, overall_performance_score, research_budget_usd
FROM google_play__comprehensive_performance_dashboard
WHERE package_name = 'com.dev.photoeditor'
ORDER BY date_day
"""
df_trend = pd.read_sql_query(query_trend, conn)
print("\nMonthly performance and budget:")
print(df_trend.to_string(index=False))

# Compute cumulative research budget
df_trend['cumulative_budget'] = df_trend['research_budget_usd'].cumsum()
print("\nCumulative research budget:")
print(df_trend[['date_day', 'cumulative_budget', 'overall_performance_score']])

conn.close()
''')
