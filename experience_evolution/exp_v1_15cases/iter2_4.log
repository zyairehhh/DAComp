# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Time series decay analysis
query1 = "SELECT date_day, daily_installs, daily_uninstalls, daily_revenue, revenue_per_active_device FROM google_play__time_series_trends ORDER BY date_day"
df1 = pd.read_sql_query(query1, conn)
df1['date_day'] = pd.to_datetime(df1['date_day'])

# Filter for last 6 months
if len(df1) > 0:
    max_date = df1['date_day'].max()
    six_months_ago = max_date - timedelta(days=180)
    df1_recent = df1[df1['date_day'] >= six_months_ago]
    
    # Calculate efficiency metrics
    df1_recent['install_to_uninstall_ratio'] = df1_recent['daily_installs'] / (df1_recent['daily_uninstalls'] + 1)
    
    # Plot 1: Acquisition efficiency decay
    fig1, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))
    
    # Install/uninstall trends
    ax1.plot(df1_recent['date_day'], df1_recent['daily_installs'], 'g-', label='Installs', alpha=0.7)
    ax1.plot(df1_recent['date_day'], df1_recent['daily_uninstalls'], 'r-', label='Uninstalls', alpha=0.7)
    ax1.set_title('Daily Installs vs Uninstalls (Last 6 Months)')
    ax1.set_xlabel('Date')
    ax1.set_ylabel('Count')
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    ax1.tick_params(axis='x', rotation=45)
    
    # Efficiency ratio
    ax2.plot(df1_recent['date_day'], df1_recent['install_to_uninstall_ratio'], 'b-', linewidth=2)
    ax2.axhline(y=df1_recent['install_to_uninstall_ratio'].mean(), color='r', linestyle='--', 
                label=f'Mean: {df1_recent["install_to_uninstall_ratio"].mean():.2f}')
    ax2.set_title('Install-to-Uninstall Ratio (Acquisition Efficiency)')
    ax2.set_xlabel('Date')
    ax2.set_ylabel('Ratio')
    ax2.legend()
    ax2.grid(True, alpha=0.3)
    ax2.tick_params(axis='x', rotation=45)
    
    plt.tight_layout()
    plt.savefig('acquisition_efficiency.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created: acquisition_efficiency.png")

# 2. Quality vs Conversion analysis
query2 = """
SELECT 
    t.date_day,
    t.quality_score,
    t.crash_rate_per_1k,
