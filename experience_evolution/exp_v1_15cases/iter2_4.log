import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-070.sqlite')

def run_query(query):
    return pd.read_sql_query(query, conn)

# 1. Non-linear relationship between store_listing_conversion_rate and quality_score, crash_rate_per_1k
print("=== Joining country_report with time_series_trends for quality_score and crash_rate_per_1k ===")
query_join = """
SELECT 
    c.date_day,
    c.region,
    c.package_name,
    c.store_listing_conversion_rate,
    t.quality_score,
    t.crash_rate_per_1k,
    c.store_listing_acquisitions,
    c.store_listing_visitors
FROM google_play__country_report c
JOIN google_play__time_series_trends t 
    ON c.date_day = t.date_day AND c.package_name = t.package_name
LIMIT 10;
"""
df_sample = run_query(query_join)
print(df_sample)

# Check count
query_count = "SELECT COUNT(*) FROM google_play__country_report c JOIN google_play__time_series_trends t ON c.date_day = t.date_day AND c.package_name = t.package_name;"
count = run_query(query_count)
print(f"\nTotal joined rows: {count.iloc[0,0]}")

# Compute correlation matrix
print("\n=== Correlation between conversion_rate, quality_score, crash_rate_per_1k ===")
query_all = """
SELECT 
    c.store_listing_conversion_rate,
    t.quality_score,
    t.crash_rate_per_1k
FROM google_play__country_report c
JOIN google_play__time_series_trends t 
    ON c.date_day = t.date_day AND c.package_name = t.package_name
WHERE t.quality_score IS NOT NULL AND t.crash_rate_per_1k IS NOT NULL;
"""
df_corr = run_query(query_all)
corr_matrix = df_corr.corr()
print(corr_matrix)

# 2. Multi-dimensional user value decay model
# Define user value as revenue_per_active_device from time_series_trends
# Market maturity possibly defined as total_device_installs from country_report aggregated per region over time.
# Let's compute revenue_per_active_device aggregated per region per month.
print("\n=== Revenue per active device per region over time ===")
query_rev = """
SELECT 
    c.region,
    strftime('%Y-%m', c.date_day) as month,
    AVG(t.revenue_per_active_device) as avg_revenue_per_active_device,
    AVG(c.total_device_installs) as avg_total_device_installs,
    SUM(c.store_listing_acquisitions) as total_acquisitions
FROM google_play__country_report c
JOIN google_play__time_series_trends t 
    ON c.date_day = t.date_day AND c.package_name = t.package_name
GROUP BY c.region, month
ORDER BY c.region, month;
"""
df_rev = run_query(query_rev)
print(df_rev.head(20))

# Compute slope per region
def linear_slope(x, y):
    if len(x) < 2:
        return np.nan, np.nan
    coeffs = np.polyfit(x, y, 1)
    slope = coeffs[0]
    p = np.poly1d(coeffs)
    yhat = p(x)
    ybar = np.sum(y)/len(y)
    ssreg = np.sum((yhat - ybar)**2)
    sstot = np.sum((y - ybar)**2)
    if sstot == 0:
        r_squared = np.nan
    else:
        r_squared = ssreg / sstot
    return slope, r_squared

print("\nRevenue per active device decay per region:")
for region in df_rev['region'].unique():
    subset = df_rev[df_rev['region'] == region].copy()
    subset['month_idx'] = range(len(subset))
    slope, r2 = linear_slope(subset['month_idx'], subset['avg_revenue_per_active_device'])
    print(f"{region}: slope={slope:.4f}, R²={r2:.3f}, start={subset['avg_revenue_per_active_device'].iloc[0]:.2f}, end={subset['avg_revenue_per_active_device'].iloc[-1]:.2f}")

# 3. Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
# Update frequency can be derived from update_events per time period per country/device.
# Let's compute update events per month per region and correlate with active_devices and rating.
print("\n=== Update frequency effect per region ===")
query_update = """
SELECT 
    region,
    strftime('%Y-%m', date_day) as month,
    SUM(update_events) as total_updates,
    AVG(active_devices_last_30_days) as avg_active_devices,
    AVG(rolling_total_average_rating) as avg_rolling_rating
FROM google_play__country_report
GROUP BY region, month
ORDER BY region, month;
"""
df_update = run_query(query_update)
print(df_update.head(20))

# Compute correlation between total_updates and avg_active_devices, avg_rolling_rating per region
for region in df_update['region'].unique():
    subset = df_update[df_update['region'] == region].copy()
    corr_updates_active = subset['total_updates'].corr(subset['avg_active_devices'])
    corr_updates_rating = subset['total_updates'].corr(subset['avg_rolling_rating'])
    print(f"{region}: correlation updates vs active devices = {corr_updates_active:.3f}, updates vs rating = {corr_updates_rating:.3f}")

conn.close()
```
