for patch, color in zip(box['boxes'], colors):
    patch.set_facecolor(color)

ax.set_xlabel('Level 1 Category', fontsize=14)
ax.set_ylabel('Discount Depth (%)', fontsize=14)
ax.set_title('Discount Depth Distribution Across Top 10 Level 1 Categories', fontsize=16)
plt.xticks(rotation=45, ha='right')
ax.grid(True, alpha=0.3, axis='y')

plt.savefig('discount_by_category_boxplot.png', dpi=300, bbox_inches='tight')
