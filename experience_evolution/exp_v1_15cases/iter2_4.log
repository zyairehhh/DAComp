import sqlite3
import pandas as pd

conn = sqlite3.connect("/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter3/dacomp-069/stage1_env/dacomp-069.sqlite")
app = "com.dev.photoeditor"

# Revenue groups using thresholds $7 and $3 (as per prompt)
geo_df = pd.read_sql("""
SELECT country, region, average_revenue_per_user, overall_market_score, app_quality_score, revenue_last_30_days
FROM google_play__geo_market_analysis WHERE package_name = ?
""", conn, params=(app,))

geo_df['revenue_category'] = geo_df['average_revenue_per_user'].apply(lambda x: 'high' if x > 7 else ('mid' if x >= 3 else 'low'))

print("Revenue Category Summary:")
print(geo_df.groupby('revenue_category').agg({
    'country': 'count',
    'average_revenue_per_user': ['mean', 'min', 'max'],
    'overall_market_score': 'mean',
    'app_quality_score': 'mean',
    'revenue_last_30_days': 'sum'
}).round(2))
print("\n")

# Time series of overall_performance_score and research_budget_usd
perf_df = pd.read_sql("""
SELECT date_day, overall_performance_score, research_budget_usd
FROM google_play__comprehensive_performance_dashboard WHERE package_name = ?
ORDER BY date_day
""", conn, params=(app,))
perf_df['date_day'] = pd.to_datetime(perf_df['date_day'])

print("Performance Trend (first 5 rows):")
print(perf_df.head())
print("Performance Trend (last 5 rows):")
print(perf_df.tail())
print("\n")

# Monthly revenue by revenue category (using finance_report)
finance_df = pd.read_sql("""
SELECT country_short, strftime('%Y-%m', date_day) as month, SUM(net_amount) as monthly_revenue
FROM google_play__finance_report WHERE package_name = ?
GROUP BY country_short, month ORDER BY country_short, month
""", conn, params=(app,))

# Merge categories
finance_df = finance_df.merge(geo_df[['country', 'revenue_category']], left_on='country_short', right_on='country', how='inner')
finance_df['month'] = pd.to_datetime(finance_df['month'] + '-01')

# Aggregate by revenue_category and month
category_month = finance_df.groupby(['revenue_category', 'month'])['monthly_revenue'].sum().reset_index()

# Compute growth rates per category
category_month['prev_rev'] = category_month.groupby('revenue_category')['monthly_revenue'].shift(1)
category_month['growth'] = (category_month['monthly_revenue'] - category_month['prev_rev']) / category_month['prev_rev']

print("Revenue Growth by Category (last 5 rows per category):")
for cat in category_month['revenue_category'].unique():
    cat_data = category_month[category_month['revenue_category'] == cat].tail(5)
    print(f"Category {cat}:")
    print(cat_data[['month', 'monthly_revenue', 'growth']].round(2))
    print()

# Compute cumulative research budget
perf_df['cumulative_budget'] = perf_df['research_budget_usd'].cumsum()
print(f"Total research budget invested over the period: ${perf_df['research_budget_usd'].sum():,.2f}")
print(f"Performance drop: {perf_df['overall_performance_score'].iloc[0]} to {perf_df['overall_performance_score'].iloc[-1]}")
print(f"Change: {perf_df['overall_performance_score'].iloc[-1] - perf_df['overall_performance_score'].iloc[0]} points")

conn.close()
```
