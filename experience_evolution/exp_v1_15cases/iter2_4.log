import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# Helper function to run SQL
def run_query(query):
    return pd.read_sql_query(query, conn)

# Linear regression using numpy polyfit degree 1
def linregress(x, y):
    coeffs = np.polyfit(x, y, 1)
    slope = coeffs[0]
    intercept = coeffs[1]
    # compute R-squared
    y_pred = slope * x + intercept
    ss_res = np.sum((y - y_pred) ** 2)
    ss_tot = np.sum((y - np.mean(y)) ** 2)
    r_squared = 1 - (ss_res / ss_tot) if ss_tot != 0 else np.nan
    # compute p-value? skip for simplicity
    return slope, intercept, r_squared

# 1. Region-wise decay of conversion rate over past 6 months
print("=== Region-wise decay of conversion rate ===")
query_region = """
SELECT 
    region,
    strftime('%Y-%m', date_day) as month,
    AVG(store_listing_conversion_rate) as avg_conversion_rate,
    SUM(store_listing_acquisitions) as total_acquisitions,
    SUM(store_listing_visitors) as total_visitors
FROM google_play__country_report
GROUP BY region, strftime('%Y-%m', date_day)
ORDER BY region, month;
"""
df_region = run_query(query_region)
print(df_region.head(20))

# Compute decay slope per region
region_decay = {}
for region in df_region['region'].unique():
    subset = df_region[df_region['region'] == region].copy()
    subset = subset.sort_values('month')
    subset['month_index'] = range(len(subset))
    if len(subset) >= 2:
        x = subset['month_index'].values
        y = subset['avg_conversion_rate'].values
        slope, intercept, r_squared = linregress(x, y)
        region_decay[region] = {'slope': slope, 'r_squared': r_squared, 'start_rate': subset.iloc[0]['avg_conversion_rate'], 'end_rate': subset.iloc[-1]['avg_conversion_rate']}
    else:
        region_decay[region] = {'slope': np.nan, 'r_squared': np.nan, 'start_rate': np.nan, 'end_rate': np.nan}

print("\nRegion decay slopes (negative indicates decline):")
for region, vals in region_decay.items():
    print(f"{region}: slope={vals['slope']:.6f}, R²={vals['r_squared']:.3f}, start={vals['start_rate']:.3f}, end={vals['end_rate']:.3f}")

# 2. Device-wise decay of active devices
print("\n=== Device-wise decay of active devices last 30 days ===")
query_device = """
SELECT 
    device,
    strftime('%Y-%m', date_day) as month,
    AVG(active_devices_last_30_days) as avg_active_devices,
    SUM(device_installs) as total_installs,
    SUM(device_uninstalls) as total_uninstalls
FROM google_play__device_report
GROUP BY device, strftime('%Y-%m', date_day)
ORDER BY device, month;
"""
df_device = run_query(query_device)
print(df_device.head(20))

# Compute decay slope per device
device_decay = {}
for device in df_device['device'].unique():
    subset = df_device[df_device['device'] == device].copy()
    subset = subset.sort_values('month')
    subset['month_index'] = range(len(subset))
    if len(subset) >= 2:
        x = subset['month_index'].values
        y = subset['avg_active_devices'].values
        slope, intercept, r_squared = linregress(x, y)
        device_decay[device] = {'slope': slope, 'r_squared': r_squared, 'start': subset.iloc[0]['avg_active_devices'], 'end': subset.iloc[-1]['avg_active_devices']}
    else:
        device_decay[device] = {'slope': np.nan, 'r_squared': np.nan, 'start': np.nan, 'end': np.nan}

print("\nDevice active devices decay slopes (negative indicates decline):")
for device, vals in device_decay.items():
    print(f"{device}: slope={vals['slope']:.2f}, R²={vals['r_squared']:.3f}, start={vals['start']:.0f}, end={vals['end']:.0f}")

conn.close()
```



