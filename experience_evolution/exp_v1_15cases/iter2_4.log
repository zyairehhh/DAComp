# 5. Multi-dimensional risk rating visualization
print("Creating visualization 5: Risk Rating Model...")
df_risk = pd.read_sql_query("""
    SELECT p.customer_id, p.customer_margin_volatility,
           c.rfm_segment, c.payment_behavior, c.credit_grade,
           c.overall_customer_score, c.risk_assessment,
           p.customer_gross_margin_pct,
           c.revenue_volatility,
           CASE WHEN p.customer_margin_volatility >= 0.252198 THEN 1 ELSE 0 END as high_vol_flag
    FROM quickbooks__profitability_analysis p
    LEFT JOIN quickbooks__customer_analytics c 
    ON p.customer_id = c.customer_id
    WHERE p.customer_margin_volatility IS NOT NULL
    AND c.overall_customer_score IS NOT NULL
    LIMIT 1000  -- Sample for visualization
""", conn)

# Create a simple risk score based on multiple factors
if not df_risk.empty:
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    
    # Risk assessment distribution
    risk_counts = df_risk['risk_assessment'].value_counts()
    axes[0, 0].bar(risk_counts.index, risk_counts.values, color=['red', 'orange', 'yellow', 'green'])
    axes[0, 0].set_xlabel('Risk Assessment')
    axes[0, 0].set_ylabel('Count')
    axes[0, 0].set_title('Customer Risk Assessment Distribution')
    for i, v in enumerate(risk_counts.values):
        axes[0, 0].text(i, v + 5, str(v), ha='center', fontsize=10)
    
    # Scatter: Overall score vs Margin volatility
    scatter4 = axes[0, 1].scatter(df_risk['customer_margin_volatility'], 
                                 df_risk['overall_customer_score'],
                                 c=df_risk['high_vol_flag'], 
                                 cmap='RdYlGn', alpha=0.7, s=50)
    axes[0, 1].set_xlabel('Customer Margin Volatility')
    axes[0, 1].set_ylabel('Overall Customer Score')
    axes[0, 1].set_title('Risk vs Customer Score (Green=Low Vol, Red=High Vol)')
    axes[0, 1].grid(True, alpha=0.3)
    
    # Box plot: Volatility by payment behavior
    payment_groups = []
    payment_labels = []
    for behavior in df_risk['payment_behavior'].unique():
        if behavior and pd.notna(behavior):
            data = df_risk[df_risk['payment_behavior'] == behavior]['customer_margin_volatility']
            if len(data) > 5:  # Only include groups with enough data
                payment_groups.append(data)
                payment_labels.append(behavior)
    
    if payment_groups:
        bp = axes[1, 0].boxplot(payment_groups, labels=payment_labels, patch_artist=True)
        # Color boxes
        colors = ['lightblue', 'lightgreen', 'lightcoral', 'gold']
        for patch, color in zip(bp['boxes'], colors[:len(payment_groups)]):
            patch.set_facecolor(color)
        axes[1, 0].set_xlabel('Payment Behavior')
        axes[1, 0].set_ylabel('Margin Volatility')
        axes[1, 0].set_title('Margin Volatility by Payment Behavior')
        axes[1, 0].tick_params(axis='x', rotation=45)
    
    # Heatmap-style: RFM segment vs Credit Grade for high volatility
    high_vol_df = df_risk[df_risk['high_vol_flag'] == 1]
    if not high_vol_df.empty and 'rfm_segment' in high_vol_df.columns and 'credit_grade' in high_vol_df.columns:
        cross_tab = pd.crosstab(high_vol_df['rfm_segment'], high_vol_df['credit_grade'])
        im = axes[1, 1].imshow(cross_tab.values, cmap='YlOrRd', aspect='auto')
        axes[1, 1].set_xlabel('Credit Grade')
        axes[1, 1].set_ylabel('RFM Segment')
        axes[1, 1].set_title('High Volatility Customers: RFM vs Credit Grade')
        axes[1, 1].set_xticks(range(len(cross_tab.columns)))
        axes[1, 1].set_xticklabels(cross_tab.columns, rotation=45)
        axes[1, 1].set_yticks(range(len(cross_tab.index)))
        axes[1, 1].set_yticklabels(cross_tab.index)
        plt.colorbar(im, ax=axes[1, 1], label='Count')
    else:
        axes[1, 1].text(0.5, 0.5, 'Insufficient data for heatmap', 
                       ha='center', va='center', transform=axes[1, 1].transAxes)
        axes[1, 1].set_title('High Volatility Customers: RFM vs Credit Grade')
    
    plt.tight_layout()
    plt.savefig('risk_rating_model.png', dpi=300, bbox_inches='tight')
    plt.close()

conn.close()
print("All visualizations created successfully!")
