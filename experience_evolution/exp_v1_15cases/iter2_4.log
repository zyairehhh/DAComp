print(f"\nUnique promotion sku_ids: {promotions_df['sku_id_int'].nunique()}")
print(f"Unique category sku_ids: {categories_df['sku_id_int'].nunique()}")

# Check if there's any overlap
promo_ids_set = set(promotions_df['sku_id_int'].dropna().astype(int).unique())
category_ids_set = set(categories_df['sku_id_int'].astype(int).unique())

print(f"\nOverlap size: {len(promo_ids_set.intersection(category_ids_set))}")

