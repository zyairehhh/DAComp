'''
import pandas as pd
import numpy as np

df = pd.read_csv('campaign_health_scores.csv')
# Top 5 high cost, low health
top_problems = df.sort_values(['cost','health_score'], ascending=[False,True]).head(5)

print("Top 5 problematic campaigns:")
print(top_problems[['campaign_id','campaign_name','year_month','cost','roas','health_score','risk_level','campaign_type','bidding_strategy','industry']])

# Compute diagnosis per campaign
# For each, compare to averages
avg_roas = df['roas'].mean()
avg_ctr = df['ctr'].mean()
avg_imp_share = df['impression_share'].mean()
avg_cpc = df['cpc'].mean()
avg_conv_rate = df['conversion_rate'].mean()
avg_quality = df['quality_score'].mean()

diagnoses = []
for idx, row in top_problems.iterrows():
