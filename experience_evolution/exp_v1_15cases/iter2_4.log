Action: LOCAL_DB_SQL(file_path="database.sqlite", command="WITH first_month AS ( SELECT r.region_name, AVG(p.revenue_per_user) as avg_rev_first, AVG(p.sessions_per_user) as avg_sess_first FROM performance p JOIN regions r ON p.region_id = r.region_id WHERE p.app_id = (SELECT app_id FROM apps WHERE app_name = 'com.dev.photoeditor') AND p.date = (SELECT MIN(date) FROM performance WHERE date >= (SELECT DATE(MAX(date), '-12 months') FROM performance)) GROUP BY r.region_id ), last_month AS ( SELECT r.region_name, AVG(p.revenue_per_user) as avg_rev_last, AVG(p.sessions_per_user) as avg_sess_last FROM performance p JOIN regions r ON p.region_id = r.region_id WHERE p.app_id = (SELECT app_id FROM apps WHERE app_name = 'com.dev.photoeditor') AND p.date = (SELECT MAX(date) FROM performance WHERE date >= (SELECT DATE(MAX(date), '-12 months') FROM performance)) GROUP BY r.region_id ), region_avg AS ( SELECT r.region_name, AVG(p.revenue_per_user) as avg_rev FROM performance p JOIN regions r ON p.region_id = r.region_id WHERE p.app_id = (SELECT app_id FROM apps WHERE app_name = 'com.dev.photoeditor') AND p.date >= (SELECT DATE(MAX(date), '-12 months') FROM performance) GROUP BY r.region_id ) SELECT f.region_name, f.avg_rev_first, l.avg_rev_last, (l.avg_rev_last - f.avg_rev_first) as rev_change, f.avg_sess_first, l.avg_sess_last, (l.avg_sess_last - f.avg_sess_first) as sess_change FROM first_month f JOIN last_month l ON f.region_name = l.region_name JOIN region_avg ra ON f.region_name = ra.region_name WHERE ra.avg_rev > 7 OR ra.avg_rev < 3 ORDER BY ra.avg_rev DESC;", output="direct")

