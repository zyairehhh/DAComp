    # Calculate efficiency metrics
    df1_recent['install_to_uninstall_ratio'] = df1_recent['daily_installs'] / (df1_recent['daily_uninstalls'] + 1)
    
    # Plot 1: Acquisition efficiency decay
    fig1, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))
    
