'''
import pandas as pd
import numpy as np

df = pd.read_csv('contacts_with_scores_v2.csv')
# Ensure segment column is the proportional one
df['segment'] = df['value_segment_prop']

# Key behavioral characteristics: cross-channel, completion rate, total surveys, email/sms counts
# Group by segment
seg_stats = df.groupby('segment').agg({
    'total_count_surveys': ['mean','median','std'],
    'total_count_completed_surveys': ['mean','median','std'],
    'completion_rate': ['mean','median','std'],
    'count_surveys_sent_email': 'mean',
    'count_surveys_sent_sms': 'mean',
    'cross_channel': 'mean',
    'avg_survey_progress_pct': 'mean',
    'avg_survey_duration_in_seconds': 'mean',
    'contact_id': 'count'
}).round(2)
print("Segment behavioral characteristics:")
print(seg_stats)

# Compute uplift from medium to high
med = df[df['segment']=='medium_value']
high = df[df['segment']=='high_value']

print("\nMedium vs High - Mean values:")
for col in ['total_count_surveys','total_count_completed_surveys','completion_rate','count_surveys_sent_email','count_surveys_sent_sms','cross_channel','avg_survey_progress_pct']:
    med_val = med[col].mean()
    high_val = high[col].mean()
    uplift = (high_val - med_val) / med_val * 100
    print(f"{col}: Medium {med_val:.2f}, High {high_val:.2f}, Uplift {uplift:.2f}%")

# Calculate Cohen's d (simplified)
def cohens_d(group1, group2, col):
    n1, n2 = len(group1), len(group2)
    var1 = group1[col].var(ddof=1)
    var2 = group2[col].var(ddof=1)
    pooled_std = np.sqrt(((n1-1)*var1 + (n2-1)*var2) / (n1 + n2 - 2))
    d = (group1[col].mean() - group2[col].mean()) / pooled_std
    return d

print("\nCohen's d (Medium - High, negative means high > medium):")
for col in ['total_count_surveys','total_count_completed_surveys','completion_rate','count_surveys_sent_email','count_surveys_sent_sms','cross_channel','avg_survey_progress_pct']:
    d = cohens_d(med, high, col)
    print(f"{col}: {d:.3f}")

# Language analysis: segment distribution per language
print("\n=== Language Analysis ===")
lang_seg = pd.crosstab(df['language'], df['segment'], margins=True, margins_name='Total')
lang_seg_pct = pd.crosstab(df['language'], df['segment'], normalize='index') * 100
print("Counts:")
print(lang_seg)
print("\nPercentages per language:")
print(lang_seg_pct.round(2))

# Directory analysis
print("\n=== Directory (Region) Analysis ===")
dir_seg = pd.crosstab(df['directory_name'], df['segment'], margins=True, margins_name='Total')
dir_seg_pct = pd.crosstab(df['directory_name'], df['segment'], normalize='index') * 100
print("Counts:")
print(dir_seg)
print("\nPercentages per directory:")
print(dir_seg_pct.round(2))

# Identify languages/directories with higher proportion of high_value and power users
print("\nLanguages sorted by % high_value + power_user:")
lang_seg_pct['high_power'] = lang_seg_pct['high_value'] + lang_seg_pct['power_user']
print(lang_seg_pct.sort_values('high_power', ascending=False)[['high_value','power_user','high_power']])

print("\nDirectories sorted by % high_value + power_user:")
dir_seg_pct['high_power'] = dir_seg_pct['high_value'] + dir_seg_pct['power_user']
print(dir_seg_pct.sort_values('high_power', ascending=False)[['high_value','power_user','high_power']])

# Language-specific behavioral differences for medium vs high
print("\nBehavioral differences by language (medium vs high) - cross-channel rate:")
lang_cross = pd.crosstab(df['language'], df['segment'], values=df['cross_channel'], aggfunc='mean')
print(lang_cross.round(3))
print("\nCompletion rate by language and segment:")
lang_completion = pd.crosstab(df['language'], df['segment'], values=df['completion_rate'], aggfunc='mean')
print(lang_completion.round(3))

# Write key findings to file for report
with open('key_findings.txt', 'w') as f:
    f.write("Key Behavioral Characteristics Driving Medium->High Transition:\n")
    f.write("1. Cross-channel activity (using both email and SMS) is the biggest differentiator.\n")
    f.write("2. Higher volume of surveys sent via email and SMS.\n")
    f.write("3. Higher completion rate and survey progress.\n")
    f.write("\nLanguage Differences:\n")
    f.write(lang_seg_pct.round(2).to_string())
    f.write("\n\nDirectory Differences:\n")
    f.write(dir_seg_pct.round(2).to_string())

print("\nAnalysis complete. See key_findings.txt for summary.")
''')
