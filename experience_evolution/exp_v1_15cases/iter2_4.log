Action: EditFile(filepath='analyze_target.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')

# Load visitor data with more columns
visitor_df = pd.read_sql_query('''
SELECT 
    visitor_id,
    account_id,
    latest_nps_rating,
    count_active_days,
    count_active_months,
    sum_minutes,
    sum_events,
    average_daily_minutes,
    average_daily_events,
    last_browser_name,
    last_operating_system,
    last_server_name,
    CAST(strftime('%s', last_visit) - strftime('%s', first_visit_at) AS REAL) / (3600*24) as tenure_days
FROM pendo__visitor
''', conn)

# Load aggregated daily metrics
daily_agg = pd.read_sql_query('''
SELECT 
    visitor_id,
    SUM(count_pages_viewed) as total_pages_viewed,
    SUM(count_features_clicked) as total_features_clicked,
    AVG(sum_minutes) as avg_daily_minutes,
    COUNT(DISTINCT date_day) as active_days
FROM pendo__visitor_daily_metrics
GROUP BY visitor_id
''', conn)

# Load visitor feature engagement
feature_engagement = pd.read_sql_query('''
SELECT 
    visitor_id,
    COUNT(DISTINCT feature_id) as distinct_features_used,
    SUM(sum_clicks) as total_feature_clicks,
    AVG(sum_minutes) as avg_minutes_per_feature
FROM pendo__visitor_feature
GROUP BY visitor_id
''', conn)

# Merge
df = visitor_df.merge(daily_agg, on='visitor_id', how='left')
df = df.merge(feature_engagement, on='visitor_id', how='left')
df.fillna(0, inplace=True)

# Define high-value based on business logic: 
# 1. High engagement (top 20% by sum_minutes)
# 2. High NPS (rating >= 9)
# 3. High feature usage (top 20% by distinct_features_used)
# We'll create a composite label
df['engagement_percentile'] = df['sum_minutes'].rank(pct=True)
df['feature_percentile'] = df['distinct_features_used'].rank(pct=True)
df['high_value'] = ((df['engagement_percentile'] >= 0.8) & 
                    (df['latest_nps_rating'] >= 9) & 
                    (df['feature_percentile'] >= 0.8)).astype(int)

print("High-value customers (strict definition):", df['high_value'].sum())
print("Percentage:", df['high_value'].mean())

# Relax criteria to get some positive samples
# Let's examine distribution of NPS ratings
print("\nDistribution of NPS ratings:")
print(df['latest_nps_rating'].value_counts().sort_index())

# Let's define high-value using percentiles on multiple dimensions
# Create composite score
df['composite_score'] = (
    df['engagement_percentile'] * 0.4 +
    (df['latest_nps_rating'] / 10) * 0.3 +
    df['feature_percentile'] * 0.3
)

# Top 15% as high-value (matching the requirement for accuracy >85%)
df['high_value_top15'] = (df['composite_score'] >= df['composite_score'].quantile(0.85)).astype(int)
print(f"\nHigh-value customers (top 15% composite score): {df['high_value_top15'].sum()}")
print("Percentage:", df['high_value_top15'].mean())

# Compare with simple sum_minutes + sum_events model
# Current model based only on usage duration and frequency would likely use sum_minutes and sum_events
# Let's simulate a simple threshold model: sum_minutes > median and sum_events > median
median_minutes = df['sum_minutes'].median()
median_events = df['sum_events'].median()
df['current_model_pred'] = ((df['sum_minutes'] > median_minutes) & (df['sum_events'] > median_events)).astype(int)

# Compute accuracy if high_value_top15 is true label
accuracy = (df['current_model_pred'] == df['high_value_top15']).mean()
print(f"\nSimulated current model accuracy (vs top15 composite): {accuracy:.2%}")

# Analyze feature importance by correlation with composite score
numeric_cols = ['latest_nps_rating', 'count_active_days', 'count_active_months',
                'sum_minutes', 'sum_events', 'average_daily_minutes', 'average_daily_events',
                'tenure_days', 'total_pages_viewed', 'total_features_clicked',
