import sqlite3
import pandas as pd

conn = sqlite3.connect("dacomp-035.sqlite")

# Get total users per department
total_users_q = "SELECT Department, COUNT(*) as total_users FROM user_information_table GROUP BY Department;"
total_users_df = pd.read_sql(total_users_q, conn)

# Join tables for active users and logins
query = """
SELECT 
    ui.Department,
    ui."User ID",
    lr."Login Record ID",
    a."Anomaly ID",
    a."Anomaly Type",
    a."Risk Level",
    a."Anomaly Score",
    a."Confirmation Status"
FROM user_information_table ui
LEFT JOIN login_records_table lr ON ui."User ID" = lr."User ID"
LEFT JOIN abnormal_logins_table a ON lr."Login Record ID" = a."Login Record ID"
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Compute per department
departments = total_users_df['Department'].tolist()
results = []
for dept in departments:
    sub = df[df['Department'] == dept]
    total_users = total_users_df[total_users_df['Department']==dept]['total_users'].iloc[0]
    active_users = sub['User ID'].notna().sum()  # Actually count distinct users with at least one login
    active_user_ids = sub['User ID'].dropna().unique()
    active_users_count = len(active_user_ids)
    total_logins = sub['Login Record ID'].notna().sum()
    abnormal = sub[sub['Anomaly ID'].notna()].copy()
    abnormal_count = abnormal.shape[0]
    abnormal_rate = abnormal_count / total_logins if total_logins>0 else 0
    avg_abnormal_per_user = abnormal_count / total_users  # include inactive users?
    avg_abnormal_per_active_user = abnormal_count / active_users_count if active_users_count>0 else 0
    # severity mapping
    risk_map = {'Low':1, 'Medium':2, 'High':3, 'Severe':4}
    abnormal['severity_num'] = abnormal['Risk Level'].map(risk_map)
    avg_severity = abnormal['severity_num'].mean() if not abnormal['severity_num'].isnull().all() else 0
    # anomaly types
    type_counts = abnormal['Anomaly Type'].value_counts().to_dict()
    results.append({
        'Department': dept,
        'Total Users': total_users,
        'Active Users': active_users_count,
        'Active Ratio': active_users_count / total_users,
        'Total Logins': total_logins,
        'Abnormal Logins': abnormal_count,
        'Abnormal Rate': abnormal_rate,
        'Abnormal per Total User': avg_abnormal_per_user,
        'Abnormal per Active User': avg_abnormal_per_active_user,
        'Avg Severity': avg_severity,
        'Multiple IPs': type_counts.get('Multiple IPs in short time', 0),
        'Device anomaly': type_counts.get('Device anomaly', 0),
        'Frequent login': type_counts.get('Frequent login', 0),
        'Remote Login': type_counts.get('Remote Login', 0),
    })

result_df = pd.DataFrame(results)
pd.set_option('display.max_columns', None)
pd.set_option('display.width', None)
print(result_df)
print("\n--- Rankings (Higher is worse) ---")
metrics = ['Abnormal Rate', 'Abnormal per Total User', 'Abnormal per Active User', 'Avg Severity', 'Remote Login', 'Multiple IPs']
for m in metrics:
    if m in result_df.columns:
        worst_dept = result_df.loc[result_df[m].idxmax()]
        print(f"Highest {m}: {worst_dept['Department']} ({worst_dept[m]:.3f})")
```
