conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Get distinct customers with their average customer_margin_volatility
query = """
SELECT customer_id,
       AVG(customer_margin_volatility) as avg_margin_volatility,
       COUNT(*) as invoice_count
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql(query, conn)
