'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from datetime import datetime, timedelta

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# ============================================================================
# 1. Acquisition Efficiency Decay Patterns
# ============================================================================

print("Creating acquisition efficiency decay visualization...")

# Get time series data for past 6 months
max_date_query = "SELECT MAX(date_day) FROM google_play__time_series_trends"
max_date = pd.read_sql_query(max_date_query, conn).iloc[0, 0]
six_months_ago = (pd.to_datetime(max_date) - timedelta(days=180)).strftime('%Y-%m-%d')

query_ts = f"""
SELECT 
    date_day,
    daily_installs,
    daily_uninstalls,
    daily_churn_rate,
    active_devices,
    daily_revenue,
    revenue_per_active_device
FROM google_play__time_series_trends 
WHERE date_day >= '{six_months_ago}'
ORDER BY date_day
"""

ts_data = pd.read_sql_query(query_ts, conn)
ts_data['date_day'] = pd.to_datetime(ts_data['date_day'])
ts_data['install_to_uninstall_ratio'] = ts_data['daily_installs'] / (ts_data['daily_uninstalls'] + 1)
ts_data['retention_rate'] = 1 - ts_data['daily_churn_rate']

# Create the first plot
fig1, axes1 = plt.subplots(2, 2, figsize=(14, 10))
fig1.suptitle('User Acquisition Efficiency Decay Patterns (Past 6 Months)', fontsize=16, fontweight='bold')

# Plot 1.1: Daily installs vs uninstalls
ax1 = axes1[0, 0]
ax1.plot(ts_data['date_day'], ts_data['daily_installs'], label='Daily Installs', color='green', alpha=0.7)
ax1.plot(ts_data['date_day'], ts_data['daily_uninstalls'], label='Daily Uninstalls', color='red', alpha=0.7)
ax1.set_title('Install vs Uninstall Trends')
ax1.set_xlabel('Date')
ax1.set_ylabel('Count')
ax1.legend()
ax1.tick_params(axis='x', rotation=45)

# Plot 1.2: Install-to-uninstall ratio
ax2 = axes1[0, 1]
ax2.plot(ts_data['date_day'], ts_data['install_to_uninstall_ratio'], color='purple', linewidth=2)
mean_ratio = ts_data['install_to_uninstall_ratio'].mean()
ax2.axhline(y=mean_ratio, color='r', linestyle='--', alpha=0.5, label=f'Mean: {mean_ratio:.2f}')
ax2.set_title('Install-to-Uninstall Ratio (Acquisition Efficiency)')
ax2.set_xlabel('Date')
ax2.set_ylabel('Ratio')
ax2.legend()
ax2.tick_params(axis='x', rotation=45)

# Plot 1.3: Retention rate
ax3 = axes1[1, 0]
ax3.plot(ts_data['date_day'], ts_data['retention_rate'], color='blue', linewidth=2)
mean_retention = ts_data['retention_rate'].mean()
ax3.axhline(y=mean_retention, color='r', linestyle='--', alpha=0.5, label=f'Mean: {mean_retention:.2f}')
ax3.set_title('Daily Retention Rate Trend')
ax3.set_xlabel('Date')
ax3.set_ylabel('Retention Rate')
ax3.legend()
ax3.tick_params(axis='x', rotation=45)

# Plot 1.4: Revenue per active device
ax4 = axes1[1, 1]
ax4.plot(ts_data['date_day'], ts_data['revenue_per_active_device'], color='orange', linewidth=2)
mean_revenue = ts_data['revenue_per_active_device'].mean()
ax4.axhline(y=mean_revenue, color='r', linestyle='--', alpha=0.5, label=f'Mean: ${mean_revenue:.2f}')
ax4.set_title('Revenue per Active Device (User Value Metric)')
ax4.set_xlabel('Date')
ax4.set_ylabel('Revenue per Device ($)')
ax4.legend()
ax4.tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('acquisition_efficiency_decay.png', dpi=300, bbox_inches='tight')
plt.close()

# ============================================================================
# 2. Non-linear Relationships Analysis
# ============================================================================

print("Creating non-linear relationships visualization...")

# Get aggregated data for quality metrics
query_quality = """
SELECT 
    t.date_day,
    t.quality_score,
    t.crash_rate_per_1k,
    AVG(cr.store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__time_series_trends t
LEFT JOIN google_play__country_report cr ON t.date_day = cr.date_day
WHERE t.quality_score > 0 AND t.crash_rate_per_1k > 0 
    AND cr.store_listing_conversion_rate > 0
GROUP BY t.date_day, t.quality_score, t.crash_rate_per_1k
ORDER BY t.date_day
"""

quality_data = pd.read_sql_query(query_quality, conn)
quality_data['date_day'] = pd.to_datetime(quality_data['date_day'])

# Get country-level rating data
query_rating = """
SELECT 
    date_day,
    region,
    store_listing_conversion_rate,
    rolling_total_average_rating,
    active_devices_last_30_days
FROM google_play__country_report
WHERE store_listing_conversion_rate > 0 AND rolling_total_average_rating > 0
ORDER BY date_day
"""

rating_data = pd.read_sql_query(query_rating, conn)
rating_data['date_day'] = pd.to_datetime(rating_data['date_day'])

fig2, axes2 = plt.subplots(2, 2, figsize=(14, 10))
fig2.suptitle('Non-linear Relationships: Key Metric Correlations', fontsize=16, fontweight='bold')

# Plot 2.1: Quality vs Conversion (moving averages)
ax1 = axes2[0, 0]
if len(quality_data) > 7:
    quality_data['conversion_ma'] = quality_data['avg_conversion_rate'].rolling(window=7).mean()
    quality_data['quality_ma'] = quality_data['quality_score'].rolling(window=7).mean()
    
    plot_data = quality_data.dropna(subset=['conversion_ma', 'quality_ma'])
    
    line1 = ax1.plot(plot_data['date_day'], plot_data['conversion_ma'], label='Conv Rate (7d MA)', color='blue')
    ax1.set_xlabel('Date')
    ax1.set_ylabel('Conversion Rate', color='blue')
    ax1.tick_params(axis='y', labelcolor='blue')
    ax1.tick_params(axis='x', rotation=45)
    
    ax1b = ax1.twinx()
    line2 = ax1b.plot(plot_data['date_day'], plot_data['quality_ma'], label='Quality Score (7d MA)', color='green')
    ax1b.set_ylabel('Quality Score', color='green')
    ax1b.tick_params(axis='y', labelcolor='green')
    
    lines = line1 + line2
    labels = [l.get_label() for l in lines]
    ax1.legend(lines, labels, loc='upper left')
else:
    ax1.text(0.5, 0.5, 'Insufficient data\nfor correlation analysis', 
             ha='center', va='center', transform=ax1.transAxes, fontsize=12)
ax1.set_title('Conversion Rate vs Quality Score Correlation Over Time')

# Plot 2.2: Rating vs Conversion scatter
ax2 = axes2[0, 1]
if len(rating_data) > 10:
    sample_data = rating_data.sample(min(300, len(rating_data)), random_state=42)
    
    scatter = ax2.scatter(sample_data['store_listing_conversion_rate'], 
                         sample_data['rolling_total_average_rating'],
                         c=sample_data['active_devices_last_30_days'],
                         cmap='plasma', alpha=0.6, s=50)
    ax2.set_title('Conversion Rate vs Average Rating')
    ax2.set_xlabel('Store Listing Conversion Rate')
    ax2.set_ylabel('Rolling Total Average Rating')
    cbar = plt.colorbar(scatter, ax=ax2)
    cbar.set_label('Active Devices (30 days)')
    
    # Add polynomial trend
    if len(sample_data) > 3:
        x = sample_data['store_listing_conversion_rate']
        y = sample_data['rolling_total_average_rating']
        z = np.polyfit(x, y, 2)
        p = np.poly1d(z)
        x_sorted = np.sort(x)
        ax2.plot(x_sorted, p(x_sorted), "r--", alpha=0.8, label='Quadratic Trend')
        ax2.legend()
else:
    ax2.text(0.5, 0.5, 'Insufficient data\nfor scatter analysis', 
             ha='center', va='center', transform=ax2.transAxes, fontsize=12)
    ax2.set_title('Conversion Rate vs Average Rating')

# Plot 2.3: Crash Rate vs Conversion
ax3 = axes2[1, 0]
if len(quality_data) > 7:
    quality_data['crash_ma'] = quality_data['crash_rate_per_1k'].rolling(window=7).mean()
    quality_data['conversion_ma'] = quality_data['avg_conversion_rate'].rolling(window=7).mean()
    
    plot_data = quality_data.dropna(subset=['conversion_ma', 'crash_ma'])
    
    line1 = ax3.plot(plot_data['date_day'], plot_data['conversion_ma'], label='Conv Rate (7d MA)', color='blue')
    ax3.set_xlabel('Date')
    ax3.set_ylabel('Conversion Rate', color='blue')
    ax3.tick_params(axis='y', labelcolor='blue')
    ax3.tick_params(axis='x', rotation=45)
    
    ax3b = ax3.twinx()
    line2 = ax3b.plot(plot_data['date_day'], plot_data['crash_ma'], label='Crash Rate (7d MA)', color='red')
    ax3b.set_ylabel('Crash Rate per 1k', color='red')
    ax3b.tick_params(axis='y', labelcolor='red')
    
    lines = line1 + line2
    labels = [l.get_label() for l in lines]
    ax3.legend(lines, labels, loc='upper left')
else:
    ax3.text(0.5, 0.5, 'Insufficient data\nfor crash rate analysis', 
             ha='center', va='center', transform=ax3.transAxes, fontsize=12)
ax3.set_title('Conversion Rate vs Crash Rate Correlation')

# Plot 2.4: Conversion rate distribution by quality quartiles
ax4 = axes2[1, 1]
if len(quality_data) > 10:
    quality_data['quality_quartile'] = pd.qcut(quality_data['quality_score'], 3, labels=['Low', 'Medium', 'High'])
    box_data = [quality_data[quality_data['quality_quartile'] == q]['avg_conversion_rate'].dropna() 
                for q in ['Low', 'Medium', 'High']]
    
    bp = ax4.boxplot(box_data, labels=['Low Quality', 'Medium Quality', 'High Quality'])
    ax4.set_title('Conversion Rate Distribution by Quality Tiers')
    ax4.set_xlabel('Quality Tier')
    ax4.set_ylabel('Conversion Rate')
    ax4.grid(True, alpha=0.3)
else:
    ax4.scatter(quality_data['quality_score'], quality_data['avg_conversion_rate'], alpha=0.7)
    ax4.set_title('Quality Score vs Conversion Rate')
    ax4.set_xlabel('Quality Score')
    ax4.set_ylabel('Conversion Rate')

plt.tight_layout()
plt.savefig('nonlinear_relationships.png', dpi=300, bbox_inches='tight')
plt.close()

# ============================================================================
# 3. Multi-dimensional Decay Model
# ============================================================================

print("Creating multi-dimensional decay analysis...")

# Get region-device data
query_multi = """
SELECT 
    cr.date_day,
    cr.region,
    cr.store_listing_conversion_rate,
    cr.active_devices_last_30_days,
    cr.rolling_total_average_rating
FROM google_play__country_report cr
WHERE cr.date_day >= '2024-07-01'
ORDER BY cr.date_day
LIMIT 1000
"""

multi_data = pd.read_sql_query(query_multi, conn)
multi_data['date_day'] = pd.to_datetime(multi_data['date_day'])

if len(multi_data) > 0:
    fig3, axes3 = plt.subplots(2, 2, figsize=(14, 10))
    fig3.suptitle('Multi-dimensional User Value Decay Analysis', fontsize=16, fontweight='bold')
    
    # Plot 3.1: Conversion rate heatmap by region over time
    ax1 = axes3[0, 0]
    
    # Aggregate by month for cleaner visualization
    multi_data['year_month'] = multi_data['date_day'].dt.to_period('M').astype(str)
    heatmap_data = multi_data.pivot_table(
        values='store_listing_conversion_rate',
        index='region',
        columns='year_month',
        aggfunc='mean'
    )
    
    if heatmap_data.size > 0:
        sns.heatmap(heatmap_data, annot=True, fmt='.3f', cmap='YlOrRd', ax=ax1, 
                   cbar_kws={'label': 'Conversion Rate'})
        ax1.set_title('Conversion Rate by Region (Monthly)')
        ax1.set_xlabel('Month')
        ax1.set_ylabel('Region')
        ax1.tick_params(axis='x', rotation=45)
    else:
        ax1.text(0.5, 0.5, 'Insufficient data\nfor heatmap', 
                ha='center', va='center', transform=ax1.transAxes, fontsize=12)
        ax1.set_title('Conversion Rate by Region')
    
    # Plot 3.2: Decay patterns by region
    ax2 = axes3[0, 1]
    if len(multi_data) > 0:
        monthly_data = multi_data.groupby(['region', 'year_month'])['store_listing_conversion_rate'].mean().reset_index()
        
        for region in monthly_data['region'].unique()[:4]:  # Limit to top 4 regions
            region_data = monthly_data[monthly_data['region'] == region]
            ax2.plot(region_data['year_month'], region_data['store_listing_conversion_rate'], 
                    marker='o', markersize=6, label=region, linewidth=2)
        
        ax2.set_title('Monthly Conversion Rate Decay by Region')
        ax2.set_xlabel('Month')
        ax2.set_ylabel('Avg Conversion Rate')
        ax2.legend()
        ax2.tick_params(axis='x', rotation=45)
    else:
        ax2.text(0.5, 0.5, 'Insufficient data\nfor decay analysis', 
                ha='center', va='center', transform=ax2.transAxes, fontsize=12)
        ax2.set_title('Regional Decay Patterns')
    
    # Plot 3.3: Active devices vs rating scatter
    ax3 = axes3[1, 0]
    if len(multi_data) > 10:
        scatter = ax3.scatter(
            multi_data['active_devices_last_30_days'],
            multi_data['rolling_total_average_rating'],
            c=multi_data['store_listing_conversion_rate'],
            cmap='coolwarm',
            alpha=0.7,
            s=50
        )
        ax3.set_title('Active Devices vs Average Rating\n(Colored by Conversion Rate)')
        ax3.set_xlabel('Active Devices (30 days)')
        ax3.set_ylabel('Average Rating')
        cbar = plt.colorbar(scatter, ax=ax3)
        cbar.set_label('Conversion Rate')
        
        # Add regression line
        x = multi_data['active_devices_last_30_days']
        y = multi_data['rolling_total_average_rating']
        if len(x) > 2:
            z = np.polyfit(x, y, 1)
            p = np.poly1d(z)
            x_range = np.linspace(x.min(), x.max(), 100)
            ax3.plot(x_range, p(x_range), 'k--', alpha=0.5, label='Linear Trend')
            ax3.legend()
    else:
        ax3.text(0.5, 0.5, 'Insufficient data\nfor scatter analysis', 
                ha='center', va='center', transform=ax3.transAxes, fontsize=12)
        ax3.set_title('Active Devices vs Rating')
    
    # Plot 3.4: Composite metric: Quality-Adjusted User Value
    ax4 = axes3[1, 1]
    if len(multi_data) > 0:
        # Create a simple composite metric
        multi_data['user_value_score'] = (
            multi_data['store_listing_conversion_rate'] * 
            multi_data['rolling_total_average_rating'] * 
            np.log1p(multi_data['active_devices_last_30_days'])
        )
        
        # Group by region for boxplot
        box_data = []
        labels = []
        for region in multi_data['region'].unique()[:4]:  # Top 4 regions
            region_val = multi_data[multi_data['region'] == region]['user_value_score']
            if len(region_val) > 0:
                box_data.append(region_val)
                labels.append(region)
        
        if len(box_data) > 0:
            bp = ax4.boxplot(box_data, labels=labels, patch_artist=True)
            # Color the boxes
            colors = ['lightblue', 'lightgreen', 'lightcoral', 'lightsalmon']
            for patch, color in zip(bp['boxes'], colors):
                patch.set_facecolor(color)
            
            ax4.set_title('User Value Score Distribution by Region')
            ax4.set_xlabel('Region')
            ax4.set_ylabel('User Value Score')
            ax4.grid(True, alpha=0.3)
            ax4.tick_params(axis='x', rotation=45)
        else:
            ax4.text(0.5, 0.5, 'Insufficient data\nfor composite metric', 
                    ha='center', va='center', transform=ax4.transAxes, fontsize=12)
            ax4.set_title('User Value Score by Region')
    else:
        ax4.text(0.5, 0.5, 'Insufficient data\nfor composite analysis', 
                ha='center', va='center', transform=ax4.transAxes, fontsize=12)
        ax4.set_title('Composite User Value Analysis')
    
    plt.tight_layout()
    plt.savefig('multidimensional_decay_analysis.png', dpi=300, bbox_inches='tight')
    plt.close()

