import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-080.sqlite')

# Read contact data
query = """
SELECT 
    contact_id,
    total_count_surveys,
    total_count_completed_surveys,
    count_surveys_sent_email,
    count_surveys_sent_sms,
    language,
    directory_name
FROM qualtrics__contact
"""
df = pd.read_sql_query(query, conn)
conn.close()

print(f"Total contacts: {len(df)}")

# Compute scores as per Stage1 formula
# 1. Frequency score: min-max scaling to 0-100
min_surveys = df['total_count_surveys'].min()
max_surveys = df['total_count_surveys'].max()
df['freq_score'] = ((df['total_count_surveys'] - min_surveys) / (max_surveys - min_surveys)) * 100

# 2. Completion score: completion rate * 100
df['completion_rate'] = df['total_count_completed_surveys'] / df['total_count_surveys']
df['completion_score'] = df['completion_rate'] * 100
df.loc[df['total_count_surveys'] == 0, 'completion_score'] = 0

# 3. Cross-channel score: binary 0 or 100
df['cross_channel'] = ((df['count_surveys_sent_email'] > 0) & (df['count_surveys_sent_sms'] > 0)).astype(int)
df['cross_channel_score'] = df['cross_channel'] * 100

# 4. Composite score
df['composite_score'] = 0.4 * df['freq_score'] + 0.4 * df['completion_score'] + 0.2 * df['cross_channel_score']

# Segment assignments based on thresholds from Stage1
def assign_segment(score):
    if score >= 61.8:
        return 'Power User'
    elif score >= 47.1:
        return 'High-Value'
    elif score >= 24.0:
        return 'Medium-Value'
    else:
        return 'Low-Value'

df['segment'] = df['composite_score'].apply(assign_segment)

