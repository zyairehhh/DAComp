risk_df['rfm_risk_norm'] = min_max_scale(risk_df['rfm_risk_score'])
risk_df['payment_risk_norm'] = min_max_scale(risk_df['payment_risk_score'])
risk_df['trend_risk_norm'] = min_max_scale(risk_df['trend_risk_score'])
risk_df['lifecycle_risk_norm'] = min_max_scale(risk_df['lifecycle_risk_score'])
risk_df['outstanding_ratio_norm'] = min_max_scale(risk_df['outstanding_ratio'])

