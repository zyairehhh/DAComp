import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

# Connect to database
conn = sqlite3.connect('/workspace/dacomp-022.sqlite')

# Query fare per km and driver ratings by vehicle type
query = """
SELECT 
    "Vehicle Type",
    AVG("Booking Value"/"Ride Distance") as avg_fare_per_km,
    AVG("Driver Ratings") as avg_driver_rating,
    COUNT(*) as ride_count
FROM sheet1 
WHERE "Booking Status" = 'Completed' 
    AND "Booking Value" IS NOT NULL 
    AND "Ride Distance" IS NOT NULL 
    AND "Ride Distance" > 0
    AND "Driver Ratings" IS NOT NULL
GROUP BY "Vehicle Type" 
ORDER BY avg_fare_per_km DESC
"""

df = pd.read_sql_query(query, conn)
conn.close()

# Create figure with two subplots
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

# Plot 1: Fare per km by vehicle type
vehicle_types = df["Vehicle Type"]
avg_fare_per_km = df["avg_fare_per_km"]
colors = plt.cm.Set3(range(len(vehicle_types)))

bars1 = ax1.bar(vehicle_types, avg_fare_per_km, color=colors)
ax1.set_xlabel('Vehicle Type')
ax1.set_ylabel('Average Fare per KM (currency units)')
ax1.set_title('Fare per Kilometer by Vehicle Type')
ax1.tick_params(axis='x', rotation=45)
ax1.grid(True, alpha=0.3)

# Add value labels on bars
for bar in bars1:
    height = bar.get_height()
    ax1.text(bar.get_x() + bar.get_width()/2., height + 0.1,
             f'{height:.1f}', ha='center', va='bottom', fontsize=9)

# Plot 2: Driver ratings by vehicle type
avg_driver_rating = df["avg_driver_rating"]

bars2 = ax2.bar(vehicle_types, avg_driver_rating, color=colors)
ax2.set_xlabel('Vehicle Type')
ax2.set_ylabel('Average Driver Rating (1-5 scale)')
ax2.set_title('Driver Ratings by Vehicle Type')
ax2.tick_params(axis='x', rotation=45)
ax2.grid(True, alpha=0.3)

# Add value labels on bars
for bar in bars2:
    height = bar.get_height()
    ax2.text(bar.get_x() + bar.get_width()/2., height + 0.01,
             f'{height:.2f}', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('/workspace/fare_vs_ratings_by_vehicle.png', dpi=150, bbox_inches='tight')
plt.close()

print("Plot saved as '/workspace/fare_vs_ratings_by_vehicle.png'")
```
