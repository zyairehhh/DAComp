import pandas as pd
import numpy as np

# load filtered campaigns
df = pd.read_csv('filtered_campaigns.csv')
print("Rows:", df.shape[0])
print(df.head())

# Ensure numeric columns
metrics = ['roas', 'cost_per_conversion', 'conversion_rate', 'quality_score', 'impression_share', 'ctr']
for col in metrics:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Define scoring function based on percentile rank (0-100)
def percentile_score(series, ascending=True):
    # ascending=True means higher values are better (e.g., roas)
    # For ascending=False (cost_per_conversion lower better), we invert series
    if ascending:
        return series.rank(pct=True) * 100
    else:
        # rank pct where lower is better -> we want higher score for lower values
        return (1 - series.rank(pct=True)) * 100

# Compute sub-scores
df['score_roas'] = percentile_score(df['roas'], ascending=True)
df['score_cpc'] = percentile_score(df['cost_per_conversion'], ascending=False)
df['score_cvr'] = percentile_score(df['conversion_rate'], ascending=True)
df['score_quality'] = percentile_score(df['quality_score'], ascending=True)
df['score_imp_share'] = percentile_score(df['impression_share'], ascending=True)
df['score_ctr'] = percentile_score(df['ctr'], ascending=True)

# Weighted composite
# Cost Efficiency (40%) = 20% roas + 20% cost_per_conversion (inverted)
# Conversion Quality (35%) = 20% conversion_rate + 15% quality_score? Let's assign equal weights? Let's do 17.5% each.
# Competitiveness (25%) = 12.5% impression_share + 12.5% ctr
df['cost_efficiency'] = 0.5 * df['score_roas'] + 0.5 * df['score_cpc']
df['conversion_quality'] = 0.5 * df['score_cvr'] + 0.5 * df['score_quality']
df['competitiveness'] = 0.5 * df['score_imp_share'] + 0.5 * df['score_ctr']

# Overall health score = weighted sum
df['health_score'] = 0.4 * df['cost_efficiency'] + 0.35 * df['conversion_quality'] + 0.25 * df['competitiveness']

# Risk level based on health_score quartiles
def risk_level(score):
    if score >= 75:
        return 'Low'
    elif score >= 50:
        return 'Medium'
    elif score >= 25:
        return 'High'
    else:
        return 'Critical'

df['risk_level'] = df['health_score'].apply(risk_level)

# Add diagnosis: Identify worst performing dimension
def diagnose(row):
    dims = ['cost_efficiency', 'conversion_quality', 'competitiveness']
    scores = [row[d] for d in dims]
    min_idx = np.argmin(scores)
    worst = dims[min_idx]
    # Map to readable
    if worst == 'cost_efficiency':
        return 'Inefficient spend (low ROAS/high CPC)'
    elif worst == 'conversion_quality':
        return 'Poor conversion quality (low CVR/Quality Score)'
    else:
        return 'Low competitiveness (low Impression Share/CTR)'

df['core_diagnosis'] = df.apply(diagnose, axis=1)

# Save results
df.to_csv('campaign_health_scores.csv', index=False)
print("Saved health scores to campaign_health_scores.csv")
print(df[['campaign_id', 'year_month', 'health_score', 'risk_level', 'core_diagnosis']].head())
```
