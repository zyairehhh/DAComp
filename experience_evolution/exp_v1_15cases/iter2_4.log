import sqlite3
import pandas as pd

conn = sqlite3.connect("/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter3/dacomp-069/stage1_env/dacomp-069.sqlite")
app = "com.dev.photoeditor"

# Get region mapping from geo_market_analysis
region_df = pd.read_sql("""
SELECT country, region FROM google_play__geo_market_analysis WHERE package_name = ?
""", conn, params=(app,))

# Monthly revenue per country from finance report
finance_df = pd.read_sql("""
SELECT country_short, strftime('%Y-%m', date_day) as month, SUM(net_amount) as monthly_revenue
FROM google_play__finance_report WHERE package_name = ?
GROUP BY country_short, month ORDER BY country_short, month
""", conn, params=(app,))

# Merge region
finance_df = finance_df.merge(region_df, left_on='country_short', right_on='country', how='inner')
finance_df['month'] = pd.to_datetime(finance_df['month'] + '-01')

# Aggregate by region and month
region_month = finance_df.groupby(['region', 'month'])['monthly_revenue'].sum().reset_index()

# Compute growth rates per region
region_month['prev_rev'] = region_month.groupby('region')['monthly_revenue'].shift(1)
region_month['growth'] = (region_month['monthly_revenue'] - region_month['prev_rev']) / region_month['prev_rev']

print("Revenue Trends by Region")
for region in region_month['region'].unique():
    reg_data = region_month[region_month['region'] == region]
    print(f"\nRegion: {region}")
    print(reg_data.tail(5).round(2))
    print(f"Overall revenue change from first to last month: {reg_data['monthly_revenue'].iloc[0]:.2f} -> {reg_data['monthly_revenue'].iloc[-1]:.2f}")
    if reg_data['monthly_revenue'].iloc[-1] < reg_data['monthly_revenue'].iloc[0]:
        print("Trend: Decreasing")
    else:
        print("Trend: Increasing")

# Also compute overall performance score trend and compare
perf_df = pd.read_sql("""
SELECT date_day, overall_performance_score, quality_score, average_rating
FROM google_play__comprehensive_performance_dashboard WHERE package_name = ?
ORDER BY date_day
""", conn, params=(app,))
perf_df['date_day'] = pd.to_datetime(perf_df['date_day'])

print("\n=== Overall Performance Trend ===")
print(perf_df.tail())

conn.close()
''')
