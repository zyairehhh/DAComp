import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import os

# Connect to database
conn = sqlite3.connect('./dacomp-069.sqlite')

# 1. Overall performance score trend over time for com.dev.photoeditor
df_score = pd.read_sql_query("""
    SELECT date_day, overall_performance_score 
    FROM google_play__comprehensive_performance_dashboard 
    WHERE package_name='com.dev.photoeditor' 
    ORDER BY date_day
""", conn)
df_score['date_day'] = pd.to_datetime(df_score['date_day'])
plt.figure(figsize=(10, 6))
plt.plot(df_score['date_day'], df_score['overall_performance_score'], marker='o')
plt.title('Overall Performance Score Trend for com.dev.photoeditor')
plt.xlabel('Date')
plt.ylabel('Performance Score')
plt.grid(True)
plt.tight_layout()
plt.savefig('performance_trend.png')
plt.close()

# 2. ARPU (average_revenue_per_user) by region, highlighting >7 and <3 thresholds
# But we need to see if any markets under $3 exist. Let's compute ARPU per market.
df_market = pd.read_sql_query("""
    SELECT country, region, average_revenue_per_user, avg_daily_revenue, overall_market_score, market_tier
    FROM google_play__geo_market_analysis 
    WHERE package_name='com.dev.photoeditor'
""", conn)

# Create a bar chart for ARPU by country, color by region
plt.figure(figsize=(12, 6))
colors = {'North America': 'blue', 'Europe': 'green', 'Asia': 'red', 'Oceania': 'orange', 'South America': 'purple'}
bar_colors = [colors.get(region, 'gray') for region in df_market['region']]
bars = plt.bar(df_market['country'], df_market['average_revenue_per_user'], color=bar_colors)
plt.axhline(y=7, color='red', linestyle='--', label='ARPU = $7')
plt.axhline(y=3, color='orange', linestyle='--', label='ARPU = $3')
plt.title('Average Revenue Per User by Country (com.dev.photoeditor)')
plt.xlabel('Country')
plt.ylabel('ARPU ($)')
plt.legend()
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('arpu_by_country.png')
plt.close()

# 3. Scatter plot: ARPU vs overall_market_score
plt.figure(figsize=(10, 6))
for region in df_market['region'].unique():
    subset = df_market[df_market['region'] == region]
    plt.scatter(subset['average_revenue_per_user'], subset['overall_market_score'], 
                label=region, s=100)
plt.axvline(x=7, color='red', linestyle='--', alpha=0.5)
plt.axvline(x=3, color='orange', linestyle='--', alpha=0.5)
plt.title('ARPU vs Market Performance Score')
plt.xlabel('Average Revenue Per User ($)')
plt.ylabel('Overall Market Score')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig('arpu_vs_market_score.png')
plt.close()

# 4. Divergence: Compare high revenue (>7) vs low revenue (<3) markets; but we have none <3.
# Let's instead compare Tier 1 vs Tier 3 markets.
df_market['revenue_category'] = df_market['average_revenue_per_user'].apply(lambda x: 'High (>$7)' if x > 7 else 'Low (<=$7)')
# We'll also compute average performance metrics across categories.
category_metrics = df_market.groupby('revenue_category').agg({
    'overall_market_score': 'mean',
    'avg_daily_revenue': 'mean',
    'average_revenue_per_user': 'mean'
}).reset_index()
print(category_metrics)

# Bar chart comparing average overall_market_score by revenue category
plt.figure(figsize=(8, 6))
plt.bar(category_metrics['revenue_category'], category_metrics['overall_market_score'])
plt.title('Average Market Score by Revenue Category (ARPU >$7 vs <=$7)')
plt.xlabel('Revenue Category')
plt.ylabel('Average Overall Market Score')
plt.tight_layout()
plt.savefig('market_score_by_revenue_category.png')
