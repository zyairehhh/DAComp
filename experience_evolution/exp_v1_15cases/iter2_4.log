'''
import pandas as pd
import numpy as np

df = pd.read_csv('filtered_campaigns.csv')
# Convert year_month to datetime
df['year_month'] = pd.to_datetime(df['year_month'])
df['year'] = df['year_month'].dt.year
df['month'] = df['year_month'].dt.month

# Aggregate monthly across all filtered campaigns
monthly = df.groupby(['year_month', 'year', 'month']).agg({
    'cost': 'sum',
    'conversions': 'sum',
    'conversion_value': 'sum',
    'impressions': 'sum',
    'clicks': 'sum',
    'campaign_id': 'nunique'
}).reset_index()
monthly['roi'] = monthly['conversion_value'] / monthly['cost']
monthly['ctr'] = monthly['clicks'] / monthly['impressions']
monthly['conv_rate'] = monthly['conversions'] / monthly['clicks']
monthly['cpc'] = monthly['cost'] / monthly['clicks']
monthly['cpa'] = monthly['cost'] / monthly['conversions']
monthly['avg_quality'] = df.groupby(['year_month'])['quality_score'].mean().values
monthly['avg_imp_share'] = df.groupby(['year_month'])['impression_share'].mean().values

# Compute month-over-month growth rates
monthly = monthly.sort_values('year_month')
monthly['cost_mom_pct'] = monthly['cost'].pct_change() * 100
monthly['conversions_mom_pct'] = monthly['conversions'].pct_change() * 100
monthly['roi_mom_pct'] = monthly['roi'].pct_change() * 100

# Year-over-year: compare same month across years
monthly['prev_year_month'] = monthly['year_month'] - pd.DateOffset(years=1)
# Merge with itself
yo = pd.merge(monthly, monthly[['year_month', 'cost', 'conversions', 'roi']], left_on='prev_year_month', right_on='year_month', suffixes=('', '_prev'))
yo['cost_yoy_pct'] = (yo['cost'] - yo['cost_prev']) / yo['cost_prev'] * 100
yo['conversions_yoy_pct'] = (yo['conversions'] - yo['conversions_prev']) / yo['conversions_prev'] * 100
yo['roi_yoy_pct'] = (yo['roi'] - yo['roi_prev']) / yo['roi_prev'] * 100
monthly = pd.merge(monthly, yo[['year_month', 'cost_yoy_pct', 'conversions_yoy_pct', 'roi_yoy_pct']], on='year_month', how='left')

print("Monthly aggregated trends:")
print(monthly[['year_month', 'cost', 'conversions', 'roi', 'cost_mom_pct', 'roi_mom_pct', 'cost_yoy_pct', 'roi_yoy_pct']])

# Seasonal: compute average by month across years
seasonal = monthly.groupby('month').agg({
    'cost': 'mean',
    'conversions': 'mean',
    'roi': 'mean'
}).reset_index()
print("\\nSeasonal averages (by month number):")
print(seasonal)

# Identify high-cost, low-conversion risk campaigns over time
# We'll flag campaigns where cost > average cost and conversion_rate < average conversion_rate
avg_cost = df['cost'].mean()
avg_conv_rate = (df['conversions'].sum() / df['clicks'].sum())
df['high_cost'] = df['cost'] > avg_cost
df['low_conv_rate'] = (df['conversions'] / df['clicks']) < avg_conv_rate
df['high_risk'] = df['high_cost'] & df['low_conv_rate']
high_risk_campaigns = df[df['high_risk']].copy()
print(f"\\nHigh-risk campaigns count: {high_risk_campaigns.shape[0]}")
print(high_risk_campaigns[['campaign_id', 'year_month', 'cost', 'conversions', 'roi']].head())

# Save to CSV
monthly.to_csv('monthly_trends.csv', index=False)
seasonal.to_csv('seasonal_patterns.csv', index=False)
high_risk_campaigns.to_csv('high_risk_campaigns.csv', index=False)
''')
