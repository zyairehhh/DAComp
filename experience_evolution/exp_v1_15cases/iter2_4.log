import sqlite3
import pandas as pd
import numpy as np
import math

# Connect to database
conn = sqlite3.connect("dacomp-058.sqlite")

# Load campaign report
df = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)
print("Campaign report rows:", df.shape[0])
print("Campaigns:", df['campaign_id'].nunique())
print("Months range:", df['year_month'].min(), df['year_month'].max())

# Ensure numeric columns are numeric
numeric_cols = ['impressions', 'clicks', 'cost', 'conversions', 'conversion_value',
                'ctr', 'cpc', 'conversion_rate', 'cost_per_conversion', 'roas',
                'quality_score', 'impression_share']
for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# 1. Filter: monthly cost > $1000 and ROI (roas) < 0.8
df_filtered = df[(df['cost'] > 1000) & (df['roas'] < 0.8)].copy()
print("Rows after cost > 1000 and roas < 0.8:", df_filtered.shape[0])
print("Unique campaigns in filtered set:", df_filtered['campaign_id'].nunique())

# 2. Compute additional metrics if needed
df_filtered['roi'] = df_filtered['roas'] - 1

# 3. Normalization function
def normalize(series, higher_better=True):
    """Return normalized series 0-100, where 100 is best."""
    if series.isnull().all():
        return pd.Series([50]*len(series), index=series.index)
    min_val = series.min()
    max_val = series.max()
    if max_val == min_val:
        return pd.Series([50]*len(series), index=series.index)
    if higher_better:
        return (series - min_val) / (max_val - min_val) * 100
    else:
        return (max_val - series) / (max_val - min_val) * 100

# Cost Efficiency (40%)
df_filtered['norm_roas'] = normalize(df_filtered['roas'], higher_better=True)
df_filtered['norm_cost_per_conv'] = normalize(df_filtered['cost_per_conversion'], higher_better=False)
df_filtered['norm_cpc'] = normalize(df_filtered['cpc'], higher_better=False)
df_filtered['cost_efficiency_score'] = 0.2 * df_filtered['norm_roas'] + 0.15 * df_filtered['norm_cost_per_conv'] + 0.05 * df_filtered['norm_cpc']

# Conversion Quality (35%)
df_filtered['norm_conversion_rate'] = normalize(df_filtered['conversion_rate'], higher_better=True)
df_filtered['norm_quality_score'] = normalize(df_filtered['quality_score'], higher_better=True)
df_filtered['conversion_quality_score'] = 0.2 * df_filtered['norm_conversion_rate'] + 0.15 * df_filtered['norm_quality_score']

# Competitiveness (25%)
df_filtered['norm_impression_share'] = normalize(df_filtered['impression_share'], higher_better=True)
df_filtered['norm_ctr'] = normalize(df_filtered['ctr'], higher_better=True)
df_filtered['competitiveness_score'] = 0.15 * df_filtered['norm_impression_share'] + 0.10 * df_filtered['norm_ctr']

# Total health score
df_filtered['health_score'] = df_filtered['cost_efficiency_score'] + df_filtered['conversion_quality_score'] + df_filtered['competitiveness_score']

# Risk level classification
def risk_level(score):
    if score < 40:
        return "High"
    elif score < 70:
        return "Medium"
    else:
        return "Low"

df_filtered['risk_level'] = df_filtered['health_score'].apply(risk_level)

# Summary stats
print("\nHealth score summary:")
print(df_filtered['health_score'].describe())
print("\nRisk level distribution:")
print(df_filtered['risk_level'].value_counts())

# Save to CSV for inspection
df_filtered.to_csv('filtered_campaigns_with_scores.csv', index=False)
print("\nSaved filtered_campaigns_with_scores.csv")

conn.close()
```
