# Add legend manually
from matplotlib.patches import Patch
legend_elements = [Patch(facecolor='tab:blue', label='Bot First'),
                   Patch(facecolor='tab:orange', label='Human First')]
ax.legend(handles=legend_elements)
ax.set_xticks(x)
ax.set_xticklabels(intents)
ax.set_ylabel('Demo Book Rate')
ax.set_title('Demo Book Rate by Intent Label and First Responder')
# Add value labels
for i, intent in enumerate(intents):
    sub = df_intent[df_intent['intent_label']==intent]
    bot_rate = sub[sub['responder_type']=='bot']['demo_rate'].iloc[0]
    human_rate = sub[sub['responder_type']=='human']['demo_rate'].iloc[0]
    ax.annotate(f'{bot_rate:.1%}', xy=(i - width/2, bot_rate), xytext=(0,3), textcoords="offset points", ha='center', va='bottom', fontsize=9)
    ax.annotate(f'{human_rate:.1%}', xy=(i + width/2, human_rate), xytext=(0,3), textcoords="offset points", ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('/workspace/intent_demo_rates.png', dpi=300)
plt.close()

# Plot 4: Lead Source Segmentation Demo Rates
sources = df_source['lead_source'].unique()
x = np.arange(len(sources))
fig, ax = plt.subplots(figsize=(10,5))
for i, source in enumerate(sources):
    sub = df_source[df_source['lead_source']==source]
    bot_rate = sub[sub['responder_type']=='bot']['demo_rate'].iloc[0]
