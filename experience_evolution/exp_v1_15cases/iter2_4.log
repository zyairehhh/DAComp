import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Load data
conn = sqlite3.connect('dacomp-060.sqlite')
df = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)
conn.close()

# Compute CTR and CVR
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
df['CTR'] = df['CTR'].replace([np.inf, -np.inf], np.nan).fillna(0)
df['CVR'] = df['CVR'].replace([np.inf, -np.inf], np.nan).fillna(0)

# Percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

# Identify problematic ad groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
# Compute expected CVR (overall average)
overall_cvr = df.loc[df['clicks']>0, 'CVR'].mean()
problematic.loc[:, 'expected_cvr'] = overall_cvr
problematic.loc[:, 'intent_match_ratio'] = problematic['CVR'] / overall_cvr

# 1. Scatter plot of CTR vs CVR with quadrant
plt.figure(figsize=(10, 6))
plt.scatter(df['CTR'], df['CVR'], alpha=0.5, s=10, label='All ad groups')
plt.scatter(problematic['CTR'], problematic['CVR'], alpha=0.7, s=20, color='red', label='Problematic (high CTR, low CVR)')
plt.axvline(x=ctr_75, color='gray', linestyle='--', alpha=0.7)
plt.axhline(y=cvr_25, color='gray', linestyle='--', alpha=0.7)
plt.fill_betweenx([0, cvr_25], ctr_75, df['CTR'].max(), color='red', alpha=0.1, label='Problematic region')
plt.xlabel('Click-Through Rate (CTR)')
plt.ylabel('Conversion Rate (CVR)')
plt.title('CTR vs CVR: High-CTR, Low-CVR Ad Groups', fontsize=14)
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('ctr_cvr_scatter.png', dpi=150)
plt.close()

# 2. Distribution of CTR and CVR with percentile thresholds
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# CTR histogram
axes[0].hist(df['CTR'], bins=50, edgecolor='black', alpha=0.7)
axes[0].axvline(x=ctr_75, color='red', linestyle='--', linewidth=2, label='75th percentile')
axes[0].set_xlabel('CTR')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Distribution of CTR')
axes[0].legend()
axes[0].grid(True, linestyle='--', alpha=0.5)

# CVR histogram
axes[1].hist(df['CVR'][df['CVR'] <= 0.5], bins=50, edgecolor='black', alpha=0.7)  # limit to 0.5 for clarity
axes[1].axvline(x=cvr_25, color='red', linestyle='--', linewidth=2, label='25th percentile')
axes[1].set_xlabel('CVR')
axes[1].set_ylabel('Frequency')
axes[1].set_title('Distribution of CVR')
axes[1].legend()
axes[1].grid(True, linestyle='--', alpha=0.5)

plt.tight_layout()
plt.savefig('ctr_cvr_distributions.png', dpi=150)
plt.close()

# 3. Top 10 problematic ad groups by spend
if not problematic.empty:
    top10_spend = problematic.nlargest(10, 'spend')
    # Use ad_group_id as label because names are encoded
    labels = [f"Ad Group {i+1}" for i in range(len(top10_spend))]
    plt.figure(figsize=(10, 6))
    bars = plt.barh(labels, top10_spend['spend'], color='coral', edgecolor='black')
    plt.xlabel('Total Spend')
    plt.title('Top 10 Problematic Ad Groups by Spend', fontsize=14)
    plt.gca().invert_yaxis()  # highest spend on top
    # Add text labels
    for bar in bars:
        width = bar.get_width()
        plt.text(width, bar.get_y() + bar.get_height()/2, f'${width:.2f}', ha='left', va='center')
    plt.tight_layout()
    plt.savefig('top_problematic_by_spend.png', dpi=150)
    plt.close()
else:
    print("No problematic ad groups to plot.")

# 4. Intent Match Ratio vs Spend for problematic ad groups
if not problematic.empty:
    plt.figure(figsize=(10, 6))
    scatter = plt.scatter(problematic['intent_match_ratio'], problematic['spend'],
                          alpha=0.6, s=50, c=problematic['CTR'], cmap='viridis')
    plt.axvline(x=1.0, color='gray', linestyle='--', alpha=0.7, label='Expected CVR (ratio=1)')
    plt.xlabel('Intent Match Ratio (Actual CVR / Expected CVR)')
    plt.ylabel('Total Spend')
    plt.title('Intent Match Ratio vs Spend for Problematic Ad Groups', fontsize=14)
    cbar = plt.colorbar(scatter)
    cbar.set_label('CTR')
    plt.legend()
    plt.grid(True, linestyle='--', alpha=0.5)
    plt.tight_layout()
    plt.savefig('intent_match_vs_spend.png', dpi=150)
    plt.close()
    
print("Plots generated successfully.")
```
