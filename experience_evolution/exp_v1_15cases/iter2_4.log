# Function to extract salary bounds
def extract_salary_bounds(salary_str):
    if pd.isna(salary_str):
        return None, None
    # Find all numbers in the string
    numbers = re.findall(r'[\d,]+\.?\d*', salary_str.replace(',', ''))
    if not numbers:
        return None, None
    # Convert to integers
    nums = [int(float(num)) for num in numbers if float(num) < 100000]  # filter unrealistic numbers
    # If many numbers, look for pattern like "X-Y" or "X-Y yuan/month"
    # Try to find numbers that look like a range
    if len(nums) >= 2:
        # Often first two numbers are the range
        lower = min(nums[:2])
        upper = max(nums[:2])
        # Basic sanity check: lower should be <= upper and reasonable
        if lower > 0 and upper <= 50000 and lower <= upper:
            return lower, upper
    return None, None

# Extract salary bounds
bounds = voc_df['Salary Range'].apply(extract_salary_bounds)
voc_df.loc[:, 'salary_lower'] = bounds.apply(lambda x: x[0] if x else None)
voc_df.loc[:, 'salary_upper'] = bounds.apply(lambda x: x[1] if x else None)
voc_df.loc[:, 'salary_mid'] = voc_df.apply(lambda row: (row['salary_lower'] + row['salary_upper']) / 2 
                                    if row['salary_lower'] and row['salary_upper'] else None, axis=1)

# Remove rows with missing salary
