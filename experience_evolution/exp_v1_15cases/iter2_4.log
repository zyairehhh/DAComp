Now we need to analyze common characteristics: maybe they have high proportion of broad match keywords, low conversion value per click, maybe high impressions but low conversions.

Let's fetch additional data: For each problematic ad group, compute average CPC, conversion value per click, etc.

We have spend, clicks, conversions_value. Let's compute metrics.

Write a script to aggregate problematic ad groups and compare with non-problematic.

Action: CreateFile(filepath='compare_metrics.py'):
```
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')

# Load problematic ad groups
problematic = pd.read_csv('problematic_with_ratio.csv')
problematic_ids = problematic['ad_group_id'].tolist()

# Get all ad groups metrics
query = """
SELECT ad_group_id, 
       SUM(spend) as spend,
       SUM(clicks) as clicks,
       SUM(impressions) as impressions,
       SUM(conversions) as conversions,
       SUM(conversions_value) as conversions_value
FROM google_ads__ad_group_report
GROUP BY ad_group_id
"""
all_metrics = pd.read_sql_query(query, conn)
all_metrics['ctr'] = all_metrics['clicks'] / all_metrics['impressions']
all_metrics['cvr'] = all_metrics['conversions'] / all_metrics['clicks']
all_metrics['cpc'] = all_metrics['spend'] / all_metrics['clicks']
all_metrics['cpa'] = all_metrics['spend'] / all_metrics['conversions']
all_metrics['conversion_value_per_click'] = all_metrics['conversions_value'] / all_metrics['clicks']
all_metrics.fillna(0, inplace=True)

# Classify
all_metrics['is_problematic'] = all_metrics['ad_group_id'].isin(problematic_ids)

# Compare averages
grouped = all_metrics.groupby('is_problematic').agg({
    'spend': 'sum',
    'clicks': 'sum',
    'impressions': 'sum',
    'conversions': 'sum',
    'conversions_value': 'sum',
    'ctr': 'mean',
    'cvr': 'mean',
    'cpc': 'mean',
    'cpa': 'mean',
    'conversion_value_per_click': 'mean'
}).reset_index()
print('Comparison between problematic and non-problematic ad groups:')
print(grouped)

# Compute percentages
total_groups = all_metrics.shape[0]
problematic_count = problematic.shape[0]
print(f'Total ad groups: {total_groups}')
print(f'Problematic ad groups: {problematic_count} ({problematic_count/total_groups*100:.2f}%)')
print('\\nProblematic ad groups have high CTR but low CVR, indicating potential intent mismatch.')

# Analyze keyword match type distribution
query2 = """
SELECT ad_group_id, keyword_match_type, SUM(clicks) as clicks
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
match_type_df = pd.read_sql_query(query2, conn)

# Aggregate by problematic status
match_type_df['is_problematic'] = match_type_df['ad_group_id'].isin(problematic_ids)
match_type_agg = match_type_df.groupby(['is_problematic', 'keyword_match_type'])['clicks'].sum().reset_index()
match_type_pivot = match_type_agg.pivot(index='keyword_match_type', columns='is_problematic', values='clicks').fillna(0)
match_type_pivot['problematic_pct'] = match_type_pivot[True] / (match_type_pivot[True] + match_type_pivot[False]) * 100
print('\\nKeyword match type clicks distribution:')
print(match_type_pivot)
```
