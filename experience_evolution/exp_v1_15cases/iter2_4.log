import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Data from stage1 report
# Overall conversion funnel
segments = ['Bot-first', 'Human-first']

# Demo booked rate
demo_rates = [23.15, 24.78]  # %
# Trial activation rate (after demo)
trial_rates = [7.11, 8.48]   # %
# Paid conversion rate (after trial)
paid_rates = [128.57, 112.82] # %

# Stage durations (days)
demo_to_trial = [141.3, 133.1]
trial_to_paid = [141.3, 147.8]

# 1. Conversion rates bar chart
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Plot 1: Conversion rates across funnel stages
x = np.arange(len(segments))
width = 0.25
axes[0].bar(x - width, demo_rates, width, label='Demo booked (%)', color='skyblue')
axes[0].bar(x, trial_rates, width, label='Trial activated (% of demo)', color='lightgreen')
axes[0].bar(x + width, paid_rates, width, label='Paid (% of trial)', color='salmon')
axes[0].set_xticks(x)
axes[0].set_xticklabels(segments)
axes[0].set_ylabel('Conversion Rate (%)')
axes[0].set_title('Conversion Rates by First Response Type')
axes[0].legend()
axes[0].grid(axis='y', linestyle='--', alpha=0.7)

# Plot 2: Stage durations
axes[1].bar(x - width/2, demo_to_trial, width, label='Demo → Trial', color='skyblue')
axes[1].bar(x + width/2, trial_to_paid, width, label='Trial → Paid', color='lightgreen')
axes[1].set_xticks(x)
axes[1].set_xticklabels(segments)
axes[1].set_ylabel('Average Days')
axes[1].set_title('Stage Durations by First Response Type')
axes[1].legend()
axes[1].grid(axis='y', linestyle='--', alpha=0.7)

plt.tight_layout()
plt.savefig('conversion_durations.png', dpi=300)
plt.close()

# 2. Impact of Intent: Pricing vs Billing vs Marketing-qualified lifecycle
# Using data from report:
# Pricing intent: human-first demo booking 24.7% vs bot 22.8%, trial activation 9.0% vs 7.8%
# Billing intent: human-first trial activation 4.8% vs bot 0%
# Marketing-qualified lifecycle: bot trial activation 16.7% vs human 12.1%
intent_labels = ['Pricing (Demo)', 'Pricing (Trial)', 'Billing (Trial)', 'MQ Lifecycle (Trial)']
bot_rates_intent = [22.8, 7.8, 0.0, 16.7]
human_rates_intent = [24.7, 9.0, 4.8, 12.1]

fig, ax = plt.subplots(figsize=(8,5))
x_intent = np.arange(len(intent_labels))
width = 0.35
ax.bar(x_intent - width/2, bot_rates_intent, width, label='Bot-first', color='royalblue')
ax.bar(x_intent + width/2, human_rates_intent, width, label='Human-first', color='orange')
ax.set_xticks(x_intent)
ax.set_xticklabels(intent_labels, rotation=15, ha='right')
ax.set_ylabel('Conversion Rate (%)')
ax.set_title('Conversion Rates by Intent/Lifecycle')
ax.legend()
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('intent_impact.png', dpi=300)
plt.close()

# 3. Impact of Segment: Startup, Mid-Market
# Startup: human-first leads across all rates (we can skip as no specific numbers)
# Mid-Market: demo booking 31.8% vs 16.7%; trial activation 14.3% vs 0%
segment_labels = ['Mid-Market (Demo)', 'Mid-Market (Trial)']
bot_segment = [16.7, 0.0]
human_segment = [31.8, 14.3]

fig, ax = plt.subplots(figsize=(6,4))
x_seg = np.arange(len(segment_labels))
ax.bar(x_seg - width/2, bot_segment, width, label='Bot-first', color='royalblue')
ax.bar(x_seg + width/2, human_segment, width, label='Human-first', color='orange')
ax.set_xticks(x_seg)
ax.set_xticklabels(segment_labels)
ax.set_ylabel('Conversion Rate (%)')
ax.set_title('Mid-Market Segment Performance')
ax.legend()
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('segment_impact.png', dpi=300)
plt.close()

# 4. Impact of Region: Asia Pacific, Europe, Latin America
# Asia Pacific: trial activation bot 15.4% vs human 6.3%; paid conversion bot 83% vs human 180%
# Europe: trial activation human 8.6% vs bot 2.4%
# Latin America: demo booking human 27% vs bot 19.5%
region_labels = ['Asia Pacific (Trial)', 'Asia Pacific (Paid)', 'Europe (Trial)', 'Latin America (Demo)']
bot_region = [15.4, 83.0, 2.4, 19.5]
human_region = [6.3, 180.0, 8.6, 27.0]

fig, ax = plt.subplots(figsize=(8,5))
x_reg = np.arange(len(region_labels))
ax.bar(x_reg - width/2, bot_region, width, label='Bot-first', color='royalblue')
ax.bar(x_reg + width/2, human_region, width, label='Human-first', color='orange')
ax.set_xticks(x_reg)
ax.set_xticklabels(region_labels, rotation=15, ha='right')
ax.set_ylabel('Conversion Rate (%)')
ax.set_title('Regional Performance Differences')
ax.legend()
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('region_impact.png', dpi=300)
plt.close()

print("Plots generated.")
