Action: CreateFile(filepath='optimal_allocation.py':
'''
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-067.sqlite')
df = pd.read_sql_query("""
SELECT source_name, total_hires, total_applications, hire_rate, avg_process_days, efficiency_score
FROM greenhouse__talent_pipeline_simplified
WHERE application_year=2024 AND application_quarter=4
""", conn)

# Add avg_quality and avg_rating per source
quality = pd.read_sql_query("""
SELECT tps.source_name, AVG(cs.candidate_quality_score) as avg_quality
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
GROUP BY tps.source_name
""", conn)
rating = pd.read_sql_query("""
SELECT tps.source_name, AVG(scd.rating) as avg_rating
FROM greenhouse__interview_scorecard_detail scd
JOIN greenhouse__interview_enhanced ie ON scd.scorecard_id = ie.scorecard_id
JOIN greenhouse__application_enhanced ae ON ie.application_id = ae.application_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE scd.rating IS NOT NULL
GROUP BY tps.source_name
""", conn)
df = df.merge(quality, on='source_name', how='left')
df = df.merge(rating, on='source_name', how='left')
df['avg_quality'] = df['avg_quality'].fillna(df['avg_quality'].median())
df['avg_rating'] = df['avg_rating'].fillna(df['avg_rating'].median())

# Cost per hire (in thousands)
cost_map = {
    'Headhunter': 20,
    'University Recruiting': 5,
    'Employee Referral': 2,
    'LinkedIn': 0.5,
    'Indeed': 0.5,
    'Glassdoor': 0.5,
    'AngelList': 0.5,
    'Company Website': 0.1
}
df['cost_per_hire'] = df['source_name'].map(cost_map)
df['current_cost'] = df['total_hires'] * df['cost_per_hire']
total_cost = df['current_cost'].sum()
target_cost = total_cost * 0.85
print(f"Current total cost: ${total_cost:.0f}k")
print(f"Target cost (15% reduction): ${target_cost:.0f}k")

# Normalize metrics for composite score
def normalize(series):
    minv = series.min()
    maxv = series.max()
    return (series - minv) / (maxv - minv)

df['hire_rate_norm'] = normalize(df['hire_rate'])
df['efficiency_score_norm'] = normalize(df['efficiency_score'])
df['avg_quality_norm'] = normalize(df['avg_quality'])
df['avg_rating_norm'] = normalize(df['avg_rating'])
# Invert avg_process_days for speed
df['speed'] = 1 / (df['avg_process_days'] + 1)
df['speed_norm'] = normalize(df['speed'])

weights = {
    'hire_rate_norm': 0.25,
    'efficiency_score_norm': 0.2,
    'avg_quality_norm': 0.25,
    'avg_rating_norm': 0.2,
    'speed_norm': 0.1
}
df['composite'] = sum(df[w] * weight for w, weight in weights.items())
# Cost-effectiveness score
df['cost_effectiveness'] = df['composite'] / df['cost_per_hire']

print(df[['source_name','total_hires','cost_per_hire','current_cost','composite','cost_effectiveness']].sort_values('cost_effectiveness', ascending=False))

# New allocation: allocate hires proportionally to cost_effectiveness while meeting cost target.
# We'll use linear programming via simple iterative adjustment.
# Step 1: start with current hires, then shift from low cost-effectiveness to high.
# Let's compute new hires per source to minimize cost while maintaining total hires (3309) and composite quality not dropping too much.
# We'll use a greedy algorithm.

df = df.sort_values('cost_effectiveness', ascending=False)
total_hires = df['total_hires'].sum()
print(f"Total hires to allocate: {total_hires}")

# We'll set a target to move hires from low-performing sources to high-performing.
# Compute desired distribution proportional to cost_effectiveness
df['allocation_weight'] = df['cost_effectiveness'] / df['cost_effectiveness'].sum()
df['new_hires'] = df['allocation_weight'] * total_hires
df['new_hires'] = df['new_hires'].round().astype(int)
# Adjust rounding errors
diff = total_hires - df['new_hires'].sum()
df.loc[df.index[0], 'new_hires'] += diff
df['new_cost'] = df['new_hires'] * df['cost_per_hire']
new_total_cost = df['new_cost'].sum()
print(f"Allocation based on cost-effectiveness:")
print(df[['source_name','total_hires','new_hires','cost_per_hire','new_cost','cost_effectiveness']].sort_values('new_hires', ascending=False))
print(f"New total cost: ${new_total_cost:.0f}k, reduction: {(1-new_total_cost/total_cost)*100:.1f}%")
if new_total_cost <= target_cost:
    print("Target achieved!")
else:
    print("Target not yet met, need further adjustment.")
''')
