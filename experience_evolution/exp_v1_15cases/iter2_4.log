                       ha="center", va="center", color="black", fontsize=8)

ax.set_title('Monthly Active Device Growth Rate by Region (%)', fontsize=14)
fig.colorbar(im, ax=ax)
plt.tight_layout()
plt.savefig('region_growth_heatmap.png', dpi=300, bbox_inches='tight')

# Also create device category analysis
device_data['month'] = device_data['date_day'].dt.to_period('M')
# Group devices into categories based on name patterns
def categorize_device(device_name):
    device_lower = device_name.lower()
    if 'iphone' in device_lower:
        return 'iPhone'
    elif 'samsung' in device_lower:
        return 'Samsung'
    elif 'redmi' in device_lower or 'xiaomi' in device_lower:
        return 'Xiaomi'
    elif 'pixel' in device_lower:
        return 'Pixel'
    elif 'oneplus' in device_lower:
        return 'OnePlus'
    else:
        return 'Other'

device_data['device_category'] = device_data['device'].apply(categorize_device)

# Analyze retention by device category
device_category_monthly = device_data.groupby(['device_category', 'month']).agg({
    'active_devices_last_30_days': 'mean',
    'rolling_total_average_rating': 'mean'
}).reset_index()

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# Plot active devices trend by category
for category in device_category_monthly['device_category'].unique():
    cat_data = device_category_monthly[device_category_monthly['device_category'] == category]
    axes[0].plot(cat_data['month'].astype(str), cat_data['active_devices_last_30_days'], 
                marker='o', label=category, linewidth=2)

axes[0].set_title('Active Devices by Device Category', fontsize=12)
axes[0].set_xlabel('Month')
axes[0].set_ylabel('Active Devices (30-day avg)')
axes[0].tick_params(axis='x', rotation=45)
axes[0].legend(title='Category', bbox_to_anchor=(1.05, 1), loc='upper left')
axes[0].grid(True, alpha=0.3)

# Plot ratings trend by category  
for category in device_category_monthly['device_category'].unique():
    cat_data = device_category_monthly[device_category_monthly['device_category'] == category]
    axes[1].plot(cat_data['month'].astype(str), cat_data['rolling_total_average_rating'], 
                marker='o', label=category, linewidth=2)

axes[1].set_title('Average Rating by Device Category', fontsize=12)
axes[1].set_xlabel('Month')
axes[1].set_ylabel('Rolling Average Rating')
axes[1].tick_params(axis='x', rotation=45)
axes[1].legend(title='Category', bbox_to_anchor=(1.05, 1), loc='upper left')
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('device_category_trends.png', dpi=300, bbox_inches='tight')

conn.close()
print("Additional visualizations created!")
''')
