import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Connect to database
conn = sqlite3.connect('dacomp-034.sqlite')

# Load attachment_4 (categories)
categories = pd.read_sql_query("SELECT sku_id, \"Level 1 Category Name\" FROM attachment_4", conn)
print("Categories loaded:", categories.shape)

# Load direct promotions (type 3, approved, valid)
promos = pd.read_sql_query("""
    SELECT sku_id, promotion_price, pdj_price, begin_time, end_time
    FROM attachment_3
    WHERE promotion_type = 3 AND state = 5 AND validation = 0
""", conn)
print("Promotions loaded:", promos.shape)

# Load sales from attachment_1 and attachment_2
sales1 = pd.read_sql_query("SELECT * FROM attachment_1", conn)
sales2 = pd.read_sql_query("SELECT * FROM attachment_2", conn)
print("Sales1 shape:", sales1.shape, " Sales2 shape:", sales2.shape)

# Combine
sales = pd.concat([sales1, sales2], ignore_index=True)
print("Combined sales shape:", sales.shape)

conn.close()
