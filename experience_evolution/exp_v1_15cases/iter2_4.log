import pandas as pd
import sqlite3
import numpy as np
from scipy.optimize import minimize

conn = sqlite3.connect('dacomp-067.sqlite')

# Get source type aggregates
df = pd.read_sql_query("""
SELECT source_type, SUM(total_hires) AS current_hires,
       AVG(hire_rate) AS hire_rate,
       AVG(avg_process_days) AS avg_days,
       AVG(interview_rate) AS interview_rate,
       AVG(interview_to_hire_rate) AS i2h_rate
FROM greenhouse__talent_pipeline_simplified
GROUP BY source_type
""", conn)

print("Current source type aggregates:")
print(df)

# Add cost per hire
cost_per_hire = {
    'agency': 20000,
    'direct': 200,
    'job_board': 1000,
    'referral': 5000,
    'social_media': 500,
    'university': 8000
}
df['cost'] = df['source_type'].map(cost_per_hire)

# Add diversity metrics (female and non-white representation) per source type
# Use aggregated earlier from analysis (but we need compute again)
# Let's compute using SQL for each source type to get female and non-white hires.
sql = """
SELECT source_type,
       COUNT(CASE WHEN a.status='hired' AND a.candidate_gender = 'Female' THEN 1 END) AS female_hires,
       COUNT(CASE WHEN a.status='hired' AND a.candidate_race != 'White' THEN 1 END) AS non_white_hires,
       COUNT(CASE WHEN a.status='hired' THEN 1 END) AS total_hires_with_data
FROM greenhouse__application_enhanced a
JOIN greenhouse__talent_pipeline_simplified t ON a.source_id = t.source_id
WHERE a.candidate_gender IS NOT NULL AND a.candidate_race IS NOT NULL
GROUP BY source_type
"""
df_div = pd.read_sql_query(sql, conn)
print("\nDiversity per source type:")
print(df_div)

# Merge
df = df.merge(df_div, on='source_type', how='left')
df['female_rep'] = df['female_hires'] / df['total_hires_with_data']
df['non_white_rep'] = df['non_white_hires'] / df['total_hires_with_data']

# Add interviewer rating per source
sql_rating = """
SELECT source_type, AVG(rating) AS avg_rating
FROM greenhouse__interview_scorecard_detail d
JOIN greenhouse__application_enhanced a ON d.application_id = a.application_id
JOIN greenhouse__talent_pipeline_simplified t ON a.source_id = t.source_id
WHERE rating IS NOT NULL
GROUP BY source_type
"""
df_rating = pd.read_sql_query(sql_rating, conn)
print("\nRating per source:")
print(df_rating)
df = df.merge(df_rating, on='source_type', how='left')

print("\nFull dataset for optimization:")
print(df)

# Current total hires baseline
current_total_hires = int(df['current_hires'].sum())
print(f"\nCurrent total hires (from talent pipeline): {current_total_hires}")

# Optimization variables: hires per source type (x_i)
n = len(df)
source_types = df['source_type'].tolist()

# Objective: minimize total cost
costs = df['cost'].values

# Constraints:
# 1. Total hires = target total hires (same as baseline)
# 2. Female representation >= 0.4
# 3. Non-white representation >= 0.3
# 4. Average interviewer rating >= 4.0 (but we cannot achieve with current ratings, so treat as separate improvement)
# We'll keep average rating as weighted average using current ratings; but we could treat as variable to improve if we adjust process.

# We'll first see if we can meet diversity and cost reduction with only source reallocation.

# Female representation weighted calc: sum(x_i * female_rep_i) / total_hires >= 0.4
female_reps = df['female_rep'].fillna(0).values
non_white_reps = df['non_white_rep'].fillna(0).values
ratings = df['avg_rating'].fillna(2.7).values

# Define optimization problem
def objective(x):
    return np.dot(x, costs)

def constraint_total_hires(x):
    return np.sum(x) - current_total_hires  # = 0

def constraint_female(x):
    total = np.sum(x)
    if total == 0:
        return -1
    return np.dot(x, female_reps) / total - 0.4  # >= 0

def constraint_non_white(x):
    total = np.sum(x)
    if total == 0:
        return -1
    return np.dot(x, non_white_reps) / total - 0.3  # >= 0

def constraint_rating(x):
    total = np.sum(x)
    if total == 0:
        return -1
    # We want average rating >= 4.0
    return np.dot(x, ratings) / total - 4.0  # >= 0

bounds = [(0, 2 * row.current_hires) for _, row in df.iterrows()]

# Initial guess: current hires
x0 = df['current_hires'].values

cons = [
    {'type': 'eq', 'fun': constraint_total_hires},
    {'type': 'ineq', 'fun': constraint_female},
    {'type': 'ineq', 'fun': constraint_non_white},
    #{'type': 'ineq', 'fun': constraint_rating}  # too strict; will cause infeasible
]

result = minimize(objective, x0, bounds=bounds, constraints=cons, method='SLSQP')
if result.success:
    opt_hires = result.x
    total_cost = result.fun
    print(f"\nOptimization successful!")
    print("Optimal hires per source:")
    for i, st in enumerate(source_types):
        print(f"  {st}: {opt_hires[i]:.1f}")
    print(f"Total cost: ${total_cost:,.2f}")
    print(f"Current total cost: ${np.dot(x0, costs):,.2f}")
    print(f"Cost reduction: {(np.dot(x0, costs) - total_cost)/np.dot(x0, costs)*100:.2f}%")
    # Compute constraints
    total = np.sum(opt_hires)
    female_rep_actual = np.dot(opt_hires, female_reps) / total
    non_white_rep_actual = np.dot(opt_hires, non_white_reps) / total
    rating_actual = np.dot(opt_hires, ratings) / total
    print(f"Female representation: {female_rep_actual:.3f}")
    print(f"Non‑white representation: {non_white_rep_actual:.3f}")
    print(f"Average interviewer rating: {rating_actual:.3f}")
else:
    print("Optimization failed:", result.message)
```
