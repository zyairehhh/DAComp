import pandas as pd
import sqlite3

df = pd.read_csv('ad_group_metrics.csv')
problematic = pd.read_csv('problematic_with_ratio.csv')
print('Total ad groups:', len(df))
print('Problematic ad groups:', len(problematic))
print('Proportion:', len(problematic)/len(df))
conn = sqlite3.connect('dacomp-060.sqlite')
