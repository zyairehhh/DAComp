'''
import pandas as pd
import numpy as np

df = pd.read_csv('contacts_with_scores.csv')
print("Segment distribution:")
print(df['value_segment'].value_counts())
print(df['value_segment'].value_counts(normalize=True) * 100)

# Compute percentiles for desired proportions
thresholds = {
    'power_user': df['composite_score'].quantile(0.9215),
    'high_value': df['composite_score'].quantile(0.7728),
    'medium_value': df['composite_score'].quantile(0.4243),
    'low_value': df['composite_score'].quantile(0.1756),
    'one_time': -np.inf
}
print("\nThresholds based on cohort proportions:")
for k, v in thresholds.items():
    print(f"{k}: {v}")

# Reassign segments
def assign_segment_proportional(score):
    if score >= thresholds['power_user']:
        return 'power_user'
    elif score >= thresholds['high_value']:
        return 'high_value'
    elif score >= thresholds['medium_value']:
        return 'medium_value'
    elif score >= thresholds['low_value']:
        return 'low_value'
    else:
        return 'one_time'

df['value_segment_prop'] = df['composite_score'].apply(assign_segment_proportional)
print("\nNew segment counts:")
print(df['value_segment_prop'].value_counts())
print(df['value_segment_prop'].value_counts(normalize=True) * 100)

# Save updated dataframe
df.to_csv('contacts_with_scores_v2.csv', index=False)

# Compute characteristics for each segment
segment_stats = df.groupby('value_segment_prop').agg({
    'total_count_surveys': ['mean','median','std'],
    'total_count_completed_surveys': ['mean','median','std'],
    'completion_rate': ['mean','median','std'],
    'count_surveys_sent_email': 'mean',
    'count_surveys_sent_sms': 'mean',
    'cross_channel': 'mean',
    'avg_survey_progress_pct': 'mean',
    'avg_survey_duration_in_seconds': 'mean'
}).round(2)
print("\nSegment statistics:")
print(segment_stats)

# Focus on medium vs high value: differences
medium = df[df['value_segment_prop'] == 'medium_value']
high = df[df['value_segment_prop'] == 'high_value']
power = df[df['value_segment_prop'] == 'power_user']

print("\nComparison Medium vs High (mean):")
compare = pd.DataFrame({
    'medium_mean': medium.mean(numeric_only=True),
    'high_mean': high.mean(numeric_only=True),
    'power_mean': power.mean(numeric_only=True)
})
print(compare.loc[['total_count_surveys','total_count_completed_surveys','completion_rate','count_surveys_sent_email','count_surveys_sent_sms','cross_channel','avg_survey_progress_pct','avg_survey_duration_in_seconds']])
''')
