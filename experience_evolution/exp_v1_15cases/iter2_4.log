for contact_id, group in df.groupby('contact_id'):
    for stage_val in ['demo_booked', 'trial_activated', 'closed_won']:
        sub = group[group['stage'] == stage_val]
        if not sub.empty:
            ts = sub['conversation_created_at'].min()
            stage_timestamps.setdefault(contact_id, {})[stage_val] = ts

# Build contact-stage dataframe
records = []
for contact_id in contact_info['contact_id']:
    first_type = contact_info[contact_info['contact_id'] == contact_id]['conversation_initiated_type'].iloc[0]
    demo_ts = stage_timestamps.get(contact_id, {}).get('demo_booked')
    trial_ts = stage_timestamps.get(contact_id, {}).get('trial_activated')
    paid_ts = stage_timestamps.get(contact_id, {}).get('closed_won')
    # Determine if demo booked (any)
    has_demo = demo_ts is not None
    # Determine if trial activated after demo (if both exist)
    has_trial_after_demo = (demo_ts is not None and trial_ts is not None and trial_ts > demo_ts)
    # Determine if paid after trial (if both exist)
    has_paid_after_trial = (trial_ts is not None and paid_ts is not None and paid_ts > trial_ts)
    records.append({
        'contact_id': contact_id,
        'first_response_type': first_type,
        'has_demo': has_demo,
        'has_trial': trial_ts is not None,
        'has_paid': paid_ts is not None,
        'demo_ts': demo_ts,
        'trial_ts': trial_ts,
        'paid_ts': paid_ts,
        'has_trial_after_demo': has_trial_after_demo,
        'has_paid_after_trial': has_paid_after_trial
    })
contact_stages = pd.DataFrame(records)

# Compute conversion rates (conditional)
def compute_rates(sub):
    total = len(sub)
    demo = sub['has_demo'].sum()
    trial_after_demo = sub['has_trial_after_demo'].sum()
    paid_after_trial = sub['has_paid_after_trial'].sum()
    rate1 = demo / total if total > 0 else 0
    rate2 = trial_after_demo / demo if demo > 0 else 0
    rate3 = paid_after_trial / trial_after_demo if trial_after_demo > 0 else 0
    return total, demo, trial_after_demo, paid_after_trial, rate1, rate2, rate3

bot = contact_stages[contact_stages['first_response_type'] == 'bot_first']
human = contact_stages[contact_stages['first_response_type'] == 'human_first']

total_bot, demo_bot, trial_bot, paid_bot, r1_bot, r2_bot, r3_bot = compute_rates(bot)
total_human, demo_human, trial_human, paid_human, r1_human, r2_human, r3_human = compute_rates(human)

print('=== Conversion Rates with Sequential Ordering ===')
print(f'Bot-first contacts: {total_bot}')
print(f'  Demo booked rate: {r1_bot:.2%} ({demo_bot}/{total_bot})')
print(f'  Trial activation rate (given demo): {r2_bot:.2%} ({trial_bot}/{demo_bot})')
print(f'  Paid conversion rate (given trial): {r3_bot:.2%} ({paid_bot}/{trial_bot})')
print()
print(f'Human-first contacts: {total_human}')
print(f'  Demo booked rate: {r1_human:.2%} ({demo_human}/{total_human})')
print(f'  Trial activation rate (given demo): {r2_human:.2%} ({trial_human}/{demo_human})')
print(f'  Paid conversion rate (given trial): {r3_human:.2%} ({paid_human}/{trial_human})')

# Compute average stage durations using timestamps (only for those with ordering)
def avg_duration(sub):
    # demo to trial for those with trial after demo
    mask = sub['has_trial_after_demo']
    if mask.sum() > 0:
        days = (sub.loc[mask, 'trial_ts'] - sub.loc[mask, 'demo_ts']).dt.total_seconds() / (24*3600)
        avg1 = days.mean()
    else:
        avg1 = np.nan
    # trial to paid for those with paid after trial
    mask2 = sub['has_paid_after_trial']
    if mask2.sum() > 0:
        days2 = (sub.loc[mask2, 'paid_ts'] - sub.loc[mask2, 'trial_ts']).dt.total_seconds() / (24*3600)
        avg2 = days2.mean()
    else:
        avg2 = np.nan
    return avg1, avg2

avg_demo_trial_bot, avg_trial_paid_bot = avg_duration(bot)
avg_demo_trial_human, avg_trial_paid_human = avg_duration(human)

print('\n=== Average Stage Durations (days) with Ordering ===')
print(f'Bot-first: demo to trial: {avg_demo_trial_bot:.2f} days')
print(f'Bot-first: trial to paid: {avg_trial_paid_bot:.2f} days')
print(f'Human-first: demo to trial: {avg_demo_trial_human:.2f} days')
print(f'Human-first: trial to paid: {avg_trial_paid_human:.2f} days')

# Analyze by intent, segment, region, lifecycle
dimensions = ['intent', 'segment', 'region', 'lifecycle']
# Need to map contact to dimension based on first conversation? Use first conversation's dimension.
contact_dim = df.sort_values('conversation_created_at').groupby('contact_id').agg({
    'intent': 'first',
    'segment': 'first',
    'region': 'first',
    'lifecycle': 'first'
}).reset_index()
contact_stages = contact_stages.merge(contact_dim, on='contact_id', how='left')

for dim in dimensions:
    print(f'\n=== Analysis by {dim} (first conversation) ===')
    for val in contact_stages[dim].unique():
        if pd.isna(val) or val == '':
            continue
        sub = contact_stages[contact_stages[dim] == val]
        bot_sub = sub[sub['first_response_type'] == 'bot_first']
        human_sub = sub[sub['first_response_type'] == 'human_first']
        if len(bot_sub) == 0 and len(human_sub) == 0:
            continue
        t_b, d_b, tr_b, p_b, r1b, r2b, r3b = compute_rates(bot_sub)
        t_h, d_h, tr_h, p_h, r1h, r2h, r3h = compute_rates(human_sub)
        print(f'{dim}: {val}')
        print(f'  Bot: contacts={t_b}, demo={r1b:.2%}, trial={r2b:.2%}, paid={r3b:.2%}')
        print(f'  Human: contacts={t_h}, demo={r1h:.2%}, trial={r2h:.2%}, paid={r3h:.2%}')

conn.close()
print('\nComputation done.')
```
