import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import sqlite3
import matplotlib

# Set style
plt.style.use('seaborn-v0_8-darkgrid')
matplotlib.rcParams['font.family'] = 'sans-serif'

# Connect to database
conn = sqlite3.connect('dacomp-080.sqlite')

# Load contact data
query = """
SELECT 
    contact_id,
    total_count_surveys,
    total_count_completed_surveys,
    count_surveys_sent_email,
    count_surveys_sent_sms,
    count_surveys_opened_email,
    count_surveys_opened_sms,
    count_surveys_started_email,
    count_surveys_started_sms,
    count_surveys_completed_email,
    count_surveys_completed_sms,
    avg_survey_progress_pct,
    language,
    directory_name
FROM qualtrics__contact
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Calculate completion rate
df['completion_rate'] = df.apply(
    lambda row: row['total_count_completed_surveys'] / row['total_count_surveys'] 
    if row['total_count_surveys'] > 0 else 0, 
    axis=1
)

# Calculate cross-channel activity
def has_cross_channel_activity(row):
    # Check if user engaged via both email and SMS (sent, opened, started, or completed)
    email_engaged = (row['count_surveys_sent_email'] > 0 or 
                     row['count_surveys_opened_email'] > 0 or 
                     row['count_surveys_started_email'] > 0 or 
                     row['count_surveys_completed_email'] > 0)
    sms_engaged = (row['count_surveys_sent_sms'] > 0 or 
                   row['count_surveys_opened_sms'] > 0 or 
                   row['count_surveys_started_sms'] > 0 or 
                   row['count_surveys_completed_sms'] > 0)
    return 1.0 if (email_engaged and sms_engaged) else 0.0

df['cross_channel_score'] = df.apply(has_cross_channel_activity, axis=1)

# Normalize participation frequency (capped at 95th percentile, min-max scaled)
participation_95th = df['total_count_surveys'].quantile(0.95)
df['capped_participation'] = df['total_count_surveys'].clip(upper=participation_95th)
df['participation_score'] = (df['capped_participation'] - df['capped_participation'].min()) / \
                            (df['capped_participation'].max() - df['capped_participation'].min() + 1e-10)

# Normalize completion rate (already 0-1)
df['completion_score'] = df['completion_rate']

# Average progress score (already percentage, convert to 0-1)
df['progress_score'] = df['avg_survey_progress_pct'] / 100.0

# Calculate composite score (0-100)
weights = {
    'participation': 0.30,
    'completion': 0.30,
    'cross_channel': 0.20,
    'progress': 0.20
}

df['composite_score'] = (
    df['participation_score'] * weights['participation'] +
    df['completion_score'] * weights['completion'] +
    df['cross_channel_score'] * weights['cross_channel'] +
    df['progress_score'] * weights['progress']
) * 100

# Determine value tiers based on percentiles
low_threshold = df['composite_score'].quantile(0.33)
high_threshold = df['composite_score'].quantile(0.66)

def assign_tier(score):
    if score <= low_threshold:
        return 'Low-Value'
    elif score <= high_threshold:
        return 'Medium-Value'
    else:
        return 'High-Value'

df['value_tier'] = df['composite_score'].apply(assign_tier)

# Save computed data for later use
df.to_csv('user_scores.csv', index=False)

print(f"Total users: {len(df)}")
print(f"Low threshold (33rd percentile): {low_threshold:.2f}")
print(f"High threshold (66th percentile): {high_threshold:.2f}")
print(f"Tier distribution:")
print(df['value_tier'].value_counts(normalize=True).sort_index())
```
