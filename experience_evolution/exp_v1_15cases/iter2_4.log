import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-092.sqlite')

# High-volatility customer IDs
query = """
SELECT customer_id,
       AVG(customer_margin_volatility) as avg_margin_volatility
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql(query, conn)
threshold = df_cust_vol['avg_margin_volatility'].quantile(0.75)
high_vol_ids = df_cust_vol[df_cust_vol['avg_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers: {len(high_vol_ids)}")

# 1. Coefficient of variation (gross_profit) over past 12 months
max_date = pd.read_sql("SELECT MAX(transaction_date) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'][0]
max_date = pd.to_datetime(max_date)
cutoff_date = max_date - pd.DateOffset(months=12)

query = f"""
SELECT customer_id, gross_profit
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
  AND transaction_date >= ?
"""
params = high_vol_ids + [cutoff_date.strftime('%Y-%m-%d')]
df_recent = pd.read_sql(query, conn, params=params)
cv_df = df_recent.groupby('customer_id')['gross_profit'].apply(
    lambda x: x.std() / x.mean() if x.mean() != 0 else np.nan
).reset_index(name='cv_gross_profit')

# 2. Variance of quarter-over-quarter invoice_total growth rate
query_q = f"""
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as quarterly_invoice_total
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
"""
df_quarterly = pd.read_sql(query_q, conn, params=high_vol_ids)

def compute_growth_variance(df):
    if df.shape[0] < 2:
        return np.nan
    df = df.sort_values(['revenue_year', 'revenue_quarter'])
    df['prev_total'] = df['quarterly_invoice_total'].shift(1)
    df['growth_rate'] = (df['quarterly_invoice_total'] - df['prev_total']) / df['prev_total']
    growth_rates = df['growth_rate'].dropna()
    if len(growth_rates) == 0:
        return np.nan
    return growth_rates.var()

growth_var = df_quarterly.groupby('customer_id', group_keys=False).apply(compute_growth_variance).reset_index(name='var_qoq_growth')

# Merge
metrics = pd.merge(cv_df, growth_var, on='customer_id', how='outer')

# 3. Behavioral features from customer_analytics
query_behav = f"""
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
       lifecycle_stage, credit_grade, risk_assessment
FROM quickbooks__customer_analytics
WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
"""
df_behav = pd.read_sql(query_behav, conn, params=high_vol_ids)

# Merge everything
df_risk = pd.merge(metrics, df_behav, on='customer_id', how='left')

# Map categorical to numeric scores
# RFM segment risk mapping (higher score = higher risk)
rfm_risk_map = {
    'Need Attention': 3,
    'At Risk': 3,
    'Potential Loyalists': 1,
    'Loyal Customers': 1,
    'New Customers': 2,
    'Champions': 0,
}
# Payment behavior risk mapping
pay_risk_map = {
    'Poor': 3,
    'Average': 2,
    'Good': 1,
    'Excellent': 0
}
# Lifecycle stage risk mapping
lifecycle_risk_map = {
    'New Customer': 2,
    'Growing': 1,
    'Mature': 0,
    'Loyal Customer': 0
}

df_risk['rfm_risk'] = df_risk['rfm_segment'].map(rfm_risk_map)
df_risk['pay_risk'] = df_risk['payment_behavior'].map(pay_risk_map)
df_risk['lifecycle_risk'] = df_risk['lifecycle_stage'].map(lifecycle_risk_map)

# Revenue trend correlation: negative correlation indicates higher risk
def trend_risk(x):
    if pd.isna(x):
        return 1  # neutral
    if x < -0.5:
        return 3
    elif x < 0:
        return 2
    elif x < 0.5:
        return 1
    else:
        return 0

df_risk['trend_risk'] = df_risk['revenue_trend_correlation'].apply(trend_risk)

# Standardize volatility metrics (higher = higher risk)
# Use quartile ranking: 0-3 scores based on quartiles
def quartile_score(series):
    # Handle NaNs by filling with median
    series = series.fillna(series.median())
    if series.nunique() < 4:
        # if not enough unique values, assign equal categories
        return pd.qcut(series, q=min(len(series), 4), labels=False, duplicates='drop')
    else:
        return pd.qcut(series, q=4, labels=[0,1,2,3], duplicates='drop')

df_risk['cv_risk'] = quartile_score(df_risk['cv_gross_profit'])
df_risk['growth_var_risk'] = quartile_score(df_risk['var_qoq_growth'])

# Compute overall risk score (weighted sum, equal weights for simplicity)
weights = {
    'cv_risk': 0.2,
    'growth_var_risk': 0.2,
    'rfm_risk': 0.2,
    'pay_risk': 0.2,
    'lifecycle_risk': 0.1,
    'trend_risk': 0.1
}
for col, w in weights.items():
    df_risk[col] = df_risk[col].fillna(df_risk[col].median())

df_risk['overall_risk_score'] = (df_risk['cv_risk'] * weights['cv_risk'] +
                                  df_risk['growth_var_risk'] * weights['growth_var_risk'] +
                                  df_risk['rfm_risk'] * weights['rfm_risk'] +
                                  df_risk['pay_risk'] * weights['pay_risk'] +
                                  df_risk['lifecycle_risk'] * weights['lifecycle_risk'] +
                                  df_risk['trend_risk'] * weights['trend_risk'])

# Risk tiers
def risk_tier(score):
    if score >= 2.0:
        return 'High'
    elif score >= 1.0:
        return 'Medium'
    else:
        return 'Low'

df_risk['risk_tier'] = df_risk['overall_risk_score'].apply(risk_tier)

print("Risk score distribution:")
print(df_risk['risk_tier'].value_counts())
print(df_risk[['overall_risk_score', 'risk_tier']].describe())

# Top 5 high-risk customers
top_high = df_risk.sort_values('overall_risk_score', ascending=False).head(5)
print("\nTop 5 high-risk customers:")
print(top_high[['customer_id', 'overall_risk_score', 'rfm_segment', 'payment_behavior', 'lifecycle_stage', 'revenue_trend_correlation', 'cv_gross_profit', 'var_qoq_growth']])
```
