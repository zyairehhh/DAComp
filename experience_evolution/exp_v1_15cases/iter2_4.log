import sqlite3
import pandas as pd
import numpy as np

# Connect to DB
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter2/dacomp-060/stage1_env/dacomp-060.sqlite')

# Aggregate at ad group level
query = """
SELECT 
    ad_group_id,
    ad_group_name,
    campaign_name,
    account_name,
    ad_group_type,
    status,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions,
    SUM(spend) AS total_spend,
    SUM(conversions_value) AS total_conversions_value
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name, campaign_name, account_name, ad_group_type, status
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Compute metrics
df['CTR'] = df['total_clicks'] / df['total_impressions']
df['CVR'] = df['total_conversions'] / df['total_clicks'].replace(0, np.nan)  # avoid division by zero
# For ad groups with zero clicks, set CVR to NaN
df.loc[df['total_clicks'] == 0, 'CVR'] = np.nan

# Compute percentiles across all ad groups (excluding NaN CVR)
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# Filter problematic ad groups: CTR > 75th percentile AND CVR < 25th percentile
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
print(f"Number of problematic ad groups: {len(problematic)}")

# Compute Expected CVR (overall average CVR weighted by clicks)
total_conversions = df['total_conversions'].sum()
total_clicks = df['total_clicks'].sum()
expected_cvr = total_conversions / total_clicks if total_clicks > 0 else 0
print(f"Expected CVR (weighted average across all ad groups): {expected_cvr:.4f}")

# For each problematic ad group, compute Intent Match Ratio = Actual CVR / Expected CVR
problematic['Intent_Match_Ratio'] = problematic['CVR'] / expected_cvr

# Analyze common characteristics: ad_group_type, status, campaign_name patterns, etc.
print("\n=== Problematic Ad Groups Characteristics ===")
print("Ad Group Type distribution:")
print(problematic['ad_group_type'].value_counts(dropna=False))
print("\nStatus distribution:")
print(problematic['status'].value_counts(dropna=False))
print("\nTop Campaigns (by count):")
print(problematic['campaign_name'].value_counts().head(10))
print("\nTop Accounts (by count):")
print(problematic['account_name'].value_counts().head(10))

# Compute average metrics for problematic vs overall
print("\n=== Metrics Comparison ===")
print("Overall averages:")
print(df[['total_clicks','total_impressions','total_conversions','CTR','CVR']].mean())
print("\nProblematic averages:")
print(problematic[['total_clicks','total_impressions','total_conversions','CTR','CVR','Intent_Match_Ratio']].mean())

# Save problematic ad groups to CSV for further inspection
problematic.to_csv('/workspace/problematic_ad_groups.csv', index=False)
print(f"\nProblematic ad groups saved to /workspace/problematic_ad_groups.csv")

# Additional: Examine keyword match types from keyword report
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter2/dacomp-060/stage1_env/dacomp-060.sqlite')
keyword_query = """
SELECT 
    ad_group_id,
    keyword_match_type,
    SUM(clicks) AS clicks,
    SUM(impressions) AS impressions,
    SUM(conversions) AS conversions
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
keyword_df = pd.read_sql_query(keyword_query, conn)
conn.close()

# Merge with problematic ad groups
problematic_keywords = keyword_df[keyword_df['ad_group_id'].isin(problematic['ad_group_id'])]
print("\n=== Keyword Match Type Distribution for Problematic Ad Groups ===")
if not problematic_keywords.empty:
    print(problematic_keywords.groupby('keyword_match_type').agg({'clicks':'sum','impressions':'sum','conversions':'sum'}).reset_index())
else:
    print("No keyword data for problematic ad groups.")

# Traffic quality: maybe look at search term report? But we have only ad group level.
# Compute cost per conversion, conversion value per cost, etc.
problematic['CPC'] = problematic['total_spend'] / problematic['total_clicks']
problematic['CPA'] = problematic['total_spend'] / problematic['total_conversions'].replace(0, np.nan)
problematic['ROAS'] = problematic['total_conversions_value'] / problematic['total_spend'].replace(0, np.nan)
print("\nProblematic ad groups average CPC, CPA, ROAS:")
print(problematic[['CPC','CPA','ROAS']].mean())

# Write summary to a markdown file
with open('/workspace/stage1.md', 'w') as f:
    f.write("# Stage 1 Analysis: High-CTR Low-CVR Ad Groups\n")
    f.write(f"- **75th percentile CTR**: {ctr_75:.4f}\n")
    f.write(f"- **25th percentile CVR**: {cvr_25:.4f}\n")
    f.write(f"- **Number of problematic ad groups**: {len(problematic)}\n")
    f.write(f"- **Expected CVR (weighted average)**: {expected_cvr:.4f}\n")
    f.write("\n## Characteristics of Problematic Ad Groups\n")
    f.write("### Ad Group Type Distribution\n")
    f.write(problematic['ad_group_type'].value_counts(dropna=False).to_string() + "\n")
    f.write("\n### Status Distribution\n")
    f.write(problematic['status'].value_counts(dropna=False).to_string() + "\n")
    f.write("\n### Top Campaigns (by count)\n")
    f.write(problematic['campaign_name'].value_counts().head(10).to_string() + "\n")
    f.write("\n### Average Metrics (Problematic vs Overall)\n")
    f.write("| Metric | Overall | Problematic |\n")
    f.write("|--------|---------|-------------|\n")
    f.write(f"| CTR | {df['CTR'].mean():.4f} | {problematic['CTR'].mean():.4f} |\n")
    f.write(f"| CVR | {df['CVR'].mean():.4f} | {problematic['CVR'].mean():.4f} |\n")
    f.write(f"| Intent Match Ratio | - | {problematic['Intent_Match_Ratio'].mean():.4f} |\n")
    f.write(f"| CPC | {df['total_spend'].sum()/df['total_clicks'].sum():.4f} | {problematic['CPC'].mean():.4f} |\n")
    f.write(f"| CPA | {df['total_spend'].sum()/df['total_conversions'].sum():.4f} | {problematic['CPA'].mean():.4f} |\n")
    f.write(f"| ROAS | {df['total_conversions_value'].sum()/df['total_spend'].sum():.4f} | {problematic['ROAS'].mean():.4f} |\n")
    f.write("\n## Recommendations\n")
    f.write("1. **Keyword Strategy**: Review keyword match types for problematic ad groups; consider shifting from broad to exact match.\n")
    f.write("2. **Audience Targeting**: Evaluate audience segments; high CTR but low conversion may indicate mismatched intent.\n")
    f.write("3. **Landing Page Experience**: Ensure landing pages align with ad messaging to improve conversion.\n")
    f.write("4. **Ad Copy & Creative**: Test new ad creatives that better qualify traffic.\n")
    f.write("5. **Bid Adjustments**: Lower bids for high-click, low-converting keywords.\n")

print("\nAnalysis completed. Stage 1 report written to /workspace/stage1.md")
