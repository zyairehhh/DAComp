    SELECT date_day, region, store_listing_conversion_rate, 
           active_devices_last_30_days, average_rating, rolling_total_average_rating,
           store_listing_acquisitions, store_listing_visitors,
           update_events, package_name
    FROM google_play__country_report
""", conn)
region_df['date_day'] = pd.to_datetime(region_df['date_day'])
region_df['month'] = region_df['date_day'].dt.to_period('M')
print("Region data shape:", region_df.shape)
