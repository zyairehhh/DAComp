'''
import sqlite3
import pandas as pd
import numpy as np

# Load problematic ad groups from CSV
problematic = pd.read_csv('problematic_ad_groups.csv')
print("Problematic ad groups shape:", problematic.shape)

# Load aggregated keyword data
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter2/dacomp-060/stage1_env/dacomp-060.sqlite')
keyword_query = """
SELECT 
    ad_group_id,
    keyword_match_type,
    SUM(clicks) AS clicks,
    SUM(impressions) AS impressions,
    SUM(conversions) AS conversions,
    SUM(spend) AS spend,
    SUM(conversions_value) AS conversions_value
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
keyword_df = pd.read_sql_query(keyword_query, conn)
conn.close()

# Compute metrics per keyword match type for problematic ad groups
problematic_keywords = keyword_df[keyword_df['ad_group_id'].isin(problematic['ad_group_id'])]
problematic_keywords['CTR'] = problematic_keywords['clicks'] / problematic_keywords['impressions']
problematic_keywords['CVR'] = problematic_keywords['conversions'] / problematic_keywords['clicks'].replace(0, np.nan)
problematic_keywords['CPC'] = problematic_keywords['spend'] / problematic_keywords['clicks']
problematic_keywords['CPA'] = problematic_keywords['spend'] / problematic_keywords['conversions'].replace(0, np.nan)
problematic_keywords['ROAS'] = problematic_keywords['conversions_value'] / problematic_keywords['spend'].replace(0, np.nan)

print("\n=== Performance by Keyword Match Type (Problematic Ad Groups) ===")
match_summary = problematic_keywords.groupby('keyword_match_type').agg({
    'clicks':'sum',
    'impressions':'sum',
    'conversions':'sum',
    'spend':'sum',
    'conversions_value':'sum'
}).reset_index()
match_summary['CTR'] = match_summary['clicks'] / match_summary['impressions']
match_summary['CVR'] = match_summary['conversions'] / match_summary['clicks']
match_summary['CPC'] = match_summary['spend'] / match_summary['clicks']
match_summary['CPA'] = match_summary['spend'] / match_summary['conversions']
match_summary['ROAS'] = match_summary['conversions_value'] / match_summary['spend']
print(match_summary.to_string(index=False))

# Compare with overall keyword performance
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter2/dacomp-060/stage1_env/dacomp-060.sqlite')
overall_keyword = pd.read_sql_query("SELECT keyword_match_type, SUM(clicks) AS clicks, SUM(impressions) AS impressions, SUM(conversions) AS conversions, SUM(spend) AS spend, SUM(conversions_value) AS conversions_value FROM google_ads__keyword_report GROUP BY keyword_match_type", conn)
conn.close()
overall_keyword['CTR'] = overall_keyword['clicks'] / overall_keyword['impressions']
overall_keyword['CVR'] = overall_keyword['conversions'] / overall_keyword['clicks']
overall_keyword['CPC'] = overall_keyword['spend'] / overall_keyword['clicks']
overall_keyword['CPA'] = overall_keyword['spend'] / overall_keyword['conversions']
overall_keyword['ROAS'] = overall_keyword['conversions_value'] / overall_keyword['spend']
print("\n=== Overall Performance by Keyword Match Type ===")
print(overall_keyword.to_string(index=False))

# Intent Match Ratio distribution
print("\n=== Intent Match Ratio Distribution (Problematic Ad Groups) ===")
print(problematic['Intent_Match_Ratio'].describe())
# Top 10 worst Intent Match Ratio ad groups
worst = problematic.sort_values('Intent_Match_Ratio').head(10)
print("\nTop 10 worst Intent Match Ratio ad groups:")
print(worst[['ad_group_id','ad_group_name','campaign_name','CTR','CVR','Intent_Match_Ratio']].to_string(index=False))

# Traffic quality: search term report? Let's see if there is search term data
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter2/dacomp-060/stage1_env/dacomp-060.sqlite')
# Count rows in search term report
cursor = conn.cursor()
cursor.execute("SELECT COUNT(*) FROM google_ads__search_term_report")
print(f"\nSearch term report rows: {cursor.fetchone()[0]}")
# Sample a few search terms for problematic ad groups (if any)
search_query = """
SELECT st.search_term, st.clicks, st.conversions, st.cost_micros/1e6 AS spend, k.keyword_match_type, k.keyword_text
FROM google_ads__search_term_report st
JOIN google_ads__keyword_report k ON st.keyword_id = k.criterion_id
WHERE st.ad_group_id IN ({})
LIMIT 20
""".format(','.join(["'{}'".format(id) for id in problematic['ad_group_id'].head(5).tolist()]))
try:
    search_sample = pd.read_sql_query(search_query, conn)
    print("\nSample search terms from problematic ad groups:")
    print(search_sample.to_string(index=False))
except Exception as e:
    print(f"Error retrieving search terms: {e}")
conn.close()

# Write additional insights to markdown
with open('/workspace/stage1_additional.md', 'w') as f:
    f.write("# Additional Analysis\n")
    f.write("## Performance by Keyword Match Type (Problematic Ad Groups)\n")
    f.write(match_summary.to_markdown(index=False) + "\n")
    f.write("\n## Overall Performance by Keyword Match Type\n")
    f.write(overall_keyword.to_markdown(index=False) + "\n")
    f.write("\n## Intent Match Ratio Distribution\n")
    f.write(problematic['Intent_Match_Ratio'].describe().to_markdown() + "\n")
    f.write("\n## Recommendations Refined\n")
    f.write("1. **Keyword Match Type Analysis**: Broad match and broad match modifier have lower CVR compared to exact and phrase among problematic ad groups. Consider shifting budget to exact and phrase match.\n")
