import pandas as pd
import sqlite3

# Load filtered campaigns
df_filtered = pd.read_csv('filtered_campaigns.csv')
# Create year_quarter column: map year_month to quarter (e.g., 2023-03 -> 2023-Q1)
def month_to_quarter(ym):
    year, month = ym.split('-')
    month = int(month)
    quarter = (month - 1) // 3 + 1
    return f"{year}-Q{quarter}"
df_filtered['year_quarter'] = df_filtered['year_month'].apply(month_to_quarter)

# Load keyword report
conn = sqlite3.connect('dacomp-058.sqlite')
df_keyword = pd.read_sql_query("SELECT year_quarter, campaign_id, avg_position, impression_share, quality_score, ctr, conversion_rate FROM google_ads__keyword_report", conn)
conn.close()

# Merge with filtered campaigns
df_keyword_filtered = pd.merge(df_keyword, df_filtered[['campaign_id', 'year_quarter']], on=['campaign_id', 'year_quarter'], how='inner')
print(f"Keyword rows matched: {df_keyword_filtered.shape[0]}")

# Compute average metrics per campaign per quarter
keyword_agg = df_keyword_filtered.groupby(['campaign_id', 'year_quarter']).agg({
    'avg_position': 'mean',
    'impression_share': 'mean',
    'quality_score': 'mean',
    'ctr': 'mean',
    'conversion_rate': 'mean'
}).reset_index()
print(keyword_agg.head())

# Merge back with filtered campaigns to add avg_position to health data
df_filtered_w_pos = pd.merge(df_filtered, keyword_agg, on=['campaign_id', 'year_quarter'], how='left')
df_filtered_w_pos['avg_position'].fillna(0, inplace=True)
df_filtered_w_pos.to_csv('filtered_with_position.csv', index=False)
print("Saved filtered_with_position.csv")
''')
