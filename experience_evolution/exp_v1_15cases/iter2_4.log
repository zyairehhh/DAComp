import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')

# Load problematic ad groups
problematic = pd.read_csv('problematic_with_ratio.csv')
problematic_ids = problematic['ad_group_id'].tolist()

# Get all ad groups metrics from earlier CSV
all_metrics = pd.read_csv('ad_group_metrics.csv')

# Mark problematic
all_metrics['is_problematic'] = all_metrics['ad_group_id'].isin(problematic_ids)

# Compute summary statistics
summary = all_metrics.groupby('is_problematic').agg({
    'total_clicks': 'sum',
    'total_impressions': 'sum',
    'total_conversions': 'sum',
    'ctr': 'mean',
    'cvr': 'mean'
}).reset_index()
print('Summary:')
print(summary)

# Compute spend and conversion value for problematic vs all
query = """
SELECT ad_group_id,
       SUM(spend) as total_spend,
       SUM(conversions_value) as total_conversion_value
FROM google_ads__ad_group_report
GROUP BY ad_group_id
"""
spend_df = pd.read_sql_query(query, conn)
spend_df['is_problematic'] = spend_df['ad_group_id'].isin(problematic_ids)
spend_summary = spend_df.groupby('is_problematic').agg({
    'total_spend': 'sum',
    'total_conversion_value': 'sum',
    'ad_group_id': 'count'
}).rename(columns={'ad_group_id': 'num_ad_groups'}).reset_index()
spend_summary['avg_spend_per_group'] = spend_summary['total_spend'] / spend_summary['num_ad_groups']
spend_summary['avg_conversion_value_per_group'] = spend_summary['total_conversion_value'] / spend_summary['num_ad_groups']
print('Spend summary:')
print(spend_summary)

# Compute ROI: conversion value / spend
spend_summary['roi'] = spend_summary['total_conversion_value'] / spend_summary['total_spend']
print('ROI:')
print(spend_summary[['is_problematic', 'roi']])

# Analyze match type distribution across all ad groups
# Get keyword match type distribution for problematic vs non-problematic
keyword_query = """
SELECT k.ad_group_id, k.keyword_match_type,
       SUM(k.clicks) as clicks, SUM(k.impressions) as impressions,
       SUM(k.conversions) as conversions
FROM google_ads__keyword_report k
GROUP BY k.ad_group_id, k.keyword_match_type
"""
keyword_all = pd.read_sql_query(keyword_query, conn)
keyword_all['is_problematic'] = keyword_all['ad_group_id'].isin(problematic_ids)
match_type_dist = keyword_all.groupby(['is_problematic', 'keyword_match_type']).agg({
    'clicks': 'sum',
    'impressions': 'sum',
    'conversions': 'sum'
}).reset_index()
match_type_dist['ctr'] = match_type_dist['clicks'] / match_type_dist['impressions']
match_type_dist['cvr'] = match_type_dist['conversions'] / match_type_dist['clicks']
print('Match type distribution:')
print(match_type_dist)

# Compute proportion of clicks by match type
total_clicks_by_group = match_type_dist.groupby('is_problematic')['clicks'].transform('sum')
match_type_dist['prop_clicks'] = match_type_dist['clicks'] / total_clicks_by_group
print('Proportion of clicks:')
print(match_type_dist[['is_problematic', 'keyword_match_type', 'prop_clicks', 'cvr']])
```
