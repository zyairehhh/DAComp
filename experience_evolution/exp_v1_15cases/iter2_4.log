import pandas as pd
import numpy as np
import sqlite3
from scipy.optimize import linprog
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-067.sqlite')

# Source data from talent_pipeline aggregated
df_source = pd.read_sql_query("""
SELECT source_type, SUM(total_hires) AS total_hires
FROM greenhouse__talent_pipeline_simplified
GROUP BY source_type
""", conn)

# Costs per hire (estimated)
costs = {
    'agency': 20000,
    'direct': 200,
    'job_board': 1000,
    'referral': 5000,
    'social_media': 500,
    'university': 8000
}
# diversity and rating per source (computed from previously)
# We need female_rep and non_white_rep per source, average rating.

# Let's compute diversity from application_enhanced with source mapping.
df_diversity = pd.read_sql_query("""
SELECT a.source_id, a.candidate_gender, a.candidate_race, a.status
FROM greenhouse__application_enhanced a
WHERE a.candidate_gender IS NOT NULL AND a.candidate_race IS NOT NULL
""", conn)

# source mapping
df_map = pd.read_sql_query("SELECT source_id, source_type FROM greenhouse__talent_pipeline_simplified", conn)
df_diversity = df_diversity.merge(df_map, on='source_id', how='inner')
df_diversity['female'] = df_diversity['candidate_gender'] == 'Female'
df_diversity['non_white'] = df_diversity['candidate_race'] != 'White'
df_diversity['hired'] = df_diversity['status'] == 'hired'

# Compute per source type
grouped = df_diversity.groupby('source_type').agg(
    total_hires_with_data=('hired', 'sum'),
    female_hires=('female', lambda x: (x & df_diversity['hired']).sum()),
    non_white_hires=('non_white', lambda x: (x & df_diversity['hired']).sum())
).reset_index()
grouped['female_rep'] = grouped['female_hires'] / grouped['total_hires_with_data']
grouped['non_white_rep'] = grouped['non_white_hires'] / grouped['total_hires_with_data']

# Interviewer rating per source
df_rating = pd.read_sql_query("""
SELECT a.source_id, d.rating
FROM greenhouse__interview_scorecard_detail d
JOIN greenhouse__application_enhanced a ON d.application_id = a.application_id
WHERE d.rating IS NOT NULL
""", conn)
df_rating = df_rating.merge(df_map, on='source_id', how='inner')
rating_group = df_rating.groupby('source_type')['rating'].mean()

# Merge into df_source
for col in ['female_rep', 'non_white_rep']:
    df_source = df_source.merge(grouped[['source_type', col]], on='source_type', how='left')
df_source = df_source.merge(rating_group.to_frame('avg_rating'), on='source_type', how='left')

# Fill missing values with average across all sources
avg_female = df_source['female_rep'].mean()
avg_nonwhite = df_source['non_white_rep'].mean()
avg_rating = df_source['avg_rating'].mean()
df_source['female_rep'].fillna(avg_female, inplace=True)
df_source['non_white_rep'].fillna(avg_nonwhite, inplace=True)
df_source['avg_rating'].fillna(avg_rating, inplace=True)

print("Source metrics:")
print(df_source.to_string())

# Optimization
# Let x_i be number of hires from source i (six sources)
source_types = ['agency', 'direct', 'job_board', 'referral', 'social_media', 'university']
n = len(source_types)
# Objective: minimize cost
c = [costs[st] for st in source_types]

# Constraints:
# 1. total hires = current total (3309)
total_hires_target = df_source['total_hires'].sum()
# 2. female representation >= 0.4
female_reps = [df_source.loc[df_source['source_type']==st, 'female_rep'].values[0] for st in source_types]
# 3. non-white representation >= 0.3
nonwhite_reps = [df_source.loc[df_source['source_type']==st, 'non_white_rep'].values[0] for st in source_types]
# 4. interviewer satisfaction >= 4.0 (average weighted by hires)
# We'll treat as constraint: sum(x_i * (avg_rating_i - 4.0)) >= 0
rating_vals = [df_source.loc[df_source['source_type']==st, 'avg_rating'].values[0] for st in source_types]

# Bounds: hires >= 0
bounds = [(0, None) for _ in range(n)]

# Equality constraint: sum(x) = total_hires_target
A_eq = [[1]*n]
b_eq = [total_hires_target]

# Inequality constraints: female representation
# (sum female_hires) >= 0.4 * total_hires
# sum(x_i * female_rep_i) >= 0.4 * total_hires
A_female = [[-fr for fr in female_reps]]
b_female = [-0.4 * total_hires_target]
# Non-white representation
A_nonwhite = [[-nwr for nwr in nonwhite_reps]]
b_nonwhite = [-0.3 * total_hires_target]
# Satisfaction constraint: weighted average rating >= 4.0
# sum(x_i * rating_i) >= 4.0 * total_hires
A_satisfaction = [[-rv for rv in rating_vals]]
b_satisfaction = [-4.0 * total_hires_target]

A_ub = A_female + A_nonwhite + A_satisfaction
b_ub = b_female + b_nonwhite + b_satisfaction

print("\nOptimizing...")
result = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
if result.success:
    hires_opt = result.x
    print("Optimal hires per source:")
    for i, st in enumerate(source_types):
        print(f"  {st}: {hires_opt[i]:.0f}")
    total_cost = sum(hires_opt[i] * c[i] for i in range(n))
    print(f"Total cost: ${total_cost:,.2f}")
    # Compute metrics
    female_hires = sum(hires_opt[i] * female_reps[i] for i in range(n))
    nonwhite_hires = sum(hires_opt[i] * nonwhite_reps[i] for i in range(n))
    avg_rating_weighted = sum(hires_opt[i] * rating_vals[i] for i in range(n)) / total_hires_target
    print(f"Female hire representation: {female_hires/total_hires_target:.1%}")
    print(f"Non-white hire representation: {nonwhite_hires/total_hires_target:.1%}")
    print(f"Weighted average interviewer rating: {avg_rating_weighted:.2f}")
else:
    print("Optimization failed:", result.message)
    # Fallback: use current allocation
    print("Current allocation:")
    for st in source_types:
        hires = df_source.loc[df_source['source_type']==st, 'total_hires'].values[0] if st in df_source['source_type'].values else 0
        print(f"  {st}: {hires}")
```

