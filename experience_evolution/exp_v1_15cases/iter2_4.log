import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')

# Load all relevant data
visitor_df = pd.read_sql_query('''
SELECT 
    visitor_id,
    account_id,
    latest_nps_rating,
    count_active_days,
    count_active_months,
    sum_minutes,
    sum_events,
    average_daily_minutes,
    average_daily_events,
    last_browser_name,
    last_operating_system,
    last_server_name,
    CAST(strftime('%s', last_visit) - strftime('%s', first_visit_at) AS REAL) / (3600*24) as tenure_days
FROM pendo__visitor
''', conn)

daily_agg = pd.read_sql_query('''
SELECT 
    visitor_id,
    SUM(count_pages_viewed) as total_pages_viewed,
    SUM(count_features_clicked) as total_features_clicked,
    AVG(sum_minutes) as avg_daily_minutes,
    COUNT(DISTINCT date_day) as active_days
FROM pendo__visitor_daily_metrics
GROUP BY visitor_id
''', conn)

feature_engagement = pd.read_sql_query('''
SELECT 
    visitor_id,
    COUNT(DISTINCT feature_id) as distinct_features_used,
    SUM(sum_clicks) as total_feature_clicks,
    AVG(sum_minutes) as avg_minutes_per_feature
FROM pendo__visitor_feature
GROUP BY visitor_id
''', conn)

df = visitor_df.merge(daily_agg, on='visitor_id', how='left')
df = df.merge(feature_engagement, on='visitor_id', how='left')
df.fillna(0, inplace=True)

# Define high-value customers (ground truth approximation)
# We'll use a composite of multiple business-relevant metrics:
# 1. High engagement (top 20% by sum_minutes)
# 2. High loyalty (top 20% by count_active_days)
# 3. High satisfaction (NPS >= 8)
# At least 2 out of 3 criteria
df['high_engagement'] = (df['sum_minutes'] >= df['sum_minutes'].quantile(0.8)).astype(int)
df['high_loyalty'] = (df['count_active_days'] >= df['count_active_days'].quantile(0.8)).astype(int)
df['high_satisfaction'] = (df['latest_nps_rating'] >= 8).astype(int)
df['high_value'] = ((df['high_engagement'] + df['high_loyalty'] + df['high_satisfaction']) >= 2).astype(int)

print("High-value customer definition (2 out of 3: engagement, loyalty, satisfaction):")
print(f"  Count: {df['high_value'].sum()} out of {len(df)} ({df['high_value'].mean():.1%})")

# Current model based only on usage duration and frequency
df['current_model'] = ((df['sum_minutes'] > df['sum_minutes'].median()) & 
                       (df['sum_events'] > df['sum_events'].median())).astype(int)
current_accuracy = (df['current_model'] == df['high_value']).mean()
print(f"\\nCurrent model accuracy: {current_accuracy:.2%}")

# Evaluate additional dimensions
