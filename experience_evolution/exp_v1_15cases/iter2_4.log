high_rev = pivot[high_market_names].sum(axis=1)
low_rev = pivot[low_market_names].sum(axis=1)

plt.figure(figsize=(12,6))
plt.plot(high_rev.index, high_rev.values, label='High ARPU Markets (> $7)', linewidth=2)
plt.plot(low_rev.index, low_rev.values, label='Low ARPU Markets (≤ $7)', linewidth=2)
plt.title('Daily Net Revenue: High‑ARPU vs Low‑ARPU Markets')
plt.xlabel('Date')
plt.ylabel('Total Net Revenue ($)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('revenue_divergence.png')
plt.close()

# 3. Market score comparison across revenue groups
df_group = pd.read_sql_query("""
    SELECT 
        CASE WHEN average_revenue_per_user > 7 THEN 'High (>$7)'
             ELSE 'Low (<=$7)' END as rev_group,
        overall_market_score,
        day_1_retention_rate,
        day_30_retention_rate,
        daily_churn_rate
    FROM google_play__geo_market_analysis
    WHERE package_name='com.dev.photoeditor'
""", conn)
group_means = df_group.groupby('rev_group').mean().reset_index()
group_means.plot.bar(x='rev_group', y=['overall_market_score','day_1_retention_rate','day_30_retention_rate','daily_churn_rate'],
                     figsize=(10,6), colormap='viridis')
plt.title('Performance Metrics by Revenue Group (ARPU >$7 vs ≤$7)')
plt.xlabel('Revenue Group')
plt.ylabel('Score / Rate')
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig('group_comparison.png')
plt.close()

# 4. Bar chart of ARPU by region with error bars (std)
df_region_arpu = pd.read_sql_query("""
    SELECT region, AVG(average_revenue_per_user) as avg_arpu,
           MIN(average_revenue_per_user) as min_arpu,
           MAX(average_revenue_per_user) as max_arpu
    FROM google_play__geo_market_analysis
    WHERE package_name='com.dev.photoeditor'
    GROUP BY region
""", conn)
x = np.arange(len(df_region_arpu))
plt.figure(figsize=(10,6))
bars = plt.bar(x, df_region_arpu['avg_arpu'], yerr=[df_region_arpu['avg_arpu']-df_region_arpu['min_arpu'],
                                            df_region_arpu['max_arpu']-df_region_arpu['avg_arpu']],
        capsize=5, color='teal', alpha=0.7)
plt.xticks(x, df_region_arpu['region'])
plt.axhline(y=7, color='red', linestyle='--', label='$7 ARPU threshold')
plt.axhline(y=3, color='orange', linestyle='--', label='$3 ARPU threshold')
plt.title('Average Revenue Per User by Region (with range)')
plt.xlabel('Region')
plt.ylabel('ARPU ($)')
plt.legend()
plt.tight_layout()
plt.savefig('regional_arpu_range.png')
plt.close()

conn.close()
print("Additional plots created.")
```
