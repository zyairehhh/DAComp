# Campaigns with low health score (critical/high)
low_health = df_health[df_health['health_score'] < 50]
low_health_count = low_health.shape[0]

# Top high-risk campaigns (by cost)
top_high_risk = high_risk.sort_values('cost', ascending=False).head(10)

# Dimensional insights
worst_campaign_type = dim_campaign.loc[dim_campaign['health_score'].idxmin()]
best_campaign_type = dim_campaign.loc[dim_campaign['health_score'].idxmax()]
worst_bidding = dim_bidding.loc[dim_bidding['health_score'].idxmin()]
best_bidding = dim_bidding.loc[dim_bidding['health_score'].idxmax()]
worst_industry = dim_industry.loc[dim_industry['health_score'].idxmin()]
best_industry = dim_industry.loc[dim_industry['health_score'].idxmax()]

# Geo insights
