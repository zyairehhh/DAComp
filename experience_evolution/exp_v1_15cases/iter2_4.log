soe = df_salary[df_salary['Company Type'].str.contains('国企', na=False)]
if len(soe) >= 100:
    categories.append('State-owned enterprises')
    means.append(soe['salary_lower'].mean())
    counts.append(len(soe))

premium_df = pd.DataFrame({'Category': categories, 'Mean Salary': means, 'Count': counts})
premium_df['Diff from Overall Mean'] = premium_df['Mean Salary'] - overall_mean

plt.figure(figsize=(12,6))
bars = plt.bar(premium_df['Category'], premium_df['Diff from Overall Mean'], color=['green' if x>0 else 'red' for x in premium_df['Diff from Overall Mean']])
plt.ylabel('Salary Difference from Overall Mean (RMB)')
plt.title('Salary Premium/Penalty for Selected Categories')
plt.axhline(y=0, color='black', linestyle='-', linewidth=0.8)
plt.xticks(rotation=30, ha='right')
for bar, diff in zip(bars, premium_df['Diff from Overall Mean']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + (20 if diff>0 else -30), f'{diff:+.0f}', ha='center', va='bottom' if diff>0 else 'top')
plt.tight_layout()
plt.savefig('/workspace/salary_premiums.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plots generated.")
''')
