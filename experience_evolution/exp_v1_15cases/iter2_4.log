import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

print("Total rows:", len(df))
completed = df[df['Booking Status'] == 'Completed']
print("Completed rides:", len(completed))
completed = completed.dropna(subset=['Booking Value', 'Ride Distance'])
completed['Booking Value'] = pd.to_numeric(completed['Booking Value'], errors='coerce')
completed['Ride Distance'] = pd.to_numeric(completed['Ride Distance'], errors='coerce')
completed = completed[(completed['Booking Value'] > 0) & (completed['Ride Distance'] > 0)]
completed['fare_per_km'] = completed['Booking Value'] / completed['Ride Distance']

print("Completed with valid fare:", len(completed))

# Vehicle type stats
vehicle_stats = completed.groupby('Vehicle Type').agg(
    avg_fare_per_km=('fare_per_km', 'mean'),
    median_fare_per_km=('fare_per_km', 'median'),
    total_rides=('Booking ID', 'count'),
    avg_distance=('Ride Distance', 'mean'),
    avg_booking_value=('Booking Value', 'mean')
).round(2).sort_values('avg_fare_per_km', ascending=False)
print("\\nVehicle Type performance (sorted by avg fare per km):")
print(vehicle_stats.to_string())

# Driver rating stats
completed['Driver Ratings'] = pd.to_numeric(completed['Driver Ratings'], errors='coerce')
completed = completed.dropna(subset=['Driver Ratings'])
print("\\nDriver Ratings distribution:")
print(completed['Driver Ratings'].describe())
rating_fare = completed.groupby(pd.cut(completed['Driver Ratings'], bins=[0,1,2,3,4,5]))['fare_per_km'].mean()
print("\\nFare per km by rating group:")
print(rating_fare)
''')
