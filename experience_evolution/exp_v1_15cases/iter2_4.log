import pandas as pd
import matplotlib.pyplot as plt
import sqlite3
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-067.sqlite')

# 1. Diversity metrics over time
diversity_query = """
SELECT 
    application_year,
    application_quarter,
    total_hires,
    female_hires,
    non_white_hires,
    female_hire_representation,
    non_white_hire_representation
FROM greenhouse__diversity_metrics
ORDER BY application_year, application_quarter
"""
diversity_df = pd.read_sql_query(diversity_query, conn)

# Create visualization 1: Diversity representation over time
plt.figure(figsize=(12, 8))

# Plot female and non-white representation
plt.subplot(2, 2, 1)
quarters = diversity_df['application_year'].astype(str) + 'Q' + diversity_df['application_quarter'].astype(str)
plt.plot(quarters, diversity_df['female_hire_representation'], marker='o', label='Female %')
plt.plot(quarters, diversity_df['non_white_hire_representation'], marker='s', label='Non-white %')
plt.axhline(y=40, color='r', linestyle='--', alpha=0.5, label='Female target (40%)')
plt.axhline(y=30, color='g', linestyle='--', alpha=0.5, label='Non-white target (30%)')
plt.xlabel('Quarter')
plt.ylabel('Representation (%)')
plt.title('Diversity Representation in Hires')
plt.legend()
plt.xticks(rotation=45)
plt.grid(True, alpha=0.3)

# Plot total hires vs diversity hires
plt.subplot(2, 2, 2)
x = np.arange(len(quarters))
width = 0.35
plt.bar(x - width/2, diversity_df['female_hires'], width, label='Female Hires')
plt.bar(x + width/2, diversity_df['non_white_hires'], width, label='Non-white Hires')
plt.xlabel('Quarter')
plt.ylabel('Number of Hires')
plt.title('Diversity Hires by Quarter')
plt.xticks(x, quarters, rotation=45)
plt.legend()
plt.grid(True, alpha=0.3, axis='y')

# 2. Sourcing channel effectiveness
source_query = """
SELECT 
    sourced_from_type,
    COUNT(*) as total_applications,
    SUM(CASE WHEN status = 'hired' THEN 1 ELSE 0 END) as hired_count,
    AVG(CASE WHEN status = 'hired' THEN 1.0 ELSE 0 END) * 100 as hire_rate
FROM greenhouse__application_enhanced
WHERE sourced_from_type IS NOT NULL
GROUP BY sourced_from_type
ORDER BY total_applications DESC
"""
source_df = pd.read_sql_query(source_query, conn)

plt.subplot(2, 2, 3)
sources = source_df['sourced_from_type']
x_pos = np.arange(len(sources))
plt.bar(x_pos, source_df['hire_rate'], color='skyblue')
plt.xlabel('Sourcing Channel')
plt.ylabel('Hire Rate (%)')
plt.title('Hire Rate by Sourcing Channel')
plt.xticks(x_pos, sources, rotation=45)
plt.grid(True, alpha=0.3, axis='y')

# Add hire rate labels on bars
for i, rate in enumerate(source_df['hire_rate']):
    plt.text(i, rate + 0.5, f'{rate:.1f}%', ha='center', va='bottom')

# 3. Department hiring performance
dept_query = """
SELECT 
    job_departments as department,
    COUNT(*) as total_applications,
    SUM(CASE WHEN status = 'hired' THEN 1 ELSE 0 END) as hired_count,
    AVG(CASE WHEN status = 'hired' THEN 1.0 ELSE 0 END) * 100 as hire_rate
FROM greenhouse__application_enhanced
WHERE job_departments IS NOT NULL AND job_departments != ''
GROUP BY job_departments
HAVING total_applications > 100
ORDER BY total_applications DESC
LIMIT 10
"""
dept_df = pd.read_sql_query(dept_query, conn)

plt.subplot(2, 2, 4)
dept_pos = np.arange(len(dept_df))
plt.bar(dept_pos, dept_df['hire_rate'], color='lightgreen')
plt.xlabel('Department')
plt.ylabel('Hire Rate (%)')
plt.title('Hire Rate by Department (Top 10 by applications)')
plt.xticks(dept_pos, dept_df['department'], rotation=45)
plt.grid(True, alpha=0.3, axis='y')

# Add hire rate labels
for i, rate in enumerate(dept_df['hire_rate']):
    plt.text(i, rate + 0.5, f'{rate:.1f}%', ha='center', va='bottom', rotation=90)

plt.tight_layout()
plt.savefig('diversity_sourcing_dept.png', dpi=300, bbox_inches='tight')
plt.close()

# 4. Interview satisfaction analysis
# Get average interview rating per interviewer
rating_query = """
SELECT 
    interviewer_name,
    AVG(rating) as avg_rating,
    COUNT(*) as num_assessments
FROM greenhouse__interview_scorecard_detail
WHERE rating IS NOT NULL AND interviewer_name IS NOT NULL
GROUP BY interviewer_name
HAVING num_assessments >= 5
ORDER BY avg_rating DESC
LIMIT 15
"""
rating_df = pd.read_sql_query(rating_query, conn)

plt.figure(figsize=(10, 6))
if not rating_df.empty:
    plt.barh(rating_df['interviewer_name'], rating_df['avg_rating'])
    plt.xlabel('Average Rating (1-5 scale)')
    plt.title('Interviewer Satisfaction Scores (Top 15 with ≥5 assessments)')
    plt.xlim(0, 5)
    plt.grid(True, alpha=0.3, axis='x')
    
    # Add rating labels
    for i, rating in enumerate(rating_df['avg_rating']):
        plt.text(rating + 0.05, i, f'{rating:.2f}', va='center')
else:
    plt.text(0.5, 0.5, 'No interview rating data available', 
             horizontalalignment='center', verticalalignment='center')
plt.tight_layout()
plt.savefig('interviewer_satisfaction.png', dpi=300, bbox_inches='tight')
plt.close()

# 5. Application funnel analysis by stage
funnel_query = """
SELECT 
    current_job_stage,
    COUNT(*) as count
FROM greenhouse__application_enhanced
WHERE current_job_stage IS NOT NULL AND current_job_stage != ''
GROUP BY current_job_stage
ORDER BY 
    CASE current_job_stage
        WHEN 'application' THEN 1
        WHEN 'phone screen' THEN 2
        WHEN 'interview' THEN 3
        WHEN 'final interview' THEN 4
        WHEN 'offer' THEN 5
        WHEN 'hired' THEN 6
        ELSE 7
    END
"""
funnel_df = pd.read_sql_query(funnel_query, conn)

plt.figure(figsize=(10, 6))
if not funnel_df.empty:
    plt.bar(funnel_df['current_job_stage'], funnel_df['count'], color='orange')
    plt.xlabel('Recruitment Stage')
    plt.ylabel('Number of Candidates')
    plt.title('Recruitment Funnel by Stage')
    plt.xticks(rotation=45)
    plt.grid(True, alpha=0.3, axis='y')
    
    # Add count labels
    for i, count in enumerate(funnel_df['count']):
        plt.text(i, count + max(funnel_df['count'])*0.01, f'{count:,}', 
                ha='center', va='bottom', rotation=90)
else:
    plt.text(0.5, 0.5, 'No funnel stage data available', 
             horizontalalignment='center', verticalalignment='center')
plt.tight_layout()
plt.savefig('recruitment_funnel.png', dpi=300, bbox_inches='tight')
plt.close()

# 6. Cost analysis by sourcing channel (assuming cost data is not available, use proxy metrics)
# Create a composite score chart for channel prioritization
channel_query = """
SELECT 
    sourced_from_type,
    COUNT(*) as total_applications,
    SUM(CASE WHEN status = 'hired' THEN 1 ELSE 0 END) as hires,
    AVG(CASE WHEN status = 'hired' THEN 1.0 ELSE 0 END) * 100 as hire_rate,
    AVG(count_interviews) as avg_interviews_per_candidate
FROM greenhouse__application_enhanced
WHERE sourced_from_type IS NOT NULL
GROUP BY sourced_from_type
"""
channel_df = pd.read_sql_query(channel_query, conn)

# Create composite score (higher is better)
# Weight: hire_rate 50%, 1/avg_interviews 30%, total_applications 20%
if not channel_df.empty:
    channel_df['hire_rate_norm'] = (channel_df['hire_rate'] - channel_df['hire_rate'].min()) / (channel_df['hire_rate'].max() - channel_df['hire_rate'].min())
    channel_df['inv_interviews_norm'] = ((1/channel_df['avg_interviews_per_candidate']) - (1/channel_df['avg_interviews_per_candidate']).min()) / ((1/channel_df['avg_interviews_per_candidate']).max() - (1/channel_df['avg_interviews_per_candidate']).min())
    channel_df['volume_norm'] = (channel_df['total_applications'] - channel_df['total_applications'].min()) / (channel_df['total_applications'].max() - channel_df['total_applications'].min())
    channel_df['composite_score'] = channel_df['hire_rate_norm'] * 0.5 + channel_df['inv_interviews_norm'] * 0.3 + channel_df['volume_norm'] * 0.2
    
