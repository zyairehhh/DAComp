plt.close()

# 2. Benefits distribution - top 10 (as in Stage1)
benefits_text = df['Benefits'].dropna().astype(str).tolist()
benefit_counts = {}
separators = ['、', ',', '，', ';', '；', 'and', '及', '以及', ' ']
for text in benefits_text:
    for sep in separators:
        text = text.replace(sep, '|')
    items = [item.strip() for item in text.split('|') if item.strip()]
    for item in items:
        if item in benefit_counts:
            benefit_counts[item] += 1
        else:
            benefit_counts[item] = 1

sorted_benefits = sorted(benefit_counts.items(), key=lambda x: x[1], reverse=True)
top10 = sorted_benefits[:10]
benefit_names = [b[0] for b in top10]
benefit_counts_vals = [b[1] for b in top10]

# Mapping Chinese benefit names to English
mapping = {
    '五险': 'Five social insurances',
