Action: CreateFile(filepath='search_term_analysis.py':
'''
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')
problematic_ids = pd.read_csv('problematic_with_ratio.csv')['ad_group_id'].tolist()

# Query search term report
query = """
SELECT ad_group_id, search_term_match_type,
       SUM(clicks) as clicks, SUM(impressions) as impressions,
       SUM(conversions) as conversions
FROM google_ads__search_term_report
GROUP BY ad_group_id, search_term_match_type
"""
search_df = pd.read_sql_query(query, conn)
search_df['is_problematic'] = search_df['ad_group_id'].isin(problematic_ids)

# Aggregate by problematic flag
search_summary = search_df.groupby(['is_problematic', 'search_term_match_type']).agg({
    'clicks': 'sum',
    'impressions': 'sum',
    'conversions': 'sum'
}).reset_index()
search_summary['ctr'] = search_summary['clicks'] / search_summary['impressions']
search_summary['cvr'] = search_summary['conversions'] / search_summary['clicks']
search_summary['cvr'].fillna(0, inplace=True)
print('Search term match type summary:')
print(search_summary)

# Proportion of clicks per match type
total_clicks = search_summary.groupby('is_problematic')['clicks'].transform('sum')
search_summary['prop_clicks'] = search_summary['clicks'] / total_clicks
print('\\nProportion of clicks:')
print(search_summary[['is_problematic', 'search_term_match_type', 'prop_clicks', 'cvr']])
''')
