'''
import pandas as pd
import numpy as np

df = pd.read_csv('contact_with_tiers.csv')
# Compute cross-channel indicator
df['cross_channel_active'] = ((df['count_surveys_sent_email'] > 0) | (df['count_surveys_opened_email'] > 0) | (df['count_surveys_started_email'] > 0) | (df['count_surveys_completed_email'] > 0)) & \
                             ((df['count_surveys_sent_sms'] > 0) | (df['count_surveys_opened_sms'] > 0) | (df['count_surveys_started_sms'] > 0) | (df['count_surveys_completed_sms'] > 0))
# Compute per tier
cross_tier = df.groupby('value_tier')['cross_channel_active'].mean() * 100
print("Percentage of users with cross-channel activity per tier:")
print(cross_tier.round(2))
print()
# Compute average participation (total_count_surveys)
part_tier = df.groupby('value_tier')['total_count_surveys'].mean()
print("Average total surveys per tier:")
print(part_tier.round(2))
print()
# Completion rate per tier
df['completion_rate'] = df['total_count_completed_surveys'] / df['total_count_surveys'].replace(0, np.nan)
comp_tier = df.groupby('value_tier')['completion_rate'].mean()
print("Average completion rate per tier:")
print(comp_tier.round(3))
print()
# Average progress per tier
progress_tier = df.groupby('value_tier')['avg_survey_progress_pct'].mean()
print("Average progress % per tier:")
print(progress_tier.round(2))
print()
# Compare medium vs high differences
medium = df[df['value_tier'] == 'medium']
high = df[df['value_tier'] == 'high']
print("Medium vs High comparison (mean):")
print("Cross-channel active: Medium {:.2f}%, High {:.2f}%".format(medium['cross_channel_active'].mean()*100, high['cross_channel_active'].mean()*100))
print("Total surveys: Medium {:.2f}, High {:.2f}".format(medium['total_count_surveys'].mean(), high['total_count_surveys'].mean()))
print("Completion rate: Medium {:.3f}, High {:.3f}".format(medium['completion_rate'].mean(), high['completion_rate'].mean()))
print("Avg progress %: Medium {:.2f}, High {:.2f}".format(medium['avg_survey_progress_pct'].mean(), high['avg_survey_progress_pct'].mean()))
print()
# Compute logistic regression feature importance maybe using correlation
numeric = df.select_dtypes(include=[np.number]).drop(columns=['completion_rate', 'cross_channel_active'], errors='ignore')
corr = numeric.corr()['composite_score'].sort_values(ascending=False)
print("Top 10 features correlated with composite score:")
print(corr.head(10))
''')
