Action: CreateFile(filepath="analyze.py"):
```
import sqlite3
import pandas as pd

conn = sqlite3.connect('database.sqlite')

# Get app_id for com.dev.photoeditor
app_id = pd.read_sql_query("SELECT app_id FROM apps WHERE app_name = 'com.dev.photoeditor'", conn).iloc[0]['app_id']

# Get date range
date_range = pd.read_sql_query("SELECT MIN(date) as min_date, MAX(date) as max_date FROM performance", conn)
min_date = date_range['min_date'][0]
max_date = date_range['max_date'][0]
print(f"Date range in performance table: {min_date} to {max_date}")

# Get the past 12 months from max_date
last_12_start = pd.read_sql_query(f"SELECT DATE('{max_date}', '-12 months') as start_date", conn).iloc[0]['start_date']
print(f"Last 12 months start: {last_12_start}")

# Query monthly aggregated data for the app
monthly_data = pd.read_sql_query(f"""
    SELECT strftime('%Y-%m', p.date) as month,
           AVG(p.revenue_per_user) as avg_revenue,
           AVG(p.sessions_per_user) as avg_sessions,
           SUM(p.user_count) as total_users
    FROM performance p
    WHERE p.app_id = {app_id}
      AND p.date >= '{last_12_start}'
    GROUP BY month
    ORDER BY month
""", conn)
print("Monthly aggregated data:")
print(monthly_data.head())
print("\n")

# Query region categorized data
region_cat = pd.read_sql_query(f"""
    WITH region_avg AS (
        SELECT r.region_name,
               AVG(p.revenue_per_user) as avg_rev,
               AVG(p.sessions_per_user) as avg_sessions,
               SUM(p.user_count) as total_users
        FROM performance p
        JOIN regions r ON p.region_id = r.region_id
        WHERE p.app_id = {app_id}
          AND p.date >= '{last_12_start}'
        GROUP BY r.region_id
    )
    SELECT region_name,
           avg_rev,
           avg_sessions,
           total_users,
           CASE WHEN avg_rev > 7 THEN 'High Revenue (>7)'
                WHEN avg_rev < 3 THEN 'Low Revenue (<3)'
                ELSE 'Medium Revenue'
           END as category
    FROM region_avg
    ORDER BY avg_rev DESC
""", conn)
print("Region categorized data:")
print(region_cat.head())
print("\n")

# Compute summary by category
summary = region_cat.groupby('category').agg(
    region_count=('region_name', 'count'),
    total_users=('total_users', 'sum'),
    avg_revenue=('avg_rev', 'mean'),
    avg_sessions=('avg_sessions', 'mean')
).reset_index()
print("Summary by revenue category:")
print(summary)

# Compute changes between first and last month for high and low revenue regions
first_month = pd.read_sql_query(f"""
    SELECT r.region_name,
           AVG(p.revenue_per_user) as avg_rev_first,
           AVG(p.sessions_per_user) as avg_sess_first
    FROM performance p
    JOIN regions r ON p.region_id = r.region_id
    WHERE p.app_id = {app_id}
      AND p.date = (SELECT MIN(date) FROM performance WHERE date >= '{last_12_start}')
    GROUP BY r.region_id
""", conn)

last_month = pd.read_sql_query(f"""
    SELECT r.region_name,
           AVG(p.revenue_per_user) as avg_rev_last,
           AVG(p.sessions_per_user) as avg_sess_last
    FROM performance p
    JOIN regions r ON p.region_id = r.region_id
    WHERE p.app_id = {app_id}
      AND p.date = (SELECT MAX(date) FROM performance WHERE date >= '{last_12_start}')
    GROUP BY r.region_id
""", conn)

changes = pd.merge(first_month, last_month, on='region_name')
changes = pd.merge(changes, region_cat[['region_name', 'category']], on='region_name')
changes['rev_change'] = changes['avg_rev_last'] - changes['avg_rev_first']
changes['sess_change'] = changes['avg_sess_last'] - changes['avg_sess_first']

print("\nChanges per region (first vs last month):")
print(changes.head())

# Aggregate changes by category
change_summary = changes.groupby('category').agg(
    avg_rev_first=('avg_rev_first', 'mean'),
    avg_rev_last=('avg_rev_last', 'mean'),
    avg_rev_change=('rev_change', 'mean'),
    avg_sess_first=('avg_sess_first', 'mean'),
    avg_sess_last=('avg_sess_last', 'mean'),
    avg_sess_change=('sess_change', 'mean')
).reset_index()
print("\nChange summary by category:")
print(change_summary)

conn.close()
```

