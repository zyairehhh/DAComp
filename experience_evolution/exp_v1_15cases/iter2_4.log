import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Identify high-volatility customers (top 25% customer_margin_volatility)
query = """
SELECT customer_id, customer_margin_volatility
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_vol = pd.read_sql_query(query, conn)
# Compute 75th percentile
threshold = df_vol['customer_margin_volatility'].quantile(0.75)
high_vol_customers = df_vol[df_vol['customer_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High volatility customers count: {len(high_vol_customers)}")

# 2. For these customers, get their gross_profit over past 12 months (need transaction date)
# Determine max date
max_date_query = "SELECT MAX(transaction_date) FROM quickbooks__profitability_analysis"
max_date = pd.read_sql_query(max_date_query, conn).iloc[0,0]
max_date = pd.to_datetime(max_date)
date_12mo_start = max_date - pd.DateOffset(months=12)

profit_query = """
SELECT customer_id, gross_profit, transaction_date
FROM quickbooks__profitability_analysis
WHERE transaction_date >= ? AND customer_id IN ({})
ORDER BY transaction_date
""".format(','.join(['?']*len(high_vol_customers)))
params = [date_12mo_start] + high_vol_customers
df_profit = pd.read_sql_query(profit_query, conn, params=params)

# Coefficient of variation per customer
coeff_var = df_profit.groupby('customer_id')['gross_profit'].apply(lambda x: x.std() / x.mean() if x.mean() != 0 else np.nan)
print("Coefficient of variation summary:")
print(coeff_var.describe())

# 3. Variance of quarter-over-quarter invoice_total growth rate per customer
# First get quarterly invoice totals per customer
qoq_query = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as quarterly_total
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({})
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
""".format(','.join(['?']*len(high_vol_customers)))
df_qoq = pd.read_sql_query(qoq_query, conn, params=high_vol_customers)
print(df_qoq.head())

# Compute quarter-over-quarter growth rate per customer
df_qoq['prev_quarter_total'] = df_qoq.groupby('customer_id')['quarterly_total'].shift(1)
df_qoq['qoq_growth_rate'] = (df_qoq['quarterly_total'] - df_qoq['prev_quarter_total']) / df_qoq['prev_quarter_total']
variance_qoq = df_qoq.groupby('customer_id')['qoq_growth_rate'].var()
print("Variance of QoQ growth rate summary:")
print(variance_qoq.describe())

# Save high_vol_customers list for later use
df_high_vol = pd.DataFrame(high_vol_customers, columns=['customer_id'])
df_high_vol.to_csv('high_vol_customers.csv', index=False)

conn.close()
```

