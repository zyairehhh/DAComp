import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-092.sqlite')

# Get high-volatility customer IDs (same as before)
query = """
WITH customer_vol AS (
    SELECT customer_id, AVG(customer_margin_volatility) AS avg_volatility
    FROM quickbooks__profitability_analysis
    GROUP BY customer_id
),
total_count AS (
    SELECT COUNT(*) as cnt FROM customer_vol
)
SELECT customer_id, avg_volatility
FROM customer_vol
WHERE avg_volatility >= (
    SELECT avg_volatility
    FROM customer_vol
    ORDER BY avg_volatility DESC
    LIMIT 1 OFFSET (SELECT cnt * 0.25 FROM total_count)
)
ORDER BY avg_volatility DESC;
"""
high_vol_df = pd.read_sql_query(query, conn)
print(f"High-volatility customers count: {len(high_vol_df)}")
customer_ids = high_vol_df['customer_id'].tolist()

# Fetch customer_analytics data
cust_analytics_query = """
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation, lifecycle_stage, customer_value_segment, customer_maturity_stage, risk_assessment
FROM quickbooks__customer_analytics
WHERE customer_id IN ({})
""".format(','.join(['?'] * len(customer_ids)))
cust_analytics_df = pd.read_sql_query(cust_analytics_query, conn, params=customer_ids)
print("\nCustomer analytics sample:")
print(cust_analytics_df.head())

# Merge with high_vol_df
