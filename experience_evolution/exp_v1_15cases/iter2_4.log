import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import re

# Connect to database
conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation_enhanced with tags
query = """
SELECT conversation_id, conversation_initiated_type, all_conversation_tags,
       conversation_created_at, first_close_at,
       all_conversation_contacts
FROM intercom__conversation_enhanced
"""
df = pd.read_sql_query(query, conn)

# Parse tags into columns
def parse_tag(tag_str, key):
    if not isinstance(tag_str, str):
        return None
    pattern = rf'{key}:([^|]+)'
    match = re.search(pattern, tag_str)
    if match:
        return match.group(1).strip()
    else:
        return None

df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))

# Load conversation_metrics for time metrics
query_metrics = """
SELECT conversation_id, time_to_first_response_minutes, time_to_first_close_minutes
FROM intercom__conversation_metrics
"""
metrics_df = pd.read_sql_query(query_metrics, conn)
df = df.merge(metrics_df, on='conversation_id', how='left')

conn.close()

# Filter out rows where conversation_initiated_type is missing
df = df[df['conversation_initiated_type'].notna()]
df['conversation_initiated_type'] = df['conversation_initiated_type'].str.strip()

print("Total conversations:", len(df))
print("Human-first count:", len(df[df['conversation_initiated_type']=='human_first']))
print("Bot-first count:", len(df[df['conversation_initiated_type']=='bot_first']))

# Overall conversion rates
human = df[df['conversation_initiated_type']=='human_first']
bot = df[df['conversation_initiated_type']=='bot_first']

def compute_conversion(df, stage_condition):
    total = df.shape[0]
    converted = stage_condition(df).sum()
    rate = converted/total if total>0 else 0
    return total, converted, rate

demo_booked = lambda d: d['stage'] == 'demo_booked'
trial_activated = lambda d: d['stage'] == 'trial_activated'
closed_won = lambda d: d['stage'] == 'closed_won'

h_total, h_demo, h_demo_rate = compute_conversion(human, demo_booked)
_, h_trial, h_trial_rate = compute_conversion(human, trial_activated)
_, h_paid, h_paid_rate = compute_conversion(human, closed_won)

b_total, b_demo, b_demo_rate = compute_conversion(bot, demo_booked)
_, b_trial, b_trial_rate = compute_conversion(bot, trial_activated)
_, b_paid, b_paid_rate = compute_conversion(bot, closed_won)

print("\nOverall Conversion Rates:")
print("Human-first: demo booked = {}/{} ({:.1%})".format(h_demo, h_total, h_demo_rate))
print("            trial activated = {}/{} ({:.1%})".format(h_trial, h_total, h_trial_rate))
print("            closed won = {}/{} ({:.1%})".format(h_paid, h_total, h_paid_rate))
print("Bot-first: demo booked = {}/{} ({:.1%})".format(b_demo, b_total, b_demo_rate))
print("          trial activated = {}/{} ({:.1%})".format(b_trial, b_total, b_trial_rate))
print("          closed won = {}/{} ({:.1%})".format(b_paid, b_total, b_paid_rate))

# Conditional conversion (contact-level)
print("\n=== Conditional Conversion (Contact-level) ===")

# Create a dataframe with one row per contact
# Define stage ordering
stage_order = {'demo_booked': 1, 'trial_activated': 2, 'closed_won': 3}
def max_stage(stages):
    # Return highest stage
    valid = [s for s in stages if s in stage_order]
    if not valid:
        return None
    return max(valid, key=lambda x: stage_order[x])

df['contact_id'] = df['all_conversation_contacts'].str.strip()

contact_groups = df.groupby('contact_id').agg({
    'stage': list,
    'conversation_initiated_type': list,
    'conversation_id': 'count'
}).reset_index()
contact_groups.rename(columns={'conversation_id': 'conversation_count'}, inplace=True)

# Determine the highest stage per contact
contact_groups['highest_stage'] = contact_groups['stage'].apply(max_stage)

# Determine responder type for the highest stage
def get_responder_for_highest_stage(contact_row):
    stages = contact_row['stage']
    responders = contact_row['conversation_initiated_type']
    highest = contact_row['highest_stage']
    if highest is None:
        return None
    # Find index of first occurrence of highest stage
    for i, s in enumerate(stages):
        if s == highest:
            return responders[i]
    return None

contact_groups['responder_type'] = contact_groups.apply(get_responder_for_highest_stage, axis=1)

# Also compute if contact had demo_booked, trial_activated, closed_won (as boolean)
contact_groups['had_demo'] = contact_groups['stage'].apply(lambda lst: 'demo_booked' in lst)
contact_groups['had_trial'] = contact_groups['stage'].apply(lambda lst: 'trial_activated' in lst)
contact_groups['had_paid'] = contact_groups['stage'].apply(lambda lst: 'closed_won' in lst)

# Now compute conditional conversion rates per responder type
def conditional_rate(df_responder, col_from, col_to):
    # col_from: boolean column indicating starting point (e.g., 'had_demo')
    # col_to: boolean column indicating target (e.g., 'had_trial')
    from_count = df_responder[df_responder[col_from]].shape[0]
    to_count = df_responder[df_responder[col_from] & df_responder[col_to]].shape[0]
    rate = to_count / from_count if from_count > 0 else 0
    return from_count, to_count, rate

for rtype in ['human_first', 'bot_first']:
    subset = contact_groups[contact_groups['responder_type'] == rtype]
    print(f"\n{rtype}:")
    # Demo booked -> Trial activated
    from_demo, to_trial, rate_demo_trial = conditional_rate(subset, 'had_demo', 'had_trial')
    print(f"  Demo booked -> Trial activated: {to_trial}/{from_demo} = {rate_demo_trial:.1%}")
    # Trial activated -> Paid
    from_trial, to_paid, rate_trial_paid = conditional_rate(subset, 'had_trial', 'had_paid')
    print(f"  Trial activated -> Paid: {to_paid}/{from_trial} = {rate_trial_paid:.1%}")

# Check counts: total contacts per responder type
print("\nTotal contacts per responder type:")
print(contact_groups['responder_type'].value_counts(dropna=False))

print("\nUnique contacts per stage per responder type:")
for rtype in ['human_first', 'bot_first']:
    subset = contact_groups[contact_groups['responder_type'] == rtype]
    demo = subset['had_demo'].sum()
    trial = subset['had_trial'].sum()
    paid = subset['had_paid'].sum()
    print(f"{rtype}: demo booked {demo}, trial activated {trial}, paid {paid}")

print("\nOverall conversion rates (unique contacts):")
for rtype in ['human_first', 'bot_first']:
    subset = contact_groups[contact_groups['responder_type'] == rtype]
    total = subset.shape[0]
    demo = subset['had_demo'].sum()
    trial = subset['had_trial'].sum()
    paid = subset['had_paid'].sum()
    print(f"{rtype}: total {total}, demo {demo} ({demo/total:.1%}), trial {trial} ({trial/total:.1%}), paid {paid} ({paid/total:.1%})")
```

