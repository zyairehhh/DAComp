import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib
import seaborn as sns

# Set style
plt.style.use('seaborn-v0_8-darkgrid')
matplotlib.rcParams['font.family'] = 'sans-serif'
matplotlib.rcParams['font.size'] = 10

# Load computed data
df = pd.read_csv('user_scores.csv')

# Create a color palette
tier_colors = {'Low-Value': '#FF6B6B', 'Medium-Value': '#FFD166', 'High-Value': '#06D6A0'}
language_colors = plt.cm.Set3(np.linspace(0, 1, 10))

# Visualization 1: User Tier Distribution
fig, ax = plt.subplots(figsize=(8, 6))
tier_counts = df['value_tier'].value_counts().sort_index()
bars = ax.bar(tier_counts.index, tier_counts.values, color=[tier_colors[t] for t in tier_counts.index])

# Add percentage labels
total = tier_counts.sum()
for i, (tier, count) in enumerate(tier_counts.items()):
    percentage = count / total * 100
    ax.text(i, count + total*0.01, f'{percentage:.0f}%', ha='center', fontweight='bold')

ax.set_title('User Value Tier Distribution', fontsize=14, fontweight='bold')
ax.set_ylabel('Number of Users', fontsize=12)
ax.set_xlabel('Value Tier', fontsize=12)
plt.tight_layout()
plt.savefig('tier_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# Visualization 2: Cross-Channel Activity by Tier
fig, ax = plt.subplots(figsize=(8, 6))
cross_channel_by_tier = df.groupby('value_tier')['cross_channel_score'].mean() * 100

bars = ax.bar(cross_channel_by_tier.index, cross_channel_by_tier.values, 
              color=[tier_colors[t] for t in cross_channel_by_tier.index])

# Add percentage labels
for i, (tier, value) in enumerate(cross_channel_by_tier.items()):
    ax.text(i, value + 1, f'{value:.1f}%', ha='center', fontweight='bold')

ax.set_title('Cross-Channel Engagement by Value Tier', fontsize=14, fontweight='bold')
ax.set_ylabel('Percentage of Users with Cross-Channel Activity (%)', fontsize=12)
ax.set_ylim(0, 100)
plt.tight_layout()
plt.savefig('cross_channel_by_tier.png', dpi=300, bbox_inches='tight')
plt.close()

# Visualization 3: Key Metrics Comparison (Medium vs High)
fig, axes = plt.subplots(2, 2, figsize=(12, 10))
metrics_data = []

for tier in ['Medium-Value', 'High-Value']:
    tier_data = df[df['value_tier'] == tier]
    metrics_data.append({
        'tier': tier,
        'avg_surveys': tier_data['total_count_surveys'].mean(),
        'completion_rate': tier_data['completion_rate'].mean() * 100,
        'avg_progress': tier_data['avg_survey_progress_pct'].mean(),
        'cross_channel': tier_data['cross_channel_score'].mean() * 100
    })

metrics_df = pd.DataFrame(metrics_data)
metrics = ['avg_surveys', 'completion_rate', 'avg_progress', 'cross_channel']
metric_names = ['Average Surveys', 'Completion Rate (%)', 'Average Progress (%)', 'Cross-Channel (%)']

for idx, (metric, name) in enumerate(zip(metrics, metric_names)):
    ax = axes[idx // 2, idx % 2]
    medium_val = metrics_df.loc[metrics_df['tier'] == 'Medium-Value', metric].values[0]
    high_val = metrics_df.loc[metrics_df['tier'] == 'High-Value', metric].values[0]
    
    bars = ax.bar(['Medium-Value', 'High-Value'], [medium_val, high_val], 
                  color=[tier_colors['Medium-Value'], tier_colors['High-Value']])
    
    # Add value labels
    ax.text(0, medium_val * 1.02, f'{medium_val:.1f}', ha='center', fontweight='bold')
    ax.text(1, high_val * 1.02, f'{high_val:.1f}', ha='center', fontweight='bold')
    
    # Add improvement arrow if High > Medium
    if high_val > medium_val:
        improvement = ((high_val - medium_val) / medium_val) * 100
        ax.annotate(f'+{improvement:.0f}%', 
                    xy=(1, high_val*0.5), 
                    xytext=(0.5, high_val*0.5),
                    arrowprops=dict(arrowstyle='->', color='black'),
                    fontweight='bold', ha='center')
    
    ax.set_title(name, fontsize=12, fontweight='bold')
    ax.set_ylabel(name.split(' ')[0] if '%' not in name else 'Percentage')
    ax.tick_params(axis='x', rotation=0)

fig.suptitle('Key Metric Comparison: Medium vs High Value Users', fontsize=14, fontweight='bold', y=0.98)
plt.tight_layout(rect=[0, 0, 1, 0.96])
plt.savefig('medium_high_comparison.png', dpi=300, bbox_inches='tight')
plt.close()

# Visualization 4: High-Tier Rate by Language
fig, ax = plt.subplots(figsize=(10, 6))

# Calculate high-tier rate by language
language_groups = df.groupby('language')
high_tier_rate = []
languages = []
for lang, group in language_groups:
    if len(group) >= 20:  # Only include languages with at least 20 users
        rate = (group['value_tier'] == 'High-Value').mean() * 100
        languages.append(lang)
        high_tier_rate.append(rate)

# Sort by rate
sorted_indices = np.argsort(high_tier_rate)[::-1]
languages_sorted = [languages[i] for i in sorted_indices]
rates_sorted = [high_tier_rate[i] for i in sorted_indices]

bars = ax.bar(range(len(languages_sorted)), rates_sorted, color=language_colors[:len(languages_sorted)])

# Add percentage labels
for i, rate in enumerate(rates_sorted):
    ax.text(i, rate + 0.5, f'{rate:.1f}%', ha='center', fontsize=9)

