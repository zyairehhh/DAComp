Action: CreateFile(filepath='compute_distributions.py':
'''
import sqlite3
import re
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query('SELECT * FROM sheet1 WHERE "Education Requirement" = "Vocational school or above"', conn)
conn.close()

print(f"Total rows: {len(df)}")

# Parse salary lower bound
def parse_salary_lower(salary_str):
    if not isinstance(salary_str, str):
        return None
    # Find first range before parentheses or just whole string
    # Remove commas
    s = salary_str.replace(',', '')
    # Look for pattern like 5000-10000
    match = re.search(r'(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)', s)
    if match:
        lower = float(match.group(1))
        return lower
    return None

df['salary_lower'] = df['Salary Range'].apply(parse_salary_lower)
print(f"Rows with parsed salary lower: {df['salary_lower'].notna().sum()}")

# Distribution bins
bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 50000]
labels = ['<2000', '2000-3000', '3000-4000', '4000-5000', '5000-6000', '6000-7000', '7000-8000', '8000-9000', '9000-10000', '10000-15000', '15000-20000', '>20000']
df['salary_bin'] = pd.cut(df['salary_lower'], bins=bins, labels=labels, right=False)
salary_dist = df['salary_bin'].value_counts().sort_index()
print("Salary distribution (lower bound):")
print(salary_dist)
salary_dist.to_csv('salary_distribution.csv')

# Benefits distribution
benefits_text = df['Benefits'].dropna()
# Split by common separators: comma, semicolon, Chinese comma '，', Chinese semicolon '；', space.
def split_benefits(text):
    # Normalize separators
    text = str(text)
    # Replace Chinese punctuation with comma
    text = text.replace('，', ',').replace('；', ';').replace('、', ',')
    # Split by comma or semicolon
    parts = re.split(r'[,;]', text)
    # Strip whitespace and filter empty
    cleaned = [p.strip() for p in parts if p.strip()]
    return cleaned

all_benefits = []
for txt in benefits_text:
    all_benefits.extend(split_benefits(txt))

# Count frequencies
from collections import Counter
benefits_counter = Counter(all_benefits)
# Get top 20
top_benefits = benefits_counter.most_common(30)
print("Top 30 benefits:")
for benefit, count in top_benefits:
    print(f"{benefit}: {count}")

# Save to csv
pd.DataFrame(top_benefits, columns=['benefit', 'count']).to_csv('benefits_distribution.csv', index=False)

# Also save the full data with parsed salary for further analysis
df.to_csv('vocational_data.csv', index=False)
print("Data saved.")
''')
