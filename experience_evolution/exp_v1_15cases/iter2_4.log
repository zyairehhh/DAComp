'''
import itertools
import numpy as np
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-067.sqlite')

# Source type data
sql = '''
SELECT source_type,
       SUM(total_hires) AS hires,
       AVG(hire_rate) AS hire_rate,
       AVG(interview_rate) AS interview_rate
FROM greenhouse__talent_pipeline_simplified
GROUP BY source_type
'''
df = pd.read_sql_query(sql, conn)

# Add cost
cost_per_hire = {
    'agency': 20000,
    'direct': 200,
    'job_board': 1000,
    'referral': 5000,
    'social_media': 500,
    'university': 8000
}
df['cost'] = df['source_type'].map(cost_per_hire)

# Diversity (female, non-white) representation from earlier analysis
df['female_rep'] = df['source_type'].map({
    'agency': 0.4,
    'direct': 0.2,
    'job_board': 0.12,
    'referral': 0.142857,
