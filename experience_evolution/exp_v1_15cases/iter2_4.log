I'll break down:
1. Join tables: abnormal_logins_table a, login_records_table l, user_information_table u.
2. Group by department.
3. Compute:
   - total_logins: count of distinct Login Record ID per dept
   - abnormal_logins: count of distinct a.Anomaly ID (or a.Login Record ID) per dept
   - abnormal_rate: abnormal_logins/total_logins*100
   - confirmed_abnormal_%: sum(case when a.Confirmation Status='Confirmed' then 1 else 0 end)/abnormal_logins*100
   - high_risk_abnormal_%: sum(case when a.Risk Level in ('Severe','High') then 1 else 0 end)/abnormal_logins*100
   - high_risk_user_%: count(distinct case when a.Risk Level in ('Severe','High') then u."User ID" end)/total_users*100
   - remote_login_%: sum(case when a.Anomaly Type='Remote Login' then 1 else 0 end)/abnormal_logins*100
   - avg_anomaly_score: avg(a.Anomaly Score)

Let's create a Python script to compute these and generate plots. First, write a script to query the data.

Action: CreateFile(filepath="compute_metrics.py"):
```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

# Connect to database
conn = sqlite3.connect('dacomp-035.sqlite')

# Query to compute metrics per department
query = """
WITH dept_users AS (
    SELECT "User ID", Department FROM user_information_table
),
login_counts AS (
    SELECT l."User ID", COUNT(DISTINCT l."Login Record ID") as total_logins
    FROM login_records_table l
    GROUP BY l."User ID"
),
abnormal_counts AS (
    SELECT a."Login Record ID", a."Anomaly ID", a."Risk Level", 
           a."Confirmation Status", a."Anomaly Type", a."Anomaly Score"
    FROM abnormal_logins_table a
),
joined AS (
    SELECT 
        u.Department,
        u."User ID",
        lc.total_logins,
        a."Anomaly ID",
        a."Risk Level",
        a."Confirmation Status",
        a."Anomaly Type",
        a."Anomaly Score"
    FROM dept_users u
    LEFT JOIN login_counts lc ON u."User ID" = lc."User ID"
    LEFT JOIN login_records_table l ON u."User ID" = l."User ID"
    LEFT JOIN abnormal_counts a ON l."Login Record ID" = a."Login Record ID"
),
department_stats AS (
    SELECT 
        Department,
        COUNT(DISTINCT "User ID") as total_users,
        COALESCE(SUM(total_logins), 0) as total_logins,
        COUNT(DISTINCT "Anomaly ID") as abnormal_logins,
        SUM(CASE WHEN "Confirmation Status" = 'Confirmed' THEN 1 ELSE 0 END) as confirmed_abnormal,
        SUM(CASE WHEN "Risk Level" IN ('Severe', 'High') THEN 1 ELSE 0 END) as high_risk_abnormal,
        COUNT(DISTINCT CASE WHEN "Risk Level" IN ('Severe', 'High') THEN "User ID" END) as high_risk_users,
        SUM(CASE WHEN "Anomaly Type" = 'Remote Login' THEN 1 ELSE 0 END) as remote_login_abnormal,
        AVG("Anomaly Score") as avg_anomaly_score
    FROM joined
    GROUP BY Department
)
SELECT 
    Department,
    total_users,
    total_logins,
    abnormal_logins,
    ROUND(100.0 * abnormal_logins / total_logins, 1) as abnormal_rate,
    ROUND(100.0 * confirmed_abnormal / abnormal_logins, 1) as confirmed_abnormal_pct,
    ROUND(100.0 * high_risk_abnormal / abnormal_logins, 1) as high_risk_abnormal_pct,
    ROUND(100.0 * high_risk_users / total_users, 1) as high_risk_user_pct,
    ROUND(100.0 * remote_login_abnormal / abnormal_logins, 1) as remote_login_pct,
    ROUND(avg_anomaly_score, 1) as avg_anomaly_score
FROM department_stats
ORDER BY 
    CASE Department 
        WHEN 'Marketing Department' THEN 1
        WHEN 'Sales Department' THEN 2
        WHEN 'Technical Department' THEN 3
        WHEN 'Finance Department' THEN 4
        ELSE 5
    END;
"""

df = pd.read_sql_query(query, conn)
conn.close()

print(df)

# Save to CSV for reference
df.to_csv('department_metrics.csv', index=False)
print("\nMetrics saved to department_metrics.csv")
```
