import sqlite3
import pandas as pd
import numpy as np
from scipy import stats
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime, timedelta
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# Helper function to run SQL
def run_query(query):
    return pd.read_sql_query(query, conn)

# 1. Region-wise decay of conversion rate over past 6 months
print("=== Region-wise decay of conversion rate ===")
query_region = """
SELECT 
    region,
    strftime('%Y-%m', date_day) as month,
    AVG(store_listing_conversion_rate) as avg_conversion_rate,
    SUM(store_listing_acquisitions) as total_acquisitions,
    SUM(store_listing_visitors) as total_visitors
FROM google_play__country_report
GROUP BY region, strftime('%Y-%m', date_day)
ORDER BY region, month;
"""
df_region = run_query(query_region)
print(df_region.head(20))

# Compute decay slope per region
region_decay = {}
for region in df_region['region'].unique():
    subset = df_region[df_region['region'] == region].copy()
    subset['month_index'] = range(len(subset))
    if len(subset) >= 2:
        slope, intercept, r_value, p_value, std_err = stats.linregress(subset['month_index'], subset['avg_conversion_rate'])
        region_decay[region] = {'slope': slope, 'r_squared': r_value**2, 'p_value': p_value, 'start_rate': subset.iloc[0]['avg_conversion_rate'], 'end_rate': subset.iloc[-1]['avg_conversion_rate']}
    else:
        region_decay[region] = {'slope': np.nan, 'r_squared': np.nan, 'p_value': np.nan, 'start_rate': np.nan, 'end_rate': np.nan}

print("\nRegion decay slopes (negative indicates decline):")
for region, vals in region_decay.items():
    print(f"{region}: slope={vals['slope']:.6f}, R²={vals['r_squared']:.3f}, p={vals['p_value']:.4f}, start={vals['start_rate']:.3f}, end={vals['end_rate']:.3f}")

# 2. Device-wise decay of conversion? Device report doesn't have conversion rate.
# Instead we can look at installs vs uninstalls, or active devices trend.
print("\n=== Device-wise decay of active devices last 30 days ===")
query_device = """
SELECT 
    device,
    strftime('%Y-%m', date_day) as month,
    AVG(active_devices_last_30_days) as avg_active_devices,
    SUM(device_installs) as total_installs,
    SUM(device_uninstalls) as total_uninstalls
FROM google_play__device_report
GROUP BY device, strftime('%Y-%m', date_day)
ORDER BY device, month;
"""
df_device = run_query(query_device)
print(df_device.head(20))

# Compute decay slope per device
device_decay = {}
for device in df_device['device'].unique():
    subset = df_device[df_device['device'] == device].copy()
    subset['month_index'] = range(len(subset))
    if len(subset) >= 2:
        slope, intercept, r_value, p_value, std_err = stats.linregress(subset['month_index'], subset['avg_active_devices'])
        device_decay[device] = {'slope': slope, 'r_squared': r_value**2, 'p_value': p_value, 'start': subset.iloc[0]['avg_active_devices'], 'end': subset.iloc[-1]['avg_active_devices']}
    else:
        device_decay[device] = {'slope': np.nan, 'r_squared': np.nan, 'p_value': np.nan, 'start': np.nan, 'end': np.nan}

print("\nDevice active devices decay slopes (negative indicates decline):")
for device, vals in device_decay.items():
    print(f"{device}: slope={vals['slope']:.2f}, R²={vals['r_squared']:.3f}, p={vals['p_value']:.4f}, start={vals['start']:.0f}, end={vals['end']:.0f}")

conn.close()
```
