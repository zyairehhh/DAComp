import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-022.sqlite')

# Vehicle type summary
query = '''
SELECT 
    "Vehicle Type",
    COUNT(*) as total_rides,
    SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) as completed,
    (SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) * 1.0 / COUNT(*)) as completion_rate,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" ELSE NULL END) as avg_fare,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" / "Ride Distance" ELSE NULL END) as avg_per_km_fare
FROM 
    sheet1 
GROUP BY 
    "Vehicle Type"
ORDER BY 
    avg_per_km_fare DESC
'''

df = pd.read_sql_query(query, conn)
print("Vehicle Type Summary (sorted by per-km fare):")
print(df.to_string(index=False))

# Top pickup locations by per-km fare
query2 = '''
SELECT 
    "Pickup Location",
    COUNT(*) as rides,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Pickup Location"
HAVING rides >= 500
ORDER BY avg_per_km_fare DESC
LIMIT 10
'''
df2 = pd.read_sql_query(query2, conn)
print("\nTop 10 Pickup Locations (>=500 rides) by per-km fare:")
print(df2.to_string(index=False))

# Top drop locations by per-km fare
query3 = '''
SELECT 
    "Drop Location",
    COUNT(*) as rides,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Drop Location"
HAVING rides >= 500
ORDER BY avg_per_km_fare DESC
LIMIT 10
'''
df3 = pd.read_sql_query(query3, conn)
print("\nTop 10 Drop Locations (>=500 rides) by per-km fare:")
print(df3.to_string(index=False))

conn.close()
```



