import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Identify high-volatility customer segment (top 25% customer_margin_volatility)
query = """
WITH customer_vol AS (
    SELECT customer_id, AVG(customer_margin_volatility) AS avg_volatility
    FROM quickbooks__profitability_analysis
    GROUP BY customer_id
),
total_count AS (
    SELECT COUNT(*) as cnt FROM customer_vol
)
SELECT customer_id, avg_volatility
FROM customer_vol
WHERE avg_volatility >= (
    SELECT avg_volatility
    FROM customer_vol
    ORDER BY avg_volatility DESC
    LIMIT 1 OFFSET (SELECT cnt * 0.25 FROM total_count)
)
ORDER BY avg_volatility DESC;
"""
high_vol_df = pd.read_sql_query(query, conn)
print(f"High-volatility customers count: {len(high_vol_df)}")
print(high_vol_df.head())

# 2. For each high-volatility customer, compute coefficient of variation of gross_profit over past 12 months
# Get max transaction_date
max_date_query = "SELECT MAX(transaction_date) FROM quickbooks__profitability_analysis;"
max_date = pd.read_sql_query(max_date_query, conn).iloc[0,0]
print(f"Max transaction date: {max_date}")
# Convert to datetime
max_date = pd.to_datetime(max_date)
start_date = max_date - pd.DateOffset(months=12)

# Monthly gross profit per customer
monthly_query = """
SELECT customer_id, 
       strftime('%Y-%m', transaction_date) AS month,
       SUM(gross_profit) AS monthly_gross_profit
FROM quickbooks__profitability_analysis
WHERE transaction_date >= ? 
  AND transaction_date <= ?
  AND customer_id IN ({})
GROUP BY customer_id, month
""".format(','.join(['?'] * len(high_vol_df)))

customer_ids = high_vol_df['customer_id'].tolist()
monthly_data = pd.read_sql_query(monthly_query, conn, params=[start_date.strftime('%Y-%m-%d'), max_date.strftime('%Y-%m-%d')] + customer_ids)

# Coefficient of variation
cv_results = []
for cust in customer_ids:
    cust_data = monthly_data[monthly_data['customer_id'] == cust]
    if len(cust_data) > 1:
        monthly_profits = cust_data['monthly_gross_profit'].values
        mean = np.mean(monthly_profits)
        std = np.std(monthly_profits, ddof=1)
        cv = std / mean if mean != 0 else np.nan
    else:
        cv = np.nan
    cv_results.append({'customer_id': cust, 'coeff_variation': cv})

cv_df = pd.DataFrame(cv_results)

# 3. Variance of quarter-over-quarter invoice_total growth rate
# Determine quarters: we need quarter numbers. Use revenue_quarter and revenue_year columns.
quarterly_query = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) AS quarter_invoice_total
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({})
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
""".format(','.join(['?'] * len(customer_ids)))

quarterly_data = pd.read_sql_query(quarterly_query, conn, params=customer_ids)

# Compute quarter-over-quarter growth rate per customer, then variance across quarters
growth_var_results = []
for cust in customer_ids:
    cust_q = quarterly_data[quarterly_data['customer_id'] == cust].sort_values(['revenue_year', 'revenue_quarter'])
    if len(cust_q) > 1:
        cust_q['prev_quarter_total'] = cust_q['quarter_invoice_total'].shift(1)
        cust_q['growth_rate'] = (cust_q['quarter_invoice_total'] - cust_q['prev_quarter_total']) / cust_q['prev_quarter_total']
        growth_rates = cust_q['growth_rate'].dropna()
        if len(growth_rates) > 1:
            var_growth = np.var(growth_rates, ddof=1)
        else:
            var_growth = np.nan
    else:
        var_growth = np.nan
    growth_var_results.append({'customer_id': cust, 'variance_growth_rate': var_growth})

growth_var_df = pd.DataFrame(growth_var_results)

# Merge results
results_df = high_vol_df.merge(cv_df, on='customer_id', how='left').merge(growth_var_df, on='customer_id', how='left')
print("\nResults for high-volatility customers:")
print(results_df.head(20))
print("\nSummary statistics:")
print(results_df[['coeff_variation', 'variance_growth_rate']].describe())

# Save to CSV for further analysis
results_df.to_csv('high_volatility_customers_metrics.csv', index=False)
print("\nSaved results to high_volatility_customers_metrics.csv")

conn.close()
```
