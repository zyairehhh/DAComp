import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('./dacomp-069.sqlite')

# 1. Regional ARPU range
df_region = pd.read_sql_query("""
    SELECT region, AVG(average_revenue_per_user) as avg_arpu,
           MIN(average_revenue_per_user) as min_arpu,
           MAX(average_revenue_per_user) as max_arpu
    FROM google_play__geo_market_analysis
    WHERE package_name='com.dev.photoeditor'
    GROUP BY region
""", conn)
x = np.arange(len(df_region))
plt.figure(figsize=(10,6))
plt.bar(x, df_region['avg_arpu'], yerr=[df_region['avg_arpu']-df_region['min_arpu'],
                                        df_region['max_arpu']-df_region['avg_arpu']],
        capsize=5, color='teal', alpha=0.7)
plt.xticks(x, df_region['region'])
plt.axhline(y=7, color='red', linestyle='--', label='$7 ARPU threshold')
plt.axhline(y=3, color='orange', linestyle='--', label='$3 ARPU threshold')
plt.title('Average Revenue Per User by Region (with range)')
plt.xlabel('Region')
plt.ylabel('ARPU ($)')
plt.legend()
plt.tight_layout()
plt.savefig('regional_arpu_range.png')
plt.close()

# 2. Group comparison (High ARPU >7 vs Low ARPU <=7) using bars for metrics
df = pd.read_sql_query("""
    SELECT 
        CASE WHEN average_revenue_per_user > 7 THEN 'High (>$7)'
             ELSE 'Low (<=$7)' END as rev_group,
        overall_market_score,
        day_1_retention_rate,
        day_30_retention_rate,
        daily_churn_rate
    FROM google_play__geo_market_analysis
    WHERE package_name='com.dev.photoeditor'
""", conn)
group_means = df.groupby('rev_group').mean().reset_index()

fig, axes = plt.subplots(2, 2, figsize=(10, 8))
metrics = ['overall_market_score', 'day_1_retention_rate', 'day_30_retention_rate', 'daily_churn_rate']
titles = ['Overall Market Score', 'Day‑1 Retention', 'Day‑30 Retention', 'Daily Churn Rate']
for i, (ax, metric, title) in enumerate(zip(axes.flat, metrics, titles)):
    ax.bar(group_means['rev_group'], group_means[metric], color=['skyblue', 'lightcoral'])
    ax.set_title(title)
    ax.set_ylabel(title)
    if i >= 2:
        ax.set_xlabel('Revenue Group')
    else:
        ax.set_xlabel('')
plt.suptitle('Performance Metrics Comparison: High‑ARPU vs Low‑ARPU Markets')
plt.tight_layout()
plt.savefig('group_comparison.png')
plt.close()

# 3. Divergence of daily net revenue over time for high‑ and low‑ARPU countries that are present in finance_report
# Map country names from geo to finance_report (country_long)
df_markets = pd.read_sql_query("""
    SELECT country, country_name, average_revenue_per_user
    FROM google_play__geo_market_analysis
    WHERE package_name='com.dev.photoeditor'
""", conn)
# list of country_long present in finance_report
df_fin = pd.read_sql_query("""
    SELECT DISTINCT country_long
    FROM google_play__finance_report
    WHERE package_name='com.dev.photoeditor'
""", conn)
available = df_fin['country_long'].tolist()
print("Countries in finance_report:", available)

# Map each to ARPU group
def get_group(row):
    return 'High' if row['average_revenue_per_user'] > 7 else 'Low'

df_markets['group'] = df_markets.apply(get_group, axis=1)
# Filter to those available
available_markets = df_markets[df_markets['country_name'].isin(available)]

df_rev = pd.read_sql_query("""
    SELECT date_day, country_long, net_amount
    FROM google_play__finance_report
    WHERE package_name='com.dev.photoeditor'
""", conn)
df_rev['date_day'] = pd.to_datetime(df_rev['date_day'])
pivot = df_rev.pivot_table(index='date_day', columns='country_long', values='net_amount', aggfunc='sum')

high_names = list(set(available_markets[available_markets['group'] == 'High']['country_name']))
low_names = list(set(available_markets[available_markets['group'] == 'Low']['country_name']))

high_rev = pivot[high_names].sum(axis=1) if high_names else pd.Series(index=pivot.index, data=0)
low_rev = pivot[low_names].sum(axis=1) if low_names else pd.Series(index=pivot.index, data=0)

plt.figure(figsize=(12,6))
plt.plot(high_rev.index, high_rev.values, label='High ARPU Markets (> $7)', linewidth=2)
if low_names:
    plt.plot(low_rev.index, low_rev.values, label='Low ARPU Markets (≤ $7)', linewidth=2)
plt.title('Daily Net Revenue: High‑ARPU vs Low‑ARPU Markets (available data)')
plt.xlabel('Date')
plt.ylabel('Total Net Revenue ($)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('revenue_divergence_fixed.png')
plt.close()

conn.close()
print("Final plots generated.")
''')
