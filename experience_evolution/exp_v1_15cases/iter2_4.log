    cbar.set_label('Conversion Rate')
    
    # Add size legend manually
    sizes = [100, 200, 300]  # Corresponding to update_events/10
    labels = ['Low Updates', 'Medium Updates', 'High Updates']
    for size, label in zip(sizes, labels):
        ax3.scatter([], [], c='gray', s=size, label=label, alpha=0.6)
    ax3.legend(scatterpoints=1, frameon=True, labelspacing=1, title='Update Frequency')
    
    # Update frequency impact
    ax4 = plt.subplot(2, 2, 4)
    update_impact = multi_dim_data.groupby(pd.cut(multi_dim_data['update_events'], 3))[['active_devices_last_30_days', 'rolling_total_average_rating']].mean()
    x = np.arange(len(update_impact))
    width = 0.35
    
    bars1 = ax4.bar(x - width/2, update_impact['active_devices_last_30_days'], width, label='Active Devices', alpha=0.7)
    ax4b = ax4.twinx()
    bars2 = ax4b.bar(x + width/2, update_impact['rolling_total_average_rating'], width, label='Avg Rating', color='orange', alpha=0.7)
    
    ax4.set_xlabel('Update Frequency Tiers')
    ax4.set_ylabel('Active Devices (30 days)')
    ax4b.set_ylabel('Average Rating')
    ax4.set_xticks(x)
    ax4.set_xticklabels(['Low', 'Medium', 'High'])
    ax4.set_title('Impact of Update Frequency on User Metrics')
    
    # Combine legends
    lines1, labels1 = ax4.get_legend_handles_labels()
    lines2, labels2 = ax4b.get_legend_handles_labels()
    ax4.legend(lines1 + lines2, labels1 + labels2, loc='upper right')
    
    plt.suptitle('Multi-dimensional Decay Analysis and Update Frequency Impact', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.savefig('multidimensional_decay_analysis.png', dpi=300, bbox_inches='tight')
    plt.close()

# 4. Update frequency interaction analysis
# Get more detailed update frequency data
query5 = """
SELECT 
    dr.date_day,
    dr.device,
    dr.update_events,
    dr.active_devices_last_30_days,
    dr.rolling_total_average_rating,
    osr.crashes,
    osr.anrs
FROM google_play__device_report dr
LEFT JOIN google_play__os_version_report osr 
    ON dr.date_day = osr.date_day AND dr.device LIKE '%' || SUBSTR(osr.android_os_version, 1, 2) || '%'
WHERE dr.update_events > 0
LIMIT 500
"""

update_data = pd.read_sql_query(query5, conn)
update_data['date_day'] = pd.to_datetime(update_data['date_day'])

if len(update_data) > 0:
    fig4, axes4 = plt.subplots(1, 2, figsize=(14, 6))
    fig4.suptitle('App Update Frequency Interaction Effects', fontsize=16, fontweight='bold')
    
    # Scatter plot: Update events vs active devices with rating as color
    ax1 = axes4[0]
    scatter = ax1.scatter(
        update_data['update_events'],
        update_data['active_devices_last_30_days'],
        c=update_data['rolling_total_average_rating'],
        cmap='RdYlBu',
        s=100,
        alpha=0.7,
        edgecolors='black',
        linewidth=0.5
    )
    ax1.set_title('Update Frequency vs Active Devices (Colored by Rating)')
    ax1.set_xlabel('Update Events Count')
    ax1.set_ylabel('Active Devices (30 days)')
    cbar = plt.colorbar(scatter, ax=ax1)
    cbar.set_label('Average Rating')
    
    # Add trend line
    z = np.polyfit(update_data['update_events'], update_data['active_devices_last_30_days'], 1)
    p = np.poly1d(z)
    x_range = np.linspace(update_data['update_events'].min(), update_data['update_events'].max(), 100)
    ax1.plot(x_range, p(x_range), 'r--', alpha=0.8, label='Linear Trend')
    ax1.legend()
    
    # Bar plot: Update frequency tiers vs metrics
    ax2 = axes4[1]
    update_data['update_tier'] = pd.qcut(update_data['update_events'], 4, labels=['Very Low', 'Low', 'High', 'Very High'])
    tier_metrics = update_data.groupby('update_tier')[['active_devices_last_30_days', 'rolling_total_average_rating']].mean().reset_index()
    
    x = np.arange(len(tier_metrics))
    width = 0.35
    
    bars1 = ax2.bar(x - width/2, tier_metrics['active_devices_last_30_days'], width, 
                   label='Active Devices', color='skyblue', alpha=0.8)
    ax2b = ax2.twinx()
    bars2 = ax2b.bar(x + width/2, tier_metrics['rolling_total_average_rating'], width,
                    label='Avg Rating', color='salmon', alpha=0.8)
    
    ax2.set_xlabel('Update Frequency Tier')
    ax2.set_ylabel('Active Devices (30 days)')
    ax2b.set_ylabel('Average Rating')
    ax2.set_xticks(x)
    ax2.set_xticklabels(tier_metrics['update_tier'])
    ax2.set_title('Metrics by Update Frequency Tier')
    ax2.tick_params(axis='x', rotation=45)
    
    # Combine legends
    lines1, labels1 = ax2.get_legend_handles_labels()
    lines2, labels2 = ax2b.get_legend_handles_labels()
    ax2.legend(lines1 + lines2, labels1 + labels2, loc='upper left')
    
    plt.tight_layout()
    plt.savefig('update_frequency_interaction.png', dpi=300, bbox_inches='tight')
    plt.close()

# Close database connection
conn.close()

print("Visualizations created successfully!")
print("1. acquisition_efficiency_decay.png")
print("2. nonlinear_relationships.png")
print("3. multidimensional_decay_analysis.png")
print("4. update_frequency_interaction.png")
