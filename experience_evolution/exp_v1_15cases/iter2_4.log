print("Correlation with high-value label:")
def pointbiserial(cont, bin_vec):
    bin_vec = bin_vec.astype(float)
    m1 = cont[bin_vec == 1].mean()
    m0 = cont[bin_vec == 0].mean()
    s = cont.std()
    n1 = (bin_vec == 1).sum()
    n0 = (bin_vec == 0).sum()
    n = n1 + n0
    if s == 0 or n == 0:
        return 0
    return (m1 - m0) / s * np.sqrt(n1 * n0 / (n * n))

dimensions = ['latest_nps_rating', 'count_active_days', 'count_active_months',
              'sum_minutes', 'sum_events', 'average_daily_minutes', 'average_daily_events',
              'total_pages_viewed', 'total_features_clicked', 'distinct_features_used']
