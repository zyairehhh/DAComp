import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-067.sqlite')

# Get hires per source with gender and race
df = pd.read_sql_query("""
SELECT tps.source_name,
       ae.candidate_gender,
       ae.candidate_race,
       COUNT(DISTINCT cs.candidate_id) as hire_count
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
GROUP BY tps.source_name, ae.candidate_gender, ae.candidate_race
""", conn)

print("Raw hire counts by gender and race:")
print(df)

# Pivot for gender
gender_pivot = df.groupby(['source_name', 'candidate_gender'])['hire_count'].sum().unstack(fill_value=0)
gender_pivot['total_hires'] = gender_pivot.sum(axis=1)
if 'Female' in gender_pivot.columns:
    gender_pivot['female_hire_percentage'] = gender_pivot['Female'] / gender_pivot['total_hires'] * 100
    gender_pivot['female_hire_representation'] = gender_pivot['Female'] / gender_pivot['total_hires'] * 100
else:
    gender_pivot['female_hire_percentage'] = 0
if 'Male' in gender_pivot.columns:
    gender_pivot['male_hire_percentage'] = gender_pivot['Male'] / gender_pivot['total_hires'] * 100
print(gender_pivot)

# Pivot for race (non-white vs white)
# Assuming race categories include White, Black, Asian, Hispanic, etc.
# We'll group into white vs non-white
def is_non_white(race):
    if race is None:
        return None
    # If race string contains 'White' (case-insensitive) treat as white
    race_lower = race.lower()
    if 'white' in race_lower:
        return 'White'
    else:
        return 'Non-White'

df['race_group'] = df['candidate_race'].apply(is_non_white)
# Drop unknown
df2 = df[df['race_group'].notnull()]
race_pivot = df2.groupby(['source_name', 'race_group'])['hire_count'].sum().unstack(fill_value=0)
race_pivot['total_hires'] = race_pivot.sum(axis=1)
if 'Non-White' in race_pivot.columns:
    race_pivot['non_white_hire_percentage'] = race_pivot['Non-White'] / race_pivot['total_hires'] * 100
print(race_pivot)

# Combine diversity metrics
diversity = pd.DataFrame()
diversity['source_name'] = gender_pivot.index
diversity['total_hires'] = gender_pivot['total_hires']
diversity['female_hire_pct'] = gender_pivot['female_hire_percentage']
diversity['non_white_hire_pct'] = race_pivot['non_white_hire_percentage']
print("\nDiversity per source:")
print(diversity)

diversity.to_csv('diversity_per_source.csv', index=False)
```

