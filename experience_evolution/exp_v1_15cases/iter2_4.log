plt.scatter(account_df['average_daily_minutes'], account_df['average_daily_events'],
            c=colors, alpha=0.6, edgecolors='k', linewidths=0.5)
plt.xlabel('Average daily minutes')
plt.ylabel('Average daily events')
plt.title('High‑Value Customers (red) vs Others (gray)')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('scatter_high_value.png', dpi=300)
plt.close()

# Compute trend slope per account using monthly aggregation
# Load visitor daily metrics
daily_df = pd.read_sql_query('SELECT * FROM pendo__visitor_daily_metrics', conn)
# Merge with account via visitor: let's get pendo__visitor mapping
visitor_df = pd.read_sql_query('SELECT visitor_id, account_id FROM pendo__visitor', conn)
daily_df = daily_df.merge(visitor_df, on='visitor_id', how='left')
# Drop rows without account_id
daily_df = daily_df.dropna(subset=['account_id'])
# Convert date_day to datetime
daily_df['date_day'] = pd.to_datetime(daily_df['date_day'])
# Aggregate by account and month
daily_df['year_month'] = daily_df['date_day'].dt.to_period('M')
monthly = daily_df.groupby(['account_id', 'year_month']).agg({
    'sum_minutes': 'sum',
    'sum_events': 'sum'
}).reset_index()
# Compute per‑account linear trend over months (slope of sum_minutes)
slopes = []
for acc_id, group in monthly.groupby('account_id'):
    # need at least 2 months
    if len(group) >= 2:
        # convert period to numeric month index
        group = group.copy()
        group['month_idx'] = np.arange(len(group))
        # linear regression slope
        x = group['month_idx'].values
        y = group['sum_minutes'].values
        slope, _ = np.polyfit(x, y, 1)
        slopes.append(slope)
    else:
        slopes.append(np.nan)
# Create DataFrame of slopes per account (only for accounts with enough data)
account_slopes = pd.DataFrame({
    'account_id': list(monthly['account_id'].unique()),
    'monthly_slope': slopes
})
# Merge with account_df
account_df = account_df.merge(account_slopes, on='account_id', how='left')

# Plot 4: Distribution of monthly slopes
plt.figure(figsize=(8, 5))
plt.hist(account_df['monthly_slope'].dropna(), bins=50, edgecolor='black', color='seagreen')
plt.xlabel('Monthly trend slope (minutes per month)')
plt.ylabel('Number of accounts')
plt.title('Distribution of Monthly Engagement Trends')
plt.axvline(x=0, color='red', linestyle='--', label='zero trend')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('trend_slope_distribution.png', dpi=300)
plt.close()

# Also compute correlation between current features and slope (as in stage1)
# We'll compute and maybe print, but not required for plot.
corr_with_slope = {}
for feat in features:
    corr = account_df[feat].corr(account_df['monthly_slope'])
    corr_with_slope[feat] = corr
print("Correlations between features and monthly slope:")
for feat, corr in corr_with_slope.items():
    print(f"{feat}: {corr:.4f}")

conn.close()
print("Plots saved: feature_correlations.png, model_weights.png, scatter_high_value.png, trend_slope_distribution.png")
```
