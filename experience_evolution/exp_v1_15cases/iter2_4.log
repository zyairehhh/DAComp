overall_cvr = df.loc[df['clicks']>0, 'CVR'].mean()
problematic['intent_match_ratio'] = problematic['CVR'] / overall_cvr

top10 = problematic.nlargest(10, 'spend')[['ad_group_id', 'campaign_name', 'spend', 'CTR', 'CVR', 'intent_match_ratio']]
print("| Rank | Ad Group ID | Campaign Name | Spend ($) | CTR | CVR | Intent Match Ratio |")
print("|------|-------------|---------------|-----------|-----|-----|-------------------|")
for i, (idx, row) in enumerate(top10.iterrows(), 1):
    print(f"| {i} | {row['ad_group_id']} | {row['campaign_name']} | {row['spend']:.2f} | {row['CTR']:.4f} | {row['CVR']:.4f} | {row['intent_match_ratio']:.3f} |")
''')
