    "Pickup Location",
    COUNT(*) as rides,
    AVG("Booking Value" / "Ride Distance") as avg_per_km
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Pickup Location"
HAVING 
    COUNT(*) >= 100
ORDER BY 
    avg_per_km DESC
LIMIT 10
"""
df3 = pd.read_sql_query(query3, conn)
print("\n=== Top 10 Pickup Locations by Per‑KM Fare (min 100 rides) ===")
print(df3.to_string(index=False))

# 4. Drop locations
query4 = """
