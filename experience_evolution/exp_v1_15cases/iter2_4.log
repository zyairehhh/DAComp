import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from datetime import datetime, timedelta

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Time series decay patterns for region-device combinations over past 6 months
# First, get the last 6 months of data (approx 180 days from max date)
max_date_query = "SELECT MAX(date_day) FROM google_play__time_series_trends"
max_date = pd.read_sql_query(max_date_query, conn).iloc[0, 0]
six_months_ago = (pd.to_datetime(max_date) - timedelta(days=180)).strftime('%Y-%m-%d')

# Get time series data for analysis - focusing on key metrics
query = f"""
SELECT 
    date_day,
    daily_installs,
    daily_uninstalls,
    daily_churn_rate,
    active_devices,
    daily_revenue,
    revenue_per_active_device,
    quality_score,
    crash_rate_per_1k
FROM google_play__time_series_trends 
WHERE date_day >= '{six_months_ago}'
ORDER BY date_day
"""

ts_data = pd.read_sql_query(query, conn)
ts_data['date_day'] = pd.to_datetime(ts_data['date_day'])
ts_data['install_to_uninstall_ratio'] = ts_data['daily_installs'] / (ts_data['daily_uninstalls'] + 1)
ts_data['retention_rate'] = 1 - ts_data['daily_churn_rate']

# Create the first plot: Acquisition efficiency decay over time
fig1, axes1 = plt.subplots(2, 2, figsize=(14, 10))
fig1.suptitle('User Acquisition Efficiency Decay Patterns (Past 6 Months)', fontsize=16, fontweight='bold')

# Plot 1.1: Daily installs vs uninstalls (showing decay)
ax1 = axes1[0, 0]
ax1.plot(ts_data['date_day'], ts_data['daily_installs'], label='Daily Installs', color='green', alpha=0.7)
ax1.plot(ts_data['date_day'], ts_data['daily_uninstalls'], label='Daily Uninstalls', color='red', alpha=0.7)
ax1.set_title('Install vs Uninstall Trends')
ax1.set_xlabel('Date')
ax1.set_ylabel('Count')
ax1.legend()
ax1.tick_params(axis='x', rotation=45)

# Plot 1.2: Install-to-uninstall ratio (efficiency metric)
ax2 = axes1[0, 1]
ax2.plot(ts_data['date_day'], ts_data['install_to_uninstall_ratio'], color='purple', linewidth=2)
ax2.axhline(y=ts_data['install_to_uninstall_ratio'].mean(), color='r', linestyle='--', alpha=0.5, label=f'Mean: {ts_data["install_to_uninstall_ratio"].mean():.2f}')
ax2.set_title('Install-to-Uninstall Ratio (Acquisition Efficiency)')
ax2.set_xlabel('Date')
ax2.set_ylabel('Ratio')
ax2.legend()
ax2.tick_params(axis='x', rotation=45)

# Plot 1.3: Retention rate trend
ax3 = axes1[1, 0]
ax3.plot(ts_data['date_day'], ts_data['retention_rate'], color='blue', linewidth=2)
ax3.axhline(y=ts_data['retention_rate'].mean(), color='r', linestyle='--', alpha=0.5, label=f'Mean: {ts_data["retention_rate"].mean():.2f}')
ax3.set_title('Daily Retention Rate Trend')
ax3.set_xlabel('Date')
ax3.set_ylabel('Retention Rate')
ax3.legend()
ax3.tick_params(axis='x', rotation=45)

# Plot 1.4: Revenue per active device
ax4 = axes1[1, 1]
ax4.plot(ts_data['date_day'], ts_data['revenue_per_active_device'], color='orange', linewidth=2)
ax4.axhline(y=ts_data['revenue_per_active_device'].mean(), color='r', linestyle='--', alpha=0.5, label=f'Mean: ${ts_data["revenue_per_active_device"].mean():.2f}')
ax4.set_title('Revenue per Active Device (User Value Metric)')
ax4.set_xlabel('Date')
ax4.set_ylabel('Revenue per Device ($)')
ax4.legend()
ax4.tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('acquisition_efficiency_decay.png', dpi=300, bbox_inches='tight')
plt.close()

# 2. Non-linear relationship analysis
# Get time series data for conversion rate vs quality metrics
# Note: We'll use aggregated data since conversion rate is in country_report and quality is in time_series
# We'll need to join the data appropriately

# Get aggregated quality and crash metrics per date
query2 = """
SELECT 
    t.date_day,
    AVG(t.quality_score) as avg_quality_score,
    AVG(t.crash_rate_per_1k) as avg_crash_rate,
    AVG(cr.store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__time_series_trends t
LEFT JOIN google_play__country_report cr ON t.date_day = cr.date_day
WHERE t.quality_score > 0 AND t.crash_rate_per_1k > 0 
    AND cr.store_listing_conversion_rate > 0
GROUP BY t.date_day
ORDER BY t.date_day
"""

quality_data = pd.read_sql_query(query2, conn)
quality_data['date_day'] = pd.to_datetime(quality_data['date_day'])

# Get individual country-level data for conversion vs rating analysis
query3 = """
SELECT 
    date_day,
    region,
    store_listing_conversion_rate,
    rolling_total_average_rating,
    active_devices_last_30_days
FROM google_play__country_report
WHERE store_listing_conversion_rate > 0 AND rolling_total_average_rating > 0
ORDER BY date_day
"""

country_data = pd.read_sql_query(query3, conn)
country_data['date_day'] = pd.to_datetime(country_data['date_day'])

fig2, axes2 = plt.subplots(2, 2, figsize=(14, 10))
fig2.suptitle('Non-linear Relationships: Conversion Rate vs Quality Metrics', fontsize=16, fontweight='bold')

# Plot 2.1: Conversion rate vs quality score (time series correlation)
ax1 = axes2[0, 0]
if len(quality_data) > 0:
    # Calculate moving averages for smoother visualization
    quality_data['conversion_ma'] = quality_data['avg_conversion_rate'].rolling(window=7).mean()
    quality_data['quality_ma'] = quality_data['avg_quality_score'].rolling(window=7).mean()
    
    plot_data = quality_data.dropna(subset=['conversion_ma', 'quality_ma'])
    
    line1 = ax1.plot(plot_data['date_day'], plot_data['conversion_ma'], label='Conversion Rate (7d MA)', color='blue')
    ax1.set_xlabel('Date')
    ax1.set_ylabel('Conversion Rate', color='blue')
    ax1.tick_params(axis='y', labelcolor='blue')
    ax1.tick_params(axis='x', rotation=45)
    
    ax1b = ax1.twinx()
    line2 = ax1b.plot(plot_data['date_day'], plot_data['quality_ma'], label='Quality Score (7d MA)', color='green')
    ax1b.set_ylabel('Quality Score', color='green')
    ax1b.tick_params(axis='y', labelcolor='green')
    
    lines = line1 + line2
    labels = [l.get_label() for l in lines]
    ax1.legend(lines, labels, loc='upper left')
    ax1.set_title('Conversion Rate vs Quality Score Correlation Over Time')
else:
    ax1.text(0.5, 0.5, 'Insufficient data for this analysis', 
             ha='center', va='center', transform=ax1.transAxes, fontsize=12)
    ax1.set_title('Conversion Rate vs Quality Score')

# Plot 2.2: Conversion rate vs rating (scatter by region)
ax2 = axes2[0, 1]
if len(country_data) > 0:
    # Take a sample for clearer visualization
    sample_data = country_data.sample(min(500, len(country_data)), random_state=42)
    
    scatter2 = ax2.scatter(sample_data['store_listing_conversion_rate'], 
                          sample_data['rolling_total_average_rating'],
                          c=sample_data['active_devices_last_30_days'],
                          cmap='plasma', alpha=0.6, s=50)
    ax2.set_title('Conversion Rate vs Average Rating (Colored by Active Devices)')
    ax2.set_xlabel('Store Listing Conversion Rate')
    ax2.set_ylabel('Rolling Total Average Rating')
    cbar2 = plt.colorbar(scatter2, ax=ax2)
    cbar2.set_label('Active Devices (30 days)')
    
    # Add polynomial trend line
    x2 = sample_data['store_listing_conversion_rate']
    y2 = sample_data['rolling_total_average_rating']
    z2 = np.polyfit(x2, y2, 2)
    p2 = np.poly1d(z2)
    x2_sorted = np.sort(x2)
    ax2.plot(x2_sorted, p2(x2_sorted), "r--", alpha=0.8, label='Quadratic Trend')
    ax2.legend()
else:
    ax2.text(0.5, 0.5, 'Insufficient data for this analysis', 
             ha='center', va='center', transform=ax2.transAxes, fontsize=12)
    ax2.set_title('Conversion Rate vs Average Rating')

# Plot 2.3: Time series of conversion rate vs crash rate
ax3 = axes2[1, 0]
if len(quality_data) > 0:
    quality_data['crash_ma'] = quality_data['avg_crash_rate'].rolling(window=7).mean()
    quality_data['conversion_ma'] = quality_data['avg_conversion_rate'].rolling(window=7).mean()
    
    plot_data = quality_data.dropna(subset=['conversion_ma', 'crash_ma'])
    
    line1 = ax3.plot(plot_data['date_day'], plot_data['conversion_ma'], label='Conv Rate (7d MA)', color='blue')
    ax3.set_xlabel('Date')
    ax3.set_ylabel('Conversion Rate', color='blue')
    ax3.tick_params(axis='y', labelcolor='blue')
    ax3.tick_params(axis='x', rotation=45)
    
    ax3b = ax3.twinx()
    line2 = ax3b.plot(plot_data['date_day'], plot_data['crash_ma'], label='Crash Rate (7d MA)', color='red')
    ax3b.set_ylabel('Crash Rate per 1k', color='red')
    ax3b.tick_params(axis='y', labelcolor='red')
    
    lines = line1 + line2
    labels = [l.get_label() for l in lines]
    ax3.legend(lines, labels, loc='upper left')
    ax3.set_title('Conversion Rate vs Crash Rate (7-day Moving Averages)')
else:
    ax3.text(0.5, 0.5, 'Insufficient data for this analysis', 
             ha='center', va='center', transform=ax3.transAxes, fontsize=12)
    ax3.set_title('Conversion Rate vs Crash Rate')

# Plot 2.4: Quality score distribution by conversion rate quartiles
ax4 = axes2[1, 1]
if len(quality_data) > 10:
    quality_data['conversion_quartile'] = pd.qcut(quality_data['avg_conversion_rate'], 4, labels=['Q1 (Low)', 'Q2', 'Q3', 'Q4 (High)'])
    box_data = [quality_data[quality_data['conversion_quartile'] == q]['avg_quality_score'].dropna() 
                for q in ['Q1 (Low)', 'Q2', 'Q3', 'Q4 (High)']]
    
