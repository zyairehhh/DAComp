def classify_experience(exp):
    if isinstance(exp, str):
        exp_lower = exp.lower()
        # Check for Chinese phrases indicating specific skill
        # We'll use keywords from data: '经验', '熟练', '有...经验', etc.
        # For simplicity, we can categorize as:
        # 1. 'Specific skill / other experience' if contains '经验' and not '不限' and not '应届'
        # 2. 'Fresh graduates' if contains '应届' or '毕业生' without experience requirement
        # 3. 'No limit' if contains '不限' or '无经验要求'
        # 4. 'Other'
        if '经验' in exp and '不限' not in exp and '无经验' not in exp:
            return 'Specific skill / other experience'
        elif '应届' in exp or '毕业生' in exp:
            return 'Fresh graduates'
        elif '不限' in exp or '无经验' in exp or '经验不限' in exp:
            return 'No limit'
        else:
            return 'Other'
    else:
        return 'Missing'

