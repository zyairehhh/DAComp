```
import sqlite3
import pandas as pd
import numpy as np
import scipy.stats as stats

conn = sqlite3.connect('dacomp-034.sqlite')

# Combine both tables
query = """
SELECT 
    a.sku_id,
    a.`SKU Quantity` as quantity,
    a.`SKU Price` as original_price,
    a.`SKU Selling Price` as selling_price,
    a.`SKU Cost Price` as cost_price,
    c.`Level 1 Category ID` as cat1_id,
    c.`Level 1 Category Name` as cat1_name
FROM attachment_1 a
LEFT JOIN attachment_4 c ON a.sku_id = c.sku_id
WHERE a.`SKU Cost Price` > 0 AND a.`SKU Price` > 0

UNION ALL

SELECT 
    b.sku_id,
    b.`SKU Quantity` as quantity,
    b.`SKU Price` as original_price,
    b.`SKU Selling Price` as selling_price,
    b.`SKU Cost Price` as cost_price,
    c.`Level 1 Category ID` as cat1_id,
    c.`Level 1 Category Name` as cat1_name
FROM attachment_2 b
LEFT JOIN attachment_4 c ON b.sku_id = c.sku_id
WHERE b.`SKU Cost Price` > 0 AND b.`SKU Price` > 0;
"""

df = pd.read_sql_query(query, conn)
df['discount_depth'] = (df['original_price'] - df['selling_price']) / df['original_price']
df['sales_revenue'] = df['selling_price'] * df['quantity']

# Remove outliers where discount_depth > 1 or < 0
df = df[(df['discount_depth'] >= 0) & (df['discount_depth'] <= 1)]

# per category correlation between discount depth and quantity
categories = df.groupby(['cat1_id', 'cat1_name']).filter(lambda x: len(x) >= 30)  # require minimum transactions
corr_results = []
for (cat_id, cat_name), group in categories.groupby(['cat1_id', 'cat1_name']):
    if len(group) < 2:
        continue
    # Correlation between discount depth and quantity per transaction
    corr, pval = stats.pearsonr(group['discount_depth'], group['quantity'])
    # Aggregate metrics
    total_revenue = group['sales_revenue'].sum()
    total_units = group['quantity'].sum()
    avg_discount = group['discount_depth'].mean()
    median_discount = group['discount_depth'].median()
    corr_results.append({
        'Category ID': cat_id,
        'Category Name': cat_name,
        'Transaction Count': len(group),
        'Total Units': total_units,
        'Total Revenue': total_revenue,
        'Avg Discount Depth': avg_discount,
        'Median Discount Depth': median_discount,
        'Correlation (Discount vs Quantity)': corr,
        'P-value': pval
    })

corr_df = pd.DataFrame(corr_results)
print("Per-category correlation between discount depth and quantity sold per transaction:")
print(corr_df.sort_values('Total Units', ascending=False))

# Save to CSV
corr_df.to_csv('category_correlation.csv', index=False)

# Overall relationship discount depth vs units sold per transaction (scatter)
import matplotlib.pyplot as plt
# Not needed for stage1

# Compute aggregated sales (units) per discount depth bin across all categories
df['discount_bin'] = pd.cut(df['discount_depth'], bins=np.linspace(0, 1, 11), labels=[f'{i*10:.0f}-{(i+1)*10:.0f}%' for i in range(10)])
bin_agg = df.groupby('discount_bin').agg(
    total_revenue=('sales_revenue', 'sum'),
    total_units=('quantity', 'sum'),
    avg_discount=('discount_depth', 'mean'),
    transaction_count=('discount_depth', 'count')
).reset_index()
print("\nAggregated by discount depth bin:")
print(bin_agg)

# Compute elasticity: percentage change in units sold per percentage point discount depth
# We'll treat each bin as a data point, compute log-log regression
bin_agg['midpoint'] = [0.05, 0.15, 0.25, 0.35, 0.45, 0.55, 0.65, 0.75, 0.85, 0.95]
log_units = np.log(bin_agg['total_units'] + 1)
log_discount = np.log(bin_agg['midpoint'] + 1e-6)
elasticity, _ = stats.linregress(log_discount, log_units)[:2]
print(f"\nApproximate elasticity (log-log) across bins: {elasticity:.3f}")

conn.close()
```
