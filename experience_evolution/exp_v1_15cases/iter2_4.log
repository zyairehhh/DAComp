```
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')

# Load visitor data
visitor_df = pd.read_sql_query('''
SELECT 
    visitor_id,
    account_id,
    latest_nps_rating,
    count_active_days,
    count_active_months,
    sum_minutes,
    sum_events,
    average_daily_minutes,
    average_daily_events,
    CAST(strftime('%s', last_visit) - strftime('%s', first_visit_at) AS REAL) / (3600*24) as tenure_days
FROM pendo__visitor
''', conn)

# Load visitor daily metrics aggregated per visitor
daily_agg = pd.read_sql_query('''
SELECT 
    visitor_id,
    SUM(count_pages_viewed) as total_pages_viewed,
    SUM(count_features_clicked) as total_features_clicked,
    AVG(sum_minutes) as avg_daily_minutes,
    COUNT(DISTINCT date_day) as active_days
FROM pendo__visitor_daily_metrics
GROUP BY visitor_id
''', conn)

# Load visitor feature engagement
feature_engagement = pd.read_sql_query('''
SELECT 
    visitor_id,
    COUNT(DISTINCT feature_id) as distinct_features_used,
    SUM(sum_clicks) as total_feature_clicks,
    AVG(sum_minutes) as avg_minutes_per_feature
FROM pendo__visitor_feature
GROUP BY visitor_id
''', conn)

# Merge
df = visitor_df.merge(daily_agg, on='visitor_id', how='left')
df = df.merge(feature_engagement, on='visitor_id', how='left')

# Fill missing values
df.fillna(0, inplace=True)

# Compute correlations
numeric_cols = ['latest_nps_rating', 'count_active_days', 'count_active_months',
                'sum_minutes', 'sum_events', 'average_daily_minutes', 'average_daily_events',
                'tenure_days', 'total_pages_viewed', 'total_features_clicked',
                'active_days', 'distinct_features_used', 'total_feature_clicks']

print("Data shape:", df.shape)
print("\nCorrelation matrix (with sum_minutes and sum_events as proxies for value):")
corr_matrix = df[numeric_cols].corr()
print(corr_matrix[['sum_minutes', 'sum_events']].sort_values('sum_minutes', ascending=False))

# Suggest high-value definition based on business logic
# For example, top 15% by sum_minutes + sum_events + NPS
df['composite_score'] = (df['sum_minutes'] / df['sum_minutes'].max() + 
                         df['sum_events'] / df['sum_events'].max() + 
                         df['latest_nps_rating'] / 10) / 3

# Top 15%
threshold = df['composite_score'].quantile(0.85)
df['high_value_label'] = (df['composite_score'] >= threshold).astype(int)

print(f"\nHigh-value customers (top 15% composite): {df['high_value_label'].sum()} out of {len(df)}")
print("High-value rate:", df['high_value_label'].mean())

# Save to CSV for later analysis
df.to_csv('visitor_features.csv', index=False)
print("\nSaved visitor_features.csv")

conn.close()
```
