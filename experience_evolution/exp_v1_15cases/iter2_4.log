```
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re
import matplotlib.pyplot as plt
from collections import Counter

# Connect to the database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

print("Total rows:", len(df))

# Filter for vocational school graduates
voc_df = df[df['Education Requirement'].str.contains('Vocational school', na=False, case=False)].copy()
print("Vocational school jobs count:", len(voc_df))

# Function to extract salary bounds
def extract_salary_bounds(salary_str):
    if pd.isna(salary_str):
        return None, None
    # Find all numbers in the string
    numbers = re.findall(r'[\d,]+\.?\d*', salary_str.replace(',', ''))
    if not numbers:
        return None, None
    # Convert to integers
    nums = [int(float(num)) for num in numbers if float(num) < 100000]  # filter unrealistic numbers
    # If many numbers, look for pattern like "X-Y" or "X-Y yuan/month"
    # Try to find numbers that look like a range
    if len(nums) >= 2:
        # Often first two numbers are the range
        lower = min(nums[:2])
        upper = max(nums[:2])
        # Basic sanity check: lower should be <= upper and reasonable
        if lower > 0 and upper <= 50000 and lower <= upper:
            return lower, upper
    return None, None

# Extract salary bounds
bounds = voc_df['Salary Range'].apply(extract_salary_bounds)
voc_df.loc[:, 'salary_lower'] = bounds.apply(lambda x: x[0] if x else None)
voc_df.loc[:, 'salary_upper'] = bounds.apply(lambda x: x[1] if x else None)
voc_df.loc[:, 'salary_mid'] = voc_df.apply(lambda row: (row['salary_lower'] + row['salary_upper']) / 2 
                                    if row['salary_lower'] and row['salary_upper'] else None, axis=1)

# Remove rows with missing salary
salary_df = voc_df.dropna(subset=['salary_lower', 'salary_upper']).copy()
print("Jobs with valid salary range:", len(salary_df))

# Check salary statistics
print(f"Salary min lower: {salary_df['salary_lower'].min()}")
print(f"Salary max upper: {salary_df['salary_upper'].max()}")

# Remove extreme outliers for better visualization
# Consider salaries up to 30000 as reasonable
filtered_salary = salary_df[(salary_df['salary_upper'] <= 30000) & (salary_df['salary_lower'] >= 100)]
print(f"Rows after removing extremes: {len(filtered_salary)}")

# 1. Starting Salary Distribution (histogram)
plt.figure(figsize=(10, 6))
plt.hist(filtered_salary['salary_mid'].dropna(), bins=50, alpha=0.7, edgecolor='black', density=False)
plt.xlabel('Monthly Salary (RMB)')
plt.ylabel('Frequency')
plt.title('Distribution of Starting Salaries for Vocational School Graduates')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('salary_distribution_clean.png', dpi=150)
print("Saved salary_distribution_clean.png")

# 2. Benefits distribution (top benefits) - improved parsing
def extract_benefits(benefit_str):
    if pd.isna(benefit_str):
        return []
    s = str(benefit_str)
    # Replace common Chinese punctuation with comma
    s = s.replace('，', ',').replace('、', ',').replace(';', ',').replace('；', ',')
    # Sometimes benefits are separated by space or period - handle carefully
    s = s.replace('.', ',')
    # Split by comma
    parts = [part.strip() for part in s.split(',') if part.strip()]
    # Filter out very short items (likely noise) and English stopwords
    # Also remove "and" "or" etc.
    stopwords = {'and', 'or', '&', '/', '等', 'etc.', 'etc', '等。', '等。', '等。'}
    filtered = []
    for part in parts:
        part_lower = part.lower()
        # Keep only meaningful benefits (more than 2 chars) and not stopwords
        if len(part) > 2 and part.lower() not in stopwords:
            # Remove trailing/leading punctuation
            part = part.strip(' .;,，、')
            if part:
                filtered.append(part)
    return filtered

all_benefits = []
for b in voc_df['Benefits'].dropna():
    all_benefits.extend(extract_benefits(b))

# Count benefits
benefit_counts = Counter(all_benefits)
# Get top 15 benefits
top_benefits = benefit_counts.most_common(15)

# Plot benefits distribution
plt.figure(figsize=(12, 8))
benefits_names = [b[0] for b in top_benefits]
benefits_counts = [b[1] for b in top_benefits]
y_pos = np.arange(len(benefits_names))
plt.barh(y_pos, benefits_counts, alpha=0.7)
plt.yticks(y_pos, benefits_names, fontsize=9)
plt.xlabel('Count')
plt.title('Top 15 Benefits Offered for Vocational School Graduates')
plt.gca().invert_yaxis()
plt.tight_layout()
plt.savefig('benefits_distribution_clean.png', dpi=150)
print("Saved benefits_distribution_clean.png")

# 3. Factors affecting salary
# Work location analysis
def get_city(location_str):
    if pd.isna(location_str):
        return None
    # Common city patterns
    cities = ['Xiamen', 'Quanzhou', 'Fuzhou', 'Putian', 'Zhangzhou', 'Nanping', 'Longyan', 'Sanming', 'Ningde']
    s = str(location_str)
    for city in cities:
        if city.lower() in s.lower():
            return city
    # Return first word if none matched
    return s.split()[0] if s.split() else None

filtered_salary.loc[:, 'city'] = filtered_salary['Work Location'].apply(get_city)
city_salary = filtered_salary.groupby('city')['salary_mid'].mean().dropna().sort_values(ascending=False).head(10)

plt.figure(figsize=(10, 6))
city_salary.plot(kind='bar', alpha=0.7)
plt.xlabel('City')
plt.ylabel('Average Monthly Salary (RMB)')
plt.title('Average Salary by City for Vocational School Graduates')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('city_salary.png', dpi=150)
print("Saved city_salary.png")

# 4. Work Experience vs Salary - simplified version
