'''
import sqlite3
import pandas as pd
import numpy as np
from sklearn.preprocessing import MinMaxScaler

conn = sqlite3.connect('dacomp-092.sqlite')

# Get all customers with necessary metrics
# 1. Profit volatility metrics
# Coefficient of variation of gross_profit over past 12 months
max_date_query = "SELECT MAX(transaction_date) FROM quickbooks__profitability_analysis;"
max_date = pd.read_sql_query(max_date_query, conn).iloc[0,0]
max_date = pd.to_datetime(max_date)
start_date = max_date - pd.DateOffset(months=12)

monthly_profit_query = """
SELECT customer_id, 
       strftime('%Y-%m', transaction_date) AS month,
       SUM(gross_profit) AS monthly_gross_profit
FROM quickbooks__profitability_analysis
WHERE transaction_date >= ? AND transaction_date <= ?
GROUP BY customer_id, month
"""
monthly_profit = pd.read_sql_query(monthly_profit_query, conn, params=[start_date.strftime('%Y-%m-%d'), max_date.strftime('%Y-%m-%d')])

cv_data = []
for cust_id, group in monthly_profit.groupby('customer_id'):
    profits = group['monthly_gross_profit'].values
    if len(profits) > 1:
        mean = np.mean(profits)
        std = np.std(profits, ddof=1)
        cv = std / mean if mean != 0 else 0
    else:
        cv = 0
    cv_data.append({'customer_id': cust_id, 'coeff_var': cv})
cv_df = pd.DataFrame(cv_data)

# 2. Quarter-over-quarter invoice total growth rate variance
quarterly_query = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) AS quarter_invoice_total
FROM quickbooks__profitability_analysis
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
"""
quarterly = pd.read_sql_query(quarterly_query, conn)

growth_var_data = []
for cust_id, group in quarterly.groupby('customer_id'):
    group = group.sort_values(['revenue_year', 'revenue_quarter'])
    if len(group) > 1:
        group['prev'] = group['quarter_invoice_total'].shift(1)
        group['growth'] = (group['quarter_invoice_total'] - group['prev']) / group['prev']
        growth_rates = group['growth'].dropna()
        if len(growth_rates) > 1:
            var = np.var(growth_rates, ddof=1)
        else:
            var = 0
    else:
        var = 0
    growth_var_data.append({'customer_id': cust_id, 'growth_variance': var})
growth_var_df = pd.DataFrame(growth_var_data)

# 3. Behavioral features from customer_analytics
behavior_query = """
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation, lifecycle_stage, customer_value_segment, risk_assessment
FROM quickbooks__customer_analytics
"""
behavior_df = pd.read_sql_query(behavior_query, conn)

# Map categorical to ordinal scores
# RFM segment risk: assume 'At Risk' highest risk, 'Need Attention' high, 'Potential Loyalists' medium, etc.
rfm_risk = {
    'At Risk': 5,
    'Need Attention': 4,
    'New Customers': 3,
    'Potential Loyalists': 2,
    'Loyal Customers': 1,
    'Champions': 0
}
behavior_df['rfm_risk_score'] = behavior_df['rfm_segment'].map(rfm_risk).fillna(3)

# Payment behavior: Poor=4, Average=3, Good=2, Excellent=1
pay_risk = {'Poor': 4, 'Average': 3, 'Good': 2, 'Excellent': 1}
behavior_df['payment_risk_score'] = behavior_df['payment_behavior'].map(pay_risk).fillna(3)

# Revenue trend correlation: negative correlation indicates unstable revenue, higher risk
behavior_df['trend_risk_score'] = 1 - behavior_df['revenue_trend_correlation']  # higher if correlation negative

# Lifecycle stage: New Customer higher risk, Loyal lower? We'll assign: New Customer=3, Growing=2, Mature=1, Loyal Customer=0
lifecycle_risk = {'New Customer': 3, 'Growing': 2, 'Mature': 1, 'Loyal Customer': 0}
behavior_df['lifecycle_risk_score'] = behavior_df['lifecycle_stage'].map(lifecycle_risk).fillna(2)

# 4. Financial risk: outstanding balance relative to total revenue
outstanding_query = """
SELECT customer_id, SUM(outstanding_balance) AS total_outstanding
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
outstanding_df = pd.read_sql_query(outstanding_query, conn)

# Revenue per customer (total invoice_total)
revenue_query = """
SELECT customer_id, SUM(invoice_total) AS total_revenue
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
revenue_df = pd.read_sql_query(revenue_query, conn)

# Merge
risk_df = cv_df.merge(growth_var_df, on='customer_id', how='outer')
risk_df = risk_df.merge(behavior_df, on='customer_id', how='left')
risk_df = risk_df.merge(outstanding_df, on='customer_id', how='left')
risk_df = risk_df.merge(revenue_df, on='customer_id', how='left')

# Compute outstanding ratio
risk_df['outstanding_ratio'] = risk_df['total_outstanding'] / (risk_df['total_revenue'] + 1e-6)

# Normalize each risk dimension to 0-1 scale
scaler = MinMaxScaler()
risk_df['coeff_var_norm'] = scaler.fit_transform(risk_df[['coeff_var']])
risk_df['growth_variance_norm'] = scaler.fit_transform(risk_df[['growth_variance']])
risk_df['rfm_risk_norm'] = scaler.fit_transform(risk_df[['rfm_risk_score']])
risk_df['payment_risk_norm'] = scaler.fit_transform(risk_df[['payment_risk_score']])
risk_df['trend_risk_norm'] = scaler.fit_transform(risk_df[['trend_risk_score']])
risk_df['lifecycle_risk_norm'] = scaler.fit_transform(risk_df[['lifecycle_risk_score']])
risk_df['outstanding_ratio_norm'] = scaler.fit_transform(risk_df[['outstanding_ratio']])

# Compute composite risk score (weighted)
weights = {
    'coeff_var': 0.2,
    'growth_variance': 0.15,
    'rfm_risk': 0.15,
    'payment_risk': 0.2,
    'trend_risk': 0.1,
    'lifecycle_risk': 0.1,
    'outstanding_ratio': 0.1
}
risk_df['composite_risk_score'] = (
    risk_df['coeff_var_norm'] * weights['coeff_var'] +
    risk_df['growth_variance_norm'] * weights['growth_variance'] +
    risk_df['rfm_risk_norm'] * weights['rfm_risk'] +
    risk_df['payment_risk_norm'] * weights['payment_risk'] +
    risk_df['trend_risk_norm'] * weights['trend_risk'] +
    risk_df['lifecycle_risk_norm'] * weights['lifecycle_risk'] +
    risk_df['outstanding_ratio_norm'] * weights['outstanding_ratio']
)

# Classify risk rating
def classify_risk(score):
    if score < 0.3:
        return 'Low Risk'
    elif score < 0.6:
        return 'Medium Risk'
    else:
        return 'High Risk'
risk_df['risk_rating'] = risk_df['composite_risk_score'].apply(classify_risk)

# Identify high-volatility segment (top 25% customer_margin_volatility)
volatility_query = """
SELECT customer_id, AVG(customer_margin_volatility) AS avg_volatility
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
volatility_df = pd.read_sql_query(volatility_query, conn)
threshold = volatility_df['avg_volatility'].quantile(0.75)
high_vol_flag = volatility_df['avg_volatility'] >= threshold
volatility_df['high_volatility'] = high_vol_flag
risk_df = risk_df.merge(volatility_df[['customer_id', 'avg_volatility', 'high_volatility']], on='customer_id', how='left')

# Analyze risk rating distribution among high-volatility vs others
print("\nRisk rating distribution for high-volatility customers:")
print(risk_df[risk_df['high_volatility']]['risk_rating'].value_counts())
print("\nRisk rating distribution for other customers:")
print(risk_df[~risk_df['high_volatility']]['risk_rating'].value_counts())

# Save results
risk_df.to_csv('customer_risk_ratings.csv', index=False)
print("\nCustomer risk ratings saved. Sample:")
print(risk_df[['customer_id', 'avg_volatility', 'high_volatility', 'risk_rating', 'composite_risk_score']].head(20))

conn.close()
''')
