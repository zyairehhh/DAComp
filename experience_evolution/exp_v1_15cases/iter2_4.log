'''
import pandas as pd
import numpy as np
import sqlite3

conn = sqlite3.connect('dacomp-070.sqlite')

# Load region + trends data at daily level (not aggregated)
region_daily = pd.read_sql_query("""
    SELECT c.date_day, c.region, c.store_listing_conversion_rate, 
           t.quality_score, t.crash_rate_per_1k, t.revenue_per_active_device,
           c.package_name
    FROM google_play__country_report c
    JOIN google_play__time_series_trends t
    ON c.date_day = t.date_day AND c.package_name = t.package_name
""", conn)
region_daily['date_day'] = pd.to_datetime(region_daily['date_day'])
print("Daily region data shape:", region_daily.shape)

# Compute correlation
corr_quality = region_daily['store_listing_conversion_rate'].corr(region_daily['quality_score'])
corr_crash = region_daily['store_listing_conversion_rate'].corr(region_daily['crash_rate_per_1k'])
print(f"Correlation between conversion rate and quality_score: {corr_quality:.4f}")
print(f"Correlation between conversion rate and crash_rate_per_1k: {corr_crash:.4f}")

# Prepare for polynomial regression (degree 2) for each region
import warnings
warnings.filterwarnings('ignore')

regions = region_daily['region'].unique()
results = []
for region in regions:
    subset = region_daily[region_daily['region'] == region]
    if len(subset) < 10:
        continue
    X = subset['quality_score'].values
    y = subset['store_listing_conversion_rate'].values
    # Remove any NaN
    mask = ~np.isnan(X) & ~np.isnan(y)
    X = X[mask]
    y = y[mask]
    if len(X) < 3:
        continue
    # Fit polynomial degree 2
    coeffs = np.polyfit(X, y, 2)
    # Compute R-squared
    p = np.poly1d(coeffs)
    y_pred = p(X)
    ss_res = np.sum((y - y_pred) ** 2)
    ss_tot = np.sum((y - np.mean(y)) ** 2)
    r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else np.nan
    results.append({
        'region': region,
        'quality_coeff_a': coeffs[0],
        'quality_coeff_b': coeffs[1],
        'quality_coeff_c': coeffs[2],
        'quality_r2': r2
    })
    # Crash rate polynomial
    Xc = subset['crash_rate_per_1k'].values
    mask2 = ~np.isnan(Xc) & ~np.isnan(y)
    Xc = Xc[mask2]
    yc = y[mask2]
    if len(Xc) >= 3:
        coeffs_c = np.polyfit(Xc, yc, 2)
        pc = np.poly1d(coeffs_c)
        y_pred_c = pc(Xc)
        ss_res_c = np.sum((yc - y_pred_c) ** 2)
        ss_tot_c = np.sum((yc - np.mean(yc)) ** 2)
        r2_c = 1 - (ss_res_c / ss_tot_c) if ss_tot_c != 0 else np.nan
        results[-1]['crash_coeff_a'] = coeffs_c[0]
        results[-1]['crash_coeff_b'] = coeffs_c[1]
        results[-1]['crash_coeff_c'] = coeffs_c[2]
        results[-1]['crash_r2'] = r2_c
    else:
        results[-1]['crash_coeff_a'] = np.nan
        results[-1]['crash_coeff_b'] = np.nan
        results[-1]['crash_coeff_c'] = np.nan
        results[-1]['crash_r2'] = np.nan

results_df = pd.DataFrame(results)
print("\nPolynomial regression results (conversion rate vs quality_score & crash_rate_per_1k):")
print(results_df.to_string())

# Now compute decay patterns: fit linear trend of conversion rate over time per region
from datetime import datetime
region_daily['days'] = (region_daily['date_day'] - region_daily['date_day'].min()).dt.days
decay_results = []
for region in regions:
    subset = region_daily[region_daily['region'] == region]
    X = subset['days'].values.reshape(-1, 1)
    y = subset['store_listing_conversion_rate'].values
    mask = ~np.isnan(y)
    X = X[mask]
    y = y[mask]
    if len(X) < 2:
        continue
    # Linear regression using numpy polyfit degree 1
    coeffs = np.polyfit(X.flatten(), y, 1)
    slope = coeffs[0]  # decay rate per day
    # Compute monthly decay (slope * 30)
    monthly_decay = slope * 30
    decay_results.append({
        'region': region,
        'daily_slope': slope,
        'monthly_decay_percentage': monthly_decay * 100,  # percentage points per month
        'intercept': coeffs[1],
        'start_conversion': y[0],
        'end_conversion': y[-1]
    })

decay_df = pd.DataFrame(decay_results)
print("\nDecay patterns (linear trend) of conversion rate per region:")
print(decay_df.to_string())

conn.close()
''')
