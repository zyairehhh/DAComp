Action: CreateFile(filepath='/workspace/contribution.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-092.sqlite')

# Get high-volatility customer IDs
query = """
SELECT customer_id,
       AVG(customer_margin_volatility) as avg_margin_volatility
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql(query, conn)
threshold = df_cust_vol['avg_margin_volatility'].quantile(0.75)
high_vol_ids = df_cust_vol[df_cust_vol['avg_margin_volatility'] >= threshold]['customer_id'].tolist()

# Get profitability data with month
query = """
SELECT revenue_month_start, customer_id, invoice_total, gross_profit, collected_amount
FROM quickbooks__profitability_analysis
"""
df_profit = pd.read_sql(query, conn)
df_profit['revenue_month_start'] = pd.to_datetime(df_profit['revenue_month_start'])

# Mark high-volatility customers
df_profit['is_high_vol'] = df_profit['customer_id'].isin(high_vol_ids)

# Monthly aggregates for high-volatility vs all
monthly_all = df_profit.groupby('revenue_month_start').agg(
    total_invoice=('invoice_total', 'sum'),
    total_collected=('collected_amount', 'sum'),
    total_gross_profit=('gross_profit', 'sum'),
    customer_count=('customer_id', 'nunique')
).reset_index()

monthly_high = df_profit[df_profit['is_high_vol']].groupby('revenue_month_start').agg(
    high_invoice=('invoice_total', 'sum'),
    high_collected=('collected_amount', 'sum'),
    high_gross_profit=('gross_profit', 'sum'),
    high_customer_count=('customer_id', 'nunique')
).reset_index()

monthly = pd.merge(monthly_all, monthly_high, on='revenue_month_start', how='left')
monthly.fillna(0, inplace=True)

# Compute contributions
monthly['high_invoice_share'] = monthly['high_invoice'] / monthly['total_invoice']
monthly['high_collected_share'] = monthly['high_collected'] / monthly['total_collected']
monthly['high_profit_share'] = monthly['high_gross_profit'] / monthly['total_gross_profit']

print("Monthly contributions (first 10 months):")
print(monthly.head(10))

# Get financial_dashboard data (business_health_score, collection_rate_percentage)
query_fd = """
SELECT dashboard_month, business_health_score, collection_rate_percentage
FROM quickbooks__financial_dashboard
WHERE dashboard_month IS NOT NULL
"""
df_fd = pd.read_sql(query_fd, conn)
df_fd['dashboard_month'] = pd.to_datetime(df_fd['dashboard_month'])

# Merge with monthly contributions (need to align months). Use revenue_month_start vs dashboard_month; they may differ slightly (start vs mid-month). Let's align by month.
monthly['month_key'] = monthly['revenue_month_start'].dt.to_period('M')
df_fd['month_key'] = df_fd['dashboard_month'].dt.to_period('M')

merged = pd.merge(monthly, df_fd, on='month_key', how='inner')
print(f"Merged rows: {merged.shape[0]}")

# Compute correlations
corr_inv_health = merged['high_invoice_share'].corr(merged['business_health_score'])
corr_inv_collect = merged['high_invoice_share'].corr(merged['collection_rate_percentage'])
corr_profit_health = merged['high_profit_share'].corr(merged['business_health_score'])
print(f"Correlation between high-vol invoice share and business health score: {corr_inv_health:.4f}")
print(f"Correlation between high-vol invoice share and collection rate: {corr_inv_collect:.4f}")
print(f"Correlation between high-vol profit share and business health score: {corr_profit_health:.4f}")

# Compute average business health score when high-vol share above median vs below median
median_share = merged['high_invoice_share'].median()
high_share = merged[merged['high_invoice_share'] > median_share]
low_share = merged[merged['high_invoice_share'] <= median_share]
print(f"Median high-vol invoice share: {median_share:.4f}")
print(f"Avg business health score when high-vol share > median: {high_share['business_health_score'].mean():.4f}")
print(f"Avg business health score when high-vol share <= median: {low_share['business_health_score'].mean():.4f}")
print(f"Diff: {high_share['business_health_score'].mean() - low_share['business_health_score'].mean():.4f}")
''')
