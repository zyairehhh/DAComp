# Conditional conversion (contact-level)
print("\n=== Conditional Conversion (Contact-level) ===")

# Create a dataframe with one row per contact
# Define stage ordering
stage_order = {'demo_booked': 1, 'trial_activated': 2, 'closed_won': 3}
def max_stage(stages):
    # Return highest stage
    valid = [s for s in stages if s in stage_order]
    if not valid:
        return None
    return max(valid, key=lambda x: stage_order[x])

df['contact_id'] = df['all_conversation_contacts'].str.strip()

contact_groups = df.groupby('contact_id').agg({
    'stage': list,
    'conversation_initiated_type': list,
    'conversation_id': 'count'
}).reset_index()
contact_groups.rename(columns={'conversation_id': 'conversation_count'}, inplace=True)

# Determine the highest stage per contact
contact_groups['highest_stage'] = contact_groups['stage'].apply(max_stage)

# Determine responder type for the highest stage
def get_responder_for_highest_stage(contact_row):
    stages = contact_row['stage']
    responders = contact_row['conversation_initiated_type']
    highest = contact_row['highest_stage']
    if highest is None:
        return None
    # Find index of first occurrence of highest stage
    for i, s in enumerate(stages):
        if s == highest:
            return responders[i]
    return None

contact_groups['responder_type'] = contact_groups.apply(get_responder_for_highest_stage, axis=1)

# Also compute if contact had demo_booked, trial_activated, closed_won (as boolean)
contact_groups['had_demo'] = contact_groups['stage'].apply(lambda lst: 'demo_booked' in lst)
contact_groups['had_trial'] = contact_groups['stage'].apply(lambda lst: 'trial_activated' in lst)
contact_groups['had_paid'] = contact_groups['stage'].apply(lambda lst: 'closed_won' in lst)

# Now compute conditional conversion rates per responder type
def conditional_rate(df_responder, col_from, col_to):
    # col_from: boolean column indicating starting point (e.g., 'had_demo')
    # col_to: boolean column indicating target (e.g., 'had_trial')
    from_count = df_responder[df_responder[col_from]].shape[0]
    to_count = df_responder[df_responder[col_from] & df_responder[col_to]].shape[0]
    rate = to_count / from_count if from_count > 0 else 0
    return from_count, to_count, rate

for rtype in ['human_first', 'bot_first']:
    subset = contact_groups[contact_groups['responder_type'] == rtype]
    print(f"\n{rtype}:")
    # Demo booked -> Trial activated
    from_demo, to_trial, rate_demo_trial = conditional_rate(subset, 'had_demo', 'had_trial')
    print(f"  Demo booked -> Trial activated: {to_trial}/{from_demo} = {rate_demo_trial:.1%}")
    # Trial activated -> Paid
    from_trial, to_paid, rate_trial_paid = conditional_rate(subset, 'had_trial', 'had_paid')
    print(f"  Trial activated -> Paid: {to_paid}/{from_trial} = {rate_trial_paid:.1%}")

# Check counts: total contacts per responder type
print("\nTotal contacts per responder type:")
print(contact_groups['responder_type'].value_counts(dropna=False))

print("\nUnique contacts per stage per responder type:")
for rtype in ['human_first', 'bot_first']:
    subset = contact_groups[contact_groups['responder_type'] == rtype]
    demo = subset['had_demo'].sum()
    trial = subset['had_trial'].sum()
    paid = subset['had_paid'].sum()
    print(f"{rtype}: demo booked {demo}, trial activated {trial}, paid {paid}")

print("\nOverall conversion rates (unique contacts):")
for rtype in ['human_first', 'bot_first']:
    subset = contact_groups[contact_groups['responder_type'] == rtype]
    total = subset.shape[0]
    demo = subset['had_demo'].sum()
    trial = subset['had_trial'].sum()
    paid = subset['had_paid'].sum()
    print(f"{rtype}: total {total}, demo {demo} ({demo/total:.1%}), trial {trial} ({trial/total:.1%}), paid {paid} ({paid/total:.1%})")
