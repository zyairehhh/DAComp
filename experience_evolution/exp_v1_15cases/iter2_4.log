        df_quality['quality_ma'] = df_quality['quality_score'].rolling(window=7).mean()
        plot_data = df_quality.dropna(subset=['conversion_ma', 'quality_ma'])
        
        axes2[0, 0].plot(plot_data['date_day'], plot_data['conversion_ma'], 'b-', label='Conv Rate (7d MA)', alpha=0.8)
        axes2[0, 0].set_xlabel('Date')
        axes2[0, 0].set_ylabel('Conversion Rate', color='b')
        axes2[0, 0].tick_params(axis='y', labelcolor='b')
        
        ax2_1b = axes2[0, 0].twinx()
        ax2_1b.plot(plot_data['date_day'], plot_data['quality_ma'], 'g-', label='Quality Score (7d MA)', alpha=0.8)
        ax2_1b.set_ylabel('Quality Score', color='g')
        ax2_1b.tick_params(axis='y', labelcolor='g')
        
        axes2[0, 0].set_title('Conversion Rate vs Quality Score Correlation')
    else:
        axes2[0, 0].text(0.5, 0.5, 'Insufficient data\nfor time series correlation',
                        ha='center', va='center', transform=axes2[0, 0].transAxes)
        axes2[0, 0].set_title('Conversion Rate vs Quality Score')
    
    axes2[0, 0].grid(True, alpha=0.3)
    axes2[0, 0].tick_params(axis='x', rotation=45)
    
    # Subplot 2: Rating vs Conversion (scatter)
    if len(df_rating) > 10:
        sample = df_rating.sample(min(200, len(df_rating)), random_state=42)
