import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-022.sqlite')

# Vehicle type summary
query = '''
SELECT 
    "Vehicle Type",
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare,
    AVG("Booking Value") as avg_fare_per_ride,
    AVG("Ride Distance") as avg_distance,
    COUNT(*) as completed_rides,
    SUM(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" ELSE 0 END) as total_earnings,
    (SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1.0 ELSE 0 END) / COUNT(*)) as completion_rate
FROM 
    sheet1 
GROUP BY 
    "Vehicle Type"
ORDER BY 
    avg_per_km_fare DESC
'''
df = pd.read_sql_query(query, conn)
print("=== Vehicle Type Summary (Sorted by Per-km Fare) ===")
print(df.to_string(index=False))

# Top pickup locations by per-km fare (with at least 500 rides)
query2 = '''
SELECT 
    "Pickup Location",
    COUNT(*) as rides,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Pickup Location"
HAVING 
    rides >= 500
ORDER BY 
    avg_per_km_fare DESC
LIMIT 10
'''
df2 = pd.read_sql_query(query2, conn)
print("\n=== Top 10 Pickup Locations (Min 500 rides) ===")
print(df2.to_string(index=False))

# Top drop locations by per-km fare (min 500 rides)
query3 = '''
SELECT 
    "Drop Location",
    COUNT(*) as rides,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Drop Location"
HAVING 
    rides >= 500
ORDER BY 
    avg_per_km_fare DESC
LIMIT 10
'''
df3 = pd.read_sql_query(query3, conn)
print("\n=== Top 10 Drop Locations (Min 500 rides) ===")
print(df3.to_string(index=False))

# Hourly fare by vehicle type (top hour each)
query4 = '''
SELECT 
    "Vehicle Type",
    CAST(substr("Time", 1, 2) AS INTEGER) as hour,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare,
    COUNT(*) as rides
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Vehicle Type", hour
ORDER BY 
    "Vehicle Type", avg_per_km_fare DESC
'''
df4 = pd.read_sql_query(query4, conn)
print("\n=== Top Hour for Each Vehicle Type ===")
for vtype in df4["Vehicle Type"].unique():
    subset = df4[df4["Vehicle Type"] == vtype].head(1)
    print(f"{vtype}: Hour {subset['hour'].values[0]} with per-km fare {subset['avg_per_km_fare'].values[0]:.2f} (rides: {subset['rides'].values[0]})")

conn.close()
