Action: CreateFile(filepath="analyze_characteristics.py":
'''
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')

# Load problematic ad groups
problematic = pd.read_csv('problematic_with_ratio.csv')
problematic_ids = problematic['ad_group_id'].tolist()

# Query keyword report for these ad groups
query = f\"\"\"
SELECT ad_group_id, keyword_match_type, keyword_text,
       SUM(clicks) as clicks, SUM(impressions) as impressions,
       SUM(conversions) as conversions
FROM google_ads__keyword_report
WHERE ad_group_id IN ({','.join(['?']*len(problematic_ids))})
GROUP BY ad_group_id, keyword_match_type, keyword_text
\"\"\"

keyword_df = pd.read_sql_query(query, conn, params=problematic_ids)
print('Keyword report rows:', len(keyword_df))
print(keyword_df.head())

# Compute CTR and CVR per keyword
keyword_df['ctr'] = keyword_df['clicks'] / keyword_df['impressions']
keyword_df['cvr'] = keyword_df['conversions'] / keyword_df['clicks']
keyword_df['cvr'].fillna(0, inplace=True)

# Aggregate by match type for problematic ad groups
match_type_stats = keyword_df.groupby('keyword_match_type').agg({
    'clicks': 'sum',
    'impressions': 'sum',
    'conversions': 'sum'
}).reset_index()
match_type_stats['ctr'] = match_type_stats['clicks'] / match_type_stats['impressions']
match_type_stats['cvr'] = match_type_stats['conversions'] / match_type_stats['clicks']
print('Match type stats:')
print(match_type_stats)

# Top keywords by clicks in problematic groups
top_keywords = keyword_df.sort_values('clicks', ascending=False).head(20)
print('Top keywords by clicks:')
print(top_keywords[['keyword_text', 'keyword_match_type', 'clicks', 'ctr', 'cvr']])
''')
