Action: CreateFile(filepath='analyze_factors_no_scipy.py'):
'''
import pandas as pd
import numpy as np
import re
import math

df = pd.read_csv('vocational_data.csv')
print(f"Total rows: {len(df)}")
df = df.dropna(subset=['salary_lower'])
print(f"Rows with salary lower: {len(df)}")

# Helper functions for t-test approximation
def mean_diff_ci(mean1, mean2, std1, std2, n1, n2):
    # pooled standard deviation
    sp = math.sqrt(((n1-1)*std1**2 + (n2-1)*std2**2) / (n1 + n2 - 2))
    # standard error of difference
    se = sp * math.sqrt(1/n1 + 1/n2)
    diff = mean1 - mean2
    # approximate 95% CI (assuming normal, t approx 1.96 for large n)
    ci_lower = diff - 1.96 * se
    ci_upper = diff + 1.96 * se
    return diff, se, (ci_lower, ci_upper)

def cohens_d(mean1, mean2, std1, std2, n1, n2):
    # pooled sd
    sp = math.sqrt(((n1-1)*std1**2 + (n2-1)*std2**2) / (n1 + n2 - 2))
    return (mean1 - mean2) / sp

# 1. Work Experience Requirement
def categorize_experience(text):
    if not isinstance(text, str):
        return 'unknown'
    t = text.lower()
    if 'no limit' in t:
        return 'no limit'
    if 'fresh' in t or 'new graduates' in t or 'fresh graduates' in t:
        return 'fresh graduates'
    # extract years
    years = re.findall(r'(\d+)\s*years?', t)
    if years:
        y = int(years[0])
        if y >= 10:
            return '10+ years'
        elif y >= 5:
            return '5+ years'
        elif y >= 3:
            return '3+ years'
        elif y >= 2:
