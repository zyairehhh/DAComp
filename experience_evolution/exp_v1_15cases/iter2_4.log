'''
import sqlite3
import pandas as pd
import numpy as np

def parse_tags(tag_str):
    if not tag_str:
        return {}
    tags = tag_str.split('|')
    d = {}
    for tag in tags:
        if ':' in tag:
            key, val = tag.split(':', 1)
            d[key] = val
    return d

conn = sqlite3.connect('/workspace/dacomp-098.sqlite')
# Load conversations with metrics
query = '''
SELECT 
    c.conversation_id,
    c.conversation_initiated_type,
    c.conversation_created_at,
    c.all_conversation_tags,
    c.all_conversation_contacts AS contact_id,
    m.first_admin_response_at,
    m.time_to_first_response_minutes
FROM intercom__conversation_enhanced c
LEFT JOIN intercom__conversation_metrics m ON c.conversation_id = m.conversation_id
'''
df = pd.read_sql_query(query, conn)
print(f'Loaded {len(df)} conversations')

# Parse tags
tag_dicts = df['all_conversation_tags'].apply(parse_tags)
df['stage'] = tag_dicts.apply(lambda d: d.get('stage', ''))
df['intent'] = tag_dicts.apply(lambda d: d.get('intent', ''))
df['segment'] = tag_dicts.apply(lambda d: d.get('segment', ''))
df['region'] = tag_dicts.apply(lambda d: d.get('region', ''))
df['lifecycle'] = tag_dicts.apply(lambda d: d.get('lifecycle', ''))
df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
df['first_admin_response_at'] = pd.to_datetime(df['first_admin_response_at'])
df['time_to_first_response_days'] = df['time_to_first_response_minutes'] / (24*60)

# Segment by first response type
df['bot_first'] = df['conversation_initiated_type'] == 'bot_first'

# Determine per contact first response type and stage flags
contact_first = df.sort_values('conversation_created_at').groupby('contact_id').agg({
    'conversation_initiated_type': 'first',
    'stage': list,
    'conversation_created_at': list
}).reset_index()

# Compute stage flags per contact
contact_first['has_demo'] = contact_first['stage'].apply(lambda lst: 'demo_booked' in lst)
contact_first['has_trial'] = contact_first['stage'].apply(lambda lst: 'trial_activated' in lst)
contact_first['has_paid'] = contact_first['stage'].apply(lambda lst: 'closed_won' in lst)

# Compute conversion rates
def compute_rates(sub):
    total = len(sub)
    demo = sub['has_demo'].sum()
    trial = sub['has_trial'].sum()
    paid = sub['has_paid'].sum()
    rate1 = demo / total if total > 0 else 0
    rate2 = trial / demo if demo > 0 else 0
    rate3 = paid / trial if trial > 0 else 0
    return total, demo, trial, paid, rate1, rate2, rate3

bot_sub = contact_first[contact_first['conversation_initiated_type'] == 'bot_first']
human_sub = contact_first[contact_first['conversation_initiated_type'] == 'human_first']

total_bot, demo_bot, trial_bot, paid_bot, r1_bot, r2_bot, r3_bot = compute_rates(bot_sub)
total_human, demo_human, trial_human, paid_human, r1_human, r2_human, r3_human = compute_rates(human_sub)

print('\\n=== Conversion Rates ===')
print(f'Bot-first contacts: {total_bot}')
print(f'  Demo booked rate: {r1_bot:.2%} ({demo_bot}/{total_bot})')
print(f'  Trial activation rate (given demo): {r2_bot:.2%} ({trial_bot}/{demo_bot})')
print(f'  Paid conversion rate (given trial): {r3_bot:.2%} ({paid_bot}/{trial_bot})')
print()
print(f'Human-first contacts: {total_human}')
print(f'  Demo booked rate: {r1_human:.2%} ({demo_human}/{total_human})')
print(f'  Trial activation rate (given demo): {r2_human:.2%} ({trial_human}/{demo_human})')
print(f'  Paid conversion rate (given trial): {r3_human:.2%} ({paid_human}/{trial_human})')

# Compute stage durations (average days between events)
# For each contact, find earliest timestamps for each stage
events = []
for contact_id, group in df.groupby('contact_id'):
    group = group.sort_values('conversation_created_at')
    demo_row = group[group['stage'] == 'demo_booked'].head(1)
    trial_row = group[group['stage'] == 'trial_activated'].head(1)
    paid_row = group[group['stage'] == 'closed_won'].head(1)
    demo_ts = demo_row['conversation_created_at'].iloc[0] if not demo_row.empty else None
    trial_ts = trial_row['conversation_created_at'].iloc[0] if not trial_row.empty else None
    paid_ts = paid_row['conversation_created_at'].iloc[0] if not paid_row.empty else None
    first_type = group['conversation_initiated_type'].iloc[0]
    events.append({
        'contact_id': contact_id,
        'first_response_type': first_type,
        'demo_ts': demo_ts,
        'trial_ts': trial_ts,
        'paid_ts': paid_ts
    })
events_df = pd.DataFrame(events)
events_df['demo_to_trial_days'] = (events_df['trial_ts'] - events_df['demo_ts']).dt.total_seconds() / (24*3600)
events_df['trial_to_paid_days'] = (events_df['paid_ts'] - events_df['trial_ts']).dt.total_seconds() / (24*3600)

bot_events = events_df[events_df['first_response_type'] == 'bot_first']
human_events = events_df[events_df['first_response_type'] == 'human_first']

avg_demo_to_trial_bot = bot_events['demo_to_trial_days'].mean(skipna=True)
avg_trial_to_paid_bot = bot_events['trial_to_paid_days'].mean(skipna=True)
avg_demo_to_trial_human = human_events['demo_to_trial_days'].mean(skipna=True)
avg_trial_to_paid_human = human_events['trial_to_paid_days'].mean(skipna=True)

print('\\n=== Average Stage Durations (days) ===')
print(f'Bot-first: demo to trial: {avg_demo_to_trial_bot:.2f} days')
print(f'Bot-first: trial to paid: {avg_trial_to_paid_bot:.2f} days')
print(f'Human-first: demo to trial: {avg_demo_to_trial_human:.2f} days')
print(f'Human-first: trial to paid: {avg_trial_to_paid_human:.2f} days')

# Time to first response
avg_response_bot = df[df['bot_first']]['time_to_first_response_days'].mean(skipna=True)
avg_response_human = df[~df['bot_first']]['time_to_first_response_days'].mean(skipna=True)
print('\\n=== Average Time to First Response (days) ===')
print(f'Bot-first: {avg_response_bot:.3f} days')
print(f'Human-first: {avg_response_human:.3f} days')

# Analyze by intent, segment, region, lifecycle
dimensions = ['intent', 'segment', 'region', 'lifecycle']
for dim in dimensions:
    print(f'\\n=== Analysis by {dim} ===')
    # For each value, compute rates for bot and human
    for val in df[dim].unique():
        if pd.isna(val) or val == '':
            continue
        sub = df[df[dim] == val]
        contact_ids = sub['contact_id'].unique()
        contact_sub = contact_first[contact_first['contact_id'].isin(contact_ids)]
        bot = contact_sub[contact_sub['conversation_initiated_type'] == 'bot_first']
        human = contact_sub[contact_sub['conversation_initiated_type'] == 'human_first']
        if len(bot) == 0 and len(human) == 0:
            continue
        total_b = len(bot)
        total_h = len(human)
        demo_b = bot['has_demo'].sum()
        trial_b = bot['has_trial'].sum()
        paid_b = bot['has_paid'].sum()
        demo_h = human['has_demo'].sum()
        trial_h = human['has_trial'].sum()
        paid_h = human['has_paid'].sum()
        r1b = demo_b / total_b if total_b > 0 else 0
        r2b = trial_b / demo_b if demo_b > 0 else 0
        r3b = paid_b / trial_b if trial_b > 0 else 0
        r1h = demo_h / total_h if total_h > 0 else 0
        r2h = trial_h / demo_h if demo_h > 0 else 0
        r3h = paid_h / trial_h if trial_h > 0 else 0
        print(f'{dim}: {val}')
        print(f'  Bot: contacts={total_b}, demo={r1b:.2%}, trial={r2b:.2%}, paid={r3b:.2%}')
        print(f'  Human: contacts={total_h}, demo={r1h:.2%}, trial={r2h:.2%}, paid={r3h:.2%}')

conn.close()
print('\\nComputation done.')
''')
