'''
import pandas as pd
import numpy as np
import re
from scipy import stats

df = pd.read_csv('vocational_data.csv')
print(f"Total rows: {len(df)}")
df = df.dropna(subset=['salary_lower'])
print(f"Rows with salary lower: {len(df)}")

# 1. Work Experience Requirement
def categorize_experience(text):
    if not isinstance(text, str):
        return 'unknown'
    t = text.lower()
    if 'no limit' in t:
        return 'no limit'
    if 'fresh' in t or 'new graduates' in t or 'fresh graduates' in t:
        return 'fresh graduates'
    # extract years
    years = re.findall(r'(\d+)\s*years?', t)
    if years:
        y = int(years[0])
        if y >= 10:
            return '10+ years'
        elif y >= 5:
            return '5+ years'
        elif y >= 3:
            return '3+ years'
        elif y >= 2:
            return '2+ years'
        elif y >= 1:
            return '1+ years'
    # check for 'more than x year'
    more = re.findall(r'more than\s*(\d+)', t)
    if more:
        y = int(more[0])
        if y >= 10:
            return '10+ years'
        elif y >= 5:
            return '5+ years'
        elif y >= 3:
            return '3+ years'
        elif y >= 2:
            return '2+ years'
        elif y >= 1:
            return '1+ years'
    return 'other'

df['exp_cat'] = df['Work Experience Requirement'].apply(categorize_experience)
# Compute average salary per category
exp_means = df.groupby('exp_cat')['salary_lower'].mean().sort_values(ascending=False)
print("Average salary by experience category:")
print(exp_means)
# Count per category
exp_counts = df['exp_cat'].value_counts()
print("Counts:", exp_counts)
# ANOVA across categories
categories = df['exp_cat'].unique()
if len(categories) > 1:
    groups = [df[df['exp_cat'] == cat]['salary_lower'].dropna() for cat in categories if len(df[df['exp_cat'] == cat]) >= 30]
    if len(groups) >= 2:
        f_stat, p_val = stats.f_oneway(*groups)
        print(f"ANOVA p-value: {p_val}")
        if p_val < 0.05:
            print("Significant difference across experience categories.")

# 2. Foreign Language Requirement
def foreign_language_required(text):
    if not isinstance(text, str):
        return 'no requirement'
    t = text.lower()
    # if contains any language name
    languages = ['english', 'chinese', 'japanese', 'spanish', 'french', 'german', 'hokkien', 'cantonese', 'other']
    for lang in languages:
        if lang in t:
            return 'required'
    if 'proficiency' in t or 'good' in t or 'required' in t:
        return 'required'
    return 'no requirement'

df['lang_req'] = df['Foreign Language Requirement'].apply(foreign_language_required)
print("\\nForeign language requirement distribution:")
print(df['lang_req'].value_counts())
lang_means = df.groupby('lang_req')['salary_lower'].mean()
print("Average salary:", lang_means)
# t-test between required vs not
required = df[df['lang_req'] == 'required']['salary_lower']
not_req = df[df['lang_req'] == 'no requirement']['salary_lower']
if len(required) > 30 and len(not_req) > 30:
    t, p = stats.ttest_ind(required, not_req, equal_var=False)
    print(f"t-test p-value: {p}")
    if p < 0.05:
        print("Significant difference.")

# 3. Age Requirement
def age_restriction(text):
    if not isinstance(text, str):
        return 'no limit'
    t = text.lower()
    if 'no limit' in t or 'none' in t:
        return 'no limit'
    if 'age' in t or 'years old' in t:
        return 'restricted'
    return 'other'

df['age_req'] = df['Age Requirement'].apply(age_restriction)
print("\\nAge requirement distribution:")
print(df['age_req'].value_counts())
age_means = df.groupby('age_req')['salary_lower'].mean()
print("Average salary:", age_means)
# ANOVA across categories

# 4. Gender Requirement
def gender_category(text):
    if not isinstance(text, str):
        return 'no limit'
    t = text.lower()
    if 'male' in t and 'female' not in t:
        return 'male only'
    elif 'female' in t and 'male' not in t:
        return 'female only'
    else:
        return 'no limit'

df['gender_req'] = df['Gender Requirement'].apply(gender_category)
print("\\nGender requirement distribution:")
print(df['gender_req'].value_counts())
gender_means = df.groupby('gender_req')['salary_lower'].mean()
print("Average salary:", gender_means)

# 5. Industry
# There is an Industry column; let's see top industries
top_industries = df['Industry'].value_counts().head(20)
print("\\nTop 20 industries:", top_industries)
# For each top industry, compute average salary
for ind in top_industries.index[:10]:
    subset = df[df['Industry'] == ind]['salary_lower']
    if len(subset) >= 30:
        print(f"{ind}: mean {subset.mean():.2f}, n={len(subset)}")
# We'll later run regression.

# 6. Company Type
top_company_types = df['Company Type'].value_counts().head(20)
print("\\nTop company types:", top_company_types)
for ct in top_company_types.index[:10]:
    subset = df[df['Company Type'] == ct]['salary_lower']
    if len(subset) >= 30:
        print(f"{ct}: mean {subset.mean():.2f}, n={len(subset)}")

# 7. Employment Type
emp_types = df['Employment Type'].value_counts()
print("\\nEmployment type distribution:", emp_types)
for et in emp_types.index[:5]:
    subset = df[df['Employment Type'] == et]['salary_lower']
    print(f"{et}: mean {subset.mean():.2f}, n={len(subset)}")

# 8. Work Location maybe region
# Could parse city from Work Location, but maybe too many.

# Let's output CSV for further inspection
df[['salary_lower', 'exp_cat', 'lang_req', 'age_req', 'gender_req', 'Industry', 'Company Type', 'Employment Type']].to_csv('factors.csv', index=False)
''')
