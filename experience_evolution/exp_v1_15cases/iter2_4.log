import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

# Connect to the database
conn = sqlite3.connect('dacomp-034.sqlite')

# Read the data
promotions_df = pd.read_sql_query("SELECT * FROM attachment_3", conn)
categories_df = pd.read_sql_query("SELECT * FROM attachment_4", conn)

# Check promotion types
print("Promotion types distribution:")
print(promotions_df['promotion_type'].value_counts())

# Filter for single-item direct price reduction promotions (type 4)
# Assuming promotion_type = 4 is single-item direct price reduction
promo_type_4 = promotions_df[promotions_df['promotion_type'] == 4].copy()

print(f"\nTotal promotions type 4: {len(promo_type_4)}")

# Calculate discount depth
promo_type_4['discount_depth'] = (promo_type_4['pdj_price'] - promo_type_4['promotion_price']) / promo_type_4['pdj_price'] * 100

# Remove any invalid rows
promo_type_4 = promo_type_4.dropna(subset=['discount_depth', 'sale_count', 'pdj_price', 'promotion_price'])

print(f"\nValid promotions after cleaning: {len(promo_type_4)}")
print(f"Discount depth range: {promo_type_4['discount_depth'].min():.2f}% to {promo_type_4['discount_depth'].max():.2f}%")
print(f"Average discount: {promo_type_4['discount_depth'].mean():.2f}%")

# Basic scatter plot of discount depth vs sales
plt.figure(figsize=(10, 6))
plt.scatter(promo_type_4['discount_depth'], promo_type_4['sale_count'], alpha=0.5)
plt.xlabel('Discount Depth (%)')
plt.ylabel('Units Sold During Promotion')
plt.title('Discount Depth vs Sales for Single-Item Direct Price Reduction Promotions')
plt.grid(True, alpha=0.3)
plt.savefig('discount_vs_sales_scatter.png', dpi=300, bbox_inches='tight')
plt.close()

conn.close()
```
