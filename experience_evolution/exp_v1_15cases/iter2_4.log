import pandas as pd
import numpy as np

# Load health scores
df_health = pd.read_csv('campaign_health_scores.csv')
print("Health scores loaded:", df_health.shape)

# Combine with original metrics
df_raw = pd.read_csv('filtered_campaigns.csv')
df_raw['roi'] = df_raw['roas']  # alias
# Merge
