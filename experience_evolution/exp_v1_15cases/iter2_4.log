'''
import pandas as pd
import numpy as np

df = pd.read_csv('contact_with_tiers.csv')
print("=== Value Tier Distribution ===")
print(df['value_tier'].value_counts())
print("Proportions:")
print(df['value_tier'].value_counts(normalize=True).round(3))
print()
print("=== Composite Score Statistics ===")
print(df['composite_score'].describe())
print("33rd percentile:", df['composite_score'].quantile(0.33))
print("66th percentile:", df['composite_score'].quantile(0.66))
print()
print("=== Cross-Channel Activity by Tier ===")
df['cross_channel'] = ((df['count_surveys_sent_email'] > 0) | (df['count_surveys_opened_email'] > 0) | (df['count_surveys_started_email'] > 0) | (df['count_surveys_completed_email'] > 0)) & \
                      ((df['count_surveys_sent_sms'] > 0) | (df['count_surveys_opened_sms'] > 0) | (df['count_surveys_started_sms'] > 0) | (df['count_surveys_completed_sms'] > 0))
cross = df.groupby('value_tier')['cross_channel'].mean() * 100
print(cross.round(2))
print()
print("=== Key Driver Differences (High vs Medium) ===")
medium = df[df['value_tier'] == 'medium']
high = df[df['value_tier'] == 'high']
print("Mean total surveys: Medium {:.2f}, High {:.2f}, Diff {:.2f}".format(
    medium['total_count_surveys'].mean(), high['total_count_surveys'].mean(),
    high['total_count_surveys'].mean() - medium['total_count_surveys'].mean()))
print("Mean completion rate: Medium {:.3f}, High {:.3f}, Diff {:.3f}".format(
    (medium['total_count_completed_surveys'] / medium['total_count_surveys'].replace(0, np.nan)).mean(),
    (high['total_count_completed_surveys'] / high['total_count_surveys'].replace(0, np.nan)).mean(),
    (high['total_count_completed_surveys'] / high['total_count_surveys'].replace(0, np.nan)).mean() - (medium['total_count_completed_surveys'] / medium['total_count_surveys'].replace(0, np.nan)).mean()))
print("Mean progress %: Medium {:.2f}, High {:.2f}, Diff {:.2f}".format(
    medium['avg_survey_progress_pct'].mean(), high['avg_survey_progress_pct'].mean(),
    high['avg_survey_progress_pct'].mean() - medium['avg_survey_progress_pct'].mean()))
print()
print("=== Language High-Tier Rates ===")
lang_high = df.groupby('language')['value_tier'].apply(lambda x: (x == 'high').mean() * 100).sort_values(ascending=False)
print(lang_high.round(2))
print()
print("=== Directory High-Tier Rates ===")
dir_high = df.groupby('directory_name')['value_tier'].apply(lambda x: (x == 'high').mean() * 100).sort_values(ascending=False)
print(dir_high.round(2))
print()
print("=== Correlation with Composite Score (Top 5) ===")
numeric = df.select_dtypes(include=[np.number])
corr = numeric.corr()['composite_score'].sort_values(ascending=False)
print(corr.head(6))
''')
