import sqlite3
import pandas as pd
import re
import numpy as np
from collections import Counter

def parse_salary_range(salary_str):
    """Extract lower bound numeric value from salary range string."""
    if not isinstance(salary_str, str):
        return None
    s = salary_str.replace(',', '')
    numbers = re.findall(r'\d+\.?\d*', s)
    if numbers:
        return float(numbers[0])
    return None

def clean_benefits(benefit_str):
    """Split benefits string into list of cleaned items."""
    if not isinstance(benefit_str, str):
        return []
    b = benefit_str.replace('，', ',').replace('、', ',')
    items = [item.strip() for item in b.split(',') if item.strip()]
    cleaned = []
    for item in items:
        if item.startswith('and '):
            item = item[4:]
        if item.endswith('.'):
            item = item[:-1]
        cleaned.append(item)
    return cleaned

def main():
    conn = sqlite3.connect('dacomp-048.sqlite')
    df = pd.read_sql_query("SELECT * FROM sheet1 WHERE \"Education Requirement\" LIKE '%Vocational%'", conn)
    conn.close()
    
    total_jobs = len(df)
    print(f"Total vocational school job postings: {total_jobs}")
    
    # Salary parsing
    df['salary_lower'] = df['Salary Range'].apply(parse_salary_range)
    df_salary = df[df['salary_lower'].notna()].copy()
    print(f"Rows with parsable salary: {len(df_salary)}")
    
    # Starting salary distribution
    bins = [0, 2000, 4000, 6000, 8000, 10000, 12000, 15000, 20000, float('inf')]
    labels = ['<2k', '2k-4k', '4k-6k', '6k-8k', '8k-10k', '10k-12k', '12k-15k', '15k-20k', '>20k']
    df_salary.loc[:, 'salary_bin'] = pd.cut(df_salary['salary_lower'], bins=bins, labels=labels, right=False)
    salary_dist = df_salary['salary_bin'].value_counts().sort_index()
    
    # Benefits distribution
    all_benefits = []
    for b in df['Benefits'].dropna():
        all_benefits.extend(clean_benefits(b))
    benefit_counts = Counter(all_benefits)
    top_benefits = benefit_counts.most_common(10)
    
    # Work Experience analysis
    def categorize_experience(exp):
        if not isinstance(exp, str):
            return "Not specified"
        exp_lower = exp.lower()
        if 'no limit' in exp_lower or '不限' in exp_lower:
            return "No limit"
        if 'more than' in exp_lower or '一年以上' in exp_lower:
            return "More than one year"
        if 'two years' in exp_lower or 'two years or more' in exp_lower:
            return "Two years or more"
        if 'three years' in exp_lower or 'three years or more' in exp_lower:
            return "Three years or more"
        if 'five years' in exp_lower or 'five years or more' in exp_lower:
            return "Five years or more"
        if 'one year' in exp_lower:
            return "One year"
        if 'less than' in exp_lower:
            return "Less than one year"
        if 'experienced' in exp_lower:
            return "Experienced"
        return "Other"
    
    df_salary.loc[:, 'work_exp_cat'] = df_salary['Work Experience Requirement'].apply(categorize_experience)
    avg_salary_exp = df_salary.groupby('work_exp_cat')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
    
    # Foreign Language analysis
    def categorize_language(lang):
        if not isinstance(lang, str):
            return "Not specified"
        lang_lower = lang.lower()
        if 'none' in lang_lower or '不限' in lang_lower or 'no requirement' in lang_lower:
            return "None"
        if 'english' in lang_lower:
            return "English"
        if 'japanese' in lang_lower:
            return "Japanese"
        if 'korean' in lang_lower:
            return "Korean"
        return "Other"
    
    df_salary.loc[:, 'language_cat'] = df_salary['Foreign Language Requirement'].apply(categorize_language)
    avg_salary_lang = df_salary.groupby('language_cat')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
    
    # Age analysis
    def parse_min_age(age_str):
        if not isinstance(age_str, str):
            return None
        numbers = re.findall(r'\d+', age_str)
        if numbers:
            return int(numbers[0])
        return None
    
    df_salary.loc[:, 'min_age'] = df_salary['Age Requirement'].apply(parse_min_age)
    bins_age = [18, 25, 30, 35, 40, 45, 50, 55, 65]
    labels_age = ['18-24', '25-29', '30-34', '35-39', '40-44', '45-49', '50-54', '55+']
    df_salary.loc[:, 'age_group'] = pd.cut(df_salary['min_age'], bins=bins_age, labels=labels_age, right=False)
    avg_salary_age = df_salary.groupby('age_group', observed=False)['salary_lower'].agg(['mean', 'median', 'count']).dropna()
    
    # Gender analysis
    def categorize_gender(gender):
        if not isinstance(gender, str):
            return "Not specified"
        gender_lower = gender.lower()
        if 'none' in gender_lower or '不限' in gender_lower:
            return "None"
        if 'male' in gender_lower or '男' in gender_lower:
            return "Male"
        if 'female' in gender_lower or '女' in gender_lower:
            return "Female"
        return "Other"
    
    df_salary.loc[:, 'gender_cat'] = df_salary['Gender Requirement'].apply(categorize_gender)
    avg_salary_gender = df_salary.groupby('gender_cat')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
    
    # Company Type analysis
    df_salary.loc[:, 'Company Type Clean'] = df_salary['Company Type'].fillna('Unknown')
    avg_salary_company = df_salary.groupby('Company Type Clean')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False).head(10)
    
    # Industry analysis
    def extract_primary_industry(industry_str):
        if not isinstance(industry_str, str):
            return "Unknown"
        if ',' in industry_str:
            return industry_str.split(',')[0].strip()
        return industry_str.strip()
    
    df_salary.loc[:, 'Industry Primary'] = df_salary['Industry'].apply(extract_primary_industry)
    avg_salary_industry = df_salary.groupby('Industry Primary')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False).head(10)
    
    # Now generate report markdown
    with open('stage1.md', 'w', encoding='utf-8') as f:
        f.write("# Analysis of Vocational School Graduates Job Market\n")
        f.write(f"*Total job postings targeting vocational school graduates: {total_jobs}*  \n")
        f.write(f"*Postings with salary information: {len(df_salary)}*  \n\n")
        
        f.write("## 1. Starting Salary Distribution\n")
        f.write("Based on the lower bound of salary range (monthly salary in yuan):\n")
        f.write("| Salary Range | Count | Percentage |\n")
        f.write("|--------------|-------|------------|\n")
        total_salary_counts = salary_dist.sum()
        for bin_label, count in salary_dist.items():
            pct = count / total_salary_counts * 100
            f.write(f"| {bin_label} | {count} | {pct:.1f}% |\n")
        f.write("\n")
        
        f.write("## 2. Benefits Distribution\n")
        f.write("Top 10 most frequently mentioned benefits:\n")
        f.write("| Benefit | Count |\n")
        f.write("|---------|-------|\n")
        for benefit, count in top_benefits:
            f.write(f"| {benefit} | {count} |\n")
        f.write("\n")
        
        f.write("## 3. Factors Influencing Starting Salary\n")
        f.write("### 3.1 Work Experience Requirement\n")
        f.write("| Experience Category | Average Salary (yuan) | Median Salary (yuan) | Number of Postings |\n")
        f.write("|---------------------|-----------------------|----------------------|--------------------|\n")
        for idx, row in avg_salary_exp.iterrows():
            f.write(f"| {idx} | {row['mean']:.0f} | {row['median']:.0f} | {row['count']} |\n")
        f.write("\n")
        
        f.write("### 3.2 Foreign Language Requirement\n")
        f.write("| Language Requirement | Average Salary (yuan) | Median Salary (yuan) | Number of Postings |\n")
        f.write("|-----------------------|-----------------------|----------------------|--------------------|\n")
        for idx, row in avg_salary_lang.iterrows():
            f.write(f"| {idx} | {row['mean']:.0f} | {row['median']:.0f} | {row['count']} |\n")
        f.write("\n")
        
        f.write("### 3.3 Age Requirement (Minimum Age)\n")
        f.write("| Age Group | Average Salary (yuan) | Median Salary (yuan) | Number of Postings |\n")
        f.write("|-----------|-----------------------|----------------------|--------------------|\n")
        for idx, row in avg_salary_age.iterrows():
            f.write(f"| {idx} | {row['mean']:.0f} | {row['median']:.0f} | {row['count']} |\n")
        f.write("\n")
        
        f.write("### 3.4 Gender Requirement\n")
        f.write("| Gender Preference | Average Salary (yuan) | Median Salary (yuan) | Number of Postings |\n")
        f.write("|-------------------|-----------------------|----------------------|--------------------|\n")
        for idx, row in avg_salary_gender.iterrows():
            f.write(f"| {idx} | {row['mean']:.0f} | {row['median']:.0f} | {row['count']} |\n")
        f.write("\n")
        
        f.write("### 3.5 Company Type\n")
        f.write("Top 10 company types by average starting salary:\n")
        f.write("| Company Type | Average Salary (yuan) | Median Salary (yuan) | Number of Postings |\n")
        f.write("|--------------|-----------------------|----------------------|--------------------|\n")
        for idx, row in avg_salary_company.iterrows():
            f.write(f"| {idx} | {row['mean']:.0f} | {row['median']:.0f} | {row['count']} |\n")
        f.write("\n")
        
        f.write("### 3.6 Industry\n")
        f.write("Top 10 industries by average starting salary (primary category):\n")
        f.write("| Industry | Average Salary (yuan) | Median Salary (yuan) | Number of Postings |\n")
        f.write("|----------|-----------------------|----------------------|--------------------|\n")
        for idx, row in avg_salary_industry.iterrows():
            f.write(f"| {idx} | {row['mean']:.0f} | {row['median']:.0f} | {row['count']} |\n")
        f.write("\n")
        
        f.write("## 4. Key Insights and Recommendations\n")
        f.write("(To be filled after reviewing results)\n")
    
    print("Analysis complete. Report written to stage1.md")

if __name__ == '__main__':
