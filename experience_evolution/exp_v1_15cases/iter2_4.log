import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette('colorblind')

# Connect to DB
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Identify high-volatility segment (top 25% customer_margin_volatility)
query = """
SELECT customer_id, customer_margin_volatility
FROM quickbooks__profitability_analysis
WHERE customer_margin_volatility IS NOT NULL
GROUP BY customer_id
"""
df_vol = pd.read_sql(query, conn)
vol_threshold = df_vol['customer_margin_volatility'].quantile(0.75)
high_vol_customers = df_vol[df_vol['customer_margin_volatility'] >= vol_threshold]['customer_id'].tolist()

# 2. Calculate coefficient of variation (std/mean) of gross_profit over past 12 months
# We need monthly gross_profit per customer for last 12 months.
# Assuming we have monthly data in profitability_analysis with revenue_month_start.
# Let's get the most recent month and go back 12 months.
max_month_query = "SELECT MAX(revenue_month_start) FROM quickbooks__profitability_analysis"
max_month = pd.read_sql(max_month_query, conn).iloc[0,0]
# Convert to datetime
max_month = pd.to_datetime(max_month)
start_month = max_month - pd.DateOffset(months=12)
# Convert to string for SQL
max_month_str = max_month.strftime('%Y-%m-%d %H:%M:%S')
start_month_str = start_month.strftime('%Y-%m-%d %H:%M:%S')
# Fetch
query_gp = """
SELECT customer_id, revenue_month_start, gross_profit
FROM quickbooks__profitability_analysis
WHERE revenue_month_start >= ? AND revenue_month_start <= ?
AND gross_profit IS NOT NULL
"""
df_gp = pd.read_sql(query_gp, conn, params=(start_month_str, max_month_str))
df_gp['revenue_month_start'] = pd.to_datetime(df_gp['revenue_month_start'])

# Compute coefficient of variation per customer
def coefficient_of_variation(series):
    if len(series) < 2 or series.mean() == 0:
        return np.nan
    return series.std() / series.mean()

cv_df = df_gp.groupby('customer_id')['gross_profit'].apply(coefficient_of_variation).reset_index(name='cv_gross_profit')
cv_df = cv_df.dropna()
cv_df['high_vol'] = cv_df['customer_id'].isin(high_vol_customers)

# 3. Variance of quarter-over-quarter invoice_total growth rate
# We need quarterly invoice totals per customer. Let's compute qoq growth.
query_qoq = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as total_invoice
FROM quickbooks__profitability_analysis
WHERE invoice_total IS NOT NULL
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
"""
df_q = pd.read_sql(query_qoq, conn)
df_q['quarter'] = df_q['revenue_year'].astype(str) + 'Q' + df_q['revenue_quarter'].astype(str)
# Compute growth
df_q['prev_total'] = df_q.groupby('customer_id')['total_invoice'].shift(1)
df_q['qoq_growth'] = (df_q['total_invoice'] - df_q['prev_total']) / df_q['prev_total']
# Variance of qoq growth per customer
var_qoq = df_q.groupby('customer_id')['qoq_growth'].var(ddof=0).reset_index(name='var_qoq_growth')
var_qoq = var_qoq.dropna()

# Merge
merged = pd.merge(cv_df, var_qoq, on='customer_id', how='inner')

# 4. Behavioral features
query_behav = """
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation, lifecycle_stage, risk_assessment
FROM quickbooks__customer_analytics
"""
df_behav = pd.read_sql(query_behav, conn)
merged = pd.merge(merged, df_behav, on='customer_id', how='left')

# 5. Contribution to business_health_score and collection_rate_percentage
# Need to join with financial_dashboard? Actually, we need per-customer contribution? Not directly.
# Instead, we can compute for high-volatility segment vs others on some aggregated metric.
# For simplicity, we can plot average business_health_score over time with segment proportion.
query_fin = """
SELECT dashboard_month, business_health_score, collection_rate_percentage
FROM quickbooks__financial_dashboard
ORDER BY dashboard_month
"""
df_fin = pd.read_sql(query_fin, conn)
df_fin['dashboard_month'] = pd.to_datetime(df_fin['dashboard_month'])

# 6. Risk exposure distribution from balance_sheet accounts receivable structure
query_ar = """
SELECT account_name, SUM(converted_amount) as amount
FROM quickbooks__balance_sheet
WHERE account_class = 'Accounts Receivable'
GROUP BY account_name
"""
df_ar = pd.read_sql(query_ar, conn)

