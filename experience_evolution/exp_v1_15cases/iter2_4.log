'''
import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-070.sqlite')

def run_query(query):
    return pd.read_sql_query(query, conn)

# 1. Non-linear relationship between store_listing_conversion_rate and quality_score, crash_rate_per_1k
print("=== Non-linear relationship (quadratic fit) ===")
query_all = """
SELECT 
    c.store_listing_conversion_rate as conv,
    t.quality_score as qual,
    t.crash_rate_per_1k as crash
FROM google_play__country_report c
JOIN google_play__time_series_trends t 
    ON c.date_day = t.date_day AND c.package_name = t.package_name
WHERE t.quality_score IS NOT NULL AND t.crash_rate_per_1k IS NOT NULL;
"""
df = run_query(query_all)
print(f"Rows: {len(df)}")

# Fit quadratic regression: conv = a + b*qual + c*qual^2
# Use numpy polyfit degree 2
X = df['qual'].values
y = df['conv'].values
coeffs_qual = np.polyfit(X, y, 2)
print(f"Quadratic coefficients for quality_score: {coeffs_qual}")
# Compute RMSE
p = np.poly1d(coeffs_qual)
y_pred = p(X)
rmse = np.sqrt(np.mean((y - y_pred)**2))
print(f"RMSE for quality_score model: {rmse}")

# Fit quadratic for crash_rate
X_crash = df['crash'].values
coeffs_crash = np.polyfit(X_crash, y, 2)
print(f"Quadratic coefficients for crash_rate_per_1k: {coeffs_crash}")
p_crash = np.poly1d(coeffs_crash)
y_pred_crash = p_crash(X_crash)
rmse_crash = np.sqrt(np.mean((y - y_pred_crash)**2))
print(f"RMSE for crash_rate model: {rmse_crash}")

# 2. Multi-dimensional user value decay model
# Define user value = revenue_per_active_device
# Predictors: conversion_rate, quality_score, crash_rate, total_device_installs (maturity), region dummies, month
# Build linear regression
print("\n=== Multi-dimensional regression for revenue per active device ===")
query_reg = """
SELECT 
    t.revenue_per_active_device as rev_per_device,
    c.store_listing_conversion_rate as conv,
    t.quality_score as qual,
    t.crash_rate_per_1k as crash,
    c.total_device_installs as total_installs,
    c.region,
    c.package_name,
    CAST(strftime('%m', c.date_day) AS INTEGER) as month
FROM google_play__country_report c
JOIN google_play__time_series_trends t 
    ON c.date_day = t.date_day AND c.package_name = t.package_name
WHERE t.revenue_per_active_device IS NOT NULL
LIMIT 10000;  # limit size for speed
"""
df_reg = run_query(query_reg)
print(f"Regression dataset size: {df_reg.shape}")

# Encode region as dummy variables
df_reg_dummy = pd.get_dummies(df_reg, columns=['region'], drop_first=True)
# Drop package_name column (categorical too many)
df_reg_numeric = df_reg_dummy.drop(columns=['package_name'])
# Check for missing values
df_reg_numeric = df_reg_numeric.dropna()
print(f"After dropping NA: {df_reg_numeric.shape}")

# Separate target and features
y_reg = df_reg_numeric['rev_per_device']
X_reg = df_reg_numeric.drop(columns=['rev_per_device'])
# Add polynomial terms for qual and crash maybe
X_reg['qual_sq'] = X_reg['qual'] ** 2
X_reg['crash_sq'] = X_reg['crash'] ** 2
X_reg['conv_sq'] = X_reg['conv'] ** 2

# Linear regression using numpy least squares
X_mat = np.column_stack([np.ones(X_reg.shape[0]), X_reg.values])
coeffs = np.linalg.lstsq(X_mat, y_reg, rcond=None)[0]
print(f"Number of coefficients: {len(coeffs)}")
print("Coefficient for intercept and first few features:")
for i, col in enumerate(['intercept'] + list(X_reg.columns)):
    if i < 10:
        print(f"{col}: {coeffs[i]:.6f}")

# Compute R-squared
y_pred_reg = X_mat @ coeffs
ssr = np.sum((y_pred_reg - y_reg.mean())**2)
sst = np.sum((y_reg - y_reg.mean())**2)
r2 = ssr / sst if sst != 0 else np.nan
print(f"R-squared: {r2:.4f}")

# 3. Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
# Compute update frequency per region per month
print("\n=== Interaction effect of update frequency ===")
query_upd = """
SELECT 
    region,
    strftime('%Y-%m', date_day) as month,
    SUM(update_events) as total_updates,
    AVG(active_devices_last_30_days) as avg_active_devices,
    AVG(rolling_total_average_rating) as avg_rating
FROM google_play__country_report
GROUP BY region, month
ORDER BY region, month;
"""
df_upd = run_query(query_upd)
# Compute correlation as before
for region in df_upd['region'].unique():
    subset = df_upd[df_upd['region'] == region].copy()
    corr_updates_active = subset['total_updates'].corr(subset['avg_active_devices'])
    corr_updates_rating = subset['total_updates'].corr(subset['avg_rating'])
    print(f"{region}: correlation updates vs active devices = {corr_updates_active:.3f}, updates vs rating = {corr_updates_rating:.3f}")

# 4. Device type decay patterns (more detailed)
print("\n=== Device type decay of conversion rate (using device report lacks conversion, use active devices) ===")
# Compute average active devices per device per month
query_dev = """
SELECT 
    device,
    strftime('%Y-%m', date_day) as month,
    AVG(active_devices_last_30_days) as avg_active,
    SUM(device_installs) as total_installs,
    SUM(device_uninstalls) as total_uninstalls,
    (SUM(device_installs) - SUM(device_uninstalls)) as net_installs
FROM google_play__device_report
GROUP BY device, month
ORDER BY device, month;
