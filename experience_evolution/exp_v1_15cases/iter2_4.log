'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from datetime import datetime, timedelta

print("Creating visualizations for Stage2 analysis...")

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# ============================================================================
# PLOT 1: Acquisition Efficiency Decay Patterns
# ============================================================================
print("Creating Plot 1: Acquisition Efficiency Decay...")

query1 = """
SELECT date_day, daily_installs, daily_uninstalls, daily_revenue, revenue_per_active_device 
FROM google_play__time_series_trends 
ORDER BY date_day
"""

df_ts = pd.read_sql_query(query1, conn)
df_ts['date_day'] = pd.to_datetime(df_ts['date_day'])

if len(df_ts) > 0:
    # Get last 6 months data
    max_date = df_ts['date_day'].max()
    six_months_ago = max_date - timedelta(days=180)
    df_recent = df_ts[df_ts['date_day'] >= six_months_ago].copy()
    
    # Calculate efficiency metrics
    df_recent['install_to_uninstall_ratio'] = df_recent['daily_installs'] / (df_recent['daily_uninstalls'] + 1)
    
    fig1, axes1 = plt.subplots(2, 2, figsize=(14, 10))
    fig1.suptitle('User Acquisition Efficiency Decay Patterns (Past 6 Months)', fontsize=16, fontweight='bold')
    
    # Subplot 1: Daily installs vs uninstalls
    axes1[0, 0].plot(df_recent['date_day'], df_recent['daily_installs'], 'g-', label='Installs', alpha=0.7)
    axes1[0, 0].plot(df_recent['date_day'], df_recent['daily_uninstalls'], 'r-', label='Uninstalls', alpha=0.7)
    axes1[0, 0].set_title('Daily Installs vs Uninstalls')
    axes1[0, 0].set_xlabel('Date')
    axes1[0, 0].set_ylabel('Count')
    axes1[0, 0].legend()
    axes1[0, 0].grid(True, alpha=0.3)
    axes1[0, 0].tick_params(axis='x', rotation=45)
    
    # Subplot 2: Install-to-uninstall ratio
    axes1[0, 1].plot(df_recent['date_day'], df_recent['install_to_uninstall_ratio'], 'b-', linewidth=2)
    mean_ratio = df_recent['install_to_uninstall_ratio'].mean()
    axes1[0, 1].axhline(y=mean_ratio, color='r', linestyle='--', alpha=0.5, label=f'Mean: {mean_ratio:.2f}')
    axes1[0, 1].set_title('Install-to-Uninstall Ratio (Acquisition Efficiency)')
    axes1[0, 1].set_xlabel('Date')
    axes1[0, 1].set_ylabel('Ratio')
    axes1[0, 1].legend()
    axes1[0, 1].grid(True, alpha=0.3)
    axes1[0, 1].tick_params(axis='x', rotation=45)
    
    # Subplot 3: Revenue per active device (user value)
    axes1[1, 0].plot(df_recent['date_day'], df_recent['revenue_per_active_device'], 'orange', linewidth=2)
    mean_revenue = df_recent['revenue_per_active_device'].mean()
    axes1[1, 0].axhline(y=mean_revenue, color='r', linestyle='--', alpha=0.5, label=f'Mean: ${mean_revenue:.2f}')
    axes1[1, 0].set_title('Revenue per Active Device (User Value Metric)')
    axes1[1, 0].set_xlabel('Date')
    axes1[1, 0].set_ylabel('Revenue per Device ($)')
    axes1[1, 0].legend()
    axes1[1, 0].grid(True, alpha=0.3)
    axes1[1, 0].tick_params(axis='x', rotation=45)
    
    # Subplot 4: Weekly aggregates for trend
    df_recent['week'] = df_recent['date_day'].dt.isocalendar().week
    weekly_agg = df_recent.groupby('week').agg({
        'daily_installs': 'mean',
        'install_to_uninstall_ratio': 'mean'
    }).tail(12)  # Last 12 weeks
    
    x = range(len(weekly_agg))
    axes1[1, 1].bar(x, weekly_agg['daily_installs'], alpha=0.7, color='lightgreen', label='Avg Installs')
    axes1[1, 1].set_xlabel('Week Number')
    axes1[1, 1].set_ylabel('Avg Daily Installs', color='lightgreen')
    axes1[1, 1].tick_params(axis='y', labelcolor='lightgreen')
    axes1[1, 1].set_xticks(x)
    axes1[1, 1].set_xticklabels(weekly_agg.index, rotation=45)
    
    ax2 = axes1[1, 1].twinx()
    ax2.plot(x, weekly_agg['install_to_uninstall_ratio'], 'b-', linewidth=2, marker='o', label='Efficiency Ratio')
    ax2.set_ylabel('Efficiency Ratio', color='blue')
    ax2.tick_params(axis='y', labelcolor='blue')
    
    axes1[1, 1].set_title('Weekly Trends: Installs vs Efficiency')
    axes1[1, 1].grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('plot1_acquisition_efficiency.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("  ✓ Created: plot1_acquisition_efficiency.png")

# ============================================================================
# PLOT 2: Non-linear Relationships
# ============================================================================
print("Creating Plot 2: Non-linear Relationships...")

query2 = """
SELECT 
    t.date_day,
    t.quality_score,
    t.crash_rate_per_1k,
    AVG(c.store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__time_series_trends t
LEFT JOIN google_play__country_report c ON t.date_day = c.date_day
WHERE t.quality_score > 0 AND c.store_listing_conversion_rate > 0
GROUP BY t.date_day
ORDER BY t.date_day
"""

df_quality = pd.read_sql_query(query2, conn)
if len(df_quality) > 0:
    df_quality['date_day'] = pd.to_datetime(df_quality['date_day'])
    
    # Get rating data separately
    query_rating = """
