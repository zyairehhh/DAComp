'''
import pandas as pd
import numpy as np

df = pd.read_csv('contacts_with_scores_v2.csv')
print("Language distribution across segments:")
lang_seg = pd.crosstab(df['language'], df['value_segment_prop'], normalize='columns') * 100
print(lang_seg.round(2))
print("\nSegments per language:")
seg_lang = pd.crosstab(df['language'], df['value_segment_prop'], normalize='index') * 100
print(seg_lang.round(2))

# Directory distribution
print("\nDirectory distribution across segments:")
dir_seg = pd.crosstab(df['directory_name'], df['value_segment_prop'], normalize='columns') * 100
print(dir_seg.round(2))
print("\nSegments per directory:")
seg_dir = pd.crosstab(df['directory_name'], df['value_segment_prop'], normalize='index') * 100
print(seg_dir.round(2))

# Key behavioral characteristics: compute uplift from medium to high
medium = df[df['value_segment_prop'] == 'medium_value']
high = df[df['value_segment_prop'] == 'high_value']

metrics = ['total_count_surveys', 'total_count_completed_surveys', 'completion_rate',
           'count_surveys_sent_email', 'count_surveys_sent_sms', 'cross_channel',
           'avg_survey_progress_pct', 'avg_survey_duration_in_seconds']

uplift = {}
for m in metrics:
    uplift[m] = (high[m].mean() - medium[m].mean()) / medium[m].mean() * 100

uplift_df = pd.DataFrame.from_dict(uplift, orient='index', columns=['uplift_percent'])
print("\nUplift from medium to high (% increase):")
print(uplift_df.sort_values(by='uplift_percent', ascending=False))

# Also compute effect size (Cohen's d) for each metric
from scipy.stats import ttest_ind
effect = {}
for m in metrics:
    d = (high[m].mean() - medium[m].mean()) / np.sqrt((high[m].std()**2 + medium[m].std()**2)/2)
    effect[m] = d

effect_df = pd.DataFrame.from_dict(effect, orient='index', columns=['cohens_d'])
print("\nEffect size (Cohen's d) for medium vs high:")
print(effect_df.sort_values(by='cohens_d', ascending=False))

# Logistic regression: predict high vs medium (binary) using behavioral features
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler

# Prepare data
binary_df = df[df['value_segment_prop'].isin(['medium_value','high_value'])].copy()
binary_df['target'] = (binary_df['value_segment_prop'] == 'high_value').astype(int)

features = ['total_count_surveys', 'total_count_completed_surveys', 'completion_rate',
            'count_surveys_sent_email', 'count_surveys_sent_sms', 'cross_channel',
            'avg_survey_progress_pct', 'avg_survey_duration_in_seconds']
X = binary_df[features].fillna(0)
y = binary_df['target']

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
model = LogisticRegression(max_iter=1000, random_state=42)
model.fit(X_scaled, y)
coef = pd.DataFrame({'feature': features, 'coefficient': model.coef_[0]})
coef['abs_coef'] = np.abs(coef['coefficient'])
coef = coef.sort_values('abs_coef', ascending=False)
print("\nLogistic regression coefficients (standardized features) for predicting high vs medium:")
print(coef)

# Analyze language and directory as predictors (categorical)
# Encode dummy variables
lang_dummies = pd.get_dummies(df['language'], prefix='lang')
dir_dummies = pd.get_dummies(df['directory_name'], prefix='dir')
merged = pd.concat([df, lang_dummies, dir_dummies], axis=1)

# Filter to medium and high
merged_mh = merged[merged['value_segment_prop'].isin(['medium_value','high_value'])].copy()
merged_mh['target'] = (merged_mh['value_segment_prop'] == 'high_value').astype(int)
cat_features = list(lang_dummies.columns) + list(dir_dummies.columns)
X_cat = merged_mh[cat_features]
y_cat = merged_mh['target']
model_cat = LogisticRegression(max_iter=1000, random_state=42)
model_cat.fit(X_cat, y_cat)
coef_cat = pd.DataFrame({'feature': cat_features, 'coefficient': model_cat.coef_[0]})
coef_cat['abs'] = np.abs(coef_cat['coefficient'])
coef_cat = coef_cat.sort_values('abs', ascending=False).head(20)
print("\nTop categorical feature coefficients (language/directory):")
print(coef_cat)
''')
