import pandas as pd
import numpy as np

df = pd.read_csv('contact_with_tiers.csv')
medium = df[df['value_tier'] == 'medium']
medium['cross_channel_active'] = ((medium['count_surveys_sent_email'] > 0) | (medium['count_surveys_opened_email'] > 0) | (medium['count_surveys_started_email'] > 0) | (medium['count_surveys_completed_email'] > 0)) & \
                                 ((medium['count_surveys_sent_sms'] > 0) | (medium['count_surveys_opened_sms'] > 0) | (medium['count_surveys_started_sms'] > 0) | (medium['count_surveys_completed_sms'] > 0))
print("Medium users with cross-channel active: {}/{} ({:.2f}%)".format(
    medium['cross_channel_active'].sum(), len(medium), medium['cross_channel_active'].mean()*100))
# Composite score comparison
print("Composite score for medium users with cross-channel active: mean {:.2f}, median {:.2f}".format(
    medium[medium['cross_channel_active']]['composite_score'].mean(),
    medium[medium['cross_channel_active']]['composite_score'].median()))
print("Composite score for medium users without cross-channel active: mean {:.2f}, median {:.2f}".format(
    medium[~medium['cross_channel_active']]['composite_score'].mean(),
    medium[~medium['cross_channel_active']]['composite_score'].median()))
# Check if any cross-channel active medium users are near high threshold
high_threshold = df['composite_score'].quantile(0.66)  # 48.48
print("High threshold (66th percentile): {:.2f}".format(high_threshold))
medium_cross_high = medium[medium['cross_channel_active'] & (medium['composite_score'] >= high_threshold)]
print("Medium users with cross-channel active whose score >= high threshold: {}/{} ({:.2f}%)".format(
    len(medium_cross_high), medium['cross_channel_active'].sum(), len(medium_cross_high)/medium['cross_channel_active'].sum()*100))
''')
