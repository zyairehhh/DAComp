import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Connect to database
conn = sqlite3.connect('dacomp-078.sqlite')
account_df = pd.read_sql_query('SELECT * FROM pendo__account', conn)

# Compute high-value label (top 25% by sum_minutes)
threshold = account_df['sum_minutes'].quantile(0.75)
y_true = (account_df['sum_minutes'] >= threshold).astype(int).values

# Features and weights as per stage1
features = [
    'average_daily_events',
    'average_daily_minutes',
    'count_feature_clicking_visitors',
    'count_active_days',
    'count_active_visitors',
    'count_page_viewing_visitors',
    'count_active_months',
    'avg_nps_rating'
]
weights = [0.1917, 0.1861, 0.1135, 0.1134, 0.1121, 0.1119, 0.1109, 0.0603]

# Standardize features (z‑score)
for feat in features:
    mean = account_df[feat].mean()
    std = account_df[feat].std()
    account_df[f'{feat}_norm'] = (account_df[feat] - mean) / std

# Compute multi‑dimensional score
multi_score = sum(account_df[f'{feat}_norm'] * w for feat, w in zip(features, weights))

# For old model, we use only two features (average_daily_minutes and average_daily_events)
# Standardize them as well
mean_min = account_df['average_daily_minutes'].mean()
std_min = account_df['average_daily_minutes'].std()
mean_ev = account_df['average_daily_events'].mean()
std_ev = account_df['average_daily_events'].std()
old_score = (account_df['average_daily_minutes'] - mean_min) / std_min + (account_df['average_daily_events'] - mean_ev) / std_ev

# Metrics calculation
def compute_metrics(y_true, y_pred):
    tp = np.sum((y_true == 1) & (y_pred == 1))
    tn = np.sum((y_true == 0) & (y_pred == 0))
    fp = np.sum((y_true == 0) & (y_pred == 1))
    fn = np.sum((y_true == 1) & (y_pred == 0))
    accuracy = (tp + tn) / (tp + tn + fp + fn) if (tp+tn+fp+fn) > 0 else 0
    precision = tp / (tp + fp) if (tp + fp) > 0 else 0
    recall = tp / (tp + fn) if (tp + fn) > 0 else 0
    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0
    return accuracy, precision, recall, f1

def best_threshold_metrics(scores, y_true):
    thresholds = np.linspace(scores.min(), scores.max(), 200)
    best_acc = 0
    best_th = None
    best_metrics = None
    for th in thresholds:
        y_pred = (scores >= th).astype(int)
        acc, prec, rec, f1 = compute_metrics(y_true, y_pred)
        if acc > best_acc:
            best_acc = acc
            best_th = th
            best_metrics = {
                'accuracy': acc,
                'precision': prec,
                'recall': rec,
                'f1': f1
            }
    return best_th, best_metrics

th_old, metrics_old = best_threshold_metrics(old_score.values, y_true)
th_multi, metrics_multi = best_threshold_metrics(multi_score.values, y_true)

print('Old model (duration‑frequency):')
print(f'  Threshold: {th_old:.3f}')
print(f'  Accuracy: {metrics_old["accuracy"]:.3f}')
print(f'  Precision: {metrics_old["precision"]:.3f}')
print(f'  Recall: {metrics_old["recall"]:.3f}')
print(f'  F1: {metrics_old["f1"]:.3f}')
print('New multi‑dimensional model:')
print(f'  Threshold: {th_multi:.3f}')
print(f'  Accuracy: {metrics_multi["accuracy"]:.3f}')
print(f'  Precision: {metrics_multi["precision"]:.3f}')
print(f'  Recall: {metrics_multi["recall"]:.3f}')
print(f'  F1: {metrics_multi["f1"]:.3f}')

# Create grouped bar chart
metrics_labels = ['Accuracy', 'Precision', 'Recall', 'F1']
old_values = [metrics_old['accuracy'], metrics_old['precision'], metrics_old['recall'], metrics_old['f1']]
multi_values = [metrics_multi['accuracy'], metrics_multi['precision'], metrics_multi['recall'], metrics_multi['f1']]

x = np.arange(len(metrics_labels))
width = 0.35

plt.figure(figsize=(9, 6))
bars1 = plt.bar(x - width/2, old_values, width, label='Old (two‑dimension)', color='lightcoral')
bars2 = plt.bar(x + width/2, multi_values, width, label='New (multi‑dimension)', color='lightseagreen')
plt.axhline(y=0.85, color='darkred', linestyle='--', linewidth=1.5, label='Target accuracy (85%)')
plt.ylabel('Score')
plt.title('Model Performance Comparison')
plt.xticks(x, metrics_labels)
plt.legend()
plt.grid(True, axis='y', linestyle='--', alpha=0.5)
# Annotate values on bars
for bars in (bars1, bars2):
    for bar in bars:
        height = bar.get_height()
        plt.text(bar.get_x() + bar.get_width()/2., height + 0.01,
                 f'{height:.3f}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('performance_comparison.png', dpi=300)
plt.close()

conn.close()
print('Performance comparison plot saved as performance_comparison.png')
```
