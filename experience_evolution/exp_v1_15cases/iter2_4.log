import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# Read ad group report
df = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)

# Compute CTR and CVR
df['CTR'] = df['clicks'] / df['impressions'].replace(0, np.nan)
df['CVR'] = df['conversions'] / df['clicks'].replace(0, np.nan)

# Compute percentiles
ctr_75th = df['CTR'].quantile(0.75)
cvr_25th = df['CVR'].quantile(0.25)

print(f"CTR 75th percentile: {ctr_75th:.4f}")
print(f"CVR 25th percentile: {cvr_25th:.4f}")

# Identify problematic ad groups
problematic = df[(df['CTR'] > ctr_75th) & (df['CVR'] < cvr_25th)].copy()
print(f"Number of problematic ad groups: {len(problematic)}")

# Save problematic ad groups to CSV for reference
problematic.to_csv('problematic_ad_groups.csv', index=False)

# Plot 1: Scatter plot of CTR vs CVR with percentiles
plt.figure(figsize=(10, 6))
plt.scatter(df['CTR'], df['CVR'], alpha=0.5, s=20, label='All ad groups')
plt.scatter(problematic['CTR'], problematic['CVR'], color='red', s=40, label='High-CTR Low-CVR')
plt.axvline(x=ctr_75th, color='green', linestyle='--', label='CTR 75th percentile')
plt.axhline(y=cvr_25th, color='orange', linestyle='--', label='CVR 25th percentile')
plt.xlabel('CTR (Click-Through Rate)')
plt.ylabel('CVR (Conversion Rate)')
plt.title('CTR vs CVR: Identifying Problematic Ad Groups')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('ctr_vs_cvr_scatter.png', dpi=150)
plt.close()

# Plot 2: Distribution of CTR and CVR
fig, axes = plt.subplots(1, 2, figsize=(12, 5))
axes[0].hist(df['CTR'].dropna(), bins=50, alpha=0.7, color='blue', edgecolor='black')
axes[0].axvline(ctr_75th, color='red', linestyle='--', label='75th percentile')
axes[0].set_xlabel('CTR')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Distribution of CTR')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

axes[1].hist(df['CVR'].dropna(), bins=50, alpha=0.7, color='green', edgecolor='black')
axes[1].axvline(cvr_25th, color='red', linestyle='--', label='25th percentile')
axes[1].set_xlabel('CVR')
axes[1].set_ylabel('Frequency')
axes[1].set_title('Distribution of CVR')
axes[1].legend()
axes[1].grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('ctr_cvr_distributions.png', dpi=150)
plt.close()

# For intent match ratio, we need expected CVR. Since not provided, we could approximate
# by average CVR per campaign or ad group type, or compute from keyword report.
# Let's compute average CVR per ad_group_type as expected CVR
df['expected_cvr'] = df.groupby('ad_group_type')['CVR'].transform('mean')
df['intent_match_ratio'] = df['CVR'] / df['expected_cvr'].replace(0, np.nan)

# For problematic ad groups, compute this ratio
problematic['expected_cvr'] = problematic.groupby('ad_group_type')['CVR'].transform('mean')
