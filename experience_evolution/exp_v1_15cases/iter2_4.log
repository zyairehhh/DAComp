import sqlite3
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-035.sqlite')

# 1. Abnormal login rate per department
query_rates = """
WITH dept_counts AS (
    SELECT Department, COUNT(*) as dept_size 
    FROM user_information_table 
    GROUP BY Department
),
abnormal_counts AS (
    SELECT ui.Department, COUNT(al.[Anomaly ID]) as abnormal_count 
    FROM abnormal_logins_table al 
    JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
    JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
    GROUP BY ui.Department
)
SELECT dc.Department, dc.dept_size, ac.abnormal_count, 
       CAST(ac.abnormal_count AS REAL) / dc.dept_size AS abnormal_rate
FROM dept_counts dc 
LEFT JOIN abnormal_counts ac ON dc.Department = ac.Department
ORDER BY abnormal_rate DESC
"""
df_rates = pd.read_sql_query(query_rates, conn)

# 2. Risk level distribution per department
query_risk = """
SELECT ui.Department, al.[Risk Level], COUNT(*) as count 
FROM abnormal_logins_table al 
JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
GROUP BY ui.Department, al.[Risk Level]
ORDER BY ui.Department, al.[Risk Level]
"""
df_risk = pd.read_sql_query(query_risk, conn)

# 3. Anomaly type distribution per department
query_type = """
SELECT ui.Department, al.[Anomaly Type], COUNT(*) as count 
FROM abnormal_logins_table al 
JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
GROUP BY ui.Department, al.[Anomaly Type]
ORDER BY ui.Department, al.[Anomaly Type]
"""
df_type = pd.read_sql_query(query_type, conn)

conn.close()

# Plot 1: Abnormal login rate per department (bar chart)
plt.figure(figsize=(10, 6))
bars = plt.bar(df_rates['Department'], df_rates['abnormal_rate'], color='steelblue')
plt.ylabel('Abnormal Login Rate (per user)', fontsize=12)
plt.title('Abnormal Login Rate by Department', fontsize=14)
plt.xticks(rotation=15)
for bar, rate in zip(bars, df_rates['abnormal_rate']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.003,
             f'{rate:.3f}', ha='center', va='bottom', fontsize=10)
plt.tight_layout()
plt.savefig('abnormal_login_rate_by_dept.png', dpi=300)
plt.close()

# Plot 2: Risk level stacked bar chart
depts = df_risk['Department'].unique()
risk_levels = ['Low', 'Medium', 'High', 'Severe']
risk_colors = {'Low': 'green', 'Medium': 'yellow', 'High': 'orange', 'Severe': 'red'}

# pivot to matrix
risk_matrix = df_risk.pivot(index='Department', columns='Risk Level', values='count').fillna(0)
# reorder columns as per risk_levels
risk_matrix = risk_matrix.reindex(columns=risk_levels, fill_value=0)
# reorder rows as per df_rates order
risk_matrix = risk_matrix.reindex(df_rates['Department'])

plt.figure(figsize=(10, 6))
bottom = np.zeros(len(depts))
for level in risk_levels:
    if level in risk_matrix.columns:
        plt.bar(depts, risk_matrix[level], bottom=bottom, label=level, color=risk_colors[level])
        bottom += risk_matrix[level].values
plt.ylabel('Number of Abnormal Logins', fontsize=12)
plt.title('Risk Level Distribution per Department', fontsize=14)
plt.xticks(rotation=15)
plt.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('risk_level_by_dept.png', dpi=300)
plt.close()

# Plot 3: Anomaly type stacked bar chart
type_matrix = df_type.pivot(index='Department', columns='Anomaly Type', values='count').fillna(0)
type_matrix = type_matrix.reindex(df_rates['Department'])
anomaly_types = type_matrix.columns.tolist()
colors = plt.cm.Set3(np.linspace(0, 1, len(anomaly_types)))

plt.figure(figsize=(10, 6))
bottom = np.zeros(len(depts))
for i, typ in enumerate(anomaly_types):
    plt.bar(depts, type_matrix[typ], bottom=bottom, label=typ, color=colors[i])
    bottom += type_matrix[typ].values
plt.ylabel('Number of Abnormal Logins', fontsize=12)
plt.title('Anomaly Type Distribution per Department', fontsize=14)
plt.xticks(rotation=15)
plt.legend(title='Anomaly Type')
plt.tight_layout()
plt.savefig('anomaly_type_by_dept.png', dpi=300)
plt.close()

print("Plots saved.")
```

