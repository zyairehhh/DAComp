Action: LOCAL_DB_SQL(file_path="database.sqlite", command="WITH region_avg AS ( SELECT r.region_name, AVG(p.revenue_per_user) as avg_rev FROM performance p JOIN regions r ON p.region_id = r.region_id WHERE p.app_id = (SELECT app_id FROM apps WHERE app_name = 'com.dev.photoeditor') AND p.date >= (SELECT DATE(MAX(date), '-12 months') FROM performance) GROUP BY r.region_id ), first_month AS ( SELECT r.region_name, AVG(p.revenue_per_user) as avg_rev_first, AVG(p.sessions_per_user) as avg_sess_first FROM performance p JOIN regions r ON p.region_id = r.region_id WHERE p.app_id = (SELECT app_id FROM apps WHERE app_name = 'com.dev.photoeditor') AND p.date = (SELECT MIN(date) FROM performance WHERE date >= (SELECT DATE(MAX(date), '-12 months') FROM performance)) GROUP BY r.region_id ), last_month AS ( SELECT r.region_name, AVG(p.revenue_per_user) as avg_rev_last, AVG(p.sessions_per_user) as avg_sess_last FROM performance p JOIN regions r ON p.region_id = r.region_id WHERE p.app_id = (SELECT app_id FROM apps WHERE app_name = 'com.dev.photoeditor') AND p.date = (SELECT MAX(date) FROM performance WHERE date >= (SELECT DATE(MAX(date), '-12 months') FROM performance)) GROUP BY r.region_id ), combined AS ( SELECT ra.region_name, ra.avg_rev, f.avg_rev_first, l.avg_rev_last, f.avg_sess_first, l.avg_sess_last FROM region_avg ra JOIN first_month f ON ra.region_name = f.region_name JOIN last_month l ON ra.region_name = l.region_name ) SELECT CASE WHEN avg_rev > 7 THEN 'High Revenue (>7)' WHEN avg_rev < 3 THEN 'Low Revenue (<3)' ELSE 'Medium Revenue' END as category, COUNT(*) as region_count, AVG(avg_rev_first) as avg_rev_first, AVG(avg_rev_last) as avg_rev_last, AVG(avg_rev_last - avg_rev_first) as avg_rev_change, AVG(avg_sess_first) as avg_sess_first, AVG(avg_sess_last) as avg_sess_last, AVG(avg_sess_last - avg_sess_first) as avg_sess_change FROM combined GROUP BY category;", output="direct")

