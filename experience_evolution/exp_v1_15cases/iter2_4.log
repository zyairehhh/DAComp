import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette('colorblind')

# Connect to DB
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Identify high-volatility segment (top 25% customer_margin_volatility)
query = """
SELECT customer_id, customer_margin_volatility
FROM quickbooks__profitability_analysis
WHERE customer_margin_volatility IS NOT NULL
GROUP BY customer_id
"""
df_vol = pd.read_sql(query, conn)
vol_threshold = df_vol['customer_margin_volatility'].quantile(0.75)
high_vol_customers = df_vol[df_vol['customer_margin_volatility'] >= vol_threshold]['customer_id'].tolist()

# 2. Calculate coefficient of variation (std/mean) of gross_profit over past 12 months
# We need monthly gross_profit per customer for last 12 months.
# Assuming we have monthly data in profitability_analysis with revenue_month_start.
# Let's get the most recent month and go back 12 months.
max_month_query = "SELECT MAX(revenue_month_start) FROM quickbooks__profitability_analysis"
max_month = pd.read_sql(max_month_query, conn).iloc[0,0]
# Convert to datetime
max_month = pd.to_datetime(max_month)
start_month = max_month - pd.DateOffset(months=12)
# Fetch
query_gp = """
SELECT customer_id, revenue_month_start, gross_profit
FROM quickbooks__profitability_analysis
WHERE revenue_month_start >= ? AND revenue_month_start <= ?
AND gross_profit IS NOT NULL
"""
df_gp = pd.read_sql(query_gp, conn, params=(start_month, max_month))
df_gp['revenue_month_start'] = pd.to_datetime(df_gp['revenue_month_start'])

# Compute coefficient of variation per customer
def coefficient_of_variation(series):
    if len(series) < 2 or series.mean() == 0:
        return np.nan
    return series.std() / series.mean()

cv_df = df_gp.groupby('customer_id')['gross_profit'].apply(coefficient_of_variation).reset_index(name='cv_gross_profit')
cv_df = cv_df.dropna()
cv_df['high_vol'] = cv_df['customer_id'].isin(high_vol_customers)

# 3. Variance of quarter-over-quarter invoice_total growth rate
# We need quarterly invoice totals per customer. Let's compute qoq growth.
query_qoq = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as total_invoice
FROM quickbooks__profitability_analysis
WHERE invoice_total IS NOT NULL
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
"""
df_q = pd.read_sql(query_qoq, conn)
df_q['quarter'] = df_q['revenue_year'].astype(str) + 'Q' + df_q['revenue_quarter'].astype(str)
# Compute growth
df_q['prev_total'] = df_q.groupby('customer_id')['total_invoice'].shift(1)
df_q['qoq_growth'] = (df_q['total_invoice'] - df_q['prev_total']) / df_q['prev_total']
# Variance of qoq growth per customer
var_qoq = df_q.groupby('customer_id')['qoq_growth'].var(ddof=0).reset_index(name='var_qoq_growth')
var_qoq = var_qoq.dropna()

# Merge
merged = pd.merge(cv_df, var_qoq, on='customer_id', how='inner')

# 4. Behavioral features
query_behav = """
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation, lifecycle_stage, risk_assessment
FROM quickbooks__customer_analytics
"""
df_behav = pd.read_sql(query_behav, conn)
merged = pd.merge(merged, df_behav, on='customer_id', how='left')

# 5. Contribution to business_health_score and collection_rate_percentage
# Need to join with financial_dashboard? Actually, we need per-customer contribution? Not directly.
# Instead, we can compute for high-volatility segment vs others on some aggregated metric.
# For simplicity, we can plot average business_health_score over time with segment proportion.
query_fin = """
SELECT dashboard_month, business_health_score, collection_rate_percentage
FROM quickbooks__financial_dashboard
ORDER BY dashboard_month
"""
df_fin = pd.read_sql(query_fin, conn)
df_fin['dashboard_month'] = pd.to_datetime(df_fin['dashboard_month'])

# 6. Risk exposure distribution from balance_sheet accounts receivable structure
query_ar = """
SELECT account_name, SUM(converted_amount) as amount
FROM quickbooks__balance_sheet
WHERE account_class = 'Accounts Receivable'
GROUP BY account_name
"""
df_ar = pd.read_sql(query_ar, conn)

# Now we have data for visualizations.
# Let's create a few key plots.

# Plot 1: Distribution of customer_margin_volatility with top 25% highlighted
fig, ax = plt.subplots(figsize=(10,6))
ax.hist(df_vol['customer_margin_volatility'], bins=50, alpha=0.7, label='All customers')
ax.axvline(vol_threshold, color='red', linestyle='--', linewidth=2, label='Top 25% threshold')
ax.set_xlabel('Customer Margin Volatility')
ax.set_ylabel('Frequency')
ax.set_title('Distribution of Customer Margin Volatility')
ax.legend()
plt.tight_layout()
plt.savefig('volatility_distribution.png', dpi=300)
plt.close()

# Plot 2: Scatter of CV vs Variance of QoQ growth, colored by high_vol
fig, ax = plt.subplots(figsize=(10,6))
scatter = ax.scatter(merged['cv_gross_profit'], merged['var_qoq_growth'], 
                     c=merged['high_vol'].astype(int), cmap='coolwarm', alpha=0.7)
ax.set_xlabel('Coefficient of Variation of Gross Profit (12 months)')
ax.set_ylabel('Variance of QoQ Invoice Total Growth')
ax.set_title('Profit Stability vs Growth Volatility')
# Add legend
handles = [plt.Line2D([0], [0], marker='o', color='w', markerfacecolor='blue', label='Low Volatility'),
           plt.Line2D([0], [0], marker='o', color='w', markerfacecolor='red', label='High Volatility')]
ax.legend(handles=handles)
plt.tight_layout()
plt.savefig('stability_vs_growth_volatility.png', dpi=300)
plt.close()

# Plot 3: Count of high-volatility customers by RFM segment
high_vol_behav = merged[merged['high_vol']]
rfm_counts = high_vol_behav['rfm_segment'].value_counts().reset_index()
rfm_counts.columns = ['rfm_segment', 'count']
fig, ax = plt.subplots(figsize=(12,6))
bars = ax.bar(rfm_counts['rfm_segment'], rfm_counts['count'])
ax.set_xlabel('RFM Segment')
ax.set_ylabel('Number of High-Volatility Customers')
ax.set_title('High-Volatility Customers by RFM Segment')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('high_vol_rfm_segment.png', dpi=300)
plt.close()

# Plot 4: Payment behavior of high-volatility vs low-volatility
pay_counts = merged.groupby(['payment_behavior', 'high_vol']).size().unstack(fill_value=0)
fig, ax = plt.subplots(figsize=(10,6))
pay_counts.plot(kind='bar', ax=ax)
ax.set_xlabel('Payment Behavior')
ax.set_ylabel('Number of Customers')
ax.set_title('Payment Behavior by Volatility Segment')
ax.legend(['Low Volatility', 'High Volatility'])
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('payment_behavior_by_volatility.png', dpi=300)
plt.close()

# Plot 5: Business health score over time and collection rate
fig, ax1 = plt.subplots(figsize=(12,6))
color1 = 'tab:blue'
ax1.set_xlabel('Month')
ax1.set_ylabel('Business Health Score', color=color1)
ax1.plot(df_fin['dashboard_month'], df_fin['business_health_score'], color=color1, linewidth=2)
ax1.tick_params(axis='y', labelcolor=color1)
ax2 = ax1.twinx()
color2 = 'tab:green'
ax2.set_ylabel('Collection Rate (%)', color=color2)
ax2.plot(df_fin['dashboard_month'], df_fin['collection_rate_percentage'], color=color2, linewidth=2, linestyle='--')
ax2.tick_params(axis='y', labelcolor=color2)
plt.title('Business Health Score and Collection Rate Over Time')
fig.tight_layout()
plt.savefig('business_health_collection_trend.png', dpi=300)
plt.close()

# Plot 6: Risk exposure distribution - Accounts Receivable composition
df_ar = df_ar.sort_values('amount', ascending=False).head(10)  # top 10 accounts
fig, ax = plt.subplots(figsize=(10,6))
ax.barh(df_ar['account_name'], df_ar['amount'])
ax.set_xlabel('Amount')
ax.set_ylabel('Account Name')
ax.set_title('Top 10 Accounts Receivable by Amount')
plt.tight_layout()
plt.savefig('ar_composition.png', dpi=300)
plt.close()

# Plot 7: Correlation matrix of selected metrics for high-volatility customers
cols = ['cv_gross_profit', 'var_qoq_growth', 'revenue_trend_correlation']
corr_df = merged[merged['high_vol']][cols].corr()
fig, ax = plt.subplots(figsize=(8,6))
im = ax.matshow(corr_df, cmap='coolwarm', vmin=-1, vmax=1)
plt.colorbar(im)
ax.set_xticks(range(len(cols)))
ax.set_yticks(range(len(cols)))
ax.set_xticklabels(cols, rotation=45)
ax.set_yticklabels(cols)
ax.set_title('Correlation Matrix for High‑Volatility Customers')
plt.tight_layout()
plt.savefig('correlation_matrix.png', dpi=300)
plt.close()

conn.close()
print('Visualizations created')
```
