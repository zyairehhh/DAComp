        # Select top devices for better visualization if too many
        if len(heatmap_data.columns) > 5:
            top_devices = heatmap_data.columns[heatmap_data.mean().nlargest(5).index]
            heatmap_data = heatmap_data[top_devices]
        
        sns.heatmap(heatmap_data, annot=True, fmt='.3f', cmap='YlOrRd', ax=ax1, cbar_kws={'label': 'Conversion Rate'})
        ax1.set_title('Avg Conversion Rate by Region-Device Combination')
        ax1.set_xlabel('Device')
        ax1.set_ylabel('Region')
        ax1.tick_params(axis='x', rotation=45)
    else:
        ax1.text(0.5, 0.5, 'Insufficient data for heatmap', 
                ha='center', va='center', transform=ax1.transAxes, fontsize=12)
        ax1.set_title('Region-Device Conversion Heatmap')
    
    # Plot 3.2: Decay analysis by region (simplified)
    ax2 = plt.subplot(2, 2, 2)
    if len(multi_dim_data) > 0:
        region_decay = multi_dim_data.groupby(['region', pd.Grouper(key='date_day', freq='M')])['store_listing_conversion_rate'].mean().reset_index()
        
        for region in region_decay['region'].unique():
            region_data = region_decay[region_decay['region'] == region]
            ax2.plot(region_data['date_day'], region_data['store_listing_conversion_rate'], marker='o', markersize=6, label=region)
        
        ax2.set_title('Monthly Conversion Rate Decay by Region')
        ax2.set_xlabel('Month')
        ax2.set_ylabel('Avg Conversion Rate')
        ax2.legend()
        ax2.tick_params(axis='x', rotation=45)
    else:
        ax2.text(0.5, 0.5, 'Insufficient data for decay analysis', 
                ha='center', va='center', transform=ax2.transAxes, fontsize=12)
        ax2.set_title('Monthly Conversion Rate Decay')
    
    # Plot 3.3: 3D visualization concept (2D projection)
    ax3 = plt.subplot(2, 2, 3)
    if len(multi_dim_data) > 10:
        scatter = ax3.scatter(
            multi_dim_data['active_devices_last_30_days'],
            multi_dim_data['rolling_total_average_rating'],
            c=multi_dim_data['store_listing_conversion_rate'],
            s=multi_dim_data['update_events']/10,  # Size by update frequency
            cmap='coolwarm',
            alpha=0.6
        )
        ax3.set_title('Multi-dimensional User Value Model')
        ax3.set_xlabel('Active Devices (30 days)')
        ax3.set_ylabel('Average Rating')
        cbar = plt.colorbar(scatter, ax=ax3)
        cbar.set_label('Conversion Rate')
        
        # Add size legend manually
        sizes = [100, 200, 300]  # Corresponding to update_events/10
        labels = ['Low Updates', 'Medium Updates', 'High Updates']
        for size, label in zip(sizes, labels):
            ax3.scatter([], [], c='gray', s=size, label=label, alpha=0.6)
        ax3.legend(scatterpoints=1, frameon=True, labelspacing=1, title='Update Frequency')
    else:
        ax3.text(0.5, 0.5, 'Insufficient data for 3D projection', 
                ha='center', va='center', transform=ax3.transAxes, fontsize=12)
        ax3.set_title('Multi-dimensional User Value Model')
    
    # Plot 3.4: Update frequency impact
    ax4 = plt.subplot(2, 2, 4)
    if len(multi_dim_data) > 0:
        # Create update frequency tiers
        multi_dim_data['update_tier'] = pd.qcut(multi_dim_data['update_events'], 4, labels=['Very Low', 'Low', 'High', 'Very High'])
        tier_metrics = multi_dim_data.groupby('update_tier')[['active_devices_last_30_days', 'rolling_total_average_rating']].mean().reset_index()
        
        x = np.arange(len(tier_metrics))
        width = 0.35
        
        bars1 = ax4.bar(x - width/2, tier_metrics['active_devices_last_30_days'], width, 
                       label='Active Devices', color='skyblue', alpha=0.8)
        ax4b = ax4.twinx()
        bars2 = ax4b.bar(x + width/2, tier_metrics['rolling_total_average_rating'], width,
                        label='Avg Rating', color='salmon', alpha=0.8)
        
        ax4.set_xlabel('Update Frequency Tier')
        ax4.set_ylabel('Active Devices (30 days)')
        ax4b.set_ylabel('Average Rating')
        ax4.set_xticks(x)
        ax4.set_xticklabels(tier_metrics['update_tier'])
        ax4.set_title('Impact of Update Frequency on User Metrics')
        ax4.tick_params(axis='x', rotation=45)
        
        # Combine legends
        lines1, labels1 = ax4.get_legend_handles_labels()
        lines2, labels2 = ax4b.get_legend_handles_labels()
        ax4.legend(lines1 + lines2, labels1 + labels2, loc='upper right')
    else:
        ax4.text(0.5, 0.5, 'Insufficient data for update impact analysis', 
                ha='center', va='center', transform=ax4.transAxes, fontsize=12)
        ax4.set_title('Update Frequency Impact')
    
    plt.suptitle('Multi-dimensional Decay Analysis and Update Frequency Impact', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.savefig('multidimensional_decay_analysis.png', dpi=300, bbox_inches='tight')
    plt.close()

# 4. Update frequency interaction analysis
# Get more detailed update frequency data from device_report
query5 = """
SELECT 
    date_day,
    device,
    update_events,
    active_devices_last_30_days,
    rolling_total_average_rating
FROM google_play__device_report
WHERE update_events > 0
ORDER BY date_day DESC
LIMIT 500
"""

update_data = pd.read_sql_query(query5, conn)
update_data['date_day'] = pd.to_datetime(update_data['date_day'])

fig4 = plt.figure(figsize=(14, 6))

if len(update_data) > 0:
    ax1 = plt.subplot(1, 2, 1)
    
    # Scatter plot: Update events vs active devices with rating as color
    scatter = ax1.scatter(
        update_data['update_events'],
        update_data['active_devices_last_30_days'],
        c=update_data['rolling_total_average_rating'],
        cmap='RdYlBu',
        s=100,
        alpha=0.7,
        edgecolors='black',
        linewidth=0.5
    )
    ax1.set_title('Update Frequency vs Active Devices\n(Colored by Average Rating)')
    ax1.set_xlabel('Update Events Count')
    ax1.set_ylabel('Active Devices (30 days)')
    cbar = plt.colorbar(scatter, ax=ax1)
    cbar.set_label('Average Rating')
    
    # Add trend line if enough data points
    if len(update_data) > 2:
        z = np.polyfit(update_data['update_events'], update_data['active_devices_last_30_days'], 1)
        p = np.poly1d(z)
        x_range = np.linspace(update_data['update_events'].min(), update_data['update_events'].max(), 100)
        ax1.plot(x_range, p(x_range), 'r--', alpha=0.8, label='Linear Trend')
        ax1.legend()
    
    # Bar plot: Update frequency tiers vs metrics
    ax2 = plt.subplot(1, 2, 2)
    
    update_data['update_tier'] = pd.qcut(update_data['update_events'], 4, labels=['Very Low', 'Low', 'High', 'Very High'])
    tier_metrics = update_data.groupby('update_tier')[['active_devices_last_30_days', 'rolling_total_average_rating']].mean().reset_index()
    
    x = np.arange(len(tier_metrics))
    width = 0.35
    
    bars1 = ax2.bar(x - width/2, tier_metrics['active_devices_last_30_days'], width, 
                   label='Active Devices', color='skyblue', alpha=0.8, edgecolor='black')
    ax2b = ax2.twinx()
    bars2 = ax2b.bar(x + width/2, tier_metrics['rolling_total_average_rating'], width,
                    label='Avg Rating', color='salmon', alpha=0.8, edgecolor='black')
    
    ax2.set_xlabel('Update Frequency Tier')
    ax2.set_ylabel('Active Devices (30 days)', color='skyblue')
    ax2b.set_ylabel('Average Rating', color='salmon')
    ax2.set_xticks(x)
    ax2.set_xticklabels(tier_metrics['update_tier'])
    ax2.set_title('User Metrics by Update Frequency Tier')
    ax2.tick_params(axis='x', rotation=45)
    
    # Add value labels to bars
    for i, v in enumerate(tier_metrics['active_devices_last_30_days']):
        ax2.text(i - width/2, v, f'{v:,.0f}', ha='center', va='bottom', fontsize=9)
    
    for i, v in enumerate(tier_metrics['rolling_total_average_rating']):
        ax2b.text(i + width/2, v, f'{v:.2f}', ha='center', va='bottom', fontsize=9)
    
    # Create single legend
    from matplotlib.patches import Patch
    legend_elements = [
        Patch(facecolor='skyblue', alpha=0.8, edgecolor='black', label='Active Devices'),
        Patch(facecolor='salmon', alpha=0.8, edgecolor='black', label='Average Rating')
    ]
    ax2.legend(handles=legend_elements, loc='upper right')
    
    plt.suptitle('App Update Frequency Interaction Effects on User Metrics', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.savefig('update_frequency_interaction.png', dpi=300, bbox_inches='tight')
    plt.close()
else:
    # Create simpler visualization if data is limited
    ax1 = plt.subplot(1, 1, 1)
    ax1.text(0.5, 0.5, 'Insufficient data\nfor update frequency analysis', 
            ha='center', va='center', transform=ax1.transAxes, fontsize=14)
    ax1.set_title('Update Frequency Interaction Effects')
    plt.tight_layout()
    plt.savefig('update_frequency_interaction.png', dpi=300, bbox_inches='tight')
    plt.close()

# Close database connection
conn.close()

print("Visualizations created successfully!")
print("1. acquisition_efficiency_decay.png")
print("2. nonlinear_relationships.png")
print("3. multidimensional_decay_analysis.png")
print("4. update_frequency_interaction.png")
