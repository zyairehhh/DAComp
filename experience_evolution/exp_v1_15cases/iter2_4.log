    SELECT date_day, device, device_installs, device_uninstalls, device_upgrades,
           active_devices_last_30_days, average_rating, rolling_total_average_rating,
           update_events, package_name
    FROM google_play__device_report
""", conn)
device_df['date_day'] = pd.to_datetime(device_df['date_day'])
device_df['month'] = device_df['date_day'].dt.to_period('M')
print("\nDevice data shape:", device_df.shape)
print(device_df.head())

# Load time series trends (global per day per package)
trends_df = pd.read_sql_query("""
