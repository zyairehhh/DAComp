ax5b.set_title('Average Time to First Close')
ax5b.set_ylim(0, 200)
for i, v in enumerate(close_times):
    ax5b.text(i, v + 5, f'{v:.1f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('stage_durations.png', dpi=300)
print("Saved stage_durations.png")
plt.close()

print("All charts generated.")
