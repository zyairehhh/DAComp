```
import pandas as pd
import numpy as np

df = pd.read_csv('source_composite.csv')
# Assign cost per hire (in thousands)
cost_per_hire = {
    'Headhunter': 20,
    'University Recruiting': 5,
    'Employee Referral': 2,
    'LinkedIn': 0.5,
    'Indeed': 0.5,
    'Glassdoor': 0.5,
    'AngelList': 0.5,
    'Company Website': 0.1
}
df['cost_per_hire'] = df['source_name'].map(cost_per_hire)

# Load current hires per source
import sqlite3
conn = sqlite3.connect('dacomp-067.sqlite')
hire_counts = pd.read_sql_query("""
SELECT tps.source_name, COUNT(DISTINCT cs.candidate_id) as current_hires
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
GROUP BY tps.source_name
""", conn)
df = df.merge(hire_counts, on='source_name', how='left')

# Total hires overall (from diversity_metrics) 4432
total_hires = 4432
df['current_cost'] = df['current_hires'] * df['cost_per_hire']
total_current_cost = df['current_cost'].sum()
print(f"Total current cost: ${total_current_cost:.0f}k")
target_cost = total_current_cost * 0.85
print(f"Target cost: ${target_cost:.0f}k")

# Allocation based on cost-weighted score
df = df.sort_values('cost_weighted_score', ascending=False)
df['allocation_weight'] = df['cost_weighted_score'] / df['cost_weighted_score'].sum()
df['new_hires'] = df['allocation_weight'] * total_hires
df['new_hires_int'] = df['new_hires'].round().astype(int)
diff = total_hires - df['new_hires_int'].sum()
df.loc[df.index[0], 'new_hires_int'] += diff

df['new_cost'] = df['new_hires_int'] * df['cost_per_hire']
new_total_cost = df['new_cost'].sum()
reduction = (1 - new_total_cost/total_current_cost)*100
print(f"New total cost: ${new_total_cost:.0f}k, reduction: {reduction:.1f}%")
print(df[['source_name','current_hires','new_hires_int','cost_per_hire','new_cost','cost_weighted_score']].to_string(index=False))
print(f"Total hires allocated: {df['new_hires_int'].sum()}")
print(f"Cost savings: ${total_current_cost - new_total_cost:.0f}k")
```
