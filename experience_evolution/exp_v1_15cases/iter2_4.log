import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-022.sqlite')

# Query to get per-km fare by vehicle type and hour
query = """
SELECT 
    "Vehicle Type",
    CAST(substr("Time", 1, 2) AS INTEGER) as hour,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare,
    COUNT(*) as rides
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Vehicle Type", hour
ORDER BY 
    "Vehicle Type", hour
"""

df = pd.read_sql_query(query, conn)

# For each vehicle type, get top 5 hours by avg_per_km_fare
top_hours_by_type = {}
for vtype in df["Vehicle Type"].unique():
    subset = df[df["Vehicle Type"] == vtype].sort_values("avg_per_km_fare", ascending=False).head(5)
    top_hours_by_type[vtype] = subset[["hour", "avg_per_km_fare", "rides"]]

# Print results
for vtype, data in top_hours_by_type.items():
    print(f"\nVehicle Type: {vtype}")
    print(data.to_string(index=False))

conn.close()
```
