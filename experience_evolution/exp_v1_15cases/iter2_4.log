import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib

# Ensure English labels
matplotlib.rcParams.update({'font.size': 12})

def fetch_data(db_path):
    conn = sqlite3.connect(db_path)
    # Department sizes
    dept_sizes = pd.read_sql_query("SELECT Department, COUNT(*) as dept_size FROM user_information_table GROUP BY Department", conn)
    # Abnormal login counts per department
    abnormal_counts = pd.read_sql_query("""
        SELECT ui.Department, COUNT(al.[Anomaly ID]) as abnormal_count
        FROM abnormal_logins_table al
        JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
        JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
        GROUP BY ui.Department
    """, conn)
    # Risk level counts per department
    risk_counts = pd.read_sql_query("""
        SELECT ui.Department, al.[Risk Level], COUNT(*) as count
        FROM abnormal_logins_table al
        JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
        JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
        GROUP BY ui.Department, al.[Risk Level]
    """, conn)
    # Anomaly type counts per department
    type_counts = pd.read_sql_query("""
        SELECT ui.Department, al.[Anomaly Type], COUNT(*) as count
        FROM abnormal_logins_table al
        JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
        JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
        GROUP BY ui.Department, al.[Anomaly Type]
    """, conn)
    conn.close()
    return dept_sizes, abnormal_counts, risk_counts, type_counts

def plot_abnormal_rate(dept_sizes, abnormal_counts):
    df = pd.merge(dept_sizes, abnormal_counts, on='Department', how='left')
    df['abnormal_rate'] = df['abnormal_count'] / df['dept_size']
    df = df.sort_values('abnormal_rate', ascending=False)
    
    fig, ax = plt.subplots(figsize=(10, 6))
    bars = ax.bar(df['Department'], df['abnormal_rate'], color='steelblue', edgecolor='black')
    ax.set_title('Abnormal Login Rate by Department', fontsize=16)
    ax.set_xlabel('Department', fontsize=14)
    ax.set_ylabel('Abnormal Logins per Employee', fontsize=14)
    # Annotate values
    for bar, rate in zip(bars, df['abnormal_rate']):
        height = bar.get_height()
        ax.text(bar.get_x() + bar.get_width()/2., height + 0.005,
                f'{rate:.3f}', ha='center', va='bottom', fontsize=11)
    plt.xticks(rotation=15)
    plt.tight_layout()
    plt.savefig('abnormal_rate_by_dept.png', dpi=300)
    plt.close()

def plot_risk_composition(risk_counts):
    # Pivot to wide format
    pivot = risk_counts.pivot(index='Department', columns='Risk Level', values='count').fillna(0)
    # Order of risk levels from low to high
    risk_order = ['Low', 'Medium', 'High', 'Severe']
    pivot = pivot.reindex(columns=risk_order)
    
    fig, ax = plt.subplots(figsize=(10, 6))
    pivot.plot(kind='bar', stacked=True, ax=ax, color=['limegreen', 'gold', 'orange', 'red'])
    ax.set_title('Abnormal Login Risk Level Composition by Department', fontsize=16)
    ax.set_xlabel('Department', fontsize=14)
    ax.set_ylabel('Number of Abnormal Logins', fontsize=14)
    ax.legend(title='Risk Level', fontsize=11)
    plt.xticks(rotation=15)
    plt.tight_layout()
    plt.savefig('risk_composition_by_dept.png', dpi=300)
    plt.close()

def plot_anomaly_type_composition(type_counts):
    pivot = type_counts.pivot(index='Department', columns='Anomaly Type', values='count').fillna(0)
    fig, ax = plt.subplots(figsize=(10, 6))
    pivot.plot(kind='bar', stacked=True, ax=ax, colormap='Set2')
    ax.set_title('Abnormal Login Types by Department', fontsize=16)
    ax.set_xlabel('Department', fontsize=14)
    ax.set_ylabel('Number of Abnormal Logins', fontsize=14)
    ax.legend(title='Anomaly Type', fontsize=11)
    plt.xticks(rotation=15)
    plt.tight_layout()
    plt.savefig('anomaly_type_by_dept.png', dpi=300)
    plt.close()

def plot_severity_heatmap(risk_counts):
    # Create a heatmap of risk level counts per department
    pivot = risk_counts.pivot(index='Department', columns='Risk Level', values='count').fillna(0)
    risk_order = ['Low', 'Medium', 'High', 'Severe']
    pivot = pivot.reindex(columns=risk_order)
    
    fig, ax = plt.subplots(figsize=(8, 6))
    im = ax.imshow(pivot.values, cmap='YlOrRd', aspect='auto')
    ax.set_xticks(range(len(risk_order)))
    ax.set_yticks(range(len(pivot.index)))
    ax.set_xticklabels(risk_order)
    ax.set_yticklabels(pivot.index)
    ax.set_xlabel('Risk Level', fontsize=14)
    ax.set_ylabel('Department', fontsize=14)
    ax.set_title('Heatmap of Abnormal Logins by Department and Risk Level', fontsize=16)
    # Add text annotations
    for i in range(len(pivot.index)):
        for j in range(len(risk_order)):
            text = ax.text(j, i, int(pivot.iloc[i, j]),
                           ha="center", va="center", color="black", fontsize=12)
    plt.colorbar(im, ax=ax, label='Count')
    plt.tight_layout()
    plt.savefig('risk_heatmap_by_dept.png', dpi=300)
    plt.close()

if __name__ == '__main__':
    dept_sizes, abnormal_counts, risk_counts, type_counts = fetch_data('dacomp-035.sqlite')
    plot_abnormal_rate(dept_sizes, abnormal_counts)
    plot_risk_composition(risk_counts)
    plot_anomaly_type_composition(type_counts)
    plot_severity_heatmap(risk_counts)
    print("Plots generated.")
```

