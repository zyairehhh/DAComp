Action: LOCAL_DB_SQL(file_path="/workspace/dacomp-035.sqlite", command="WITH dept_stats AS (
    SELECT u.Department,
           COUNT(DISTINCT u.`User ID`) as total_users,
           COUNT(DISTINCT l.`Login Record ID`) as total_logins,
           SUM(CASE WHEN a.`Anomaly ID` IS NOT NULL THEN 1 ELSE 0 END) as abnormal_logins,
           SUM(CASE WHEN a.`Confirmation Status` = 'Confirmed' THEN 1 ELSE 0 END) as confirmed_abnormal,
           SUM(CASE WHEN a.`Risk Level` IN ('Severe', 'High') THEN 1 ELSE 0 END) as high_risk_count
    FROM login_records_table l
    LEFT JOIN abnormal_logins_table a ON l.`Login Record ID` = a.`Login Record ID`
    JOIN user_information_table u ON l.`User ID` = u.`User ID`
    GROUP BY u.Department
)
SELECT Department,
       total_users,
       total_logins,
       abnormal_logins,
       ROUND(abnormal_logins * 100.0 / total_logins, 2) as abnormal_rate_pct,
       confirmed_abnormal,
       ROUND(confirmed_abnormal * 100.0 / abnormal_logins, 2) as confirmed_rate_pct,
       high_risk_count,
       ROUND(high_risk_count * 100.0 / abnormal_logins, 2) as high_risk_rate_pct
FROM dept_stats
ORDER BY confirmed_rate_pct DESC;", output="direct")
