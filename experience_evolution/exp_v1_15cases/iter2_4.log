type_pivot = type_counts.pivot(index='Department', columns='Anomaly Type', values='count').fillna(0)
type_pivot = type_pivot.reset_index()
type_pivot.columns = ['Department', 'anomaly_device', 'anomaly_frequent', 'anomaly_multiple_ips', 'anomaly_remote']
df = pd.merge(df, type_pivot, on='Department', how='left')

# Confirmation status
conf_pivot = confirmation_counts.pivot(index='Department', columns='Confirmation Status', values='count').fillna(0)
conf_pivot = conf_pivot.reset_index()
conf_pivot.columns = ['Department', 'confirmed', 'pending']
df = pd.merge(df, conf_pivot, on='Department', how='left')
df['pending_rate'] = df['pending'] / df['abnormal_logins']

# Compute composite risk index (custom)
# Weight factors: abnormal_rate, avg_severity, pending_rate, proportion of high severity anomalies, remote login proportion, multiple IPs proportion, inactive_ratio
# Let's create a scoring system (higher is worse)
df['high_sev_prop'] = (df.get('risk_high',0) + df.get('risk_severe',0)) / df['abnormal_logins']
df['remote_prop'] = df['anomaly_remote'] / df['abnormal_logins']
df['multiple_ips_prop'] = df['anomaly_multiple_ips'] / df['abnormal_logins']

# Normalize each metric to 0-1 scale per department
metrics = ['abnormal_rate', 'avg_severity', 'pending_rate', 'high_sev_prop', 'remote_prop', 'multiple_ips_prop', 'inactive_ratio']
for m in metrics:
    min_val = df[m].min()
    max_val = df[m].max()
    if max_val - min_val > 0:
        df[m + '_norm'] = (df[m] - min_val) / (max_val - min_val)
    else:
        df[m + '_norm'] = 0

# Weight each normalized metric (custom importance)
weights = {
    'abnormal_rate_norm': 0.2,
    'avg_severity_norm': 0.2,
    'pending_rate_norm': 0.15,
    'high_sev_prop_norm': 0.15,
    'remote_prop_norm': 0.1,
    'multiple_ips_prop_norm': 0.1,
    'inactive_ratio_norm': 0.1
}
df['composite_risk'] = sum(df[col] * weight for col, weight in weights.items())

# Round values for readability
for col in df.columns:
    if df[col].dtype == 'float64':
        df[col] = df[col].round(4)

# Sort by composite risk descending
df = df.sort_values('composite_risk', ascending=False)

print("Department Risk Analysis:")
print(df.to_string(index=False))
print("\n--- Key Metrics (sorted by composite risk) ---")
for idx, row in df.iterrows():
    print(f"{row['Department']}: Composite Risk {row['composite_risk']:.4f}, Abnormal Rate {row['abnormal_rate']:.2%}, Avg Severity {row['avg_severity']:.2f}, Pending Rate {row['pending_rate']:.2%}")
''')
