WHERE cr.date_day >= '2024-07-01'  # Last ~3.5 months for clearer visualization
LIMIT 1000
"""

multi_dim_data = pd.read_sql_query(query4, conn)
multi_dim_data['date_day'] = pd.to_datetime(multi_dim_data['date_day'])

if len(multi_dim_data) > 0:
    # Create a pivot table for heatmap visualization
    heatmap_data = multi_dim_data.pivot_table(
        values='store_listing_conversion_rate',
        index='region',
        columns='device',
        aggfunc='mean'
    ).fillna(0)
    
    # Select top devices for better visualization
    if len(heatmap_data.columns) > 5:
        top_devices = heatmap_data.columns[heatmap_data.mean().nlargest(5).index]
        heatmap_data = heatmap_data[top_devices]
    
    fig3 = plt.figure(figsize=(12, 8))
    ax1 = plt.subplot(2, 2, 1)
    sns.heatmap(heatmap_data, annot=True, fmt='.3f', cmap='YlOrRd', ax=ax1)
    ax1.set_title('Avg Conversion Rate by Region-Device Combination')
    ax1.set_xlabel('Device')
    ax1.set_ylabel('Region')
    ax1.tick_params(axis='x', rotation=45)
    
    # Decay analysis by region (simplified)
    ax2 = plt.subplot(2, 2, 2)
    region_decay = multi_dim_data.groupby(['region', pd.Grouper(key='date_day', freq='M')])['store_listing_conversion_rate'].mean().reset_index()
    
    for region in region_decay['region'].unique():
        region_data = region_decay[region_decay['region'] == region]
        ax2.plot(region_data['date_day'], region_data['store_listing_conversion_rate'], marker='o', label=region)
    
    ax2.set_title('Monthly Conversion Rate Decay by Region')
    ax2.set_xlabel('Month')
    ax2.set_ylabel('Avg Conversion Rate')
    ax2.legend()
    ax2.tick_params(axis='x', rotation=45)
    
    # 3D visualization concept (2D projection)
    ax3 = plt.subplot(2, 2, 3)
    scatter = ax3.scatter(
