import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

conn = sqlite3.connect("dacomp-058.sqlite")
df = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)
df['year_month'] = pd.to_datetime(df['year_month'], format='%Y-%m')
df['year'] = df['year_month'].dt.year
df['month'] = df['year_month'].dt.month

# Filter for cost > 1000 and roas < 0.8
df_filtered = df[(df['cost'] > 1000) & (df['roas'] < 0.8)].copy()

# Compute YoY growth rate per campaign, but we need at least two years of data.
# Let's calculate average roas, cost, health score per month across all filtered campaigns.
monthly_agg = df_filtered.groupby('year_month').agg(
    avg_roas=('roas', 'mean'),
    total_cost=('cost', 'sum'),
    avg_ctr=('ctr', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean'),
    avg_impression_share=('impression_share', 'mean'),
    count=('campaign_id', 'size')
).reset_index().sort_values('year_month')
print("Monthly aggregated metrics for underperforming campaigns:")
print(monthly_agg)

# Calculate YoY growth for each month
monthly_agg['prev_year_month'] = monthly_agg['year_month'] + pd.DateOffset(years=1)
# Merge with itself to get previous year values
merged = pd.merge(monthly_agg, monthly_agg, left_on='year_month', right_on='prev_year_month', 
                  suffixes=('', '_prev'), how='left')
merged['yoy_growth_roas'] = (merged['avg_roas'] - merged['avg_roas_prev']) / merged['avg_roas_prev'] * 100
merged['yoy_growth_cost'] = (merged['total_cost'] - merged['total_cost_prev']) / merged['total_cost_prev'] * 100
print("\nYear-over-Year growth (where prior year exists):")
print(merged[['year_month', 'avg_roas', 'avg_roas_prev', 'yoy_growth_roas', 'total_cost', 'total_cost_prev', 'yoy_growth_cost']])

# Seasonal variation: compute average per month across years
df_filtered['month_name'] = df_filtered['year_month'].dt.month
seasonal = df_filtered.groupby('month_name').agg(
    avg_roas=('roas', 'mean'),
    avg_cost=('cost', 'mean'),
    avg_ctr=('ctr', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean')
).reset_index()
print("\nSeasonal variation (monthly averages across years):")
print(seasonal)

conn.close()
