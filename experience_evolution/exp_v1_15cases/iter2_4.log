```
import sqlite3
import pandas as pd

conn = sqlite3.connect("dacomp-035.sqlite")

# Get total users per department
total_users_q = "SELECT Department, COUNT(*) as total_users FROM user_information_table GROUP BY Department;"
total_users_df = pd.read_sql(total_users_q, conn)

# Get active users per department (users with at least one login)
active_users_q = """
SELECT ui.Department, COUNT(DISTINCT ui."User ID") as active_users
FROM user_information_table ui
JOIN login_records_table lr ON ui."User ID" = lr."User ID"
GROUP BY ui.Department;
"""
active_users_df = pd.read_sql(active_users_q, conn)

# Get logins and abnormal data
query = """
SELECT 
    ui.Department,
    ui."User ID",
    lr."Login Record ID",
    a."Anomaly ID",
    a."Anomaly Type",
    a."Risk Level",
    a."Anomaly Score",
    a."Confirmation Status"
FROM login_records_table lr
JOIN user_information_table ui ON lr."User ID" = ui."User ID"
LEFT JOIN abnormal_logins_table a ON lr."Login Record ID" = a."Login Record ID"
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Merge total and active users
stats = pd.merge(total_users_df, active_users_df, on='Department', how='left')
stats['Active Ratio'] = stats['active_users'] / stats['total_users']

# Compute per department from df
grouped = df.groupby('Department').agg(
    total_logins=('Login Record ID', 'count'),
    abnormal_logins=('Anomaly ID', lambda x: x.notna().sum()),
    avg_anomaly_score=('Anomaly Score', 'mean'),
).reset_index()

# Compute severity average
risk_map = {'Low':1, 'Medium':2, 'High':3, 'Severe':4}
df['severity_num'] = df['Risk Level'].map(risk_map)
severity_avg = df[df['Anomaly ID'].notna()].groupby('Department')['severity_num'].mean().reset_index(name='avg_severity')

# Compute anomaly type counts
abnormal_df = df[df['Anomaly ID'].notna()].copy()
type_counts = pd.crosstab(abnormal_df['Department'], abnormal_df['Anomaly Type']).reset_index()

# Combine
result_df = pd.merge(stats, grouped, on='Department', how='left')
result_df = pd.merge(result_df, severity_avg, on='Department', how='left')
result_df = pd.merge(result_df, type_counts, on='Department', how='left')
result_df.fillna(0, inplace=True)

# Compute derived metrics
result_df['Abnormal Rate'] = result_df['abnormal_logins'] / result_df['total_logins']
result_df['Abnormal per Total User'] = result_df['abnormal_logins'] / result_df['total_users']
result_df['Abnormal per Active User'] = result_df['abnormal_logins'] / result_df['active_users']

# Reorder columns
cols = ['Department', 'total_users', 'active_users', 'Active Ratio', 'total_logins',
        'abnormal_logins', 'Abnormal Rate', 'Abnormal per Total User', 'Abnormal per Active User',
        'avg_anomaly_score', 'avg_severity'] + list(type_counts.columns[1:])
result_df = result_df[cols]

pd.set_option('display.max_columns', None)
pd.set_option('display.width', None)
print(result_df)
print("\n--- Rankings (Higher is worse) ---")
metrics = ['Abnormal Rate', 'Abnormal per Total User', 'Abnormal per Active User', 'avg_severity',
           'Remote Login', 'Multiple IPs in short time', 'Device anomaly', 'Frequent login']
for m in metrics:
    if m in result_df.columns:
        worst_dept = result_df.loc[result_df[m].idxmax()]
        print(f"Highest {m}: {worst_dept['Department']} ({worst_dept[m]:.3f})")
```

