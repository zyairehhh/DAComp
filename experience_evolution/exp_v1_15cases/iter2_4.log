import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-092.sqlite')

# High-volatility customer IDs
query = """
SELECT customer_id,
       AVG(customer_margin_volatility) as avg_margin_volatility
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql(query, conn)
threshold = df_cust_vol['avg_margin_volatility'].quantile(0.75)
high_vol_ids = df_cust_vol[df_cust_vol['avg_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers: {len(high_vol_ids)}")

# 1. Coefficient of variation (gross_profit) over past 12 months
max_date = pd.read_sql("SELECT MAX(transaction_date) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'][0]
max_date = pd.to_datetime(max_date)
cutoff_date = max_date - pd.DateOffset(months=12)

query = f"""
SELECT customer_id, gross_profit
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
  AND transaction_date >= ?
"""
params = high_vol_ids + [cutoff_date.strftime('%Y-%m-%d')]
df_recent = pd.read_sql(query, conn, params=params)
cv_df = df_recent.groupby('customer_id')['gross_profit'].apply(
    lambda x: x.std() / x.mean() if x.mean() != 0 else np.nan
).reset_index(name='cv_gross_profit')

# 2. Variance of quarter-over-quarter invoice_total growth rate
query_q = f"""
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as quarterly_invoice_total
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
"""
df_quarterly = pd.read_sql(query_q, conn, params=high_vol_ids)

def compute_growth_variance(df):
    if df.shape[0] < 2:
        return np.nan
    df = df.sort_values(['revenue_year', 'revenue_quarter'])
    df['prev_total'] = df['quarterly_invoice_total'].shift(1)
    df['growth_rate'] = (df['quarterly_invoice_total'] - df['prev_total']) / df['prev_total']
    growth_rates = df['growth_rate'].dropna()
    if len(growth_rates) == 0:
        return np.nan
    return growth_rates.var()

growth_var = df_quarterly.groupby('customer_id', group_keys=False).apply(compute_growth_variance).reset_index(name='var_qoq_growth')
growth_var = growth_var[['customer_id', 'var_qoq_growth']]

# Merge
metrics = pd.merge(cv_df, growth_var, on='customer_id', how='outer')

# 3. Behavioral features from customer_analytics
query_behav = f"""
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
       lifecycle_stage, credit_grade, risk_assessment
FROM quickbooks__customer_analytics
WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
"""
df_behav = pd.read_sql(query_behav, conn, params=high_vol_ids)

# Merge everything
df_risk = pd.merge(metrics, df_behav, on='customer_id', how='left')
print(f"Risk dataset shape: {df_risk.shape}")

# MAP categorical to numeric risk scores (0-1)
rfm_risk_score = {
    'Need Attention': 1.0,
    'At Risk': 1.0,
    'Potential Loyalists': 0.4,
    'Loyal Customers': 0.2,
    'New Customers': 0.6,
    'Champions': 0.0,
}
pay_risk_score = {
    'Poor': 1.0,
    'Average': 0.7,
    'Good': 0.3,
    'Excellent': 0.0
}
lifecycle_risk_score = {
    'New Customer': 0.8,
    'Growing': 0.4,
    'Mature': 0.2,
    'Loyal Customer': 0.0
}
df_risk['rfm_risk_norm'] = df_risk['rfm_segment'].map(rfm_risk_score)
df_risk['pay_risk_norm'] = df_risk['payment_behavior'].map(pay_risk_score)
df_risk['lifecycle_risk_norm'] = df_risk['lifecycle_stage'].map(lifecycle_risk_score)

# Revenue trend correlation: negative correlation indicates higher risk
def trend_risk_norm(x):
    if pd.isna(x):
        return 0.5
    # map from -1 to 1 -> risk 1 to 0
    return (1 - x) / 2  # so -1 =>1, 1=>0

df_risk['trend_risk_norm'] = df_risk['revenue_trend_correlation'].apply(trend_risk_norm)

# Normalize volatility metrics (0-1) where higher value indicates higher risk
def normalize_to_unit(series, higher_worse=True):
    # replace NaN with median
    median = series.median()
    s = series.fillna(median)
    if s.max() == s.min():
        return pd.Series(0.5, index=s.index)
    if higher_worse:
        return (s - s.min()) / (s.max() - s.min())
    else:
        return 1 - (s - s.min()) / (s.max() - s.min())

df_risk['cv_risk_norm'] = normalize_to_unit(df_risk['cv_gross_profit'], higher_worse=True)
df_risk['growth_var_risk_norm'] = normalize_to_unit(df_risk['var_qoq_growth'], higher_worse=True)

# Compute overall risk score (weighted sum)
weights = {
    'cv_risk_norm': 0.2,
    'growth_var_risk_norm': 0.2,
    'rfm_risk_norm': 0.2,
    'pay_risk_norm': 0.2,
    'lifecycle_risk_norm': 0.1,
    'trend_risk_norm': 0.1
}
df_risk['overall_risk_score'] = (df_risk['cv_risk_norm'] * weights['cv_risk_norm'] +
                                  df_risk['growth_var_risk_norm'] * weights['growth_var_risk_norm'] +
                                  df_risk['rfm_risk_norm'] * weights['rfm_risk_norm'] +
                                  df_risk['pay_risk_norm'] * weights['pay_risk_norm'] +
                                  df_risk['lifecycle_risk_norm'] * weights['lifecycle_risk_norm'] +
                                  df_risk['trend_risk_norm'] * weights['trend_risk_norm'])

# Risk tiers: percentiles
def assign_tier(score):
    if score >= df_risk['overall_risk_score'].quantile(0.75):
        return 'High'
    elif score >= df_risk['overall_risk_score'].quantile(0.25):
        return 'Medium'
    else:
        return 'Low'

df_risk['risk_tier'] = df_risk['overall_risk_score'].apply(assign_tier)

print("Risk tier distribution:")
print(df_risk['risk_tier'].value_counts())
print("\nOverall risk score summary:")
print(df_risk['overall_risk_score'].describe())

# Top 5 high-risk customers
top_high = df_risk.sort_values('overall_risk_score', ascending=False).head(5)
print("\nTop 5 high-risk customers:")
print(top_high[['customer_id', 'overall_risk_score', 'risk_tier', 'rfm_segment', 'payment_behavior', 'lifecycle_stage', 'revenue_trend_correlation', 'cv_gross_profit', 'var_qoq_growth']])
```
