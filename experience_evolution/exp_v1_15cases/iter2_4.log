    f.write(f"Best geo by ROI: {best_geo['geo_target']} (ROI {best_geo['roi']:.2f})\\n")
    f.write(f"Worst device by ROI: {worst_device['device_type']} (ROI {worst_device['roi']:.2f})\\n")
    f.write(f"Best device by ROI: {best_device['device_type']} (ROI {best_device['roi']:.2f})\\n")
    f.write(f"Month with highest MoM cost growth: {max_growth['year_month'].strftime('%Y-%m')} ({max_growth['cost_mom_pct']:.1f}%)\\n")
    f.write(f"Month with highest seasonal avg cost: Month {int(seasonal_max['month'])} (avg cost ${seasonal_max['cost']:,.0f})\\n")
    f.write(f"Top high-risk campaigns by cost: \\n")
    for idx, row in top_high_risk.iterrows():
