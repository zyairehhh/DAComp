box_data = [country_data[country_data['conversion_quartile'] == q]['quality_score'].dropna() for q in ['Q1 (Low)', 'Q2', 'Q3', 'Q4 (High)']]

bp = ax4.boxplot(box_data, labels=['Q1 (Low)', 'Q2', 'Q3', 'Q4 (High)'])
