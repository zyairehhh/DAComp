'''
import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-070.sqlite')

def run_query(query):
    return pd.read_sql_query(query, conn)

# Market maturity analysis
print("=== Market maturity effect on revenue per active device ===")
query_maturity = """
SELECT 
    c.region,
    c.total_device_installs,
    t.revenue_per_active_device
FROM google_play__country_report c
JOIN google_play__time_series_trends t 
    ON c.date_day = t.date_day AND c.package_name = t.package_name
WHERE t.revenue_per_active_device IS NOT NULL AND c.total_device_installs IS NOT NULL
LIMIT 5000;
"""
df_maturity = run_query(query_maturity)
print(f"Rows: {df_maturity.shape[0]}")

# Compute percentiles for total_device_installs
df_maturity['maturity_quartile'] = pd.qcut(df_maturity['total_device_installs'], q=4, labels=['Low', 'Medium-Low', 'Medium-High', 'High'])
print("\nAverage revenue per active device by maturity quartile:")
print(df_maturity.groupby('maturity_quartile')['revenue_per_active_device'].mean())

# Also by region
print("\nAverage revenue per active device by region:")
print(df_maturity.groupby('region')['revenue_per_active_device'].mean())

# Interaction region & maturity
print("\nAverage revenue per active device by region and maturity quartile:")
print(df_maturity.groupby(['region', 'maturity_quartile'])['revenue_per_active_device'].mean().unstack())

# 2. Decay patterns of user acquisition cost-efficiency per region and device type combination
# Since no direct combination, compute separately and discuss.
print("\n=== Region-wise conversion rate decay over months (slope) ===")
query_region_slope = """
WITH region_monthly AS (
    SELECT 
        region,
        strftime('%Y-%m', date_day) as month,
        AVG(store_listing_conversion_rate) as avg_conv,
        SUM(store_listing_acquisitions) as acquisitions,
        SUM(store_listing_visitors) as visitors
    FROM google_play__country_report
    GROUP BY region, month
)
SELECT region, month, avg_conv,
    ROW_NUMBER() OVER (PARTITION BY region ORDER BY month) as month_idx
FROM region_monthly
ORDER BY region, month;
"""
df_region_slope = run_query(query_region_slope)
# compute slope per region using polyfit
from collections import defaultdict
region_slopes = defaultdict(dict)
for region in df_region_slope['region'].unique():
    subset = df_region_slope[df_region_slope['region'] == region]
    x = subset['month_idx'].values
    y = subset['avg_conv'].values
    if len(x) >= 2:
        coeffs = np.polyfit(x, y, 1)
        slope = coeffs[0]
        region_slopes[region]['slope'] = slope
        region_slopes[region]['start'] = y[0]
        region_slopes[region]['end'] = y[-1]
    else:
        region_slopes[region]['slope'] = np.nan
        region_slopes[region]['start'] = np.nan
        region_slopes[region]['end'] = np.nan

print("Region conversion rate decay slopes:")
for region, vals in region_slopes.items():
    print(f"{region}: slope={vals['slope']:.6f} (start={vals['start']:.3f}, end={vals['end']:.3f})")

# Device type active devices decay slopes (already computed earlier)
print("\n=== Device type active devices decay slopes (top 5 positive, top 2 negative) ===")
query_device_slope = """
WITH device_monthly AS (
    SELECT 
        device,
        strftime('%Y-%m', date_day) as month,
        AVG(active_devices_last_30_days) as avg_active,
        SUM(device_installs) as installs,
        SUM(device_uninstalls) as uninstalls
    FROM google_play__device_report
    GROUP BY device, month
)
SELECT device, month, avg_active,
    ROW_NUMBER() OVER (PARTITION BY device ORDER BY month) as month_idx
FROM device_monthly
ORDER BY device, month;
"""
df_device_slope = run_query(query_device_slope)
device_slopes = defaultdict(dict)
for device in df_device_slope['device'].unique():
    subset = df_device_slope[df_device_slope['device'] == device]
    x = subset['month_idx'].values
    y = subset['avg_active'].values
    if len(x) >= 2:
        coeffs = np.polyfit(x, y, 1)
        slope = coeffs[0]
        device_slopes[device]['slope'] = slope
        device_slopes[device]['start'] = y[0]
        device_slopes[device]['end'] = y[-1]
    else:
        device_slopes[device]['slope'] = np.nan
        device_slopes[device]['start'] = np.nan
        device_slopes[device]['end'] = np.nan

# Sort by slope
sorted_devices = sorted(device_slopes.items(), key=lambda kv: kv[1]['slope'], reverse=True)
print("Top 5 growing devices:")
for device, vals in sorted_devices[:5]:
    print(f"{device}: slope={vals['slope']:.2f} (start={vals['start']:.0f}, end={vals['end']:.0f})")
print("\nTop 2 declining devices:")
for device, vals in sorted_devices[-2:]:
    print(f"{device}: slope={vals['slope']:.2f} (start={vals['start']:.0f}, end={vals['end']:.0f})")

conn.close()
''')
