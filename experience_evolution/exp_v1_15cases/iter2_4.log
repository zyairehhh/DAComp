import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import re

# Connect to database
conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation_enhanced with tags
query = """
SELECT conversation_id, conversation_initiated_type, all_conversation_tags,
       all_conversation_contacts
FROM intercom__conversation_enhanced
"""
df = pd.read_sql_query(query, conn)

# Parse tags into columns
def parse_tag(tag_str, key):
    if not isinstance(tag_str, str):
        return None
    pattern = rf'{key}:([^|]+)'
    match = re.search(pattern, tag_str)
    if match:
        return match.group(1).strip()
    else:
        return None

df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))

# Load conversation_metrics for time metrics
query_metrics = """
SELECT conversation_id, time_to_first_response_minutes, time_to_first_close_minutes
FROM intercom__conversation_metrics
"""
metrics_df = pd.read_sql_query(query_metrics, conn)
df = df.merge(metrics_df, on='conversation_id', how='left')

conn.close()

# Filter out rows where conversation_initiated_type is missing
df = df[df['conversation_initiated_type'].notna()]
df['conversation_initiated_type'] = df['conversation_initiated_type'].str.strip()

print("Data loaded.")

# Helper functions
def conversion_rate(df, condition):
    total = df.shape[0]
    converted = condition(df).sum()
    return total, converted, converted/total if total>0 else 0

# Overall funnel performance
human = df[df['conversation_initiated_type']=='human_first']
bot = df[df['conversation_initiated_type']=='bot_first']

print(f"Human-first conversations: {human.shape[0]}")
print(f"Bot-first conversations: {bot.shape[0]}")

demo_booked = lambda d: d['stage'] == 'demo_booked'
trial_activated = lambda d: d['stage'] == 'trial_activated'
closed_won = lambda d: d['stage'] == 'closed_won'

h_total, h_demo, h_demo_rate = conversion_rate(human, demo_booked)
_, h_trial, h_trial_rate = conversion_rate(human, trial_activated)
_, h_paid, h_paid_rate = conversion_rate(human, closed_won)

b_total, b_demo, b_demo_rate = conversion_rate(bot, demo_booked)
_, b_trial, b_trial_rate = conversion_rate(bot, trial_activated)
_, b_paid, b_paid_rate = conversion_rate(bot, closed_won)

# Save overall conversion rates for plotting
overall_data = {
    'Human': [h_demo_rate, h_trial_rate, h_paid_rate],
    'Bot': [b_demo_rate, b_trial_rate, b_paid_rate]
}
print("Overall conversion rates computed.")

# Plotting
import matplotlib.pyplot as plt

# Set style
plt.style.use('seaborn-v0_8-whitegrid')

# Function to add value labels on bars
def autolabel(ax, rects):
    for rect in rects:
        height = rect.get_height()
        ax.annotate(f'{height:.1%}',
                    xy=(rect.get_x() + rect.get_width() / 2, height),
                    xytext=(0, 3),
                    textcoords="offset points",
                    ha='center', va='bottom', fontsize=10)

# 1. Overall conversion rates bar chart
labels = ['Demo Booked', 'Trial Activated', 'Paid (Closed Won)']
x = range(len(labels))
width = 0.35

fig, ax = plt.subplots(figsize=(10,6))
rects1 = ax.bar([i - width/2 for i in x], overall_data['Human'], width, label='Human First', color='skyblue')
rects2 = ax.bar([i + width/2 for i in x], overall_data['Bot'], width, label='Bot First', color='lightcoral')

ax.set_xlabel('Funnel Stage', fontsize=12)
ax.set_ylabel('Conversion Rate (%)', fontsize=12)
ax.set_title('Overall Conversion Rates by First Responder Type', fontsize=14)
ax.set_xticks(x)
ax.set_xticklabels(labels)
ax.legend()
ax.set_ylim(0, 0.15)
autolabel(ax, rects1)
autolabel(ax, rects2)
plt.tight_layout()
plt.savefig('overall_conversion_rates.png', dpi=300)
print("Saved overall_conversion_rates.png")
plt.close()

# 2. Conditional conversion rates (demo->trial, trial->paid)
# Compute conditional conversion at contact level
df['contact_id'] = df['all_conversation_contacts'].str.strip()
contact_groups = df.groupby('contact_id').agg({
    'stage': list,
    'conversation_initiated_type': list,
}).reset_index()

stage_order = {'demo_booked': 1, 'trial_activated': 2, 'closed_won': 3}
def max_stage(stages):
    valid = [s for s in stages if s in stage_order]
    if not valid:
        return None
    return max(valid, key=lambda x: stage_order[x])

contact_groups['highest_stage'] = contact_groups['stage'].apply(max_stage)
def get_responder_for_highest_stage(row):
    stages = row['stage']
    responders = row['conversation_initiated_type']
    highest = row['highest_stage']
    if highest is None:
        return None
    for i, s in enumerate(stages):
        if s == highest:
            return responders[i]
    return None
contact_groups['responder_type'] = contact_groups.apply(get_responder_for_highest_stage, axis=1)
contact_groups['had_demo'] = contact_groups['stage'].apply(lambda lst: 'demo_booked' in lst)
contact_groups['had_trial'] = contact_groups['stage'].apply(lambda lst: 'trial_activated' in lst)
contact_groups['had_paid'] = contact_groups['stage'].apply(lambda lst: 'closed_won' in lst)

def conditional_rate(subset, col_from, col_to):
    from_count = subset[subset[col_from]].shape[0]
    to_count = subset[subset[col_from] & subset[col_to]].shape[0]
    rate = to_count / from_count if from_count > 0 else 0
    return from_count, to_count, rate

human_contacts = contact_groups[contact_groups['responder_type']=='human_first']
bot_contacts = contact_groups[contact_groups['responder_type']=='bot_first']

h_demo_count, h_trial_from_demo, h_demo_trial_rate = conditional_rate(human_contacts, 'had_demo', 'had_trial')
h_trial_count, h_paid_from_trial, h_trial_paid_rate = conditional_rate(human_contacts, 'had_trial', 'had_paid')
b_demo_count, b_trial_from_demo, b_demo_trial_rate = conditional_rate(bot_contacts, 'had_demo', 'had_trial')
b_trial_count, b_paid_from_trial, b_trial_paid_rate = conditional_rate(bot_contacts, 'had_trial', 'had_paid')

print("Conditional conversion rates:")
print(f"Human: demo->trial {h_demo_trial_rate:.1%}, trial->paid {h_trial_paid_rate:.1%}")
print(f"Bot: demo->trial {b_demo_trial_rate:.1%}, trial->paid {b_trial_paid_rate:.1%}")

# Plot conditional conversion rates
fig2, ax2 = plt.subplots(figsize=(8,6))
cond_labels = ['Demo → Trial', 'Trial → Paid']
x2 = range(len(cond_labels))
human_cond = [h_demo_trial_rate, h_trial_paid_rate]
bot_cond = [b_demo_trial_rate, b_trial_paid_rate]

rects1 = ax2.bar([i - width/2 for i in x2], human_cond, width, label='Human First', color='skyblue')
rects2 = ax2.bar([i + width/2 for i in x2], bot_cond, width, label='Bot First', color='lightcoral')

ax2.set_xlabel('Transition', fontsize=12)
ax2.set_ylabel('Conversion Rate (%)', fontsize=12)
ax2.set_title('Conditional Conversion Rates by First Responder Type', fontsize=14)
ax2.set_xticks(x2)
ax2.set_xticklabels(cond_labels)
ax2.legend()
ax2.set_ylim(0, 0.25)
autolabel(ax2, rects1)
autolabel(ax2, rects2)
plt.tight_layout()
plt.savefig('conditional_conversion_rates.png', dpi=300)
print("Saved conditional_conversion_rates.png")
plt.close()

# 3. Paid conversion rate by region
# Compute paid conversion per region per responder type
regions = df['region'].unique()
regions = [r for r in regions if r is not None]
regions.sort()

human_region_paid = []
bot_region_paid = []
for region in regions:
    human_region = human[human['region']==region]
    bot_region = bot[bot['region']==region]
    h_total_r, h_paid_r, h_rate = conversion_rate(human_region, closed_won)
    b_total_r, b_paid_r, b_rate = conversion_rate(bot_region, closed_won)
    human_region_paid.append(h_rate)
    bot_region_paid.append(b_rate)

# Select top N regions by total conversations
region_counts = df['region'].value_counts().head(8)  # top 8 regions
top_regions = region_counts.index.tolist()
# Filter data
top_human = []
top_bot = []
for reg in top_regions:
    idx = regions.index(reg)
    top_human.append(human_region_paid[idx])
    top_bot.append(bot_region_paid[idx])

fig3, ax3 = plt.subplots(figsize=(12,6))
x3 = range(len(top_regions))
rects1 = ax3.bar([i - width/2 for i in x3], top_human, width, label='Human First', color='skyblue')
rects2 = ax3.bar([i + width/2 for i in x3], top_bot, width, label='Bot First', color='lightcoral')
ax3.set_xlabel('Region', fontsize=12)
ax3.set_ylabel('Paid Conversion Rate (%)', fontsize=12)
ax3.set_title('Paid Conversion Rate by Region and First Responder Type', fontsize=14)
ax3.set_xticks(x3)
ax3.set_xticklabels(top_regions, rotation=45, ha='right')
ax3.legend()
ax3.set_ylim(0, 0.25)
autolabel(ax3, rects1)
autolabel(ax3, rects2)
plt.tight_layout()
plt.savefig('region_paid_conversion.png', dpi=300)
print("Saved region_paid_conversion.png")
plt.close()

# 4. Paid conversion rate by segment (segment: Startup, Mid‑Market, etc.)
segments = df['segment'].unique()
segments = [s for s in segments if s is not None]
segments.sort()
human_segment_paid = []
