import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-034.sqlite')
query = """
SELECT 
    a.sku_id,
    a."SKU Quantity" as quantity,
    a."SKU Selling Price" as selling_price,
    b."Level 1 Category Name" as category
FROM attachment_1 a
LEFT JOIN attachment_4 b ON a.sku_id = b.sku_id
UNION ALL
SELECT 
    c.sku_id,
    c."SKU Quantity",
    c."SKU Selling Price",
    d."Level 1 Category Name"
FROM attachment_2 c
LEFT JOIN attachment_4 d ON c.sku_id = d.sku_id
"""
df = pd.read_sql(query, conn)
total_qty = df.groupby('category')['quantity'].sum().reset_index()
total_qty.columns = ['category', 'total_quantity_all']
discounted = df[df['selling_price'] < df['selling_price']]  # Wait, need original price
# Actually need original price. Let's load with original price.
query2 = """
SELECT 
    a.sku_id,
    a."SKU Quantity" as quantity,
    a."SKU Price" as original_price,
    a."SKU Selling Price" as selling_price,
    b."Level 1 Category Name" as category
FROM attachment_1 a
LEFT JOIN attachment_4 b ON a.sku_id = b.sku_id
UNION ALL
SELECT 
    c.sku_id,
    c."SKU Quantity",
    c."SKU Price",
    c."SKU Selling Price",
    d."Level 1 Category Name"
FROM attachment_2 c
LEFT JOIN attachment_4 d ON c.sku_id = d.sku_id
"""
df2 = pd.read_sql(query2, conn)
df2['is_discounted'] = df2['selling_price'] < df2['original_price']
total_all = df2.groupby('category').agg(
    total_quantity=('quantity', 'sum'),
    discounted_quantity=('quantity', lambda x: x[df2['is_discounted']].sum())
).reset_index()
total_all['discount_share'] = total_all['discounted_quantity'] / total_all['total_quantity']
print(total_all.sort_values('total_quantity', ascending=False))
total_all.to_csv('total_sales_by_category.csv', index=False)
conn.close()
```
