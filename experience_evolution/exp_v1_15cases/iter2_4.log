import sqlite3
import pandas as pd

conn = sqlite3.connect("dacomp-035.sqlite")

# Map risk levels to numeric severity
risk_map = {'Low':1, 'Medium':2, 'High':3, 'Severe':4}

# Join tables
query = """
SELECT 
    ui.Department,
    ui."User ID",
    lr."Login Record ID",
    a."Anomaly ID",
    a."Anomaly Type",
    a."Risk Level",
    a."Anomaly Score",
    a."Confirmation Status"
FROM login_records_table lr
JOIN user_information_table ui ON lr."User ID" = ui."User ID"
LEFT JOIN abnormal_logins_table a ON lr."Login Record ID" = a."Login Record ID"
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Compute per-department metrics
departments = df['Department'].unique()
results = []
for dept in departments:
    sub = df[df['Department'] == dept]
    total_logins = sub.shape[0]
    active_users = sub['User ID'].nunique()
    abnormal = sub[sub['Anomaly ID'].notna()]
    abnormal_count = abnormal.shape[0]
    abnormal_rate = abnormal_count / total_logins if total_logins>0 else 0
    avg_abnormal_per_user = abnormal_count / active_users if active_users>0 else 0
    # average anomaly score
    avg_score = abnormal['Anomaly Score'].mean() if not abnormal['Anomaly Score'].isnull().all() else 0
    # severity average
    abnormal['severity_num'] = abnormal['Risk Level'].map(risk_map)
    avg_severity = abnormal['severity_num'].mean() if not abnormal['severity_num'].isnull().all() else 0
    # confirmed vs pending
    confirmed = abnormal[abnormal['Confirmation Status']=='Confirmed'].shape[0]
    pending = abnormal[abnormal['Confirmation Status']=='Pending confirmation'].shape[0]
    # anomaly type distribution
    type_counts = abnormal['Anomaly Type'].value_counts().to_dict()
    results.append({
        'Department': dept,
        'Active Users': active_users,
        'Total Logins': total_logins,
        'Abnormal Logins': abnormal_count,
        'Abnormal Rate': abnormal_rate,
        'Avg Abnormal per User': avg_abnormal_per_user,
        'Avg Anomaly Score': avg_score,
        'Avg Severity (1-4)': avg_severity,
        'Confirmed Abnormal': confirmed,
        'Pending Abnormal': pending,
        'Multiple IPs': type_counts.get('Multiple IPs in short time', 0),
        'Device anomaly': type_counts.get('Device anomaly', 0),
        'Frequent login': type_counts.get('Frequent login', 0),
        'Remote Login': type_counts.get('Remote Login', 0)
    })

result_df = pd.DataFrame(results)
print(result_df)
```
