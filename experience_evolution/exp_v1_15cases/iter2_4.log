import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')
problematic_ids = pd.read_csv('problematic_with_ratio.csv')['ad_group_id'].tolist()

query = """
SELECT ad_group_id,
       SUM(spend) as total_spend,
       SUM(conversions_value) as total_conversion_value,
       SUM(clicks) as total_clicks,
       SUM(impressions) as total_impressions,
       SUM(conversions) as total_conversions
FROM google_ads__ad_group_report
GROUP BY ad_group_id
"""
df = pd.read_sql_query(query, conn)
df['is_problematic'] = df['ad_group_id'].isin(problematic_ids)
summary = df.groupby('is_problematic').agg({
    'total_spend': 'sum',
    'total_conversion_value': 'sum',
    'total_clicks': 'sum',
    'total_impressions': 'sum',
    'total_conversions': 'sum',
    'ad_group_id': 'count'
}).rename(columns={'ad_group_id': 'num_ad_groups'}).reset_index()
summary['ctr'] = summary['total_clicks'] / summary['total_impressions']
summary['cvr'] = summary['total_conversions'] / summary['total_clicks']
summary['cpc'] = summary['total_spend'] / summary['total_clicks']
summary['roi'] = summary['total_conversion_value'] / summary['total_spend']
print(summary)
```
