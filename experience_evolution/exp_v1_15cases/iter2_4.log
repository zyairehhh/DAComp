import pandas as pd
import numpy as np

df = pd.read_csv('ad_group_metrics.csv')
print("Rows:", df.shape[0])
print("Columns:", df.columns.tolist())
print("\nSummary:")
print(df[['ctr', 'cvr']].describe())

# Compute percentiles
ctr_75 = df['ctr'].quantile(0.75)
cvr_25 = df['cvr'].quantile(0.25)
print(f"\n75th percentile of CTR: {ctr_75:.4f}")
print(f"25th percentile of CVR: {cvr_25:.4f}")

# Identify problematic ad groups
problematic = df[(df['ctr'] > ctr_75) & (df['cvr'] < cvr_25)]
print(f"\nNumber of problematic ad groups: {problematic.shape[0]}")
print(problematic[['ad_group_id', 'ad_group_name', 'ctr', 'cvr']].head(10))
```
