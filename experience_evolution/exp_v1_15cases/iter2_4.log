              color=plt.cm.Paired(np.linspace(0, 1, len(directories_sorted))))

# Add percentage labels
for i, rate in enumerate(rates_sorted_dir):
    ax.text(i, rate + 0.5, f'{rate:.1f}%', ha='center', fontsize=9)

ax.set_title('High-Value Tier Rate by Directory', fontsize=14, fontweight='bold')
ax.set_xlabel('Directory', fontsize=12)
ax.set_ylabel('High-Value Tier Rate (%)', fontsize=12)
ax.set_xticks(range(len(directories_sorted)))
