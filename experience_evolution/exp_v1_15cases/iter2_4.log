import numpy as np
from datetime import datetime, timedelta

print("Creating visualizations for Stage2 analysis...")

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# ============================================================================
# PLOT 1: Acquisition Efficiency Decay Patterns
# ============================================================================
print("Creating Plot 1: Acquisition Efficiency Decay...")

query1 = """
SELECT date_day, daily_installs, daily_uninstalls, daily_revenue, revenue_per_active_device 
FROM google_play__time_series_trends 
ORDER BY date_day
"""

df_ts = pd.read_sql_query(query1, conn)
df_ts['date_day'] = pd.to_datetime(df_ts['date_day'])

if len(df_ts) > 0:
    # Get last 6 months data
    max_date = df_ts['date_day'].max()
    six_months_ago = max_date - timedelta(days=180)
    df_recent = df_ts[df_ts['date_day'] >= six_months_ago].copy()
    
    # Calculate efficiency metrics
    df_recent['install_to_uninstall_ratio'] = df_recent['daily_installs'] / (df_recent['daily_uninstalls'] + 1)
    
    fig1, axes1 = plt.subplots(2, 2, figsize=(14, 10))
    fig1.suptitle('User Acquisition Efficiency Decay Patterns (Past 6 Months)', fontsize=16, fontweight='bold')
    
    # Subplot 1: Daily installs vs uninstalls
    axes1[0, 0].plot(df_recent['date_day'], df_recent['daily_installs'], 'g-', label='Installs', alpha=0.7)
    axes1[0, 0].plot(df_recent['date_day'], df_recent['daily_uninstalls'], 'r-', label='Uninstalls', alpha=0.7)
    axes1[0, 0].set_title('Daily Installs vs Uninstalls')
    axes1[0, 0].set_xlabel('Date')
    axes1[0, 0].set_ylabel('Count')
    axes1[0, 0].legend()
    axes1[0, 0].grid(True, alpha=0.3)
    axes1[0, 0].tick_params(axis='x', rotation=45)
    
    # Subplot 2: Install-to-uninstall ratio
    axes1[0, 1].plot(df_recent['date_day'], df_recent['install_to_uninstall_ratio'], 'b-', linewidth=2)
    mean_ratio = df_recent['install_to_uninstall_ratio'].mean()
    axes1[0, 1].axhline(y=mean_ratio, color='r', linestyle='--', alpha=0.5, label=f'Mean: {mean_ratio:.2f}')
    axes1[0, 1].set_title('Install-to-Uninstall Ratio (Acquisition Efficiency)')
    axes1[0, 1].set_xlabel('Date')
    axes1[0, 1].set_ylabel('Ratio')
    axes1[0, 1].legend()
    axes1[0, 1].grid(True, alpha=0.3)
    axes1[0, 1].tick_params(axis='x', rotation=45)
    
    # Subplot 3: Revenue per active device (user value)
    axes1[1, 0].plot(df_recent['date_day'], df_recent['revenue_per_active_device'], 'orange', linewidth=2)
    mean_revenue = df_recent['revenue_per_active_device'].mean()
    axes1[1, 0].axhline(y=mean_revenue, color='r', linestyle='--', alpha=0.5, label=f'Mean: ${mean_revenue:.2f}')
    axes1[1, 0].set_title('Revenue per Active Device (User Value Metric)')
    axes1[1, 0].set_xlabel('Date')
    axes1[1, 0].set_ylabel('Revenue per Device ($)')
    axes1[1, 0].legend()
    axes1[1, 0].grid(True, alpha=0.3)
    axes1[1, 0].tick_params(axis='x', rotation=45)
    
    # Subplot 4: Weekly aggregates for trend
    df_recent['week'] = df_recent['date_day'].dt.isocalendar().week
    weekly_agg = df_recent.groupby('week').agg({
        'daily_installs': 'mean',
        'install_to_uninstall_ratio': 'mean'
    }).tail(12)  # Last 12 weeks
    
    x = range(len(weekly_agg))
    axes1[1, 1].bar(x, weekly_agg['daily_installs'], alpha=0.7, color='lightgreen', label='Avg Installs')
    axes1[1, 1].set_xlabel('Week Number')
    axes1[1, 1].set_ylabel('Avg Daily Installs', color='lightgreen')
    axes1[1, 1].tick_params(axis='y', labelcolor='lightgreen')
    axes1[1, 1].set_xticks(x)
    axes1[1, 1].set_xticklabels(weekly_agg.index, rotation=45)
    
    ax2 = axes1[1, 1].twinx()
    ax2.plot(x, weekly_agg['install_to_uninstall_ratio'], 'b-', linewidth=2, marker='o', label='Efficiency Ratio')
    ax2.set_ylabel('Efficiency Ratio', color='blue')
    ax2.tick_params(axis='y', labelcolor='blue')
    
    axes1[1, 1].set_title('Weekly Trends: Installs vs Efficiency')
    axes1[1, 1].grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('plot1_acquisition_efficiency.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("  ✓ Created: plot1_acquisition_efficiency.png")

# ============================================================================
# PLOT 2: Non-linear Relationships
# ============================================================================
print("Creating Plot 2: Non-linear Relationships...")

query2 = """
SELECT 
    t.date_day,
    t.quality_score,
    t.crash_rate_per_1k,
    AVG(c.store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__time_series_trends t
LEFT JOIN google_play__country_report c ON t.date_day = c.date_day
WHERE t.quality_score > 0 AND c.store_listing_conversion_rate > 0
GROUP BY t.date_day
ORDER BY t.date_day
"""

df_quality = pd.read_sql_query(query2, conn)
if len(df_quality) > 0:
    df_quality['date_day'] = pd.to_datetime(df_quality['date_day'])
    
    # Get rating data separately
    query_rating = """
    SELECT date_day, rolling_total_average_rating, store_listing_conversion_rate
    FROM google_play__country_report 
    WHERE rolling_total_average_rating > 0 AND store_listing_conversion_rate > 0
    """
    df_rating = pd.read_sql_query(query_rating, conn)
    
    fig2, axes2 = plt.subplots(2, 2, figsize=(14, 10))
    fig2.suptitle('Non-linear Relationships: Key Metric Correlations', fontsize=16, fontweight='bold')
    
    # Subplot 1: Quality vs Conversion (time series correlation)
    if len(df_quality) > 7:
        df_quality['conversion_ma'] = df_quality['avg_conversion_rate'].rolling(window=7).mean()
        df_quality['quality_ma'] = df_quality['quality_score'].rolling(window=7).mean()
        plot_data = df_quality.dropna(subset=['conversion_ma', 'quality_ma'])
        
        axes2[0, 0].plot(plot_data['date_day'], plot_data['conversion_ma'], 'b-', label='Conv Rate (7d MA)', alpha=0.8)
        axes2[0, 0].set_xlabel('Date')
        axes2[0, 0].set_ylabel('Conversion Rate', color='b')
        axes2[0, 0].tick_params(axis='y', labelcolor='b')
        
        ax2_1b = axes2[0, 0].twinx()
        ax2_1b.plot(plot_data['date_day'], plot_data['quality_ma'], 'g-', label='Quality Score (7d MA)', alpha=0.8)
        ax2_1b.set_ylabel('Quality Score', color='g')
        ax2_1b.tick_params(axis='y', labelcolor='g')
        
        axes2[0, 0].set_title('Conversion Rate vs Quality Score Correlation')
    else:
        axes2[0, 0].text(0.5, 0.5, 'Insufficient data\nfor time series correlation',
                        ha='center', va='center', transform=axes2[0, 0].transAxes)
        axes2[0, 0].set_title('Conversion Rate vs Quality Score')
    
    axes2[0, 0].grid(True, alpha=0.3)
    axes2[0, 0].tick_params(axis='x', rotation=45)
    
    # Subplot 2: Rating vs Conversion (scatter)
    if len(df_rating) > 10:
        sample = df_rating.sample(min(200, len(df_rating)), random_state=42)
        scatter = axes2[0, 1].scatter(sample['store_listing_conversion_rate'],
                                     sample['rolling_total_average_rating'],
                                     alpha=0.6, s=50, edgecolors='black')
        axes2[0, 1].set_xlabel('Conversion Rate')
        axes2[0, 1].set_ylabel('Average Rating')
        axes2[0, 1].set_title('Conversion Rate vs Average Rating Relationship')
        
        # Add quadratic trend line
        if len(sample) > 3:
            x = sample['store_listing_conversion_rate']
            y = sample['rolling_total_average_rating']
            z = np.polyfit(x, y, 2)
            p = np.poly1d(z)
            x_sorted = np.sort(x)
            axes2[0, 1].plot(x_sorted, p(x_sorted), 'r--', alpha=0.8, label='Quadratic Trend')
            axes2[0, 1].legend()
    else:
        axes2[0, 1].text(0.5, 0.5, 'Insufficient data\nfor scatter analysis',
                        ha='center', va='center', transform=axes2[0, 1].transAxes)
        axes2[0, 1].set_title('Conversion Rate vs Rating')
    
    axes2[0, 1].grid(True, alpha=0.3)
    
    # Subplot 3: Crash Rate vs Conversion
    if len(df_quality) > 7:
        df_quality['crash_ma'] = df_quality['crash_rate_per_1k'].rolling(window=7).mean()
        df_quality['conversion_ma'] = df_quality['avg_conversion_rate'].rolling(window=7).mean()
        plot_data = df_quality.dropna(subset=['conversion_ma', 'crash_ma'])
        
        axes2[1, 0].plot(plot_data['date_day'], plot_data['conversion_ma'], 'b-', label='Conv Rate (7d MA)', alpha=0.8)
        axes2[1, 0].set_xlabel('Date')
        axes2[1, 0].set_ylabel('Conversion Rate', color='b')
        axes2[1, 0].tick_params(axis='y', labelcolor='b')
        
        ax2_3b = axes2[1, 0].twinx()
        ax2_3b.plot(plot_data['date_day'], plot_data['crash_ma'], 'r-', label='Crash Rate (7d MA)', alpha=0.8)
        ax2_3b.set_ylabel('Crash Rate per 1k', color='r')
        ax2_3b.tick_params(axis='y', labelcolor='r')
        
        axes2[1, 0].set_title('Conversion Rate vs Crash Rate Correlation')
    else:
        axes2[1, 0].text(0.5, 0.5, 'Insufficient data\nfor crash rate analysis',
                        ha='center', va='center', transform=axes2[1, 0].transAxes)
        axes2[1, 0].set_title('Conversion Rate vs Crash Rate')
    
    axes2[1, 0].grid(True, alpha=0.3)
    axes2[1, 0].tick_params(axis='x', rotation=45)
    
    # Subplot 4: Histogram of conversion rates
    if len(df_rating) > 0:
        axes2[1, 1].hist(df_rating['store_listing_conversion_rate'], bins=20, alpha=0.7, color='purple', edgecolor='black')
        axes2[1, 1].axvline(x=df_rating['store_listing_conversion_rate'].mean(), 
                           color='r', linestyle='--', linewidth=2,
                           label=f'Mean: {df_rating["store_listing_conversion_rate"].mean():.3f}')
        axes2[1, 1].set_xlabel('Conversion Rate')
        axes2[1, 1].set_ylabel('Frequency')
        axes2[1, 1].set_title('Distribution of Conversion Rates')
        axes2[1, 1].legend()
        axes2[1, 1].grid(True, alpha=0.3, axis='y')
    else:
        axes2[1, 1].text(0.5, 0.5, 'Insufficient data\nfor distribution analysis',
                        ha='center', va='center', transform=axes2[1, 1].transAxes)
        axes2[1, 1].set_title('Conversion Rate Distribution')
    
    plt.tight_layout()
    plt.savefig('plot2_nonlinear_relationships.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("  ✓ Created: plot2_nonlinear_relationships.png")

# ============================================================================
# PLOT 3: Multi-dimensional Decay Analysis
# ============================================================================
print("Creating Plot 3: Multi-dimensional Decay Analysis...")

query3 = """
SELECT 
    region,
    store_listing_conversion_rate,
    active_devices_last_30_days,
    rolling_total_average_rating
FROM google_play__country_report
WHERE date_day >= '2024-08-01'
"""

df_multi = pd.read_sql_query(query3, conn)
if len(df_multi) > 0:
    fig3, axes3 = plt.subplots(2, 2, figsize=(14, 10))
    fig3.suptitle('Multi-dimensional User Value Decay Analysis', fontsize=16, fontweight='bold')
    
    # Subplot 1: Top regions by conversion rate
    region_summary = df_multi.groupby('region').agg({
        'store_listing_conversion_rate': 'mean',
        'active_devices_last_30_days': 'sum',
        'rolling_total_average_rating': 'mean'
    }).reset_index()
    
    # Get top 5 regions by active devices
    top_regions = region_summary.nlargest(5, 'active_devices_last_30_days')
    
    x = np.arange(len(top_regions))
    width = 0.35
    
    bars1 = axes3[0, 0].bar(x - width/2, top_regions['active_devices_last_30_days'], width,
                           color='lightblue', edgecolor='black', alpha=0.8, label='Active Devices')
    axes3[0, 0].set_xlabel('Region')
    axes3[0, 0].set_ylabel('Active Devices (30 days)', color='lightblue')
    axes3[0, 0].tick_params(axis='y', labelcolor='lightblue')
    axes3[0, 0].set_xticks(x)
    axes3[0, 0].set_xticklabels([r[:15] for r in top_regions['region']], rotation=45, ha='right')
    
    ax3_1b = axes3[0, 0].twinx()
    bars2 = ax3_1b.bar(x + width/2, top_regions['store_listing_conversion_rate'], width,
                      color='orange', edgecolor='black', alpha=0.8, label='Conv Rate')
    ax3_1b.set_ylabel('Conversion Rate', color='orange')
    ax3_1b.tick_params(axis='y', labelcolor='orange')
    
    axes3[0, 0].set_title('Top 5 Regions: Active Devices vs Conversion Rate')
    axes3[0, 0].grid(True, alpha=0.3, axis='y')
    
    # Subplot 2: 3D projection (2D scatter with size/color)
    scatter = axes3[0, 1].scatter(df_multi['store_listing_conversion_rate'],
                                  df_multi['rolling_total_average_rating'],
                                  s=np.log1p(df_multi['active_devices_last_30_days'])*10,
                                  c=df_multi['active_devices_last_30_days'],
                                  cmap='viridis',
                                  alpha=0.6,
                                  edgecolors='black')
    
    axes3[0, 1].set_xlabel('Conversion Rate')
    axes3[0, 1].set_ylabel('Average Rating')
    axes3[0, 1].set_title('Multi-dimensional User Value Space\n(Size & Color = Active Devices)')
    plt.colorbar(scatter, ax=axes3[0, 1], label='Active Devices (30 days)')
    axes3[0, 1].grid(True, alpha=0.3)
    
    # Subplot 3: Composite metric distribution by region
    df_multi['value_score'] = (df_multi['store_listing_conversion_rate'] * 
                               df_multi['rolling_total_average_rating'] * 
                               np.log1p(df_multi['active_devices_last_30_days']))
    
    # Get composite scores for top 4 regions
    top_4_regions = region_summary.nlargest(4, 'active_devices_last_30_days')['region'].tolist()
    box_data = []
    box_labels = []
    
    for region in top_4_regions:
        region_scores = df_multi[df_multi['region'] == region]['value_score']
        if len(region_scores) > 0:
            box_data.append(region_scores)
            box_labels.append(region[:12])  # Truncate long region names
    
    if box_data:
        bp = axes3[1, 0].boxplot(box_data, labels=box_labels, patch_artist=True)
        colors = ['lightblue', 'lightgreen', 'lightcoral', 'lightsalmon']
        for patch, color in zip(bp['boxes'], colors):
            patch.set_facecolor(color)
        axes3[1, 0].set_xlabel('Region')
        axes3[1, 0].set_ylabel('Composite User Value Score')
        axes3[1, 0].set_title('User Value Score Distribution by Region')
        axes3[1, 0].grid(True, alpha=0.3, axis='y')
        axes3[1, 0].tick_params(axis='x', rotation=45)
    else:
        axes3[1, 0].text(0.5, 0.5, 'Insufficient data\nfor composite metric',
                        ha='center', va='center', transform=axes3[1, 0].transAxes)
        axes3[1, 0].set_title('Composite User Value Analysis')
    
    # Subplot 4: Correlation matrix heatmap (conceptual)
    corr_data = df_multi[['store_listing_conversion_rate', 
                         'active_devices_last_30_days',
                         'rolling_total_average_rating']].dropna()
    
    if len(corr_data) > 2:
        corr_matrix = corr_data.corr()
        im = axes3[1, 1].imshow(corr_matrix, cmap='coolwarm', vmin=-1, vmax=1)
        axes3[1, 1].set_xticks(range(len(corr_matrix.columns)))
        axes3[1, 1].set_yticks(range(len(corr_matrix.columns)))
        axes3[1, 1].set_xticklabels(['Conv Rate', 'Devices', 'Rating'], rotation=45)
        axes3[1, 1].set_yticklabels(['Conv Rate', 'Devices', 'Rating'])
        
        # Add correlation values
        for i in range(len(corr_matrix.columns)):
            for j in range(len(corr_matrix.columns)):
                axes3[1, 1].text(j, i, f'{corr_matrix.iloc[i, j]:.2f}',
                                ha='center', va='center', color='white' if abs(corr_matrix.iloc[i, j]) > 0.5 else 'black')
        
        axes3[1, 1].set_title('Metric Correlation Matrix')
        plt.colorbar(im, ax=axes3[1, 1])
    else:
        axes3[1, 1].text(0.5, 0.5, 'Insufficient data\nfor correlation matrix',
                        ha='center', va='center', transform=axes3[1, 1].transAxes)
        axes3[1, 1].set_title('Metric Correlations')
    
    plt.tight_layout()
    plt.savefig('plot3_multidimensional_decay.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("  ✓ Created: plot3_multidimensional_decay.png")

# ============================================================================
# PLOT 4: Update Frequency Interaction Effects
# ============================================================================
print("Creating Plot 4: Update Frequency Interaction Effects...")

query4 = """
SELECT 
    update_events,
    active_devices_last_30_days,
    rolling_total_average_rating
FROM google_play__device_report
WHERE update_events > 0 AND active_devices_last_30_days > 0
"""

df_updates = pd.read_sql_query(query4, conn)
if len(df_updates) > 0:
    fig4, axes4 = plt.subplots(1, 2, figsize=(14, 6))
    fig4.suptitle('App Update Frequency Interaction Effects', fontsize=16, fontweight='bold')
    
    # Subplot 1: Update frequency vs metrics scatter
    scatter = axes4[0].scatter(df_updates['update_events'],
                               df_updates['active_devices_last_30_days'],
                               c=df_updates['rolling_total_average_rating'],
                               cmap='RdYlBu',
                               s=100,
                               alpha=0.7,
                               edgecolors='black')
    
    axes4[0].set_xlabel('Update Events Count')
    axes4[0].set_ylabel('Active Devices (30 days)')
    axes4[0].set_title('Update Frequency vs Active Devices\n(Colored by Average Rating)')
    cbar = plt.colorbar(scatter, ax=axes4[0])
    cbar.set_label('Average Rating')
    axes4[0].grid(True, alpha=0.3)
    
    # Add trend line for active devices
    if len(df_updates) > 2:
        z = np.polyfit(df_updates['update_events'], df_updates['active_devices_last_30_days'], 1)
        p = np.poly1d(z)
        x_range = np.linspace(df_updates['update_events'].min(), df_updates['update_events'].max(), 100)
        axes4[0].plot(x_range, p(x_range), 'r--', alpha=0.8, label='Linear Trend')
        axes4[0].legend()
    
    # Subplot 2: Metrics by update frequency tier
    df_updates['update_tier'] = pd.qcut(df_updates['update_events'], 4,
                                        labels=['Very Low', 'Low', 'High', 'Very High'])
    tier_stats = df_updates.groupby('update_tier').agg({
        'active_devices_last_30_days': 'mean',
        'rolling_total_average_rating': 'mean'
    }).reset_index()
    
    x = np.arange(len(tier_stats))
    width = 0.35
    
    bars1 = axes4[1].bar(x - width/2, tier_stats['active_devices_last_30_days'], width,
                        color='skyblue', edgecolor='black', alpha=0.8, label='Active Devices')
    axes4[1].set_xlabel('Update Frequency Tier')
    axes4[1].set_ylabel('Avg Active Devices', color='skyblue')
    axes4[1].tick_params(axis='y', labelcolor='skyblue')
    axes4[1].set_xticks(x)
    axes4[1].set_xticklabels(tier_stats['update_tier'])
    
    ax4_2b = axes4[1].twinx()
    bars2 = ax4_2b.bar(x + width/2, tier_stats['rolling_total_average_rating'], width,
                      color='salmon', edgecolor='black', alpha=0.8, label='Avg Rating')
    ax4_2b.set_ylabel('Average Rating', color='salmon')
    ax4_2b.tick_params(axis='y', labelcolor='salmon')
    
    axes4[1].set_title('User Metrics by Update Frequency Tier')
    axes4[1].grid(True, alpha=0.3, axis='y')
    
    # Add value labels
    for i, v in enumerate(tier_stats['active_devices_last_30_days']):
        axes4[1].text(i - width/2, v, f'{v:,.0f}', ha='center', va='bottom', fontsize=9)
    
    for i, v in enumerate(tier_stats['rolling_total_average_rating']):
        ax4_2b.text(i + width/2, v, f'{v:.2f}', ha='center', va='bottom', fontsize=9)
    
    plt.tight_layout()
    plt.savefig('plot4_update_interaction.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("  ✓ Created: plot4_update_interaction.png")

# ============================================================================
# PLOT 5: Summary Dashboard
# ============================================================================
print("Creating Plot 5: Summary Dashboard...")

fig5 = plt.figure(figsize=(15, 10))
fig5.suptitle('Performance Analysis Dashboard', fontsize=20, fontweight='bold')

# Summary 1: Key metrics overview
ax1 = plt.subplot(2, 3, 1)
if len(df_ts) > 0:
    key_metrics = {
        'Avg Daily\nInstalls': df_ts['daily_installs'].mean(),
        'Avg Daily\nRevenue': df_ts['daily_revenue'].mean(),
        'Avg Revenue\nper Device': df_ts['revenue_per_active_device'].mean() if 'revenue_per_active_device' in df_ts.columns else 0,
        'Avg Install/\nUninstall Ratio': df_ts['daily_installs'].mean() / (df_ts['daily_uninstalls'].mean() + 1)
    }
    
    bars = ax1.bar(range(len(key_metrics)), list(key_metrics.values()), 
                  color=['skyblue', 'lightgreen', 'gold', 'lightcoral'],
                  edgecolor='black')
    
    ax1.set_title('Key Performance Metrics (Overall Averages)')
    ax1.set_ylabel('Value')
    ax1.set_xticks(range(len(key_metrics)))
    ax1.set_xticklabels(list(key_metrics.keys()), rotation=45, ha='right')
    
    for bar, value in zip(bars, key_metrics.values()):
        height = bar.get_height()
        ax1.text(bar.get_x() + bar.get_width()/2., height,
                f'{value:.1f}' if value < 100 else f'{value:.0f}',
                ha='center', va='bottom', fontsize=9)
else:
    ax1.text(0.5, 0.5, 'No time series data\navailable for summary',
            ha='center', va='center', transform=ax1.transAxes)

# Summary 2: Top regions performance
ax2 = plt.subplot(2, 3, 2)
if 'region_summary' in locals() and len(region_summary) > 0:
    top_3_regions = region_summary.nlargest(3, 'active_devices_last_30_days')
    
    labels = [r[:12] for r in top_3_regions['region']]
    sizes = top_3_regions['active_devices_last_30_days']
    colors = ['lightblue', 'lightgreen', 'salmon']
    
    wedges, texts, autotexts = ax2.pie(sizes, labels=labels, colors=colors, autopct='%1.1f%%',
                                      startangle=90, textprops={'fontsize': 10})
    ax2.set_title('Top 3 Regions by Active Devices')
    ax2.axis('equal')
else:
    ax2.text(0.5, 0.5, 'No region data\navailable for summary',
            ha='center', va='center', transform=ax2.transAxes)

# Summary 3: Update frequency impact summary
ax3 = plt.subplot(2, 3, 3)
if 'tier_stats' in locals() and len(tier_stats) > 0:
    # Calculate percentage differences
    max_devices = tier_stats['active_devices_last_30_days'].max()
    min_devices = tier_stats['active_devices_last_30_days'].min()
    max_rating = tier_stats['rolling_total_average_rating'].max()
    min_rating = tier_stats['rolling_total_average_rating'].min()
    
    device_diff = ((max_devices - min_devices) / min_devices * 100) if min_devices > 0 else 0
    rating_diff = ((max_rating - min_rating) / min_rating * 100) if min_rating > 0 else 0
    
    summary_text = f"""Update Frequency Impact:
    
Active Devices Variation:
{device_diff:+.1f}% from lowest to highest tier

Average Rating Variation:
{rating_diff:+.1f}% from lowest to highest tier

Recommendation:
{"Increase updates" if device_diff > 0 else "Optimize update frequency"}"""
    
    ax3.text(0.5, 0.5, summary_text, ha='center', va='center', transform=ax3.transAxes,
            fontsize=10, linespacing=1.5)
    ax3.set_title('Update Frequency Impact Analysis')
else:
    ax3.text(0.5, 0.5, 'No update data\navailable for analysis',
            ha='center', va='center', transform=ax3.transAxes)

# Summary 4: Quality metrics correlation
ax4 = plt.subplot(2, 3, 4)
if 'corr_matrix' in locals():
    # Simple correlation summary
    corr_summary = f"""Key Correlations:

Conv Rate ↔ Rating: {corr_matrix.iloc[0, 2]:.3f}
Conv Rate ↔ Devices: {corr_matrix.iloc[0, 1]:.3f}
Devices ↔ Rating: {corr_matrix.iloc[1, 2]:.3f}

Strongest Relationship:
{corr_matrix.columns[corr_matrix.abs().max().argmax()]} ↔ 
{corr_matrix.columns[corr_matrix.abs().max(axis=1).argmax()]}: 
{corr_matrix.abs().max().max():.3f}"""
    
    ax4.text(0.5, 0.5, corr_summary, ha='center', va='center', transform=ax4.transAxes,
            fontsize=10, linespacing=1.5)
    ax4.set_title('Metric Correlation Summary')
else:
    ax4.text(0.5, 0.5, 'Insufficient data\nfor correlation summary',
            ha='center', va='center', transform=ax4.transAxes)

# Summary 5: Recommendation summary
ax5 = plt.subplot(2, 3, 5)
recommendations = """Key Recommendations:

1. Focus on regions with highest
   conversion-to-device ratios

2. Maintain quality score > {:.1f}
   (current correlation: {:.3f})

3. Optimize update frequency for
   maximum user engagement

4. Monitor crash rates closely
   when improving conversion""".format(
       df_quality['quality_score'].mean() if 'df_quality' in locals() and len(df_quality) > 0 else 3.5,
       corr_matrix.iloc[0, 2] if 'corr_matrix' in locals() else 0.0
   )

ax5.text(0.5, 0.5, recommendations, ha='center', va='center', transform=ax5.transAxes,
        fontsize=10, linespacing=1.5)
ax5.set_title('Strategic Recommendations')

# Summary 6: Action priority matrix (conceptual)
ax6 = plt.subplot(2, 3, 6)
priority_data = {
    'High Impact,\nLow Effort': ['Optimize store listing', 'Target top regions'],
    'High Impact,\nHigh Effort': ['Improve app quality', 'Expand to new markets'],
    'Low Impact,\nLow Effort': ['Minor UX tweaks', 'Update documentation'],
    'Low Impact,\nHigh Effort': ['Complete redesign', 'New platform support']
}

# Simple priority visualization
x_pos = [0.2, 0.8, 0.2, 0.8]
y_pos = [0.8, 0.8, 0.2, 0.2]
colors = ['lightgreen', 'gold', 'lightblue', 'salmon']
labels = list(priority_data.keys())

for i, (label, items) in enumerate(priority_data.items()):
    ax6.scatter(x_pos[i], y_pos[i], s=500, c=colors[i], alpha=0.7, edgecolors='black')
    ax6.text(x_pos[i], y_pos[i] + 0.05, label, ha='center', va='bottom', fontsize=9, fontweight='bold')
    # Add item dots
    for j, item in enumerate(items):
