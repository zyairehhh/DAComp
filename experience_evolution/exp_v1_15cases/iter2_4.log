Action: CreateFile(filepath='diversity_per_source.py':
```
import pandas as pd
import sqlite3
conn = sqlite3.connect('dacomp-067.sqlite')
query = """
SELECT tps.source_name,
       COUNT(DISTINCT cs.candidate_id) as total_hires,
       SUM(CASE WHEN ae.candidate_gender = 'Female' THEN 1 ELSE 0 END) as female_hires,
       SUM(CASE WHEN ae.candidate_race != 'White' AND ae.candidate_race IS NOT NULL THEN 1 ELSE 0 END) as non_white_hires
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
GROUP BY tps.source_name
"""
df = pd.read_sql_query(query, conn)
df['female_pct'] = df['female_hires'] / df['total_hires'] * 100
df['non_white_pct'] = df['non_white_hires'] / df['total_hires'] * 100
print(df)
''')
