print("\\nPredictive power (point-biserial correlation) with high-value target:")
for feat in features:
    corr = pointbiserial_corr(df[feat], df['high_value_target'])
    print(f"{feat:25s}: corr={corr:.4f}")

# Categorical features encoding
print("\\nHigh-value rate by categorical dimensions:")
for cat in ['last_browser_name', 'last_operating_system', 'last_server_name']:
    rates = df.groupby(cat)['high_value_target'].mean().sort_values(ascending=False)
    print(f"\\n{cat}:")
    print(rates.head())

# Build a simple multi-dimensional model using weighted score
# Compute normalized features
norm_features = ['sum_minutes', 'sum_events', 'latest_nps_rating', 
                 'count_active_days', 'distinct_features_used', 'total_pages_viewed']
for col in norm_features:
    df[f'{col}_norm'] = (df[col] - df[col].mean()) / df[col].std()

# Weighted sum (tune weights to maximize accuracy)
weights = {'sum_minutes': 0.3, 'sum_events': 0.2, 'latest_nps_rating': 0.15,
           'count_active_days': 0.15, 'distinct_features_used': 0.1, 'total_pages_viewed': 0.1}
df['multi_dim_score'] = sum(df[f'{col}_norm'] * w for col, w in weights.items())

# Find threshold that maximizes accuracy
from collections import defaultdict
thresholds = np.linspace(df['multi_dim_score'].min(), df['multi_dim_score'].max(), 100)
best_acc = 0
best_thresh = 0
for thresh in thresholds:
    pred = (df['multi_dim_score'] >= thresh).astype(int)
    acc = (pred == df['high_value_target']).mean()
    if acc > best_acc:
        best_acc = acc
        best_thresh = thresh

print(f"\\nMulti-dimensional model accuracy (weighted sum): {best_acc:.2%}")
print(f"Optimal threshold: {best_thresh:.3f}")

# Compare with simple threshold on sum_minutes (baseline)
baseline_acc = max(df['high_value_target'].mean(), 1 - df['high_value_target'].mean())
print(f"Baseline (always predict majority): {baseline_acc:.2%}")
print(f"Improvement over baseline: {best_acc - baseline_acc:.2%}")

# Feature importance via simple decision tree split
def gini_impurity(binary_vec):
    p = binary_vec.mean()
    return 2 * p * (1 - p)

def reduction_in_gini(feature, target, split_val):
    left = target[feature <= split_val]
    right = target[feature > split_val]
    if len(left) == 0 or len(right) == 0:
        return 0
    total = len(target)
    gini_parent = gini_impurity(target)
    gini_left = gini_impurity(left)
    gini_right = gini_impurity(right)
    weighted_gini = (len(left)/total) * gini_left + (len(right)/total) * gini_right
    return gini_parent - weighted_gini

print("\\nBest single-split Gini reduction for each feature:")
for feat in ['sum_minutes', 'sum_events', 'latest_nps_rating', 'count_active_days', 'distinct_features_used']:
    vals = df[feat].unique()
    if len(vals) > 100:
        splits = np.percentile(vals, np.linspace(10, 90, 9))
    else:
        splits = vals
    best_reduction = 0
    best_split = None
    for split in splits:
        red = reduction_in_gini(df[feat], df['high_value_target'], split)
        if red > best_reduction:
            best_reduction = red
            best_split = split
    print(f"{feat:25s}: reduction={best_reduction:.4f} at split={best_split:.2f}")

# Save enriched dataset
df.to_csv('visitor_features_target.csv', index=False)
print("\\nSaved visitor_features_target.csv")

conn.close()
