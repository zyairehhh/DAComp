import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-034.sqlite')
# Load data (already computed earlier, but redo)
sales_query = """
SELECT `SKU Quantity` as quantity, `SKU Price` as original_price, `SKU Selling Price` as selling_price
FROM attachment_1
UNION ALL
SELECT `SKU Quantity`, `SKU Price`, `SKU Selling Price`
FROM attachment_2
"""
df_sales = pd.read_sql_query(sales_query, conn)
df_cat = pd.read_sql_query("SELECT sku_id, `Level 1 Category Name` as cat1 FROM attachment_4", conn)
df = pd.merge(df_sales, df_cat, on='sku_id', how='left')
df['discount_depth'] = (df['original_price'] - df['selling_price']) / df['original_price']
df['discounted'] = df['discount_depth'] > 0
df_disc = df[df['discounted']].copy()

# Compute category-level metrics
summary = df_disc.groupby('cat1').agg(
    total_disc_qty=('quantity', 'sum'),
    avg_discount_depth=('discount_depth', 'mean'),
    corr=('discount_depth', lambda x: x.corr(df_disc.loc[x.index, 'quantity']))
).reset_index()

# Scatter with size and color
plt.figure(figsize=(12,8))
sc = plt.scatter(summary['avg_discount_depth']*100, summary['total_disc_qty']/1000,
                 c=summary['corr'], cmap='RdYlGn', s=200, alpha=0.7, edgecolors='black')
plt.colorbar(sc, label='Correlation (Discount Depth vs Quantity)')
plt.xlabel('Average Discount Depth (%)')
plt.ylabel('Discounted Sales Quantity (Thousands)')
plt.title('Category-Level Discount Depth vs Sales Volume (Colored by Correlation)')
plt.grid(True, alpha=0.3)
# Annotate notable categories
for idx, row in summary.iterrows():
    if row['total_disc_qty'] > 50000 or abs(row['corr']) > 0.3:
        plt.annotate(row['cat1'], (row['avg_discount_depth']*100, row['total_disc_qty']/1000),
                     fontsize=8, ha='center')
plt.savefig('discount_depth_vs_volume_scatter.png', dpi=300)
plt.close()

# Plot of discount depth distribution for top positive vs negative correlation categories
pos_cats = summary.nlargest(3, 'corr')['cat1'].tolist()
neg_cats = summary.nsmallest(3, 'corr')['cat1'].tolist()
fig, axes = plt.subplots(1, 2, figsize=(14,6), sharey=True)
for i, (cats, title) in enumerate([(pos_cats, 'Top 3 Positive Correlation Categories'),
                                    (neg_cats, 'Top 3 Negative Correlation Categories')]):
    data = [df_disc[df_disc['cat1']==cat]['discount_depth'].dropna() for cat in cats]
    axes[i].boxplot(data, labels=cats)
    axes[i].set_title(title)
    axes[i].set_ylabel('Discount Depth')
    axes[i].grid(True, alpha=0.3)
plt.suptitle('Discount Depth Distribution for Categories with Extreme Correlations')
plt.savefig('correlation_extremes_boxplot.png', dpi=300)
plt.close()

conn.close()
print("Extra plots generated.")
