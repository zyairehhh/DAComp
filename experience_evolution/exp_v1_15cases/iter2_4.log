```
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-022.sqlite')

# Vehicle type summary
query = """
SELECT 
    "Vehicle Type",
    COUNT(*) as total_rides,
    SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) as completed,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" ELSE NULL END) as avg_fare,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" / "Ride Distance" ELSE NULL END) as avg_per_km_fare,
    (SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) * 1.0 / COUNT(*)) as completion_rate
FROM 
    sheet1 
GROUP BY 
    "Vehicle Type"
ORDER BY 
    avg_per_km_fare DESC
"""
df_vehicle = pd.read_sql_query(query, conn)
print("Vehicle Type Performance:")
print(df_vehicle.to_string(index=False))

# Top pickup locations by per-km fare
query2 = """
SELECT 
    "Pickup Location",
    COUNT(*) as rides,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Pickup Location"
HAVING 
    rides >= 100
ORDER BY 
    avg_per_km_fare DESC
LIMIT 10
"""
df_pickup = pd.read_sql_query(query2, conn)
print("\nTop 10 Pickup Locations by Per-Km Fare (min 100 rides):")
print(df_pickup.to_string(index=False))

# Top drop locations
query3 = """
SELECT 
    "Drop Location",
    COUNT(*) as rides,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Drop Location"
HAVING 
    rides >= 100
ORDER BY 
    avg_per_km_fare DESC
LIMIT 10
"""
df_drop = pd.read_sql_query(query3, conn)
print("\nTop 10 Drop Locations by Per-Km Fare (min 100 rides):")
print(df_drop.to_string(index=False))

# Hourly patterns for each vehicle type (top hour)
query4 = """
SELECT 
    "Vehicle Type",
    CAST(substr("Time", 1, 2) AS INTEGER) as hour,
    AVG("Booking Value" / "Ride Distance") as avg_per_km_fare,
    COUNT(*) as rides
FROM 
    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Vehicle Type", hour
ORDER BY 
    "Vehicle Type", avg_per_km_fare DESC
"""
df_hour = pd.read_sql_query(query4, conn)
# For each vehicle type, get top hour
top_hours = df_hour.groupby('Vehicle Type').first().reset_index()
print("\nBest Hour for Each Vehicle Type (Highest Per-Km Fare):")
print(top_hours[['Vehicle Type', 'hour', 'avg_per_km_fare', 'rides']].to_string(index=False))

conn.close()
```
