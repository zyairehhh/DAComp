plt.figure(figsize=(10,6))
plt.scatter(df['cost_per_hire'], df['composite_score'], s=100, alpha=0.7)
for i, row in df.iterrows():
    plt.annotate(row['source_name'], (row['cost_per_hire'], row['composite_score']),
                 xytext=(5,5), textcoords='offset points', fontsize=9)
plt.title('Trade-off: Cost per Hire vs Composite Score', fontsize=14)
plt.xlabel('Cost per Hire (k$)', fontsize=12)
plt.ylabel('Composite Score', fontsize=12)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('cost_vs_composite.png', dpi=300)
plt.close()

# Compare current vs suggested allocation (if we have new_hires from optimal_allocation.py)
# We can compute new_hires from cost-effectiveness weight
total_hires = df['total_hires'].sum()
df['allocation_weight'] = df['cost_effectiveness'] / df['cost_effectiveness'].sum()
df['suggested_hires'] = (df['allocation_weight'] * total_hires).round().astype(int)

# Create grouped bar chart
fig, ax = plt.subplots(figsize=(12,7))
x = range(len(df))
width = 0.35
bars1 = ax.bar(x, df['total_hires'], width, label='Current Hires', color='blue', alpha=0.7)
bars2 = ax.bar([i + width for i in x], df['suggested_hires'], width, label='Suggested Hires (by cost-effectiveness)', color='red', alpha=0.7)
ax.set_xlabel('Source', fontsize=12)
ax.set_ylabel('Number of Hires', fontsize=12)
ax.set_title('Current vs Suggested Hires Allocation', fontsize=14)
ax.set_xticks([i + width/2 for i in x])
ax.set_xticklabels(df['source_name'], rotation=45, ha='right')
ax.legend()
plt.tight_layout()
plt.savefig('current_vs_suggested_hires.png', dpi=300)
plt.close()

print("Additional cost-effectiveness plots saved.")
