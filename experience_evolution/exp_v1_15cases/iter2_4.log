import pulp
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-067.sqlite')

# Data
source_types = ['agency', 'direct', 'job_board', 'referral', 'social_media', 'university']
# Female representation per source
female = {
    'agency': 0.4,
    'direct': 0.2,
    'job_board': 0.12,
    'referral': 0.142857,
    'social_media': 0.0,
    'university': 0.4
}
non_white = {
    'agency': 1.0,
    'direct': 0.9,
    'job_board': 0.8,
    'referral': 0.857143,
    'social_media': 0.833333,
    'university': 1.0
}
cost_per_hire = {
    'agency': 20000,
    'direct': 200,
    'job_board': 1000,
    'referral': 5000,
    'social_media': 500,
    'university': 8000
}
# Current hires per source (for reference)
current = {
    'agency': 647,
    'direct': 280,
    'job_board': 1088,
    'referral': 404,
    'social_media': 197,
    'university': 693
}

total_hires = sum(current.values())  # 3309

# Create LP problem
prob = pulp.LpProblem('Recruitment_Cost_Minimization', pulp.LpMinimize)

# Decision variables: hires per source
vars = pulp.LpVariable.dicts('Hires', source_types, lowBound=0, cat='Integer')

# Objective: total cost
prob += pulp.lpSum([cost_per_hire[s] * vars[s] for s in source_types])

# Constraint: total hires = total_hires (assuming hiring needs constant)
prob += pulp.lpSum([vars[s] for s in source_types]) == total_hires, "TotalHires"

# Female representation >= 40%
prob += pulp.lpSum([female[s] * vars[s] for s in source_types]) >= 0.4 * total_hires, "FemaleRep"

# Non-white representation >= 30%
prob += pulp.lpSum([non_white[s] * vars[s] for s in source_types]) >= 0.3 * total_hires, "NonWhiteRep"

# Optional: interviewer satisfaction > 4.0 (cannot satisfy with current ratings; ignore for now)
# Solve
prob.solve(pulp.PULP_CBC_CMD(msg=False))

print("Optimization status:", pulp.LpStatus[prob.status])
if pulp.LpStatus[prob.status] == 'Optimal':
    print("\nOptimal allocation:")
    total_cost = pulp.value(prob.objective)
    for s in source_types:
        val = pulp.value(vars[s])
        print(f"{s}: {int(val)} hires (current {current[s]})")
    print(f"\nTotal hires: {sum(pulp.value(vars[s]) for s in source_types)}")
    print(f"Total cost: ${total_cost:,.2f}")
    print(f"Current cost: ${sum(current[s] * cost_per_hire[s] for s in source_types):,.2f}")
    reduction = (sum(current[s] * cost_per_hire[s] for s in source_types) - total_cost) / sum(current[s] * cost_per_hire[s] for s in source_types) * 100
    print(f"Cost reduction: {reduction:.2f}%")
    # Compute actual female and non-white representation
    female_hires = sum(female[s] * pulp.value(vars[s]) for s in source_types)
    non_white_hires = sum(non_white[s] * pulp.value(vars[s]) for s in source_types)
    print(f"Female representation: {female_hires / total_hires:.3f}")
    print(f"Non‑white representation: {non_white_hires / total_hires:.3f}")
else:
    print("No optimal solution found.")
''')
