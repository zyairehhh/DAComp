import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo_market_analysis data for the app
query = """
SELECT country, region, avg_daily_revenue, avg_active_devices, avg_transaction_value, average_revenue_per_user,
       overall_market_score, app_quality_score, store_performance_score
FROM google_play__geo_market_analysis
WHERE package_name = 'com.dev.photoeditor'
"""
df = pd.read_sql_query(query, conn)

# Compute daily revenue per active device
df['daily_rev_per_device'] = df['avg_daily_revenue'] / df['avg_active_devices']

print("Daily revenue per active device:")
print(df[['country', 'region', 'daily_rev_per_device', 'avg_transaction_value', 'average_revenue_per_user']].sort_values('daily_rev_per_device'))

# Identify markets where daily_rev_per_device > 7 and < 3 (likely none, but check)
high = df[df['daily_rev_per_device'] > 7]
low = df[df['daily_rev_per_device'] < 3]
print("\nMarkets with daily_rev_per_device > $7:")
print(high[['country', 'region', 'daily_rev_per_device']])
print("\nMarkets with daily_rev_per_device < $3:")
print(low[['country', 'region', 'daily_rev_per_device']])

# Compare performance scores between high and low markets
print("\nPerformance comparison:")
print("High markets (daily_rev_per_device > $7) average scores:")
if not high.empty:
    print(high[['overall_market_score', 'app_quality_score', 'store_performance_score']].mean())
else:
    print("No high markets")
print("\nLow markets (daily_rev_per_device < $3) average scores:")
if not low.empty:
    print(low[['overall_market_score', 'app_quality_score', 'store_performance_score']].mean())
else:
    print("No low markets")

# Also look at trend of overall_performance_score over time per region? Not available.
# Let's compute total research budget and average performance score over time.
query2 = """
SELECT date_day, overall_performance_score, research_budget_usd
FROM google_play__comprehensive_performance_dashboard
WHERE package_name = 'com.dev.photoeditor'
ORDER BY date_day
"""
df2 = pd.read_sql_query(query2, conn)
print("\nOverall performance score trend:")
print(df2)

# Compute total research budget
total_budget = df2['research_budget_usd'].sum()
print(f"\nTotal research budget over 12 months: ${total_budget:,.2f}")

# Compute average performance score at start and end
start_score = df2.iloc[-1]['overall_performance_score']  # earliest? Actually first row is latest? Need to sort by date ascending.
df2_sorted = df2.sort_values('date_day')
start_score = df2_sorted.iloc[0]['overall_performance_score']
end_score = df2_sorted.iloc[-1]['overall_performance_score']
print(f"Start score (earliest): {start_score}")
print(f"End score (latest): {end_score}")
print(f"Change: {end_score - start_score}")

# Compute regional performance divergence using overall_market_score
print("\nRegional performance divergence (overall_market_score) between high and low revenue metric groups.")
# Use avg_transaction_value > 7 as high, < 3 as low? But none <3. Use median split.
median_atv = df['avg_transaction_value'].median()
print(f"Median avg_transaction_value: {median_atv}")
high_atv = df[df['avg_transaction_value'] > median_atv]
low_atv = df[df['avg_transaction_value'] <= median_atv]
print(f"High avg_transaction_value markets count: {len(high_atv)}")
print(f"Low avg_transaction_value markets count: {len(low_atv)}")
print("High group average overall_market_score:", high_atv['overall_market_score'].mean())
print("Low group average overall_market_score:", low_atv['overall_market_score'].mean())

# Similarly for average_revenue_per_user
median_arpu = df['average_revenue_per_user'].median()
print(f"\nMedian average_revenue_per_user: {median_arpu}")
high_arpu = df[df['average_revenue_per_user'] > median_arpu]
low_arpu = df[df['average_revenue_per_user'] <= median_arpu]
print(f"High ARPU markets count: {len(high_arpu)}")
print(f"Low ARPU markets count: {len(low_arpu)}")
print("High ARPU group average overall_market_score:", high_arpu['overall_market_score'].mean())
print("Low ARPU group average overall_market_score:", low_arpu['overall_market_score'].mean())

conn.close()
```
