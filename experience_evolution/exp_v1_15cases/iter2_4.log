import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Decay patterns of user acquisition cost-efficiency per region (store_listing_conversion_rate)
region_daily = pd.read_sql_query("""
    SELECT date_day, region, store_listing_conversion_rate 
    FROM google_play__country_report
""", conn)
region_daily['date_day'] = pd.to_datetime(region_daily['date_day'])
region_daily['month'] = region_daily['date_day'].dt.to_period('M')
region_monthly = region_daily.groupby(['region', 'month']).agg({
    'store_listing_conversion_rate': 'mean'
}).reset_index()
region_monthly['month'] = region_monthly['month'].dt.to_timestamp()
region_monthly = region_monthly.sort_values(['region', 'month'])

# Compute month-over-month change per region
region_monthly['conv_rate_change'] = region_monthly.groupby('region')['store_listing_conversion_rate'].pct_change()
print("=== Decay Patterns of Conversion Rate per Region ===")
for region in region_monthly['region'].unique():
    subset = region_monthly[region_monthly['region'] == region]
    if len(subset) > 1:
        # Linear slope per day
        daily = region_daily[region_daily['region'] == region]
        daily['days'] = (daily['date_day'] - daily['date_day'].min()).dt.days
        X = daily['days'].values.reshape(-1,1)
        y = daily['store_listing_conversion_rate'].values
        mask = ~np.isnan(y)
        if mask.sum() > 1:
            coeffs = np.polyfit(X[mask].flatten(), y[mask], 1)
            slope = coeffs[0] * 30  # per month
            print(f"{region}: monthly slope = {slope:.6f}, average conversion rate = {daily['store_listing_conversion_rate'].mean():.4f}")

# 2. Decay patterns per device type (use net installs as proxy)
device_daily = pd.read_sql_query("""
    SELECT date_day, device, device_installs, device_uninstalls, device_upgrades
    FROM google_play__device_report
""", conn)
device_daily['date_day'] = pd.to_datetime(device_daily['date_day'])
device_daily['month'] = device_daily['date_day'].dt.to_period('M')
device_daily['net_installs'] = device_daily['device_installs'] - device_daily['device_uninstalls']
device_monthly = device_daily.groupby(['device', 'month']).agg({
    'net_installs': 'sum',
    'device_installs': 'sum',
    'device_uninstalls': 'sum'
}).reset_index()
device_monthly['month'] = device_monthly['month'].dt.to_timestamp()
device_monthly = device_monthly.sort_values(['device', 'month'])
device_monthly['net_installs_change'] = device_monthly.groupby('device')['net_installs'].pct_change()
print("\n=== Decay Patterns of Net Installs per Device ===")
top_devices = device_monthly['device'].unique()[:5]  # limit output
for device in top_devices:
    subset = device_monthly[device_monthly['device'] == device]
    if len(subset) > 1:
        avg_net = subset['net_installs'].mean()
        avg_change = subset['net_installs_change'].mean()
        print(f"{device}: average net installs = {avg_net:.0f}, average monthly change = {avg_change:.4f}")

# 3. Non-linear relationship between store_listing_conversion_rate and quality_score / crash_rate_per_1k
# Use region-level daily data joined with trends
print("\n=== Non-linear Relationship Analysis ===")
region_trends = pd.read_sql_query("""
    SELECT c.date_day, c.region, c.store_listing_conversion_rate as conv_rate,
           t.quality_score, t.crash_rate_per_1k as crash_rate
    FROM google_play__country_report c
    JOIN google_play__time_series_trends t
    ON c.date_day = t.date_day AND c.package_name = t.package_name
""", conn)
region_trends = region_trends.dropna()
# Polynomial regression degree 2 on quality_score
Xq = region_trends['quality_score'].values
yq = region_trends['conv_rate'].values
coeffs_q = np.polyfit(Xq, yq, 2)
print(f"Polynomial fit (conv_rate vs quality_score): a={coeffs_q[0]:.6f}, b={coeffs_q[1]:.6f}, c={coeffs_q[2]:.6f}")
# R-squared
p_q = np.poly1d(coeffs_q)
y_pred_q = p_q(Xq)
r2_q = 1 - np.sum((yq - y_pred_q)**2) / np.sum((yq - np.mean(yq))**2)
print(f"R-squared: {r2_q:.6f}")

Xc = region_trends['crash_rate'].values
yc = region_trends['conv_rate'].values
coeffs_c = np.polyfit(Xc, yc, 2)
print(f"Polynomial fit (conv_rate vs crash_rate): a={coeffs_c[0]:.6f}, b={coeffs_c[1]:.6f}, c={coeffs_c[2]:.6f}")
p_c = np.poly1d(coeffs_c)
y_pred_c = p_c(Xc)
r2_c = 1 - np.sum((yc - y_pred_c)**2) / np.sum((yc - np.mean(yc))**2)
print(f"R-squared: {r2_c:.6f}")

# 4. Multi-dimensional user value decay model (predict revenue_per_active_device)
print("\n=== Multi-dimensional Regression Model for Revenue per Active Device ===")
# Use earlier regression results from modeling.py, but we can recompute simplified
df = pd.read_sql_query("""
    SELECT c.region, c.store_listing_conversion_rate, c.update_events,
           c.active_devices_last_30_days, c.average_rating,
           t.quality_score, t.crash_rate_per_1k, t.revenue_per_active_device,
           t.daily_installs, t.date_day
    FROM google_play__country_report c
    JOIN google_play__time_series_trends t
    ON c.date_day = t.date_day AND c.package_name = t.package_name
""", conn)
df['date_day'] = pd.to_datetime(df['date_day'])
df['days_since_start'] = (df['date_day'] - pd.Timestamp('2024-04-01')).dt.days
df = pd.get_dummies(df, columns=['region'], drop_first=True)
X = df[['store_listing_conversion_rate', 'update_events', 'active_devices_last_30_days',
        'average_rating', 'quality_score', 'crash_rate_per_1k', 'days_since_start',
        'region_Europe', 'region_North America', 'region_South America']].astype(float)
y = df['revenue_per_active_device'].astype(float)
mask = ~X.isna().any(axis=1) & ~y.isna()
X = X[mask]
y = y[mask]
X_mat = np.column_stack([np.ones(X.shape[0]), X])
coeffs, _, _, _ = np.linalg.lstsq(X_mat, y, rcond=None)
print(f"Model R² (approximate): {1 - np.sum((y - X_mat @ coeffs)**2) / np.sum((y - np.mean(y))**2):.4f}")
print("Top 5 influential features (absolute coefficient):")
features = ['intercept'] + list(X.columns)
abs_coef = np.abs(coeffs)
top_idx = np.argsort(abs_coef)[::-1][:6]
for idx in top_idx:
    print(f"  {features[idx]}: {coeffs[idx]:.8f}")

# 5. Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
print("\n=== Interaction Effect of Update Frequency ===")
device_updates = pd.read_sql_query("""
    SELECT d.date_day, d.device, d.update_events, d.active_devices_last_30_days,
           d.rolling_total_average_rating
    FROM google_play__device_report d
""", conn)
device_updates['date_day'] = pd.to_datetime(device_updates['date_day'])
device_updates['month'] = device_updates['date_day'].dt.month
# Aggregate per device per month
monthly = device_updates.groupby(['device', 'month']).agg({
    'update_events': 'sum',
    'active_devices_last_30_days': 'mean',
    'rolling_total_average_rating': 'mean'
}).reset_index()
corr_active = monthly['update_events'].corr(monthly['active_devices_last_30_days'])
corr_rating = monthly['update_events'].corr(monthly['rolling_total_average_rating'])
print(f"Correlation (update frequency vs active_devices): {corr_active:.4f}")
print(f"Correlation (update frequency vs rolling_rating): {corr_rating:.4f}")
# Also compute for region-level updates
region_updates = pd.read_sql_query("""
    SELECT date_day, region, update_events, active_devices_last_30_days,
           rolling_total_average_rating
    FROM google_play__country_report
""", conn)
region_updates['month'] = pd.to_datetime(region_updates['date_day']).dt.month
region_monthly = region_updates.groupby(['region', 'month']).agg({
    'update_events': 'sum',
    'active_devices_last_30_days': 'mean',
    'rolling_total_average_rating': 'mean'
}).reset_index()
corr_active_reg = region_monthly['update_events'].corr(region_monthly['active_devices_last_30_days'])
corr_rating_reg = region_monthly['update_events'].corr(region_monthly['rolling_total_average_rating'])
print(f"Region-level correlation (updates vs active_devices): {corr_active_reg:.4f}")
print(f"Region-level correlation (updates vs rolling_rating): {corr_rating_reg:.4f}")

conn.close()
```
