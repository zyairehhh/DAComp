```
import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import matplotlib.pyplot as plt
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# Load region data with trends
region_df = pd.read_sql_query("""
    SELECT c.date_day, c.region, c.store_listing_conversion_rate, 
           c.active_devices_last_30_days, c.average_rating, c.rolling_total_average_rating,
           c.store_listing_acquisitions, c.store_listing_visitors,
           c.update_events, c.package_name,
           t.quality_score, t.crash_rate_per_1k, t.revenue_per_active_device,
           t.daily_installs, t.daily_revenue, t.daily_uninstalls, t.active_devices
    FROM google_play__country_report c
    JOIN google_play__time_series_trends t
    ON c.date_day = t.date_day AND c.package_name = t.package_name
""", conn)
region_df['date_day'] = pd.to_datetime(region_df['date_day'])
region_df['month'] = region_df['date_day'].dt.to_period('M')
print("Region+Trends shape:", region_df.shape)

# Aggregate per region per month (mean across days and packages)
region_monthly = region_df.groupby(['region', 'month']).agg({
    'store_listing_conversion_rate': 'mean',
    'quality_score': 'mean',
    'crash_rate_per_1k': 'mean',
    'revenue_per_active_device': 'mean',
    'active_devices_last_30_days': 'mean',
    'average_rating': 'mean',
    'rolling_total_average_rating': 'mean',
    'update_events': 'sum',  # total updates per region per month
}).reset_index()
region_monthly['month'] = region_monthly['month'].dt.to_timestamp()
print("\nRegion monthly aggregated:")
print(region_monthly.head())

# Compute decay (month-over-month percentage change) per region
region_monthly = region_monthly.sort_values(['region', 'month'])
region_monthly['conversion_rate_pct_change'] = region_monthly.groupby('region')['store_listing_conversion_rate'].pct_change()
region_monthly['revenue_per_active_device_pct_change'] = region_monthly.groupby('region')['revenue_per_active_device'].pct_change()
print("\nDecay examples:")
print(region_monthly.head(10))

# Identify non-linear relationship between conversion rate and quality_score / crash_rate
# Use polynomial regression (degree 2) per region? We'll compute correlation and maybe fit polynomial later.

# Load device data with trends
device_df = pd.read_sql_query("""
    SELECT d.date_day, d.device, d.device_installs, d.device_uninstalls, d.device_upgrades,
           d.active_devices_last_30_days, d.average_rating, d.rolling_total_average_rating,
           d.update_events, d.package_name,
           t.quality_score, t.crash_rate_per_1k, t.revenue_per_active_device,
           t.daily_installs, t.daily_revenue, t.daily_uninstalls, t.active_devices
    FROM google_play__device_report d
    JOIN google_play__time_series_trends t
    ON d.date_day = t.date_day AND d.package_name = t.package_name
""", conn)
device_df['date_day'] = pd.to_datetime(device_df['date_day'])
device_df['month'] = device_df['date_day'].dt.to_period('M')
print("\nDevice+Trends shape:", device_df.shape)

# Aggregate per device per month
device_monthly = device_df.groupby(['device', 'month']).agg({
    'device_installs': 'sum',
    'device_uninstalls': 'sum',
    'device_upgrades': 'sum',
    'active_devices_last_30_days': 'mean',
    'average_rating': 'mean',
    'rolling_total_average_rating': 'mean',
    'update_events': 'sum',
    'revenue_per_active_device': 'mean',
    'quality_score': 'mean',
    'crash_rate_per_1k': 'mean',
}).reset_index()
device_monthly['month'] = device_monthly['month'].dt.to_timestamp()
device_monthly['net_installs'] = device_monthly['device_installs'] - device_monthly['device_uninstalls']
device_monthly['install_retention_rate'] = device_monthly['device_upgrades'] / (device_monthly['device_installs'] + 1e-6)
print("\nDevice monthly aggregated:")
print(device_monthly.head())

# Compute decay per device: month-over-month change in net_installs, revenue_per_active_device, etc.
device_monthly = device_monthly.sort_values(['device', 'month'])
device_monthly['net_installs_pct_change'] = device_monthly.groupby('device')['net_installs'].pct_change()
device_monthly['revenue_per_active_device_pct_change'] = device_monthly.groupby('device')['revenue_per_active_device'].pct_change()
print("\nDevice decay examples:")
print(device_monthly.head(10))

conn.close()

# Save aggregated data to CSV for further analysis if needed
region_monthly.to_csv('region_monthly.csv', index=False)
device_monthly.to_csv('device_monthly.csv', index=False)
print("\nSaved region_monthly.csv and device_monthly.csv")
