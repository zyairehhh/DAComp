import sqlite3
import pandas as pd
import re
import numpy as np
from collections import Counter

def parse_salary_range(salary_str):
    """
    Extract lower bound numeric value from salary range string.
    Returns float or None if not parseable.
    """
    if not isinstance(salary_str, str):
        return None
    # Remove commas
    s = salary_str.replace(',', '')
    # Common patterns: "5000-10000 yuan/month", "8000-12000 RMB/month", "面议", "None"
    # Also includes "Base salary: 3000-5000 RMB/month + commission"
    # We'll look for the first number before a dash (or first number if no dash)
    # Use regex to find all numbers
    numbers = re.findall(r'\d+\.?\d*', s)
    if numbers:
        # Convert to float
        # If there is a range like 5000-10000, numbers[0] is lower bound.
        # However, sometimes there may be multiple numbers like "8000-12000 RMB/month (Base salary: 4500-6000)"
        # In such cases, we might want the lower bound of the first range? Let's take the first number.
        # But careful: "8000-12000 RMB/month (Base salary: 4500-6000)" => numbers are [8000,12000,4500,6000]
        # The lower bound of overall salary is 8000. So we take numbers[0].
        return float(numbers[0])
    else:
        return None

def main():
    conn = sqlite3.connect('/workspace/dacomp-048.sqlite')
    df = pd.read_sql_query("SELECT * FROM sheet1 WHERE \"Education Requirement\" LIKE '%Vocational%'", conn)
    conn.close()
    
    print(f"Total vocational school job postings: {len(df)}")
    
    # Parse salary lower bound
    df['salary_lower'] = df['Salary Range'].apply(parse_salary_range)
    # Filter out rows with no salary parsed
    df_salary = df[df['salary_lower'].notna()]
    print(f"Rows with parsable salary: {len(df_salary)}")
    
    # Compute distribution of starting salary (lower bound)
    # We can bucket salaries into ranges
    bins = [0, 2000, 4000, 6000, 8000, 10000, 12000, 15000, 20000, float('inf')]
    labels = ['<2k', '2k-4k', '4k-6k', '6k-8k', '8k-10k', '10k-12k', '12k-15k', '15k-20k', '>20k']
    df_salary['salary_bin'] = pd.cut(df_salary['salary_lower'], bins=bins, labels=labels, right=False)
    salary_dist = df_salary['salary_bin'].value_counts().sort_index()
    print("\nStarting Salary Distribution (lower bound):")
    print(salary_dist)
    
    # Benefits distribution - parse Benefits column
    # Benefits are comma-separated lists; we can tokenize and count frequencies
    benefits_list = []
    for b in df['Benefits'].dropna():
        # Split by commas, but also Chinese commas might be '、' or '，'? Let's see data.
        # Based on sample, they use commas and Chinese commas? We'll handle both.
        # Replace Chinese punctuation with comma
        b = str(b).replace('，', ',').replace('、', ',')
        items = [item.strip() for item in b.split(',') if item.strip()]
        benefits_list.extend(items)
    benefits_counts = Counter(benefits_list)
    # Top 20 benefits
    top_benefits = benefits_counts.most_common(20)
    print("\nTop 20 Benefits (frequency):")
    for benefit, count in top_benefits:
        print(f"{benefit}: {count}")
    
    # Analyze qualities that increase starting salary
    # Potential qualities: Work Experience Requirement, Foreign Language Requirement, Age Requirement, Gender Requirement, Company Type, Industry, etc.
    # For categorical variables, we can compare average salary across categories.
    # Let's focus on Work Experience Requirement and Foreign Language Requirement.
    # Clean Work Experience Requirement: categorize into levels
    def categorize_experience(exp):
        if not isinstance(exp, str):
            return "Not specified"
        exp_lower = exp.lower()
        if 'no limit' in exp_lower or '不限' in exp_lower:
            return "No limit"
        if 'more than' in exp_lower or '一年以上' in exp_lower:
            return "More than one year"
        if 'two years' in exp_lower or 'two years or more' in exp_lower:
            return "Two years or more"
        if 'three years' in exp_lower or 'three years or more' in exp_lower:
            return "Three years or more"
        if 'five years' in exp_lower:
            return "Five years or more"
        if 'one year' in exp_lower:
            return "One year"
        if 'less than' in exp_lower:
            return "Less than one year"
        if 'experienced' in exp_lower:
            return "Experienced"
        return "Other"
    
    df_salary['work_exp_cat'] = df_salary['Work Experience Requirement'].apply(categorize_experience)
    # Compute average salary per category
    avg_salary_by_exp = df_salary.groupby('work_exp_cat')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
    print("\nAverage Starting Salary by Work Experience Requirement:")
    print(avg_salary_by_exp)
    
    # Foreign Language Requirement
    def categorize_language(lang):
        if not isinstance(lang, str):
            return "Not specified"
        lang_lower = lang.lower()
        if 'none' in lang_lower or '不限' in lang_lower or 'no requirement' in lang_lower:
            return "None"
        if 'english' in lang_lower:
            return "English"
        if 'japanese' in lang_lower:
            return "Japanese"
        if 'korean' in lang_lower:
            return "Korean"
        return "Other"
    
    df_salary['language_cat'] = df_salary['Foreign Language Requirement'].apply(categorize_language)
    avg_salary_by_lang = df_salary.groupby('language_cat')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
    print("\nAverage Starting Salary by Foreign Language Requirement:")
    print(avg_salary_by_lang)
    
    # Age Requirement - maybe parse min age
    def parse_min_age(age_str):
        if not isinstance(age_str, str):
            return None
        numbers = re.findall(r'\d+', age_str)
        if numbers:
            # Usually format "20 to 45 years old" => numbers[0] is min
            return int(numbers[0])
        else:
            return None
    
    df_salary['min_age'] = df_salary['Age Requirement'].apply(parse_min_age)
    # Compare salary vs min_age (maybe group by ranges)
    bins_age = [18, 25, 30, 35, 40, 45, 50, 55, 65]
    labels_age = ['18-24', '25-29', '30-34', '35-39', '40-44', '45-49', '50-54', '55+']
    df_salary['age_group'] = pd.cut(df_salary['min_age'], bins=bins_age, labels=labels_age, right=False)
    avg_salary_by_age = df_salary.groupby('age_group')['salary_lower'].agg(['mean', 'median', 'count']).dropna()
    print("\nAverage Starting Salary by Minimum Age Group:")
    print(avg_salary_by_age)
    
    # Gender Requirement
    def categorize_gender(gender):
        if not isinstance(gender, str):
            return "Not specified"
        gender_lower = gender.lower()
        if 'none' in gender_lower or '不限' in gender_lower:
            return "None"
        if 'male' in gender_lower or '男' in gender_lower:
            return "Male"
        if 'female' in gender_lower or '女' in gender_lower:
            return "Female"
        return "Other"
    
    df_salary['gender_cat'] = df_salary['Gender Requirement'].apply(categorize_gender)
    avg_salary_by_gender = df_salary.groupby('gender_cat')['salary_lower'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
    print("\nAverage Starting Salary by Gender Requirement:")
    print(avg_salary_by_gender)
    
    # Save results for reporting
    salary_dist.to_csv('/workspace/salary_distribution.csv')
    pd.DataFrame(top_benefits, columns=['benefit', 'count']).to_csv('/workspace/top_benefits.csv', index=False)
    avg_salary_by_exp.to_csv('/workspace/avg_salary_by_experience.csv')
    avg_salary_by_lang.to_csv('/workspace/avg_salary_by_language.csv')
    avg_salary_by_age.to_csv('/workspace/avg_salary_by_age.csv')
    avg_salary_by_gender.to_csv('/workspace/avg_salary_by_gender.csv')
    print("\nResults saved to CSV files.")

if __name__ == '__main__':
    main()
