# 2. Impact of Intent: Pricing vs Billing vs Marketing-qualified lifecycle
# Using data from report:
# Pricing intent: human-first demo booking 24.7% vs bot 22.8%, trial activation 9.0% vs 7.8%
# Billing intent: human-first trial activation 4.8% vs bot 0%
# Marketing-qualified lifecycle: bot trial activation 16.7% vs human 12.1%
intent_labels = ['Pricing (Demo)', 'Pricing (Trial)', 'Billing (Trial)', 'MQ Lifecycle (Trial)']
