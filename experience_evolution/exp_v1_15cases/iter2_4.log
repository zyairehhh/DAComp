daily['date_day'] = pd.to_datetime(daily['date_day'])

# Compute growth rate per visitor (second half vs first half)
def compute_growth(df):
    if len(df) < 2:
        return None
    df = df.sort_values('date_day')
    split = len(df) // 2
    first = df.iloc[:split]['sum_minutes'].sum()
    second = df.iloc[split:]['sum_minutes'].sum()
    growth = (second - first) / (first + 1e-9)
    return growth

growth = daily.groupby('visitor_id').apply(compute_growth).reset_index(name='growth_rate')
growth['future_positive'] = (growth['growth_rate'] > 0).astype(int)

df_growth = df.merge(growth, on='visitor_id', how='inner')
df_growth = df_growth.dropna(subset=['growth_rate'])

# Build model to predict future growth
features_growth = ['sum_minutes', 'sum_events', 'latest_nps_rating', 'count_active_days',
                   'average_daily_minutes', 'distinct_features_used']
for col in features_growth:
    df_growth[f'{col}_norm'] = (df_growth[col] - df_growth[col].mean()) / df_growth[col].std()

weights_growth = {'sum_minutes': 0.3, 'sum_events': 0.25, 'latest_nps_rating': 0.2,
                  'count_active_days': 0.15, 'average_daily_minutes': 0.1}
df_growth['growth_score'] = sum(df_growth[f'{col}_norm'] * w for col, w in weights_growth.items())

# Evaluate prediction of future growth
thresholds = np.linspace(df_growth['growth_score'].min(), df_growth['growth_score'].max(), 100)
accuracies = [(df_growth['growth_score'] >= t).astype(int) == df_growth['future_positive']).mean() for t in thresholds]
best_growth_acc = max(accuracies)
print(f"Predictive accuracy for future engagement growth: {best_growth_acc:.2%}")

print("\\n--- Summary ---")
print("1. Current model accuracy: ~68% (based on duration+frequency)")
print(f"2. Proposed multi-dimensional model accuracy: {accuracy_85:.2%}")
print(f"3. Future trend prediction accuracy: {best_growth_acc:.2%}")
print("4. Key additional dimensions: NPS rating, active days, average daily minutes, feature diversity")
print("5. Categorical factors: server, browser, OS show slight variations")

# Save final dataset
df.to_csv('final_visitor_analysis.csv', index=False)
print("\\nSaved final_visitor_analysis.csv")

conn.close()
''')
