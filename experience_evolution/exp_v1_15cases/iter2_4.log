             horizontalalignment='center', verticalalignment='center')
plt.tight_layout()
plt.savefig('recruitment_funnel.png', dpi=300, bbox_inches='tight')
plt.close()

# 6. Cost analysis by sourcing channel (assuming cost data is not available, use proxy metrics)
# Create a composite score chart for channel prioritization
channel_query = """
SELECT 
    sourced_from_type,
    COUNT(*) as total_applications,
    SUM(CASE WHEN status = 'hired' THEN 1 ELSE 0 END) as hires,
    AVG(CASE WHEN status = 'hired' THEN 1.0 ELSE 0 END) * 100 as hire_rate,
    AVG(count_interviews) as avg_interviews_per_candidate
FROM greenhouse__application_enhanced
WHERE sourced_from_type IS NOT NULL
GROUP BY sourced_from_type
"""
channel_df = pd.read_sql_query(channel_query, conn)

# Create composite score (higher is better)
# Weight: hire_rate 50%, 1/avg_interviews 30%, total_applications 20%
if not channel_df.empty:
    channel_df['hire_rate_norm'] = (channel_df['hire_rate'] - channel_df['hire_rate'].min()) / (channel_df['hire_rate'].max() - channel_df['hire_rate'].min())
    channel_df['inv_interviews_norm'] = ((1/channel_df['avg_interviews_per_candidate']) - (1/channel_df['avg_interviews_per_candidate']).min()) / ((1/channel_df['avg_interviews_per_candidate']).max() - (1/channel_df['avg_interviews_per_candidate']).min())
    channel_df['volume_norm'] = (channel_df['total_applications'] - channel_df['total_applications'].min()) / (channel_df['total_applications'].max() - channel_df['total_applications'].min())
    channel_df['composite_score'] = channel_df['hire_rate_norm'] * 0.5 + channel_df['inv_interviews_norm'] * 0.3 + channel_df['volume_norm'] * 0.2
    
    plt.figure(figsize=(10, 6))
