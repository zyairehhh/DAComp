'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Set style
plt.style.use('default')
# Use default font (no Chinese needed)

conn = sqlite3.connect('dacomp-035.sqlite')
abnormal = pd.read_sql_query('SELECT * FROM abnormal_logins_table', conn)
login = pd.read_sql_query('SELECT * FROM login_records_table', conn)
user = pd.read_sql_query('SELECT * FROM user_information_table', conn)
conn.close()

# Merge to get department per abnormal login
login_dept = login.merge(user[['User ID', 'Department']], on='User ID', how='left')
abnormal_dept = abnormal.merge(login_dept[['Login Record ID', 'Department']], on='Login Record ID', how='left')

# Compute metrics as before (same as compute_metrics_final.py)
def compute_metrics():
    user_counts = user.groupby('Department').size().reset_index(name='total_users')
    login_counts = login_dept.groupby('Department')['Login Record ID'].nunique().reset_index(name='total_logins')
    abnormal_counts = abnormal_dept.groupby('Department')['Anomaly ID'].nunique().reset_index(name='abnormal_logins')
    metrics = login_counts.merge(abnormal_counts, on='Department', how='left').merge(user_counts, on='Department', how='left')
    metrics['abnormal_rate'] = metrics['abnormal_logins'] / metrics['total_logins'] * 100
    
    confirmed = abnormal_dept[abnormal_dept['Confirmation Status'] == 'Confirmed'].groupby('Department')['Anomaly ID'].nunique().reset_index(name='confirmed_abnormal')
    metrics = metrics.merge(confirmed, on='Department', how='left')
    metrics['confirmed_abnormal_pct'] = metrics['confirmed_abnormal'] / metrics['abnormal_logins'] * 100
    
    high_risk = abnormal_dept[abnormal_dept['Risk Level'].isin(['Severe', 'High'])].groupby('Department')['Anomaly ID'].nunique().reset_index(name='high_risk_abnormal')
    metrics = metrics.merge(high_risk, on='Department', how='left')
    metrics['high_risk_abnormal_pct'] = metrics['high_risk_abnormal'] / metrics['abnormal_logins'] * 100
    
    remote = abnormal_dept[abnormal_dept['Anomaly Type'] == 'Remote Login'].groupby('Department')['Anomaly ID'].nunique().reset_index(name='remote_abnormal')
    metrics = metrics.merge(remote, on='Department', how='left')
    metrics['remote_login_pct'] = metrics['remote_abnormal'] / metrics['abnormal_logins'] * 100
    
    abnormal_high_risk = abnormal_dept[abnormal_dept['Risk Level'].isin(['Severe', 'High'])]
    high_risk_users = abnormal_high_risk.groupby('Department')['User ID'].nunique().reset_index(name='high_risk_user_count')
    metrics = metrics.merge(high_risk_users, on='Department', how='left')
    metrics['high_risk_user_pct'] = metrics['high_risk_user_count'] / metrics['total_users'] * 100
    
    avg_score = abnormal_dept.groupby('Department')['Anomaly Score'].mean().reset_index(name='avg_anomaly_score')
    metrics = metrics.merge(avg_score, on='Department', how='left')
    
    metrics = metrics.fillna(0)
    for col in ['abnormal_rate', 'confirmed_abnormal_pct', 'high_risk_abnormal_pct', 'remote_login_pct', 'high_risk_user_pct', 'avg_anomaly_score']:
        metrics[col] = metrics[col].round(1)
    
    return metrics

metrics = compute_metrics()
print('Metrics computed:')
print(metrics.to_string(index=False))

# Shorten department names for plotting
metrics['Dept'] = metrics['Department'].str.replace(' Department', '')

# Order as per Stage1 discussion: Marketing, Sales, Technical, Finance
order = ['Marketing', 'Sales', 'Technical', 'Finance']
metrics['Dept'] = pd.Categorical(metrics['Dept'], categories=order, ordered=True)
metrics = metrics.sort_values('Dept')

# Plot 1: High-risk user percentage
fig, ax = plt.subplots(figsize=(8, 5))
bars = ax.bar(metrics['Dept'], metrics['high_risk_user_pct'], color='indianred')
ax.set_title('Percentage of Users with High‑Risk Abnormal Logins per Department', fontsize=14)
ax.set_xlabel('Department', fontsize=12)
ax.set_ylabel('Percentage (%)', fontsize=12)
ax.set_ylim(0, 40)
# Annotate bars
for bar in bars:
    height = bar.get_height()
    ax.annotate(f'{height:.1f}%',
                xy=(bar.get_x() + bar.get_width() / 2, height),
                xytext=(0, 3), textcoords='offset points',
                ha='center', va='bottom', fontsize=11)
plt.tight_layout()
plt.savefig('high_risk_user_pct.png', dpi=300)
print('Saved high_risk_user_pct.png')
plt.close()

# Plot 2: Confirmed abnormal percentage
fig, ax = plt.subplots(figsize=(8, 5))
bars = ax.bar(metrics['Dept'], metrics['confirmed_abnormal_pct'], color='steelblue')
ax.set_title('Confirmed Abnormal Logins (% of All Abnormal Logins)', fontsize=14)
ax.set_xlabel('Department', fontsize=12)
ax.set_ylabel('Percentage (%)', fontsize=12)
ax.set_ylim(0, 70)
for bar in bars:
    height = bar.get_height()
    ax.annotate(f'{height:.1f}%',
                xy=(bar.get_x() + bar.get_width() / 2, height),
                xytext=(0, 3), textcoords='offset points',
                ha='center', va='bottom', fontsize=11)
plt.tight_layout()
plt.savefig('confirmed_abnormal_pct.png', dpi=300)
print('Saved confirmed_abnormal_pct.png')
plt.close()

# Plot 3: Average anomaly score
fig, ax = plt.subplots(figsize=(8, 5))
bars = ax.bar(metrics['Dept'], metrics['avg_anomaly_score'], color='darkorange')
ax.set_title('Average Anomaly Score per Department', fontsize=14)
ax.set_xlabel('Department', fontsize=12)
ax.set_ylabel('Average Score', fontsize=12)
ax.set_ylim(0, 55)
for bar in bars:
    height = bar.get_height()
    ax.annotate(f'{height:.1f}',
                xy=(bar.get_x() + bar.get_width() / 2, height),
                xytext=(0, 3), textcoords='offset points',
                ha='center', va='bottom', fontsize=11)
plt.tight_layout()
plt.savefig('avg_anomaly_score.png', dpi=300)
print('Saved avg_anomaly_score.png')
plt.close()

# Plot 4: Stacked risk level distribution
risk_counts = pd.crosstab(abnormal_dept['Department'], abnormal_dept['Risk Level'])
# Normalize to percentage of total abnormal per department
risk_pct = risk_counts.div(risk_counts.sum(axis=1), axis=0) * 100
# Shorten department names for x-axis
risk_pct.index = risk_pct.index.str.replace(' Department', '')
# Ensure order
risk_pct = risk_pct.reindex(order)
# Define risk level order for stacking
risk_order = ['Severe', 'High', 'Medium', 'Low']
risk_pct = risk_pct[risk_order]

fig, ax = plt.subplots(figsize=(9, 6))
bottom = np.zeros(len(risk_pct))
colors = ['firebrick', 'coral', 'gold', 'lightgreen']
for i, risk in enumerate(risk_order):
    ax.bar(risk_pct.index, risk_pct[risk], bottom=bottom, label=risk, color=colors[i], edgecolor='white')
    bottom += risk_pct[risk].fillna(0).values

ax.set_title('Risk‑Level Distribution of Abnormal Logins by Department', fontsize=14)
ax.set_xlabel('Department', fontsize=12)
ax.set_ylabel('Percentage (%)', fontsize=12)
ax.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('risk_distribution.png', dpi=300)
print('Saved risk_distribution.png')
plt.close()

print('All plots saved.')
''')
