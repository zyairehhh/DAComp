    plt.barh(channel_df['sourced_from_type'], channel_df['composite_score'])
    plt.xlabel('Composite Score (Higher = Better)')
    plt.title('Sourcing Channel Prioritization Score\n(Hire Rate 50%, Interview Efficiency 30%, Volume 20%)')
    plt.grid(True, alpha=0.3, axis='x')
    
    # Add score labels
    for i, score in enumerate(channel_df['composite_score']):
        plt.text(score + 0.01, i, f'{score:.3f}', va='center')
    
    plt.tight_layout()
    plt.savefig('channel_prioritization.png', dpi=300, bbox_inches='tight')
    plt.close()

conn.close()
print("Visualizations generated successfully")
