'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-034.sqlite')

# Combine both tables
query = """
SELECT 
    a.sku_id,
    a.`SKU Quantity` as quantity,
    a.`SKU Price` as original_price,
    a.`SKU Selling Price` as selling_price,
    a.`SKU Cost Price` as cost_price,
    c.`Level 1 Category ID` as cat1_id,
    c.`Level 1 Category Name` as cat1_name
FROM attachment_1 a
LEFT JOIN attachment_4 c ON a.sku_id = c.sku_id
WHERE a.`SKU Cost Price` > 0 AND a.`SKU Price` > 0

UNION ALL

SELECT 
    b.sku_id,
    b.`SKU Quantity` as quantity,
    b.`SKU Price` as original_price,
    b.`SKU Selling Price` as selling_price,
    b.`SKU Cost Price` as cost_price,
    c.`Level 1 Category ID` as cat1_id,
    c.`Level 1 Category Name` as cat1_name
FROM attachment_2 b
LEFT JOIN attachment_4 c ON b.sku_id = c.sku_id
WHERE b.`SKU Cost Price` > 0 AND b.`SKU Price` > 0;
"""

df = pd.read_sql_query(query, conn)
df['discount_depth'] = (df['original_price'] - df['selling_price']) / df['original_price']
df = df[(df['discount_depth'] >= 0) & (df['discount_depth'] <= 1)]

# Category-level summary
cat_agg = df.groupby(['cat1_id', 'cat1_name']).agg(
    total_units=('quantity', 'sum'),
    total_revenue=('selling_price', lambda x: (x * df.loc[x.index, 'quantity']).sum()),  # already have sales_revenue column but we compute directly
    avg_discount_depth=('discount_depth', 'mean'),
    median_discount_depth=('discount_depth', 'median'),
    promotion_count=('discount_depth', 'count'),
    avg_quantity_per_transaction=('quantity', 'mean'),
    avg_selling_price=('selling_price', 'mean')
).reset_index()

# Compute discount elasticity per category (correlation between discount depth and quantity per transaction)
cat_agg['corr_discount_quantity'] = np.nan
for idx, row in cat_agg.iterrows():
    cat_id = row['cat1_id']
    cat_df = df[df['cat1_id'] == cat_id]
    if len(cat_df) >= 2:
        corr = cat_df['discount_depth'].corr(cat_df['quantity'])
        cat_agg.at[idx, 'corr_discount_quantity'] = corr
    else:
        cat_agg.at[idx, 'corr_discount_quantity'] = np.nan

cat_agg.sort_values('total_units', ascending=False, inplace=True)
print("Category-level summary (sorted by total units sold):")
print(cat_agg.to_string(index=False))

# Save to CSV
cat_agg.to_csv('category_metrics.csv', index=False)

# Identify top categories by total units
top_cats = cat_agg.head(10)
print("\nTop 10 categories by units sold:")
print(top_cats[['cat1_name', 'total_units', 'total_revenue', 'avg_discount_depth', 'corr_discount_quantity']].to_string(index=False))

# Identify categories with highest average discount depth
high_discount_cats = cat_agg.sort_values('avg_discount_depth', ascending=False).head(10)
print("\nTop 10 categories by average discount depth:")
print(high_discount_cats[['cat1_name', 'avg_discount_depth', 'total_units', 'corr_discount_quantity']].to_string(index=False))

conn.close()
''')
