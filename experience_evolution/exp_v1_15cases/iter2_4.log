import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Connect to database
conn = sqlite3.connect('dacomp-035.sqlite')

# Query 1: Abnormal login counts per department (raw counts and rates)
query_counts = '''
WITH dept_counts AS (
    SELECT Department, COUNT(*) as dept_size 
    FROM user_information_table 
    GROUP BY Department
),
abnormal_counts AS (
    SELECT ui.Department, COUNT(al.[Anomaly ID]) as abnormal_count
    FROM abnormal_logins_table al
    JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
    JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
    GROUP BY ui.Department
)
SELECT dc.Department, dc.dept_size, ac.abnormal_count, 
       CAST(ac.abnormal_count AS REAL) / dc.dept_size AS abnormal_rate
FROM dept_counts dc
LEFT JOIN abnormal_counts ac ON dc.Department = ac.Department
ORDER BY abnormal_rate DESC
'''
df_counts = pd.read_sql_query(query_counts, conn)

# Plot 1: Bar chart of abnormal login rate per department
plt.figure(figsize=(8,5))
bars = plt.bar(df_counts['Department'], df_counts['abnormal_rate'], color='skyblue')
plt.title('Abnormal Login Rate by Department', fontsize=14)
plt.xlabel('Department', fontsize=12)
plt.ylabel('Abnormal Login Rate (events per user)', fontsize=12)
plt.xticks(rotation=15)
# Add value labels on bars
for bar, rate in zip(bars, df_counts['abnormal_rate']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.005,
             f'{rate:.3f}', ha='center', va='bottom', fontsize=10)
plt.tight_layout()
plt.savefig('abnormal_rate_by_dept.png', dpi=300)
plt.close()

# Query 2: Risk level distribution per department
query_risk = '''
SELECT ui.Department, al.[Risk Level], COUNT(*) as count
FROM abnormal_logins_table al
JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
GROUP BY ui.Department, al.[Risk Level]
ORDER BY ui.Department, al.[Risk Level]
'''
df_risk = pd.read_sql_query(query_risk, conn)

# Pivot for stacked bar
risk_pivot = df_risk.pivot(index='Department', columns='Risk Level', values='count').fillna(0)
# Reorder risk levels for consistent color mapping
risk_levels = ['Low', 'Medium', 'High', 'Severe']
# Ensure all levels present
for level in risk_levels:
    if level not in risk_pivot.columns:
        risk_pivot[level] = 0
risk_pivot = risk_pivot[risk_levels]

# Plot 2: Stacked bar chart of risk levels per department
plt.figure(figsize=(9,6))
risk_pivot.plot(kind='bar', stacked=True, colormap='RdYlGn_r', edgecolor='black')
plt.title('Distribution of Risk Levels in Abnormal Logins by Department', fontsize=14)
plt.xlabel('Department', fontsize=12)
plt.ylabel('Number of Abnormal Login Events', fontsize=12)
plt.xticks(rotation=15)
plt.legend(title='Risk Level', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.tight_layout()
plt.savefig('risk_levels_by_dept.png', dpi=300)
plt.close()

# Query 3: Anomaly type distribution per department
query_type = '''
SELECT ui.Department, al.[Anomaly Type], COUNT(*) as count
FROM abnormal_logins_table al
JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
GROUP BY ui.Department, al.[Anomaly Type]
ORDER BY ui.Department, al.[Anomaly Type]
'''
df_type = pd.read_sql_query(query_type, conn)

# Pivot for stacked bar
type_pivot = df_type.pivot(index='Department', columns='Anomaly Type', values='count').fillna(0)
# We may want to order anomaly types logically
anomaly_types = ['Multiple IPs in short time', 'Device anomaly', 'Frequent login', 'Remote Login']
for atype in anomaly_types:
    if atype not in type_pivot.columns:
        type_pivot[atype] = 0
type_pivot = type_pivot[anomaly_types]

# Plot 3: Stacked bar chart of anomaly types per department
plt.figure(figsize=(9,6))
type_pivot.plot(kind='bar', stacked=True, colormap='tab20c', edgecolor='black')
plt.title('Distribution of Anomaly Types in Abnormal Logins by Department', fontsize=14)
plt.xlabel('Department', fontsize=12)
plt.ylabel('Number of Abnormal Login Events', fontsize=12)
plt.xticks(rotation=15)
plt.legend(title='Anomaly Type', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.tight_layout()
plt.savefig('anomaly_types_by_dept.png', dpi=300)
plt.close()

# Query 4: Severity score per department (average anomaly score)
# Note: anomaly score column name? We have "Anomaly Score" integer values.
query_score = '''
SELECT ui.Department, AVG(al.[Anomaly Score]) as avg_score
FROM abnormal_logins_table al
JOIN login_records_table lr ON al.[Login Record ID] = lr.[Login Record ID]
JOIN user_information_table ui ON lr.[User ID] = ui.[User ID]
GROUP BY ui.Department
ORDER BY avg_score DESC
'''
