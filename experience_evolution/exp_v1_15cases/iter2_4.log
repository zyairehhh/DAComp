import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-022.sqlite')

# Query for scatter plot data
query = """
SELECT 
    "Vehicle Type",
    AVG("Booking Value"/"Ride Distance") as avg_fare_per_km,
    AVG("Driver Ratings") as avg_driver_rating,
    COUNT(*) as ride_count
FROM sheet1 
WHERE "Booking Status" = 'Completed' 
    AND "Booking Value" IS NOT NULL 
    AND "Ride Distance" IS NOT NULL 
    AND "Ride Distance" > 0
    AND "Driver Ratings" IS NOT NULL
GROUP BY "Vehicle Type" 
"""

df = pd.read_sql_query(query, conn)

# Create scatter plot
plt.figure(figsize=(10, 6))
colors = plt.cm.Set3(range(len(df)))

# Create scatter plot with bubble sizes based on ride count
scatter = plt.scatter(df['avg_fare_per_km'], df['avg_driver_rating'], 
                      s=df['ride_count']/50,  # Scale down for visibility
                      c=colors, alpha=0.7, edgecolors='black', linewidth=0.5)

# Add vehicle type labels
for i, row in df.iterrows():
    plt.annotate(row['Vehicle Type'], 
                (row['avg_fare_per_km'], row['avg_driver_rating']),
                xytext=(5, 5), textcoords='offset points',
                fontsize=9, alpha=0.8)

plt.xlabel('Average Fare per KM (currency units)')
plt.ylabel('Average Driver Rating (1-5 scale)')
plt.title('Relationship Between Fare per KM and Driver Ratings by Vehicle Type\n(Bubble size represents number of rides)')
plt.grid(True, alpha=0.3)

# Add correlation coefficient
correlation = df['avg_fare_per_km'].corr(df['avg_driver_rating'])
plt.text(0.05, 0.95, f'Correlation: {correlation:.3f}', 
         transform=plt.gca().transAxes, fontsize=10,
         verticalalignment='top',
         bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))

plt.tight_layout()
plt.savefig('fare_rating_correlation.png', dpi=150, bbox_inches='tight')
plt.close()

# Now analyze time patterns - extract hour from Time column
query_time = """
SELECT 
    CAST(SUBSTR("Time", 1, 2) AS INTEGER) as hour,
    "Vehicle Type",
    AVG("Booking Value"/"Ride Distance") as avg_fare_per_km,
    COUNT(*) as ride_count
FROM sheet1 
WHERE "Booking Status" = 'Completed' 
    AND "Booking Value" IS NOT NULL 
    AND "Ride Distance" IS NOT NULL 
    AND "Ride Distance" > 0
    AND "Time" IS NOT NULL
    AND "Time" != ''
GROUP BY hour, "Vehicle Type"
ORDER BY hour, "Vehicle Type"
"""

df_time = pd.read_sql_query(query_time, conn)
conn.close()

# Pivot for heatmap or line plot
pivot_df = df_time.pivot(index='hour', columns='Vehicle Type', values='avg_fare_per_km')

# Create line plot for fare per km by hour for top 3 vehicle types
plt.figure(figsize=(12, 6))

# Get top 3 vehicle types by total rides
top_vehicles = df.sort_values('ride_count', ascending=False)['Vehicle Type'].head(3).tolist()

for vehicle in top_vehicles:
    if vehicle in pivot_df.columns:
        vehicle_data = pivot_df[vehicle].dropna()
        plt.plot(vehicle_data.index, vehicle_data.values, 
                marker='o', linewidth=2, markersize=6, label=vehicle)

plt.xlabel('Hour of Day')
plt.ylabel('Average Fare per KM (currency units)')
plt.title('Hourly Fare per KM Patterns for Top 3 Vehicle Types')
plt.legend()
plt.grid(True, alpha=0.3)
plt.xticks(range(0, 24))

plt.tight_layout()
plt.savefig('hourly_fare_patterns.png', dpi=150, bbox_inches='tight')
plt.close()

print("Plots saved as 'fare_rating_correlation.png' and 'hourly_fare_patterns.png'")
```
