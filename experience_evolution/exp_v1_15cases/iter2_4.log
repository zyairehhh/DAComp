import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
matplotlib.use('Agg')

conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Filter completed rides
completed = df[df['Booking Status'] == 'Completed']
# Remove rows with missing Booking Value or Ride Distance
completed = completed.dropna(subset=['Booking Value', 'Ride Distance'])
# Ensure numeric
completed['Booking Value'] = pd.to_numeric(completed['Booking Value'], errors='coerce')
completed['Ride Distance'] = pd.to_numeric(completed['Ride Distance'], errors='coerce')
completed = completed[(completed['Booking Value'] > 0) & (completed['Ride Distance'] > 0)]

# Compute per-km fare
completed['fare_per_km'] = completed['Booking Value'] / completed['Ride Distance']

# Plot 1: Average fare per km by Vehicle Type
plt.figure(figsize=(10,6))
avg_fare = completed.groupby('Vehicle Type')['fare_per_km'].mean().sort_values(ascending=False)
avg_fare.plot(kind='bar', color='skyblue')
plt.title('Average Fare per Kilometer by Vehicle Type')
plt.xlabel('Vehicle Type')
plt.ylabel('Average Fare (currency per km)')
plt.tight_layout()
plt.savefig('avg_fare_per_km_by_vehicle.png')
plt.close()

# Plot 2: Driver Ratings distribution and its relation to fare per km
plt.figure(figsize=(10,6))
completed['Driver Ratings'] = pd.to_numeric(completed['Driver Ratings'], errors='coerce')
completed = completed.dropna(subset=['Driver Ratings'])
bins = [0, 1, 2, 3, 4, 5]
labels = ['0-1', '1-2', '2-3', '3-4', '4-5']
completed['rating_group'] = pd.cut(completed['Driver Ratings'], bins=bins, labels=labels, include_lowest=True)
rating_fare = completed.groupby('rating_group')['fare_per_km'].mean()
rating_fare.plot(kind='bar', color='lightcoral')
plt.title('Average Fare per Kilometer by Driver Rating Group')
plt.xlabel('Driver Rating Group')
plt.ylabel('Average Fare (currency per km)')
plt.tight_layout()
plt.savefig('avg_fare_per_km_by_rating.png')
plt.close()

# Plot 3: Scatter of Driver Rating vs fare per km for each Vehicle Type (maybe top 3)
# Let's pick top 3 vehicle types by count
top_vehicles = completed['Vehicle Type'].value_counts().head(3).index.tolist()
fig, axes = plt.subplots(1, 3, figsize=(15,5), sharey=True)
for i, vt in enumerate(top_vehicles):
    subset = completed[completed['Vehicle Type'] == vt]
    axes[i].scatter(subset['Driver Ratings'], subset['fare_per_km'], alpha=0.5, s=10)
    axes[i].set_title(f'Vehicle: {vt}')
    axes[i].set_xlabel('Driver Rating')
    axes[i].set_ylabel('Fare per km')
plt.suptitle('Driver Rating vs Fare per km by Vehicle Type')
plt.tight_layout()
plt.savefig('scatter_rating_fare_by_vehicle.png')
plt.close()

# Plot 4: Distribution of ride distances by vehicle type (boxplot)
plt.figure(figsize=(10,6))
completed.boxplot(column='Ride Distance', by='Vehicle Type', rot=45)
plt.title('Ride Distance Distribution by Vehicle Type')
plt.xlabel('Vehicle Type')
plt.ylabel('Ride Distance (km)')
plt.tight_layout()
plt.savefig('boxplot_distance_by_vehicle.png')
plt.close()
```
