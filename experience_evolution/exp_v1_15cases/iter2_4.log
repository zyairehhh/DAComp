import sqlite3
import pandas as pd
import numpy as np
import datetime

# Connect to database
conn = sqlite3.connect('dacomp-034.sqlite')

# Load direct promotions (type 3)
promos_query = """
SELECT 
    sku_id,
    promotion_price,
    pdj_price,
    begin_time,
    end_time
FROM attachment_3
WHERE promotion_type = 3 
    AND state = 5 
    AND validation = 0
"""
promos = pd.read_sql(promos_query, conn)
print(f"Promotions count: {len(promos)}")

# Load category mapping
cats_query = """
SELECT sku_id, "Level 1 Category Name"
FROM attachment_4
"""
categories = pd.read_sql(cats_query, conn)

# Load sales from attachment_1 and attachment_2
sales_query = """
SELECT 
    sku_id,
    "SKU Quantity" as quantity,
    "SKU Price" as original_price,
    "SKU Selling Price" as selling_price,
    "create_dt" as order_date
FROM attachment_1
UNION ALL
SELECT 
    sku_id,
    "SKU Quantity",
    "SKU Price",
    "SKU Selling Price",
    "create_dt"
FROM attachment_2
"""
sales = pd.read_sql(sales_query, conn)
print(f"Sales rows: {len(sales)}")

# Merge with categories
sales = sales.merge(categories, on='sku_id', how='left')
# Merge with promotions (but need date range)
# Convert date strings
sales['order_date'] = pd.to_datetime(sales['order_date'])
# For promotions, parse begin_time and end_time
def parse_promo_date(s):
    if pd.isnull(s):
        return pd.NaT
    # format like "2017/9/9 9:00"
    try:
        return pd.to_datetime(s, format='%Y/%m/%d %H:%M')
    except:
        # fallback
        return pd.to_datetime(s)

promos['begin_dt'] = promos['begin_time'].apply(parse_promo_date)
promos['end_dt'] = promos['end_time'].apply(parse_promo_date)

# Compute discount depth for promotions
promos['discount_depth'] = (promos['pdj_price'] - promos['promotion_price']) / promos['pdj_price']
print("Promo discount depth stats:")
print(promos['discount_depth'].describe())

# Now join sales with promotions where sku matches and order_date within range
# This is a range join; we can do a cartesian join then filter, but might be heavy.
# Let's first try to join on sku_id and then filter.
merged = sales.merge(promos[['sku_id', 'begin_dt', 'end_dt', 'discount_depth']], on='sku_id', how='inner')
print(f"Merged rows before date filter: {len(merged)}")
# Filter for order_date between begin_dt and end_dt
merged = merged[(merged['order_date'] >= merged['begin_dt']) & (merged['order_date'] <= merged['end_dt'])]
print(f"Merged rows after date filter: {len(merged)}")

# Compute discount depth from sales price difference (optional)
merged['sales_discount_depth'] = (merged['original_price'] - merged['selling_price']) / merged['original_price']

# Group by Level 1 Category and discount depth (maybe bucket)
merged['discount_bucket'] = pd.cut(merged['discount_depth'], bins=[0, 0.1, 0.2, 0.3, 0.5, 1.0], labels=['0-10%','10-20%','20-30%','30-50%','>50%'])
category_sales = merged.groupby(['Level 1 Category Name', 'discount_bucket']).agg(
    total_quantity=('quantity', 'sum'),
    total_revenue=('selling_price', lambda x: (x * merged.loc[x.index, 'quantity']).sum()),
    avg_discount_depth=('discount_depth', 'mean'),
    promo_count=('sku_id', 'count')
).reset_index()

print(category_sales)

# Save to CSV for further analysis
category_sales.to_csv('category_discount_sales.csv', index=False)

# Compute correlation per category between discount depth and quantity
correlations = []
for cat in merged['Level 1 Category Name'].unique():
    if pd.isnull(cat):
        continue
    sub = merged[merged['Level 1 Category Name'] == cat]
    if len(sub) > 1:
        corr = sub['discount_depth'].corr(sub['quantity'])
        correlations.append({'category': cat, 'correlation': corr, 'n': len(sub)})
corr_df = pd.DataFrame(correlations)
print(corr_df.sort_values('correlation'))

# Additional analysis: total sales per category
total_by_cat = merged.groupby('Level 1 Category Name').agg(
    total_quantity=('quantity', 'sum'),
    total_revenue=('selling_price', lambda x: (x * merged.loc[x.index, 'quantity']).sum()),
    avg_discount=('discount_depth', 'mean'),
    promo_count=('sku_id', 'count')
).reset_index()
print(total_by_cat)

conn.close()
```
