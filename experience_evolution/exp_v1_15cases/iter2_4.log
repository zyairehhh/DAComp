    'composite_score': 'mean',
    'participation_score': 'mean',
    'completion_score': 'mean',
    'cross_channel_score': 'mean',
    'progress_score': 'mean',
    'total_count_surveys': 'mean',
    'total_count_completed_surveys': 'mean',
    'avg_survey_progress_pct': 'mean',
    'avg_survey_duration_in_seconds': 'mean',
    'count_surveys_sent_email': 'mean',
    'count_surveys_sent_sms': 'mean',
    'count_surveys_opened_email': 'mean',
    'count_surveys_opened_sms': 'mean',
    'count_surveys_started_email': 'mean',
    'count_surveys_started_sms': 'mean',
    'count_surveys_completed_email': 'mean',
    'count_surveys_completed_sms': 'mean',
}).round(2)
print("Average metrics per tier:")
print(agg)

# Compare medium vs high
numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
medium = df[df['value_tier'] == 'medium'][numeric_cols]
high = df[df['value_tier'] == 'high'][numeric_cols]
# Compute difference means
diff = high.mean() - medium.mean()
# Select key metrics to display
key_metrics = ['total_count_surveys', 'total_count_completed_surveys', 'avg_survey_progress_pct',
               'count_surveys_sent_email', 'count_surveys_sent_sms',
               'count_surveys_opened_email', 'count_surveys_opened_sms',
               'count_surveys_started_email', 'count_surveys_started_sms',
               'count_surveys_completed_email', 'count_surveys_completed_sms']
diff = diff[key_metrics]
print("\nDifference (high - medium) in key metrics:")
