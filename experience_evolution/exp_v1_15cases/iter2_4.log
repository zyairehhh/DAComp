# Load source composite data
comp_df = pd.read_csv(os.path.join(stage1_path, "source_composite.csv"))
# Load hires per source
hires_df = pd.read_csv(os.path.join(stage1_path, "hires_per_source.csv"))
# Load source rating
rating_df = pd.read_csv(os.path.join(stage1_path, "source_rating.csv"))

# 1. Bar chart of composite score per source
plt.figure(figsize=(10,6))
bars = plt.bar(comp_df['source_name'], comp_df['composite_score'], color='skyblue')
plt.title('Composite Score by Sourcing Channel', fontsize=14)
plt.xlabel('Source', fontsize=12)
plt.ylabel('Composite Score', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('composite_score_by_source.png', dpi=300)
plt.close()

# 2. Bar chart of total hires per source
plt.figure(figsize=(10,6))
plt.bar(hires_df['source_name'], hires_df['total_hires'], color='lightgreen')
plt.title('Total Hires per Sourcing Channel (2024 Q4)', fontsize=14)
plt.xlabel('Source', fontsize=12)
plt.ylabel('Number of Hires', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('hires_per_source.png', dpi=300)
plt.close()

# 3. Scatter plot: hire rate vs avg process days with composite score as size
plt.figure(figsize=(10,6))
scatter = plt.scatter(comp_df['hire_rate'], comp_df['avg_process_days'], 
                      s=comp_df['composite_score']*100, alpha=0.7, 
                      c=comp_df['cost_index'], cmap='RdYlBu_r')
plt.colorbar(scatter, label='Cost Index (lower is cheaper)')
for i, row in comp_df.iterrows():
    plt.annotate(row['source_name'], (row['hire_rate'], row['avg_process_days']),
                 xytext=(5,5), textcoords='offset points', fontsize=9)
plt.title('Trade-off: Hire Rate vs Process Days (size = composite score)', fontsize=14)
plt.xlabel('Hire Rate (%)', fontsize=12)
plt.ylabel('Average Process Days', fontsize=12)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('hire_rate_vs_process_days.png', dpi=300)
plt.close()

# 4. Horizontal bar chart of normalized metrics for top sources
# Sort by composite score descending
comp_sorted = comp_df.sort_values('composite_score', ascending=True).tail(8)
metrics = ['hire_rate_norm', 'interview_rate_norm', 'interview_to_hire_rate_norm',
           'efficiency_score_norm', 'avg_quality_norm', 'avg_rating_norm', 'process_speed_norm']
# Use a palette
import numpy as np
fig, ax = plt.subplots(figsize=(12, 8))
y_pos = np.arange(len(comp_sorted['source_name']))
height = 0.1
colors = plt.cm.Set2(np.linspace(0, 1, len(metrics)))
for i, metric in enumerate(metrics):
    ax.barh(y_pos + i*height, comp_sorted[metric], height, color=colors[i], label=metric)
ax.set_yticks(y_pos + height*(len(metrics)-1)/2)
ax.set_yticklabels(comp_sorted['source_name'])
ax.set_xlabel('Normalized Score (0-1)')
ax.set_title('Normalized Performance Metrics by Source (Top 8 sorted by composite)')
ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
plt.tight_layout()
plt.savefig('normalized_metrics_by_source.png', dpi=300)
plt.close()

# 5. Line chart of cost vs quality (rating)
plt.figure(figsize=(10,6))
plt.scatter(comp_df['cost_index'], rating_df['avg_rating'], s=100, alpha=0.7)
for i, row in comp_df.iterrows():
    plt.annotate(row['source_name'], (row['cost_index'], rating_df.loc[i, 'avg_rating']),
                 xytext=(5,5), textcoords='offset points', fontsize=9)
plt.title('Cost vs Quality (Avg Rating) by Source', fontsize=14)
plt.xlabel('Cost Index (lower is cheaper)', fontsize=12)
plt.ylabel('Average Rating (higher is better)', fontsize=12)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('cost_vs_quality.png', dpi=300)
plt.close()

print("Visualizations saved as PNG files.")
