import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('/workspace/dacomp-034.sqlite')

# Load sales data (attachment_1 and attachment_2? They look identical, maybe union)
# According to stage1 they used both? Let's check row counts.
query = """
SELECT COUNT(*) as cnt FROM attachment_1
UNION ALL
SELECT COUNT(*) FROM attachment_2
"""
counts = pd.read_sql_query(query, conn)
print("Row counts:", counts)

# Actually stage1 says "Two sales tables (attachment_1, attachment_2) containing 1.22 million transaction lines"
# We'll combine them.
sales_query = """
SELECT create_dt, `Order ID` as order_id, sku_id, sku_name, `Is Completed` as is_completed,
       `SKU Quantity` as quantity, `SKU Price` as original_price, `SKU Selling Price` as selling_price,
       `SKU Cost Price` as cost_price, `UPC Code` as upc
FROM attachment_1
UNION ALL
SELECT create_dt, `Order ID`, sku_id, sku_name, `Is Completed`,
       `SKU Quantity`, `SKU Price`, `SKU Selling Price`, `SKU Cost Price`, `UPC Code`
FROM attachment_2
"""
df_sales = pd.read_sql_query(sales_query, conn)
print("Total sales rows:", len(df_sales))

# Load category mapping
df_cat = pd.read_sql_query("SELECT sku_id, `Level 1 Category Name` as cat1 FROM attachment_4", conn)

# Merge
df = pd.merge(df_sales, df_cat, on='sku_id', how='left')
print("Rows after merge:", len(df))

# Compute discount depth only where original_price > 0 and selling_price < original_price (discounted)
df['discount_depth'] = (df['original_price'] - df['selling_price']) / df['original_price']
df['discounted'] = df['discount_depth'] > 0
df_disc = df[df['discounted']].copy()
print("Discounted transactions:", len(df_disc))

# Compute category-level correlation and average discount depth, total quantity
# Group by category and compute correlation between discount_depth and quantity
cat_corrs = []
for cat, group in df_disc.groupby('cat1'):
    if len(group) >= 10:  # enough data
        corr = group['discount_depth'].corr(group['quantity'])
        avg_depth = group['discount_depth'].mean()
        total_qty = group['quantity'].sum()
        cat_corrs.append({
            'category': cat,
            'correlation': corr,
            'avg_discount_depth': avg_depth,
            'total_disc_qty': total_qty
        })

df_cat_corr = pd.DataFrame(cat_corrs)
print(df_cat_corr.head())

# Save data for later use
df_cat_corr.to_csv('/workspace/category_correlations.csv', index=False)

# Also get discount depth distribution overall
overall_depths = df_disc['discount_depth'].dropna()
print("Overall discount depth stats:", overall_depths.describe())

# Plot 1: Overall discount depth histogram
plt.figure(figsize=(10,6))
plt.hist(overall_depths*100, bins=50, alpha=0.7, color='skyblue', edgecolor='black')
plt.axvline(overall_depths.median()*100, color='red', linestyle='--', label=f'Median = {overall_depths.median()*100:.1f}%')
plt.xlabel('Discount Depth (%)')
plt.ylabel('Frequency')
plt.title('Distribution of Discount Depth Across All Discounted Transactions')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('/workspace/discount_depth_histogram.png', dpi=300)
plt.close()

# Plot 2: Category correlation vs average discount depth (bubble chart)
plt.figure(figsize=(12,8))
scatter = plt.scatter(df_cat_corr['avg_discount_depth']*100, df_cat_corr['correlation'],
                      s=df_cat_corr['total_disc_qty']/100, alpha=0.6, c=df_cat_corr['correlation'], cmap='RdYlGn')
plt.axhline(y=0, color='gray', linestyle='--')
plt.xlabel('Average Discount Depth (%)')
plt.ylabel('Correlation (Discount Depth vs Quantity)')
plt.title('Category-Level Correlation between Discount Depth and Sales Quantity\n(Bubble size = total discounted quantity)')
plt.colorbar(scatter, label='Correlation')
# Annotate some notable categories
for idx, row in df_cat_corr.iterrows():
    if abs(row['correlation']) > 0.2 or row['total_disc_qty'] > 50000:
        plt.annotate(row['category'], (row['avg_discount_depth']*100, row['correlation']), fontsize=8)
plt.grid(True, alpha=0.3)
plt.savefig('/workspace/category_correlation_bubble.png', dpi=300)
plt.close()

# Plot 3: Top categories by discounted sales volume (bar chart)
top_cats = df_cat_corr.nlargest(10, 'total_disc_qty')
plt.figure(figsize=(12,6))
bars = plt.barh(top_cats['category'], top_cats['total_disc_qty']/1000, color='steelblue')
plt.xlabel('Discounted Sales Quantity (Thousands)')
plt.title('Top 10 Categories by Discounted Sales Volume')
plt.gca().invert_yaxis()
for bar in bars:
    width = bar.get_width()
    plt.text(width, bar.get_y() + bar.get_height()/2, f'{width:.0f}k', ha='left', va='center')
plt.grid(True, alpha=0.3, axis='x')
plt.savefig('/workspace/top_categories_volume.png', dpi=300)
plt.close()

# Plot 4: Discount depth distribution across selected categories (boxplot)
# Select categories with high volume
selected_cats = top_cats['category'].head(6).tolist()
df_selected = df_disc[df_disc['cat1'].isin(selected_cats)]
plt.figure(figsize=(12,6))
df_selected.boxplot(column='discount_depth', by='cat1', grid=False, vert=True)
plt.xticks(rotation=45)
plt.title('Discount Depth Distribution for High-Volume Categories')
plt.suptitle('')
plt.ylabel('Discount Depth')
plt.xlabel('Category')
plt.grid(True, alpha=0.3)
plt.savefig('/workspace/boxplot_discount_depth_by_category.png', dpi=300)
plt.close()

# Plot 5: Discount bucket concentration for a few categories
# Define buckets
bins = [0, 0.05, 0.10, 0.15, 0.20, 0.30, 0.50, 1.0]
labels = ['0-5%', '5-10%', '10-15%', '15-20%', '20-30%', '30-50%', '>50%']
df_disc['discount_bucket'] = pd.cut(df_disc['discount_depth'], bins=bins, labels=labels, include_lowest=True)
# For each selected category, compute proportion of quantity in each bucket
cat_buckets = df_disc.groupby(['cat1','discount_bucket'])['quantity'].sum().unstack(fill_value=0)
cat_buckets_prop = cat_buckets.div(cat_buckets.sum(axis=1), axis=0)
# Take top categories
top5_cats = df_cat_corr.nlargest(5, 'total_disc_qty')['category'].tolist()
cat_buckets_prop_top = cat_buckets_prop.loc[top5_cats]
# Plot stacked bar
plt.figure(figsize=(12,6))
cat_buckets_prop_top.plot(kind='barh', stacked=True, colormap='viridis')
plt.xlabel('Proportion of Discounted Quantity')
plt.title('Discount Depth Bucket Concentration for Top 5 Categories by Volume')
plt.legend(title='Discount Bucket', bbox_to_anchor=(1.05, 1))
plt.grid(True, alpha=0.3, axis='x')
plt.savefig('/workspace/discount_bucket_concentration.png', dpi=300, bbox_inches='tight')
plt.close()

conn.close()
print("Plots generated.")
```
