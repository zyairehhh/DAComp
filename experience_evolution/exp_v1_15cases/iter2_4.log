    sheet1 
WHERE 
    "Booking Status" = 'Completed'
GROUP BY 
    "Drop Location"
HAVING 
    COUNT(*) >= 100
ORDER BY 
    avg_per_km DESC
LIMIT 10
"""
df4 = pd.read_sql_query(query4, conn)
print("\n=== Top 10 Drop Locations by Per‑KM Fare (min 100 rides) ===")
