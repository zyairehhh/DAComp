import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-060.sqlite')
df = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)

# Compute CTR and CVR
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
df['CTR'] = df['CTR'].replace([np.inf, -np.inf], np.nan).fillna(0)
df['CVR'] = df['CVR'].replace([np.inf, -np.inf], np.nan).fillna(0)

# Percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

# Identify problematic ad groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
overall_cvr = df.loc[df['clicks']>0, 'CVR'].mean()
problematic.loc[:, 'intent_match_ratio'] = problematic['CVR'] / overall_cvr

total_ad_groups = len(df)
num_problematic = len(problematic)
pct_problematic = num_problematic / total_ad_groups * 100
total_spend_problematic = problematic['spend'].sum()
avg_intent_match = problematic['intent_match_ratio'].mean()

print(f"Total ad groups: {total_ad_groups}")
print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")
print(f"Problematic ad groups: {num_problematic}")
print(f"Percentage of total: {pct_problematic:.1f}%")
print(f"Overall average CVR: {overall_cvr:.4f}")
print(f"Total spend for problematic groups: ${total_spend_problematic:.2f}")
print(f"Average intent match ratio for problematic groups: {avg_intent_match:.3f}")
''')
