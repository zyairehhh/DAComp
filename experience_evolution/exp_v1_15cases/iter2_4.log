import sqlite3
import pandas as pd
import os

# Connect to database
conn = sqlite3.connect("/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter3/dacomp-069/stage1_env/dacomp-069.sqlite")

# Define app
app = "com.dev.photoeditor"

# Get geo_market_analysis to classify revenue groups
geo_query = """
SELECT country, region, average_revenue_per_user, overall_market_score, app_quality_score
FROM google_play__geo_market_analysis WHERE package_name = ?
"""
geo_df = pd.read_sql(geo_query, conn, params=(app,))
geo_df['revenue_group'] = geo_df['average_revenue_per_user'].apply(lambda x: 'high' if x > 28 else ('low' if x < 10 else 'medium'))

# Get finance report monthly revenue per country
finance_query = """
SELECT country_short, strftime('%Y-%m', date_day) as month, SUM(net_amount) as monthly_revenue, SUM(transactions) as monthly_transactions
FROM google_play__finance_report WHERE package_name = ?
GROUP BY country_short, month ORDER BY country_short, month
"""
finance_df = pd.read_sql(finance_query, conn, params=(app,))

# Merge with revenue groups
finance_df = finance_df.merge(geo_df[['country', 'revenue_group']], left_on='country_short', right_on='country', how='inner')

# Compute month-over-month growth per country
finance_df['month'] = pd.to_datetime(finance_df['month'] + '-01')
finance_df = finance_df.sort_values(['country_short', 'month'])
finance_df['prev_revenue'] = finance_df.groupby('country_short')['monthly_revenue'].shift(1)
finance_df['revenue_growth'] = (finance_df['monthly_revenue'] - finance_df['prev_revenue']) / finance_df['prev_revenue']

# Aggregate by revenue_group and month
group_month = finance_df.groupby(['revenue_group', 'month']).agg({
    'monthly_revenue': 'sum',
    'monthly_transactions': 'sum',
    'revenue_growth': 'mean'
}).reset_index()

# Compute overall monthly performance score from comprehensive_performance_dashboard
perf_query = """
SELECT date_day, overall_performance_score, research_budget_usd FROM google_play__comprehensive_performance_dashboard WHERE package_name = ?
ORDER BY date_day
"""
perf_df = pd.read_sql(perf_query, conn, params=(app,))
perf_df['date_day'] = pd.to_datetime(perf_df['date_day'])

# Save aggregated data to current directory
output_dir = '.'
group_month.to_csv(os.path.join(output_dir, 'group_month_revenue.csv'), index=False)
perf_df.to_csv(os.path.join(output_dir, 'overall_performance.csv'), index=False)
geo_df.to_csv(os.path.join(output_dir, 'geo_markets.csv'), index=False)

# Print summary
print("=== Revenue Groups Summary ===")
print(geo_df.groupby('revenue_group').agg({'country': 'count', 'average_revenue_per_user': 'mean', 'overall_market_score': 'mean', 'app_quality_score': 'mean'}).round(2))
print("\n=== Monthly Revenue by Group (first few rows) ===")
print(group_month.head(20))
print("\n=== Overall Performance Trend ===")
print(perf_df)

conn.close()
```
