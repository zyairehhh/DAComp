import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.ticker import FuncFormatter
import warnings
warnings.filterwarnings('ignore')

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Visualize: Decay patterns of user acquisition cost-efficiency for each region and device type combination over past 6 months
# We need to understand user acquisition cost-efficiency. Since we don't have direct CAC, we can infer from conversion rate, installs, revenue
print("Creating visualization 1: Regional decay patterns...")

# Load country data with time series
query = """
SELECT 
    date_day,
    region,
    country_short,
    store_listing_conversion_rate,
    active_devices_last_30_days,
    total_store_visitors,
    total_store_acquisitions,
    net_device_installs,
    rolling_store_conversion_rate
FROM google_play__country_report 
WHERE date_day >= DATE('2024-04-01')
ORDER BY date_day, region, country_short
"""
country_df = pd.read_sql_query(query, conn)
country_df['date_day'] = pd.to_datetime(country_df['date_day'])

# Aggregate by region and month
country_df['month'] = country_df['date_day'].dt.to_period('M')
region_monthly = country_df.groupby(['region', 'month']).agg({
    'store_listing_conversion_rate': 'mean',
    'active_devices_last_30_days': 'sum',
    'total_store_visitors': 'sum',
    'total_store_acquisitions': 'sum',
    'net_device_installs': 'sum'
}).reset_index()
region_monthly['conversion_rate'] = region_monthly['total_store_acquisitions'] / region_monthly['total_store_visitors'].replace(0, np.nan)
region_monthly['install_efficiency'] = region_monthly['net_device_installs'] / region_monthly['total_store_acquisitions'].replace(0, np.nan)  # Proxy for efficiency

# Plot 1: Conversion rate decay by region over time
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
regions = region_monthly['region'].unique()

for i, region in enumerate(regions):
    if i >= 4:  # Only 4 subplots
        break
    ax = axes[i//2, i%2]
    region_data = region_monthly[region_monthly['region'] == region]
    ax.plot(region_data['month'].astype(str), region_data['store_listing_conversion_rate'], 
            marker='o', linewidth=2, label='Conversion Rate')
    ax.set_title(f'Store Listing Conversion Rate Trend: {region}', fontsize=12, fontweight='bold')
    ax.set_xlabel('Month')
    ax.set_ylabel('Conversion Rate')
    ax.tick_params(axis='x', rotation=45)
    ax.legend()
    ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('regional_conversion_decay.png', dpi=300)
print("Saved regional_conversion_decay.png")

# 2. Visualize: Non-linear relationship between store_listing_conversion_rate and quality_score/crash_rate_per_1k
print("\nCreating visualization 2: Non-linear relationships...")

# Get data with conversion rate vs quality metrics
query = """
SELECT 
    cr.date_day,
    cr.country_short,
    cr.store_listing_conversion_rate,
    cr.active_devices_last_30_days,
    ts.quality_score,
    ts.crash_rate_per_1k,
    ts.revenue_per_active_device
FROM google_play__country_report cr
JOIN google_play__time_series_trends ts ON cr.date_day = ts.date_day
WHERE cr.date_day >= DATE('2024-04-01')
  AND ts.crash_rate_per_1k IS NOT NULL 
  AND ts.quality_score IS NOT NULL
  AND cr.store_listing_conversion_rate IS NOT NULL
"""
quality_data = pd.read_sql_query(query, conn)
quality_data['date_day'] = pd.to_datetime(quality_data['date_day'])

# Scatter plots with regression
fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Plot 1: Conversion Rate vs Quality Score
scatter1 = axes[0].scatter(quality_data['quality_score'], quality_data['store_listing_conversion_rate'], 
                           c=quality_data['active_devices_last_30_days'], cmap='viridis', alpha=0.7, s=50)
axes[0].set_xlabel('Quality Score (0-10)', fontsize=11)
axes[0].set_ylabel('Store Listing Conversion Rate', fontsize=11)
axes[0].set_title('Conversion Rate vs Quality Score\n(Size/Color: Active Devices)', fontsize=12, fontweight='bold')

# Add trend line
z1 = np.polyfit(quality_data['quality_score'], quality_data['store_listing_conversion_rate'], 2)
p1 = np.poly1d(z1)
xp = np.linspace(quality_data['quality_score'].min(), quality_data['quality_score'].max(), 100)
axes[0].plot(xp, p1(xp), 'r-', linewidth=2, label='Quadratic Trend')

# Plot 2: Conversion Rate vs Crash Rate
scatter2 = axes[1].scatter(quality_data['crash_rate_per_1k'], quality_data['store_listing_conversion_rate'],
                           c=quality_data['revenue_per_active_device'], cmap='plasma', alpha=0.7, s=50)
axes[1].set_xlabel('Crash Rate per 1k Sessions', fontsize=11)
axes[1].set_ylabel('Store Listing Conversion Rate', fontsize=11)
axes[1].set_title('Conversion Rate vs Crash Rate\n(Size/Color: Revenue per Active Device)', fontsize=12, fontweight='bold')

# Add trend line
z2 = np.polyfit(quality_data['crash_rate_per_1k'], quality_data['store_listing_conversion_rate'], 2)
p2 = np.poly1d(z2)
xp2 = np.linspace(quality_data['crash_rate_per_1k'].min(), quality_data['crash_rate_per_1k'].max(), 100)
axes[1].plot(xp2, p2(xp2), 'r-', linewidth=2, label='Quadratic Trend')

# Add colorbars
cbar1 = fig.colorbar(scatter1, ax=axes[0])
cbar1.set_label('Active Devices (Last 30 Days)')
cbar2 = fig.colorbar(scatter2, ax=axes[1])
cbar2.set_label('Revenue per Active Device')

axes[0].legend()
axes[1].legend()
plt.tight_layout()
plt.savefig('conversion_quality_relationship.png', dpi=300)
print("Saved conversion_quality_relationship.png")

# 3. Visualize: Multi-dimensional user value decay model
print("\nCreating visualization 3: Multi-dimensional user value decay...")

# Calculate user value decay proxy
# We'll use revenue per active device over time as proxy for user value
query = """
SELECT 
    date_day,
    revenue_per_active_device,
    active_devices,
    daily_installs,
    daily_uninstalls,
    daily_churn_rate,
    quality_score,
    crash_rate_per_1k
FROM google_play__time_series_trends
WHERE date_day >= DATE('2024-04-01')
ORDER BY date_day
"""
user_value_data = pd.read_sql_query(query, conn)
user_value_data['date_day'] = pd.to_datetime(user_value_data['date_day'])

# Create a user value score (composite metric)
user_value_data['user_value_score'] = (
    user_value_data['revenue_per_active_device'] * 0.4 +
    (10 - user_value_data['crash_rate_per_1k']) * 0.3 +
    user_value_data['quality_score'] * 0.3
)

# Plot 3D surface or 2D projection
fig = plt.figure(figsize=(14, 6))

# Plot 1: User value decay over time
ax1 = fig.add_subplot(1, 2, 1)
ax1.plot(user_value_data['date_day'], user_value_data['user_value_score'], 
         marker='o', markersize=3, linewidth=1.5, color='blue', label='User Value Score')
ax1.plot(user_value_data['date_day'], user_value_data['revenue_per_active_device'] * 10,  # Scaled for comparison
         marker='s', markersize=3, linewidth=1.5, color='red', alpha=0.5, label='Revenue per Device (scaled)')
ax1.set_xlabel('Date')
ax1.set_ylabel('Score / Scaled Metric')
ax1.set_title('User Value Decay Over Time', fontsize=12, fontweight='bold')
ax1.legend()
ax1.grid(True, alpha=0.3)
ax1.tick_params(axis='x', rotation=45)

# Plot 2: Churn vs User Value
ax2 = fig.add_subplot(1, 2, 2)
scatter = ax2.scatter(user_value_data['daily_churn_rate'], user_value_data['user_value_score'],
                      c=user_value_data['date_day'].dt.month, cmap='viridis', alpha=0.7, s=50)
ax2.set_xlabel('Daily Churn Rate')
ax2.set_ylabel('User Value Score')
ax2.set_title('User Value Score vs Churn Rate\n(Color: Month)', fontsize=12, fontweight='bold')
cbar = fig.colorbar(scatter, ax=ax2)
cbar.set_label('Month')

plt.tight_layout()
plt.savefig('user_value_decay_model.png', dpi=300)
print("Saved user_value_decay_model.png")

# 4. Visualize: Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
print("\nCreating visualization 4: App update frequency effects...")

# Get device-level data with updates
query = """
SELECT 
    dr.date_day,
    dr.device,
    dr.active_devices_last_30_days,
    dr.rolling_total_average_rating,
    dr.update_events,
    cr.store_listing_conversion_rate,
    ts.quality_score
FROM google_play__device_report dr
JOIN google_play__time_series_trends ts ON dr.date_day = ts.date_day
JOIN google_play__country_report cr ON dr.date_day = cr.date_day AND cr.country_short = 'US'
WHERE dr.date_day >= DATE('2024-04-01')
  AND dr.update_events > 0
"""
update_data = pd.read_sql_query(query, conn)
update_data['date_day'] = pd.to_datetime(update_data['date_day'])

# Aggregate by month and device
update_data['month'] = update_data['date_day'].dt.to_period('M')
update_summary = update_data.groupby(['device', 'month']).agg({
    'update_events': 'sum',
    'active_devices_last_30_days': 'mean',
    'rolling_total_average_rating': 'mean',
    'store_listing_conversion_rate': 'mean',
    'quality_score': 'mean'
}).reset_index()

# Select top 6 devices for clarity
top_devices = update_summary.groupby('device')['update_events'].sum().nlargest(6).index.tolist()
update_summary_top = update_summary[update_summary['device'].isin(top_devices)]

# Create 2x2 grid plot
fig, axes = plt.subplots(2, 2, figsize=(14, 10))

# Plot 1: Update events vs Active Devices (scatter)
for device in top_devices:
    device_data = update_summary_top[update_summary_top['device'] == device]
    axes[0, 0].scatter(device_data['update_events'], device_data['active_devices_last_30_days'], 
                      label=device, s=100, alpha=0.7)
axes[0, 0].set_xlabel('Total Update Events (Monthly)')
axes[0, 0].set_ylabel('Avg Active Devices (Last 30 Days)')
axes[0, 0].set_title('Update Frequency vs Active Devices\nby Device Type', fontsize=12, fontweight='bold')
axes[0, 0].legend(loc='best', fontsize=9)
axes[0, 0].grid(True, alpha=0.3)

# Plot 2: Update events vs Average Rating
for device in top_devices:
    device_data = update_summary_top[update_summary_top['device'] == device]
    axes[0, 1].scatter(device_data['update_events'], device_data['rolling_total_average_rating'],
                      label=device, s=100, alpha=0.7)
axes[0, 1].set_xlabel('Total Update Events (Monthly)')
axes[0, 1].set_ylabel('Avg Rolling Total Rating')
axes[0, 1].set_title('Update Frequency vs User Ratings\nby Device Type', fontsize=12, fontweight='bold')
axes[0, 1].legend(loc='best', fontsize=9)
axes[0, 1].grid(True, alpha=0.3)

# Plot 3: Update trends over time (line plot)
for device in top_devices:
    device_data = update_summary_top[update_summary_top['device'] == device]
    axes[1, 0].plot(device_data['month'].astype(str), device_data['update_events'], 
                   marker='o', linewidth=2, label=device)
axes[1, 0].set_xlabel('Month')
axes[1, 0].set_ylabel('Update Events')
axes[1, 0].set_title('Monthly Update Events Trend\n(Top 6 Devices)', fontsize=12, fontweight='bold')
axes[1, 0].tick_params(axis='x', rotation=45)
axes[1, 0].legend(loc='best', fontsize=9)
axes[1, 0].grid(True, alpha=0.3)

# Plot 4: Correlation matrix heatmap
corr_data = update_summary_top[['update_events', 'active_devices_last_30_days', 
                                'rolling_total_average_rating', 'store_listing_conversion_rate', 
                                'quality_score']].corr()
im = axes[1, 1].imshow(corr_data, cmap='RdYlBu', vmin=-1, vmax=1, aspect='auto')
axes[1, 1].set_xticks(range(len(corr_data.columns)))
axes[1, 1].set_xticklabels(corr_data.columns, rotation=45, ha='right')
axes[1, 1].set_yticks(range(len(corr_data.columns)))
axes[1, 1].set_yticklabels(corr_data.columns)
axes[1, 1].set_title('Correlation: Update Events vs Performance Metrics', fontsize=12, fontweight='bold')

# Add correlation values
for i in range(len(corr_data.columns)):
    for j in range(len(corr_data.columns)):
        text = axes[1, 1].text(j, i, f'{corr_data.iloc[i, j]:.2f}', 
                              ha='center', va='center', color='black', fontsize=9)

plt.colorbar(im, ax=axes[1, 1])
plt.tight_layout()
plt.savefig('update_frequency_effects.png', dpi=300)
print("Saved update_frequency_effects.png")

# 5. Additional visualization: Revenue per active device optimization strategies
print("\nCreating visualization 5: Revenue optimization strategies...")

# Analyze revenue per active device across regions and over time
query = """
SELECT 
    cr.date_day,
    cr.region,
    cr.store_listing_conversion_rate,
    cr.active_devices_last_30_days,
    ts.revenue_per_active_device,
    ts.quality_score,
    ts.crash_rate_per_1k,
    ts.daily_install_uninstall_ratio
FROM google_play__country_report cr
JOIN google_play__time_series_trends ts ON cr.date_day = ts.date_day
WHERE cr.date_day >= DATE('2024-04-01')
"""
revenue_data = pd.read_sql_query(query, conn)
revenue_data['date_day'] = pd.to_datetime(revenue_data['date_day'])

# Market maturity classification based on active devices growth
revenue_data['month'] = revenue_data['date_day'].dt.to_period('M')
market_maturity = revenue_data.groupby(['region', 'month']).agg({
    'active_devices_last_30_days': 'sum',
    'revenue_per_active_device': 'mean',
    'store_listing_conversion_rate': 'mean'
}).reset_index()

# Calculate growth rate
market_maturity['device_growth'] = market_maturity.groupby('region')['active_devices_last_30_days'].pct_change()
market_maturity['maturity'] = pd.qcut(market_maturity['device_growth'].fillna(0), 
                                     q=3, labels=['Declining', 'Stable', 'Growing'])

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Plot 1: Revenue per device by market maturity
for maturity in ['Declining', 'Stable', 'Growing']:
    subset = market_maturity[market_maturity['maturity'] == maturity]
    axes[0].scatter(subset['store_listing_conversion_rate'], subset['revenue_per_active_device'],
                   label=maturity, alpha=0.7, s=80)

axes[0].set_xlabel('Store Listing Conversion Rate')
axes[0].set_ylabel('Revenue per Active Device')
axes[0].set_title('Revenue Optimization by Market Maturity', fontsize=12, fontweight='bold')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# Plot 2: Time series of revenue per device by region
for region in revenue_data['region'].unique():
    region_data = revenue_data[revenue_data['region'] == region]
    region_monthly = region_data.groupby('month')['revenue_per_active_device'].mean().reset_index()
    axes[1].plot(region_monthly['month'].astype(str), region_monthly['revenue_per_active_device'],
                marker='o', linewidth=2, label=region)

axes[1].set_xlabel('Month')
axes[1].set_ylabel('Revenue per Active Device')
axes[1].set_title('Revenue per Device Trend by Region', fontsize=12, fontweight='bold')
axes[1].tick_params(axis='x', rotation=45)
axes[1].legend()
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('revenue_optimization_strategies.png', dpi=300)
print("Saved revenue_optimization_strategies.png")

conn.close()
print("\nAll visualizations created successfully!")
```

