```
import sqlite3
import pandas as pd
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-034.sqlite')

# Load categories
cats = pd.read_sql('SELECT sku_id, "Level 1 Category Name" FROM attachment_4', conn)

# Load discounted sales
query = """
SELECT 
    a.sku_id,
    a."SKU Quantity" as quantity,
    a."SKU Price" as original_price,
    a."SKU Selling Price" as selling_price,
    a."create_dt" as order_date
FROM attachment_1 a
WHERE a."SKU Selling Price" < a."SKU Price"
UNION ALL
SELECT 
    b.sku_id,
    b."SKU Quantity",
    b."SKU Price",
    b."SKU Selling Price",
    b."create_dt"
FROM attachment_2 b
WHERE b."SKU Selling Price" < b."SKU Price"
"""
sales = pd.read_sql(query, conn)
print(f"Discounted sales rows: {len(sales)}")

# Merge with categories
sales = sales.merge(cats, on='sku_id', how='left')

# Compute discount depth
sales['discount_depth'] = (sales['original_price'] - sales['selling_price']) / sales['original_price']
# Remove any outliers (discount depth >1 or <=0)
sales = sales[(sales['discount_depth'] > 0) & (sales['discount_depth'] <= 1)]

# Create discount buckets
bins = [0, 0.05, 0.1, 0.15, 0.2, 0.3, 0.5, 1.0]
labels = ['0-5%','5-10%','10-15%','15-20%','20-30%','30-50%','>50%']
sales['discount_bucket'] = pd.cut(sales['discount_depth'], bins=bins, labels=labels, include_lowest=True)

# Compute revenue per line
sales['revenue'] = sales['selling_price'] * sales['quantity']

# Group by category and bucket
grouped = sales.groupby(['Level 1 Category Name', 'discount_bucket']).agg(
    total_quantity=('quantity', 'sum'),
    total_revenue=('revenue', 'sum'),
    avg_discount_depth=('discount_depth', 'mean'),
    transaction_count=('sku_id', 'count')
).reset_index()
grouped = grouped.sort_values(['Level 1 Category Name', 'discount_bucket'])
print("Aggregated data:")
print(grouped.head(20))

# Save to CSV
grouped.to_csv('category_discount_aggregated.csv', index=False)

# Compute overall stats per category
category_stats = sales.groupby('Level 1 Category Name').agg(
    total_quantity=('quantity', 'sum'),
    total_revenue=('revenue', 'sum'),
    avg_discount_depth=('discount_depth', 'mean'),
    total_transactions=('sku_id', 'count'),
    unique_skus=('sku_id', 'nunique')
).reset_index()
category_stats = category_stats.sort_values('total_quantity', ascending=False)
print("\nCategory-level stats:")
print(category_stats)

# Compute correlation between discount depth and quantity per category using numpy
correlations = []
for cat in sales['Level 1 Category Name'].dropna().unique():
    sub = sales[sales['Level 1 Category Name'] == cat]
    if len(sub) > 10:
        corr = np.corrcoef(sub['discount_depth'], sub['quantity'])[0,1]
        correlations.append({
            'category': cat,
            'correlation': corr,
            'n': len(sub),
            'avg_depth': sub['discount_depth'].mean(),
            'total_quantity': sub['quantity'].sum()
        })
corr_df = pd.DataFrame(correlations).sort_values('correlation', ascending=False)
print("\nCorrelation between discount depth and quantity sold per category:")
print(corr_df)

# Simple linear regression per category (elasticity)
def simple_regression(x, y):
    # returns slope, intercept
    A = np.vstack([x, np.ones(len(x))]).T
    m, c = np.linalg.lstsq(A, y, rcond=None)[0]
    return m, c

elasticities = []
for cat in sales['Level 1 Category Name'].dropna().unique():
    sub = sales[sales['Level 1 Category Name'] == cat]
    if len(sub) > 10:
        x = sub['discount_depth'].values
        y = sub['quantity'].values
        slope, intercept = simple_regression(x, y)
        # Elasticity = slope * (avg_discount_depth / avg_quantity)
        avg_depth = sub['discount_depth'].mean()
        avg_qty = sub['quantity'].mean()
        if avg_qty != 0:
            elasticity = slope * (avg_depth / avg_qty)
        else:
            elasticity = np.nan
        # R-squared
        y_pred = slope * x + intercept
        ss_res = np.sum((y - y_pred) ** 2)
        ss_tot = np.sum((y - np.mean(y)) ** 2)
        r_squared = 1 - (ss_res / ss_tot) if ss_tot != 0 else np.nan
        elasticities.append({
            'category': cat,
            'elasticity': elasticity,
            'slope': slope,
            'r_squared': r_squared,
            'avg_depth': avg_depth,
            'avg_quantity': avg_qty,
            'n': len(sub)
        })
elasticity_df = pd.DataFrame(elasticities).sort_values('elasticity', ascending=False)
print("\nElasticity estimates (discount depth vs quantity):")
print(elasticity_df)

# Also compute average discount depth per category and total sales
sales_by_cat = sales.groupby('Level 1 Category Name').agg(
    avg_discount=('discount_depth', 'mean'),
    total_quantity=('quantity', 'sum'),
    total_revenue=('revenue', 'sum')
).reset_index()
sales_by_cat = sales_by_cat.sort_values('total_quantity', ascending=False)
print("\nSales by Category:")
print(sales_by_cat)

# Save correlation and elasticity data
corr_df.to_csv('category_correlation.csv', index=False)
elasticity_df.to_csv('category_elasticity.csv', index=False)

conn.close()
```

