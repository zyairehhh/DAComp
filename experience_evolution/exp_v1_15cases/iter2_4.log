print('Overall average CVR:', overall_cvr)
print('Total spend for problematic groups: ${:.2f}'.format(problematic['spend'].sum()))
print('Average intent match ratio for problematic groups: {:.3f}'.format((problematic['CVR']/overall_cvr).mean()))
