import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-067.sqlite')

df = pd.read_sql_query("""
SELECT tps.source_name, ae.candidate_gender, ae.candidate_race, COUNT(DISTINCT cs.candidate_id) as hire_count
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
GROUP BY tps.source_name, ae.candidate_gender, ae.candidate_race
""", conn)

# Clean gender: treat None as unknown
df['candidate_gender'] = df['candidate_gender'].fillna('Unknown')
df['candidate_race'] = df['candidate_race'].fillna('Unknown')

print(df.head())

# Pivot for gender
gender_pivot = df.pivot_table(index='source_name', columns='candidate_gender', values='hire_count', aggfunc='sum', fill_value=0)
print(gender_pivot.columns)
gender_pivot['total_hires'] = gender_pivot.sum(axis=1)
# Ensure female column exists
if 'female' in gender_pivot.columns:
    female_hires = gender_pivot['female']
else:
    female_hires = 0
if 'male' in gender_pivot.columns:
    male_hires = gender_pivot['male']
else:
    male_hires = 0

gender_pivot['female_rep'] = female_hires / gender_pivot['total_hires'] * 100
gender_pivot['male_rep'] = male_hires / gender_pivot['total_hires'] * 100
print("\nGender representation per source:")
print(gender_pivot[['total_hires','female_rep','male_rep']])

# Race: white vs non-white
# Determine white vs non-white from candidate_race
# We'll map race to white or non-white
race_map = {
    'White': 'white',
    'Asian': 'non-white',
    'Black': 'non-white',
    'Hispanic': 'non-white',
    'Native American': 'non-white',
    'Two or more races': 'non-white',
    'Unknown': 'unknown'
}
def map_race(r):
    if r in race_map:
        return race_map[r]
    else:
        return 'non-white'  # default

df['race_group'] = df['candidate_race'].apply(map_race)

race_pivot = df.pivot_table(index='source_name', columns='race_group', values='hire_count', aggfunc='sum', fill_value=0)
race_pivot['total_hires'] = race_pivot.sum(axis=1)
if 'white' in race_pivot.columns:
    white_hires = race_pivot['white']
else:
    white_hires = 0
if 'non-white' in race_pivot.columns:
    nonwhite_hires = race_pivot['non-white']
else:
    nonwhite_hires = 0

race_pivot['white_rep'] = white_hires / race_pivot['total_hires'] * 100
race_pivot['non_white_rep'] = nonwhite_hires / race_pivot['total_hires'] * 100
print("\nRace representation per source:")
print(race_pivot[['total_hires','white_rep','non_white_rep']])

target_female = 40
target_nonwhite = 30

gender_pivot['meets_female'] = gender_pivot['female_rep'] >= target_female
race_pivot['meets_nonwhite'] = race_pivot['non_white_rep'] >= target_nonwhite

print("\nDiversity compliance:")
for source in gender_pivot.index:
    female_rep = gender_pivot.loc[source,'female_rep']
    meets_f = gender_pivot.loc[source,'meets_female']
    nonwhite_rep = race_pivot.loc[source,'non_white_rep']
    meets_nw = race_pivot.loc[source,'meets_nonwhite']
    print(f"{source}: Female {female_rep:.1f}% ({'meets' if meets_f else 'fails'}), Non-white {nonwhite_rep:.1f}% ({'meets' if meets_nw else 'fails'})")
