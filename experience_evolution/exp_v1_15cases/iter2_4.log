Action: CreateFile(filepath='language_region_analysis.py':
'''
import pandas as pd
import numpy as np

df = pd.read_csv('contact_with_tiers.csv')
# Language distribution per tier
lang = pd.crosstab(df['value_tier'], df['language'], normalize='index') * 100
print("Language distribution per tier (%):")
print(lang.round(2))
print()
# Directory distribution
dir_tab = pd.crosstab(df['value_tier'], df['directory_name'], normalize='index') * 100
print("Directory distribution per tier (%):")
print(dir_tab.round(2))
print()
# Compute transition likelihood: proportion of high tier within each language group
lang_high = df.groupby('language')['value_tier'].apply(lambda x: (x == 'high').mean() * 100).sort_values(ascending=False)
print("Percentage of users that are high-tier per language:")
print(lang_high.round(2))
print()
# Same for directory
dir_high = df.groupby('directory_name')['value_tier'].apply(lambda x: (x == 'high').mean() * 100).sort_values(ascending=False)
print("Percentage of users that are high-tier per directory:")
print(dir_high.round(2))
print()
# Also compute medium-to-high transition: among users not low, what proportion are high?
df_not_low = df[df['value_tier'] != 'low']
trans = df_not_low.groupby('language')['value_tier'].apply(lambda x: (x == 'high').mean() * 100).sort_values(ascending=False)
print("Among non-low users, percentage high-tier per language:")
print(trans.round(2))
''')
