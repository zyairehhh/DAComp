Action: CreateFile(filepath="visualize.py"):
```python
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# Load ad group report data
df = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)
conn.close()

# Compute metrics
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks'].replace(0, np.nan)  # avoid division by zero

# Remove rows where CTR or CVR cannot be computed (NaN)
df_clean = df.dropna(subset=['CTR', 'CVR'])

# Compute percentiles
ctr_75 = df_clean['CTR'].quantile(0.75)
cvr_25 = df_clean['CVR'].quantile(0.25)

print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# Identify problematic ad groups
problematic = df_clean[(df_clean['CTR'] > ctr_75) & (df_clean['CVR'] < cvr_25)]
print(f"Number of problematic ad groups: {len(problematic)}")

# Save problematic ad groups for reference
problematic.to_csv('problematic_ad_groups.csv', index=False)

# For Intent Match Ratio, we need expected CVR. Since not in data, we can compute average CVR per ad group type or status as proxy.
# Let's compute average CVR per ad_group_type as expected CVR
if 'ad_group_type' in df_clean.columns:
    expected_cvr = df_clean.groupby('ad_group_type')['CVR'].mean().reset_index()
    expected_cvr.rename(columns={'CVR': 'expected_CVR'}, inplace=True)
    df_clean = df_clean.merge(expected_cvr, on='ad_group_type', how='left')
    df_clean['Intent_Match_Ratio'] = df_clean['CVR'] / df_clean['expected_CVR'].replace(0, np.nan)
    # For problematic groups, compute average intent match ratio
    problematic = df_clean[(df_clean['CTR'] > ctr_75) & (df_clean['CVR'] < cvr_25)]
    avg_imr = problematic['Intent_Match_Ratio'].mean()
    print(f"Average Intent Match Ratio for problematic groups: {avg_imr:.4f}")
```

