import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect("dacomp-058.sqlite")

# Load geo_report
geo_df = pd.read_sql_query("SELECT * FROM google_ads__geo_report", conn)
print("Geo report shape:", geo_df.shape)

# Count distinct geo_target per campaign
geo_summary = geo_df.groupby(['campaign_id', 'year_month']).agg(
    geo_count=('geo_target', 'nunique'),
    avg_imp_share=('impression_share', 'mean'),
    avg_ctr=('ctr', 'mean')
).reset_index()

# Load device_report
device_df = pd.read_sql_query("SELECT * FROM google_ads__device_report", conn)
print("Device report shape:", device_df.shape)
device_summary = device_df.groupby(['campaign_id', 'year_month']).agg(
    device_count=('device_type', 'nunique'),
    avg_ctr_device=('ctr', 'mean')
).reset_index()

# Load filtered campaigns with scores
df_filtered = pd.read_csv('filtered_campaigns_with_scores.csv')

# Merge with geo_summary and device_summary
df_enriched = df_filtered.merge(geo_summary, on=['campaign_id', 'year_month'], how='left')
df_enriched = df_enriched.merge(device_summary, on=['campaign_id', 'year_month'], how='left')

print("\nEnriched data shape:", df_enriched.shape)

# Analyze by geo count categories
geo_bins = pd.cut(df_enriched['geo_count'], bins=[0, 1, 5, 10, 100], labels=['1', '2-5', '6-10', '>10'])
df_enriched['geo_bin'] = geo_bins
geo_analysis = df_enriched.groupby('geo_bin').agg(
    count=('campaign_id', 'size'),
    avg_health=('health_score', 'mean'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean')
).reset_index()
print("\n=== Performance by number of geo targets ===")
print(geo_analysis)

# Analyze by device count
device_bins = pd.cut(df_enriched['device_count'], bins=[0, 1, 2, 3], labels=['1', '2', '3'])
df_enriched['device_bin'] = device_bins
device_analysis = df_enriched.groupby('device_bin').agg(
    count=('campaign_id', 'size'),
    avg_health=('health_score', 'mean'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean')
).reset_index()
print("\n=== Performance by number of device types ===")
print(device_analysis)

# Look at specific geo_target patterns: we need to aggregate across all rows
geo_target_agg = geo_df.groupby('geo_target').agg(
    total_cost=('cost', 'sum'),
    total_conversions=('conversions', 'sum'),
    avg_roas=('roas', 'mean'),
    avg_ctr=('ctr', 'mean')
).reset_index().sort_values('total_cost', ascending=False)
print("\nTop 10 geo_target by total cost:")
print(geo_target_agg.head(10))

# Device type breakdown
device_agg = device_df.groupby('device_type').agg(
    total_cost=('cost', 'sum'),
    total_conversions=('conversions', 'sum'),
    avg_roas=('roas', 'mean'),
    avg_ctr=('ctr', 'mean')
).reset_index().sort_values('total_cost', ascending=False)
print("\nPerformance by device type:")
print(device_agg)

conn.close()
```
