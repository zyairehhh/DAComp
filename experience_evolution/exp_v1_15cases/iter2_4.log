import pandas as pd
import sqlite3
conn = sqlite3.connect('dacomp-067.sqlite')

# Get source performance
df_source = pd.read_sql_query("""
SELECT source_name, source_type, total_applications, total_hires, hire_rate, avg_process_days, interview_rate, interview_to_hire_rate, efficiency_score
FROM greenhouse__talent_pipeline_simplified
""", conn)

print("Source performance summary:")
print(df_source)

# Compute current total hires and costs
cost_per_hire = {
    'agency': 20000,
    'direct': 200,
    'job_board': 1000,
    'referral': 5000,
    'social_media': 500,
    'university': 8000
}

df_source['cost'] = df_source['source_type'].map(cost_per_hire)
df_source['total_cost'] = df_source['total_hires'] * df_source['cost']

print("\nCost breakdown:")
print(df_source[['source_name', 'source_type', 'total_hires', 'cost', 'total_cost']])

total_current_cost = df_source['total_cost'].sum()
print(f"\nTotal current recruitment cost: ${total_current_cost:,.2f}")

# Compute per source: female hire representation and non-white representation
# Use application_enhanced to compute diversity per source_id mapping
df_diversity = pd.read_sql_query("""
SELECT a.source_id, a.candidate_gender, a.candidate_race, a.status
FROM greenhouse__application_enhanced a
WHERE a.candidate_gender IS NOT NULL AND a.candidate_race IS NOT NULL
""", conn)

# Merge with source_type
df_source_id = pd.read_sql_query("SELECT source_id, source_name FROM greenhouse__talent_pipeline_simplified", conn)
df_diversity = df_diversity.merge(df_source_id, on='source_id', how='left')
df_diversity = df_diversity.dropna(subset=['source_name'])

# Compute diversity per source_type
df_diversity['female'] = df_diversity['candidate_gender'] == 'Female'
df_diversity['non_white'] = df_diversity['candidate_race'] != 'White'
df_diversity['hired'] = df_diversity['status'] == 'hired'

grouped = df_diversity.groupby('source_name').agg(
    total_hires_with_data=('hired', 'sum'),
    female_hires=('female', lambda x: (x & df_diversity['hired']).sum()),
    non_white_hires=('non_white', lambda x: (x & df_diversity['hired']).sum())
).reset_index()

grouped = grouped.merge(df_source[['source_name','source_type']], on='source_name')
grouped['female_rep'] = grouped['female_hires'] / grouped['total_hires_with_data']
grouped['non_white_rep'] = grouped['non_white_hires'] / grouped['total_hires_with_data']

print("\nDiversity per source (among hires with gender/race data):")
print(grouped)

# Interviewer satisfaction per source
# Use interview_scorecard_detail and application_enhanced
df_satisfaction = pd.read_sql_query("""
SELECT a.source_id, d.rating
FROM greenhouse__interview_scorecard_detail d
JOIN greenhouse__application_enhanced a ON d.application_id = a.application_id
WHERE d.rating IS NOT NULL
""", conn)

df_satisfaction = df_satisfaction.merge(df_source_id, on='source_id', how='left')
df_satisfaction = df_satisfaction.dropna(subset=['source_name'])
avg_rating = df_satisfaction.groupby('source_name')['rating'].mean()
print("\nAverage interviewer rating per source:")
print(avg_rating)

# Determine which sources meet satisfaction > 4? None as rating ~2.7.
# We need to improve satisfaction overall, maybe by optimizing interview process.

# Compute stage retention rates (funnel)
# We'll compute total applications that reach each stage
# Assume each application has current_job_stage indicating furthest stage reached.
# Not accurate but approximate.

df_stage = pd.read_sql_query("""
SELECT current_job_stage, COUNT(*) as cnt
FROM greenhouse__application_enhanced
WHERE current_job_stage IS NOT NULL
GROUP BY current_job_stage
ORDER BY CASE current_job_stage
    WHEN 'Application Review' THEN 1
    WHEN 'Phone Screen' THEN 2
    WHEN 'Technical Interview' THEN 3
    WHEN 'Panel Interview' THEN 4
    WHEN 'Final Interview' THEN 5
    WHEN 'Offer' THEN 6
END
""", conn)

print("\nStage funnel (total applications per stage):")
print(df_stage)

# Compute drop-off rates
df_stage['drop_off'] = 1 - df_stage['cnt'] / df_stage['cnt'].iloc[0]
df_stage['retention'] = df_stage['cnt'] / df_stage['cnt'].iloc[0]
print("\nFunnel (starting from Application Review):")
print(df_stage[['current_job_stage', 'cnt', 'retention', 'drop_off']])
```

