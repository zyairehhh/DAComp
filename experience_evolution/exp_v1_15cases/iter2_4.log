```python
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-067.sqlite')

# Get source metrics from talent_pipeline_simplified
df_source = pd.read_sql_query("""
SELECT source_id, source_name, hire_rate, interview_rate, interview_to_hire_rate, avg_process_days, efficiency_score
FROM greenhouse__talent_pipeline_simplified
""", conn)

# Get avg quality per source
df_quality = pd.read_sql_query("""
SELECT tps.source_name, AVG(cs.candidate_quality_score) as avg_quality
FROM greenhouse__application_enhanced ae
JOIN greenhouse__candidate_summary cs ON ae.candidate_id = cs.candidate_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE cs.hired_count >= 1
GROUP BY tps.source_name
""", conn)

# Get avg rating per source
df_rating = pd.read_sql_query("""
SELECT tps.source_name, AVG(scd.rating) as avg_rating
FROM greenhouse__interview_scorecard_detail scd
JOIN greenhouse__interview_enhanced ie ON scd.scorecard_id = ie.scorecard_id
JOIN greenhouse__application_enhanced ae ON ie.application_id = ae.application_id
JOIN greenhouse__talent_pipeline_simplified tps ON ae.source_id = tps.source_id
WHERE scd.rating IS NOT NULL
GROUP BY tps.source_name
""", conn)

# Merge
df = df_source.merge(df_quality, on='source_name', how='left')
df = df.merge(df_rating, on='source_name', how='left')

# Fill missing values with median
df['avg_quality'] = df['avg_quality'].fillna(df['avg_quality'].median())
df['avg_rating'] = df['avg_rating'].fillna(df['avg_rating'].median())

print(df)

# Normalize metrics (higher is better)
def min_max_scale(series):
    if series.max() == series.min():
        return pd.Series([0.5]*len(series), index=series.index)
    return (series - series.min()) / (series.max() - series.min())

df['hire_rate_norm'] = min_max_scale(df['hire_rate'])
df['interview_rate_norm'] = min_max_scale(df['interview_rate'])
df['interview_to_hire_rate_norm'] = min_max_scale(df['interview_to_hire_rate'])
df['efficiency_score_norm'] = min_max_scale(df['efficiency_score'])
df['avg_quality_norm'] = min_max_scale(df['avg_quality'])
df['avg_rating_norm'] = min_max_scale(df['avg_rating'])
df['process_speed_norm'] = min_max_scale(1 / (df['avg_process_days'] + 1))

# Weighted composite index
weights = {
    'hire_rate': 0.25,
    'interview_rate': 0.1,
    'interview_to_hire_rate': 0.15,
    'efficiency_score': 0.15,
    'avg_quality': 0.2,
    'avg_rating': 0.1,
    'process_speed': 0.05
}
df['composite_score'] = (
    df['hire_rate_norm'] * weights['hire_rate'] +
    df['interview_rate_norm'] * weights['interview_rate'] +
    df['interview_to_hire_rate_norm'] * weights['interview_to_hire_rate'] +
    df['efficiency_score_norm'] * weights['efficiency_score'] +
    df['avg_quality_norm'] * weights['avg_quality'] +
    df['avg_rating_norm'] * weights['avg_rating'] +
    df['process_speed_norm'] * weights['process_speed']
)

# Add cost proxy: assume cost per hire inversely related to composite score? We'll create a cost index based on typical categories.
cost_map = {
    'Headhunter': 5,  # high
    'University Recruiting': 2,  # medium (travel, events)
    'Employee Referral': 1,  # low (bonus)
    'LinkedIn': 3,
    'Indeed': 3,
    'Glassdoor': 3,
    'AngelList': 3,
    'Company Website': 1  # low (organic)
}
df['cost_index'] = df['source_name'].map(cost_map)
df['cost_weighted_score'] = df['composite_score'] / df['cost_index']  # higher means more cost-effective

print(df[['source_name', 'hire_rate', 'avg_process_days', 'avg_quality', 'avg_rating', 'composite_score', 'cost_index', 'cost_weighted_score']].sort_values('cost_weighted_score', ascending=False))

# Save to CSV
df.to_csv('source_composite.csv', index=False)
print("Saved to source_composite.csv")
```

