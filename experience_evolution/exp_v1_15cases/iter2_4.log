'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-035.sqlite')

# Load tables
abnormal = pd.read_sql_query('SELECT * FROM abnormal_logins_table', conn)
login = pd.read_sql_query('SELECT * FROM login_records_table', conn)
user = pd.read_sql_query('SELECT * FROM user_information_table', conn)
conn.close()

# Merge to get department for each login
login_user = login.merge(user[['User ID', 'Department']], on='User ID', how='left')

# Merge abnormal with login to get department for each abnormal login
abnormal_login = abnormal.merge(login_user[['Login Record ID', 'Department']], on='Login Record ID', how='left')

# Compute total users per department
user_counts = user.groupby('Department').size().reset_index(name='total_users')

# Compute total logins per department
login_counts = login_user.groupby('Department')['Login Record ID'].nunique().reset_index(name='total_logins')

# Compute abnormal logins per department
abnormal_counts = abnormal_login.groupby('Department')['Anomaly ID'].nunique().reset_index(name='abnormal_logins')

# Merge
metrics = login_counts.merge(abnormal_counts, on='Department', how='left')
metrics = metrics.merge(user_counts, on='Department', how='left')
metrics['abnormal_rate'] = metrics['abnormal_logins'] / metrics['total_logins'] * 100

# Confirmed abnormal %
confirmed = abnormal_login[abnormal_login['Confirmation Status'] == 'Confirmed'].groupby('Department')['Anomaly ID'].nunique().reset_index(name='confirmed_abnormal')
metrics = metrics.merge(confirmed, on='Department', how='left')
metrics['confirmed_abnormal_pct'] = metrics['confirmed_abnormal'] / metrics['abnormal_logins'] * 100

# High-risk abnormal %
high_risk = abnormal_login[abnormal_login['Risk Level'].isin(['Severe', 'High'])].groupby('Department')['Anomaly ID'].nunique().reset_index(name='high_risk_abnormal')
metrics = metrics.merge(high_risk, on='Department', how='left')
metrics['high_risk_abnormal_pct'] = metrics['high_risk_abnormal'] / metrics['abnormal_logins'] * 100

# Remote login %
remote = abnormal_login[abnormal_login['Anomaly Type'] == 'Remote Login'].groupby('Department')['Anomaly ID'].nunique().reset_index(name='remote_abnormal')
metrics = metrics.merge(remote, on='Department', how='left')
metrics['remote_login_pct'] = metrics['remote_abnormal'] / metrics['abnormal_logins'] * 100

# High-risk user %
# For each department, count distinct users who have at least one high-risk abnormal login
abnormal_high_risk = abnormal_login[abnormal_login['Risk Level'].isin(['Severe', 'High'])]
high_risk_users = abnormal_high_risk.groupby('Department')['User ID'].nunique().reset_index(name='high_risk_user_count')
metrics = metrics.merge(high_risk_users, on='Department', how='left')
metrics['high_risk_user_pct'] = metrics['high_risk_user_count'] / metrics['total_users'] * 100

# Average anomaly score
avg_score = abnormal_login.groupby('Department')['Anomaly Score'].mean().reset_index(name='avg_anomaly_score')
metrics = metrics.merge(avg_score, on='Department', how='left')

# Fill NaN with 0 for missing values (where no abnormal logins)
metrics = metrics.fillna(0)

# Round for readability
for col in ['abnormal_rate', 'confirmed_abnormal_pct', 'high_risk_abnormal_pct', 'remote_login_pct', 'high_risk_user_pct', 'avg_anomaly_score']:
    metrics[col] = metrics[col].round(1)

# Reorder columns
metrics = metrics[['Department', 'total_users', 'total_logins', 'abnormal_logins', 'abnormal_rate',
                   'confirmed_abnormal_pct', 'high_risk_abnormal_pct', 'high_risk_user_pct',
                   'remote_login_pct', 'avg_anomaly_score']]

print(metrics.to_string(index=False))
''')
