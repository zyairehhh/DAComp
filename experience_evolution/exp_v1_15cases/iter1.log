import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import re

conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Filter for vocational school education requirement
voc_df = df[df['Education Requirement'].str.contains('Vocational school', na=False)]

# Parse salary lower bound
def parse_salary_lower(salary_str):
    if pd.isna(salary_str):
        return None
    match = re.search(r'([\d,]+)\s*[-~]', str(salary_str))
    if match:
        num_str = match.group(1).replace(',', '')
        try:
            return float(num_str)
        except:
            return None
    match = re.search(r'([\d,]+)', str(salary_str))
    if match:
        num_str = match.group(1).replace(',', '')
        try:
            return float(num_str)
        except:
            return None
    return None

voc_df['salary_lower'] = voc_df['Salary Range'].apply(parse_salary_lower)
salary_df = voc_df.dropna(subset=['salary_lower'])

# Categorize language requirement
def categorize_language(lang_str):
    if pd.isna(lang_str):
        return 'Unspecified (no requirement)'
    lang = str(lang_str).lower()
    if 'english' in lang and 'proficiency' in lang:
        return 'Proficiency in English required'
    if 'english' in lang and 'good' in lang:
        return 'Good English proficiency required'
    if 'english' in lang:
        return 'English (general)'
    if 'chinese' in lang and 'good' in lang:
        return 'Good Chinese proficiency required'
    # any other explicit requirement?
    if 'other levels require good performance' in lang:
        return 'Other levels require good performance'
    return 'Unspecified (no requirement)'

salary_df['lang_category'] = salary_df['Foreign Language Requirement'].apply(categorize_language)
lang_salary = salary_df.groupby('lang_category')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)

# Keep only categories with count >= 10
lang_salary = lang_salary[lang_salary['count'] >= 10]

plt.figure(figsize=(10, 6))
bars = plt.bar(lang_salary.index, lang_salary['mean'], color='teal')
plt.title('Average Starting Salary by Foreign Language Requirement')
plt.xlabel('Language Requirement')
plt.ylabel('Average Starting Salary (yuan/month)')
plt.xticks(rotation=45, ha='right')
for bar, count in zip(bars, lang_salary['count']):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 50, f'n={count}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('language_vs_salary.png', dpi=300)
plt.close()
print("Language vs salary plot generated.")
