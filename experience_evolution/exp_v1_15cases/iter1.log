import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-060.sqlite')

# Get the same problematic ad groups as before
query = """
SELECT 
    ad_group_id,
    ad_group_name,
    ad_group_type,
    status,
    SUM(spend) as total_spend,
    SUM(clicks) as total_clicks,
    SUM(impressions) as total_impressions,
    SUM(conversions) as total_conversions,
    SUM(conversions_value) as total_conversions_value
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name, ad_group_type, status
HAVING total_impressions > 0 AND total_clicks > 0
"""
ad_groups = pd.read_sql_query(query, conn)
ad_groups['CTR'] = ad_groups['total_clicks'] / ad_groups['total_impressions']
ad_groups['CVR'] = ad_groups['total_conversions'] / ad_groups['total_clicks']
ad_groups['CVR'] = ad_groups['CVR'].replace([np.inf, -np.inf], np.nan)
ad_groups['CPA'] = ad_groups['total_spend'] / ad_groups['total_conversions']
ad_groups['CPA'] = ad_groups['CPA'].replace([np.inf, -np.inf], np.nan)

ctr_75th = ad_groups['CTR'].quantile(0.75)
cvr_25th = ad_groups['CVR'].quantile(0.25)

problematic_ad_groups = ad_groups[
    (ad_groups['CTR'] > ctr_75th) & 
    (ad_groups['CVR'] < cvr_25th) &
    (ad_groups['CVR'].notna())
].copy()

normal_ad_groups = ad_groups[
    ~ad_groups['ad_group_id'].isin(problematic_ad_groups['ad_group_id'])
]

# Visualization: Spend vs Performance Efficiency
plt.figure(figsize=(12, 5))

# Subplot 1: Spend vs CTR
plt.subplot(1, 2, 1)
plt.scatter(normal_ad_groups['total_spend'], normal_ad_groups['CTR'], 
           alpha=0.5, s=30, c='blue', label='Normal Ad Groups')
plt.scatter(problematic_ad_groups['total_spend'], problematic_ad_groups['CTR'], 
           alpha=0.7, s=50, c='red', label='Problematic Ad Groups', edgecolors='w')
plt.xscale('log')  # Log scale for better visibility
plt.xlabel('Total Spend (log scale)')
plt.ylabel('Click-Through Rate (CTR)')
plt.title('Spend vs CTR: Problematic Groups Show High CTR Despite Spend')
plt.legend()
plt.grid(True, alpha=0.3)

# Subplot 2: Spend vs CVR
plt.subplot(1, 2, 2)
valid_normal = normal_ad_groups[normal_ad_groups['CVR'].notna()]
valid_problematic = problematic_ad_groups[problematic_ad_groups['CVR'].notna()]

plt.scatter(valid_normal['total_spend'], valid_normal['CVR'], 
           alpha=0.5, s=30, c='blue', label='Normal Ad Groups')
plt.scatter(valid_problematic['total_spend'], valid_problematic['CVR'], 
           alpha=0.7, s=50, c='red', label='Problematic Ad Groups', edgecolors='w')
plt.xscale('log')  # Log scale for better visibility
plt.xlabel('Total Spend (log scale)')
plt.ylabel('Conversion Rate (CVR)')
plt.title('Spend vs CVR: Problematic Groups Show Low CVR Across Spend Levels')
plt.legend()
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('spend_performance_analysis.png', dpi=300, bbox_inches='tight')
plt.close()

# Calculate some additional statistics
problematic_stats = problematic_ad_groups['total_spend'].describe()
normal_stats = normal_ad_groups['total_spend'].describe()

print("Spend Statistics:")
print(f"Problematic Ad Groups - Mean Spend: ${problematic_stats['mean']:.2f}")
print(f"Normal Ad Groups - Mean Spend: ${normal_stats['mean']:.2f}")
print(f"Problematic Ad Groups - Total Spend: ${problematic_ad_groups['total_spend'].sum():.2f}")
print(f"Normal Ad Groups - Total Spend: ${normal_ad_groups['total_spend'].sum():.2f}")
print(f"Percentage of Total Spend from Problematic Groups: {(problematic_ad_groups['total_spend'].sum() / ad_groups['total_spend'].sum())*100:.2f}%")

# Intent Match Ratio Analysis (Actual CVR / Expected CVR)
# For expected CVR, use overall average CVR from normal groups
overall_avg_cvr = normal_ad_groups['CVR'].mean()
problematic_ad_groups['Intent_Match_Ratio'] = problematic_ad_groups['CVR'] / overall_avg_cvr

# Plot Intent Match Ratio distribution
plt.figure(figsize=(10, 6))
plt.hist(problematic_ad_groups['Intent_Match_Ratio'].dropna(), bins=20, alpha=0.7, color='red', edgecolor='black')
plt.axvline(x=1, color='green', linestyle='--', label='Expected Performance (Ratio = 1)')
plt.xlabel('Intent Match Ratio (Actual CVR / Expected CVR)')
plt.ylabel('Number of Ad Groups')
plt.title('Intent Match Ratio Distribution for Problematic Ad Groups')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('intent_match_ratio.png', dpi=300, bbox_inches='tight')
plt.close()

print(f"\nIntent Match Ratio Analysis:")
print(f"Overall Average CVR (from normal groups): {overall_avg_cvr:.4f}")
print(f"Average Intent Match Ratio for problematic groups: {problematic_ad_groups['Intent_Match_Ratio'].mean():.4f}")
print(f"Number of problematic groups with Intent Match Ratio < 0.5: {(problematic_ad_groups['Intent_Match_Ratio'] < 0.5).sum()}")
print(f"Number of problematic groups with Intent Match Ratio < 0.3: {(problematic_ad_groups['Intent_Match_Ratio'] < 0.3).sum()}")

conn.close()
''')
