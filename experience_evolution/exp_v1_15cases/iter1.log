'''
import sqlite3, re

conn = sqlite3.connect('dacomp-081.sqlite')
cursor = conn.cursor()
cursor.execute("SELECT value, embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL")
cf_stats = {}
for row in cursor.fetchall():
    v = row[0]
    ed = row[1]
    matches = re.findall(r'custom_field_(\d+):value_(\d+)', ed)
    for cf, _ in matches:
        if cf not in cf_stats:
            cf_stats[cf] = {'values': [], 'count': 0}
        cf_stats[cf]['values'].append(v)
        cf_stats[cf]['count'] += 1

print("custom_field_id,count,avg_value,min_value,max_value")
for cf, data in sorted(cf_stats.items(), key=lambda x: x[0]):
    vals = data['values']
    avg = sum(vals)/len(vals)
    mn = min(vals)
    mx = max(vals)
    print(f"{cf},{len(vals)},{avg:.4f},{mn},{mx}")
conn.close()
''')  # We'll output to a CSV file.

