Action: CreateFile(filepath='region_mapping.py':
'''
import pandas as pd
import numpy as np

# Load location data
loc_df = pd.read_csv('response_locations.csv')
print(f"Location records: {len(loc_df)}")
print(loc_df.head())

# Define continent mapping based on lat/lng
# Simplified bounding boxes (not accurate but enough for segmentation)
def continent_from_lat_lng(lat, lng):
    if pd.isna(lat) or pd.isna(lng):
        return 'Unknown'
    # North America
    if (lat > 12 and lat < 72) and (lng > -170 and lng < -52):
        return 'North America'
    # South America
    if (lat > -56 and lat < 13) and (lng > -83 and lng < -34):
        return 'South America'
    # Europe
    if (lat > 36 and lat < 72) and (lng > -25 and lng < 60):
        return 'Europe'
    # Africa
    if (lat > -35 and lat < 37) and (lng > -26 and lng < 60):
        return 'Africa'
    # Asia
    if (lat > -10 and lat < 78) and (lng > 25 and lng < 179):
        return 'Asia'
    # Australia / Oceania
    if (lat > -50 and lat < 0) and (lng > 112 and lng < 180) or (lat > -50 and lat < 0) and (lng > -180 and lng < -120):
        return 'Oceania'
    # Antarctica
    if lat < -60:
        return 'Antarctica'
    return 'Other'

loc_df['region'] = loc_df.apply(lambda row: continent_from_lat_lng(row['location_latitude'], row['location_longitude']), axis=1)

print("\nRegion distribution:")
print(loc_df['region'].value_counts())

# Assign region to each user (most frequent region per email)
user_region = loc_df.groupby('recipient_email')['region'].agg(lambda x: x.mode().iloc[0] if not x.mode().empty else 'Unknown').reset_index()
user_region.columns = ['email', 'region']
user_region.to_csv('user_region.csv', index=False)
print(f"Unique users with region: {len(user_region)}")
''')
