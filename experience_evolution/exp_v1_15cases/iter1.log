import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-041.sqlite')

# Step 1: Get high-traffic halls (average Daily Visitor Count > 900)
query_halls = '''
SELECT "Exhibition Hall Record ID" as hall_id, 
       AVG("Daily Visitor Count") as avg_visitor_count 
FROM gallery_information 
GROUP BY "Exhibition Hall Record ID" 
HAVING avg_visitor_count > 900
'''

high_traffic_halls = pd.read_sql_query(query_halls, conn)
print(f"High-traffic halls found: {len(high_traffic_halls)}")

if len(high_traffic_halls) == 0:
    print("No high-traffic halls found")
    exit()

# Step 2: Get display cases in these halls - fix the query
hall_ids = high_traffic_halls['hall_id'].tolist()
placeholders = ','.join(['?' for _ in hall_ids])

display_cases_query = f'''
SELECT "Display case ID", "Gallery reference" as hall_id
FROM display_case_information 
WHERE "Gallery reference" IN ({placeholders})
'''

display_cases = pd.read_sql_query(display_cases_query, conn, params=hall_ids)
print(f"Display cases in high-traffic halls: {len(display_cases)}")

