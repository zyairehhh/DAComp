    promotion_price,
    (pdj_price - promotion_price) / pdj_price AS discount_depth,
    date(
        substr(begin_time, 1, instr(begin_time, ' ') - 1),
        'unixepoch'  -- won't work, need to replace '/' with '-'
    ) AS begin_date,
    date(
        substr(end_time, 1, instr(end_time, ' ') - 1),
        'unixepoch'
    ) AS end_date
FROM attachment_3
WHERE promotion_type = 3 
    AND state = 5 
    AND validation = 0 
    AND begin_time LIKE '%/%'
'''
# The above may fail because date expects YYYY-MM-DD.
# Let's do conversion in Python after loading.
promos_raw = pd.read_sql_query('''
    SELECT id, sku_id, pdj_price, promotion_price, begin_time, end_time
    FROM attachment_3
    WHERE promotion_type = 3 
        AND state = 5 
        AND validation = 0 
        AND begin_time LIKE '%/%'
''', conn)

def convert_date(dt_str):
    """Convert 'YYYY/M/D H:MM' to date string 'YYYY-MM-DD'"""
    if isinstance(dt_str, str):
        # split at space
        date_part = dt_str.split(' ')[0]
        # replace '/' with '-'
        parts = date_part.split('/')
        if len(parts) == 3:
            return f"{int(parts[0]):04d}-{int(parts[1]):02d}-{int(parts[2]):02d}"
    return None

promos_raw['begin_date'] = promos_raw['begin_time'].apply(convert_date)
promos_raw['end_date'] = promos_raw['end_time'].apply(convert_date)
promos_raw['discount_depth'] = (promos_raw['pdj_price'] - promos_raw['promotion_price']) / promos_raw['pdj_price']
promos_raw['discount_depth'] = promos_raw['discount_depth'].clip(lower=0)

# Load category mapping
cats = pd.read_sql_query('SELECT sku_id, "Level 1 Category Name" AS l1_cat_name FROM attachment_4', conn)
promos = pd.merge(promos_raw, cats, on='sku_id', how='left')

# Load sales
sales1 = pd.read_sql_query('SELECT create_dt, sku_id, "SKU Quantity" AS qty, "SKU Selling Price" AS price FROM attachment_1', conn)
sales2 = pd.read_sql_query('SELECT create_dt, sku_id, "SKU Quantity" AS qty, "SKU Selling Price" AS price FROM attachment_2', conn)
sales = pd.concat([sales1, sales2], ignore_index=True)
sales['create_dt'] = pd.to_datetime(sales['create_dt'])

# Convert promotion dates to datetime for comparison
promos['begin_dt'] = pd.to_datetime(promos['begin_date'])
promos['end_dt'] = pd.to_datetime(promos['end_date'])

# For each promotion, compute total sales quantity and revenue within period
results = []
for idx, row in promos.iterrows():
    mask = (sales['sku_id'] == row['sku_id']) & \
           (sales['create_dt'] >= row['begin_dt']) & \
           (sales['create_dt'] <= row['end_dt'])
    promo_sales = sales.loc[mask]
    total_qty = promo_sales['qty'].sum()
    total_rev = (promo_sales['qty'] * promo_sales['price']).sum()
    results.append({
        'promo_id': row['id'],
        'sku_id': row['sku_id'],
        'discount_depth': row['discount_depth'],
        'l1_cat_name': row['l1_cat_name'],
        'total_qty': total_qty,
        'total_rev': total_rev,
        'promotion_price': row['promotion_price'],
        'pdj_price': row['pdj_price'],
        'begin_date': row['begin_date'],
        'end_date': row['end_date']
    })

results_df = pd.DataFrame(results)
print("Promotion sales summary:")
print(results_df[['sku_id', 'l1_cat_name', 'discount_depth', 'total_qty', 'total_rev']].head(20))

# Compute summary statistics per category
cat_stats = results_df.groupby('l1_cat_name').agg(
    num_promotions=('promo_id', 'count'),
    avg_discount_depth=('discount_depth', 'mean'),
    total_qty=('total_qty', 'sum'),
    total_rev=('total_rev', 'sum'),
    avg_qty_per_promo=('total_qty', 'mean')
).reset_index()
print("\nCategory-level statistics:")
print(cat_stats)

# Compute correlation between discount depth and sales quantity
corr = results_df['discount_depth'].corr(results_df['total_qty'])
print(f"\nCorrelation between discount depth and total quantity sold: {corr:.3f}")

# Scatter plot discount depth vs quantity (optional)
plt.figure(figsize=(8,6))
plt.scatter(results_df['discount_depth'], results_df['total_qty'], alpha=0.5)
plt.xlabel('Discount Depth')
plt.ylabel('Total Quantity Sold')
plt.title('Discount Depth vs Sales Quantity')
plt.savefig('discount_vs_qty.png')
plt.close()

# Save results to CSV for further review
results_df.to_csv('promotion_sales_analysis.csv', index=False)
cat_stats.to_csv('category_stats.csv', index=False)

conn.close()
''')
