import pandas as pd
import sqlite3

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter1/dacomp-022/stage1_env/dacomp-022.sqlite')
df = pd.read_sql_query("""
    SELECT `Vehicle Type`,
           CAST(substr(Time, 1, 2) AS INTEGER) as hour,
           SUM(`Booking Value`) as total_earnings,
           COUNT(*) as rides,
           AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km
    FROM sheet1
    WHERE `Booking Status`='Completed'
    GROUP BY `Vehicle Type`, hour
""", conn)

# total earnings per vehicle type
total_by_vehicle = df.groupby('Vehicle Type').agg({'total_earnings':'sum', 'rides':'sum'}).reset_index()
total_by_vehicle['avg_earnings_per_ride'] = total_by_vehicle['total_earnings'] / total_by_vehicle['rides']
print("=== Total Earnings per Vehicle Type ===")
print(total_by_vehicle.sort_values('total_earnings', ascending=False))

# compute average fare per km per vehicle type
fare_by_vehicle = pd.read_sql_query("""
    SELECT `Vehicle Type`,
           AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km
    FROM sheet1
    WHERE `Booking Status`='Completed'
    GROUP BY `Vehicle Type`
""", conn)
print("\n=== Average Fare per km ===")
print(fare_by_vehicle.sort_values('avg_fare_per_km', ascending=False))

# compute hourly earnings per vehicle type (average per hour across all hours)
hourly_earnings = df.groupby('Vehicle Type').agg({'total_earnings':'mean'}).reset_index()
hourly_earnings.columns = ['Vehicle Type', 'avg_earnings_per_hour']
print("\n=== Average Total Earnings per Hour (mean across hours) ===")
print(hourly_earnings.sort_values('avg_earnings_per_hour', ascending=False))

conn.close()
```

