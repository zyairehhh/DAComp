import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

conn = sqlite3.connect('dacomp-034.sqlite')

# 1. Promotion data (single-item direct price reduction)
promo_query = """
SELECT 
    a.sku_id,
    a.promotion_price,
    a.pdj_price,
    a.sale_count,
    b."Level 1 Category ID",
    b."Level 1 Category Name"
FROM attachment_3 a
LEFT JOIN attachment_4 b ON a.sku_id = b.sku_id
WHERE a.promotion_type = 4
"""
promo_df = pd.read_sql(promo_query, conn)
# Compute discount depth
promo_df['discount_depth'] = (promo_df['pdj_price'] - promo_df['promotion_price']) / promo_df['pdj_price']
promo_df = promo_df[(promo_df['discount_depth'] > 0) & (promo_df['discount_depth'] <= 1)]
print(f"Promotions with category: {promo_df.shape[0]}")

# 2. Compute per category stats
category_stats = promo_df.groupby(['Level 1 Category ID', 'Level 1 Category Name']).agg(
    avg_discount=('discount_depth', 'mean'),
    median_discount=('discount_depth', 'median'),
    total_promo_sales=('sale_count', 'sum'),
    promo_count=('sku_id', 'count')
).reset_index()
category_stats = category_stats.sort_values('avg_discount', ascending=False)

# 3. Plot average discount depth by category (horizontal bar)
plt.figure(figsize=(10, 8))
plt.barh(category_stats['Level 1 Category Name'], category_stats['avg_discount'])
plt.xlabel('Average Discount Depth')
plt.title('Average Discount Depth by Level 1 Category (Promotion Type 4)')
plt.tight_layout()
plt.savefig('avg_discount_depth_by_category_hbar.png', dpi=300)
plt.close()

# 4. Scatter: avg discount vs total promotion sales
plt.figure(figsize=(8,6))
plt.scatter(category_stats['avg_discount'], category_stats['total_promo_sales'], s=50, alpha=0.7)
for i, row in category_stats.iterrows():
    plt.text(row['avg_discount'], row['total_promo_sales'], str(int(row['Level 1 Category ID'])), fontsize=8)
plt.xlabel('Average Discount Depth')
plt.ylabel('Total Promotion Sales (sale_count)')
plt.title('Discount Depth vs Promotion Sales by Category')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('discount_vs_sales_scatter.png', dpi=300)
plt.close()

# 5. Boxplot of discount depth distribution per category (top 10 categories by promo count)
top_cats = category_stats.nlargest(10, 'promo_count')['Level 1 Category Name'].tolist()
promo_top = promo_df[promo_df['Level 1 Category Name'].isin(top_cats)]
plt.figure(figsize=(12,6))
promo_top.boxplot(column='discount_depth', by='Level 1 Category Name', rot=45)
plt.title('Discount Depth Distribution by Category (Top 10 by Promotion Count)')
plt.suptitle('')
plt.xlabel('Category')
plt.ylabel('Discount Depth')
plt.tight_layout()
plt.savefig('discount_depth_boxplot_top10.png', dpi=300)
plt.close()

# 6. Promotion count per category
plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['promo_count'])
plt.title('Number of Single-Item Direct Price Reduction Promotions by Category')
plt.xlabel('Category')
plt.ylabel('Promotion Count')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('promotion_count_per_category.png', dpi=300)
plt.close()

# 7. Relationship between discount depth and sales per promotion (individual promo)
# Filter to reasonable sale_count
plt.figure(figsize=(8,6))
plt.scatter(promo_df['discount_depth'], promo_df['sale_count'], alpha=0.3, s=10)
plt.xlabel('Discount Depth')
plt.ylabel('Promotion Sales (sale_count)')
plt.title('Discount Depth vs Sales per Promotion (All Promotions)')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('discount_vs_sales_all.png', dpi=300)
plt.close()

# 8. Compute elasticity-like metric: total promo sales / avg discount per category
category_stats['sales_per_discount'] = category_stats['total_promo_sales'] / category_stats['avg_discount']
category_stats = category_stats.sort_values('sales_per_discount', ascending=False)

plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['sales_per_discount'])
plt.title('Promotion Effectiveness (Total Sales per Unit Discount Depth) by Category')
plt.xlabel('Category')
plt.ylabel('Sales per Discount Depth')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('promotion_effectiveness_sales_per_discount.png', dpi=300)
plt.close()

# 9. Output summary table for stage2.md
print(category_stats[['Level 1 Category Name', 'avg_discount', 'total_promo_sales', 'promo_count', 'sales_per_discount']].head(20))

conn.close()
```

