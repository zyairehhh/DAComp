df_hourly = pd.read_sql_query(query2, conn)

# For each vehicle type, pick top 3 hours with highest avg_fare_per_km
top_fare = df_hourly.groupby('Vehicle Type').head(3).reset_index(drop=True)

# 3. Hourly analysis for each vehicle type (top hours by total earnings)
df_hourly_earnings = df_hourly.sort_values(['Vehicle Type', 'total_earnings'], ascending=[True, False])
top_earnings = df_hourly_earnings.groupby('Vehicle Type').head(3).reset_index(drop=True)

# 4. Cancellation rates
query3 = """
SELECT `Vehicle Type`,
       COUNT(*) as total_rides,
       SUM(CASE WHEN `Booking Status` = 'Cancelled by Driver' THEN 1 ELSE 0 END) as driver_cancelled,
       SUM(CASE WHEN `Booking Status` = 'Cancelled by Customer' THEN 1 ELSE 0 END) as customer_cancelled,
       SUM(CASE WHEN `Incomplete Rides` = 1.0 THEN 1 ELSE 0 END) as incomplete
FROM sheet1
GROUP BY `Vehicle Type`
"""
df_canc = pd.read_sql_query(query3, conn)
df_canc['driver_cancel_rate'] = df_canc['driver_cancelled'] / df_canc['total_rides'] * 100
df_canc['customer_cancel_rate'] = df_canc['customer_cancelled'] / df_canc['total_rides'] * 100
df_canc['incomplete_rate'] = df_canc['incomplete'] / df_canc['total_rides'] * 100

# 5. Rating vs fare per km
query4 = """
SELECT CASE
    WHEN `Driver Ratings` < 4.0 THEN 'Low (<4.0)'
    WHEN `Driver Ratings` < 4.5 THEN 'Medium (4.0-4.5)'
    WHEN `Driver Ratings` <= 5.0 THEN 'High (4.5-5)'
    ELSE 'NA'
END as rating_group,
AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
AVG(`Booking Value`) as avg_booking,
AVG(`Ride Distance`) as avg_distance,
COUNT(*) as num_rides
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY rating_group
ORDER BY avg_fare_per_km DESC
"""
df_rating = pd.read_sql_query(query4, conn)

# Write insights to CSV
df_vehicle.to_csv('/workspace/vehicle_type_summary2.csv', index=False)
top_fare.to_csv('/workspace/top_hours_by_fare.csv', index=False)
top_earnings.to_csv('/workspace/top_hours_by_earnings.csv', index=False)
df_canc.to_csv('/workspace/cancellation_summary.csv', index=False)
df_rating.to_csv('/workspace/rating_fare_summary.csv', index=False)

conn.close()

print("Analysis complete.")
print("\n=== Vehicle Type Summary (by fare per km) ===")
print(df_vehicle[['Vehicle Type', 'total_rides', 'total_earnings', 'avg_fare_per_km', 'avg_driver_rating']])
print("\n=== Cancellation Rates ===")
print(df_canc[['Vehicle Type', 'driver_cancel_rate', 'customer_cancel_rate', 'incomplete_rate']])
print("\n=== Rating Groups vs Fare per km ===")
print(df_rating)
```
