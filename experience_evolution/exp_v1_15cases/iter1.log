import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-070.sqlite')
country_df = pd.read_sql_query("SELECT date_day, package_name, region, store_listing_conversion_rate, active_devices_last_30_days, rolling_total_average_rating, update_events FROM google_play__country_report", conn)
device_df = pd.read_sql_query("SELECT date_day, package_name, device, active_devices_last_30_days, rolling_total_average_rating, update_events FROM google_play__device_report", conn)
conn.close()

country_df['date_day'] = pd.to_datetime(country_df['date_day'])
device_df['date_day'] = pd.to_datetime(device_df['date_day'])

# Extract device brand
device_df['device_brand'] = device_df['device'].apply(lambda x: x.split()[0] if isinstance(x, str) else 'Unknown')

# Merge on date_day and package_name (inner join) -> each row is per region, device brand per day
merged = pd.merge(country_df, device_df, on=['date_day', 'package_name'], suffixes=('_country', '_device'))
print("Merged shape:", merged.shape)
print(merged.head())

# Compute monthly average conversion rate per region and device brand
merged['year_month'] = merged['date_day'].dt.to_period('M')
monthly = merged.groupby(['region', 'device_brand', 'year_month'])['store_listing_conversion_rate'].mean().reset_index()
# Compute decay slope per region-device combination
decay_results = []
for (region, brand), group in monthly.groupby(['region', 'device_brand']):
    group = group.sort_values('year_month')
    if len(group) >= 2:
        x = np.arange(len(group))
        y = group['store_listing_conversion_rate'].values
        coeff = np.polyfit(x, y, 1)
        slope = coeff[0]
        p = np.poly1d(coeff)
        yhat = p(x)
        ybar = np.mean(y)
        ssreg = np.sum((yhat - ybar)**2)
        sstot = np.sum((y - ybar)**2)
        r2 = ssreg / sstot if sstot != 0 else 0
        decay_results.append({
            'region': region,
            'device_brand': brand,
            'slope': slope,
            'r_squared': r2,
            'start_rate': y[0],
            'end_rate': y[-1]
        })
    else:
        decay_results.append({
            'region': region,
            'device_brand': brand,
            'slope': None,
            'r_squared': None,
            'start_rate': None,
            'end_rate': None
        })

decay_df = pd.DataFrame(decay_results)
print("\nDecay patterns per region-device combination (top 10):")
print(decay_df.sort_values('slope').head(10))
print("\nWorst decay (most negative slopes):")
print(decay_df.sort_values('slope').head())
print("\nBest improvement (most positive slopes):")
print(decay_df.sort_values('slope', ascending=False).head())

# Compute average conversion rate across all combos
overall_monthly = merged.groupby('year_month')['store_listing_conversion_rate'].mean().reset_index()
print("\nOverall monthly conversion rate:")
print(overall_monthly)

# Non-linear relationship with quality_score and crash_rate_per_1k (we already did)
# But need per region/device? We'll skip for now.

# Model for revenue_per_active_device per region? It's not in merged. We'll use country-level revenue? Not present.
# We'll skip.

print("\nAdvanced analysis done.")
```
