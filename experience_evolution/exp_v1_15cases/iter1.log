Action: LOCAL_DB_SQL(file_path="dacomp-060.sqlite", command="SELECT ad_group_id, ad_group_name, 
       SUM(clicks) as total_clicks,
       SUM(impressions) as total_impressions,
       SUM(conversions) as total_conversions,
       CASE WHEN SUM(impressions) > 0 THEN SUM(clicks) * 1.0 / SUM(impressions) ELSE 0 END as ctr,
       CASE WHEN SUM(clicks) > 0 THEN SUM(conversions) * 1.0 / SUM(clicks) ELSE 0 END as cvr
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name
LIMIT 10;", output="direct")
