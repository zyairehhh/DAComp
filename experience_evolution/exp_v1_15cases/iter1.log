Action: CreateFile(filepath='analysis4.py':
'''
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')
ad_group_agg = pd.read_csv('ad_group_aggregates.csv')
problematic = pd.read_csv('problematic_details.csv')
non_problematic = ad_group_agg[~ad_group_agg['ad_group_id'].isin(problematic['ad_group_id'])]

print("Proportion of ad groups with zero conversions:")
print("Problematic:", (problematic['total_conversions'] == 0).sum() / len(problematic))
print("Non-problematic:", (non_problematic['total_conversions'] == 0).sum() / len(non_problematic))

