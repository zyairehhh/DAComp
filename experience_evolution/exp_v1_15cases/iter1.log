df = pd.read_csv('user_value_scores.csv')
# Load region mapping
region_df = pd.read_csv('user_region.csv')
# Merge on email
merged = pd.merge(df, region_df, left_on='email', right_on='email', how='left')
print(f"Users with region: {merged['region'].notna().sum()}")

# For users missing region, assign Unknown
merged['region'] = merged['region'].fillna('Unknown')

# Composite score by region
print("\n=== Composite score by region ===")
group_region = merged.groupby('region')['composite_score'].agg(['mean', 'median', 'std', 'count']).round(2)
print(group_region.sort_values('mean', ascending=False))

# Segment distribution per region
seg_region = pd.crosstab(merged['region'], merged['segment'], normalize='index') * 100
print("\n=== Segment % per region ===")
print(seg_region.round(1))

# Language vs region cross-tab
print("\n=== Language vs region cross-tab (top) ===")
lang_region = pd.crosstab(merged['language'], merged['region'], normalize='index') * 100
print(lang_region.round(1).head(10))

# Transition analysis: For each language-region group, compute proportion of high-value users
merged['is_high'] = merged['segment'] == 'high_value'
high_rate = merged.groupby(['language', 'region'])['is_high'].mean().reset_index()
high_rate = high_rate.sort_values('is_high', ascending=False)
print("\n=== Top language-region groups by high-value proportion ===")
print(high_rate.head(15))
print("\n=== Bottom language-region groups by high-value proportion ===")
print(high_rate.tail(15))
''')
