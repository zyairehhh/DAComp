import sqlite3

conn = sqlite3.connect('dacomp-081.sqlite')
cursor = conn.cursor()
cursor.execute("SELECT * FROM qualtrics__response LIMIT 1")
cols = [description[0] for description in cursor.description]
print("Searching for 'performance'")
for col in cols:
    try:
        cursor.execute(f"SELECT COUNT(*) FROM qualtrics__response WHERE CAST({col} AS TEXT) LIKE '%performance%'")
        count = cursor.fetchone()[0]
        if count > 0:
            print(f"Column {col} has {count} rows with 'performance'")
            cursor.execute(f"SELECT DISTINCT {col} FROM qualtrics__response WHERE CAST({col} AS TEXT) LIKE '%performance%' LIMIT 3")
            samples = cursor.fetchall()
            print(f"Samples: {samples}")
    except Exception as e:
        pass
conn.close()
