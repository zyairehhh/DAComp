import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database (database is in the same directory)
db_path = 'dacomp-070.sqlite'  # relative path
conn = sqlite3.connect(db_path)

# Helper to save fig
def save_fig(name):
    plt.tight_layout()
    plt.savefig(f'{name}.png', dpi=300)  # save to current directory
    plt.close()

# 1. Regional conversion rate trends over past 6 months
query = """
SELECT date_day, region, store_listing_conversion_rate
FROM google_play__country_report
WHERE date_day >= '2024-04-01'
"""
df = pd.read_sql_query(query, conn, parse_dates=['date_day'])
df['month'] = df['date_day'].dt.to_period('M').astype(str)
monthly = df.groupby(['region', 'month'])['store_listing_conversion_rate'].mean().reset_index()

# Pivot for plotting
pivot = monthly.pivot(index='month', columns='region', values='store_listing_conversion_rate')
# Order months chronologically
month_order = ['2024-04','2024-05','2024-06','2024-07','2024-08','2024-09','2024-10']
pivot = pivot.reindex(month_order)

plt.figure(figsize=(10,6))
for region in pivot.columns:
    plt.plot(pivot.index, pivot[region], marker='o', label=region)
plt.xlabel('Month')
plt.ylabel('Average Store Listing Conversion Rate')
plt.title('Regional Conversion Rate Trends (Past 6 Months)')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
save_fig('regional_conversion_trends')

# 2. Device brand active device trends (slope bar chart)
query2 = """
SELECT date_day, device, active_devices_last_30_days
FROM google_play__device_report
WHERE date_day >= '2024-04-01'
"""
df_dev = pd.read_sql_query(query2, conn, parse_dates=['date_day'])
df_dev['month'] = df_dev['date_day'].dt.to_period('M').astype(str)
monthly_dev = df_dev.groupby(['device', 'month'])['active_devices_last_30_days'].mean().reset_index()

# Compute linear slope per device (simple linear regression over months)
def month_to_num(m):
    y, m = map(int, m.split('-'))
    return (y - 2024) * 12 + (m - 4)  # April 2024 = 0

monthly_dev['month_num'] = monthly_dev['month'].apply(month_to_num)
slopes = []
for dev in monthly_dev['device'].unique():
    sub = monthly_dev[monthly_dev['device'] == dev]
    if len(sub) < 2:
        slopes.append((dev, 0, 0))
        continue
    coeff = np.polyfit(sub['month_num'], sub['active_devices_last_30_days'], 1)
    # Compute R^2
    corr = np.corrcoef(sub['month_num'], sub['active_devices_last_30_days'])[0,1]
    slopes.append((dev, coeff[0], corr**2))
slope_df = pd.DataFrame(slopes, columns=['device','slope','r2'])
slope_df = slope_df.sort_values('slope', ascending=False)

plt.figure(figsize=(12,6))
bars = plt.bar(slope_df['device'], slope_df['slope'], color='steelblue')
plt.xlabel('Device Brand')
plt.ylabel('Slope (Active Devices per Month)')
plt.title('Device Brand Active Devices Trend Slope (Linear)')
plt.xticks(rotation=45, ha='right')
# Add R2 as annotations
for i, (_, row) in enumerate(slope_df.iterrows()):
    plt.text(i, row['slope'] + (0.02 if row['slope']>=0 else -0.02), 
             f'R²={row["r2"]:.2f}', ha='center', va='bottom' if row['slope']>=0 else 'top', fontsize=8)
plt.tight_layout()
save_fig('device_slope_bar')

# 3. Non-linear relationship: conversion vs quality_score and crash_rate_per_1k
query3 = """
SELECT date_day, store_listing_conversion_rate, quality_score, crash_rate_per_1k
FROM google_play__time_series_trends
WHERE date_day >= '2024-04-01'
"""
df_qual = pd.read_sql_query(query3, conn, parse_dates=['date_day'])
# Drop rows with missing values
df_qual = df_qual.dropna(subset=['store_listing_conversion_rate','quality_score','crash_rate_per_1k'])

# Scatter quality_score vs conversion
plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
plt.scatter(df_qual['quality_score'], df_qual['store_listing_conversion_rate'], alpha=0.5, s=10)
# Fit quadratic
if len(df_qual) >= 3:
    coeff_q = np.polyfit(df_qual['quality_score'], df_qual['store_listing_conversion_rate'], 2)
    x_seq = np.linspace(df_qual['quality_score'].min(), df_qual['quality_score'].max(), 100)
    y_seq = np.polyval(coeff_q, x_seq)
    plt.plot(x_seq, y_seq, color='red', linewidth=2, label=f'Quadratic fit')
plt.xlabel('Quality Score')
plt.ylabel('Conversion Rate')
plt.title('Conversion Rate vs Quality Score')
plt.legend()

plt.subplot(1,2,2)
plt.scatter(df_qual['crash_rate_per_1k'], df_qual['store_listing_conversion_rate'], alpha=0.5, s=10)
if len(df_qual) >= 3:
    coeff_c = np.polyfit(df_qual['crash_rate_per_1k'], df_qual['store_listing_conversion_rate'], 2)
    x_seq = np.linspace(df_qual['crash_rate_per_1k'].min(), df_qual['crash_rate_per_1k'].max(), 100)
    y_seq = np.polyval(coeff_c, x_seq)
    plt.plot(x_seq, y_seq, color='red', linewidth=2, label=f'Quadratic fit')
plt.xlabel('Crash Rate per 1k')
plt.ylabel('Conversion Rate')
plt.title('Conversion Rate vs Crash Rate')
plt.legend()

save_fig('conversion_vs_quality_crash')

# 4. Market maturity classification: install growth per month
query4 = """
SELECT date_day, daily_installs
FROM google_play__time_series_trends
WHERE date_day >= '2024-04-01'
"""
df_inst = pd.read_sql_query(query4, conn, parse_dates=['date_day'])
df_inst['month'] = df_inst['date_day'].dt.to_period('M').astype(str)
monthly_inst = df_inst.groupby('month')['daily_installs'].sum().reset_index()
monthly_inst['month_num'] = monthly_inst['month'].apply(month_to_num)
monthly_inst = monthly_inst.sort_values('month_num')
# Compute month-over-month growth (as percent)
monthly_inst['prev_installs'] = monthly_inst['daily_installs'].shift(1)
monthly_inst['growth'] = (monthly_inst['daily_installs'] - monthly_inst['prev_installs']) / monthly_inst['prev_installs'] * 100
# Classify
def classify(g):
    if g > 5:
        return 'Emerging'
    elif g < -5:
        return 'Mature'
    else:
        return 'Stable'
monthly_inst['maturity'] = monthly_inst['growth'].apply(lambda g: classify(g) if pd.notnull(g) else 'N/A')
# Plot bar
plt.figure(figsize=(8,6))
colors = {'Emerging':'green','Mature':'red','Stable':'gray'}
bar_colors = [colors[m] for m in monthly_inst['maturity']]
bars = plt.bar(monthly_inst['month'], monthly_inst['growth'], color=bar_colors, edgecolor='black')
plt.xlabel('Month')
plt.ylabel('Install Growth (%)')
plt.title('Monthly Install Growth and Market Maturity')
plt.axhline(y=5, color='green', linestyle='--', alpha=0.3, label='Emerging threshold (>5%)')
plt.axhline(y=-5, color='red', linestyle='--', alpha=0.3, label='Mature threshold (<-5%)')
plt.legend()
# Add value labels
for bar, val in zip(bars, monthly_inst['growth']):
    if pd.notnull(val):
        height = bar.get_height()
        plt.text(bar.get_x() + bar.get_width()/2., height + (0.5 if height>=0 else -1.5),
                 f'{val:.1f}%', ha='center', va='bottom' if height>=0 else 'top', fontsize=9)
save_fig('market_maturity_growth')

# 5. Interaction effect: update frequency vs active devices, colored by rating
query5 = """
SELECT date_day, 
       SUM(update_events) as total_update_events,
       AVG(active_devices_last_30_days) as avg_active_devices,
       AVG(rolling_total_average_rating) as avg_rating
FROM google_play__country_report
WHERE date_day >= '2024-04-01'
GROUP BY date_day
"""
df_inter = pd.read_sql_query(query5, conn, parse_dates=['date_day'])
df_inter = df_inter.dropna()
# Plot scatter of update_events vs active_devices, size by rating?
plt.figure(figsize=(10,6))
sc = plt.scatter(df_inter['total_update_events'], df_inter['avg_active_devices'], 
                 c=df_inter['avg_rating'], cmap='viridis', alpha=0.6, s=50)
plt.colorbar(sc, label='Average Rating')
plt.xlabel('Total Daily Update Events')
plt.ylabel('Average Active Devices (30‑day)')
plt.title('Interaction of Update Frequency, Active Devices, and Rating')
save_fig('update_active_rating_scatter')

conn.close()
print("Visualization scripts executed.")
```
