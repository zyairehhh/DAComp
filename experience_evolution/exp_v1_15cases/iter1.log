ts_df['date_day'] = pd.to_datetime(ts_df['date_day'])
ts_df['year_month'] = ts_df['date_day'].dt.to_period('M')
monthly = ts_df.groupby('year_month').agg({
    'daily_installs': 'sum',
    'daily_revenue': 'sum',
    'active_devices': 'mean',
    'package_name': 'nunique'
}).reset_index()
monthly = monthly.sort_values('year_month')
# compute MoM growth
monthly['install_growth'] = monthly['daily_installs'].pct_change()
monthly['revenue_growth'] = monthly['daily_revenue'].pct_change()
print("Monthly growth rates:")
print(monthly[['year_month', 'daily_installs', 'install_growth', 'daily_revenue', 'revenue_growth']])
# Classify months as mature (low growth) or emerging (high growth)
threshold = 0.05
monthly['market_maturity'] = monthly['install_growth'].apply(lambda x: 'Emerging' if x > threshold else 'Mature' if x < -threshold else 'Stable')
print("\nMarket maturity classification:")
print(monthly[['year_month', 'install_growth', 'market_maturity']])
''')
