import pandas as pd
import numpy as np
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')

# Load ad group metrics
ad_metrics = pd.read_csv('ad_group_metrics_with_ratio.csv')

# Get additional fields from original table like status, spend, etc.
query = """
SELECT ad_group_id, 
       MIN(status) as status,  -- assume same status across rows
       SUM(spend) as total_spend,
       AVG(spend) as avg_daily_spend,
       MIN(ad_group_type) as ad_group_type
FROM google_ads__ad_group_report
GROUP BY ad_group_id
"""
ad_details = pd.read_sql_query(query, conn)
ad_metrics = ad_metrics.merge(ad_details, on='ad_group_id', how='left')

# Compute CPC = spend / clicks, CPA = spend / conversions (if conversions>0)
ad_metrics['cpc'] = ad_metrics['total_spend'] / ad_metrics['total_clicks']
ad_metrics['cpa'] = ad_metrics['total_spend'] / ad_metrics['total_conversions']
ad_metrics['cpa'] = ad_metrics['cpa'].replace([np.inf, -np.inf], np.nan)

# Define problematic flag (already exists from previous analysis)
problematic = ad_metrics[ad_metrics['problematic'] == True]
non_problematic = ad_metrics[ad_metrics['problematic'] == False]

# Compare problematic vs non-problematic
print("=== Performance Metrics ===")
print("Problematic ad groups (271):")
print(f"  Average CTR: {problematic['ctr'].mean():.4f}")
print(f"  Average CVR: {problematic['cvr'].mean():.4f}")
print(f"  Expected CVR: {problematic['expected_cvr'].mean():.4f}")
print(f"  Intent Match Ratio: {problematic['intent_match_ratio'].mean():.3f}")
print(f"  Average CPC: ${problematic['cpc'].mean():.2f}")
print(f"  Average CPA: ${problematic['cpa'].mean():.2f}")
print(f"  Total Spend: ${problematic['total_spend'].sum():.2f}")
print(f"  Total Conversions: {problematic['total_conversions'].sum():.1f}")
print(f"  Average Spend per group: ${problematic['total_spend'].mean():.2f}")

print("\nNon-problematic ad groups (4053):")
print(f"  Average CTR: {non_problematic['ctr'].mean():.4f}")
print(f"  Average CVR: {non_problematic['cvr'].mean():.4f}")
print(f"  Expected CVR: {non_problematic['expected_cvr'].mean():.4f}")
print(f"  Intent Match Ratio: {non_problematic['intent_match_ratio'].mean():.3f}")
print(f"  Average CPC: ${non_problematic['cpc'].mean():.2f}")
print(f"  Average CPA: ${non_problematic['cpa'].mean():.2f}")
print(f"  Total Spend: ${non_problematic['total_spend'].sum():.2f}")
print(f"  Total Conversions: {non_problematic['total_conversions'].sum():.1f}")
print(f"  Average Spend per group: ${non_problematic['total_spend'].mean():.2f}")

# Status distribution
print("\n=== Status Distribution ===")
status_counts = ad_metrics.groupby(['problematic', 'status']).size().unstack(fill_value=0)
print(status_counts)

# Ad group type (likely all SEARCH_STANDARD)
print("\n=== Ad Group Type ===")
print(ad_metrics['ad_group_type'].value_counts())

# Analyze top problematic ad groups by spend (most costly)
top_problematic = problematic.nlargest(10, 'total_spend')[['ad_group_id', 'ad_group_name', 'ctr', 'cvr', 'intent_match_ratio', 'total_spend', 'total_clicks', 'total_conversions']]
print("\n=== Top 10 Problematic Ad Groups by Spend ===")
print(top_problematic.to_string(index=False))

# Save problematic details
problematic.to_csv('problematic_details.csv', index=False)

conn.close()
