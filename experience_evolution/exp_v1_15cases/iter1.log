import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect("/workspace/dacomp-022.sqlite")
# Query for vehicle type summary
query = """
SELECT `Vehicle Type`,
    AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
    AVG(`Booking Value`) as avg_booking_value,
    AVG(`Ride Distance`) as avg_distance,
    COUNT(*) as total_rides,
    SUM(`Booking Value`) as total_booking_value
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY `Vehicle Type`
ORDER BY avg_fare_per_km DESC
"""
df = pd.read_sql_query(query, conn)
print("Vehicle Type Summary (sorted by fare per km):")
print(df.to_string())
print("\n")

# Query for top hours by fare per km per vehicle type (ride count > 100)
query2 = """
WITH hourly AS (
    SELECT `Vehicle Type`,
        CAST(substr(Time, 1, 2) AS INTEGER) as hour,
        AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
        AVG(`Booking Value`) as avg_booking,
        AVG(`Ride Distance`) as avg_distance,
        COUNT(*) as num_rides,
        SUM(`Booking Value`) as total_earnings
    FROM sheet1
    WHERE `Booking Status` = 'Completed'
    GROUP BY `Vehicle Type`, hour
    HAVING COUNT(*) > 100
),
ranked_fare AS (
    SELECT *,
        ROW_NUMBER() OVER (PARTITION BY `Vehicle Type` ORDER BY avg_fare_per_km DESC) as fare_rank
    FROM hourly
),
ranked_earnings AS (
    SELECT *,
        ROW_NUMBER() OVER (PARTITION BY `Vehicle Type` ORDER BY total_earnings DESC) as earnings_rank
    FROM hourly
)
SELECT f.`Vehicle Type`,
    f.hour as best_fare_hour,
    f.avg_fare_per_km as best_fare_per_km,
    f.num_rides as rides_at_best_fare,
    e.hour as highest_earnings_hour,
    e.total_earnings as earnings_at_hour,
    e.num_rides as rides_at_earnings_peak
FROM ranked_fare f
JOIN ranked_earnings e ON f.`Vehicle Type` = e.`Vehicle Type`
WHERE f.fare_rank = 1 AND e.earnings_rank = 1
ORDER BY f.avg_fare_per_km DESC
"""
df2 = pd.read_sql_query(query2, conn)
print("Best hour per vehicle type (fare per km vs total earnings):")
print(df2.to_string())
print("\n")

# Overall top 10 hours for fare per km (any vehicle with >100 rides)
query3 = """
SELECT `Vehicle Type`,
    CAST(substr(Time, 1, 2) AS INTEGER) as hour,
    AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
    COUNT(*) as num_rides,
    SUM(`Booking Value`) as total_earnings
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY `Vehicle Type`, hour
HAVING COUNT(*) > 100
ORDER BY avg_fare_per_km DESC
LIMIT 10
"""
df3 = pd.read_sql_query(query3, conn)
print("Top 10 highest fare per km hours (>100 rides):")
print(df3.to_string())
print("\n")

# Overall top 10 hours for total earnings
query4 = """
SELECT `Vehicle Type`,
    CAST(substr(Time, 1, 2) AS INTEGER) as hour,
    AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
    COUNT(*) as num_rides,
    SUM(`Booking Value`) as total_earnings
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY `Vehicle Type`, hour
ORDER BY total_earnings DESC
LIMIT 10
"""
df4 = pd.read_sql_query(query4, conn)
print("Top 10 highest total earnings hours:")
print(df4.to_string())
print("\n")

# Ratings analysis
query5 = """
SELECT CASE 
        WHEN `Driver Ratings` < 3.5 THEN 'Low (<3.5)'
        WHEN `Driver Ratings` < 4.0 THEN 'Medium (3.5-4.0)'
        WHEN `Driver Ratings` < 4.5 THEN 'Good (4.0-4.5)'
        WHEN `Driver Ratings` <= 5.0 THEN 'High (4.5-5)'
        ELSE 'No Rating'
    END as rating_group,
    AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
    AVG(`Booking Value`) as avg_booking,
    AVG(`Ride Distance`) as avg_distance,
    COUNT(*) as num_rides
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY rating_group
ORDER BY avg_fare_per_km DESC
"""
df5 = pd.read_sql_query(query5, conn)
print("Fare per km by driver rating groups:")
print(df5.to_string())
print("\n")

# Cancellation rates analysis
query6 = """
SELECT `Vehicle Type`,
    COUNT(*) as total_rides,
    ROUND(100.0 * SUM(CASE WHEN `Booking Status` = 'Cancelled by Driver' THEN 1 ELSE 0 END) / COUNT(*), 2) as driver_cancel_pct,
    ROUND(100.0 * SUM(CASE WHEN `Booking Status` = 'Cancelled by Customer' THEN 1 ELSE 0 END) / COUNT(*), 2) as cust_cancel_pct,
    ROUND(100.0 * SUM(CASE WHEN `Incomplete Rides` = 1.0 THEN 1 ELSE 0 END) / COUNT(*), 2) as incomplete_pct
FROM sheet1
GROUP BY `Vehicle Type`
ORDER BY driver_cancel_pct DESC
"""
df6 = pd.read_sql_query(query6, conn)
print("Cancellation and incomplete rates by vehicle type:")
print(df6.to_string())

conn.close()
```

