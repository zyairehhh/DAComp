            filter_counts.plot(kind='bar', edgecolor='black', alpha=0.7)
            plt.xlabel('Filter Status')
            plt.ylabel('Count')
            plt.title('Display Case Filter Status in\nHigh-Traffic Exhibition Halls')
            plt.xticks(rotation=45, ha='right')
    
    plt.tight_layout()
    plt.savefig('display_case_conditions.png', dpi=300, bbox_inches='tight')
