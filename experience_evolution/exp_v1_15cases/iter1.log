seasonal = monthly.groupby('month')['roi'].mean().reset_index()
print("\n--- Seasonal average ROI (across all months) ---")
print(seasonal.round(3))

# 7. Identify core problems per high-risk campaign
# For each high-risk campaign, determine which dimension scores are low.
high_risk['lowest_dimension'] = high_risk[['cost_efficiency_score','conversion_quality_score','competitiveness_score']].idxmin(axis=1)
high_risk['lowest_dimension'] = high_risk['lowest_dimension'].str.replace('_score','')
print("\n--- High-risk campaign diagnosis ---")
for _, row in high_risk.iterrows():
    print(f"Campaign {row['campaign_id']} ({row['campaign_name']}) - Risk: {row['risk_level']}, Health: {row['health_score']:.1f}")
    print(f"  Lowest dimension: {row['lowest_dimension']}")
    print(f"  ROI: {row['avg_roi']:.2f}, Conv rate: {row['avg_conversion_rate']:.4f}, CTR: {row['avg_ctr']:.5f}, Imp share: {row['avg_impression_share']:.3f}, Avg position: {row['avg_position_weighted']:.2f}")
    # Recommend based on low dimension
    if row['lowest_dimension'] == 'cost_efficiency':
        print("  Recommendation: Improve ROI via bid adjustments, keyword optimization, or landing page improvements.")
    elif row['lowest_dimension'] == 'conversion_quality':
        print("  Recommendation: Improve conversion rate via ad copy, landing page, targeting adjustments.")
    else:
        print("  Recommendation: Improve competitiveness via increasing bids, ad relevance, or budget allocation.")

# Save high risk campaigns to CSV
high_risk.to_csv('high_risk_campaigns.csv', index=False)
print("\nHigh-risk campaigns saved to high_risk_campaigns.csv")

conn.close()
''')
