'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib
# Ensure English labels; no Chinese characters
# matplotlib.rcParams['font.sans-serif'] = []  # default
# matplotlib.rcParams['axes.unicode_minus'] = False

def load_data():
    conn = sqlite3.connect('dacomp-092.sqlite')
    # profitability_analysis
    pa = pd.read_sql_query('''
        SELECT customer_id, transaction_date, invoice_total, gross_profit,
               customer_margin_volatility, revenue_year, revenue_quarter
        FROM quickbooks__profitability_analysis
    ''', conn, parse_dates=['transaction_date'])
    # customer_analytics
    ca = pd.read_sql_query('''
        SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
               lifecycle_stage, customer_value_segment, risk_assessment
        FROM quickbooks__customer_analytics
    ''', conn)
    # financial_dashboard (monthly)
    fd = pd.read_sql_query('''
        SELECT dashboard_month, business_health_score, collection_rate_percentage
        FROM quickbooks__financial_dashboard
    ''', conn, parse_dates=['dashboard_month'])
    # balance_sheet (accounts receivable)
    bs = pd.read_sql_query('''
        SELECT calendar_date, account_class, account_sub_type, account_name, amount
        FROM quickbooks__balance_sheet
        WHERE account_type LIKE '%Receivable%' OR account_class LIKE '%Receivable%'
    ''', conn, parse_dates=['calendar_date'])
    conn.close()
    return pa, ca, fd, bs

def compute_volatility_metrics(pa):
    # Determine threshold for top 25% customer_margin_volatility
    # Use the latest value per customer (or maybe average? column is per customer?)
    # Let's assume each row per customer has same volatility? Check.
    # Group by customer and take max (or last)
    cust_vol = pa.groupby('customer_id')['customer_margin_volatility'].max().reset_index()
    threshold = cust_vol['customer_margin_volatility'].quantile(0.75)
    high_vol_customers = cust_vol[cust_vol['customer_margin_volatility'] >= threshold]['customer_id'].tolist()
    print(f'High volatility threshold: {threshold:.4f}')
    print(f'Number of high-volatility customers: {len(high_vol_customers)}')
    
    # Filter pa for high-volatility customers
    pa_high = pa[pa['customer_id'].isin(high_vol_customers)]
    
    # Coefficient of variation (std/mean) of gross_profit over past 12 months for each customer
    # Determine latest date
    max_date = pa['transaction_date'].max()
    start_date = max_date - pd.DateOffset(months=12)
    # Aggregate monthly gross_profit per customer
    pa_high['year_month'] = pa_high['transaction_date'].dt.to_period('M')
    monthly_profit = pa_high.groupby(['customer_id', 'year_month'])['gross_profit'].sum().reset_index()
    # Compute std and mean per customer (only months within last 12 months)
    monthly_profit['date'] = monthly_profit['year_month'].dt.to_timestamp()
    monthly_profit = monthly_profit[monthly_profit['date'] >= start_date]
    if monthly_profit.empty:
        # fallback: use all data
        monthly_profit = pa_high.groupby(['customer_id', 'year_month'])['gross_profit'].sum().reset_index()
    cv = monthly_profit.groupby('customer_id')['gross_profit'].agg(['std','mean']).reset_index()
    cv['coeff_of_variation'] = cv['std'] / cv['mean']
    cv.replace([np.inf, -np.inf], np.nan, inplace=True)
    cv.fillna(0, inplace=True)
    
    # Variance of quarter-over-quarter invoice_total growth rate per customer
    # Compute total invoice_total per quarter per customer
    pa_high['quarter'] = pa_high['transaction_date'].dt.to_period('Q')
    quarterly_invoice = pa_high.groupby(['customer_id', 'quarter'])['invoice_total'].sum().reset_index()
    # Calculate growth rate
    quarterly_invoice = quarterly_invoice.sort_values(['customer_id', 'quarter'])
    quarterly_invoice['prev_quarter_invoice'] = quarterly_invoice.groupby('customer_id')['invoice_total'].shift(1)
    quarterly_invoice['growth_rate'] = (quarterly_invoice['invoice_total'] - quarterly_invoice['prev_quarter_invoice']) / quarterly_invoice['prev_quarter_invoice']
    # Variance of growth_rate per customer (excluding NaN)
    var_growth = quarterly_invoice.groupby('customer_id')['growth_rate'].var().reset_index()
    var_growth.rename(columns={'growth_rate':'growth_rate_variance'}, inplace=True)
    var_growth.fillna(0, inplace=True)
    
    # Merge cv and var_growth
    metrics = pd.merge(cv[['customer_id','coeff_of_variation']], var_growth, on='customer_id', how='left')
    metrics['growth_rate_variance'].fillna(0, inplace=True)
    return metrics, high_vol_customers, threshold

def merge_with_customer_analytics(metrics, ca):
    df = pd.merge(metrics, ca, on='customer_id', how='left')
    return df

def plot_distribution(pa, threshold):
    # Distribution of customer_margin_volatility
    cust_vol = pa.groupby('customer_id')['customer_margin_volatility'].max().reset_index()
    plt.figure(figsize=(10,6))
    plt.hist(cust_vol['customer_margin_volatility'], bins=50, alpha=0.7, color='skyblue', edgecolor='black')
    plt.axvline(x=threshold, color='red', linestyle='--', linewidth=2, label=f'Top 25% threshold ({threshold:.2f})')
    plt.xlabel('Customer Margin Volatility')
    plt.ylabel('Frequency')
    plt.title('Distribution of Customer Margin Volatility')
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.savefig('volatility_distribution.png', dpi=300, bbox_inches='tight')
    plt.close()

def plot_cv_vs_variance(metrics_df):
    plt.figure(figsize=(10,6))
    plt.scatter(metrics_df['coeff_of_variation'], metrics_df['growth_rate_variance'], alpha=0.7, edgecolors='k')
    plt.xlabel('Coefficient of Variation (Std/Mean of Gross Profit)')
    plt.ylabel('Variance of Quarter-over-Quarter Growth Rate')
    plt.title('Profit Stability Metrics for High-Volatility Customers')
    plt.grid(True, alpha=0.3)
    # Log scale if needed
    if metrics_df['growth_rate_variance'].max() > 10 * metrics_df['growth_rate_variance'].median():
        plt.yscale('log')
    plt.savefig('cv_vs_variance.png', dpi=300, bbox_inches='tight')
    plt.close()

def plot_behavioral_features(merged_df):
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    # RFM Segment
    rfm_counts = merged_df['rfm_segment'].value_counts().head(10)
    axes[0,0].bar(rfm_counts.index, rfm_counts.values, color='lightcoral')
    axes[0,0].set_xlabel('RFM Segment')
    axes[0,0].set_ylabel('Count')
    axes[0,0].set_title('High-Volatility Customers by RFM Segment')
    axes[0,0].tick_params(axis='x', rotation=45)
    # Payment Behavior
    pay_counts = merged_df['payment_behavior'].value_counts()
    axes[0,1].bar(pay_counts.index, pay_counts.values, color='lightgreen')
    axes[0,1].set_xlabel('Payment Behavior')
    axes[0,1].set_ylabel('Count')
    axes[0,1].set_title('High-Volatility Customers by Payment Behavior')
    axes[0,1].tick_params(axis='x', rotation=45)
    # Lifecycle Stage
    life_counts = merged_df['lifecycle_stage'].value_counts()
    axes[1,0].bar(life_counts.index, life_counts.values, color='lightblue')
    axes[1,0].set_xlabel('Lifecycle Stage')
    axes[1,0].set_ylabel('Count')
    axes[1,0].set_title('High-Volatility Customers by Lifecycle Stage')
    axes[1,0].tick_params(axis='x', rotation=45)
    # Risk Assessment
    risk_counts = merged_df['risk_assessment'].value_counts()
    axes[1,1].bar(risk_counts.index, risk_counts.values, color='orange')
    axes[1,1].set_xlabel('Risk Assessment')
    axes[1,1].set_ylabel('Count')
    axes[1,1].set_title('High-Volatility Customers by Risk Assessment')
    axes[1,1].tick_params(axis='x', rotation=45)
    plt.tight_layout()
    plt.savefig('behavioral_features.png', dpi=300, bbox_inches='tight')
    plt.close()

def plot_business_health_vs_volatility(merged_df, fd):
    # For each high-volatility customer, we need their contribution to business_health_score? Not directly.
    # Maybe use the latest business_health_score and compare with collection_rate_percentage over time.
    # Instead, we can plot the distribution of business_health_score across months and highlight months where high-volatility customers contributed more? Hard.
    # Simpler: show correlation between volatility metrics and revenue_trend_correlation.
    if 'revenue_trend_correlation' in merged_df.columns:
        plt.figure(figsize=(10,6))
        plt.scatter(merged_df['coeff_of_variation'], merged_df['revenue_trend_correlation'], alpha=0.7, edgecolors='k')
        plt.xlabel('Coefficient of Variation (Profit Stability)')
        plt.ylabel('Revenue Trend Correlation')
        plt.title('Volatility vs. Revenue Trend Correlation')
        plt.grid(True, alpha=0.3)
        plt.savefig('volatility_vs_revenue_trend.png', dpi=300, bbox_inches='tight')
        plt.close()
    # Also plot collection rate percentage over time from financial_dashboard
    if not fd.empty:
        fd = fd.sort_values('dashboard_month')
        plt.figure(figsize=(10,6))
        plt.plot(fd['dashboard_month'], fd['collection_rate_percentage'], marker='o', linestyle='-', color='green')
        plt.xlabel('Month')
        plt.ylabel('Collection Rate Percentage')
        plt.title('Collection Rate Over Time')
        plt.grid(True, alpha=0.3)
        plt.savefig('collection_rate_trend.png', dpi=300, bbox_inches='tight')
        plt.close()

def plot_accounts_receivable(bs):
    if bs.empty:
        return
    # Aggregate by account_class
    class_totals = bs.groupby('account_class')['amount'].sum().reset_index()
    plt.figure(figsize=(8,8))
    plt.pie(class_totals['amount'], labels=class_totals['account_class'], autopct='%1.1f%%', startangle=90)
    plt.title('Accounts Receivable Structure by Account Class')
    plt.savefig('receivable_structure.png', dpi=300, bbox_inches='tight')
    plt.close()

def main():
    pa, ca, fd, bs = load_data()
    metrics, high_vol_customers, threshold = compute_volatility_metrics(pa)
    merged_df = merge_with_customer_analytics(metrics, ca)
    print(f'Metrics shape: {metrics.shape}')
    print(f'Merged shape: {merged_df.shape}')
    
    plot_distribution(pa, threshold)
    plot_cv_vs_variance(metrics)
    plot_behavioral_features(merged_df)
    plot_business_health_vs_volatility(merged_df, fd)
    plot_accounts_receivable(bs)
    
    # Save metrics for reference
    metrics.to_csv('high_vol_customers_metrics.csv', index=False)
    merged_df.to_csv('high_vol_customers_merged.csv', index=False)
    print('Plots created.')

if __name__ == '__main__':
    main()
''')
