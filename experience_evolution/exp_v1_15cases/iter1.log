'''
import sqlite3
import pandas as pd
import numpy as np
import datetime

conn = sqlite3.connect('dacomp-092.sqlite')

# Helper function to handle missing data
print("=== High-Volatility Customer Analysis ===")

# 1. Identify high-volatility customers (top 25% by avg customer_margin_volatility)
query_cust_vol = """
SELECT customer_id, AVG(customer_margin_volatility) as avg_vol
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql_query(query_cust_vol, conn)
threshold = df_cust_vol['avg_vol'].quantile(0.75)
high_vol_customers = df_cust_vol[df_cust_vol['avg_vol'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers: {len(high_vol_customers)} (top 25%, threshold={threshold:.4f})")

# 2. Define past 12 months window
max_date = pd.read_sql_query("SELECT MAX(transaction_date) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'].iloc[0]
max_date = pd.to_datetime(max_date)
start_date = max_date - pd.DateOffset(months=12)
print(f"Analysis window: {start_date.date()} to {max_date.date()}")

placeholders = ','.join(['?'] * len(high_vol_customers))

# 3. Coefficient of Variation of gross profit (monthly)
query_invoices = f"""
SELECT customer_id, transaction_date, gross_profit, invoice_total
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({placeholders})
AND DATE(transaction_date) >= DATE(?)
"""
df_invoices = pd.read_sql_query(query_invoices, conn, params=high_vol_customers + [start_date.strftime('%Y-%m-%d')])
df_invoices['transaction_date'] = pd.to_datetime(df_invoices['transaction_date'])
df_invoices['month'] = df_invoices['transaction_date'].dt.to_period('M')

monthly = df_invoices.groupby(['customer_id', 'month']).agg(
    monthly_gross_profit=('gross_profit', 'sum')
).reset_index()

cv_list = []
for cust in high_vol_customers:
    cust_data = monthly[monthly['customer_id'] == cust]
    if len(cust_data) >= 2:
        std = cust_data['monthly_gross_profit'].std()
        mean = cust_data['monthly_gross_profit'].mean()
        cv = std / mean if mean != 0 else np.nan
        cv_list.append({'customer_id': cust, 'cv_gross_profit': cv, 'months_count': len(cust_data)})
cv_df = pd.DataFrame(cv_list)
print(f"Coefficient of variation computed for {len(cv_df)} customers (>=2 months).")
print(f"Average CV: {cv_df['cv_gross_profit'].mean():.3f}")

# 4. Variance of quarter-over-quarter invoice_total growth rate
df_invoices['quarter'] = df_invoices['transaction_date'].dt.to_period('Q')
quarterly = df_invoices.groupby(['customer_id', 'quarter']).agg(
    quarter_invoice_total=('invoice_total', 'sum')
).reset_index()
quarterly = quarterly.sort_values(['customer_id', 'quarter'])
quarterly['prev_quarter'] = quarterly.groupby('customer_id')['quarter_invoice_total'].shift(1)
quarterly['growth_rate'] = (quarterly['quarter_invoice_total'] - quarterly['prev_quarter']) / quarterly['prev_quarter']
growth_var = quarterly.groupby('customer_id')['growth_rate'].var().reset_index(name='variance_growth_rate')
print(f"Variance of growth rate computed for {len(growth_var)} customers.")
print(f"Average variance: {growth_var['variance_growth_rate'].mean():.3f}")

# 5. Behavioral features from customer_analytics
query_cust = f"""
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
       lifecycle_stage, customer_maturity_stage, credit_score, risk_assessment
FROM quickbooks__customer_analytics
WHERE customer_id IN ({placeholders})
"""
df_cust = pd.read_sql_query(query_cust, conn, params=high_vol_customers)

# Merge
profile = pd.merge(cv_df, growth_var, on='customer_id', how='left')
profile = pd.merge(profile, df_cust, on='customer_id', how='left')
print(f"Profile shape: {profile.shape}")

# 6. Contributions to overall financial metrics
# Overall totals from profitability_analysis (entire dataset)
query_overall = """
SELECT 
    SUM(invoice_total) as total_invoice,
    SUM(collected_amount) as total_collected,
    SUM(outstanding_balance) as total_outstanding,
    SUM(gross_profit) as total_profit,
    COUNT(DISTINCT customer_id) as total_customers
FROM quickbooks__profitability_analysis
"""
total_overall = pd.read_sql_query(query_overall, conn)

query_high = f"""
SELECT 
    SUM(invoice_total) as total_invoice,
    SUM(collected_amount) as total_collected,
    SUM(outstanding_balance) as total_outstanding,
    SUM(gross_profit) as total_profit,
    COUNT(DISTINCT customer_id) as total_customers
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({placeholders})
"""
total_high = pd.read_sql_query(query_high, conn, params=high_vol_customers)

contributions = {}
