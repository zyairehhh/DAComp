query = """
SELECT date_day, overall_performance_score, research_budget_usd 
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor' 
ORDER BY date_day
"""
df = pd.read_sql_query(query, conn)
df['date_day'] = pd.to_datetime(df['date_day'])

fig, ax1 = plt.subplots(figsize=(10, 6))

color = 'tab:blue'
ax1.set_xlabel('Date')
ax1.set_ylabel('Overall Performance Score', color=color)
ax1.plot(df['date_day'], df['overall_performance_score'], marker='o', color=color, label='Performance Score')
ax1.tick_params(axis='y', labelcolor=color)
ax1.set_ylim(70, 90)

ax2 = ax1.twinx()
color = 'tab:red'
ax2.set_ylabel('Research Budget (USD)', color=color)
ax2.plot(df['date_day'], df['research_budget_usd'], marker='s', color=color, linestyle='--', label='Research Budget')
ax2.tick_params(axis='y', labelcolor=color)

plt.title('Performance Score vs Research Budget Over Time')
fig.tight_layout()
plt.savefig('budget_vs_performance.png', dpi=300)
plt.close()

conn.close()
print('Generated budget_vs_performance.png')
''')
