Now, we need to produce a final report. Based on analysis, we can identify which departments need prioritized security awareness guidance. I'd consider multiple dimensions: per-user abnormal login rate, confirmed risk per user, proportion of users affected, and trends. Let's compute a composite score for each department.

I'll create a Python script to compute a normalized score.

Action: CreateFile(filepath="analysis.py"):
```
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-035.sqlite')

# 1. User counts per department
user_counts = pd.read_sql_query('SELECT "Department", COUNT(DISTINCT "User ID") as user_count FROM user_information_table GROUP BY "Department"', conn)

# 2. Abnormal logins per department
abnormal_counts = pd.read_sql_query('''
    SELECT u."Department", COUNT(a."Anomaly ID") as abnormal_count
    FROM abnormal_logins_table a
    LEFT JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    LEFT JOIN user_information_table u ON l."User ID" = u."User ID"
    GROUP BY u."Department"
''', conn)

# 3. Confirmed anomalies per department
confirmed_counts = pd.read_sql_query('''
    SELECT u."Department", COUNT(a."Anomaly ID") as confirmed_count,
        SUM(CASE 
                WHEN a."Risk Level" = 'Severe' THEN 3
                WHEN a."Risk Level" = 'High' THEN 2
                WHEN a."Risk Level" = 'Medium' THEN 1
                WHEN a."Risk Level" = 'Low' THEN 0.5
                ELSE 0 END) as weighted_confirmed
    FROM abnormal_logins_table a
    LEFT JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    LEFT JOIN user_information_table u ON l."User ID" = u."User ID"
    WHERE a."Confirmation Status" = 'Confirmed'
    GROUP BY u."Department"
''', conn)

# 4. Affected users per department (users with at least one abnormal login)
affected_users = pd.read_sql_query('''
    SELECT u."Department", COUNT(DISTINCT u."User ID") as affected_users
    FROM abnormal_logins_table a
    LEFT JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    LEFT JOIN user_information_table u ON l."User ID" = u."User ID"
    GROUP BY u."Department"
''', conn)

# Merge all metrics
df = user_counts.merge(abnormal_counts, on='Department', how='left')\
                .merge(confirmed_counts, on='Department', how='left')\
                .merge(affected_users, on='Department', how='left')

df['abnormal_per_user'] = df['abnormal_count'] / df['user_count']
df['confirmed_per_user'] = df['confirmed_count'] / df['user_count']
df['weighted_confirmed_per_user'] = df['weighted_confirmed'] / df['user_count']
df['affected_proportion'] = df['affected_users'] / df['user_count']

# Fill NaNs with zero
df = df.fillna(0)

# Normalize each metric to 0-1 scale (min-max) for combination
metrics = ['abnormal_per_user', 'confirmed_per_user', 'weighted_confirmed_per_user', 'affected_proportion']
for col in metrics:
    min_val = df[col].min()
    max_val = df[col].max()
    if max_val > min_val:
        df[col + '_norm'] = (df[col] - min_val) / (max_val - min_val)
    else:
        df[col + '_norm'] = 0.5

# Compute composite score (equal weight)
df['composite_score'] = df[[col + '_norm' for col in metrics]].mean(axis=1)
df_sorted = df.sort_values('composite_score', ascending=False)
print(df_sorted[['Department', 'user_count', 'abnormal_count', 'confirmed_count', 'weighted_confirmed', 'affected_users',
                 'abnormal_per_user', 'confirmed_per_user', 'weighted_confirmed_per_user', 'affected_proportion', 'composite_score']])

# Also compute monthly trends for each department (2024)
monthly = pd.read_sql_query('''
    SELECT u."Department", 
           strftime('%Y-%m', a."Detection Time") as month,
           COUNT(*) as count
    FROM abnormal_logins_table a
    LEFT JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    LEFT JOIN user_information_table u ON l."User ID" = u."User ID"
    WHERE a."Detection Time" IS NOT NULL
    GROUP BY u."Department", month
    ORDER BY u."Department", month
''', conn)
print("\nMonthly trend sample (first 20 rows):")
print(monthly.head(20))

conn.close()
```
