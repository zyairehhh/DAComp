plt.figure(figsize=(15, 10))

# 1. Visitor count distribution for high-traffic halls
plt.subplot(2, 3, 1)
if len(high_traffic_halls) > 0:
    plt.hist(high_traffic_halls['avg_visitor_count'], bins=20, edgecolor='black', alpha=0.7)
    plt.xlabel('Average Daily Visitor Count')
    plt.ylabel('Number of Exhibition Halls')
