import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import re

# Connect to database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Filter for vocational school education requirement
voc_df = df[df['Education Requirement'].str.contains('Vocational school', na=False)]

# Parse salary lower bound
def parse_salary_lower(salary_str):
    if pd.isna(salary_str):
        return None
    # Find first number before dash (lower bound)
    # Remove commas and non-numeric characters except dash and dot
    # Example: "3000-4000 yuan/month" -> 3000
    match = re.search(r'([\d,]+)\s*[-~]', str(salary_str))
    if match:
        num_str = match.group(1).replace(',', '')
        try:
            return float(num_str)
        except:
            return None
    # If no dash, maybe single number?
    match = re.search(r'([\d,]+)', str(salary_str))
    if match:
        num_str = match.group(1).replace(',', '')
        try:
            return float(num_str)
        except:
            return None
    return None

voc_df['salary_lower'] = voc_df['Salary Range'].apply(parse_salary_lower)
# Remove rows where salary_lower is null
salary_df = voc_df.dropna(subset=['salary_lower'])

print(f"Total vocational postings: {len(voc_df)}")
print(f"Valid salary rows: {len(salary_df)}")

# 1. Starting salary distribution histogram
plt.figure(figsize=(10, 6))
bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 30000]
labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-7k', '7k-8k', '8k-9k', '9k-10k', '10k-15k', '15k-20k', '≥20k']
salary_df['salary_bracket'] = pd.cut(salary_df['salary_lower'], bins=bins, labels=labels, right=False)
bracket_counts = salary_df['salary_bracket'].value_counts().sort_index()
plt.bar(bracket_counts.index, bracket_counts.values, color='skyblue')
plt.title('Distribution of Starting Salaries for Vocational School Graduates')
plt.xlabel('Salary Bracket (yuan/month)')
plt.ylabel('Number of Job Postings')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('starting_salary_distribution.png', dpi=300)
plt.close()

# 2. Benefits distribution
def split_benefits(benefits_str):
    if pd.isna(benefits_str):
        return []
    # Split by common separators: comma, semicolon, Chinese punctuation ，；、.
    separators = r'[,，;；、.\s]+'
    items = re.split(separators, str(benefits_str))
    # Strip whitespace and filter empty
    items = [item.strip() for item in items if item.strip()]
    return items

all_benefits = []
for benefits in voc_df['Benefits'].dropna():
    all_benefits.extend(split_benefits(benefits))

# Count frequencies
benefit_counts = pd.Series(all_benefits).value_counts()
top_n = 15
top_benefits = benefit_counts.head(top_n)

plt.figure(figsize=(12, 6))
plt.barh(range(len(top_benefits)), top_benefits.values, color='lightgreen')
plt.yticks(range(len(top_benefits)), top_benefits.index)
plt.gca().invert_yaxis()  # highest on top
plt.title(f'Top {top_n} Benefits for Vocational School Graduates')
plt.xlabel('Number of Mentions')
plt.tight_layout()
plt.savefig('top_benefits.png', dpi=300)
plt.close()

# 3. Work experience requirement vs average starting salary
# Define mapping of experience categories from report
# We can compute from raw data
def categorize_experience(exp_str):
    if pd.isna(exp_str):
        return None
    exp_lower = str(exp_str).lower()
    if 'eight years or more' in exp_lower or '8 years or more' in exp_lower:
        return 'Eight years or more'
    if 'ten years or more' in exp_lower or '10 years or more' in exp_lower:
        return 'Ten years or more'
    if 'five years or more' in exp_lower or '5 years or more' in exp_lower:
        return 'Five years or more'
    if 'four years or more' in exp_lower or '4 years or more' in exp_lower:
        return 'Four years or more'
    if 'three years or more' in exp_lower or '3 years or more' in exp_lower:
        return 'Three years or more'
    if 'two years or more' in exp_lower or '2 years or more' in exp_lower:
        return 'Two years or more'
    if 'no limit' in exp_lower or 'unlimited' in exp_lower:
        return 'No limit'
    if 'more than one year' in exp_lower or '1 year' in exp_lower:
        return 'More than one year'
    if 'fresh graduate' in exp_lower:
        return 'Fresh graduates'
    # default
    return None

salary_df['exp_category'] = salary_df['Work Experience Requirement'].apply(categorize_experience)
exp_salary = salary_df.dropna(subset=['exp_category']).groupby('exp_category')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)

plt.figure(figsize=(10, 6))
bars = plt.bar(exp_salary.index, exp_salary['mean'], color='coral')
plt.title('Average Starting Salary by Work Experience Requirement')
plt.xlabel('Experience Requirement')
plt.ylabel('Average Starting Salary (yuan/month)')
plt.xticks(rotation=45, ha='right')
# Add count labels on bars
for bar, count in zip(bars, exp_salary['count']):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 50, f'n={count}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('experience_vs_salary.png', dpi=300)
plt.close()

print("Plots generated.")
```
