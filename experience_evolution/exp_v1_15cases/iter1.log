import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/workspace/dacomp-041.sqlite')

# High-traffic halls
high_halls = pd.read_sql_query("""
    SELECT `Exhibition Hall Record ID`, `Daily Visitor Count`, `Visitor Traffic`
    FROM gallery_information
    WHERE `Daily Visitor Count` > 900
""", conn)

print("Number of high-traffic halls:", len(high_halls))
print(high_halls.head())

# Display cases in these halls
display_cases = pd.read_sql_query("""
    SELECT dci.`Display case ID`, dci.`Gallery reference`, dci.`Airtightness`, dci.`Display case material`,
           dci.`Seal status`, dci.`Maintenance Status`, dci.`Filter status`, dci.`Silica gel status`
    FROM display_case_information AS dci
    JOIN gallery_information AS gi ON dci.`Gallery reference` = gi.`Exhibition Hall Record ID`
    WHERE gi.`Daily Visitor Count` > 900
""", conn)

print("\nNumber of display cases in high-traffic halls:", len(display_cases))
print(display_cases.head())

# Environmental monitoring data for those display cases
env_data = pd.read_sql_query("""
    SELECT emd.`Display Case Reference`, emd.`Temperature (°C)`, emd.`Relative Humidity (%)`,
           emd.`24-hour Temperature Change`, emd.`24-hour Humidity Change`, emd.`Atmospheric Pressure (hPa)`
    FROM environmental_monitoring_data AS emd
    WHERE emd.`Display Case Reference` IN (
        SELECT dci.`Display case ID`
        FROM display_case_information AS dci
        JOIN gallery_information AS gi ON dci.`Gallery reference` = gi.`Exhibition Hall Record ID`
        WHERE gi.`Daily Visitor Count` > 900
    )
""", conn)

print("\nEnvironmental monitoring records count:", len(env_data))
if len(env_data) > 0:
    print(env_data.head())
else:
    print("No environmental data found for these display cases.")

# Air quality readings linked via environmental monitoring reference? Need to join with environmental_monitoring_data on Environmental Reading ID.
air_quality = pd.read_sql_query("""
    SELECT aqr.`Environmental monitoring reference`, aqr.`Carbon dioxide concentration (ppm)`,
           aqr.`Total volatile organic compounds concentration (ppb)`, aqr.`Ozone concentration (ppb)`,
           aqr.`Sulfur dioxide concentration (ppb)`, aqr.`Nitrogen dioxide concentration (ppb)`,
           aqr.`PM2.5 concentration`, aqr.`PM10 concentration`, aqr.`Formaldehyde concentration`,
           aqr.`Air exchange rate`, aqr.`Airflow velocity (m/s)`
    FROM air_quality_readings AS aqr
    WHERE aqr.`Environmental monitoring reference` IN (
        SELECT emd.`Environmental Reading ID`
        FROM environmental_monitoring_data AS emd
        WHERE emd.`Display Case Reference` IN (
            SELECT dci.`Display case ID`
            FROM display_case_information AS dci
            JOIN gallery_information AS gi ON dci.`Gallery reference` = gi.`Exhibition Hall Record ID`
            WHERE gi.`Daily Visitor Count` > 900
        )
    )
""", conn)

print("\nAir quality records count:", len(air_quality))
if len(air_quality) > 0:
    print(air_quality.head())
else:
    print("No air quality data found.")

# Light and radiation readings
light_rad = pd.read_sql_query("""
    SELECT lrr.`Environmental monitoring reference`, lrr.`Illuminance (Lux)`,
           lrr.`UV Irradiance (μW/cm²)`, lrr.`IR Irradiance (W/m²)`,
           lrr.`Visible Light Exposure (Lx·h)`
    FROM light_and_radiation_readings AS lrr
    WHERE lrr.`Environmental monitoring reference` IN (
        SELECT emd.`Environmental Reading ID`
        FROM environmental_monitoring_data AS emd
        WHERE emd.`Display Case Reference` IN (
            SELECT dci.`Display case ID`
            FROM display_case_information AS dci
            JOIN gallery_information AS gi ON dci.`Gallery reference` = gi.`Exhibition Hall Record ID`
            WHERE gi.`Daily Visitor Count` > 900
        )
    )
""", conn)

print("\nLight and radiation records count:", len(light_rad))
if len(light_rad) > 0:
    print(light_rad.head())
else:
    print("No light/radiation data found.")

# Condition assessments for artifacts in those display cases
condition = pd.read_sql_query("""
    SELECT ca.`Inspected Cultural Relic Reference`, ca.`Inspected Display Case Reference`,
           ca.`Condition Assessment Rating`, ca.`Conservation Assessment Date`
    FROM condition_assessment AS ca
    WHERE ca.`Inspected Display Case Reference` IN (
        SELECT dci.`Display case ID`
        FROM display_case_information AS dci
        JOIN gallery_information AS gi ON dci.`Gallery reference` = gi.`Exhibition Hall Record ID`
        WHERE gi.`Daily Visitor Count` > 900
    )
""", conn)

print("\nCondition assessment records count:", len(condition))
if len(condition) > 0:
    print(condition.head())
else:
    print("No condition assessments found.")

# Artifact ratings (basic artifact info and ratings)
artifact_ratings = pd.read_sql_query("""
    SELECT ar.`Cultural Relic Reference Number`, ar.`Historical Significance Rating`,
           ar.`Research Value Rating`, ar.`Exhibition Value Rating`, ar.`Cultural Value Score`,
           ar.`Public Accessibility Rating`, ar.`Educational Value Rating`, ar.`Conservation Difficulty`,
           ar.`Treatment Complexity`, ar.`Material Stability`, ar.`Deterioration Rate`
    FROM artifact_rating AS ar
    WHERE ar.`Cultural Relic Reference Number` IN (
        SELECT ca.`Inspected Cultural Relic Reference`
        FROM condition_assessment AS ca
        WHERE ca.`Inspected Display Case Reference` IN (
            SELECT dci.`Display case ID`
            FROM display_case_information AS dci
            JOIN gallery_information AS gi ON dci.`Gallery reference` = gi.`Exhibition Hall Record ID`
            WHERE gi.`Daily Visitor Count` > 900
        )
    )
""", conn)

print("\nArtifact rating records count:", len(artifact_ratings))
if len(artifact_ratings) > 0:
    print(artifact_ratings.head())

conn.close()
```

