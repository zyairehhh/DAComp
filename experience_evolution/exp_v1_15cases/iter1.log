import sqlite3
import pandas as pd

conn = sqlite3.connect('/workspace/dacomp-022.sqlite')

# Average fare per km by vehicle type
avg_fare = pd.read_sql_query("""
SELECT `Vehicle Type`,
       AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
       AVG(`Booking Value`) as avg_booking_value,
       AVG(`Ride Distance`) as avg_distance_km,
       COUNT(*) as completed_rides,
       SUM(`Booking Value`) as total_earnings
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY `Vehicle Type`
ORDER BY avg_fare_per_km DESC
""", conn)

print("=== Vehicle Type Performance (Completed Rides) ===")
print(avg_fare.to_string())

# Hourly peak earnings
hourly = pd.read_sql_query("""
SELECT `Vehicle Type`,
       CAST(substr(Time, 1, 2) AS INTEGER) as hour,
       COUNT(*) as rides,
       AVG(`Booking Value` / `Ride Distance`) as fare_per_km,
       AVG(`Booking Value`) as avg_booking,
       AVG(`Ride Distance`) as avg_distance,
       SUM(`Booking Value`) as total_earnings
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY `Vehicle Type`, hour
""", conn)

# For each vehicle type, get top hours by fare per km (rides > 100)
top_fare = hourly[hourly['rides'] > 100].sort_values(['Vehicle Type', 'fare_per_km'], ascending=[True, False])
top_fare = top_fare.groupby('Vehicle Type').head(3).reset_index(drop=True)
print("\n=== Top Hours by Fare per KM (rides > 100) ===")
print(top_fare[['Vehicle Type', 'hour', 'fare_per_km', 'rides', 'total_earnings']].to_string())

# For each vehicle type, get top hours by total earnings
top_earnings = hourly.sort_values(['Vehicle Type', 'total_earnings'], ascending=[True, False])
top_earnings = top_earnings.groupby('Vehicle Type').head(3).reset_index(drop=True)
print("\n=== Top Hours by Total Earnings ===")
print(top_earnings[['Vehicle Type', 'hour', 'total_earnings', 'rides', 'fare_per_km']].to_string())

# Driver ratings vs fare per km
rating_fare = pd.read_sql_query("""
SELECT CASE 
         WHEN `Driver Ratings` < 3.5 THEN 'Low (<3.5)'
         WHEN `Driver Ratings` < 4.0 THEN 'Mid (3.5-4.0)'
         WHEN `Driver Ratings` < 4.5 THEN 'High (4.0-4.5)'
         WHEN `Driver Ratings` <= 5.0 THEN 'Very High (4.5-5.0)'
         ELSE 'No Rating'
       END as rating_group,
       AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
       AVG(`Booking Value`) as avg_booking,
       AVG(`Ride Distance`) as avg_distance,
       COUNT(*) as rides
FROM sheet1
WHERE `Booking Status` = 'Completed' AND `Driver Ratings` IS NOT NULL
GROUP BY rating_group
ORDER BY avg_fare_per_km DESC
""", conn)
print("\n=== Fare per KM by Driver Rating Group ===")
print(rating_fare.to_string())

# Customer rating vs fare (optional)
cust_rating_fare = pd.read_sql_query("""
SELECT CASE 
         WHEN `Customer Rating` < 3.5 THEN 'Low (<3.5)'
         WHEN `Customer Rating` < 4.0 THEN 'Mid (3.5-4.0)'
         WHEN `Customer Rating` < 4.5 THEN 'High (4.0-4.5)'
         WHEN `Customer Rating` <= 5.0 THEN 'Very High (4.5-5.0)'
         ELSE 'No Rating'
       END as cust_rating_group,
       AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
       AVG(`Booking Value`) as avg_booking,
       AVG(`Ride Distance`) as avg_distance,
       COUNT(*) as rides
FROM sheet1
WHERE `Booking Status` = 'Completed' AND `Customer Rating` IS NOT NULL
GROUP BY cust_rating_group
ORDER BY avg_fare_per_km DESC
""", conn)
print("\n=== Fare per KM by Customer Rating Group ===")
print(cust_rating_fare.to_string())

conn.close()
```

