import pandas as pd
import numpy as np

results = pd.read_csv('promotion_sales_analysis.csv')
cat_stats = pd.read_csv('category_stats.csv')

print("=== Overview ===")
print(f"Total promotions: {len(results)}")
print(f"Promotions with zero sales: {(results['total_qty'] == 0).sum()}")
print(f"Promotions with positive sales: {(results['total_qty'] > 0).sum()}")

# Filter out promotions with zero sales for correlation analysis
non_zero = results[results['total_qty'] > 0]
print(f"\nNon-zero sales promotions: {len(non_zero)}")
corr = non_zero['discount_depth'].corr(non_zero['total_qty'])
print(f"Correlation (non-zero only) between discount depth and quantity: {corr:.3f}")

# Overall correlation (including zeros)
corr_overall = results['discount_depth'].corr(results['total_qty'])
print(f"Overall correlation (including zero-sales promotions): {corr_overall:.3f}")

# Compute average discount depth and average quantity per category
category_summary = results.groupby('l1_cat_name').agg(
    num_promotions=('promo_id', 'count'),
    avg_discount=('discount_depth', 'mean'),
    total_qty=('total_qty', 'sum'),
    total_rev=('total_rev', 'sum'),
    avg_qty_per_promo=('total_qty', 'mean'),
    avg_rev_per_promo=('total_rev', 'mean')
).reset_index()
category_summary = category_summary.sort_values('total_qty', ascending=False)
print("\n=== Category Performance (sorted by total quantity sold) ===")
print(category_summary.to_string())

# Simple linear approximation of elasticity using covariance
cov = non_zero['discount_depth'].cov(non_zero['total_qty'])
var = non_zero['discount_depth'].var()
if var > 0:
    slope = cov / var
else:
    slope = 0
print(f"\nApproximate elasticity (slope from covariance): {slope:.2f}")
print("Interpretation: each unit increase in discount depth (1 = 100%) corresponds to {slope:.0f} units increase in quantity.")

# Identify top-performing categories
top_cats = category_summary[category_summary['total_qty'] > 0].head(5)
print("\n=== Top Categories by Quantity ===")
for idx, row in top_cats.iterrows():
    print(f"{row['l1_cat_name']}: {row['total_qty']} units, avg discount {row['avg_discount']:.2%}, avg qty per promo {row['avg_qty_per_promo']:.1f}")

# Identify categories with high discount but low sales
high_discount = results[results['discount_depth'] > 0.5]
print(f"\nPromotions with discount depth > 50%: {len(high_discount)}")
print(high_discount[['l1_cat_name', 'discount_depth', 'total_qty']].sort_values('discount_depth', ascending=False).head(10).to_string())

# Examine zero-sales promotions by category
zero_by_cat = results[results['total_qty'] == 0].groupby('l1_cat_name').size().reset_index(name='zero_count')
print("\n=== Zero-sales promotions by category ===")
print(zero_by_cat.to_string())

# Recommendations
print("\n=== Preliminary Recommendations ===")
print("1. Focus promotion resources on categories with high responsiveness: Daily Delivery/Refrigerated shows highest total quantity sold (1,528 units) and average quantity per promotion (274.3).")
print("2. Discount depth correlation with sales quantity is weak overall (0.239), but among promotions that actually generated sales, correlation is strong (0.856). This indicates that discount depth matters only when the promotion is effective; many promotions with discounts yielded zero sales for other reasons.")
print("3. Some categories (e.g., Imported Goods, Medical Equipment) recorded zero sales despite promotions; investigate product‑market fit or promotion execution.")
print("4. Consider A/B testing with tiered discount levels within high‑performing categories to identify optimal discount depth.")
print("5. For categories with low sales despite high discount depth, evaluate competition, pricing strategy, or promotion timing.")
```
