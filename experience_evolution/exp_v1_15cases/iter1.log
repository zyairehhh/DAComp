print(df_source[['source_name', 'total_hires', 'cost_per_hire', 'total_cost']])
print("Total recruitment cost:", total_cost_current)
print("Average cost per hire:", total_cost_current / df_source['total_hires'].sum())

# compute cost per hire weighted
cost_per_hire_weighted = total_cost_current / df_source['total_hires'].sum()
print("\nWeighted average cost per hire:", cost_per_hire_weighted)

# compute needed reduction of 15%
target_cost = total_cost_current * 0.85
print("Target cost (15% reduction):", target_cost)
print("Required savings:", total_cost_current - target_cost)

# compute current diversity metrics
female_hire_rep = df_div['female_hire_representation'].iloc[0]
non_white_hire_rep = df_div['non_white_hire_representation'].iloc[0]
print("Current female hire representation:", female_hire_rep)
print("Current non-white hire representation:", non_white_hire_rep)

# we need to maintain >=40% female, >=30% non-white
print("Diversity targets: Female >=40%, Non-white >=30%")
print("Current diversity meets targets:", female_hire_rep >= 40 and non_white_hire_rep >= 30)

# interviewer satisfaction (average rating per interview) - we need to ensure >4.0
# compute average rating per interviewer with at least 5 interviews
df_interviewer = pd.read_sql_query("""
SELECT interviewer_name, AVG(rating) as avg_rating, COUNT(*) as num_scorecards
FROM greenhouse__interview_scorecard_detail 
WHERE interviewer_name IS NOT NULL AND rating IS NOT NULL
GROUP BY interviewer_name
HAVING COUNT(*) >= 5
ORDER BY avg_rating DESC
""", conn)
print("\nInterviewer satisfaction (top 10):")
print(df_interviewer.head(10))
print("\nInterviewer satisfaction (bottom 10):")
print(df_interviewer.tail(10))
print("Overall average rating across all scorecards:", df_rating['rating'].dot(df_rating['cnt']) / df_rating['cnt'].sum())

# compute retention rates per stage
# we can approximate funnel: application -> interview -> hire
# from talent pipeline data, compute interview_rate = applications_with_interviews / total_applications
df_source['interview_rate'] = df_source['applications_with_interviews'] / df_source['total_applications']
print("\nSource interview rates:")
print(df_source[['source_name', 'interview_rate', 'hire_rate']])

# overall interview rate
total_interviews = df_source['applications_with_interviews'].sum()
total_apps = df_source['total_applications'].sum()
print("Overall interview rate:", total_interviews / total_apps)
print("Overall hire rate:", df_source['total_hires'].sum() / total_apps)
print("Interview to hire rate (overall):", df_source['total_hires'].sum() / total_interviews)

conn.close()
''')
