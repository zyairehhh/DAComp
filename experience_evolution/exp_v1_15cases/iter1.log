Action: CreateFile(filepath='top_field.py':
'''
import sqlite3
import re
from collections import Counter

conn = sqlite3.connect('dacomp-081.sqlite')
cur = conn.cursor()
cur.execute("SELECT embedded_data FROM qualtrics__response WHERE embedded_data LIKE '%custom_field_%'")
rows = cur.fetchall()
pattern = re.compile(r'custom_field_(\d+)')
counter = Counter()
for row in rows:
    ed = row[0]
    matches = pattern.findall(ed)
    for m in matches:
        counter[m] += 1
print("Top custom fields by occurrence:")
for field, cnt in counter.most_common(10):
    print(f"custom_field_{field}: {cnt} occurrences")
''')
