'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo data
geo_df = pd.read_sql_query("SELECT * FROM google_play__geo_market_analysis WHERE package_name = 'com.dev.photoeditor'", conn)

# Split by revenue metric: using avg_transaction_value > 30 as high, <=30 as low
geo_df['revenue_group'] = np.where(geo_df['avg_transaction_value'] > 30, 'high', 'low')

# Compare performance metrics
metrics = ['overall_market_score', 'app_quality_score', 'daily_churn_rate', 'day_30_retention_rate', 'weekly_growth_rate', 'store_conversion_rate', 'market_size_score', 'revenue_opportunity_score', 'growth_potential_score', 'user_quality_score', 'store_performance_score']
group_stats = geo_df.groupby('revenue_group')[metrics].mean()
print("Average performance metrics by revenue group:")
print(group_stats.T)
print()

# Let's also compute median
print("Median performance metrics by revenue group:")
for col in metrics:
    high_median = geo_df[geo_df['revenue_group'] == 'high'][col].median()
    low_median = geo_df[geo_df['revenue_group'] == 'low'][col].median()
    print(f"{col}: High={high_median:.2f}, Low={low_median:.2f}, Diff={high_median - low_median:.2f}")

# Load finance report and compute monthly revenue per region
finance_df = pd.read_sql_query("SELECT country_long, region, date_day, net_amount, transactions FROM google_play__finance_report WHERE package_name = 'com.dev.photoeditor'", conn)
finance_df['date_day'] = pd.to_datetime(finance_df['date_day'])
finance_df['month'] = finance_df['date_day'].dt.to_period('M')

# Merge with geo grouping
country_to_group = geo_df.set_index('country_name')['revenue_group'].to_dict()
finance_df['revenue_group'] = finance_df['country_long'].map(country_to_group)
# Some countries may not have geo data; drop NA
finance_df = finance_df.dropna(subset=['revenue_group'])

# Compute monthly revenue per group
monthly_group = finance_df.groupby(['month', 'revenue_group']).agg({'net_amount': 'sum', 'transactions': 'sum'}).reset_index()
print("\nMonthly revenue by group (first few rows):")
print(monthly_group.head())

# Compute growth rate per group
monthly_group = monthly_group.sort_values(['revenue_group', 'month'])
monthly_group['prev_net'] = monthly_group.groupby('revenue_group')['net_amount'].shift(1)
monthly_group['monthly_growth'] = (monthly_group['net_amount'] - monthly_group['prev_net']) / monthly_group['prev_net'] * 100
print(monthly_group[['month', 'revenue_group', 'net_amount', 'monthly_growth']].head(10))

# Load comprehensive dashboard for overall_performance_score over time
comp_df = pd.read_sql_query("SELECT date_day, overall_performance_score, research_budget_usd FROM google_play__comprehensive_performance_dashboard WHERE package_name = 'com.dev.photoeditor' ORDER BY date_day", conn)
comp_df['date_day'] = pd.to_datetime(comp_df['date_day'])
print("\nOverall performance trend:")
print(comp_df)

# Calculate correlation between research budget and performance score? Not much.

conn.close()

# Output to CSV for further investigation
group_stats.T.to_csv('group_stats.csv')
monthly_group.to_csv('monthly_group_revenue.csv')
''')
