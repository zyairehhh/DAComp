import pandas as pd

df = pd.read_csv('user_value_scores.csv')
print("=== Composite score by language ===")
group = df.groupby('language')['composite_score'].agg(['mean', 'median', 'std', 'count']).round(2)
print(group.sort_values('mean', ascending=False))

# Segment distribution per language
seg_counts = pd.crosstab(df['language'], df['segment'], normalize='index') * 100
print("\n=== Segment % per language ===")
print(seg_counts.round(1))

# Transition: compute proportion of medium_value users moving to high_value? Not time-series.
# Instead we can compare medium vs high within each language.
print("\n=== Behavioral metrics by language for medium and high segments ===")
for lang in df['language'].unique():
    sub = df[df['language'] == lang]
    med = sub[sub['segment'] == 'medium_value']
    high = sub[sub['segment'] == 'high_value']
    if len(med) > 10 and len(high) > 10:
        print(f"\nLanguage: {lang}")
        # Compare participation frequency
        part_diff = high['total_count_surveys'].mean() - med['total_count_surveys'].mean()
        comp_diff = high['completion_rate'].mean() - med['completion_rate'].mean()
        channel_diff = high['channel_distinct'].mean() - med['channel_distinct'].mean()
        print(f"  Participation diff (high - med): {part_diff:.1f}")
        print(f"  Completion rate diff: {comp_diff:.3f}")
        print(f"  Channel distinct diff: {channel_diff:.2f}")
''')
