import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import os

db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter1/dacomp-069/stage2_env/dacomp-069.sqlite"

# Connect to database
conn = sqlite3.connect(db_path)

# 1. Overall performance score over time
query1 = """
SELECT date_day, overall_performance_score
FROM google_play__comprehensive_performance_dashboard
WHERE package_name = 'com.dev.photoeditor'
ORDER BY date_day;
"""
df_score = pd.read_sql_query(query1, conn)
df_score['date_day'] = pd.to_datetime(df_score['date_day'])

# Plot 1: Performance Trend
plt.figure(figsize=(10, 6))
plt.plot(df_score['date_day'], df_score['overall_performance_score'], marker='o')
plt.title('Overall Performance Score Over Time for com.dev.photoeditor')
plt.xlabel('Date')
plt.ylabel('Performance Score')
plt.grid(True, linestyle='--', alpha=0.7)
plt.ylim(70, 90)
plt.tight_layout()
plt.savefig('/workspace/performance_score_trend.png', dpi=300)
plt.close()

# 2. Regional comparison: high vs low average_revenue_per_user
query2 = """
SELECT country_name, region, avg_daily_installs, avg_active_devices,
       weekly_growth_rate, avg_daily_revenue, average_revenue_per_user,
       day_30_retention_rate, daily_churn_rate, app_quality_score,
       overall_market_score
FROM google_play__geo_market_analysis
WHERE package_name = 'com.dev.photoeditor'
ORDER BY average_revenue_per_user DESC;
"""
df_region = pd.read_sql_query(query2, conn)

# Identify top and bottom markets by average_revenue_per_user
threshold_high = 20  # high revenue per user
threshold_low = 10   # low revenue per user
df_high = df_region[df_region['average_revenue_per_user'] >= threshold_high]
df_low = df_region[df_region['average_revenue_per_user'] < threshold_low]

print(f"High revenue markets: {df_high['country_name'].tolist()}")
print(f"Low revenue markets: {df_low['country_name'].tolist()}")

# Plot 2: Bar chart of key metrics for high vs low revenue markets
metrics = ['avg_daily_installs', 'weekly_growth_rate', 'day_30_retention_rate', 'daily_churn_rate', 'app_quality_score']
high_means = df_high[metrics].mean()
low_means = df_low[metrics].mean()

plt.figure(figsize=(12, 8))
x = range(len(metrics))
width = 0.35
plt.bar([i - width/2 for i in x], high_means, width, label='High Revenue Markets', color='steelblue')
plt.bar([i + width/2 for i in x], low_means, width, label='Low Revenue Markets', color='lightcoral')
plt.xticks(x, metrics, rotation=45, ha='right')
plt.ylabel('Average Value')
plt.title('Performance Metrics: High vs Low Revenue per User Markets')
plt.legend()
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('/workspace/regional_metrics_comparison.png', dpi=300)
plt.close()

# 3. Scatter plot: average_revenue_per_user vs overall_market_score
plt.figure(figsize=(10, 6))
plt.scatter(df_region['average_revenue_per_user'], df_region['overall_market_score'], s=100, alpha=0.7)
for i, row in df_region.iterrows():
    plt.annotate(row['country_name'], (row['average_revenue_per_user'], row['overall_market_score']),
                 fontsize=8, alpha=0.9)
plt.xlabel('Average Revenue per User (USD)')
plt.ylabel('Overall Market Score')
plt.title('Market Score vs Revenue per User by Country')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('/workspace/revenue_vs_market_score.png', dpi=300)
plt.close()

# 4. Regional map of performance: bar chart of overall_market_score by country
plt.figure(figsize=(14, 6))
df_sorted = df_region.sort_values('overall_market_score', ascending=False)
plt.bar(df_sorted['country_name'], df_sorted['overall_market_score'], color='mediumseagreen')
plt.xlabel('Country')
plt.ylabel('Overall Market Score')
plt.title('Overall Market Score by Country')
plt.xticks(rotation=45, ha='right')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('/workspace/market_score_by_country.png', dpi=300)
plt.close()

conn.close()

print("Plots generated.")
