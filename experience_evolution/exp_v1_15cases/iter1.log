Action: CreateFile(filepath="analysis.py"):
```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-035.sqlite')

query = """
SELECT u."Department", strftime('%Y-%m', a."Detection Time") as month, COUNT(*) as count
FROM abnormal_logins_table a
LEFT JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
LEFT JOIN user_information_table u ON l."User ID" = u."User ID"
WHERE a."Detection Time" IS NOT NULL
GROUP BY u."Department", month
ORDER BY u."Department", month;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# pivot
pivot = df.pivot(index='month', columns='Department', values='count').fillna(0)

print("Monthly abnormal login counts per department:")
print(pivot)

# overall trend
pivot['Total'] = pivot.sum(axis=1)
print("\nTotal monthly trend:")
print(pivot[['Total']])
```

