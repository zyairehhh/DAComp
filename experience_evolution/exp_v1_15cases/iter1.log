import sqlite3
import pandas as pd

conn = sqlite3.connect('/workspace/dacomp-022.sqlite')

# 1. Overall fare per km by vehicle type
query = """
SELECT `Vehicle Type`,
       AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
       AVG(`Booking Value`) as avg_booking,
       AVG(`Ride Distance`) as avg_distance,
       COUNT(*) as total_rides,
       SUM(`Booking Value`) as total_earnings
FROM sheet1
WHERE `Booking Status` = 'Completed'
GROUP BY `Vehicle Type`
ORDER BY avg_fare_per_km DESC
"""
df = pd.read_sql_query(query, conn)
print("=== Vehicle Type Overall Performance ===")
print(df.to_string(index=False))
print()

# 2. Top hours for each vehicle type by fare per km (with ride count > 100)
query2 = """
WITH hourly AS (
    SELECT `Vehicle Type`,
           CAST(substr(Time, 1, 2) AS INTEGER) as hour,
           AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
           AVG(`Booking Value`) as avg_booking,
           AVG(`Ride Distance`) as avg_distance,
           COUNT(*) as rides,
           SUM(`Booking Value`) as total_earnings
    FROM sheet1
    WHERE `Booking Status` = 'Completed'
    GROUP BY `Vehicle Type`, hour
)
SELECT *
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY `Vehicle Type` ORDER BY avg_fare_per_km DESC) as rn_fare,
           ROW_NUMBER() OVER (PARTITION BY `Vehicle Type` ORDER BY total_earnings DESC) as rn_earnings
    FROM hourly
    WHERE rides > 100
)
WHERE rn_fare <= 3 OR rn_earnings <= 3
ORDER BY `Vehicle Type`, hour
"""
df2 = pd.read_sql_query(query2, conn)
print("=== Top Hours by Vehicle Type (ride count > 100) ===")
# We'll process further in Python
for vtype in df2['Vehicle Type'].unique():
    subset = df2[df2['Vehicle Type'] == vtype]
    top_fare = subset[subset['rn_fare'] <= 3].sort_values('rn_fare')
    top_earnings = subset[subset['rn_earnings'] <= 3].sort_values('rn_earnings')
    print(f"\nVehicle: {vtype}")
    print("Top 3 hours by fare per km:")
    print(top_fare[['hour','avg_fare_per_km','rides','total_earnings']].to_string(index=False))
    print("Top 3 hours by total earnings:")
    print(top_earnings[['hour','total_earnings','rides','avg_fare_per_km']].to_string(index=False))

# 3. Driver ratings vs fare per km
query3 = """
SELECT `Vehicle Type`,
       ROUND(`Driver Ratings`,1) as rating_bin,
       AVG(`Booking Value` / `Ride Distance`) as avg_fare_per_km,
       AVG(`Booking Value`) as avg_booking,
       COUNT(*) as rides
FROM sheet1
WHERE `Booking Status` = 'Completed' AND `Driver Ratings` IS NOT NULL
GROUP BY `Vehicle Type`, rating_bin
HAVING rides >= 50
ORDER BY `Vehicle Type`, rating_bin
"""
df3 = pd.read_sql_query(query3, conn)
print("\n=== Driver Rating vs Fare per km (by Vehicle) ===")
print(df3.to_string(index=False))

# 4. Cancellation and incomplete rates by vehicle type
query4 = """
SELECT `Vehicle Type`,
       COUNT(*) as total_bookings,
       SUM(CASE WHEN `Booking Status` = 'Cancelled by Driver' THEN 1 ELSE 0 END) as driver_cancelled,
       SUM(CASE WHEN `Booking Status` = 'Cancelled by Customer' THEN 1 ELSE 0 END) as cust_cancelled,
       SUM(CASE WHEN `Incomplete Rides` = 1.0 THEN 1 ELSE 0 END) as incomplete,
       100.0 * SUM(CASE WHEN `Booking Status` = 'Cancelled by Driver' THEN 1 ELSE 0 END) / COUNT(*) as driver_cancel_pct,
       100.0 * SUM(CASE WHEN `Booking Status` = 'Cancelled by Customer' THEN 1 ELSE 0 END) / COUNT(*) as cust_cancel_pct,
       100.0 * SUM(CASE WHEN `Incomplete Rides` = 1.0 THEN 1 ELSE 0 END) / COUNT(*) as incomplete_pct
FROM sheet1
GROUP BY `Vehicle Type`
ORDER BY total_bookings DESC
"""
df4 = pd.read_sql_query(query4, conn)
print("\n=== Cancellation and Incomplete Rates by Vehicle Type ===")
print(df4.to_string(index=False))

conn.close()
```
