import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib

# Ensure English labels/fonts (avoid SimHei unless necessary)
# matplotlib.rcParams['font.sans-serif'] = []  # default
# matplotlib.rcParams['axes.unicode_minus'] = False

def load_data():
    conn = sqlite3.connect('dacomp-022.sqlite')
    df = pd.read_sql_query("SELECT * FROM sheet1;", conn)
    conn.close()
    return df

def compute_per_km_fare(df):
    # Ensure distance > 0 to avoid division by zero
    df = df.copy()
    df['per_km_fare'] = df['Booking Value'] / df['Ride Distance']
    # Filter out unrealistic values (e.g., negative, infinite, extreme outliers)
    df = df[(df['per_km_fare'] > 0) & (df['per_km_fare'] < 1000)]  # reasonable cap
    return df

def plot_vehicle_type_fare(df):
    # Bar chart: average per-km fare by vehicle type
    vehicle_avg = df.groupby('Vehicle Type')['per_km_fare'].mean().sort_values()
    
    fig, ax = plt.subplots(figsize=(10, 6))
    vehicle_avg.plot(kind='bar', ax=ax, color='skyblue')
    ax.set_title('Average Per-Kilometer Fare by Vehicle Type')
    ax.set_xlabel('Vehicle Type')
    ax.set_ylabel('Average Fare (currency per km)')
    ax.tick_params(axis='x', rotation=45)
    plt.tight_layout()
    plt.savefig('vehicle_type_fare.png', dpi=300)
    plt.close()
    
def plot_rating_vs_fare(df):
    # Scatter or box plot: Driver Ratings vs per-km fare
    fig, ax = plt.subplots(figsize=(10, 6))
    # For better visualization, bin ratings into categories
    df['Rating_Group'] = pd.cut(df['Driver Ratings'], bins=[0, 1, 2, 3, 4, 5], labels=['0-1', '1-2', '2-3', '3-4', '4-5'])
    # Boxplot
    df.boxplot(column='per_km_fare', by='Rating_Group', ax=ax, grid=False)
    ax.set_title('Per-Kilometer Fare Distribution by Driver Rating Groups')
    ax.set_xlabel('Driver Rating Group')
    ax.set_ylabel('Per-Kilometer Fare')
    ax.set_xticklabels(ax.get_xticklabels(), rotation=0)
    plt.suptitle('')
    plt.tight_layout()
    plt.savefig('rating_vs_fare.png', dpi=300)
    plt.close()

def plot_payment_method_fare(df):
    # Average fare by payment method
    pay_avg = df.groupby('Payment Method')['per_km_fare'].mean().sort_values()
    
    fig, ax = plt.subplots(figsize=(8, 5))
    pay_avg.plot(kind='bar', ax=ax, color='lightgreen')
    ax.set_title('Average Per-Kilometer Fare by Payment Method')
    ax.set_xlabel('Payment Method')
    ax.set_ylabel('Average Fare')
    ax.tick_params(axis='x', rotation=45)
    plt.tight_layout()
    plt.savefig('payment_method_fare.png', dpi=300)
    plt.close()

def plot_booking_status_fare(df):
    # Compare completed vs cancelled rides maybe
    # Filter by Booking Status
    status_avg = df.groupby('Booking Status')['per_km_fare'].mean()
    
    fig, ax = plt.subplots(figsize=(6, 4))
    status_avg.plot(kind='bar', ax=ax, color='orange')
    ax.set_title('Average Per-Kilometer Fare by Booking Status')
    ax.set_xlabel('Booking Status')
    ax.set_ylabel('Average Fare')
    ax.tick_params(axis='x', rotation=0)
    plt.tight_layout()
    plt.savefig('booking_status_fare.png', dpi=300)
    plt.close()

def plot_combined_strategy(df):
    # Joint effect: Vehicle Type and Rating
    # Create a pivot table
    pivot = df.pivot_table(values='per_km_fare', index='Vehicle Type', columns='Rating_Group', aggfunc='mean')
    
    fig, ax = plt.subplots(figsize=(12, 6))
    pivot.plot(kind='bar', ax=ax)
    ax.set_title('Average Per-Kilometer Fare by Vehicle Type and Driver Rating Group')
    ax.set_xlabel('Vehicle Type')
    ax.set_ylabel('Average Fare')
    ax.legend(title='Rating Group')
    ax.tick_params(axis='x', rotation=45)
    plt.tight_layout()
    plt.savefig('vehicle_rating_fare.png', dpi=300)
    plt.close()

def main():
    df = load_data()
    print(f'Loaded {len(df)} rows.')
    df = compute_per_km_fare(df)
    print(f'After filtering per-km fare, {len(df)} rows remain.')
    
    plot_vehicle_type_fare(df)
    plot_rating_vs_fare(df)
    plot_payment_method_fare(df)
    plot_booking_status_fare(df)
    plot_combined_strategy(df)
    
    print('Plots generated.')

if __name__ == '__main__':
    main()
