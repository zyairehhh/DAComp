'''
import sqlite3
import re
import pandas as pd
from collections import defaultdict

conn = sqlite3.connect('dacomp-081.sqlite')
cur = conn.cursor()
cur.execute("SELECT embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL LIMIT 10000")
rows = cur.fetchall()

field_numeric = defaultdict(list)
pattern = re.compile(r'custom_field_(\d+):value_(\d+)')
for row in rows:
    ed = row[0]
    for match in pattern.finditer(ed):
        field = f'custom_field_{match.group(1)}'
        val = int(match.group(2))
        field_numeric[field].append(val)

# compute min, max, avg, and check if within plausible revenue range (0-100)
for field, vals in list(field_numeric.items())[:30]:
    avg = sum(vals) / len(vals)
    min_v = min(vals)
    max_v = max(vals)
    # check if typical values are between 0-100
    if max_v <= 100 and min_v >= 0:
        print(f"{field}: count={len(vals)}, min={min_v}, max={max_v}, avg={avg:.2f}")
''')
