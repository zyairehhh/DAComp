'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo data and define groups
geo_df = pd.read_sql_query("SELECT * FROM google_play__geo_market_analysis WHERE package_name = 'com.dev.photoeditor'", conn)
geo_df['revenue_group'] = np.where(geo_df['avg_transaction_value'] > 30, 'high', 'low')

# Finance data
finance_df = pd.read_sql_query("SELECT country_long, region, date_day, net_amount, transactions FROM google_play__finance_report WHERE package_name = 'com.dev.photoeditor'", conn)
finance_df['date_day'] = pd.to_datetime(finance_df['date_day'])
finance_df['month'] = finance_df['date_day'].dt.to_period('M')
country_to_group = geo_df.set_index('country_name')['revenue_group'].to_dict()
finance_df['revenue_group'] = finance_df['country_long'].map(country_to_group)
finance_df = finance_df.dropna(subset=['revenue_group'])

# Monthly revenue by group
monthly_group = finance_df.groupby(['month', 'revenue_group']).agg({'net_amount': 'sum', 'transactions': 'sum'}).reset_index()
monthly_group['avg_transaction_value'] = monthly_group['net_amount'] / monthly_group['transactions']

# Sort and compute growth
monthly_group = monthly_group.sort_values(['revenue_group', 'month'])
monthly_group['prev_net'] = monthly_group.groupby('revenue_group')['net_amount'].shift(1)
monthly_group['monthly_growth'] = (monthly_group['net_amount'] - monthly_group['prev_net']) / monthly_group['prev_net'] * 100
print("Monthly revenue trends for both groups:")
print(monthly_group[['month', 'revenue_group', 'net_amount', 'transactions', 'avg_transaction_value', 'monthly_growth']].head(20))

# Compute cumulative growth over the period for each group
first_month = monthly_group.groupby('revenue_group')['net_amount'].first()
last_month = monthly_group.groupby('revenue_group')['net_amount'].last()
total_growth = (last_month - first_month) / first_month * 100
print("\nCumulative growth over observed months:")
print(total_growth)

# Load overall performance score
comp_df = pd.read_sql_query("SELECT date_day, overall_performance_score, research_budget_usd FROM google_play__comprehensive_performance_dashboard WHERE package_name = 'com.dev.photoeditor' ORDER BY date_day", conn)
comp_df['date_day'] = pd.to_datetime(comp_df['date_day'])
comp_df['month'] = comp_df['date_day'].dt.to_period('M')
print("\nOverall performance score by month:")
print(comp_df[['month', 'overall_performance_score', 'research_budget_usd']])

# Check if there is correlation between research budget and performance
comp_df['budget_change'] = comp_df['research_budget_usd'].diff()
comp_df['score_change'] = comp_df['overall_performance_score'].diff()
print("\nBudget vs Score changes:")
print(comp_df[['month', 'research_budget_usd', 'budget_change', 'overall_performance_score', 'score_change']])

# Also examine quality score and crash rates across groups
print("\nPerformance differences in key quality indicators:")
for col in ['app_quality_score', 'app_crash_rate_per_1k', 'daily_churn_rate', 'day_30_retention_rate', 'weekly_growth_rate']:
    high_mean = geo_df[geo_df['revenue_group'] == 'high'][col].mean()
    low_mean = geo_df[geo_df['revenue_group'] == 'low'][col].mean()
    print(f"{col}: High={high_mean:.2f}, Low={low_mean:.2f}, Diff={high_mean - low_mean:.2f}")

# Compute correlation between overall_market_score and avg_transaction_value
corr = geo_df['avg_transaction_value'].corr(geo_df['overall_market_score'])
print(f"\nCorrelation between avg_transaction_value and overall_market_score: {corr:.3f}")

conn.close()
''')
