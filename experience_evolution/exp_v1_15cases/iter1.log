import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter1/dacomp-067/stage1_env/dacomp-067.sqlite')

# talent pipeline
df_source = pd.read_sql_query("SELECT * FROM greenhouse__talent_pipeline_simplified", conn)
print("Source performance:")
print(df_source[['source_name', 'source_type', 'total_applications', 'total_hires', 'hire_rate', 'avg_process_days', 'efficiency_score']])

# diversity metrics
df_div = pd.read_sql_query("SELECT * FROM greenhouse__diversity_metrics ORDER BY application_year DESC, application_quarter DESC LIMIT 1", conn)
print("\nDiversity metrics (latest quarter):")
print(df_div[['application_year', 'application_quarter', 'female_hire_representation', 'non_white_hire_representation', 'overall_hire_rate']])

# candidate summary averages
df_candidate = pd.read_sql_query("SELECT AVG(total_applications) as avg_apps, AVG(hired_count) as avg_hired, AVG(active_count) as avg_active, AVG(rejected_count) as avg_rejected FROM greenhouse__candidate_summary", conn)
print("\nCandidate summary averages:")
print(df_candidate)

# interview ratings
df_rating = pd.read_sql_query("SELECT rating, COUNT(*) as cnt FROM greenhouse__interview_scorecard_detail WHERE rating IS NOT NULL GROUP BY rating ORDER BY rating", conn)
print("\nRating distribution:")
print(df_rating)
print("Average rating:", df_rating['rating'].dot(df_rating['cnt']) / df_rating['cnt'].sum())

# application status breakdown
df_status = pd.read_sql_query("SELECT status, COUNT(*) as cnt FROM greenhouse__application_enhanced GROUP BY status", conn)
print("\nApplication status:")
print(df_status)

# source distribution for hires (from application_enhanced)
df_source_hires = pd.read_sql_query("""
SELECT sourced_from, sourced_from_type, COUNT(*) as apps, 
       SUM(CASE WHEN status='hired' THEN 1 ELSE 0 END) as hires
FROM greenhouse__application_enhanced 
WHERE sourced_from IS NOT NULL 
GROUP BY sourced_from, sourced_from_type 
ORDER BY hires DESC
""", conn)
print("\nSource distribution from application_enhanced:")
print(df_source_hires)

# process days per source (from talent pipeline)
print("\nProcess days per source:")
print(df_source[['source_name', 'avg_process_days']].sort_values('avg_process_days'))

# cost model assumptions (cost per hire per source)
cost_per_hire = {
    'Headhunter': 20000,
    'University Recruiting': 10000,
    'Indeed': 5000,
    'Employee Referral': 3000,
    'AngelList': 5000,
    'Company Website': 2000,
    'Glassdoor': 5000,
    'LinkedIn': 4000
}
df_source['cost_per_hire'] = df_source['source_name'].map(cost_per_hire)
df_source['total_cost'] = df_source['total_hires'] * df_source['cost_per_hire']
total_cost_current = df_source['total_cost'].sum()
print("\nCost model (current):")
print(df_source[['source_name', 'total_hires', 'cost_per_hire', 'total_cost']])
print("Total recruitment cost:", total_cost_current)
print("Average cost per hire:", total_cost_current / df_source['total_hires'].sum())

# compute cost per hire weighted
cost_per_hire_weighted = total_cost_current / df_source['total_hires'].sum()
print("\nWeighted average cost per hire:", cost_per_hire_weighted)

# compute needed reduction of 15%
target_cost = total_cost_current * 0.85
print("Target cost (15% reduction):", target_cost)
print("Required savings:", total_cost_current - target_cost)

# compute current diversity metrics
female_hire_rep = df_div['female_hire_representation'].iloc[0]
non_white_hire_rep = df_div['non_white_hire_representation'].iloc[0]
print("Current female hire representation:", female_hire_rep)
print("Current non-white hire representation:", non_white_hire_rep)

# we need to maintain >=40% female, >=30% non-white
print("Diversity targets: Female >=40%, Non-white >=30%")
print("Current diversity meets targets:", female_hire_rep >= 40 and non_white_hire_rep >= 30)

# interviewer satisfaction (average rating per interview) - we need to ensure >4.0
# compute average rating per interviewer with at least 5 interviews
df_interviewer = pd.read_sql_query("""
SELECT interviewer_name, AVG(rating) as avg_rating, COUNT(*) as num_scorecards
FROM greenhouse__interview_scorecard_detail 
WHERE interviewer_name IS NOT NULL AND rating IS NOT NULL
GROUP BY interviewer_name
HAVING COUNT(*) >= 5
ORDER BY avg_rating DESC
""", conn)
print("\nInterviewer satisfaction (top 10):")
print(df_interviewer.head(10))
print("\nInterviewer satisfaction (bottom 10):")
print(df_interviewer.tail(10))
print("Overall average rating across all scorecards:", df_rating['rating'].dot(df_rating['cnt']) / df_rating['cnt'].sum())

# compute retention rates per stage
# we can approximate funnel: application -> interview -> hire
# from talent pipeline data, compute interview_rate = applications_with_interviews / total_applications
df_source['interview_rate'] = df_source['applications_with_interviews'] / df_source['total_applications']
print("\nSource interview rates:")
print(df_source[['source_name', 'interview_rate', 'hire_rate']])

# overall interview rate
total_interviews = df_source['applications_with_interviews'].sum()
total_apps = df_source['total_applications'].sum()
print("Overall interview rate:", total_interviews / total_apps)
print("Overall hire rate:", df_source['total_hires'].sum() / total_apps)
print("Interview to hire rate (overall):", df_source['total_hires'].sum() / total_interviews)

conn.close()
```
