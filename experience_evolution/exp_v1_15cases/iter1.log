import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

conn = sqlite3.connect('dacomp-070.sqlite')  # relative path

def save_fig(name):
    plt.tight_layout()
    plt.savefig(f'{name}.png', dpi=300)  # save in current directory
    plt.close()

# 1. Regional conversion rate trends
print('Processing regional conversion trends...')
query1 = """
SELECT date_day, region, store_listing_conversion_rate
FROM google_play__country_report
WHERE date_day >= '2024-04-01'
"""
df1 = pd.read_sql_query(query1, conn, parse_dates=['date_day'])
df1['month'] = df1['date_day'].dt.to_period('M').astype(str)
monthly = df1.groupby(['region', 'month'])['store_listing_conversion_rate'].mean().reset_index()
pivot = monthly.pivot(index='month', columns='region', values='store_listing_conversion_rate')
month_order = ['2024-04','2024-05','2024-06','2024-07','2024-08','2024-09','2024-10']
pivot = pivot.reindex(month_order)

plt.figure(figsize=(10,6))
for region in pivot.columns:
    plt.plot(pivot.index, pivot[region], marker='o', label=region)
plt.xlabel('Month')
plt.ylabel('Average Store Listing Conversion Rate')
plt.title('Regional Conversion Rate Trends (Past 6 Months)')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
save_fig('regional_conversion_trends')

# 2. Device brand trends
print('Processing device brand trends...')
query2 = """
SELECT date_day, device, active_devices_last_30_days
FROM google_play__device_report
WHERE date_day >= '2024-04-01'
"""
df2 = pd.read_sql_query(query2, conn, parse_dates=['date_day'])
# Extract brand (first word before space)
def extract_brand(device):
    # Assume brand is first word, remove possible quotes
    if isinstance(device, str):
        return device.split()[0].strip()
    else:
        return 'Unknown'
df2['brand'] = df2['device'].apply(extract_brand)
df2['month'] = df2['date_day'].dt.to_period('M').astype(str)
monthly_dev = df2.groupby(['brand', 'month'])['active_devices_last_30_days'].mean().reset_index()

def month_to_num(m):
    y, m = map(int, m.split('-'))
    return (y - 2024) * 12 + (m - 4)

monthly_dev['month_num'] = monthly_dev['month'].apply(month_to_num)
slopes = []
for brand in monthly_dev['brand'].unique():
    sub = monthly_dev[monthly_dev['brand'] == brand]
    if len(sub) < 2:
        slopes.append((brand, 0, 0, 0))
        continue
    coeff = np.polyfit(sub['month_num'], sub['active_devices_last_30_days'], 1)
    # slope, intercept
    slope, intercept = coeff[0], coeff[1]
    pred = slope * sub['month_num'] + intercept
    ss_res = np.sum((sub['active_devices_last_30_days'] - pred) ** 2)
    ss_tot = np.sum((sub['active_devices_last_30_days'] - sub['active_devices_last_30_days'].mean()) ** 2)
    r2 = 1 - ss_res/ss_tot if ss_tot != 0 else 0
    slopes.append((brand, slope, r2, intercept))
slope_df = pd.DataFrame(slopes, columns=['brand','slope','r2','intercept'])
slope_df = slope_df.sort_values('slope', ascending=False)

plt.figure(figsize=(12,6))
bars = plt.bar(slope_df['brand'], slope_df['slope'], color='steelblue')
plt.xlabel('Device Brand')
plt.ylabel('Slope (Active Devices per Month)')
plt.title('Device Brand Active Devices Trend Slope (Linear)')
plt.xticks(rotation=45, ha='right')
for i, (_, row) in enumerate(slope_df.iterrows()):
    plt.text(i, row['slope'] + (0.02 if row['slope']>=0 else -0.02), 
             f'R²={row["r2"]:.2f}', ha='center', va='bottom' if row['slope']>=0 else 'top', fontsize=8)
plt.tight_layout()
save_fig('device_slope_bar')

# 3. Non-linear relationship: daily aggregated conversion vs quality & crash
print('Processing non-linear relationship...')
# Daily average conversion
query_conv = """
SELECT date_day, AVG(store_listing_conversion_rate) as avg_conversion
FROM google_play__country_report
WHERE date_day >= '2024-04-01'
GROUP BY date_day
"""
df_conv = pd.read_sql_query(query_conv, conn, parse_dates=['date_day'])
# Daily average quality and crash
query_qual = """
SELECT date_day, AVG(quality_score) as avg_quality, AVG(crash_rate_per_1k) as avg_crash
FROM google_play__time_series_trends
WHERE date_day >= '2024-04-01'
GROUP BY date_day
"""
df_qual = pd.read_sql_query(query_qual, conn, parse_dates=['date_day'])
# Merge
df_nl = pd.merge(df_conv, df_qual, on='date_day', how='inner')
df_nl = df_nl.dropna()

plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
x = df_nl['avg_quality']
y = df_nl['avg_conversion']
plt.scatter(x, y, alpha=0.5, s=10)
if len(df_nl) >= 3:
    coeff_q = np.polyfit(x, y, 2)
    x_seq = np.linspace(x.min(), x.max(), 100)
    y_seq = np.polyval(coeff_q, x_seq)
    plt.plot(x_seq, y_seq, color='red', linewidth=2, label=f'Quadratic fit')
plt.xlabel('Daily Average Quality Score')
plt.ylabel('Daily Average Conversion Rate')
plt.title('Conversion Rate vs Quality Score (Daily Aggregated)')
plt.legend()

plt.subplot(1,2,2)
x2 = df_nl['avg_crash']
y2 = df_nl['avg_conversion']
plt.scatter(x2, y2, alpha=0.5, s=10)
if len(df_nl) >= 3:
    coeff_c = np.polyfit(x2, y2, 2)
    x_seq2 = np.linspace(x2.min(), x2.max(), 100)
    y_seq2 = np.polyval(coeff_c, x_seq2)
    plt.plot(x_seq2, y_seq2, color='red', linewidth=2, label=f'Quadratic fit')
plt.xlabel('Daily Average Crash Rate per 1k')
plt.ylabel('Daily Average Conversion Rate')
plt.title('Conversion Rate vs Crash Rate (Daily Aggregated)')
plt.legend()
save_fig('conversion_vs_quality_crash_daily')

# 4. Market maturity classification
print('Processing market maturity...')
query4 = """
SELECT date_day, daily_installs
FROM google_play__time_series_trends
WHERE date_day >= '2024-04-01'
"""
df_inst = pd.read_sql_query(query4, conn, parse_dates=['date_day'])
df_inst['month'] = df_inst['date_day'].dt.to_period('M').astype(str)
monthly_inst = df_inst.groupby('month')['daily_installs'].sum().reset_index()
monthly_inst['month_num'] = monthly_inst['month'].apply(month_to_num)
monthly_inst = monthly_inst.sort_values('month_num')
monthly_inst['prev_installs'] = monthly_inst['daily_installs'].shift(1)
monthly_inst['growth'] = (monthly_inst['daily_installs'] - monthly_inst['prev_installs']) / monthly_inst['prev_installs'] * 100

def classify(g):
    if pd.isnull(g):
        return 'N/A'
    if g > 5:
        return 'Emerging'
    elif g < -5:
        return 'Mature'
    else:
        return 'Stable'
monthly_inst['maturity'] = monthly_inst['growth'].apply(classify)

plt.figure(figsize=(8,6))
colors = {'Emerging':'green','Mature':'red','Stable':'gray'}
bar_colors = [colors[m] for m in monthly_inst['maturity']]
bars = plt.bar(monthly_inst['month'], monthly_inst['growth'], color=bar_colors, edgecolor='black')
plt.xlabel('Month')
plt.ylabel('Install Growth (%)')
plt.title('Monthly Install Growth and Market Maturity')
plt.axhline(y=5, color='green', linestyle='--', alpha=0.3, label='Emerging threshold (>5%)')
plt.axhline(y=-5, color='red', linestyle='--', alpha=0.3, label='Mature threshold (<-5%)')
plt.legend()
for bar, val in zip(bars, monthly_inst['growth']):
    if pd.notnull(val):
        height = bar.get_height()
        plt.text(bar.get_x() + bar.get_width()/2., height + (0.5 if height>=0 else -1.5),
                 f'{val:.1f}%', ha='center', va='bottom' if height>=0 else 'top', fontsize=9)
save_fig('market_maturity_growth')

# 5. Interaction effect: update frequency vs active devices vs rating
print('Processing interaction effect...')
query5 = """
SELECT date_day, 
       SUM(update_events) as total_update_events,
       AVG(active_devices_last_30_days) as avg_active_devices,
       AVG(rolling_total_average_rating) as avg_rating
FROM google_play__country_report
WHERE date_day >= '2024-04-01'
GROUP BY date_day
"""
df_inter = pd.read_sql_query(query5, conn, parse_dates=['date_day'])
df_inter = df_inter.dropna()
plt.figure(figsize=(10,6))
sc = plt.scatter(df_inter['total_update_events'], df_inter['avg_active_devices'], 
                 c=df_inter['avg_rating'], cmap='viridis', alpha=0.6, s=50)
plt.colorbar(sc, label='Average Rating')
plt.xlabel('Total Daily Update Events')
plt.ylabel('Average Active Devices (30‑day)')
plt.title('Interaction of Update Frequency, Active Devices, and Rating')
save_fig('update_active_rating_scatter')

conn.close()
print('All plots generated.')
```
