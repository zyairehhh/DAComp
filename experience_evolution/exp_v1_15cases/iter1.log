'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import reverse_geocoder as rg

# Connect to database
conn = sqlite3.connect('dacomp-080.sqlite')

# Load contact data
contact_df = pd.read_sql_query("SELECT * FROM qualtrics__contact;", conn)

# Compute participation frequency normalization
total_surveys = contact_df['total_count_surveys'].fillna(0).astype(float)
min_surveys = total_surveys.min()
max_surveys = total_surveys.max()
participation_norm = (total_surveys - min_surveys) / (max_surveys - min_surveys) if max_surveys > min_surveys else 0

# Compute completion rate normalization
completed = contact_df['total_count_completed_surveys'].fillna(0).astype(float)
completion_rate = np.where(total_surveys > 0, completed / total_surveys, 0)
completion_norm = completion_rate  # already 0-1

# Compute cross-channel activity
def distinct_channels(row):
    channels = 0
    if row['count_surveys_sent_email'] > 0:
        channels += 1
    if row['count_surveys_sent_sms'] > 0:
        channels += 1
    return channels

def distinct_opened_channels(row):
    opened = 0
    if row['count_surveys_opened_email'] > 0:
        opened += 1
    if row['count_surveys_opened_sms'] > 0:
        opened += 1
    return opened

contact_df['distinct_channels'] = contact_df.apply(distinct_channels, axis=1)
contact_df['distinct_opened_channels'] = contact_df.apply(distinct_opened_channels, axis=1)
raw_cross = (contact_df['distinct_channels'] / 2) * 0.5 + (contact_df['distinct_opened_channels'] / 2) * 0.5
max_raw = raw_cross.max()
min_raw = raw_cross.min()
cross_channel_norm = (raw_cross - min_raw) / (max_raw - min_raw) if max_raw > min_raw else 0

# Composite score
composite = (0.4 * participation_norm + 0.4 * completion_norm + 0.2 * cross_channel_norm) * 100
contact_df['composite_score'] = composite

# Percentiles for segmentation
p33 = np.percentile(composite, 33)
p66 = np.percentile(composite, 66)
print(f"33rd percentile: {p33:.1f}")
print(f"66th percentile: {p66:.1f}")

def assign_segment(score):
    if score < p33:
        return 'Low-value'
    elif score < p66:
        return 'Medium-value'
    else:
        return 'High-value'

contact_df['segment'] = contact_df['composite_score'].apply(assign_segment)

# Add power user flag (top 10%)
power_threshold = np.percentile(composite, 90)
contact_df['power_user'] = contact_df['composite_score'] >= power_threshold

# Add language from contact_df (already exists)
# Geographic region from responses
response_df = pd.read_sql_query("SELECT contact_id, location_latitude, location_longitude FROM qualtrics__response WHERE location_latitude IS NOT NULL AND location_longitude IS NOT NULL;", conn)
# For each user, get the most frequent location (simplify: first non-null)
user_coords = response_df.drop_duplicates(subset='contact_id', keep='first')
# Merge with contact_df
contact_df = contact_df.merge(user_coords[['contact_id', 'location_latitude', 'location_longitude']], on='contact_id', how='left')

# Use reverse geocoder to get country, then continent
def get_region(lat, lon):
    if pd.isna(lat) or pd.isna(lon):
        return 'Unknown'
    try:
        result = rg.search((float(lat), float(lon)))
        country_code = result[0]['cc']
        # map country code to continent (simplified)
        from pycountry_convert import country_alpha2_to_continent_code, country_name_to_country_alpha2
        continent = country_alpha2_to_continent_code(country_code)
        continent_names = {'AF': 'Africa', 'AS': 'Asia', 'EU': 'Europe', 'NA': 'North America', 'SA': 'South America', 'OC': 'Oceania', 'AN': 'Antarctica'}
        return continent_names.get(continent, 'Other')
    except:
        return 'Unknown'

# Install pycountry-convert if not available
import subprocess, sys
subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'pycountry-convert'])

from pycountry_convert import country_alpha2_to_continent_code

contact_df['region'] = contact_df.apply(lambda row: get_region(row['location_latitude'], row['location_longitude']), axis=1)

# Save computed table for reference (optional)
contact_df.to_csv('/workspace/contact_with_scores.csv', index=False)

# Plot 1: Distribution of Composite Scores with Percentiles and Power-User Threshold
plt.figure(figsize=(10,6))
plt.hist(contact_df['composite_score'], bins=50, edgecolor='black', alpha=0.7, color='skyblue')
plt.axvline(p33, color='orange', linestyle='--', label=f'33rd percentile ({p33:.1f})')
plt.axvline(p66, color='green', linestyle='--', label=f'66th percentile ({p66:.1f})')
plt.axvline(power_threshold, color='red', linestyle='--', label=f'Top 10% threshold ({power_threshold:.1f})')
plt.xlabel('Composite Score (0-100)')
plt.ylabel('Number of Users')
plt.title('Distribution of User Composite Scores')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('/workspace/score_distribution.png', dpi=300)
plt.close()

# Plot 2: Average Metrics by Segment
segment_metrics = contact_df.groupby('segment').agg(
    avg_total_surveys=('total_count_surveys', 'mean'),
    avg_completed_surveys=('total_count_completed_surveys', 'mean'),
    avg_completion_rate=('completion_rate', 'mean'),
    avg_distinct_channels=('distinct_channels', 'mean'),
    avg_cross_channel_norm=('cross_channel_norm', 'mean')
).reset_index()
# completion_rate column not created yet, compute
contact_df['completion_rate'] = contact_df['total_count_completed_surveys'] / contact_df['total_count_surveys'].replace(0, np.nan)
segment_metrics = contact_df.groupby('segment').agg(
    avg_total_surveys=('total_count_surveys', 'mean'),
    avg_completed_surveys=('total_count_completed_surveys', 'mean'),
    avg_completion_rate=('completion_rate', 'mean'),
    avg_distinct_channels=('distinct_channels', 'mean')
).reset_index()

plt.figure(figsize=(10,6))
x = np.arange(len(segment_metrics))
width = 0.2
plt.bar(x - width*1.5, segment_metrics['avg_total_surveys'], width, label='Avg Total Surveys', color='C0')
plt.bar(x - width*0.5, segment_metrics['avg_completed_surveys'], width, label='Avg Completed Surveys', color='C1')
plt.bar(x + width*0.5, segment_metrics['avg_completion_rate']*100, width, label='Avg Completion Rate (%)', color='C2')
plt.bar(x + width*1.5, segment_metrics['avg_distinct_channels'], width, label='Avg Distinct Channels', color='C3')
plt.xlabel('User Segment')
plt.ylabel('Average Value')
plt.title('Key Behavioral Metrics by User Segment')
plt.xticks(x, segment_metrics['segment'])
plt.legend()
