        # Step 5: Get light and radiation data
        light_query = f"""
        SELECT lrr.*, TRIM(di."Gallery reference") as hall_id
        FROM light_and_radiation_readings lrr
        JOIN environmental_monitoring_data emd ON lrr."Environmental monitoring reference" = emd."Environmental Reading ID"
        JOIN display_case_information di ON emd."Display Case Reference" = di."Display case ID"
        WHERE di."Display case ID" IN ({placeholders2})
        """
        
        light_data = pd.read_sql_query(light_query, conn, params=display_case_ids)
        print(f"Light & radiation readings: {len(light_data)}")

