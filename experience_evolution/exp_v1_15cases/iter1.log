Action: CreateFile(filepath='analyze.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-034.sqlite')

# Load promotions of type 3 (single item discount) that are approved and valid
query = '''
SELECT 
    id,
    sku_id,
    sku_name,
    promotion_price,
    pdj_price,
    begin_time,
    end_time,
    sale_count,
    limit_count
FROM attachment_3
WHERE promotion_type = 3 
    AND state = 5 
    AND validation = 0 
    AND begin_time LIKE '%/%'
'''
promos = pd.read_sql_query(query, conn)
print(f"Number of valid promotions: {len(promos)}")

# Compute discount depth
promos['discount_depth'] = (promos['pdj_price'] - promos['promotion_price']) / promos['pdj_price']
# Discount depth between 0 and 1
promos['discount_depth'] = promos['discount_depth'].clip(lower=0)

# Convert begin_time and end_time to datetime
promos['begin_dt'] = pd.to_datetime(promos['begin_time'], format='%Y/%m/%d %H:%M', errors='coerce')
promos['end_dt'] = pd.to_datetime(promos['end_time'], format='%Y/%m/%d %H:%M', errors='coerce')
# Drop rows where conversion failed
promos = promos.dropna(subset=['begin_dt', 'end_dt'])
print(f"Promotions after date conversion: {len(promos)}")

# Load category mapping
categories = pd.read_sql_query('SELECT sku_id, "Level 1 Category ID", "Level 1 Category Name" FROM attachment_4', conn)
categories.rename(columns={'Level 1 Category ID': 'l1_cat_id', 'Level 1 Category Name': 'l1_cat_name'}, inplace=True)

# Merge promotions with categories
promos_cat = pd.merge(promos, categories, on='sku_id', how='left')
print(f"Promotions with category mapping: {len(promos_cat)}")

# Load sales data (combine attachment_1 and attachment_2)
sales1 = pd.read_sql_query('SELECT create_dt, "Order ID", sku_id, "SKU Quantity", "SKU Selling Price" FROM attachment_1', conn)
