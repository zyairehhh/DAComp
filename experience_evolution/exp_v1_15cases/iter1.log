import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# Query ad group report data
query = """
SELECT 
    ad_group_id,
    ad_group_name,
    ad_group_type,
    status,
    SUM(spend) as total_spend,
    SUM(clicks) as total_clicks,
    SUM(impressions) as total_impressions,
    SUM(conversions) as total_conversions,
    SUM(conversions_value) as total_conversions_value
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name, ad_group_type, status
HAVING total_impressions > 0 AND total_clicks > 0  -- Ensure valid CTR calculation
"""
ad_groups = pd.read_sql_query(query, conn)

# Calculate metrics
ad_groups['CTR'] = ad_groups['total_clicks'] / ad_groups['total_impressions']
ad_groups['CVR'] = ad_groups['total_conversions'] / ad_groups['total_clicks']
ad_groups['CVR'] = ad_groups['CVR'].replace([np.inf, -np.inf], np.nan)
ad_groups['CPA'] = ad_groups['total_spend'] / ad_groups['total_conversions']
ad_groups['CPA'] = ad_groups['CPA'].replace([np.inf, -np.inf], np.nan)

# Calculate percentiles
ctr_75th = ad_groups['CTR'].quantile(0.75)
cvr_25th = ad_groups['CVR'].quantile(0.25)

# Identify problematic ad groups
problematic_ad_groups = ad_groups[
    (ad_groups['CTR'] > ctr_75th) & 
    (ad_groups['CVR'] < cvr_25th) &
    (ad_groups['CVR'].notna())
].copy()

# Get normal ad groups for comparison
normal_ad_groups = ad_groups[
    ~ad_groups['ad_group_id'].isin(problematic_ad_groups['ad_group_id'])
]

print(f"Total ad groups: {len(ad_groups)}")
print(f"Problematic ad groups: {len(problematic_ad_groups)}")
print(f"CTR 75th percentile: {ctr_75th:.4f}")
print(f"CVR 25th percentile: {cvr_25th:.4f}")
print(f"Average CTR (problematic): {problematic_ad_groups['CTR'].mean():.4f}")
print(f"Average CVR (problematic): {problematic_ad_groups['CVR'].mean():.4f}")

# Visualization 1: CTR vs CVR scatter plot with percentile thresholds
plt.figure(figsize=(10, 6))
plt.scatter(normal_ad_groups['CTR'], normal_ad_groups['CVR'], 
           alpha=0.6, s=50, c='blue', label='Normal Ad Groups', edgecolors='w')
plt.scatter(problematic_ad_groups['CTR'], problematic_ad_groups['CVR'], 
           alpha=0.8, s=100, c='red', label='Problematic Ad Groups (High CTR, Low CVR)', edgecolors='w')

# Add percentile lines
plt.axvline(x=ctr_75th, color='orange', linestyle='--', alpha=0.7, label=f'CTR 75th percentile ({ctr_75th:.3f})')
plt.axhline(y=cvr_25th, color='green', linestyle='--', alpha=0.7, label=f'CVR 25th percentile ({cvr_25th:.3f})')

plt.xlabel('Click-Through Rate (CTR)')
plt.ylabel('Conversion Rate (CVR)')
plt.title('CTR vs CVR: Identifying High-CTR, Low-CVR Ad Groups')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('ctr_cvr_scatter.png', dpi=300, bbox_inches='tight')
plt.close()

# Visualization 2: Distribution of CTR for problematic vs normal ad groups
plt.figure(figsize=(10, 6))
plt.hist(normal_ad_groups['CTR'].dropna(), bins=30, alpha=0.7, color='blue', 
         label=f'Normal Ad Groups (n={len(normal_ad_groups)})', density=True)
plt.hist(problematic_ad_groups['CTR'].dropna(), bins=20, alpha=0.7, color='red', 
         label=f'Problematic Ad Groups (n={len(problematic_ad_groups)})', density=True)
plt.axvline(x=ctr_75th, color='orange', linestyle='--', alpha=0.8, label=f'CTR 75th percentile')
plt.xlabel('Click-Through Rate (CTR)')
plt.ylabel('Density')
plt.title('CTR Distribution: Problematic vs Normal Ad Groups')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('ctr_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# Visualization 3: Ad group type distribution for problematic vs normal
if len(problematic_ad_groups) > 0:
    # Combine ad group types from both groups
