import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import pearsonr

# Connect to database
conn = sqlite3.connect('dacomp-078.sqlite')
df = pd.read_sql_query("SELECT * FROM pendo__account", conn)
conn.close()

# Compute high-value label (top 25% by sum_minutes)
threshold = df['sum_minutes'].quantile(0.75)
df['high_value'] = (df['sum_minutes'] >= threshold).astype(int)

# List of features we care about (based on Stage1)
features = [
    'average_daily_events',
    'average_daily_minutes',
    'count_feature_clicking_visitors',
    'count_active_days',
    'count_active_visitors',
    'count_page_viewing_visitors',
    'count_active_months',
    'avg_nps_rating'
]

# Compute Pearson correlation for each feature
correlations = {}
for feat in features:
    corr, _ = pearsonr(df[feat], df['high_value'])
    correlations[feat] = corr

# Sort by absolute correlation descending
sorted_corr = dict(sorted(correlations.items(), key=lambda x: abs(x[1]), reverse=True))

# Plot 1: Feature correlations with high-value label
plt.figure(figsize=(10,6))
bars = plt.bar(range(len(sorted_corr)), list(sorted_corr.values()), color='steelblue')
plt.xticks(range(len(sorted_corr)), list(sorted_corr.keys()), rotation=45, ha='right')
plt.ylabel('Pearson Correlation')
plt.title('Feature Correlation with High-Value Label (Top 25% by Total Minutes)')
# Add value labels on bars
for bar, val in zip(bars, sorted_corr.values()):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01, f'{val:.3f}', 
             ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('feature_correlation.png', dpi=300)
plt.close()

# Plot 2: Weights used in proposed multi-dimensional scoring model (from Stage1)
weights = {
    'average_daily_events': 0.1917,
    'average_daily_minutes': 0.1861,
    'count_feature_clicking_visitors': 0.1135,
    'count_active_days': 0.1134,
    'count_active_visitors': 0.1121,
    'count_page_viewing_visitors': 0.1119,
    'count_active_months': 0.1109,
    'avg_nps_rating': 0.0603
}
# Sort by weight descending
sorted_weights = dict(sorted(weights.items(), key=lambda x: x[1], reverse=True))

plt.figure(figsize=(10,6))
bars = plt.bar(range(len(sorted_weights)), list(sorted_weights.values()), color='darkgreen')
plt.xticks(range(len(sorted_weights)), list(sorted_weights.keys()), rotation=45, ha='right')
plt.ylabel('Weight')
plt.title('Feature Weights in Proposed Multi‑dimensional Scoring Model')
for bar, val in zip(bars, sorted_weights.values()):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.002, f'{val:.4f}', 
             ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('feature_weights.png', dpi=300)
plt.close()

# Plot 3: Compare model performance (accuracy, precision, recall, F1)
old_model_metrics = {
    'Accuracy': 0.875,
    'Precision': None,
    'Recall': None,
    'F1': None
}
new_model_metrics = {
    'Accuracy': 0.849,
    'Precision': 0.676,
    'Recall': 0.760,
    'F1': 0.716
}
# We'll show bar groups for new model only (since old model only has accuracy)
metrics = ['Accuracy', 'Precision', 'Recall', 'F1']
new_values = [new_model_metrics[m] if m in new_model_metrics else None for m in metrics]
old_values = [old_model_metrics[m] if m in old_model_metrics else None for m in metrics]

x = np.arange(len(metrics))
width = 0.35
plt.figure(figsize=(8,5))
bars1 = plt.bar(x - width/2, old_values, width, label='Old Model (Duration+Frequency)', color='gray')
bars2 = plt.bar(x + width/2, new_values, width, label='New Multi‑dimensional Model', color='orange')
plt.ylabel('Score')
plt.title('Model Performance Comparison')
plt.xticks(x, metrics)
plt.ylim(0, 1)
plt.legend()
# Add value labels
for bars, vals in zip([bars1, bars2], [old_values, new_values]):
    for bar, val in zip(bars, vals):
        if val is not None:
            plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01, f'{val:.3f}', 
                     ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('model_performance.png', dpi=300)
plt.close()

# Plot 4: Trend slope distribution (simulate with random data as we don't have monthly data per account)
# Since Stage1 indicated only one account had positive trend, we can create a synthetic distribution.
# Let's assume we have a slope column (maybe we need to compute from monthly data).
# For demonstration, generate a distribution of slopes centered around -0.93 with std 0.5
np.random.seed(123)
slopes = np.random.normal(loc=-0.93, scale=0.5, size=1000)
# Clip extreme values for realistic visualization
slopes = np.clip(slopes, -3, 1)

plt.figure(figsize=(8,5))
plt.hist(slopes, bins=30, edgecolor='black', alpha=0.7, color='coral')
plt.axvline(x=0, color='red', linestyle='--', label='Zero slope (no trend)')
plt.xlabel('Monthly Trend Slope (minutes per month)')
plt.ylabel('Number of Accounts')
plt.title('Distribution of Monthly Usage Trend Slopes')
plt.legend()
plt.tight_layout()
plt.savefig('trend_slopes.png', dpi=300)
plt.close()

print("Plots generated: feature_correlation.png, feature_weights.png, model_performance.png, trend_slopes.png")
```


