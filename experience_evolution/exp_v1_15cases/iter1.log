'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
df_account = pd.read_sql_query("""
    SELECT account_id, 
           sum_minutes, sum_events,
           count_active_days, count_active_months,
           avg_nps_rating,
           count_active_visitors,
           count_page_viewing_visitors,
           count_feature_clicking_visitors,
           average_daily_minutes, average_daily_events
    FROM pendo__account
""", conn)
df_account.set_index('account_id', inplace=True)

# define high-value as top 25% of sum_minutes
threshold = df_account['sum_minutes'].quantile(0.75)
df_account['high_value'] = (df_account['sum_minutes'] > threshold).astype(int)

# select features for scoring
features = ['average_daily_events', 'average_daily_minutes',
            'count_feature_clicking_visitors', 'count_active_days',
            'count_active_visitors', 'count_page_viewing_visitors',
            'count_active_months', 'avg_nps_rating']
X = df_account[features].copy()
y = df_account['high_value'].copy()

# standardize
X_norm = (X - X.mean()) / X.std()
# compute correlation with target
corr = X_norm.columns.map(lambda col: X_norm[col].corr(y))
# weights as normalized correlation (absolute)
weights = corr / np.abs(corr).sum()
score = X_norm.dot(weights)

# find optimal threshold
thresholds = np.linspace(score.min(), score.max(), 50)
def compute_metrics(y_true, y_pred):
    tp = ((y_true == 1) & (y_pred == 1)).sum()
    tn = ((y_true == 0) & (y_pred == 0)).sum()
    fp = ((y_true == 0) & (y_pred == 1)).sum()
    fn = ((y_true == 1) & (y_pred == 0)).sum()
    acc = (tp + tn) / (tp + tn + fp + fn)
    prec = tp / (tp + fp) if (tp + fp) > 0 else 0
    rec = tp / (tp + fn) if (tp + fn) > 0 else 0
    f1 = 2 * prec * rec / (prec + rec) if (prec + rec) > 0 else 0
    return acc, prec, rec, f1

best_acc = 0
best_thresh = 0
best_pred = None
for t in thresholds:
    pred = (score > t).astype(int)
    acc, prec, rec, f1 = compute_metrics(y, pred)
    if acc > best_acc:
        best_acc = acc
        best_thresh = t
        best_pred = pred

acc, prec, rec, f1 = compute_metrics(y, best_pred)
print("Model performance:")
print("Best accuracy:", best_acc)
print("Precision:", prec)
print("Recall:", rec)
print("F1:", f1)
print("\nProposed scoring weights:")
for feat, w in zip(features, weights):
    print(f"{feat}: {w:.4f}")

# existing model (duration + frequency)
existing_features = ['average_daily_minutes', 'average_daily_events']
X_ex = df_account[existing_features]
X_ex_norm = (X_ex - X_ex.mean()) / X_ex.std()
score_ex = X_ex_norm.mean(axis=1)
best_acc_ex = 0
for t in thresholds:
    pred = (score_ex > t).astype(int)
    acc, _, _, _ = compute_metrics(y, pred)
    if acc > best_acc_ex:
        best_acc_ex = acc
print("\nExisting model (duration+frequency) accuracy:", best_acc_ex)

# compute correlation of score with high_value
print("\nScore correlation with high_value:", score.corr(y))

conn.close()
''')
