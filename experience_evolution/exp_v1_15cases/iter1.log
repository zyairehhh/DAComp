We need to compute sales per SKU during promotion periods and compare with baseline. The stage1 report likely did that. For visualization, we can make:

1. Discount depth vs sales uplift (or incremental sales) by Level 1 Category.
2. Promotion effectiveness (maybe elasticity) across categories.

But to create plots, I need to compute aggregates. Let's write a Python script that does the necessary SQL queries and creates plots.

First, create a temporary Python script to explore.

Action: CreateFile(filepath="visualize.py"):
```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# Connect to DB
conn = sqlite3.connect('dacomp-034.sqlite')

# Query promotion data: single-item direct price reduction (promotion_type = 4)
promo_query = """
SELECT 
    sku_id,
    promotion_price,
    pdj_price,
    begin_time,
    end_time,
    sale_count
FROM attachment_3 
WHERE promotion_type = 4
"""
promo_df = pd.read_sql(promo_query, conn)
print("Promo rows:", promo_df.shape[0])
print(promo_df.head())

# Compute discount depth
promo_df['discount_depth'] = (promo_df['pdj_price'] - promo_df['promotion_price']) / promo_df['pdj_price']
# Filter out invalid (negative discount or >1?)
promo_df = promo_df[(promo_df['discount_depth'] > 0) & (promo_df['discount_depth'] <= 1)]

# Query category mapping
cat_query = """
SELECT sku_id, "Level 1 Category ID", "Level 1 Category Name"
FROM attachment_4
"""
cat_df = pd.read_sql(cat_query, conn)
# Merge
promo_df = promo_df.merge(cat_df, on='sku_id', how='left')
print("After merging category:", promo_df.shape)

# Query transaction data (attachment_2 maybe contains promotion transactions?)
sales_query = """
SELECT sku_id, "SKU Selling Price", "SKU Quantity", create_dt
FROM attachment_2
WHERE "SKU Price" != "SKU Selling Price"  -- discount applied
"""
sales_df = pd.read_sql(sales_query, conn)
sales_df['create_dt'] = pd.to_datetime(sales_df['create_dt'])
print("Sales rows:", sales_df.shape[0])
print(sales_df.head())

# For each promotion period, aggregate sales quantity
# We'll handle date conversions
promo_df['begin_time'] = pd.to_datetime(promo_df['begin_time'], errors='coerce')
promo_df['end_time'] = pd.to_datetime(promo_df['end_time'], errors='coerce')
# Remove rows where datetime conversion fails
promo_df = promo_df.dropna(subset=['begin_time', 'end_time'])

# For simplicity, we could aggregate sales by sku_id and compute total sales during promotion periods.
# But that's complex; we'll compute average discount depth vs total sales per category.

# Let's group by Level 1 Category and compute average discount depth and total sale_count
category_stats = promo_df.groupby(['Level 1 Category ID', 'Level 1 Category Name']).agg(
    avg_discount_depth=('discount_depth', 'mean'),
    total_promo_sales=('sale_count', 'sum'),
    promo_count=('sku_id', 'count')
).reset_index()

print(category_stats.head())

# Plot 1: Bar chart of avg discount depth by category
plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['avg_discount_depth'])
plt.title('Average Discount Depth by Level 1 Category')
plt.xlabel('Category')
plt.ylabel('Average Discount Depth')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('avg_discount_depth_by_category.png')
plt.close()

# Plot 2: Scatter of avg discount depth vs total promo sales
plt.figure(figsize=(8,6))
plt.scatter(category_stats['avg_discount_depth'], category_stats['total_promo_sales'])
plt.title('Discount Depth vs Promotion Sales by Category')
plt.xlabel('Average Discount Depth')
plt.ylabel('Total Promotion Sales')
# Annotate points with category name
for i, row in category_stats.iterrows():
    plt.text(row['avg_discount_depth'], row['total_promo_sales'], str(row['Level 1 Category ID']), fontsize=9)
plt.tight_layout()
plt.savefig('discount_depth_vs_promo_sales.png')
plt.close()

# Plot 3: Bar chart of promotion count by category
plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['promo_count'])
plt.title('Number of Promotions by Level 1 Category')
plt.xlabel('Category')
plt.ylabel('Promotion Count')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('promotion_count_by_category.png')
plt.close()

# Compute effectiveness: sales per discount depth? We'll compute ratio
category_stats['sales_per_discount'] = category_stats['total_promo_sales'] / category_stats['avg_discount_depth']
category_stats = category_stats.sort_values('sales_per_discount', ascending=False)

plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['sales_per_discount'])
plt.title('Promotion Effectiveness (Sales per Discount Depth) by Category')
plt.xlabel('Category')
plt.ylabel('Sales per Discount Depth')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('promotion_effectiveness_by_category.png')
plt.close()

conn.close()
```
