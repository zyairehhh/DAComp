import sqlite3
import pandas as pd
import numpy as np
import re

def extract_lower_salary(salary_str):
    if not isinstance(salary_str, str):
        return None
    s = salary_str.replace(',', '')
    match = re.search(r'(\d+)\s*-\s*\d+', s)
    if match:
        return int(match.group(1))
    match = re.search(r'(\d+)', s)
    if match:
        return int(match.group(1))
    return None

def main():
    conn = sqlite3.connect('dacomp-048.sqlite')
    query = "SELECT * FROM sheet1 WHERE \"Education Requirement\" = 'Vocational school or above'"
    df = pd.read_sql_query(query, conn)
    df['starting_salary'] = df['Salary Range'].apply(extract_lower_salary)
    df = df.dropna(subset=['starting_salary'])
    print(f"Total vocational school graduates job postings with parsed salary: {df.shape[0]}")
    
    # Starting salary summary statistics
    print("\n--- Starting Salary Summary Statistics (yuan/month) ---")
    print(f"Mean: {df['starting_salary'].mean():.2f}")
    print(f"Median: {df['starting_salary'].median():.2f}")
    print(f"Std Dev: {df['starting_salary'].std():.2f}")
    print(f"Min: {df['starting_salary'].min()}")
    print(f"Max: {df['starting_salary'].max()}")
    
    # Distribution in percentage
    bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 50000]
    labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-7k', '7k-8k', '8k-9k', '9k-10k', '10k-15k', '15k-20k', '>20k']
    df['salary_bin'] = pd.cut(df['starting_salary'], bins=bins, labels=labels, right=False)
    dist = df['salary_bin'].value_counts().sort_index()
    dist_pct = (dist / dist.sum() * 100).round(2)
    dist_df = pd.DataFrame({'count': dist, 'percentage': dist_pct})
    print("\n--- Salary Distribution ---")
    print(dist_df)
    
    # Benefits distribution: parse benefits column (split by common separators)
    def split_benefits(benefit_str):
        if not isinstance(benefit_str, str):
            return []
        # Split by commas, semicolons, Chinese separators，、；
        parts = re.split(r'[,;、，；]', benefit_str)
        cleaned = [p.strip() for p in parts if p.strip()]
        return cleaned
    
    all_benefits = []
    for b in df['Benefits'].dropna():
        all_benefits.extend(split_benefits(b))
    from collections import Counter
    benefit_counts = Counter(all_benefits)
    top_30 = benefit_counts.most_common(30)
    print("\n--- Top 30 Benefits (Frequency) ---")
    for benefit, count in top_30:
        print(f"{benefit}: {count}")
    
    # Save to CSV for report
    pd.DataFrame(top_30, columns=['Benefit', 'Count']).to_csv('top_benefits.csv', index=False)
    
    # Analyze qualities impact: compute average salary for each category
    qualities = ['Work Experience Requirement', 'Foreign Language Requirement', 'Age Requirement', 'Gender Requirement', 'Company Type', 'Industry']
    for col in qualities:
        if col in df.columns:
            # Replace empty strings or NaN with 'Unspecified'
            df[col] = df[col].fillna('Unspecified')
            grouped = df.groupby(col)['starting_salary'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
            # Filter for categories with count >= 10
            filtered = grouped[grouped['count'] >= 10]
            print(f"\n--- {col} Impact on Starting Salary (top 10 by mean) ---")
            print(filtered.head(10))
            filtered.to_csv(f'{col}_impact.csv')
    
    # Additional analysis: compare mean salary for each quality with overall mean
    overall_mean = df['starting_salary'].mean()
    print(f"\nOverall mean salary: {overall_mean:.2f}")
    for col in qualities:
        if col in df.columns:
            # Limit to top 5 categories by count
            top_cats = df[col].value_counts().head(5).index
            subset = df[df[col].isin(top_cats)]
            means = subset.groupby(col)['starting_salary'].mean().sort_values(ascending=False)
            diff = means - overall_mean
            print(f"\n{col} - Top 5 categories salary difference from overall mean:")
            for cat, mean_sal in means.items():
                print(f"  {cat}: {mean_sal:.2f} ({diff[cat]:+.2f})")
    
    conn.close()

if __name__ == '__main__':
    main()
```)
