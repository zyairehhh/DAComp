import sqlite3, re, collections

conn = sqlite3.connect('dacomp-081.sqlite')
cursor = conn.cursor()
cursor.execute("SELECT embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL")
cf_counts = collections.Counter()
for row in cursor.fetchall():
    matches = re.findall(r'custom_field_(\d+):value_(\d+)', row[0])
    for cf, val in matches:
        cf_counts[cf] += 1

# total rows per cf
print("custom_field, total_rows")
for cf, cnt in cf_counts.most_common(10):
    print(f"{cf}, {cnt}")
conn.close()
