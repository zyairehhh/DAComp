Action: CreateFile(filepath='analysis.sql':
'''
-- Create a view of valid single‑item direct discount promotions
DROP VIEW IF EXISTS valid_promos;
CREATE VIEW valid_promos AS
SELECT
    id,
    sku_id,
    pdj_price,
    promotion_price,
    (pdj_price - promotion_price) / pdj_price AS discount_depth,
    date(substr(begin_time, 1, 10)) AS begin_date,
    date(substr(end_time, 1, 10)) AS end_date,
    begin_time,
    end_time
FROM attachment_3
WHERE promotion_type = 3
    AND state = 5
    AND validation = 0
    AND begin_time LIKE '%/%'
    AND end_time LIKE '%/%';

-- Join with category mapping
DROP VIEW IF EXISTS promo_with_cat;
CREATE VIEW promo_with_cat AS
SELECT
    vp.*,
    cat."Level 1 Category ID" AS l1_cat_id,
    cat."Level 1 Category Name" AS l1_cat_name
FROM valid_promos vp
LEFT JOIN attachment_4 cat ON vp.sku_id = cat.sku_id;

-- Combine sales tables
DROP VIEW IF EXISTS all_sales;
CREATE VIEW all_sales AS
SELECT create_dt, sku_id, "SKU Quantity" as qty, "SKU Selling Price" as price
FROM attachment_1
UNION ALL
SELECT create_dt, sku_id, "SKU Quantity" as qty, "SKU Selling Price" as price
FROM attachment_2;

-- For each promotion, aggregate sales that fall within its date range
SELECT
    pwc.id,
    pwc.sku_id,
    pwc.discount_depth,
    pwc.l1_cat_name,
    pwc.begin_date,
    pwc.end_date,
    SUM(s.qty) AS total_qty,
    SUM(s.qty * s.price) AS total_revenue,
    COUNT(DISTINCT s.create_dt) AS transaction_count
FROM promo_with_cat pwc
LEFT JOIN all_sales s ON pwc.sku_id = s.sku_id
    AND date(s.create_dt) BETWEEN pwc.begin_date AND pwc.end_date
GROUP BY pwc.id, pwc.sku_id, pwc.discount_depth, pwc.l1_cat_name, pwc.begin_date, pwc.end_date
ORDER BY total_qty DESC;
''')
