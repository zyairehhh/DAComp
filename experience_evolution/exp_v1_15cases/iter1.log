import sqlite3
import pandas as pd
import re

conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()
voc_df = df[df['Education Requirement'].str.contains('Vocational school', na=False)]
def split_benefits(benefits_str):
    if pd.isna(benefits_str):
        return []
    separators = r'[,，;；、.\s]+'
    items = re.split(separators, str(benefits_str))
    items = [item.strip() for item in items if item.strip()]
    return items

all_benefits = []
for benefits in voc_df['Benefits'].dropna():
    all_benefits.extend(split_benefits(benefits))
benefit_counts = pd.Series(all_benefits).value_counts()
print(benefit_counts.head(20))
