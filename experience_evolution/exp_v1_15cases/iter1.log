import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Connect to database
db_path = 'dacomp-067.sqlite'
conn = sqlite3.connect(db_path)

# --- 1. Channel weight allocation: Top source performance ---
source_df = pd.read_sql_query("""
    SELECT source_name, source_type, 
           total_applications, total_hires, 
           hire_rate, interview_rate, 
           interview_to_hire_rate, efficiency_score
    FROM greenhouse__talent_pipeline_simplified
    WHERE source_name IS NOT NULL
    ORDER BY efficiency_score DESC
    LIMIT 10
""", conn)

# Bar plot of efficiency score
plt.figure(figsize=(10,6))
bars = plt.barh(source_df['source_name'], source_df['efficiency_score'], color='skyblue')
plt.xlabel('Efficiency Score')
plt.title('Top 10 Sourcing Channels by Efficiency Score')
for bar, hr in zip(bars, source_df['hire_rate']):
    plt.text(bar.get_width() + 0.01, bar.get_y() + bar.get_height()/2, 
             f'{hr:.1%}', va='center', fontsize=9)
plt.tight_layout()
plt.savefig('channel_efficiency.png', dpi=300)
plt.close()

# --- 2. Diversity trends over quarters ---
div_df = pd.read_sql_query("""
    SELECT application_year, application_quarter,
           female_hire_representation,
           non_white_hire_representation,
           overall_hire_rate
    FROM greenhouse__diversity_metrics
    ORDER BY application_year, application_quarter
""", conn)
div_df['quarter_label'] = div_df['application_year'].astype(str) + 'Q' + div_df['application_quarter'].astype(str)

plt.figure(figsize=(10,6))
plt.plot(div_df['quarter_label'], div_df['female_hire_representation'], marker='o', label='Female Hire %', linewidth=2)
plt.plot(div_df['quarter_label'], div_df['non_white_hire_representation'], marker='s', label='Non‑White Hire %', linewidth=2)
plt.axhline(y=0.40, color='r', linestyle='--', alpha=0.5, label='Female Target (40%)')
plt.axhline(y=0.30, color='g', linestyle='--', alpha=0.5, label='Non‑White Target (30%)')
plt.xlabel('Quarter')
plt.ylabel('Representation (%)')
plt.title('Diversity Hire Representation Over Time')
plt.legend()
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('diversity_trend.png', dpi=300)
plt.close()

# --- 3. Overall conversion funnel across sources ---
funnel_df = pd.read_sql_query("""
    SELECT 
        AVG(hire_rate) as avg_hire_rate,
        AVG(interview_rate) as avg_interview_rate,
        AVG(interview_to_hire_rate) as avg_interview_to_hire_rate
    FROM greenhouse__talent_pipeline_simplified
""", conn)

labels = ['Application->Interview', 'Interview->Hire', 'Overall Hire']
values = [funnel_df['avg_interview_rate'].iloc[0], funnel_df['avg_interview_to_hire_rate'].iloc[0], funnel_df['avg_hire_rate'].iloc[0]]
plt.figure(figsize=(8,5))
bars = plt.bar(labels, values, color=['lightblue', 'lightgreen', 'gold'])
for bar, v in zip(bars, values):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01, f'{v:.1%}', ha='center')
plt.ylabel('Conversion Rate')
plt.title('Average Conversion Rates Across Recruitment Funnel')
plt.tight_layout()
plt.savefig('conversion_funnel.png', dpi=300)
plt.close()

# --- 4. Department‑level conversion rates ---
job_df = pd.read_sql_query("""
    SELECT departments, 
           COUNT(*) as num_jobs,
           AVG(overall_conversion_rate) as avg_conversion,
           AVG(interview_to_hire_rate) as avg_i2h,
           AVG(avg_job_rating) as avg_rating
    FROM greenhouse__job_enhanced
    WHERE departments IS NOT NULL AND departments != ''
    GROUP BY departments
    ORDER BY avg_conversion DESC
    LIMIT 10
""", conn)
plt.figure(figsize=(10,6))
plt.barh(job_df['departments'], job_df['avg_conversion'], color='teal')
plt.xlabel('Average Overall Conversion Rate')
plt.title('Top 10 Departments by Conversion Rate')
plt.tight_layout()
plt.savefig('department_conversion.png', dpi=300)
plt.close()

# --- 5. Interviewer recommendation distribution ---
try:
    interview_df = pd.read_sql_query("""
        SELECT overall_recommendation,
               COUNT(*) as count
        FROM greenhouse__interview_enhanced
        WHERE overall_recommendation IS NOT NULL AND overall_recommendation != ''
        GROUP BY overall_recommendation
        ORDER BY count DESC
    """, conn)
    if not interview_df.empty:
        plt.figure(figsize=(8,5))
        bars = plt.bar(interview_df['overall_recommendation'], interview_df['count'], color='purple')
        plt.xlabel('Overall Recommendation')
        plt.ylabel('Count')
        plt.title('Distribution of Interview Recommendations')
        for bar, v in zip(bars, interview_df['count']):
            plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 1, str(v), ha='center', fontsize=10)
        plt.tight_layout()
        plt.savefig('interview_recommendation.png', dpi=300)
        plt.close()
except Exception as e:
    print("Interview recommendation data not available:", e)

# --- 6. Cost reduction: source efficiency vs volume ---
# We'll plot volume (total_applications) vs efficiency (efficiency_score)
if not source_df.empty:
    plt.figure(figsize=(10,6))
    plt.scatter(source_df['total_applications'], source_df['efficiency_score'], s=100, alpha=0.7)
    for idx, row in source_df.iterrows():
        plt.annotate(row['source_name'], (row['total_applications'], row['efficiency_score']), fontsize=8)
    plt.xlabel('Total Applications')
    plt.ylabel('Efficiency Score')
    plt.title('Source Volume vs Efficiency (Size = Hire Rate)')
    plt.tight_layout()
    plt.savefig('source_volume_efficiency.png', dpi=300)
    plt.close()

conn.close()
```
