print("High segment size:", len(high))

# Compute average differences
metrics = ['total_count_surveys', 'total_count_completed_surveys', 'completion_rate',
           'count_surveys_sent_email', 'count_surveys_sent_sms',
           'count_surveys_opened_email', 'count_surveys_opened_sms',
           'count_surveys_started_email', 'count_surveys_started_sms',
           'count_surveys_completed_email', 'count_surveys_completed_sms',
           'avg_survey_progress_pct', 'avg_survey_duration_in_seconds',
           'channel_distinct', 'opened_distinct']

print("\nFeature importance (relative difference high vs medium):")
for metric in metrics:
    med_mean = medium[metric].mean()
    high_mean = high[metric].mean()
    if med_mean == 0:
        rel_diff = np.inf
    else:
        rel_diff = (high_mean - med_mean) / med_mean * 100
    abs_diff = high_mean - med_mean
    print(f"{metric:35s}: med={med_mean:6.2f}, high={high_mean:6.2f}, diff={abs_diff:7.2f}, rel={rel_diff:6.1f}%")

# Compute correlation between each metric and composite score within medium segment
print("\nCorrelation with composite_score within medium segment:")
for metric in metrics:
    corr = medium[metric].corr(medium['composite_score'])
    print(f"{metric:35s}: correlation {corr:.3f}")

# Now compare language-specific transition
print("\n--- Language-specific transition ---")
for lang in df['language'].unique():
