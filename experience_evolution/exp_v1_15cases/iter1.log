import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-060.sqlite')

# Load problematic ad group IDs
problematic = pd.read_csv('problematic_details.csv')
problem_ids = problematic['ad_group_id'].tolist()

# Compute match type performance for problematic vs non-problematic
query = """
SELECT 
    CASE WHEN ad_group_id IN ({}) THEN 1 ELSE 0 END AS is_problematic,
    keyword_match_type,
    SUM(clicks) as clicks,
    SUM(conversions) as conversions,
    CASE WHEN SUM(clicks) > 0 THEN SUM(conversions)*1.0/SUM(clicks) ELSE 0 END as cvr,
    SUM(spend) as spend
FROM google_ads__keyword_report
GROUP BY is_problematic, keyword_match_type
""".format(','.join(["'{}'".format(id) for id in problem_ids]))
match_perf = pd.read_sql_query(query, conn)
print("=== Match Type Performance ===")
print(match_perf.to_string(index=False))

# Search term match type distribution and performance
query2 = """
SELECT 
    CASE WHEN ad_group_id IN ({}) THEN 1 ELSE 0 END AS is_problematic,
    search_term_match_type,
    SUM(clicks) as clicks,
    SUM(conversions) as conversions,
    CASE WHEN SUM(clicks) > 0 THEN SUM(conversions)*1.0/SUM(clicks) ELSE 0 END as cvr,
    SUM(spend) as spend
FROM google_ads__search_term_report
WHERE search_term_match_type IS NOT NULL
GROUP BY is_problematic, search_term_match_type
ORDER BY is_problematic, cvr DESC
""".format(','.join(["'{}'".format(id) for id in problem_ids]))
search_perf = pd.read_sql_query(query2, conn)
print("\n=== Search Term Match Type Performance ===")
print(search_perf.to_string(index=False))

# Compute average keyword count per ad group (maybe problematic have fewer keywords?)
query3 = """
SELECT 
    CASE WHEN ad_group_id IN ({}) THEN 1 ELSE 0 END AS is_problematic,
    ad_group_id,
    COUNT(DISTINCT criterion_id) as keyword_count
FROM google_ads__keyword_report
GROUP BY is_problematic, ad_group_id
""".format(','.join(["'{}'".format(id) for id in problem_ids]))
keyword_counts = pd.read_sql_query(query3, conn)
print("\n=== Keyword Count per Ad Group ===")
print(keyword_counts.groupby('is_problematic')['keyword_count'].describe())

# Examine search term relevance: count of distinct search terms per click
query4 = """
SELECT 
    CASE WHEN ad_group_id IN ({}) THEN 1 ELSE 0 END AS is_problematic,
    COUNT(DISTINCT search_term) as unique_search_terms,
    SUM(clicks) as total_clicks,
    COUNT(DISTINCT search_term)*1.0/SUM(clicks) as unique_terms_per_click
FROM google_ads__search_term_report
WHERE search_term IS NOT NULL
GROUP BY is_problematic
""".format(','.join(["'{}'".format(id) for id in problem_ids]))
search_relevance = pd.read_sql_query(query4, conn)
print("\n=== Search Term Diversity ===")
print(search_relevance.to_string(index=False))

conn.close()
''')
