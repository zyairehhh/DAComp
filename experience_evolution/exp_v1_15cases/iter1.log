```python
import pandas as pd
import numpy as np

# Load contact data
df = pd.read_csv('contact_data.csv')
print(f"Total users: {len(df)}")

# Compute participation frequency
# Use total_count_surveys as participation count
participation = df['total_count_surveys'].fillna(0)

# Compute completion rate
df['completion_rate'] = np.where(
    df['total_count_surveys'] > 0,
    df['total_count_completed_surveys'] / df['total_count_surveys'],
    0
)

# Compute cross-channel activity
# Distinct channels used: email if count_surveys_sent_email > 0, SMS if count_surveys_sent_sms > 0
email_active = df['count_surveys_sent_email'] > 0
sms_active = df['count_surveys_sent_sms'] > 0
df['channel_distinct'] = email_active.astype(int) + sms_active.astype(int)  # max 2

# Additional cross-channel engagement: opened/started across channels
email_opened = df['count_surveys_opened_email'] > 0
sms_opened = df['count_surveys_opened_sms'] > 0
df['opened_distinct'] = email_opened.astype(int) + sms_opened.astype(int)

# We'll create a composite cross-channel score (0-1) combining distinct channels and engagement
# Let's define cross_channel_score = (channel_distinct / 2) * 0.5 + (opened_distinct / 2) * 0.5
df['cross_channel_raw'] = (df['channel_distinct'] / 2) * 0.5 + (df['opened_distinct'] / 2) * 0.5

# Normalize participation frequency (min-max scaling)
participation_min = participation.min()
participation_max = participation.max()
df['participation_norm'] = (participation - participation_min) / (participation_max - participation_min) if participation_max > participation_min else 0

# Normalize completion rate (already 0-1)
df['completion_norm'] = df['completion_rate'].clip(0, 1)

# Normalize cross-channel score (already 0-1)
df['cross_channel_norm'] = df['cross_channel_raw'].clip(0, 1)

# Weights (adjustable)
w_part = 0.4
w_comp = 0.4
w_cross = 0.2

# Composite score (0-100)
df['composite_score'] = (w_part * df['participation_norm'] + w_comp * df['completion_norm'] + w_cross * df['cross_channel_norm']) * 100

# Segmentation based on percentiles
low_threshold = df['composite_score'].quantile(0.33)
medium_threshold = df['composite_score'].quantile(0.66)
def segment(score):
    if score < low_threshold:
        return 'low_value'
    elif score < medium_threshold:
        return 'medium_value'
    else:
        return 'high_value'
df['segment'] = df['composite_score'].apply(segment)

# Add power user flag: maybe top 10% by composite score
power_threshold = df['composite_score'].quantile(0.90)
df['power_user'] = df['composite_score'] >= power_threshold

# Output CSV with scores
df.to_csv('user_value_scores.csv', index=False)

# Summary statistics
print("\nScore summary:")
print(df['composite_score'].describe())
print("\nSegment counts:")
print(df['segment'].value_counts())
print(f"\nPower users (top 10%): {df['power_user'].sum()}")

# Save segmentation thresholds for reference
thresholds = pd.DataFrame({
    'threshold': ['low_medium', 'medium_high', 'power'],
    'value': [low_threshold, medium_threshold, power_threshold]
})
thresholds.to_csv('score_thresholds.csv', index=False)
```
