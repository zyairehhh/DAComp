import sqlite3
import pandas as pd
import re
from collections import defaultdict

conn = sqlite3.connect('dacomp-081.sqlite')
cur = conn.cursor()
cur.execute("SELECT embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL")
rows = cur.fetchall()

field_counts = defaultdict(int)
value_counts = defaultdict(list)

for row in rows:
    ed = row[0]
    # parse pattern {key1:value1, key2:value2}
    # remove braces
    eds = ed.strip('{}')
    pairs = [pair.strip() for pair in eds.split(',')]
    for pair in pairs:
        if ':' not in pair:
            continue
        key, val = pair.split(':', 1)
        field_counts[key] += 1
        value_counts[key].append(val)

print("Top custom fields by frequency:")
for key, cnt in sorted(field_counts.items(), key=lambda x: -x[1])[:20]:
    print(f"{key}: {cnt} occurrences")
    # show unique values sample
    uniq_vals = set(value_counts[key])
    print(f"  Sample values: {list(uniq_vals)[:5]}")
    # if all values start with 'value_', maybe numeric after underscore
    numeric_vals = []
    for v in value_counts[key]:
        if v.startswith('value_'):
            try:
                num = int(v[6:])
                numeric_vals.append(num)
            except:
                pass
    if numeric_vals:
        print(f"  Numeric range: {min(numeric_vals)} - {max(numeric_vals)}")
    print()
```
