'''
import sqlite3
import re

conn = sqlite3.connect('dacomp-081.sqlite')
c = conn.cursor()
c.execute("SELECT embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL LIMIT 1000")
rows = c.fetchall()
pattern = r'custom_field_(\d+):value_(\d+)'
stats = {}
for r in rows:
    matches = re.findall(pattern, r[0])
    for key, val in matches:
        stats.setdefault(key, []).append(int(val))

print("Custom field counts:", {k: len(v) for k, v in stats.items()})
import pandas as pd
for key, vals in stats.items():
    print(f"custom_field_{key}: min={min(vals)}, max={max(vals)}, avg={sum(vals)/len(vals):.2f}")
