    JOIN display_case_information di ON ca."Inspected Display Case Reference" = di."Display case ID"
    WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
    """
    
    condition_data = pd.read_sql_query(condition_query, conn)
    
    if len(condition_data) > 0:
        # Create visualization for condition assessment
        plt.figure(figsize=(10, 6))
        plt.hist(condition_data['Condition Assessment Rating'].dropna(), bins=10, edgecolor='black', alpha=0.7)
        plt.xlabel('Condition Assessment Rating (higher is better)')
        plt.ylabel('Count')
        plt.title('Artifact Condition Distribution in High-Traffic Exhibition Halls')
        plt.savefig('artifact_condition_high_traffic.png', dpi=300, bbox_inches='tight')
        plt.close()
        print("Created artifact_condition_high_traffic.png")
        
except Exception as e:
    print(f"Could not fetch condition data: {e}")

try:
    # Get artifact ratings for artifacts in high-traffic halls
    # This requires linking through display cases and condition assessment
    rating_query = f"""
    SELECT ar.*, di."Gallery reference" as hall_id
    FROM artifact_rating ar
    JOIN condition_assessment ca ON ar."Cultural Relic Reference Number" = ca."Inspected Cultural Relic Reference"
    JOIN display_case_information di ON ca."Inspected Display Case Reference" = di."Display case ID"
    WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
    LIMIT 1000
    """
    
    rating_data = pd.read_sql_query(rating_query, conn)
    
    if len(rating_data) > 0:
        # Create visualization for cultural value scores
        plt.figure(figsize=(12, 8))
        
        rating_columns = ['Historical Significance Rating', 'Research Value Rating', 
                         'Exhibition Value Rating', 'Cultural Value Score',
                         'Public Accessibility Rating', 'Educational Value Rating']
        
        fig, axes = plt.subplots(2, 3, figsize=(15, 10))
        axes = axes.flatten()
        
        for i, col in enumerate(rating_columns[:6]):
            if col in rating_data.columns:
                axes[i].hist(rating_data[col].dropna(), bins=10, edgecolor='black', alpha=0.7)
                axes[i].set_xlabel(col)
                axes[i].set_ylabel('Count')
                axes[i].set_title(f'{col} Distribution')
        
        plt.suptitle('Artifact Rating Metrics in High-Traffic Exhibition Halls', fontsize=16)
        plt.tight_layout()
        plt.savefig('artifact_ratings_high_traffic.png', dpi=300, bbox_inches='tight')
        plt.close()
        print("Created artifact_ratings_high_traffic.png")
        
except Exception as e:
    print(f"Could not fetch rating data: {e}")

# Analyze risks: Check for environmental parameters outside recommended ranges
env_risks = []
if 'env_data' in locals() and len(env_data) > 0:
    # Museum standards: Temperature 18-22°C, Humidity 40-60%
    temp_outside = ((env_data['Temperature (°C)'] < 18) | (env_data['Temperature (°C)'] > 22)).sum()
    humidity_outside = ((env_data['Relative Humidity (%)'] < 40) | (env_data['Relative Humidity (%)'] > 60)).sum()
    
    env_risks.append(f"Temperature readings outside 18-22°C range: {temp_outside}/{len(env_data)} ({temp_outside/len(env_data)*100:.1f}%)")
    env_risks.append(f"Humidity readings outside 40-60% range: {humidity_outside}/{len(env_data)} ({humidity_outside/len(env_data)*100:.1f}%)")

if 'air_quality_data' in locals() and len(air_quality_data) > 0:
    # Museum standards: CO2 < 1000 ppm, TVOCs < 500 ppb
    co2_high = (air_quality_data['Carbon dioxide concentration (ppm)'] > 1000).sum()
    tvocs_high = (air_quality_data['Total volatile organic compounds concentration (ppb)'] > 500).sum()
    
    env_risks.append(f"CO2 concentrations > 1000 ppm: {co2_high}/{len(air_quality_data)} ({co2_high/len(air_quality_data)*100:.1f}%)")
    env_risks.append(f"TVOC concentrations > 500 ppb: {tvocs_high}/{len(air_quality_data)} ({tvocs_high/len(air_quality_data)*100:.1f}%)")

if 'light_data' in locals() and len(light_data) > 0:
    # Museum standards: Light sensitive materials < 50 lux, moderately sensitive < 200 lux
    light_high = (light_data['Illuminance (Lux)'] > 200).sum()
    
    env_risks.append(f"Illuminance > 200 lux (above moderate sensitivity threshold): {light_high}/{len(light_data)} ({light_high/len(light_data)*100:.1f}%)")

# Save risk analysis to file
with open('risk_analysis_summary.txt', 'w') as f:
    f.write("ENVIRONMENTAL RISK ANALYSIS FOR HIGH-TRAFFIC EXHIBITION HALLS\n")
    f.write("="*60 + "\n\n")
    for risk in env_risks:
        f.write(f"- {risk}\n")

print("\nRisk analysis summary saved to risk_analysis_summary.txt")

print("Visualization script completed.")
''')
