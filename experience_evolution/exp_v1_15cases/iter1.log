import sqlite3, re

conn = sqlite3.connect('dacomp-081.sqlite')
cursor = conn.cursor()
cursor.execute("SELECT embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL")
cf_distinct = {}
for row in cursor.fetchall():
    ed = row[0]
    matches = re.findall(r'custom_field_(\d+):value_(\d+)', ed)
    for cf, val in matches:
        if cf not in cf_distinct:
            cf_distinct[cf] = set()
        cf_distinct[cf].add(val)

# group by distinct count
grouped = {}
for cf, s in cf_distinct.items():
    cnt = len(s)
    grouped.setdefault(cnt, []).append(cf)

for cnt, cfs in sorted(grouped.items()):
    print(f"Distinct {cnt}: {len(cfs)} custom_fields (examples: {cfs[:5]})")
conn.close()
