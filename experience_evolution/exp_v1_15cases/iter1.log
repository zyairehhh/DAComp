conn = sqlite3.connect('dacomp-078.sqlite')

# Load visitor daily metrics and visitor-account mapping
# visitor table has account_id
visitor_df = pd.read_sql_query("SELECT visitor_id, account_id FROM pendo__visitor", conn)
daily_df = pd.read_sql_query("SELECT * FROM pendo__visitor_daily_metrics", conn)

# Merge to get account_id per daily record
df = pd.merge(daily_df, visitor_df, on='visitor_id', how='inner')
conn.close()

# Convert date_day to datetime and extract year-month
df['date_day'] = pd.to_datetime(df['date_day'])
df['year_month'] = df['date_day'].dt.to_period('M')

# Aggregate monthly minutes per account
monthly = df.groupby(['account_id', 'year_month'])['sum_minutes'].sum().reset_index()
# Ensure each account has at least 3 months of data for slope calculation
counts = monthly.groupby('account_id').size()
valid_accounts = counts[counts >= 3].index
monthly = monthly[monthly['account_id'].isin(valid_accounts)]

# Compute linear slope (trend) per account
slopes = []
for acc in monthly['account_id'].unique():
    sub = monthly[monthly['account_id'] == acc]
    # convert period to numeric month index (e.g., number of months since earliest month)
    sub = sub.sort_values('year_month')
    sub['month_num'] = np.arange(len(sub))
    if len(sub) >= 2:
        slope, intercept, r_value, p_value, std_err = stats.linregress(sub['month_num'], sub['sum_minutes'])
        slopes.append(slope)

slopes = np.array(slopes)
print(f'Number of accounts with >=3 months: {len(slopes)}')
print(f'Mean slope: {slopes.mean():.2f} minutes per month')
print(f'Median slope: {np.median(slopes):.2f}')
print(f'Min slope: {slopes.min():.2f}')
print(f'Max slope: {slopes.max():.2f}')
print(f'Accounts with positive slope: {(slopes > 0).sum()}')
print(f'Accounts with negative slope: {(slopes < 0).sum()}')
print(f'Accounts with zero slope (within epsilon): {(np.abs(slopes) < 1e-10).sum()}')

# Histogram of slopes
plt.figure(figsize=(10, 6))
plt.hist(slopes, bins=50, edgecolor='black', alpha=0.7, color='purple')
plt.axvline(x=0, color='red', linestyle='--', linewidth=2, label='Zero Trend')
plt.axvline(x=slopes.mean(), color='green', linestyle='-', linewidth=2, label=f'Mean Slope = {slopes.mean():.2f}')
plt.xlabel('Monthly Trend Slope (minutes per month)')
plt.ylabel('Number of Accounts')
plt.title('Distribution of Account‑Level Monthly Usage Trends')
plt.legend()
plt.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('trend_slopes_histogram.png', dpi=150)
plt.close()

# Scatter of monthly minutes vs month index for a few example accounts
example_accounts = monthly['account_id'].unique()[:6]  # first six
fig, axes = plt.subplots(2, 3, figsize=(15, 10))
axes = axes.ravel()
for idx, acc in enumerate(example_accounts):
    sub = monthly[monthly['account_id'] == acc].sort_values('year_month')
    sub['month_num'] = np.arange(len(sub))
    axes[idx].plot(sub['month_num'], sub['sum_minutes'], marker='o', linestyle='-')
    axes[idx].set_title(f'Account {acc[:8]}...')
    axes[idx].set_xlabel('Month Index')
    axes[idx].set_ylabel('Monthly Minutes')
    axes[idx].grid(True, alpha=0.3)
plt.suptitle('Example Monthly Usage Patterns (First Six Accounts)', fontsize=16)
plt.tight_layout(rect=[0, 0, 1, 0.96])
plt.savefig('example_monthly_patterns.png', dpi=150)
plt.close()

print("Plots generated: trend_slopes_histogram.png, example_monthly_patterns.png")
''')
