'''
import sqlite3
import re
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
matplotlib.use('Agg')

conn = sqlite3.connect('dacomp-081.sqlite')
cur = conn.cursor()
cur.execute("SELECT survey_name, embedded_data, value, user_language FROM qualtrics__response WHERE embedded_data IS NOT NULL AND value IS NOT NULL AND user_language IS NOT NULL")
rows = cur.fetchall()
data = []
for row in rows:
    survey_name, embedded_data, value_str, user_language = row
    try:
        value = float(value_str)
    except:
        continue
    # parse embedded_data for custom_field_580
    revenue_val = None
    pattern = re.compile(r'custom_field_580:value_(\d+)')
    match = pattern.search(embedded_data)
    if match:
        revenue_val = int(match.group(1))
    data.append({
        'survey_name': survey_name,
        'value': value,
        'language': user_language,
        'revenue': revenue_val
    })

df = pd.DataFrame(data)

# Chart 1: Mean performance per language
lang_means = df.groupby('language')['value'].mean().reset_index()
lang_means = lang_means.sort_values('value', ascending=False)

plt.figure(figsize=(10,6))
bars = plt.bar(lang_means['language'], lang_means['value'], color='steelblue')
plt.xlabel('User Language (Region Proxy)')
plt.ylabel('Average Performance Score')
plt.title('Performance Divergence Across Regions (Language)')
# Add value labels on top
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, height + 0.02, f'{height:.2f}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('performance_by_language.png', dpi=300)
plt.close()

# Chart 2: Box plot for high/low revenue groups (using custom_field_580)
df_rev = df.dropna(subset=['revenue'])
# Normalize revenue to approximate scale 0-10
df_rev['rev_norm'] = (df_rev['revenue'] - df_rev['revenue'].min()) / (df_rev['revenue'].max() - df_rev['revenue'].min()) * 10
# Classify: high revenue >7, low revenue <3
high_rev = df_rev[df_rev['rev_norm'] > 7]['value']
low_rev = df_rev[df_rev['rev_norm'] < 3]['value']

plt.figure(figsize=(8,6))
box_data = [high_rev, low_rev]
plt.boxplot(box_data, labels=[f'High Revenue\n(> 7)', f'Low Revenue\n(< 3)'])
plt.ylabel('Performance Score')
plt.title('Performance Comparison: High vs Low Revenue Markets')
plt.tight_layout()
plt.savefig('performance_by_revenue.png', dpi=300)
plt.close()

print("Generated plots.")
''')
