import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib

# Ensure English labels
matplotlib.rcParams.update({'font.size': 12})

# Connect to database
conn = sqlite3.connect('dacomp-078.sqlite')

# Load account data
df = pd.read_sql_query("SELECT * FROM pendo__account", conn)
conn.close()

# Define high-value label (top 25% by sum_minutes)
threshold = df['sum_minutes'].quantile(0.75)
df['high_value'] = (df['sum_minutes'] >= threshold).astype(int)

# Features used in Stage1
features = [
    'average_daily_events',
    'average_daily_minutes',
    'count_feature_clicking_visitors',
    'count_active_days',
    'count_active_visitors',
    'count_page_viewing_visitors',
    'count_active_months',
    'avg_nps_rating'
]

# Compute Pearson correlation with high_value label
correlations = {}
for feat in features:
    corr = df[feat].corr(df['high_value'])
    correlations[feat] = corr

# Sort by absolute correlation for plotting
sorted_corr = sorted(correlations.items(), key=lambda x: abs(x[1]), reverse=True)
feat_names = [f.replace('_', ' ').title() for f, _ in sorted_corr]
corr_values = [v for _, v in sorted_corr]

# Plot 1: Feature Correlation with High‑Value Label
plt.figure(figsize=(10, 6))
bars = plt.barh(feat_names, corr_values, color='steelblue')
plt.xlabel('Pearson Correlation with High‑Value Label')
plt.title('Feature Correlations with High‑Value (Top 25% Total Minutes)')
plt.xlim(-0.1, 0.8)
# Add value labels on bars
for bar, val in zip(bars, corr_values):
    width = bar.get_width()
    plt.text(width + 0.01, bar.get_y() + bar.get_height()/2,
             f'{val:.3f}', ha='left', va='center')
plt.tight_layout()
plt.savefig('feature_correlations.png', dpi=150)
plt.close()

# Plot 2: Weights of Multi‑dimensional Model (from Stage1)
weights = {
    'average_daily_events': 0.1917,
    'average_daily_minutes': 0.1861,
    'count_feature_clicking_visitors': 0.1135,
    'count_active_days': 0.1134,
    'count_active_visitors': 0.1121,
    'count_page_viewing_visitors': 0.1119,
    'count_active_months': 0.1109,
    'avg_nps_rating': 0.0603
}
# Keep same order as correlation plot for consistency
weight_names = [f.replace('_', ' ').title() for f in feat_names]
weight_vals = [weights[f.replace(' ', '_').lower()] for f in weight_names]

plt.figure(figsize=(10, 6))
bars2 = plt.barh(weight_names, weight_vals, color='darkorange')
plt.xlabel('Weight in Multi‑dimensional Scoring Model')
plt.title('Feature Weights in Proposed Value Model')
plt.xlim(0, 0.25)
for bar, val in zip(bars2, weight_vals):
    width = bar.get_width()
    plt.text(width + 0.005, bar.get_y() + bar.get_height()/2,
             f'{val:.4f}', ha='left', va='center')
plt.tight_layout()
plt.savefig('feature_weights.png', dpi=150)
plt.close()

# Plot 3: Model Performance Comparison
# Accuracy numbers from Stage1
models = ['Existing (Duration+Frequency)', 'Proposed Multi‑dimensional']
accuracies = [0.875, 0.849]  # Stage1 reports 87.5% and 84.9%
colors = ['lightcoral', 'lightgreen']

plt.figure(figsize=(8, 5))
bars3 = plt.bar(models, accuracies, color=colors, edgecolor='black')
plt.ylabel('Accuracy')
plt.title('Model Accuracy in Identifying High‑Value Customers')
plt.ylim(0, 1.0)
for bar, acc in zip(bars3, accuracies):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, height + 0.01,
             f'{acc:.1%}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('model_accuracy_comparison.png', dpi=150)
plt.close()

print("Plots generated: feature_correlations.png, feature_weights.png, model_accuracy_comparison.png")
```
