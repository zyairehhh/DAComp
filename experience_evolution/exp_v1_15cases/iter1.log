```
import sqlite3
import pandas as pd
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-058.sqlite')

# 1. Identify campaigns that have at least one month with cost > $1000 and ROI < 0.8
query = """
SELECT DISTINCT campaign_id, campaign_name, campaign_type, bidding_strategy, industry
FROM google_ads__campaign_report
WHERE cost > 1000 AND (conversion_value - cost)/cost < 0.8
"""
candidates = pd.read_sql_query(query, conn)
print(f"Candidate campaigns count: {len(candidates)}")

# 2. For each candidate, compute aggregated metrics across all months (full history)
# We'll compute:
# - total_cost, total_conversion_value, total_conversions, total_clicks, total_impressions
# - average ROAS, ROI, CTR, conversion_rate, quality_score, impression_share
# - average avg_position from keyword_report (weighted by impressions)
# - average device and geo distribution metrics? Might not be needed.

# Get campaign-level summary from campaign_report
campaign_summary = pd.read_sql_query("""
    SELECT
        campaign_id,
        SUM(cost) as total_cost,
        SUM(conversion_value) as total_conversion_value,
        SUM(conversions) as total_conversions,
        SUM(clicks) as total_clicks,
        SUM(impressions) as total_impressions,
        AVG(ctr) as avg_ctr,
        AVG(conversion_rate) as avg_conversion_rate,
        AVG(quality_score) as avg_quality_score,
        AVG(impression_share) as avg_impression_share,
        AVG(roas) as avg_roas,
        AVG((conversion_value - cost)/cost) as avg_roi
    FROM google_ads__campaign_report
    GROUP BY campaign_id
""", conn)

# Get avg_position from keyword_report (weighted by impressions)
keyword_avg = pd.read_sql_query("""
    SELECT
        campaign_id,
        SUM(impressions * avg_position) / SUM(impressions) as avg_position_weighted
    FROM google_ads__keyword_report
    WHERE impressions > 0
    GROUP BY campaign_id
""", conn)

# Merge
campaign_metrics = campaign_summary.merge(keyword_avg, on='campaign_id', how='left')
# Add candidate flag
campaign_metrics['is_candidate'] = campaign_metrics['campaign_id'].isin(candidates['campaign_id'])

print("Campaign metrics sample:")
print(campaign_metrics.head())
print("\nCandidate campaigns metrics shape:", campaign_metrics[campaign_metrics['is_candidate']].shape)

# 3. Define health score sub-scores
# We'll normalize each metric to a 0-100 scale using percentile ranks or min-max scaling.
# Since we need to compare across dimensions, we'll use percentile rank (0-100) within all campaigns.
# For each metric, higher is better (except avg_position where lower is better; we'll invert).
# Define which metrics belong to which dimension:
# Cost Efficiency (40%): avg_roi, maybe total_cost? Actually efficiency is about ROI, ROAS, cost_per_conversion.
# Conversion Quality (35%): avg_conversion_rate, avg_quality_score
# Competitiveness (25%): avg_ctr, avg_impression_share, avg_position_weighted (inverted)

# Compute percentile ranks
for col in ['avg_roi', 'avg_conversion_rate', 'avg_quality_score', 'avg_ctr', 'avg_impression_share']:
    campaign_metrics[col+'_rank'] = campaign_metrics[col].rank(pct=True) * 100

# For avg_position_weighted, lower is better: rank inversely
campaign_metrics['avg_position_inverted'] = 1 / campaign_metrics['avg_position_weighted']  # lower position -> higher score
campaign_metrics['avg_position_rank'] = campaign_metrics['avg_position_inverted'].rank(pct=True) * 100

# Compute dimension scores
campaign_metrics['cost_efficiency_score'] = campaign_metrics['avg_roi_rank'] * 0.4
campaign_metrics['conversion_quality_score'] = (campaign_metrics['avg_conversion_rate_rank'] + campaign_metrics['avg_quality_score_rank']) / 2 * 0.35
campaign_metrics['competitiveness_score'] = (campaign_metrics['avg_ctr_rank'] + campaign_metrics['avg_impression_share_rank'] + campaign_metrics['avg_position_rank']) / 3 * 0.25

campaign_metrics['health_score'] = (campaign_metrics['cost_efficiency_score'] +
                                    campaign_metrics['conversion_quality_score'] +
                                    campaign_metrics['competitiveness_score'])

# Risk level: based on health_score percentiles
campaign_metrics['risk_level'] = pd.qcut(campaign_metrics['health_score'], q=4, labels=['Low', 'Medium', 'High', 'Critical'])

# Add campaign metadata
campaign_meta = pd.read_sql_query("""
    SELECT DISTINCT campaign_id, campaign_name, campaign_type, bidding_strategy, industry
    FROM google_ads__campaign_report
""", conn)
campaign_metrics = campaign_metrics.merge(campaign_meta, on='campaign_id', how='left')

# Sort by health_score ascending (worst first)
campaign_metrics.sort_values('health_score', inplace=True)
print("\nTop 10 worst campaigns by health score:")
print(campaign_metrics[['campaign_id','campaign_name','health_score','risk_level','avg_roi','avg_conversion_rate','avg_quality_score','avg_ctr','avg_impression_share','avg_position_weighted']].head(10))

# Save to CSV for review
campaign_metrics.to_csv('campaign_health_scores.csv', index=False)
print("\nSaved to campaign_health_scores.csv")

conn.close()
```
