'''
import sqlite3, re

conn = sqlite3.connect('dacomp-081.sqlite')
cursor = conn.cursor()
cursor.execute("SELECT value, embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL")
cf_stats = {}
for row in cursor.fetchall():
    v = row[0]
    ed = row[1]
    matches = re.findall(r'custom_field_(\d+):value_(\d+)', ed)
    for cf, _ in matches:
        if cf not in cf_stats:
            cf_stats[cf] = {'total':0, 'gt7':0, 'lt3':0}
        cf_stats[cf]['total'] += 1
        if v > 7:
            cf_stats[cf]['gt7'] += 1
        if v < 3:
            cf_stats[cf]['lt3'] += 1

print("custom_field,total,gt7,lt3,gt7_pct,lt3_pct")
for cf, data in sorted(cf_stats.items(), key=lambda x: x[1]['total'], reverse=True)[:30]:
    total = data['total']
    gt7 = data['gt7']
    lt3 = data['lt3']
    pct_gt7 = gt7/total*100 if total>0 else 0
    pct_lt3 = lt3/total*100 if total>0 else 0
    print(f"{cf},{total},{gt7},{lt3},{pct_gt7:.1f},{pct_lt3:.1f}")
conn.close()
''')
