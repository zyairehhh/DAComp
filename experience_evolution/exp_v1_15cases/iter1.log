Action: CreateFile(filepath='benefit_percentage.py':
'''
import pandas as pd
import re
import sqlite3

conn = sqlite3.connect('dacomp-048.sqlite')
query = "SELECT * FROM sheet1 WHERE \"Education Requirement\" = 'Vocational school or above'"
df = pd.read_sql_query(query, conn)
def split_benefits(benefit_str):
    if not isinstance(benefit_str, str):
        return []
    parts = re.split(r'[,;、，；]', benefit_str)
    cleaned = [p.strip() for p in parts if p.strip()]
    return cleaned

all_benefits = []
for b in df['Benefits'].dropna():
    all_benefits.extend(split_benefits(b))
from collections import Counter
benefit_counts = Counter(all_benefits)
total = len(all_benefits)
top = benefit_counts.most_common(30)
df_out = pd.DataFrame(top, columns=['Benefit', 'Count'])
df_out['Percentage'] = (df_out['Count'] / total * 100).round(2)
print(df_out)
df_out.to_csv('benefit_percentage.csv', index=False)
conn.close()
''')
