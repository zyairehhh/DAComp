        JOIN display_case_information di ON emd."Display Case Reference" = di."Display case ID"
        WHERE di."Display case ID" IN ({placeholders2})
        """
        
        env_data = pd.read_sql_query(env_query, conn, params=display_case_ids)
        print(f"Environmental monitoring records: {len(env_data)}")
        
        # Step 4: Get air quality data
        air_quality_query = f"""
        SELECT aqr.*, TRIM(di."Gallery reference") as hall_id
        FROM air_quality_readings aqr
        JOIN environmental_monitoring_data emd ON aqr."Environmental monitoring reference" = emd."Environmental Reading ID"
        JOIN display_case_information di ON emd."Display Case Reference" = di."Display case ID"
        WHERE di."Display case ID" IN ({placeholders2})
        """
        
        air_quality_data = pd.read_sql_query(air_quality_query, conn, params=display_case_ids)
