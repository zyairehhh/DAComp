import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
df_account = pd.read_sql_query("""
    SELECT account_id, 
           sum_minutes, sum_events,
           count_active_days, count_active_months,
           avg_nps_rating,
           count_active_visitors,
           count_page_viewing_visitors,
           count_feature_clicking_visitors,
           average_daily_minutes, average_daily_events
    FROM pendo__account
""", conn)
df_account.set_index('account_id', inplace=True)

# define high-value as top 25% of sum_minutes
threshold = df_account['sum_minutes'].quantile(0.75)
df_account['high_value'] = (df_account['sum_minutes'] > threshold).astype(int)

# select features for scoring (excluding sum_minutes, sum_events because they are directly correlated with target)
features = ['average_daily_events', 'average_daily_minutes',
            'count_feature_clicking_visitors', 'count_active_days',
            'count_active_visitors', 'count_page_viewing_visitors',
            'count_active_months', 'avg_nps_rating']
X = df_account[features].copy()
y = df_account['high_value'].copy()

# standardize
X_norm = (X - X.mean()) / X.std()
# compute correlation with target
corr = X_norm.columns.map(lambda col: X_norm[col].corr(y))
# weights as normalized correlation (absolute)
weights = corr / np.abs(corr).sum()
# compute score
score = X_norm.dot(weights)
df_account['score'] = score

# find optimal threshold for classification
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
thresholds = np.linspace(score.min(), score.max(), 50)
best_acc = 0
best_thresh = 0
for t in thresholds:
    pred = (score > t).astype(int)
    acc = accuracy_score(y, pred)
    if acc > best_acc:
        best_acc = acc
        best_thresh = t

print("Weighted score correlation with high_value:", score.corr(y))
print("Best accuracy using threshold on score:", best_acc)
print("Threshold value:", best_thresh)
print("Precision at best threshold:", precision_score(y, (score > best_thresh).astype(int)))
print("Recall at best threshold:", recall_score(y, (score > best_thresh).astype(int)))
print("F1 score:", f1_score(y, (score > best_thresh).astype(int)))

# compare with baseline: using only sum_minutes > threshold (original)
baseline_acc = accuracy_score(y, (df_account['sum_minutes'] > threshold).astype(int))
print("\nBaseline accuracy (using sum_minutes > percentile 75):", baseline_acc)
# but this is the same as high_value definition, accuracy would be 1? Wait high_value defined as sum_minutes > threshold, so baseline accuracy is 1. Actually that's trivial.
# We need to evaluate how well other features predict high_value defined by sum_minutes.
# Let's compute accuracy of using average_daily_minutes > median as predictor.
median_avg = df_account['average_daily_minutes'].median()
pred_avg = (df_account['average_daily_minutes'] > median_avg).astype(int)
acc_avg = accuracy_score(y, pred_avg)
print("Accuracy using average_daily_minutes > median:", acc_avg)

# compute feature importance using Gini? Not necessary.

# propose scoring formula:
print("\nProposed scoring weights:")
for feat, w in zip(features, weights):
    print(f"{feat}: {w:.4f}")

# compute accuracy of proposed scoring with equal weights
weights_eq = np.ones(len(features)) / len(features)
score_eq = X_norm.dot(weights_eq)
best_acc_eq = 0
for t in thresholds:
    pred = (score_eq > t).astype(int)
    acc = accuracy_score(y, pred)
    if acc > best_acc_eq:
        best_acc_eq = acc
        best_t_eq = t
print("\nEqual weights accuracy:", best_acc_eq)

# compute accuracy of existing model? We don't have that but the prompt says existing model accuracy is 68%.
# Build a simple linear combination of those two (equal weight) and evaluate.
existing_features = ['average_daily_minutes', 'average_daily_events']
X_existing = df_account[existing_features]
X_existing_norm = (X_existing - X_existing.mean()) / X_existing.std()
score_existing = X_existing_norm.mean(axis=1)
# find best threshold
best_acc_existing = 0
for t in thresholds:
    pred = (score_existing > t).astype(int)
    acc = accuracy_score(y, pred)
    if acc > best_acc_existing:
        best_acc_existing = acc
        best_t_existing = t
print("\nExisting model (duration + frequency) accuracy:", best_acc_existing)

conn.close()
```
