import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import statsmodels.api as sm
from sklearn.preprocessing import PolynomialFeatures
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-070.sqlite')
print("Connected to database")

# Load data
country_df = pd.read_sql_query("SELECT * FROM google_play__country_report", conn)
country_df['date_day'] = pd.to_datetime(country_df['date_day'])
device_df = pd.read_sql_query("SELECT * FROM google_play__device_report", conn)
device_df['date_day'] = pd.to_datetime(device_df['date_day'])
ts_df = pd.read_sql_query("SELECT * FROM google_play__time_series_trends", conn)
ts_df['date_day'] = pd.to_datetime(ts_df['date_day'])

conn.close()

print("Data loaded.")

# 1. Decay patterns of user acquisition cost-efficiency (conversion rate) per region over past 6 months
# Compute monthly average conversion rate per region
country_df['year_month'] = country_df['date_day'].dt.to_period('M')
region_monthly = country_df.groupby(['region', 'year_month'])['store_listing_conversion_rate'].mean().reset_index()
# Calculate decay (slope) per region using linear regression on month index
region_decay = []
for region in region_monthly['region'].unique():
    sub = region_monthly[region_monthly['region'] == region].copy()
    sub = sub.sort_values('year_month')
    sub['month_num'] = range(len(sub))
    if len(sub) >= 2:
        X = sm.add_constant(sub['month_num'])
        y = sub['store_listing_conversion_rate']
        model = sm.OLS(y, X).fit()
        slope = model.params['month_num']
        region_decay.append({'region': region, 'decay_slope': slope, 'r_squared': model.rsquared})
    else:
        region_decay.append({'region': region, 'decay_slope': None, 'r_squared': None})
region_decay_df = pd.DataFrame(region_decay)
print("\nRegion conversion rate decay slopes:")
print(region_decay_df)

# 2. Decay patterns per device type (extract brand from device name)
# Extract brand as first word of device
device_df['device_brand'] = device_df['device'].apply(lambda x: x.split()[0] if isinstance(x, str) else 'Unknown')
device_df['year_month'] = device_df['date_day'].dt.to_period('M')
# Need conversion rate per device? Not directly available. Use store_listing_conversion_rate from country? Not possible.
# Instead, we can compute device-level acquisition efficiency as device_installs per store_listing_visitors? But visitors not in device_report.
# We need to join device_report with country_report? Not feasible.
# Let's consider using device-specific conversion rate from aggregated data? Might need to approximate.
# Since we don't have device-level conversion, we can analyze decay of active_devices_last_30_days per device brand.
device_monthly = device_df.groupby(['device_brand', 'year_month'])['active_devices_last_30_days'].mean().reset_index()
device_decay = []
for brand in device_monthly['device_brand'].unique():
    sub = device_monthly[device_monthly['device_brand'] == brand].copy()
    sub = sub.sort_values('year_month')
    sub['month_num'] = range(len(sub))
    if len(sub) >= 2:
        X = sm.add_constant(sub['month_num'])
        y = sub['active_devices_last_30_days']
        model = sm.OLS(y, X).fit()
        slope = model.params['month_num']
        device_decay.append({'device_brand': brand, 'decay_slope': slope, 'r_squared': model.rsquared})
    else:
        device_decay.append({'device_brand': brand, 'decay_slope': None, 'r_squared': None})
device_decay_df = pd.DataFrame(device_decay)
print("\nDevice brand active devices decay slopes:")
print(device_decay_df)

# 3. Non-linear relationship between store_listing_conversion_rate and quality_score / crash_rate_per_1k
# We need to join conversion rate with quality and crash at day level across apps and regions.
# Aggregate conversion rate per day (average across regions and apps)
daily_conversion = country_df.groupby('date_day')['store_listing_conversion_rate'].mean().reset_index()
# Aggregate quality_score and crash_rate_per_1k per day (average across apps)
daily_quality = ts_df.groupby('date_day')[['quality_score', 'crash_rate_per_1k']].mean().reset_index()
# Merge
daily_metrics = pd.merge(daily_conversion, daily_quality, on='date_day', how='inner')
print("\nDaily aggregated metrics shape:", daily_metrics.shape)
print(daily_metrics.head())

# 3a. Scatter plots and polynomial regression
# We'll compute polynomial regression of conversion rate vs quality_score (degree 2)
X_qual = daily_metrics['quality_score'].values.reshape(-1,1)
poly = PolynomialFeatures(degree=2, include_bias=False)
X_poly = poly.fit_transform(X_qual)
X_poly = sm.add_constant(X_poly)
y_conv = daily_metrics['store_listing_conversion_rate']
model_qual = sm.OLS(y_conv, X_poly).fit()
print("\nPolynomial regression (quality_score) coefficients:", model_qual.params)
print("R-squared:", model_qual.rsquared)

# 3b. Conversion vs crash_rate_per_1k
X_crash = daily_metrics['crash_rate_per_1k'].values.reshape(-1,1)
X_poly_crash = poly.fit_transform(X_crash)
X_poly_crash = sm.add_constant(X_poly_crash)
model_crash = sm.OLS(y_conv, X_poly_crash).fit()
print("\nPolynomial regression (crash_rate_per_1k) coefficients:", model_crash.params)
print("R-squared:", model_crash.rsquared)

# 4. Multi-dimensional user value decay model for revenue_per_active_device
# We'll build a linear regression with interaction terms
# Features: store_listing_conversion_rate, quality_score, crash_rate_per_1k, active_devices_last_30_days, rolling_total_average_rating, update_frequency
# Need update_frequency: compute from country_df or device_df? Use update_events per day per app, sum across regions/devices.
daily_updates = country_df.groupby(['date_day', 'package_name'])['update_events'].sum().reset_index()
daily_updates_total = daily_updates.groupby('date_day')['update_events'].sum().reset_index()
daily_updates_total.rename(columns={'update_events': 'total_update_events'}, inplace=True)

# Aggregate other metrics per day (average across apps)
daily_ts = ts_df.groupby('date_day').agg({
    'revenue_per_active_device': 'mean',
    'active_devices': 'mean',
    'quality_score': 'mean',
    'crash_rate_per_1k': 'mean',
    'rolling_total_average_rating': 'mean'  # Not in ts_df, but in country_df and device_df
}).reset_index()
# Rolling total average rating from country_df average per day
daily_rating = country_df.groupby('date_day')['rolling_total_average_rating'].mean().reset_index()
daily_rating.rename(columns={'rolling_total_average_rating': 'avg_rolling_rating'}, inplace=True)
# Merge
daily_model = pd.merge(daily_ts, daily_rating, on='date_day', how='left')
daily_model = pd.merge(daily_model, daily_conversion, on='date_day', how='left')
daily_model = pd.merge(daily_model, daily_updates_total, on='date_day', how='left')
print("\nDaily model dataset shape:", daily_model.shape)
print(daily_model.head())

# Build regression model for revenue_per_active_device
# Drop rows with NaN
daily_model_clean = daily_model.dropna()
X = daily_model_clean[['store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k',
                       'active_devices', 'avg_rolling_rating', 'total_update_events']]
# Add interaction term: update_events * avg_rolling_rating (as per task)
X['update_rating_interaction'] = X['total_update_events'] * X['avg_rolling_rating']
X = sm.add_constant(X)
y = daily_model_clean['revenue_per_active_device']
model_rev = sm.OLS(y, X).fit()
print("\nRegression model for revenue_per_active_device:")
print(model_rev.summary())

# 5. Quantify interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
# We need active_devices_last_30_days per day (from country_df or device_df). Use country_df's active_devices_last_30_days aggregated per day.
daily_active = country_df.groupby('date_day')['active_devices_last_30_days'].mean().reset_index()
daily_update = daily_updates_total.copy()
daily_merge = pd.merge(daily_active, daily_update, on='date_day', how='inner')
daily_merge = pd.merge(daily_merge, daily_rating, on='date_day', how='inner')
# Build regression with interaction term
X_int = daily_merge[['total_update_events', 'avg_rolling_rating']].copy()
X_int['interaction'] = X_int['total_update_events'] * X_int['avg_rolling_rating']
X_int = sm.add_constant(X_int)
y_active = daily_merge['active_devices_last_30_days']
model_active = sm.OLS(y_active, X_int).fit()
print("\nRegression for active_devices_last_30_days (with interaction):")
print(model_active.summary())

# Also for rolling rating as dependent variable? Actually interaction effect on both active devices and rating.
# Let's also regress avg_rolling_rating on total_update_events (with interaction) maybe not needed.
# Compute correlation between update frequency and rating.

print("\nAnalysis completed.")
