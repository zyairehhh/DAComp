import pandas as pd
import numpy as np
import sqlite3

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# Load aggregated ad groups (already computed)
ad_group_agg = pd.read_csv('ad_group_aggregates.csv')
print(f"Total ad groups: {len(ad_group_agg)}")

# Compute percentiles
ctr_75 = ad_group_agg['ctr'].quantile(0.75)
cvr_25 = ad_group_agg['cvr'].quantile(0.25)
print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# Filter problematic ad groups: CTR > 75th percentile and CVR < 25th percentile
problematic = ad_group_agg[(ad_group_agg['ctr'] > ctr_75) & (ad_group_agg['cvr'] < cvr_25)]
print(f"Problematic ad groups count: {len(problematic)}")

# Save problematic list
problematic.to_csv('problematic_ad_groups.csv', index=False)

# Compute overall average CVR per match type (already computed)
match_type_cvr = pd.read_csv('match_type_cvr.csv')
print("\nMatch type CVR:")
print(match_type_cvr)

# Compute expected CVR per ad group based on keyword mix
# Get keyword-level data per ad group
query = """
SELECT ad_group_id, keyword_match_type,
       SUM(clicks) as clicks,
       SUM(conversions) as conversions
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
keyword_agg = pd.read_sql_query(query, conn)
print(f"\nKeyword aggregation rows: {len(keyword_agg)}")

# Merge with overall average CVR per match type
keyword_agg = keyword_agg.merge(match_type_cvr[['keyword_match_type', 'avg_cvr']], on='keyword_match_type', how='left')
# Compute expected conversions = clicks * avg_cvr for each match type within ad group
keyword_agg['expected_conversions'] = keyword_agg['clicks'] * keyword_agg['avg_cvr']

# Aggregate expected conversions per ad group
expected_per_adgroup = keyword_agg.groupby('ad_group_id').agg(
    total_clicks=('clicks', 'sum'),
    total_expected_conversions=('expected_conversions', 'sum')
).reset_index()
expected_per_adgroup['expected_cvr'] = expected_per_adgroup['total_expected_conversions'] / expected_per_adgroup['total_clicks']

# Merge with ad_group_agg
ad_group_agg = ad_group_agg.merge(expected_per_adgroup[['ad_group_id', 'expected_cvr']], on='ad_group_id', how='left')
# For ad groups with no keyword data (should be few), fill expected_cvr with overall average CVR
overall_avg_cvr = ad_group_agg['cvr'].mean()
ad_group_agg['expected_cvr'] = ad_group_agg['expected_cvr'].fillna(overall_avg_cvr)

# Compute Intent Match Ratio
ad_group_agg['intent_match_ratio'] = ad_group_agg['cvr'] / ad_group_agg['expected_cvr']

# Add problematic flag
ad_group_agg['problematic'] = (ad_group_agg['ctr'] > ctr_75) & (ad_group_agg['cvr'] < cvr_25)

# Analyze characteristics of problematic vs non-problematic
print("\n=== Characteristics summary ===")
print("Problematic ad groups stats (mean):")
print(ad_group_agg[ad_group_agg['problematic'] == True][['ctr', 'cvr', 'expected_cvr', 'intent_match_ratio']].mean())
print("\nNon-problematic ad groups stats (mean):")
print(ad_group_agg[ad_group_agg['problematic'] == False][['ctr', 'cvr', 'expected_cvr', 'intent_match_ratio']].mean())

# Traffic quality: compute match type distribution for problematic ad groups
# Get match type distribution per ad group (percentage of clicks per match type)
keyword_agg['clicks_per_match'] = keyword_agg.groupby('ad_group_id')['clicks'].transform('sum')
keyword_agg['match_type_share'] = keyword_agg['clicks'] / keyword_agg['clicks_per_match']
# Pivot to get shares per match type
match_type_pivot = keyword_agg.pivot_table(index='ad_group_id', columns='keyword_match_type', values='match_type_share', aggfunc='sum', fill_value=0)
# Merge with problematic flag
match_type_pivot = match_type_pivot.merge(ad_group_agg[['ad_group_id', 'problematic']], left_index=True, right_on='ad_group_id', how='left')

print("\nMatch type share comparison (mean share of clicks):")
print("Problematic:")
print(match_type_pivot[match_type_pivot['problematic'] == True][['EXACT', 'PHRASE', 'BROAD', 'BROAD_MATCH_MODIFIER']].mean())
print("Non-problematic:")
print(match_type_pivot[match_type_pivot['problematic'] == False][['EXACT', 'PHRASE', 'BROAD', 'BROAD_MATCH_MODIFIER']].mean())

# Also compute search term match type distribution from search_term_report
query_search = """
SELECT ad_group_id, search_term_match_type,
       SUM(clicks) as clicks
FROM google_ads__search_term_report
GROUP BY ad_group_id, search_term_match_type
"""
search_agg = pd.read_sql_query(query_search, conn)
if not search_agg.empty:
    search_agg['total_clicks'] = search_agg.groupby('ad_group_id')['clicks'].transform('sum')
    search_agg['match_share'] = search_agg['clicks'] / search_agg['total_clicks']
    search_pivot = search_agg.pivot_table(index='ad_group_id', columns='search_term_match_type', values='match_share', aggfunc='sum', fill_value=0)
    # Merge with problematic flag
    search_pivot = search_pivot.merge(ad_group_agg[['ad_group_id', 'problematic']], left_index=True, right_on='ad_group_id', how='left')
    print("\nSearch term match type share (mean):")
    print("Problematic:")
    print(search_pivot[search_pivot['problematic'] == True].select_dtypes(include=[np.number]).mean())
    print("Non-problematic:")
    print(search_pivot[search_pivot['problematic'] == False].select_dtypes(include=[np.number]).mean())
else:
    print("No search term data.")

# Save detailed ad group metrics with intent match ratio
ad_group_agg.to_csv('ad_group_metrics_with_ratio.csv', index=False)
print("\nDetailed metrics saved to ad_group_metrics_with_ratio.csv")

conn.close()
```
