def plot_behavioral_features(merged_df):
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    # RFM Segment
    rfm_counts = merged_df['rfm_segment'].value_counts().head(10)
    axes[0,0].bar(rfm_counts.index, rfm_counts.values, color='lightcoral')
    axes[0,0].set_xlabel('RFM Segment')
    axes[0,0].set_ylabel('Count')
    axes[0,0].set_title('High-Volatility Customers by RFM Segment')
    axes[0,0].tick_params(axis='x', rotation=45)
    # Payment Behavior
    pay_counts = merged_df['payment_behavior'].value_counts()
    axes[0,1].bar(pay_counts.index, pay_counts.values, color='lightgreen')
    axes[0,1].set_xlabel('Payment Behavior')
    axes[0,1].set_ylabel('Count')
    axes[0,1].set_title('High-Volatility Customers by Payment Behavior')
    axes[0,1].tick_params(axis='x', rotation=45)
    # Lifecycle Stage
    life_counts = merged_df['lifecycle_stage'].value_counts()
    axes[1,0].bar(life_counts.index, life_counts.values, color='lightblue')
    axes[1,0].set_xlabel('Lifecycle Stage')
    axes[1,0].set_ylabel('Count')
    axes[1,0].set_title('High-Volatility Customers by Lifecycle Stage')
    axes[1,0].tick_params(axis='x', rotation=45)
    # Risk Assessment
    risk_counts = merged_df['risk_assessment'].value_counts()
    axes[1,1].bar(risk_counts.index, risk_counts.values, color='orange')
    axes[1,1].set_xlabel('Risk Assessment')
    axes[1,1].set_ylabel('Count')
    axes[1,1].set_title('High-Volatility Customers by Risk Assessment')
    axes[1,1].tick_params(axis='x', rotation=45)
    plt.tight_layout()
    plt.savefig('behavioral_features.png', dpi=300, bbox_inches='tight')
    plt.close()

def plot_business_health_vs_volatility(merged_df, fd):
    # For each high-volatility customer, we need their contribution to business_health_score? Not directly.
    # Maybe use the latest business_health_score and compare with collection_rate_percentage over time.
    # Instead, we can plot the distribution of business_health_score across months and highlight months where high-volatility customers contributed more? Hard.
    # Simpler: show correlation between volatility metrics and revenue_trend_correlation.
    if 'revenue_trend_correlation' in merged_df.columns:
        plt.figure(figsize=(10,6))
        plt.scatter(merged_df['coeff_of_variation'], merged_df['revenue_trend_correlation'], alpha=0.7, edgecolors='k')
        plt.xlabel('Coefficient of Variation (Profit Stability)')
        plt.ylabel('Revenue Trend Correlation')
        plt.title('Volatility vs. Revenue Trend Correlation')
        plt.grid(True, alpha=0.3)
        plt.savefig('volatility_vs_revenue_trend.png', dpi=300, bbox_inches='tight')
        plt.close()
    # Also plot collection rate percentage over time from financial_dashboard
    if not fd.empty:
        fd = fd.sort_values('dashboard_month')
        plt.figure(figsize=(10,6))
        plt.plot(fd['dashboard_month'], fd['collection_rate_percentage'], marker='o', linestyle='-', color='green')
        plt.xlabel('Month')
        plt.ylabel('Collection Rate Percentage')
        plt.title('Collection Rate Over Time')
        plt.grid(True, alpha=0.3)
        plt.savefig('collection_rate_trend.png', dpi=300, bbox_inches='tight')
        plt.close()

def plot_accounts_receivable(bs):
    if bs.empty:
        return
    # Aggregate by account_class
    class_totals = bs.groupby('account_class')['amount'].sum().reset_index()
    plt.figure(figsize=(8,8))
    plt.pie(class_totals['amount'], labels=class_totals['account_class'], autopct='%1.1f%%', startangle=90)
    plt.title('Accounts Receivable Structure by Account Class')
    plt.savefig('receivable_structure.png', dpi=300, bbox_inches='tight')
    plt.close()

def main():
    pa, ca, fd, bs = load_data()
    metrics, high_vol_customers, threshold = compute_volatility_metrics(pa)
    merged_df = merge_with_customer_analytics(metrics, ca)
    print(f'Metrics shape: {metrics.shape}')
    print(f'Merged shape: {merged_df.shape}')
    
    plot_distribution(pa, threshold)
    plot_cv_vs_variance(metrics)
    plot_behavioral_features(merged_df)
    plot_business_health_vs_volatility(merged_df, fd)
    plot_accounts_receivable(bs)
    
    # Save metrics for reference
    metrics.to_csv('high_vol_customers_metrics.csv', index=False)
    merged_df.to_csv('high_vol_customers_merged.csv', index=False)
    print('Plots created.')

if __name__ == '__main__':
    main()
''')
