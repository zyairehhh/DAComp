import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
matplotlib.use('Agg')  # non-interactive backend

# Connect to database - file is in current directory
conn = sqlite3.connect('dacomp-035.sqlite')

# Query 1: Abnormal login counts per department
query1 = """
SELECT 
    u.Department,
    COUNT(a."Anomaly ID") AS abnormal_count,
    AVG(a."Anomaly Score") AS avg_score,
    SUM(CASE WHEN a."Risk Level" IN ('Severe', 'High') THEN 1 ELSE 0 END) AS high_risk_count
FROM abnormal_logins_table a
JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
JOIN user_account_table ac ON l."User ID" = ac."User ID"
JOIN user_information_table u ON ac."User ID" = u."User ID"
GROUP BY u.Department
ORDER BY abnormal_count DESC;
"""
df_dept = pd.read_sql_query(query1, conn)

# Plot 1: Bar chart of abnormal login count per department
plt.figure(figsize=(8,5))
plt.bar(df_dept['Department'], df_dept['abnormal_count'], color='skyblue')
plt.title('Abnormal Login Count by Department')
plt.xlabel('Department')
plt.ylabel('Number of Abnormal Logins')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('/workspace/abnormal_count_by_dept.png', dpi=300)
plt.close()

# Plot 2: Stacked bar for risk levels (Severe/High vs Medium/Low)
query2 = """
SELECT 
    u.Department,
    a."Risk Level",
    COUNT(*) AS count
FROM abnormal_logins_table a
JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
JOIN user_account_table ac ON l."User ID" = ac."User ID"
JOIN user_information_table u ON ac."User ID" = u."User ID"
GROUP BY u.Department, a."Risk Level"
"""
df_risk = pd.read_sql_query(query2, conn)
# Pivot
pivot = df_risk.pivot(index='Department', columns='Risk Level', values='count').fillna(0)
# Order departments as per df_dept order
pivot = pivot.reindex(df_dept['Department'])
# Plot stacked bar
plt.figure(figsize=(8,5))
pivot.plot(kind='bar', stacked=True, colormap='RdYlGn_r')  # reversed colormap maybe
plt.title('Abnormal Login Risk Level Distribution by Department')
plt.xlabel('Department')
plt.ylabel('Number of Abnormal Logins')
plt.xticks(rotation=45, ha='right')
plt.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('/workspace/risk_distribution_by_dept.png', dpi=300)
plt.close()

# Plot 3: Monthly trend per department (using Detection Time)
query3 = """
SELECT 
    u.Department,
    strftime('%Y-%m', a."Detection Time") AS month,
    COUNT(*) AS count
FROM abnormal_logins_table a
JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
JOIN user_account_table ac ON l."User ID" = ac."User ID"
JOIN user_information_table u ON ac."User ID" = u."User ID"
WHERE a."Detection Time" IS NOT NULL
GROUP BY u.Department, month
ORDER BY month, u.Department;
"""
df_monthly = pd.read_sql_query(query3, conn)
# Pivot for line plot
pivot_monthly = df_monthly.pivot(index='month', columns='Department', values='count').fillna(0)
plt.figure(figsize=(10,6))
for dept in pivot_monthly.columns:
    plt.plot(pivot_monthly.index, pivot_monthly[dept], marker='o', label=dept)
plt.title('Monthly Abnormal Login Trend by Department')
plt.xlabel('Month (YYYY-MM)')
plt.ylabel('Number of Abnormal Logins')
plt.xticks(rotation=45, ha='right')
plt.legend(title='Department')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('/workspace/monthly_trend_by_dept.png', dpi=300)
plt.close()

conn.close()
print("Plots generated: abnormal_count_by_dept.png, risk_distribution_by_dept.png, monthly_trend_by_dept.png")
