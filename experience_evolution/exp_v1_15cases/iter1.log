print("\nPolynomial regression (quality_score) coefficients (highest degree first):", coeff_qual)
# Compute R^2
p_qual = np.poly1d(coeff_qual)
y_pred_qual = p_qual(x_qual)
ss_res = np.sum((y_conv - y_pred_qual)**2)
ss_tot = np.sum((y_conv - np.mean(y_conv))**2)
r2_qual = 1 - (ss_res / ss_tot) if ss_tot != 0 else 0
print("R-squared:", r2_qual)

# Crash rate vs conversion
x_crash = daily_metrics['crash_rate_per_1k'].values
coeff_crash = np.polyfit(x_crash, y_conv, 2)
print("\nPolynomial regression (crash_rate_per_1k) coefficients (highest degree first):", coeff_crash)
p_crash = np.poly1d(coeff_crash)
y_pred_crash = p_crash(x_crash)
ss_res_crash = np.sum((y_conv - y_pred_crash)**2)
ss_tot_crash = np.sum((y_conv - np.mean(y_conv))**2)
r2_crash = 1 - (ss_res_crash / ss_tot_crash) if ss_tot_crash != 0 else 0
print("R-squared:", r2_crash)

# 4. Multi-dimensional user value decay model for revenue_per_active_device
# Compute daily aggregated features
daily_updates = country_df.groupby(['date_day', 'package_name'])['update_events'].sum().reset_index()
daily_updates_total = daily_updates.groupby('date_day')['update_events'].sum().reset_index()
daily_updates_total.rename(columns={'update_events': 'total_update_events'}, inplace=True)

daily_ts = ts_df.groupby('date_day').agg({
    'revenue_per_active_device': 'mean',
    'active_devices': 'mean',
    'quality_score': 'mean',
    'crash_rate_per_1k': 'mean',
}).reset_index()
daily_rating = country_df.groupby('date_day')['rolling_total_average_rating'].mean().reset_index()
daily_rating.rename(columns={'rolling_total_average_rating': 'avg_rolling_rating'}, inplace=True)
daily_model = pd.merge(daily_ts, daily_rating, on='date_day', how='left')
daily_model = pd.merge(daily_model, daily_conversion, on='date_day', how='left')
daily_model = pd.merge(daily_model, daily_updates_total, on='date_day', how='left')
print("\nDaily model dataset shape:", daily_model.shape)
print(daily_model.head())

# Build linear regression using numpy linear algebra (OLS)
# Prepare matrix
daily_model_clean = daily_model.dropna()
X = daily_model_clean[['store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k',
                       'active_devices', 'avg_rolling_rating', 'total_update_events']].copy()
X['update_rating_interaction'] = X['total_update_events'] * X['avg_rolling_rating']
X = np.column_stack([np.ones(len(X)), X])  # add constant
y = daily_model_clean['revenue_per_active_device'].values
# Solve (X^T X)^{-1} X^T y
try:
    coeffs = np.linalg.lstsq(X, y, rcond=None)[0]
    print("\nRegression coefficients for revenue_per_active_device:")
    feature_names = ['const', 'store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k',
                     'active_devices', 'avg_rolling_rating', 'total_update_events', 'update_rating_interaction']
    for name, coef in zip(feature_names, coeffs):
        print(f"{name}: {coef:.6f}")
    # Compute R^2
    y_pred = X @ coeffs
    ss_res = np.sum((y - y_pred)**2)
    ss_tot = np.sum((y - np.mean(y))**2)
    r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else 0
    print(f"R-squared: {r2:.4f}")
except Exception as e:
    print("Regression error:", e)

# 5. Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
daily_active = country_df.groupby('date_day')['active_devices_last_30_days'].mean().reset_index()
daily_update = daily_updates_total.copy()
daily_merge = pd.merge(daily_active, daily_update, on='date_day', how='inner')
daily_merge = pd.merge(daily_merge, daily_rating, on='date_day', how='inner')
# Regression for active_devices_last_30_days
X_act = daily_merge[['total_update_events', 'avg_rolling_rating']].copy()
X_act['interaction'] = X_act['total_update_events'] * X_act['avg_rolling_rating']
X_act = np.column_stack([np.ones(len(X_act)), X_act])
y_act = daily_merge['active_devices_last_30_days'].values
coeffs_act = np.linalg.lstsq(X_act, y_act, rcond=None)[0]
print("\nRegression coefficients for active_devices_last_30_days:")
act_names = ['const', 'total_update_events', 'avg_rolling_rating', 'interaction']
for name, coef in zip(act_names, coeffs_act):
    print(f"{name}: {coef:.6f}")
y_pred_act = X_act @ coeffs_act
ss_res_act = np.sum((y_act - y_pred_act)**2)
ss_tot_act = np.sum((y_act - np.mean(y_act))**2)
r2_act = 1 - (ss_res_act / ss_tot_act) if ss_tot_act != 0 else 0
print(f"R-squared: {r2_act:.4f}")

# Interaction effect on rolling_total_average_rating (maybe update frequency affects rating)
# Regression with rating as dependent variable and update events as independent, but rating may affect updates (reverse causality). We'll just compute correlation.
corr = daily_merge[['total_update_events', 'avg_rolling_rating']].corr().iloc[0,1]
print(f"\nCorrelation between total_update_events and avg_rolling_rating: {corr:.4f}")

print("\nAnalysis completed.")
```
