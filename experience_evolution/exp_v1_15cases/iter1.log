import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-069.sqlite')

# High-level numbers
comp_df = pd.read_sql_query("SELECT * FROM google_play__comprehensive_performance_dashboard WHERE package_name = 'com.dev.photoeditor' ORDER BY date_day", conn)
score_start = comp_df['overall_performance_score'].iloc[0]
score_end = comp_df['overall_performance_score'].iloc[-1]
total_budget = comp_df['research_budget_usd'].sum()
print(f"Overall Performance Score: {score_start} → {score_end} (Change: {score_end - score_start} points)")
print(f"Total Research Budget (12 months): ${total_budget:,.2f}")
print()

# Regional split summary
geo_df = pd.read_sql_query("SELECT * FROM google_play__geo_market_analysis WHERE package_name = 'com.dev.photoeditor'", conn)
high_count = (geo_df['avg_transaction_value'] > 30).sum()
low_count = len(geo_df) - high_count
print(f"High revenue markets (>$30 avg transaction): {high_count} countries")
print(f"Low revenue markets (≤$30): {low_count} countries")
print()

# Revenue contributions
finance_df = pd.read_sql_query("SELECT country_long, region, date_day, net_amount, transactions FROM google_play__finance_report WHERE package_name = 'com.dev.photoeditor'", conn)
finance_df['date_day'] = pd.to_datetime(finance_df['date_day'])
finance_df['month'] = finance_df['date_day'].dt.to_period('M')
# Merge groups
geo_df['revenue_group'] = np.where(geo_df['avg_transaction_value'] > 30, 'high', 'low')
country_to_group = geo_df.set_index('country_name')['revenue_group'].to_dict()
finance_df['revenue_group'] = finance_df['country_long'].map(country_to_group)
finance_df = finance_df.dropna(subset=['revenue_group'])
total_rev = finance_df['net_amount'].sum()
high_rev = finance_df[finance_df['revenue_group'] == 'high']['net_amount'].sum()
low_rev = finance_df[finance_df['revenue_group'] == 'low']['net_amount'].sum()
print(f"Total revenue over 12 months: ${total_rev:,.2f}")
print(f"  High revenue markets: ${high_rev:,.2f} ({high_rev/total_rev*100:.1f}%)")
print(f"  Low revenue markets: ${low_rev:,.2f} ({low_rev/total_rev*100:.1f}%)")
print()

# Monthly trends
monthly_group = finance_df.groupby(['month', 'revenue_group'])['net_amount'].sum().unstack().fillna(0)
high_growth = (monthly_group['high'].iloc[-1] - monthly_group['high'].iloc[0]) / monthly_group['high'].iloc[0] * 100
low_growth = (monthly_group['low'].iloc[-1] - monthly_group['low'].iloc[0]) / monthly_group['low'].iloc[0] * 100
print(f"Cumulative growth Jan-Dec 2024:")
print(f"  High revenue markets: {high_growth:.1f}%")
print(f"  Low revenue markets: {low_growth:.1f}%")
print()

# Performance metrics differences
metrics = geo_df.groupby('revenue_group')[['overall_market_score', 'app_quality_score', 'daily_churn_rate', 'day_30_retention_rate', 'weekly_growth_rate']].mean()
print("Average performance metrics:")
print(metrics)

conn.close()
''')
