        plt.legend()

# 6. Light/Radiation - Illuminance (fixing column name issue)
if 'light_data' in locals() and len(light_data) > 0:
    plt.subplot(2, 3, 6)
    # The column name has a special character, so we need to handle it carefully
    # First check what column names exist
    illuminance_col = None
    for col in light_data.columns:
        if 'Illuminance' in col:
            illuminance_col = col
            break
    
    if illuminance_col:
        lux_data = light_data[illuminance_col].dropna()
        if len(lux_data) > 0:
            plt.hist(lux_data, bins=20, edgecolor='black', alpha=0.7, color='orange')
            plt.xlabel('Illuminance (Lux)')
            plt.ylabel('Frequency')
            plt.title('Light Levels in\nHigh-Traffic Exhibition Halls')
            
            # Add museum standard thresholds
            plt.axvline(x=50, color='red', linestyle='--', alpha=0.7, 
                       label='Light-sensitive: <50 lux')
            plt.axvline(x=200, color='orange', linestyle='--', alpha=0.7,
                       label='Moderately sensitive: <200 lux')
            plt.legend()
    else:
        print("Warning: Could not find illuminance column in light_data")

plt.tight_layout()
