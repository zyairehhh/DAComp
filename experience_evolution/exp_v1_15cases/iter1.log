import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
# get monthly minutes per account
df_monthly = pd.read_sql_query("""
    SELECT 
        account_id,
        strftime('%Y-%m', date_day) as month,
        SUM(pendo__visitor_daily_metrics.sum_minutes) as monthly_minutes,
        SUM(pendo__visitor_daily_metrics.sum_events) as monthly_events,
        SUM(pendo__visitor_daily_metrics.count_pages_viewed) as monthly_pages,
        SUM(pendo__visitor_daily_metrics.count_features_clicked) as monthly_features
    FROM pendo__visitor_daily_metrics 
    JOIN pendo__visitor USING (visitor_id)
    GROUP BY account_id, month
    ORDER BY account_id, month
""", conn)

# compute months from start
df_monthly['month'] = pd.to_datetime(df_monthly['month'])
df_monthly = df_monthly.sort_values(['account_id', 'month'])
df_monthly['month_seq'] = df_monthly.groupby('account_id').cumcount() + 1

# pivot to wide: each row account, columns month1_minutes, month2_minutes...
df_pivot = df_monthly.pivot(index='account_id', columns='month_seq', values='monthly_minutes')
df_pivot = df_pivot.add_prefix('month_')

# filter accounts with at least 6 months of data
df_pivot = df_pivot.dropna(subset=['month_1','month_2','month_3','month_4','month_5','month_6'])
print("Accounts with at least 6 months:", df_pivot.shape[0])

# define target: high-value if average minutes in months 4-6 > 75th percentile of those months
future_avg = df_pivot[['month_4','month_5','month_6']].mean(axis=1)
threshold = future_avg.quantile(0.75)
df_pivot['high_value'] = (future_avg > threshold).astype(int)
print("High-value count:", df_pivot['high_value'].sum())
print("Threshold:", threshold)

# compute features from first 3 months
features = pd.DataFrame(index=df_pivot.index)
features['avg_minutes_months_1_3'] = df_pivot[['month_1','month_2','month_3']].mean(axis=1)
features['growth_rate_1_3'] = (df_pivot['month_3'] - df_pivot['month_1']) / (df_pivot['month_1'] + 1)
features['std_months_1_3'] = df_pivot[['month_1','month_2','month_3']].std(axis=1)
features['max_month_1_3'] = df_pivot[['month_1','month_2','month_3']].max(axis=1)
features['min_month_1_3'] = df_pivot[['month_1','month_2','month_3']].min(axis=1)

# add account-level static features from pendo__account
df_account = pd.read_sql_query("""
    SELECT account_id, count_active_days, count_active_months, avg_nps_rating,
           count_active_visitors, count_page_viewing_visitors,
           count_feature_clicking_visitors, average_daily_minutes, average_daily_events,
           sum_minutes, sum_events
    FROM pendo__account
""", conn)
df_account.set_index('account_id', inplace=True)
# join
features = features.join(df_account, how='inner')

# add target
features['high_value'] = df_pivot['high_value']

# compute correlation of each feature with target
corr_target = features.corr()['high_value'].drop('high_value').sort_values(key=abs, ascending=False)
print("\nTop feature correlations with high_value (absolute):")
print(corr_target.head(20))

# also compute statistical significance?
# We'll output some insights
print("\nHigh-value proportion:", features['high_value'].mean())
print("Features shape:", features.shape)

# Examine feature means by high-value vs non-high-value
high = features[features['high_value']==1]
low = features[features['high_value']==0]
print("\nMean avg_minutes_months_1_3:")
print("High-value:", high['avg_minutes_months_1_3'].mean())
print("Low-value:", low['avg_minutes_months_1_3'].mean())
print("\nMean average_daily_minutes:")
print("High:", high['average_daily_minutes'].mean())
print("Low:", low['average_daily_minutes'].mean())
print("\nMean avg_nps_rating:")
print("High:", high['avg_nps_rating'].mean())
print("Low:", low['avg_nps_rating'].mean())

conn.close()
''')
