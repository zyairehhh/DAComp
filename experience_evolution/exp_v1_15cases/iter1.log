Action: CreateFile(filepath='analyze_segments.py'):
```
import pandas as pd
import numpy as np

# Load contact data with scores
df = pd.read_csv('user_value_scores.csv')
print("Columns:", df.columns.tolist())

# For each segment, compute average metrics
segments = df.groupby('segment').agg(
    count=('contact_id', 'count'),
    avg_total_surveys=('total_count_surveys', 'mean'),
    avg_completed_surveys=('total_count_completed_surveys', 'mean'),
    avg_completion_rate=('completion_rate', 'mean'),
    avg_email_sent=('count_surveys_sent_email', 'mean'),
    avg_sms_sent=('count_surveys_sent_sms', 'mean'),
    avg_email_opened=('count_surveys_opened_email', 'mean'),
    avg_sms_opened=('count_surveys_opened_sms', 'mean'),
    avg_progress=('avg_survey_progress_pct', 'mean'),
    avg_duration=('avg_survey_duration_in_seconds', 'mean'),
    avg_composite_score=('composite_score', 'mean')
).reset_index()
print("\nSegment averages:")
print(segments)

# Compare medium vs high
medium = df[df['segment'] == 'medium_value']
high = df[df['segment'] == 'high_value']

# Compute differences
metrics = [
    'total_count_surveys',
    'total_count_completed_surveys',
    'completion_rate',
    'count_surveys_sent_email',
    'count_surveys_sent_sms',
    'count_surveys_opened_email',
    'count_surveys_opened_sms',
    'avg_survey_progress_pct',
    'avg_survey_duration_in_seconds',
    'channel_distinct',
    'opened_distinct'
]
diff = {}
for m in metrics:
    diff[m] = high[m].mean() - medium[m].mean()
diff_df = pd.DataFrame(list(diff.items()), columns=['metric', 'mean_diff_high_minus_medium'])
print("\nMean difference (high - medium):")
print(diff_df)

# Statistical significance using t-test (simple)
from scipy import stats
ttest_results = {}
for m in metrics:
    t, p = stats.ttest_ind(high[m].dropna(), medium[m].dropna())
    ttest_results[m] = p
ttest_df = pd.DataFrame(list(ttest_results.items()), columns=['metric', 'p_value'])
print("\nT-test p-values:")
print(ttest_df)

# Identify key drivers: metrics where difference is large and p-value < 0.05
significant = ttest_df[ttest_df['p_value'] < 0.05]
print("\nSignificant metrics (p < 0.05):")
print(significant.merge(diff_df, on='metric'))
```
