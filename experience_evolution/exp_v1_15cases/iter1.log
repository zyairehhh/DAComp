    plt.legend()

# 2. Temperature distribution
if 'env_data' in locals() and len(env_data) > 0:
    plt.subplot(2, 3, 2)
    temp_data = env_data['Temperature (°C)'].dropna()
    if len(temp_data) > 0:
        plt.hist(temp_data, bins=20, edgecolor='black', alpha=0.7, color='red')
        plt.xlabel('Temperature (°C)')
        plt.ylabel('Frequency')
        plt.title('Temperature Distribution in\nHigh-Traffic Exhibition Halls')
        
        # Add museum standard range (18-22°C)
