import sqlite3
import pandas as pd

# Connect to the database
conn = sqlite3.connect('dacomp-041.sqlite')

# First, let's check what the actual column names look like in gallery_information
cursor = conn.cursor()
cursor.execute('PRAGMA table_info(gallery_information)')
columns = cursor.fetchall()
print("Gallery Information columns:")
for col in columns:
    print(f"  {col[1]} (Type: {col[2]})")

# Check a sample of data
cursor.execute('SELECT "Exhibition Hall Record ID", "Daily Visitor Count" FROM gallery_information LIMIT 5')
sample = cursor.fetchall()
print("\\nSample gallery data:")
for row in sample:
    print(f"  {row}")

# Get high-traffic halls
query = '''SELECT "Exhibition Hall Record ID" as hall_id, 
           AVG("Daily Visitor Count") as avg_visitor_count 
           FROM gallery_information 
           GROUP BY "Exhibition Hall Record ID" 
           HAVING avg_visitor_count > 900'''

high_traffic = pd.read_sql_query(query, conn)
print(f"\\nHigh-traffic halls (>900 avg visitors): {len(high_traffic)}")
print("First 5 high-traffic halls:")
print(high_traffic.head())

# Check display cases for one high-traffic hall
test_hall = high_traffic.iloc[0]['hall_id']
print(f"\\nChecking display cases for hall: {test_hall}")

display_query = f'SELECT * FROM display_case_information WHERE "Gallery reference" = ?'
cursor.execute(display_query, (test_hall,))
display_cases = cursor.fetchall()
print(f"Found {len(display_cases)} display cases for {test_hall}")

if display_cases:
    print("First display case columns:")
    cursor.execute('PRAGMA table_info(display_case_information)')
    display_cols = [col[1] for col in cursor.fetchall()]
    print(f"  Columns: {display_cols}")
    print(f"  First case: {display_cases[0]}")

# Check if we can find any environmental data for these display cases
if display_cases:
    display_case_id = display_cases[0][0]  # First column is Display case ID
    env_query = f'SELECT * FROM environmental_monitoring_data WHERE "Display Case Reference" = ?'
    cursor.execute(env_query, (display_case_id,))
    env_readings = cursor.fetchall()
    print(f"\\nFound {len(env_readings)} environmental readings for display case {display_case_id}")

cursor.close()
conn.close()
''')
