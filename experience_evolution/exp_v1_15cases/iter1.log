```
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
# get monthly minutes per account
df_monthly = pd.read_sql_query("""
    SELECT 
        account_id,
        strftime('%Y-%m', date_day) as month,
        SUM(pendo__visitor_daily_metrics.sum_minutes) as monthly_minutes
    FROM pendo__visitor_daily_metrics 
    JOIN pendo__visitor USING (visitor_id)
    GROUP BY account_id, month
    ORDER BY account_id, month
""", conn)
if len(df_monthly) == 0:
    print("No monthly data")
    conn.close()
    exit()
df_monthly['month'] = pd.to_datetime(df_monthly['month'])
df_monthly['month_seq'] = df_monthly.groupby('account_id').cumcount() + 1
# compute linear trend slope per account with at least 3 months
def compute_slope(group):
    if len(group) >= 3:
        x = group['month_seq'].values.astype(float)
        y = group['monthly_minutes'].values.astype(float)
        slope = np.polyfit(x, y, 1)[0] if len(x) > 1 else 0
        return slope
    else:
        return np.nan
slopes = df_monthly.groupby('account_id').apply(compute_slope)
slopes.name = 'trend_slope'
# get account features
df_account = pd.read_sql_query("""
    SELECT account_id, 
           sum_minutes, sum_events,
           count_active_days, count_active_months,
           avg_nps_rating,
           count_active_visitors,
           count_page_viewing_visitors,
           count_feature_clicking_visitors,
           average_daily_minutes, average_daily_events
    FROM pendo__account
""", conn)
df_account.set_index('account_id', inplace=True)
# merge
df = df_account.join(slopes, how='left')
df['trend_slope'].fillna(0, inplace=True)
# define positive trend (slope > 0)
df['positive_trend'] = (df['trend_slope'] > 0).astype(int)
print("Accounts with positive trend:", df['positive_trend'].sum(), "/", len(df))
# correlation of features with positive_trend
features = ['sum_minutes', 'sum_events', 'count_active_days', 'count_active_months',
            'avg_nps_rating', 'count_active_visitors', 'count_page_viewing_visitors',
            'count_feature_clicking_visitors', 'average_daily_minutes', 'average_daily_events']
corr_trend = df[features].corrwith(df['positive_trend']).sort_values(key=abs, ascending=False)
print("\nCorrelation with positive trend:")
print(corr_trend)
# examine means
print("\nPositive trend accounts average features:")
print(df[df['positive_trend']==1][features].mean())
print("\nNon-positive trend accounts average features:")
print(df[df['positive_trend']==0][features].mean())
# simple classification using average_daily_minutes median
median_feat = df['average_daily_minutes'].median()
pred = (df['average_daily_minutes'] > median_feat).astype(int)
acc = (pred == df['positive_trend']).sum() / len(df)
print("\nAccuracy of using average_daily_minutes > median to predict positive trend:", acc)
conn.close()
```
