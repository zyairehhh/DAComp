'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter1/dacomp-067/stage1_env/dacomp-067.sqlite')

# Load data
df_source = pd.read_sql_query("SELECT * FROM greenhouse__talent_pipeline_simplified", conn)
df_div = pd.read_sql_query("SELECT * FROM greenhouse__diversity_metrics ORDER BY application_year DESC, application_quarter DESC LIMIT 1", conn)
df_app = pd.read_sql_query("SELECT * FROM greenhouse__application_enhanced", conn)
df_interview = pd.read_sql_query("SELECT * FROM greenhouse__interview_enhanced", conn)
df_scorecard = pd.read_sql_query("SELECT * FROM greenhouse__interview_scorecard_detail", conn)

# Diversity per source
df_app_source = df_app[df_app['sourced_from'].notna()]
# compute gender distribution per source
gender_counts = df_app_source.groupby(['sourced_from', 'candidate_gender']).size().unstack(fill_value=0)
gender_pct = gender_counts.div(gender_counts.sum(axis=1), axis=0)
print("Gender distribution per source:")
print(gender_pct.round(3))

# compute race distribution per source
race_counts = df_app_source.groupby(['sourced_from', 'candidate_race']).size().unstack(fill_value=0)
race_pct = race_counts.div(race_counts.sum(axis=1), axis=0)
print("\nRace distribution per source:")
print(race_pct.round(3))

# compute hires per source
hires_per_source = df_app_source[df_app_source['status']=='hired'].groupby('sourced_from').size()
print("\nHires per source:")
print(hires_per_source)

# compute female hire representation per source
female_hires = df_app_source[(df_app_source['status']=='hired') & (df_app_source['candidate_gender']=='Female')].groupby('sourced_from').size()
female_representation = female_hires / hires_per_source
print("\nFemale hire representation per source:")
print(female_representation.round(3))

# compute non-white hire representation per source (assuming race not 'White')
non_white_hires = df_app_source[(df_app_source['status']=='hired') & (df_app_source['candidate_race']!='White')].groupby('sourced_from').size()
non_white_representation = non_white_hires / hires_per_source
print("\nNon-white hire representation per source:")
print(non_white_representation.round(3))

# Cost model
cost_per_hire = {
    'Headhunter': 20000,
    'University Recruiting': 10000,
    'Indeed': 5000,
    'Employee Referral': 3000,
    'AngelList': 5000,
    'Company Website': 2000,
    'Glassdoor': 5000,
    'LinkedIn': 4000
}
df_source['cost_per_hire'] = df_source['source_name'].map(cost_per_hire)
df_source['total_cost'] = df_source['total_hires'] * df_source['cost_per_hire']
total_cost = df_source['total_cost'].sum()
print(f"\\nTotal recruitment cost: ${total_cost:,.0f}")
target_cost = total_cost * 0.85
print(f"Target cost after 15% reduction: ${target_cost:,.0f}")
savings_needed = total_cost - target_cost
print(f"Savings needed: ${savings_needed:,.0f}")

# Compute cost per hire overall
total_hires = df_source['total_hires'].sum()
avg_cost_per_hire = total_cost / total_hires
print(f"Average cost per hire: ${avg_cost_per_hire:.2f}")

# Identify which sources are most cost-effective (hire rate / cost)
df_source['cost_per_applicant'] = df_source['total_cost'] / df_source['total_applications']
df_source['hire_rate'] = df_source['total_hires'] / df_source['total_applications'] * 100
df_source['cost_effectiveness'] = df_source['hire_rate'] / df_source['cost_per_applicant']
print("\\nSource cost-effectiveness:")
