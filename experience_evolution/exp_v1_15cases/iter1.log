import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-041.sqlite')

# Step 1: Get high-traffic halls (average Daily Visitor Count > 900)
query_halls = """
SELECT "Exhibition Hall Record ID" as hall_id, 
       AVG("Daily Visitor Count") as avg_visitor_count 
FROM gallery_information 
GROUP BY "Exhibition Hall Record ID" 
HAVING avg_visitor_count > 900
"""

high_traffic_halls = pd.read_sql_query(query_halls, conn)

# Step 2: Get display cases in these halls
display_cases_query = f"""
SELECT di."Display case ID", di."Gallery reference" as hall_id
FROM display_case_information di
WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
"""

display_cases = pd.read_sql_query(display_cases_query, conn)

print(f"High-traffic halls: {len(high_traffic_halls)}")
print(f"Display cases in high-traffic halls: {len(display_cases)}")

# Step 3: Get environmental data for these display cases
if len(display_cases) > 0:
    env_query = f"""
    SELECT emd.*, di."Gallery reference" as hall_id
    FROM environmental_monitoring_data emd
    JOIN display_case_information di ON emd."Display Case Reference" = di."Display case ID"
    WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
    LIMIT 1000
    """
    
    env_data = pd.read_sql_query(env_query, conn)
    print(f"Environmental data samples: {len(env_data)}")
    
    # Step 4: Get air quality data
    air_quality_query = f"""
    SELECT aqr.*, di."Gallery reference" as hall_id
    FROM air_quality_readings aqr
    JOIN environmental_monitoring_data emd ON aqr."Environmental monitoring reference" = emd."Environmental Reading ID"
    JOIN display_case_information di ON emd."Display Case Reference" = di."Display case ID"
    WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
    LIMIT 1000
    """
    
    air_quality_data = pd.read_sql_query(air_quality_query, conn)
    print(f"Air quality data samples: {len(air_quality_data)}")
    
    # Step 5: Get light and radiation data
    light_query = f"""
    SELECT lrr.*, di."Gallery reference" as hall_id
    FROM light_and_radiation_readings lrr
    JOIN environmental_monitoring_data emd ON lrr."Environmental monitoring reference" = emd."Environmental Reading ID"
    JOIN display_case_information di ON emd."Display Case Reference" = di."Display case ID"
    WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
    LIMIT 1000
    """
    
    light_data = pd.read_sql_query(light_query, conn)
    print(f"Light and radiation data samples: {len(light_data)}")

conn.close()

# Create visualizations
plt.figure(figsize=(15, 10))

# 1. Visitor count distribution for high-traffic halls
plt.subplot(2, 3, 1)
plt.hist(high_traffic_halls['avg_visitor_count'], bins=20, edgecolor='black', alpha=0.7)
plt.xlabel('Average Daily Visitor Count')
plt.ylabel('Number of Exhibition Halls')
plt.title('Distribution of Visitor Counts in High-Traffic Halls (>900 visitors/day)')

# 2. Temperature distribution
if 'env_data' in locals() and len(env_data) > 0:
    plt.subplot(2, 3, 2)
    plt.hist(env_data['Temperature (°C)'].dropna(), bins=20, edgecolor='black', alpha=0.7, color='red')
    plt.xlabel('Temperature (°C)')
    plt.ylabel('Frequency')
    plt.title('Temperature Distribution in High-Traffic Halls')
    
    # 3. Humidity distribution
    plt.subplot(2, 3, 3)
    plt.hist(env_data['Relative Humidity (%)'].dropna(), bins=20, edgecolor='black', alpha=0.7, color='blue')
    plt.xlabel('Relative Humidity (%)')
    plt.ylabel('Frequency')
    plt.title('Humidity Distribution in High-Traffic Halls')
    
    # 4. Temperature vs Humidity scatter (if enough data)
    if len(env_data) > 10:
        plt.subplot(2, 3, 4)
        plt.scatter(env_data['Temperature (°C)'], env_data['Relative Humidity (%)'], alpha=0.5)
        plt.xlabel('Temperature (°C)')
        plt.ylabel('Relative Humidity (%)')
        plt.title('Temperature vs Humidity in High-Traffic Halls')

# 5. Air quality metrics - CO2 levels
if 'air_quality_data' in locals() and len(air_quality_data) > 0:
    plt.subplot(2, 3, 5)
    # Calculate statistics for CO2
    co2_data = air_quality_data['Carbon dioxide concentration (ppm)'].dropna()
    if len(co2_data) > 0:
        plt.hist(co2_data, bins=20, edgecolor='black', alpha=0.7, color='green')
        plt.xlabel('CO2 Concentration (ppm)')
        plt.ylabel('Frequency')
        plt.title('CO2 Concentration in High-Traffic Halls')

# 6. Light/Radiation - Illuminance
if 'light_data' in locals() and len(light_data) > 0:
    plt.subplot(2, 3, 6)
    lux_data = light_data['Illuminance (Lux)'].dropna()
    if len(lux_data) > 0:
        plt.hist(lux_data, bins=20, edgecolor='black', alpha=0.7, color='orange')
        plt.xlabel('Illuminance (Lux)')
        plt.ylabel('Frequency')
        plt.title('Light Levels in High-Traffic Halls')

plt.tight_layout()
plt.savefig('environmental_analysis_high_traffic.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created environmental_analysis_high_traffic.png")

# Additional analysis: Check if we can link to artifact condition
try:
    # Try to get condition assessment linked to display cases in high-traffic halls
    condition_query = f"""
    SELECT ca.*, di."Gallery reference" as hall_id
    FROM condition_assessment ca
    JOIN display_case_information di ON ca."Inspected Display Case Reference" = di."Display case ID"
    WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
    """
    
    condition_data = pd.read_sql_query(condition_query, conn)
    
    if len(condition_data) > 0:
        # Create visualization for condition assessment
        plt.figure(figsize=(10, 6))
        plt.hist(condition_data['Condition Assessment Rating'].dropna(), bins=10, edgecolor='black', alpha=0.7)
        plt.xlabel('Condition Assessment Rating (higher is better)')
        plt.ylabel('Count')
        plt.title('Artifact Condition Distribution in High-Traffic Exhibition Halls')
        plt.savefig('artifact_condition_high_traffic.png', dpi=300, bbox_inches='tight')
        plt.close()
        print("Created artifact_condition_high_traffic.png")
        
except Exception as e:
    print(f"Could not fetch condition data: {e}")

try:
    # Get artifact ratings for artifacts in high-traffic halls
    # This requires linking through display cases and condition assessment
    rating_query = f"""
    SELECT ar.*, di."Gallery reference" as hall_id
    FROM artifact_rating ar
    JOIN condition_assessment ca ON ar."Cultural Relic Reference Number" = ca."Inspected Cultural Relic Reference"
    JOIN display_case_information di ON ca."Inspected Display Case Reference" = di."Display case ID"
    WHERE di."Gallery reference" IN ({','.join(['"'+str(x)+'"' for x in high_traffic_halls['hall_id'].tolist()])})
    LIMIT 1000
    """
    
    rating_data = pd.read_sql_query(rating_query, conn)
    
    if len(rating_data) > 0:
        # Create visualization for cultural value scores
        plt.figure(figsize=(12, 8))
        
        rating_columns = ['Historical Significance Rating', 'Research Value Rating', 
                         'Exhibition Value Rating', 'Cultural Value Score',
                         'Public Accessibility Rating', 'Educational Value Rating']
        
        fig, axes = plt.subplots(2, 3, figsize=(15, 10))
        axes = axes.flatten()
        
        for i, col in enumerate(rating_columns[:6]):
            if col in rating_data.columns:
                axes[i].hist(rating_data[col].dropna(), bins=10, edgecolor='black', alpha=0.7)
                axes[i].set_xlabel(col)
                axes[i].set_ylabel('Count')
                axes[i].set_title(f'{col} Distribution')
        
        plt.suptitle('Artifact Rating Metrics in High-Traffic Exhibition Halls', fontsize=16)
        plt.tight_layout()
        plt.savefig('artifact_ratings_high_traffic.png', dpi=300, bbox_inches='tight')
        plt.close()
        print("Created artifact_ratings_high_traffic.png")
        
except Exception as e:
    print(f"Could not fetch rating data: {e}")

# Analyze risks: Check for environmental parameters outside recommended ranges
env_risks = []
if 'env_data' in locals() and len(env_data) > 0:
    # Museum standards: Temperature 18-22°C, Humidity 40-60%
    temp_outside = ((env_data['Temperature (°C)'] < 18) | (env_data['Temperature (°C)'] > 22)).sum()
    humidity_outside = ((env_data['Relative Humidity (%)'] < 40) | (env_data['Relative Humidity (%)'] > 60)).sum()
    
    env_risks.append(f"Temperature readings outside 18-22°C range: {temp_outside}/{len(env_data)} ({temp_outside/len(env_data)*100:.1f}%)")
    env_risks.append(f"Humidity readings outside 40-60% range: {humidity_outside}/{len(env_data)} ({humidity_outside/len(env_data)*100:.1f}%)")

if 'air_quality_data' in locals() and len(air_quality_data) > 0:
    # Museum standards: CO2 < 1000 ppm, TVOCs < 500 ppb
    co2_high = (air_quality_data['Carbon dioxide concentration (ppm)'] > 1000).sum()
    tvocs_high = (air_quality_data['Total volatile organic compounds concentration (ppb)'] > 500).sum()
    
    env_risks.append(f"CO2 concentrations > 1000 ppm: {co2_high}/{len(air_quality_data)} ({co2_high/len(air_quality_data)*100:.1f}%)")
    env_risks.append(f"TVOC concentrations > 500 ppb: {tvocs_high}/{len(air_quality_data)} ({tvocs_high/len(air_quality_data)*100:.1f}%)")

if 'light_data' in locals() and len(light_data) > 0:
    # Museum standards: Light sensitive materials < 50 lux, moderately sensitive < 200 lux
    light_high = (light_data['Illuminance (Lux)'] > 200).sum()
    
    env_risks.append(f"Illuminance > 200 lux (above moderate sensitivity threshold): {light_high}/{len(light_data)} ({light_high/len(light_data)*100:.1f}%)")

# Save risk analysis to file
with open('risk_analysis_summary.txt', 'w') as f:
    f.write("ENVIRONMENTAL RISK ANALYSIS FOR HIGH-TRAFFIC EXHIBITION HALLS\n")
    f.write("="*60 + "\n\n")
    for risk in env_risks:
        f.write(f"- {risk}\n")

print("\nRisk analysis summary saved to risk_analysis_summary.txt")

print("Visualization script completed.")
