print(f"Number of high-traffic halls: {len(high_traffic_halls)}")

# Get display cases for just a few to test
test_halls = high_traffic_halls['hall_id'].head(5).tolist()
print(f"Testing with halls: {test_halls}")

for hall in test_halls:
    query = f'SELECT COUNT(*) FROM display_case_information WHERE "Gallery reference" = "{hall}"'
    count = pd.read_sql_query(query, conn)
    print(f"Hall {hall}: {count.iloc[0,0]} display cases")

# Now check what's in display_case_information more broadly
query_sample = 'SELECT "Gallery reference", COUNT(*) as case_count FROM display_case_information GROUP BY "Gallery reference" LIMIT 10'
sample = pd.read_sql_query(query_sample, conn)
print("\nSample gallery-case counts:")
print(sample)

conn.close()
'''
