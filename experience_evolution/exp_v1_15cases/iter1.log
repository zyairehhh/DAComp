import pandas as pd

df = pd.read_csv('user_value_scores.csv')

# Define cross-channel users (both email and SMS sent)
df['cross_channel_both'] = (df['count_surveys_sent_email'] > 0) & (df['count_surveys_sent_sms'] > 0)

# Define opened both channels
df['opened_both'] = (df['count_surveys_opened_email'] > 0) & (df['count_surveys_opened_sms'] > 0)

segments = df.groupby('segment')
for name, seg in segments:
    total = len(seg)
    cross_both_pct = seg['cross_channel_both'].mean() * 100
    opened_both_pct = seg['opened_both'].mean() * 100
    print(f"{name}: total {total}, cross-channel (both) {cross_both_pct:.1f}%, opened both {opened_both_pct:.1f}%")

# Language-specific cross-channel rates
print("\nCross-channel (both) by language:")
lang_cross = df.groupby('language')['cross_channel_both'].mean().sort_values(ascending=False)
for lang, rate in lang_cross.items():
    print(f"{lang}: {rate*100:.1f}%")
''')
