import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
# get account-level static features
df_account = pd.read_sql_query("""
    SELECT account_id, 
           sum_minutes, sum_events,
           count_active_days, count_active_months,
           avg_nps_rating,
           count_active_visitors,
           count_page_viewing_visitors,
           count_feature_clicking_visitors,
           average_daily_minutes, average_daily_events
    FROM pendo__account
""", conn)
df_account.set_index('account_id', inplace=True)

# get feature diversity per account
df_feature = pd.read_sql_query("""
    SELECT account_id, COUNT(DISTINCT feature_id) as distinct_features,
           SUM(pendo__visitor_feature.sum_clicks) as total_clicks,
           SUM(pendo__visitor_feature.sum_minutes) as total_feature_minutes
    FROM pendo__visitor_feature
    JOIN pendo__visitor USING (visitor_id)
    GROUP BY account_id
""", conn)
df_feature.set_index('account_id', inplace=True)

# get monthly trend: compute slope of minutes over time (if at least 3 months)
df_monthly = pd.read_sql_query("""
    SELECT 
        account_id,
        strftime('%Y-%m', date_day) as month,
        SUM(pendo__visitor_daily_metrics.sum_minutes) as monthly_minutes
    FROM pendo__visitor_daily_metrics 
    JOIN pendo__visitor USING (visitor_id)
    GROUP BY account_id, month
    ORDER BY account_id, month
""", conn)
if len(df_monthly) > 0:
    df_monthly['month'] = pd.to_datetime(df_monthly['month'])
    df_monthly['month_seq'] = df_monthly.groupby('account_id').cumcount() + 1
    # compute linear trend slope per account
    def compute_slope(group):
        if len(group) >= 3:
            x = group['month_seq'].values.astype(float)
            y = group['monthly_minutes'].values.astype(float)
            slope = np.polyfit(x, y, 1)[0] if len(x) > 1 else 0
            return slope
        else:
            return np.nan
    slopes = df_monthly.groupby('account_id').apply(compute_slope)
    slopes.name = 'trend_slope'
else:
    slopes = pd.Series(dtype=float)

# combine
df = df_account.join(df_feature, how='left').join(slopes, how='left')
df.fillna(0, inplace=True)

# define high-value as top 25% of sum_minutes
threshold = df['sum_minutes'].quantile(0.75)
df['high_value'] = (df['sum_minutes'] > threshold).astype(int)
print("Total accounts:", len(df))
print("High-value accounts (top 25% sum_minutes):", df['high_value'].sum())

# compute correlation with high_value
corr = df.corr()['high_value'].drop('high_value').sort_values(key=abs, ascending=False)
print("\nTop feature correlations with high_value:")
print(corr.head(20))

# examine means
print("\nHigh-value accounts average features:")
print(df[df['high_value']==1].mean())
print("\nNon-high-value accounts average features:")
print(df[df['high_value']==0].mean())

# extra: compute composite score using PCA? Not needed.

# compute feature importance using logistic regression? Not allowed.
# but we can propose weighting based on correlation magnitudes.
# Normalize features (z-score) then compute weighted sum.
# Let's compute weights as normalized correlation coefficients.
features_for_score = df.drop(columns=['high_value', 'sum_minutes', 'sum_events'])  # exclude target and highly correlated
features_normalized = (features_for_score - features_for_score.mean()) / features_for_score.std()
corr_series = df[features_for_score.columns].corrwith(df['high_value'])
weights = corr_series / corr_series.abs().sum()
print("\nProposed weights for multi-dimensional scoring (based on correlation):")
print(weights.sort_values(ascending=False))

# compute score for each account
score = (features_normalized * weights).sum(axis=1)
# check how well score separates high-value
df['score'] = score
print("\nScore correlation with high_value:", df['score'].corr(df['high_value']))
# compute AUC? Not needed.

