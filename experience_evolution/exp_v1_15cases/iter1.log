import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-098.sqlite')
df = pd.read_sql_query("""
    SELECT conversation_id, conversation_initiated_type, 
           time_to_first_close_minutes/1440.0 as time_to_first_close_days
    FROM intercom__conversation_metrics
    WHERE time_to_first_close_minutes IS NOT NULL
""", conn)
conn.close()

# Segmentation
bot_times = df[df['conversation_initiated_type'] == 'bot_first']['time_to_first_close_days']
human_times = df[df['conversation_initiated_type'] == 'human_first']['time_to_first_close_days']

avg_bot = bot_times.mean()
avg_human = human_times.mean()

print(f"Bot-first average days to first close: {avg_bot:.2f}")
print(f"Human-first average days to first close: {avg_human:.2f}")

fig, ax = plt.subplots(figsize=(8,6))
categories = ['Bot-First', 'Human-First']
values = [avg_bot, avg_human]
colors = ['skyblue', 'lightcoral']
bars = ax.bar(categories, values, color=colors)
ax.set_ylabel('Average Days to First Close')
ax.set_title('Average Time to First Close by First Response Type')
ax.bar_label(bars, fmt='%.2f days')
plt.tight_layout()
plt.savefig('time_to_first_close.png', dpi=300)
plt.close()

print("Duration plot saved.")
```)
