'''
import pandas as pd
import numpy as np

# Load scored users
df = pd.read_csv('user_value_scores.csv')
print("Columns:", df.columns.tolist())

# Behavioral metrics we want to compare
metrics = ['total_count_surveys', 'total_count_completed_surveys', 'completion_rate',
           'count_surveys_sent_email', 'count_surveys_sent_sms',
           'count_surveys_opened_email', 'count_surveys_opened_sms',
           'count_surveys_started_email', 'count_surveys_started_sms',
           'count_surveys_completed_email', 'count_surveys_completed_sms',
           'avg_survey_progress_pct', 'avg_survey_duration_in_seconds',
           'channel_distinct', 'opened_distinct']

segments = df['segment'].unique()
for seg in sorted(segments):
    sub = df[df['segment'] == seg]
    print(f"\n--- Segment: {seg} (n={len(sub)}) ---")
    for metric in metrics:
        if metric in df.columns:
            mean_val = sub[metric].mean()
            median_val = sub[metric].median()
            print(f"{metric}: mean={mean_val:.2f}, median={median_val:.2f}")
        else:
            print(f"{metric} not in columns")

# Compare medium vs high
medium = df[df['segment'] == 'medium_value']
high = df[df['segment'] == 'high_value']
print("\n=== Difference (high - medium) for key metrics ===")
for metric in ['total_count_surveys', 'total_count_completed_surveys', 'completion_rate',
               'count_surveys_sent_email', 'count_surveys_sent_sms',
               'count_surveys_opened_email', 'count_surveys_opened_sms',
               'avg_survey_progress_pct']:
    if metric in df.columns:
        mean_diff = high[metric].mean() - medium[metric].mean()
        pct_diff = mean_diff / medium[metric].mean() * 100 if medium[metric].mean() != 0 else np.nan
        print(f"{metric}: mean diff = {mean_diff:.2f} ({pct_diff:.1f}%)")
    else:
        print(f"{metric} not in columns")

# Statistical significance? Not required but maybe compute t-test
from scipy.stats import ttest_ind
print("\n--- T-tests for medium vs high ---")
for metric in ['total_count_surveys', 'total_count_completed_surveys', 'completion_rate']:
    if metric in df.columns:
        t, p = ttest_ind(medium[metric].dropna(), high[metric].dropna(), equal_var=False)
        print(f"{metric}: t={t:.3f}, p={p:.5f}")
''')
