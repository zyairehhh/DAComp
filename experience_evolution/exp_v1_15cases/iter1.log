'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
# get monthly minutes per account, ordered by month
df_monthly = pd.read_sql_query("""
    SELECT 
        account_id,
        strftime('%Y-%m', date_day) as month,
        SUM(pendo__visitor_daily_metrics.sum_minutes) as monthly_minutes
    FROM pendo__visitor_daily_metrics 
    JOIN pendo__visitor USING (visitor_id)
    GROUP BY account_id, month
    ORDER BY account_id, month
""", conn)
# convert to datetime
df_monthly['month'] = pd.to_datetime(df_monthly['month'])
# determine month sequence per account
df_monthly['month_seq'] = df_monthly.groupby('account_id').cumcount() + 1
# total months per account
month_counts = df_monthly.groupby('account_id').size()
# keep accounts with at least 4 months total (so we have split)
valid_accounts = month_counts[month_counts >= 4].index
df = df_monthly[df_monthly['account_id'].isin(valid_accounts)]
# pivot
pivot = df.pivot(index='account_id', columns='month_seq', values='monthly_minutes')
pivot = pivot.add_prefix('month_')
# define first half as first 2 months? For simplicity, use first 2 months as training, next 2 as future (since many have only 4 months)
# We'll compute average minutes in first 2 months and average in next 2 months
pivot['avg_first2'] = pivot[['month_1','month_2']].mean(axis=1)
pivot['avg_next2'] = pivot[['month_3','month_4']].mean(axis=1)
# compute growth rate
pivot['growth_rate'] = (pivot['avg_next2'] - pivot['avg_first2']) / (pivot['avg_first2'] + 1e-9)
# target: high growth if growth_rate > median? Let's define high-growth as top 25%
threshold = pivot['growth_rate'].quantile(0.75)
pivot['high_growth'] = (pivot['growth_rate'] > threshold).astype(int)
print("Accounts with at least 4 months:", pivot.shape[0])
print("High-growth count:", pivot['high_growth'].sum())

# merge with account static features
df_account = pd.read_sql_query("""
    SELECT account_id, 
           sum_minutes, sum_events,
           count_active_days, count_active_months,
           avg_nps_rating,
           count_active_visitors,
           count_page_viewing_visitors,
           count_feature_clicking_visitors,
           average_daily_minutes, average_daily_events
    FROM pendo__account
""", conn)
df_account.set_index('account_id', inplace=True)
features = pivot[['avg_first2']].join(df_account, how='inner')
features['high_growth'] = pivot['high_growth']

# compute correlation with high_growth
corr = features.corr()['high_growth'].drop('high_growth').sort_values(key=abs, ascending=False)
print("\nTop feature correlations with high_growth:")
print(corr.head(20))

# examine distribution
print("\nHigh-growth accounts average features:")
print(features[features['high_growth']==1].mean())
print("\nNon-high-growth accounts average features:")
print(features[features['high_growth']==0].mean())

# also compute feature diversity: number of distinct features used per account
df_feature = pd.read_sql_query("""
    SELECT account_id, COUNT(DISTINCT feature_id) as distinct_features,
           SUM(sum_clicks) as total_clicks,
           SUM(sum_minutes) as total_feature_minutes
    FROM pendo__visitor_feature
    JOIN pendo__visitor USING (visitor_id)
    GROUP BY account_id
""", conn)
df_feature.set_index('account_id', inplace=True)
features2 = features.join(df_feature, how='left')
features2.fillna(0, inplace=True)
corr2 = features2.corr()['high_growth'].drop('high_growth').sort_values(key=abs, ascending=False)
print("\nIncluding feature diversity:")
print(corr2.head(15))

conn.close()
''')
