import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
matplotlib.use('Agg')  # non-interactive backend
import os

conn = sqlite3.connect('/workspace/dacomp-069.sqlite')

# Plot 1: Overall performance score over time
query1 = """
SELECT date_day, overall_performance_score, research_budget_usd 
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor' 
ORDER BY date_day
"""
df1 = pd.read_sql_query(query1, conn)
df1['date_day'] = pd.to_datetime(df1['date_day'])
fig, ax1 = plt.subplots(figsize=(10,6))
ax1.plot(df1['date_day'], df1['overall_performance_score'], marker='o', color='tab:blue', label='Performance Score')
ax1.set_xlabel('Month')
ax1.set_ylabel('Overall Performance Score', color='tab:blue')
ax1.tick_params(axis='y', labelcolor='tab:blue')
ax1.set_title('Performance Score Decline Over 12 Months (com.dev.photoeditor)')
ax1.grid(True)
ax1.legend(loc='upper left')
# Add budget as secondary axis
ax2 = ax1.twinx()
ax2.plot(df1['date_day'], df1['research_budget_usd'], marker='s', color='tab:red', linestyle='--', label='Research Budget USD')
ax2.set_ylabel('Research Budget (USD)', color='tab:red')
ax2.tick_params(axis='y', labelcolor='tab:red')
ax2.legend(loc='upper right')
plt.tight_layout()
plt.savefig('/workspace/performance_score_trend.png', dpi=300)
plt.close()

# Plot 2: Regional comparison: high vs low revenue per user
query2 = """
SELECT 
    country_name,
    region,
    avg_daily_installs,
    avg_active_devices,
    weekly_growth_rate,
    avg_transaction_value,
    average_revenue_per_user,
    day_30_retention_rate,
    daily_churn_rate,
    overall_market_score,
    investment_recommendation
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor'
ORDER BY average_revenue_per_user DESC
"""
df2 = pd.read_sql_query(query2, conn)
# Determine thresholds: high revenue per user > 20, low < 10
df2['revenue_tier'] = pd.cut(df2['average_revenue_per_user'], 
                              bins=[0, 10, 20, float('inf')], 
                              labels=['Low (<$10)', 'Medium ($10-$20)', 'High (>$20)'])
# Calculate averages for each tier
tier_avg = df2.groupby('revenue_tier').agg({
    'avg_daily_installs': 'mean',
    'weekly_growth_rate': 'mean',
    'day_30_retention_rate': 'mean',
    'daily_churn_rate': 'mean',
    'overall_market_score': 'mean'
}).reset_index()

# Bar chart: avg_daily_installs and weekly_growth_rate by tier
fig, axes = plt.subplots(2, 2, figsize=(12, 10))
# Subplot 1: Avg Daily Installs
tier_avg.plot.bar(x='revenue_tier', y='avg_daily_installs', ax=axes[0,0], color='skyblue', legend=False)
axes[0,0].set_title('Avg Daily Installs by Revenue Tier')
axes[0,0].set_ylabel('Avg Daily Installs')
axes[0,0].tick_params(axis='x', rotation=45)
# Subplot 2: Weekly Growth Rate
tier_avg.plot.bar(x='revenue_tier', y='weekly_growth_rate', ax=axes[0,1], color='orange', legend=False)
axes[0,1].set_title('Avg Weekly Growth Rate by Revenue Tier')
axes[0,1].set_ylabel('Weekly Growth Rate (%)')
axes[0,1].tick_params(axis='x', rotation=45)
# Subplot 3: Day‑30 Retention
tier_avg.plot.bar(x='revenue_tier', y='day_30_retention_rate', ax=axes[1,0], color='green', legend=False)
axes[1,0].set_title('Avg Day‑30 Retention by Revenue Tier')
axes[1,0].set_ylabel('Day‑30 Retention Rate')
axes[1,0].tick_params(axis='x', rotation=45)
# Subplot 4: Overall Market Score
tier_avg.plot.bar(x='revenue_tier', y='overall_market_score', ax=axes[1,1], color='purple', legend=False)
axes[1,1].set_title('Avg Overall Market Score by Revenue Tier')
axes[1,1].set_ylabel('Market Score')
axes[1,1].tick_params(axis='x', rotation=45)
plt.suptitle('Regional Performance by Average Revenue per User Tier', fontsize=14)
plt.tight_layout(rect=[0, 0, 1, 0.96])
plt.savefig('/workspace/regional_performance_by_revenue_tier.png', dpi=300)
plt.close()

# Plot 3: Scatter of market score vs growth rate colored by region
fig, ax = plt.subplots(figsize=(10,6))
regions = df2['region'].unique()
colors = plt.cm.Set3(range(len(regions)))
for i, region in enumerate(regions):
    subset = df2[df2['region'] == region]
    ax.scatter(subset['weekly_growth_rate'], subset['overall_market_score'], 
               label=region, color=colors[i], s=100, alpha=0.7)
ax.set_xlabel('Weekly Growth Rate (%)')
ax.set_ylabel('Overall Market Score')
ax.set_title('Market Score vs Weekly Growth Rate by Region')
ax.legend(title='Region')
ax.grid(True)
plt.tight_layout()
plt.savefig('/workspace/market_score_vs_growth_scatter.png', dpi=300)
plt.close()

# Plot 4: Top 10 countries by avg_active_devices, with performance metrics
df2_top = df2.sort_values('avg_active_devices', ascending=False).head(10)
fig, ax = plt.subplots(figsize=(12,7))
x = range(len(df2_top))
width = 0.35
bars1 = ax.bar(x, df2_top['avg_active_devices']/1000, width, label='Active Devices (k)', color='blue')
ax.set_xlabel('Country')
ax.set_ylabel('Active Devices (thousands)')
ax.set_xticks(x)
ax.set_xticklabels(df2_top['country_name'], rotation=45, ha='right')
ax2 = ax.twinx()
bars2 = ax2.plot(x, df2_top['weekly_growth_rate'], color='red', marker='o', label='Weekly Growth Rate (%)')
ax2.set_ylabel('Weekly Growth Rate (%)', color='red')
ax2.tick_params(axis='y', labelcolor='red')
ax.set_title('Top 10 Countries by Active Devices with Growth Rate')
# Combine legends
lines_labels = [bars1] + bars2
labels = [l.get_label() for l in lines_labels]
ax.legend(lines_labels, labels, loc='upper left')
plt.tight_layout()
plt.savefig('/workspace/top_countries_active_devices.png', dpi=300)
plt.close()

conn.close()
print("Plots generated.")
```

