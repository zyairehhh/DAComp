import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("Set2")

# Load database
db_path = "dacomp-058.sqlite"
conn = sqlite3.connect(db_path)

# Load health scores (from CSV generated in Stage1)
health_df = pd.read_csv("../stage1_env/campaign_health_scores.csv")
print(f"Loaded health scores shape: {health_df.shape}")
print(health_df.head())

# 1. Distribution of health scores with risk levels
plt.figure(figsize=(10, 6))
sns.histplot(data=health_df, x='health_score', hue='risk_level', multiple='stack', kde=True)
plt.title('Distribution of Campaign Health Scores by Risk Level')
plt.xlabel('Health Score')
plt.ylabel('Count')
plt.tight_layout()
plt.savefig('health_score_distribution.png')
plt.close()

# 2. Health score vs ROI scatter (size by total_cost)
plt.figure(figsize=(10, 6))
scatter = plt.scatter(health_df['avg_roi'], health_df['health_score'],
                      c=pd.Categorical(health_df['risk_level']).codes,
                      cmap='RdYlGn_r', s=health_df['total_cost']/1000, alpha=0.7)
plt.colorbar(scatter, label='Risk Level (0=Low,1=Medium,2=High,3=Critical)')
plt.xlabel('Average ROI')
plt.ylabel('Health Score')
plt.title('Health Score vs ROI (size = total cost)')
plt.tight_layout()
plt.savefig('health_vs_roi.png')
plt.close()

# 3. Average health score per campaign_type (bar)
plt.figure(figsize=(12, 6))
health_by_type = health_df.groupby('campaign_type')['health_score'].mean().sort_values()
health_by_type.plot(kind='bar', color='steelblue')
plt.title('Average Health Score by Campaign Type')
plt.xlabel('Campaign Type')
plt.ylabel('Average Health Score')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('health_by_campaign_type.png')
plt.close()

# 4. Risk level distribution across industries
plt.figure(figsize=(14, 8))
risk_industry = pd.crosstab(health_df['industry'], health_df['risk_level'], normalize='index')
risk_industry.plot(kind='bar', stacked=True)
plt.title('Risk Level Distribution Across Industries')
plt.xlabel('Industry')
plt.ylabel('Proportion')
plt.legend(title='Risk Level')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('risk_by_industry.png')
plt.close()

# 5. Time series: average ROI over months for high-risk vs low-risk campaigns
# Need to join with monthly data
query = """
SELECT year_month, campaign_id, conversion_value, cost, conversions
FROM google_ads__campaign_report
"""
monthly_df = pd.read_sql_query(query, conn)
monthly_df['year_month'] = pd.to_datetime(monthly_df['year_month'], format='%Y-%m')
# Compute ROI per row
monthly_df['roi'] = (monthly_df['conversion_value'] - monthly_df['cost']) / monthly_df['cost']
# Merge risk level
monthly_risk = monthly_df.merge(health_df[['campaign_id', 'risk_level']], on='campaign_id', how='left')
# Group by month and risk level
monthly_agg = monthly_risk.groupby(['year_month', 'risk_level']).agg(
    avg_roi=('roi', 'mean'),
    total_cost=('cost', 'sum')
).reset_index()

plt.figure(figsize=(12, 6))
for risk in monthly_agg['risk_level'].unique():
    sub = monthly_agg[monthly_agg['risk_level']==risk]
    plt.plot(sub['year_month'], sub['avg_roi'], marker='o', label=risk)
plt.title('Monthly Average ROI by Risk Level')
plt.xlabel('Month')
plt.ylabel('Average ROI')
plt.legend(title='Risk Level')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('monthly_roi_by_risk.png')
plt.close()

# 6. Correlation heatmap of health score components
components = health_df[['cost_efficiency_score', 'conversion_quality_score', 'competitiveness_score',
                        'avg_roi', 'avg_ctr', 'avg_conversion_rate', 'avg_quality_score', 'avg_impression_share']]
corr = components.corr()
plt.figure(figsize=(10, 8))
sns.heatmap(corr, annot=True, cmap='coolwarm', center=0)
plt.title('Correlation Heatmap of Health Score Components')
plt.tight_layout()
plt.savefig('correlation_heatmap.png')
plt.close()

conn.close()
print("Plots generated.")
```
