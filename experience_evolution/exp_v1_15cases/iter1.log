But we need past 12 months from max date. Let's write a Python script to do analysis.

Action: CreateFile(filepath="analyze.py"):
```
import sqlite3
import pandas as pd
import numpy as np
import datetime

conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Identify high-volatility customers (top 25% by avg customer_margin_volatility)
query_cust_vol = """
SELECT customer_id, AVG(customer_margin_volatility) as avg_vol
FROM quickbooks__profitability_analysis
GROUP BY customer_id
"""
df_cust_vol = pd.read_sql_query(query_cust_vol, conn)
threshold = df_cust_vol['avg_vol'].quantile(0.75)
high_vol = df_cust_vol[df_cust_vol['avg_vol'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers: {len(high_vol)} (threshold={threshold:.6f})")

# 2. Get latest date in data
max_date = pd.read_sql_query("SELECT MAX(transaction_date) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'].iloc[0]
max_date = pd.to_datetime(max_date)
start_date = max_date - pd.DateOffset(months=12)
print(f"Period: {start_date.date()} to {max_date.date()}")

# 3. Fetch invoice-level data for these customers within period
query_invoices = f"""
SELECT customer_id, transaction_date, gross_profit, invoice_total, revenue_month_start
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({','.join(['?']*len(high_vol))})
AND DATE(transaction_date) >= DATE(?)
"""
df = pd.read_sql_query(query_invoices, conn, params=high_vol + [start_date.strftime('%Y-%m-%d')])
df['transaction_date'] = pd.to_datetime(df['transaction_date'])
df['month'] = df['transaction_date'].dt.to_period('M')

# 4. Compute monthly gross profit per customer
monthly = df.groupby(['customer_id', 'month']).agg(
    monthly_gross_profit=('gross_profit', 'sum'),
    monthly_invoice_total=('invoice_total', 'sum')
).reset_index()

# Ensure at least 2 months for CV calculation
cv_data = []
for cust in high_vol:
    cust_data = monthly[monthly['customer_id'] == cust]
    if len(cust_data) >= 2:
        std = cust_data['monthly_gross_profit'].std()
        mean = cust_data['monthly_gross_profit'].mean()
        cv = std / mean if mean != 0 else np.nan
        cv_data.append({
            'customer_id': cust,
            'cv_gross_profit': cv,
            'months_count': len(cust_data)
        })

cv_df = pd.DataFrame(cv_data)
print(f"Computed CV for {len(cv_df)} customers.")
print(cv_df.head())

# 5. Variance of quarter-over-quarter invoice_total growth rate
# Define quarters
df['quarter'] = df['transaction_date'].dt.to_period('Q')
quarterly = df.groupby(['customer_id', 'quarter']).agg(quarter_invoice_total=('invoice_total', 'sum')).reset_index()
quarterly = quarterly.sort_values(['customer_id', 'quarter'])
quarterly['prev_quarter'] = quarterly.groupby('customer_id')['quarter_invoice_total'].shift(1)
quarterly['growth_rate'] = (quarterly['quarter_invoice_total'] - quarterly['prev_quarter']) / quarterly['prev_quarter']
# Compute variance of growth rate per customer
growth_var = quarterly.groupby('customer_id')['growth_rate'].var().reset_index(name='variance_growth_rate')
print(growth_var.head())

# 6. Merge with customer_analytics to get behavioral features
query_cust = f"""
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
       lifecycle_stage, customer_maturity_stage, activity_status,
       credit_score, credit_grade, risk_assessment
FROM quickbooks__customer_analytics
WHERE customer_id IN ({','.join(['?']*len(high_vol))})
"""
df_cust = pd.read_sql_query(query_cust, conn, params=high_vol)

# 7. Merge with financial_dashboard to get business_health_score and collection_rate_percentage contributions
# We need to aggregate across dashboard months? Let's get the latest dashboard month.
dashboard = pd.read_sql_query("SELECT dashboard_month, business_health_score, collection_rate_percentage FROM quickbooks__financial_dashboard ORDER BY dashboard_month DESC LIMIT 1", conn)
print(f"Latest dashboard month: {dashboard['dashboard_month'].iloc[0]}")
print(f"Business Health Score: {dashboard['business_health_score'].iloc[0]}")
print(f"Collection Rate: {dashboard['collection_rate_percentage'].iloc[0]}")

# The contribution of high-volatility customers to overall business_health_score?
# Need to compute something like sum of their gross profit impact? Not directly given.
# Maybe we need to compute proportion of outstanding receivables etc.
# Let's compute from profitability_analysis: sum of collected_amount, invoice_total, etc.
high_vol_total = df.groupby('customer_id').agg(
    total_gross_profit=('gross_profit', 'sum'),
    total_invoice=('invoice_total', 'sum'),
    total_collected=('collected_amount', 'sum')
).reset_index()
# Need collected_amount column exists? Let's check.
query_check = "SELECT * FROM quickbooks__profitability_analysis LIMIT 1"
print(pd.read_sql_query(query_check, conn).columns.tolist())

conn.close()
```
