import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation_enhanced table with tags
df = pd.read_sql_query("SELECT conversation_id, conversation_initiated_type, all_conversation_tags FROM intercom__conversation_enhanced", conn)
conn.close()

# Parse tags
def extract_tag(tags, prefix):
    if not isinstance(tags, str):
        return None
    for tag in tags.split('|'):
        if tag.startswith(prefix):
            return tag.split(':')[1] if ':' in tag else None
    return None

df['stage'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage:'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent:'))
df['region'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'region:'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'segment:'))

# Define conversion flags based on stage tags
df['demo_booked'] = df['stage'].apply(lambda x: 1 if x == 'demo_booked' else 0)
df['trial_activated'] = df['stage'].apply(lambda x: 1 if x == 'trial_activated' else 0)
df['closed_won'] = df['stage'].apply(lambda x: 1 if x == 'closed_won' else 0)

# Segmentation
bot_df = df[df['conversation_initiated_type'] == 'bot_first']
human_df = df[df['conversation_initiated_type'] == 'human_first']

print(f"Total conversations: {len(df)}")
print(f"Bot-first: {len(bot_df)}")
print(f"Human-first: {len(human_df)}")

# Overall funnel rates
def compute_rates(group_df):
    total = len(group_df)
    demo_rate = group_df['demo_booked'].sum() / total * 100 if total > 0 else 0
    trial_rate = group_df['trial_activated'].sum() / total * 100 if total > 0 else 0
    closed_rate = group_df['closed_won'].sum() / total * 100 if total > 0 else 0
    return total, demo_rate, trial_rate, closed_rate

bot_total, bot_demo, bot_trial, bot_closed = compute_rates(bot_df)
human_total, human_demo, human_trial, human_closed = compute_rates(human_df)

print("\nOverall Funnel Rates:")
print(f"Bot-first: Demo {bot_demo:.2f}%, Trial {bot_trial:.2f}%, Closed {bot_closed:.2f}%")
print(f"Human-first: Demo {human_demo:.2f}%, Trial {human_trial:.2f}%, Closed {human_closed:.2f}%")

# Plot 1: Funnel conversion comparison
fig, ax = plt.subplots(figsize=(8, 6))
x = np.arange(3)
width = 0.35
bot_rates = [bot_demo, bot_trial, bot_closed]
human_rates = [human_demo, human_trial, human_closed]
bars1 = ax.bar(x - width/2, bot_rates, width, label='Bot-First', color='skyblue')
bars2 = ax.bar(x + width/2, human_rates, width, label='Human-First', color='lightcoral')
ax.set_xlabel('Funnel Stage')
ax.set_ylabel('Conversion Rate (%)')
ax.set_title('Funnel Conversion Rates by First Response Type')
ax.set_xticks(x)
ax.set_xticklabels(['Demo Booked', 'Trial Activated', 'Closed Won'])
ax.legend()
ax.bar_label(bars1, fmt='%.2f%%')
ax.bar_label(bars2, fmt='%.2f%%')
plt.tight_layout()
plt.savefig('funnel_conversion_rates.png', dpi=300)
plt.close()

# Plot 2: Intent-level comparison for billing and pricing
intents_of_interest = ['billing', 'pricing']
intent_data = []
group_cols = []
for intent in intents_of_interest:
    bot_intent = bot_df[bot_df['intent'] == intent]
    human_intent = human_df[human_df['intent'] == intent]
    _, bot_demo_intent, _, bot_closed_intent = compute_rates(bot_intent)
    _, human_demo_intent, _, human_closed_intent = compute_rates(human_intent)
    group_cols.append(intent.capitalize())
    intent_data.append([bot_demo_intent, bot_closed_intent])
    intent_data.append([human_demo_intent, human_closed_intent])

# Create grouped bar chart
fig, ax = plt.subplots(figsize=(10, 6))
x = np.arange(len(intents_of_interest))
width = 0.35
metrics = ['Demo Rate', 'Closed-Won Rate']
colors = ['skyblue', 'lightcoral']
for i, metric_idx in enumerate([0, 1]):
    offset = width * i - width/2
    bot_vals = [intent_data[2*j][metric_idx] for j in range(len(intents_of_interest))]
    human_vals = [intent_data[2*j+1][metric_idx] for j in range(len(intents_of_interest))]
    ax.bar(x + offset, bot_vals, width/2, label=f'Bot-First {metrics[i]}', color=colors[i], hatch='//' if i==1 else None)
    ax.bar(x + offset + width/2, human_vals, width/2, label=f'Human-First {metrics[i]}', color=colors[i], alpha=0.7, hatch='\\' if i==1 else None)
ax.set_xlabel('Intent')
ax.set_ylabel('Conversion Rate (%)')
ax.set_title('Conversion Rates by Intent and First Response Type')
ax.set_xticks(x)
ax.set_xticklabels([intent.capitalize() for intent in intents_of_interest])
# Create custom legend
from matplotlib.patches import Patch
legend_elements = [Patch(facecolor='skyblue', label='Demo Rate'),
                   Patch(facecolor='lightcoral', label='Closed-Won Rate'),
                   Patch(facecolor='white', edgecolor='black', hatch='//', label='Bot-First'),
                   Patch(facecolor='white', edgecolor='black', hatch='\\', label='Human-First')]
ax.legend(handles=legend_elements, loc='upper left')
plt.tight_layout()
plt.savefig('intent_conversion_rates.png', dpi=300)
plt.close()

# Plot 3: Regional closed-won rates
regions = df['region'].dropna().unique()
region_data = []
for region in regions:
    bot_region = bot_df[bot_df['region'] == region]
    human_region = human_df[human_df['region'] == region]
    _, _, _, bot_closed_region = compute_rates(bot_region)
    _, _, _, human_closed_region = compute_rates(human_region)
    region_data.append((region, bot_closed_region, human_closed_region))

region_data = sorted(region_data, key=lambda x: x[1] + x[2], reverse=True)  # sort by sum
regions_sorted = [r[0] for r in region_data]
bot_rates_reg = [r[1] for r in region_data]
human_rates_reg = [r[2] for r in region_data]

fig, ax = plt.subplots(figsize=(12, 7))
x = np.arange(len(regions_sorted))
width = 0.35
bars1 = ax.bar(x - width/2, bot_rates_reg, width, label='Bot-First', color='skyblue')
bars2 = ax.bar(x + width/2, human_rates_reg, width, label='Human-First', color='lightcoral')
ax.set_xlabel('Region')
ax.set_ylabel('Closed-Won Rate (%)')
ax.set_title('Closed-Won Rate by Region and First Response Type')
ax.set_xticks(x)
