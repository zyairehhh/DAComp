import sqlite3
import pandas as pd
import numpy as np
import re

def extract_lower_salary(salary_str):
    if not isinstance(salary_str, str):
        return None
    # Remove commas
    s = salary_str.replace(',', '')
    # Find the first number (integer) before a dash
    # Pattern: optional currency, digits, optional decimal, maybe followed by dash
    match = re.search(r'(\d+)\s*-\s*\d+', s)
    if match:
        lower = int(match.group(1))
        return lower
    # If pattern not found, try to find first number
    match = re.search(r'(\d+)', s)
    if match:
        lower = int(match.group(1))
        return lower
    return None

def main():
    conn = sqlite3.connect('dacomp-048.sqlite')
    query = "SELECT * FROM sheet1 WHERE \"Education Requirement\" = 'Vocational school or above'"
    df = pd.read_sql_query(query, conn)
    print(f"Rows: {df.shape[0]}")
    
    # Extract starting salary
    df['starting_salary'] = df['Salary Range'].apply(extract_lower_salary)
    # Drop rows where salary not parsed
    df_salary = df.dropna(subset=['starting_salary'])
    print(f"Rows with parsed salary: {df_salary.shape[0]}")
    
    # Compute distribution (bins)
    bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 50000]
    labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-7k', '7k-8k', '8k-9k', '9k-10k', '10k-15k', '15k-20k', '>20k']
    df_salary['salary_bin'] = pd.cut(df_salary['starting_salary'], bins=bins, labels=labels, right=False)
    distribution = df_salary['salary_bin'].value_counts().sort_index()
    print("Starting Salary Distribution:")
    print(distribution)
    
    # Save distribution to CSV for later use
    distribution.to_csv('salary_distribution.csv')
    
    # Benefits distribution: split benefits string by common separators (commas, semicolons, spaces)
    benefits_col = df['Benefits']
    # Let's first get unique benefits to see pattern
    all_benefits = []
    for b in benefits_col.dropna():
        # Split by common separators
        split = re.split(r'[,;、，；]', b)
        for item in split:
            item = item.strip()
            if item:
                all_benefits.append(item)
    from collections import Counter
    benefit_counts = Counter(all_benefits)
    top_benefits = benefit_counts.most_common(30)
    print("\nTop 30 Benefits:")
    for benefit, count in top_benefits:
        print(f"{benefit}: {count}")
    
    # Save top benefits
    pd.DataFrame(top_benefits, columns=['Benefit', 'Count']).to_csv('benefits_distribution.csv', index=False)
    
    # Analyze qualities effect on starting salary
    # Qualities: Work Experience Requirement, Foreign Language Requirement, Age Requirement, Gender Requirement, Company Type, Industry
    qualities = ['Work Experience Requirement', 'Foreign Language Requirement', 'Age Requirement', 'Gender Requirement', 'Company Type', 'Industry']
    for col in qualities:
        if col in df_salary.columns:
            # Group by unique values and compute mean starting salary
            grouped = df_salary.groupby(col)['starting_salary'].agg(['mean', 'count']).sort_values('mean', ascending=False)
            # Filter out categories with too few samples (e.g., count < 10)
            filtered = grouped[grouped['count'] >= 10]
            print(f"\n{col} vs Starting Salary (top 10 by mean):")
            print(filtered.head(10))
            # Save to CSV
            filtered.to_csv(f'{col}_salary_effect.csv')
    
    conn.close()

if __name__ == '__main__':
    main()
```
