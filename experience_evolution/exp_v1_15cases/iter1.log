import sqlite3
import pandas as pd
import numpy as np
import json

def parse_tag(tag_str, key):
    if not tag_str or pd.isna(tag_str):
        return None
    key_str = key + ':'
    start = tag_str.find(key_str)
    if start == -1:
        return None
    start += len(key_str)
    end = tag_str.find('|', start)
    if end == -1:
        return tag_str[start:]
    else:
        return tag_str[start:end]

def main():
    conn = sqlite3.connect('/workspace/dacomp-098.sqlite')
    # Load conversation_enhanced with conversation_id, conversation_initiated_type, all_conversation_tags
    query = """
    SELECT conversation_id, conversation_initiated_type, all_conversation_tags
    FROM intercom__conversation_enhanced
    """
    df = pd.read_sql_query(query, conn)
    # Parse tags
    df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
    df['intent_label'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
    df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))
    df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
    df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
    df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))
    
    # Load conversation_metrics for timestamps
    query2 = """
    SELECT conversation_id, conversation_created_at,
           first_admin_response_at, first_contact_reply_at,
           time_to_first_response_minutes
    FROM intercom__conversation_metrics
    """
    df_metrics = pd.read_sql_query(query2, conn)
    df = df.merge(df_metrics, on='conversation_id', how='inner')
    
    # For conversion funnel, we assume stage indicates the highest stage reached.
    # Count per initiated_type and stage
    stage_counts = df.groupby(['conversation_initiated_type', 'stage']).size().unstack(fill_value=0)
    print("Stage counts:")
    print(stage_counts)
    
    # Define funnel stages ordered: demo_booked, trial_started?, trial_activated, closed_won
    # We have stages: demo_booked, trial_started, trial_activated, closed_won, closed_lost, etc.
    # Let's compute conversion rates.
    total_conversations = df.groupby('conversation_initiated_type').size()
    print("\nTotal conversations per type:")
    print(total_conversations)
    
    # Conversion rate 1: % of customers who book a demo after starting a conversation
    # That's simply count where stage = demo_booked divided by total conversations
    demo_booked_counts = df[df['stage'] == 'demo_booked'].groupby('conversation_initiated_type').size()
    demo_conversion_rate = demo_booked_counts / total_conversations * 100
    print("\nDemo booked counts:")
    print(demo_booked_counts)
    print("\nDemo conversion rate (%):")
    print(demo_conversion_rate)
    
    # Conversion rate 2: % of customers who activate a trial after booking a demo.
    # Need to count customers who reached trial_activation among those who booked a demo.
    # However, we don't have a sequence per customer; each conversation is independent? 
    # We'll assume each conversation is a unique lead, and stage indicates final stage.
    # Thus, we compute conditional probability: P(trial_activated | demo_booked) = count(trial_activated) / count(demo_booked)
    # But that's assuming that if someone reaches trial_activated, they also had demo_booked earlier? Not necessarily.
    # Better to compute funnel as: total conversations -> demo_booked -> trial_activated -> closed_won
    # We'll compute counts for each stage and derive rates.
    trial_activated_counts = df[df['stage'] == 'trial_activated'].groupby('conversation_initiated_type').size()
    closed_won_counts = df[df['stage'] == 'closed_won'].groupby('conversation_initiated_type').size()
    
    print("\nTrial activated counts:")
    print(trial_activated_counts)
    print("\nClosed won counts:")
    print(closed_won_counts)
    
    # Compute stage durations
    # We need timestamps: first_response_at is first_admin_response_at or first_contact_reply_at? 
    # The task: define stage duration average time interval (in days) between first response and booking, booking and activation, activation and payment.
    # Since we don't have exact timestamps for each stage, we cannot compute these durations.
    # We'll approximate using conversation_created_at and first_admin_response_at? Not accurate.
    # For now, we can compute average time_to_first_response_minutes by initiated_type.
    print("\nAverage time to first response (minutes):")
    avg_time = df.groupby('conversation_initiated_type')['time_to_first_response_minutes'].mean()
    print(avg_time)
    
    # Also include intent_label breakdown to explain differences
    print("\nIntent distribution:")
    intent_counts = df.groupby(['conversation_initiated_type', 'intent_label']).size().unstack(fill_value=0)
    print(intent_counts)
    
    # Save results for reporting
    stage_counts.to_csv('/workspace/stage_counts.csv')
    demo_conversion_rate.to_csv('/workspace/demo_conversion_rate.csv')
    avg_time.to_csv('/workspace/avg_time_to_first_response.csv')
    intent_counts.to_csv('/workspace/intent_counts.csv')
    
    # Additional analysis: region, segment, lifecycle
    print("\nRegion distribution:")
    region_counts = df.groupby(['conversation_initiated_type', 'region']).size().unstack(fill_value=0)
    print(region_counts.head())
    
    conn.close()

if __name__ == '__main__':
    main()
```
