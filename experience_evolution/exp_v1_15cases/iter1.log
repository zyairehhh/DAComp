'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-092.sqlite')
# Get high-volatility customers (top 25% of customer_margin_volatility)
query = '''
SELECT customer_id, MAX(customer_margin_volatility) as max_vol
FROM quickbooks__profitability_analysis
GROUP BY customer_id
'''
cust_vol = pd.read_sql_query(query, conn)
threshold = cust_vol['max_vol'].quantile(0.75)
high_vol_ids = cust_vol[cust_vol['max_vol'] >= threshold]['customer_id'].tolist()
print(f'High-volatility customers: {len(high_vol_ids)}')

# Monthly revenue per customer
pa_monthly = pd.read_sql_query('''
    SELECT customer_id,
           strftime('%Y-%m', transaction_date) as month,
           SUM(invoice_total) as revenue
    FROM quickbooks__profitability_analysis
    GROUP BY customer_id, month
''', conn)
# Add flag for high-volatility
pa_monthly['is_high_vol'] = pa_monthly['customer_id'].isin(high_vol_ids)
# Aggregate total revenue per month
monthly_total = pa_monthly.groupby('month')['revenue'].sum().reset_index().rename(columns={'revenue':'total_revenue'})
monthly_high = pa_monthly[pa_monthly['is_high_vol']].groupby('month')['revenue'].sum().reset_index().rename(columns={'revenue':'high_vol_revenue'})
monthly = pd.merge(monthly_total, monthly_high, on='month', how='left').fillna(0)
monthly['high_vol_proportion'] = monthly['high_vol_revenue'] / monthly['total_revenue']

# Get financial_dashboard business_health_score and collection_rate_percentage
fd = pd.read_sql_query('''
    SELECT strftime('%Y-%m', dashboard_month) as month,
           business_health_score,
           collection_rate_percentage
    FROM quickbooks__financial_dashboard
''', conn)
# Merge
merged = pd.merge(fd, monthly, on='month', how='inner')
if merged.empty:
    print('No overlapping months')
    conn.close()
    exit()

# Plot
fig, axes = plt.subplots(2, 2, figsize=(14,10))
# Scatter: high_vol_proportion vs business_health_score
axes[0,0].scatter(merged['high_vol_proportion'], merged['business_health_score'], alpha=0.7)
axes[0,0].set_xlabel('Proportion of High-Volatility Customer Revenue')
axes[0,0].set_ylabel('Business Health Score')
axes[0,0].set_title('Impact of High-Volatility Customers on Business Health')
axes[0,0].grid(True, alpha=0.3)
# high_vol_proportion vs collection_rate_percentage
axes[0,1].scatter(merged['high_vol_proportion'], merged['collection_rate_percentage'], alpha=0.7, color='orange')
axes[0,1].set_xlabel('Proportion of High-Volatility Customer Revenue')
axes[0,1].set_ylabel('Collection Rate Percentage')
axes[0,1].set_title('Impact on Collection Rate')
axes[0,1].grid(True, alpha=0.3)
# Trend over time: business_health_score
axes[1,0].plot(merged['month'], merged['business_health_score'], marker='o', label='Business Health Score')
axes[1,0].set_xlabel('Month')
axes[1,0].set_ylabel('Business Health Score')
axes[1,0].tick_params(axis='x', rotation=45)
axes[1,0].set_title('Business Health Score Over Time')
axes[1,0].grid(True, alpha=0.3)
# Trend over time: high_vol_proportion
ax2 = axes[1,0].twinx()
ax2.plot(merged['month'], merged['high_vol_proportion'], marker='s', color='red', label='High-Vol Proportion')
ax2.set_ylabel('High-Vol Proportion', color='red')
ax2.tick_params(axis='y', labelcolor='red')
lines1, labels1 = axes[1,0].get_legend_handles_labels()
lines2, labels2 = ax2.get_legend_handles_labels()
axes[1,0].legend(lines1+lines2, labels1+labels2, loc='upper left')
# Bar: high-vol customers count per segment
ca = pd.read_sql_query('''
    SELECT customer_id, customer_value_segment, rfm_segment
    FROM quickbooks__customer_analytics
''', conn)
ca['is_high_vol'] = ca['customer_id'].isin(high_vol_ids)
segment_counts = ca.groupby('customer_value_segment')['is_high_vol'].sum().reset_index()
segment_counts = segment_counts.sort_values('is_high_vol', ascending=False).head(10)
axes[1,1].bar(segment_counts['customer_value_segment'], segment_counts['is_high_vol'], color='steelblue')
axes[1,1].set_xlabel('Customer Value Segment')
axes[1,1].set_ylabel('Number of High-Volatility Customers')
axes[1,1].set_title('High-Volatility Customers by Value Segment')
axes[1,1].tick_params(axis='x', rotation=45)
axes[1,1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('impact_analysis.png', dpi=300, bbox_inches='tight')
plt.close()
conn.close()
print('Extra plot saved.')
''')
