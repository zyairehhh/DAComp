           female_hire_representation,
           non_white_hire_representation,
           overall_hire_rate
    FROM greenhouse__diversity_metrics
    ORDER BY application_year, application_quarter
""", conn)
div_df['quarter_label'] = div_df['application_year'].astype(str) + 'Q' + div_df['application_quarter'].astype(str)

plt.figure(figsize=(10,6))
plt.plot(div_df['quarter_label'], div_df['female_hire_representation'], marker='o', label='Female Hire %', linewidth=2)
plt.plot(div_df['quarter_label'], div_df['non_white_hire_representation'], marker='s', label='Non‑White Hire %', linewidth=2)
plt.axhline(y=0.40, color='r', linestyle='--', alpha=0.5, label='Female Target (40%)')
plt.axhline(y=0.30, color='g', linestyle='--', alpha=0.5, label='Non‑White Target (30%)')
plt.xlabel('Quarter')
plt.ylabel('Representation (%)')
plt.title('Diversity Hire Representation Over Time')
plt.legend()
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/diversity_trend.png', dpi=300)
plt.close()

# --- 3. Interview stage conversion funnel ---
# Aggregate from application_enhanced? Let's compute counts per stage.
pipeline_df = pd.read_sql_query("""
    SELECT current_stage, COUNT(*) as count_apps,
           SUM(CASE WHEN status = 'hired' THEN 1 ELSE 0 END) as hired,
           SUM(CASE WHEN status = 'active' THEN 1 ELSE 0 END) as active
    FROM greenhouse__application_enhanced
    GROUP BY current_stage
    ORDER BY 
        CASE current_stage 
            WHEN 'application' THEN 1
            WHEN 'phone screen' THEN 2
            WHEN 'technical interview' THEN 3
            WHEN 'onsite interview' THEN 4
            WHEN 'offer' THEN 5
            ELSE 6 END
""", conn)

plt.figure(figsize=(10,6))
plt.bar(pipeline_df['current_stage'], pipeline_df['count_apps'], color='lightblue', label='Applications')
plt.bar(pipeline_df['current_stage'], pipeline_df['hired'], color='darkgreen', label='Hired')
plt.bar(pipeline_df['current_stage'], pipeline_df['active'], color='orange', label='Active', alpha=0.7)
plt.xlabel('Recruitment Stage')
plt.ylabel('Count')
plt.title('Application Volume and Hires by Recruitment Stage')
plt.xticks(rotation=45)
plt.legend()
plt.tight_layout()
plt.savefig('/workspace/pipeline_stages.png', dpi=300)
plt.close()

# --- 4. Department‑level conversion rates ---
job_df = pd.read_sql_query("""
    SELECT job_departments, 
           COUNT(*) as num_jobs,
           AVG(overall_conversion_rate) as avg_conversion,
           AVG(interview_to_hire_rate) as avg_i2h,
           AVG(avg_job_rating) as avg_rating
    FROM greenhouse__job_enhanced
    WHERE job_departments IS NOT NULL AND job_departments != ''
    GROUP BY job_departments
    ORDER BY avg_conversion DESC
    LIMIT 10
""", conn)
plt.figure(figsize=(10,6))
plt.barh(job_df['job_departments'], job_df['avg_conversion'], color='teal')
plt.xlabel('Average Overall Conversion Rate')
plt.title('Top 10 Departments by Conversion Rate')
plt.tight_layout()
plt.savefig('/workspace/department_conversion.png', dpi=300)
plt.close()

# --- 5. Interviewer satisfaction vs alignment (if data exists) ---
# Check greenhouse__interview_enhanced
# Let's get average interview score by interviewer background alignment.
try:
    interview_df = pd.read_sql_query("""
        SELECT interviewer_background_alignment,
               AVG(interview_score) as avg_score,
               COUNT(*) as count
        FROM greenhouse__interview_enhanced
        WHERE interviewer_background_alignment IS NOT NULL
        GROUP BY interviewer_background_alignment
        ORDER BY avg_score DESC
    """, conn)
    if not interview_df.empty:
        plt.figure(figsize=(8,5))
        plt.bar(interview_df['interviewer_background_alignment'], interview_df['avg_score'], color='purple')
        plt.xlabel('Interviewer Background Alignment')
        plt.ylabel('Average Interview Score')
        plt.title('Interviewer Alignment Impact on Interview Score')
        for i, (idx, row) in enumerate(interview_df.iterrows()):
            plt.text(i, row['avg_score']+0.05, f"{row['avg_score']:.2f}", ha='center', fontsize=10)
        plt.tight_layout()
        plt.savefig('/workspace/interviewer_alignment.png', dpi=300)
        plt.close()
except Exception as e:
    print("Interviewer alignment data not available:", e)

conn.close()
''')
