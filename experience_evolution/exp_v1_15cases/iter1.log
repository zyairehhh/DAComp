import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-058.sqlite')

# 1. Identify candidate campaigns (monthly cost > $1000 and ROI < 0.8 at least once)
candidate_query = """
SELECT DISTINCT campaign_id, campaign_name, campaign_type, bidding_strategy, industry
FROM google_ads__campaign_report
WHERE cost > 1000 AND (conversion_value - cost)/cost < 0.8
"""
candidates = pd.read_sql_query(candidate_query, conn)
print(f"Number of candidate campaigns (high-cost, low-ROI): {len(candidates)}")
print(candidates.head())

# 2. Compute aggregated campaign-level metrics (including avg_position)
campaign_summary = pd.read_sql_query("""
    SELECT
        campaign_id,
        SUM(cost) as total_cost,
        SUM(conversion_value) as total_conversion_value,
        SUM(conversions) as total_conversions,
        SUM(clicks) as total_clicks,
        SUM(impressions) as total_impressions,
        AVG(ctr) as avg_ctr,
        AVG(conversion_rate) as avg_conversion_rate,
        AVG(quality_score) as avg_quality_score,
        AVG(impression_share) as avg_impression_share,
        AVG(roas) as avg_roas,
        AVG((conversion_value - cost)/cost) as avg_roi,
        COUNT(*) as months_active
    FROM google_ads__campaign_report
    GROUP BY campaign_id
""", conn)

# avg_position weighted by impressions from keyword_report
keyword_avg = pd.read_sql_query("""
    SELECT
        campaign_id,
        SUM(impressions * avg_position) / SUM(impressions) as avg_position_weighted
    FROM google_ads__keyword_report
    WHERE impressions > 0
    GROUP BY campaign_id
""", conn)

campaign_metrics = campaign_summary.merge(keyword_avg, on='campaign_id', how='left')
campaign_metrics['is_candidate'] = campaign_metrics['campaign_id'].isin(candidates['campaign_id'])

# 3. Health Score Model
# Normalize each metric to percentile rank (0-100)
for col in ['avg_roi', 'avg_conversion_rate', 'avg_quality_score', 'avg_ctr', 'avg_impression_share']:
    campaign_metrics[col+'_rank'] = campaign_metrics[col].rank(pct=True) * 100

# Invert avg_position (lower is better)
campaign_metrics['avg_position_inverted'] = 1 / campaign_metrics['avg_position_weighted']
campaign_metrics['avg_position_rank'] = campaign_metrics['avg_position_inverted'].rank(pct=True) * 100

# Dimension scores with weights
campaign_metrics['cost_efficiency_score'] = campaign_metrics['avg_roi_rank'] * 0.4
campaign_metrics['conversion_quality_score'] = (campaign_metrics['avg_conversion_rate_rank'] + campaign_metrics['avg_quality_score_rank']) / 2 * 0.35
campaign_metrics['competitiveness_score'] = (campaign_metrics['avg_ctr_rank'] + campaign_metrics['avg_impression_share_rank'] + campaign_metrics['avg_position_rank']) / 3 * 0.25
campaign_metrics['health_score'] = (campaign_metrics['cost_efficiency_score'] +
                                    campaign_metrics['conversion_quality_score'] +
                                    campaign_metrics['competitiveness_score'])

# Risk levels based on health_score quartiles
campaign_metrics['risk_level'] = pd.qcut(campaign_metrics['health_score'], q=4, labels=['Low', 'Medium', 'High', 'Critical'])

# Add metadata
campaign_meta = pd.read_sql_query("""
    SELECT DISTINCT campaign_id, campaign_name, campaign_type, bidding_strategy, industry
    FROM google_ads__campaign_report
""", conn)
campaign_metrics = campaign_metrics.merge(campaign_meta, on='campaign_id', how='left')
campaign_metrics['roi'] = (campaign_metrics['total_conversion_value'] - campaign_metrics['total_cost']) / campaign_metrics['total_cost']

# Save full health score table
campaign_metrics.to_csv('campaign_health_full.csv', index=False)
print("\nHealth scores saved to campaign_health_full.csv")
print("Health score distribution:", campaign_metrics['health_score'].describe())

# 4. High-risk campaigns (candidates with health_score in bottom 25% or risk level Critical/High)
high_risk = campaign_metrics[campaign_metrics['is_candidate'] & (campaign_metrics['risk_level'].isin(['High','Critical']))]
print(f"\nHigh-risk candidate campaigns: {len(high_risk)}")
print(high_risk[['campaign_id','campaign_name','health_score','risk_level','avg_roi','avg_conversion_rate','avg_ctr','avg_impression_share','avg_position_weighted']])

# 5. Performance differences across dimensions
# a) campaign_type
def dimension_performance(dim):
    df = campaign_metrics.groupby(dim).agg(
        avg_roi=('avg_roi','mean'),
        avg_conversion_rate=('avg_conversion_rate','mean'),
        avg_ctr=('avg_ctr','mean'),
        avg_impression_share=('avg_impression_share','mean'),
        avg_quality_score=('avg_quality_score','mean'),
        avg_position_weighted=('avg_position_weighted','mean'),
        total_cost=('total_cost','sum'),
        total_conversions=('total_conversions','sum')
    ).reset_index()
    df['conversion_cost_ratio'] = df['total_conversions'] / df['total_cost']
    return df

for dim in ['campaign_type','bidding_strategy','industry']:
    print(f"\n--- Performance by {dim} ---")
    print(dimension_performance(dim).round(3))

# b) geo_target
geo_perf = pd.read_sql_query("""
    SELECT
        geo_target,
        AVG((conversion_value - cost)/cost) as avg_roi,
        AVG(conversion_rate) as avg_conversion_rate,
        AVG(ctr) as avg_ctr,
        AVG(impression_share) as avg_impression_share,
        AVG(quality_score) as avg_quality_score,
        SUM(cost) as total_cost,
        SUM(conversions) as total_conversions
    FROM google_ads__geo_report
    GROUP BY geo_target
""", conn)
geo_perf['conversion_cost_ratio'] = geo_perf['total_conversions'] / geo_perf['total_cost']
print("\n--- Performance by geo_target ---")
print(geo_perf.round(3))

# c) device_type
device_perf = pd.read_sql_query("""
    SELECT
        device_type,
        AVG((conversion_value - cost)/cost) as avg_roi,
        AVG(conversion_rate) as avg_conversion_rate,
        AVG(ctr) as avg_ctr,
        AVG(impression_share) as avg_impression_share,
        AVG(quality_score) as avg_quality_score,
        SUM(cost) as total_cost,
        SUM(conversions) as total_conversions
    FROM google_ads__device_report
    GROUP BY device_type
""", conn)
device_perf['conversion_cost_ratio'] = device_perf['total_conversions'] / device_perf['total_cost']
print("\n--- Performance by device_type ---")
print(device_perf.round(3))

# 6. Trend analysis: YoY growth for each campaign (or overall) for months Jan-Jun
# Extract month and year
monthly = pd.read_sql_query("""
    SELECT
        campaign_id,
        year_month,
        SUM(cost) as cost,
        SUM(conversion_value) as conversion_value,
        SUM(conversions) as conversions,
        AVG((conversion_value - cost)/cost) as roi,
        AVG(conversion_rate) as conversion_rate,
        AVG(ctr) as ctr,
        AVG(impression_share) as impression_share
    FROM google_ads__campaign_report
    GROUP BY campaign_id, year_month
""", conn)
monthly['year'] = monthly['year_month'].str[:4].astype(int)
monthly['month'] = monthly['year_month'].str[-2:].astype(int)

# Prepare pivot for YoY comparison (only months present in both years)
pivot = monthly.pivot_table(index='month', columns='year', values='roi', aggfunc='mean')
print("\n--- Average ROI by month across years ---")
print(pivot.round(3))

# Compute year-over-year growth for overlapping months (Jan-Jun)
overlap_months = [1,2,3,4,5,6]
growth = {}
for m in overlap_months:
    if m in pivot.index and 2023 in pivot.columns and 2024 in pivot.columns:
        roi_2023 = pivot.loc[m, 2023]
        roi_2024 = pivot.loc[m, 2024]
        growth[m] = (roi_2024 - roi_2023) / roi_2023 if roi_2023 != 0 else np.nan
print("\n--- YoY ROI growth (2024 vs 2023) for Jan-Jun ---")
for m, g in growth.items():
    print(f"Month {m}: {g:.1%}")

# Seasonal fluctuation (average ROI per month across all years)
seasonal = monthly.groupby('month')['roi'].mean().reset_index()
print("\n--- Seasonal average ROI (across all months) ---")
print(seasonal.round(3))

# 7. Identify core problems per high-risk campaign
# For each high-risk campaign, determine which dimension scores are low.
high_risk['lowest_dimension'] = high_risk[['cost_efficiency_score','conversion_quality_score','competitiveness_score']].idxmin(axis=1)
high_risk['lowest_dimension'] = high_risk['lowest_dimension'].str.replace('_score','')
print("\n--- High-risk campaign diagnosis ---")
for _, row in high_risk.iterrows():
    print(f"Campaign {row['campaign_id']} ({row['campaign_name']}) - Risk: {row['risk_level']}, Health: {row['health_score']:.1f}")
    print(f"  Lowest dimension: {row['lowest_dimension']}")
    print(f"  ROI: {row['avg_roi']:.2f}, Conv rate: {row['avg_conversion_rate']:.4f}, CTR: {row['avg_ctr']:.5f}, Imp share: {row['avg_impression_share']:.3f}, Avg position: {row['avg_position_weighted']:.2f}")
    # Recommend based on low dimension
    if row['lowest_dimension'] == 'cost_efficiency':
        print("  Recommendation: Improve ROI via bid adjustments, keyword optimization, or landing page improvements.")
    elif row['lowest_dimension'] == 'conversion_quality':
        print("  Recommendation: Improve conversion rate via ad copy, landing page, targeting adjustments.")
    else:
        print("  Recommendation: Improve competitiveness via increasing bids, ad relevance, or budget allocation.")

# Save high risk campaigns to CSV
high_risk.to_csv('high_risk_campaigns.csv', index=False)
print("\nHigh-risk campaigns saved to high_risk_campaigns.csv")

conn.close()
```

