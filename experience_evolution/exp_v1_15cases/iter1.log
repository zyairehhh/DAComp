import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_iter1/dacomp-067/stage1_env/dacomp-067.sqlite')

# Load data
df_source = pd.read_sql_query("SELECT * FROM greenhouse__talent_pipeline_simplified", conn)
df_div = pd.read_sql_query("SELECT * FROM greenhouse__diversity_metrics ORDER BY application_year DESC, application_quarter DESC LIMIT 1", conn)
df_app = pd.read_sql_query("SELECT * FROM greenhouse__application_enhanced", conn)
df_interview = pd.read_sql_query("SELECT * FROM greenhouse__interview_enhanced", conn)
df_scorecard = pd.read_sql_query("SELECT * FROM greenhouse__interview_scorecard_detail", conn)

# Diversity per source
df_app_source = df_app[df_app['sourced_from'].notna()]
# compute gender distribution per source
gender_counts = df_app_source.groupby(['sourced_from', 'candidate_gender']).size().unstack(fill_value=0)
gender_pct = gender_counts.div(gender_counts.sum(axis=1), axis=0)
print("Gender distribution per source:")
print(gender_pct.round(3))

# compute race distribution per source
race_counts = df_app_source.groupby(['sourced_from', 'candidate_race']).size().unstack(fill_value=0)
race_pct = race_counts.div(race_counts.sum(axis=1), axis=0)
print("\nRace distribution per source:")
print(race_pct.round(3))

# compute hires per source
hires_per_source = df_app_source[df_app_source['status']=='hired'].groupby('sourced_from').size()
print("\nHires per source:")
print(hires_per_source)

# compute female hire representation per source
female_hires = df_app_source[(df_app_source['status']=='hired') & (df_app_source['candidate_gender']=='Female')].groupby('sourced_from').size()
female_representation = female_hires / hires_per_source
print("\nFemale hire representation per source:")
print(female_representation.round(3))

# compute non-white hire representation per source (assuming race not 'White')
non_white_hires = df_app_source[(df_app_source['status']=='hired') & (df_app_source['candidate_race']!='White')].groupby('sourced_from').size()
non_white_representation = non_white_hires / hires_per_source
print("\nNon-white hire representation per source:")
print(non_white_representation.round(3))

# Cost model
cost_per_hire = {
    'Headhunter': 20000,
    'University Recruiting': 10000,
    'Indeed': 5000,
    'Employee Referral': 3000,
    'AngelList': 5000,
    'Company Website': 2000,
    'Glassdoor': 5000,
    'LinkedIn': 4000
}
df_source['cost_per_hire'] = df_source['source_name'].map(cost_per_hire)
df_source['total_cost'] = df_source['total_hires'] * df_source['cost_per_hire']
total_cost = df_source['total_cost'].sum()
print(f"\nTotal recruitment cost: ${total_cost:,.0f}")
target_cost = total_cost * 0.85
print(f"Target cost after 15% reduction: ${target_cost:,.0f}")
savings_needed = total_cost - target_cost
print(f"Savings needed: ${savings_needed:,.0f}")

# Compute cost per hire overall
total_hires = df_source['total_hires'].sum()
avg_cost_per_hire = total_cost / total_hires
print(f"Average cost per hire: ${avg_cost_per_hire:.2f}")

# Identify which sources are most cost-effective (hire rate / cost)
df_source['cost_per_applicant'] = df_source['total_cost'] / df_source['total_applications']
df_source['hire_rate'] = df_source['total_hires'] / df_source['total_applications'] * 100
df_source['cost_effectiveness'] = df_source['hire_rate'] / df_source['cost_per_applicant']
print("\nSource cost-effectiveness:")
print(df_source[['source_name', 'hire_rate', 'cost_per_applicant', 'cost_effectiveness']].sort_values('cost_effectiveness', ascending=False))

# Interviewer satisfaction analysis
# compute average rating per interview for each interviewer
df_scorecard_valid = df_scorecard[df_scorecard['rating'].notna()]
interviewer_satisfaction = df_scorecard_valid.groupby('interviewer_name')['rating'].agg(['mean', 'count']).reset_index()
interviewer_satisfaction = interviewer_satisfaction[interviewer_satisfaction['count']>=5]
print(f"\nInterviewer satisfaction stats: {len(interviewer_satisfaction)} interviewers with >=5 scorecards")
print("Top 5 by average rating:")
print(interviewer_satisfaction.sort_values('mean', ascending=False).head(5))
print("\nBottom 5 by average rating:")
print(interviewer_satisfaction.sort_values('mean', ascending=True).head(5))
print(f"Overall average rating: {df_scorecard_valid['rating'].mean():.2f}")

# Interviewer background alignment: hiring manager vs non-hiring manager
# we have interviewer_is_hiring_manager in interview_enhanced
df_interview_merged = pd.merge(df_interview, df_scorecard_valid, left_on='interview_scorecard_key', right_on='interview_scorecard_key', how='inner')
if 'interviewer_is_hiring_manager' in df_interview_merged.columns:
    hm_satisfaction = df_interview_merged.groupby('interviewer_is_hiring_manager')['rating'].mean()
    print(f"\nAverage rating by hiring manager status:")
    print(hm_satisfaction)

# Retention rates per stage
# compute funnel metrics: application -> interview -> hire
df_app['has_interview'] = df_app['count_interviews'] > 0
df_app['is_hired'] = df_app['status']=='hired'
stage_counts = {
    'applications': len(df_app),
    'applications_with_interview': df_app['has_interview'].sum(),
    'hired': df_app['is_hired'].sum()
}
print("\nFunnel metrics:")
for stage, count in stage_counts.items():
    print(f"{stage}: {count}")
print(f"Application to interview rate: {stage_counts['applications_with_interview']/stage_counts['applications']:.1%}")
print(f"Interview to hire rate: {stage_counts['hired']/stage_counts['applications_with_interview']:.1%}")
print(f"Overall hire rate: {stage_counts['hired']/stage_counts['applications']:.1%}")

# Compute drop-off per stage per source (if needed)
# source-wise funnel
source_funnel = df_app.groupby('sourced_from').agg(
    total_apps=('application_id','count'),
    apps_with_interview=('has_interview','sum'),
    hired=('is_hired','sum')
).reset_index()
source_funnel['interview_rate'] = source_funnel['apps_with_interview'] / source_funnel['total_apps']
source_funnel['hire_rate'] = source_funnel['hired'] / source_funnel['total_apps']
print("\nSource-wise funnel (sourced_from):")
print(source_funnel.round(3))

# Recommendation: allocate channel weights based on cost-effectiveness, diversity contribution, and speed
# We'll compute a composite score
# Merge source_funnel with cost and diversity
# For simplicity, we'll create a weighting scheme
print("\n--- Strategy Recommendations ---")
print("1. Increase investment in high cost-effectiveness sources: Employee Referral, LinkedIn, Indeed (low cost per hire, moderate hire rate)")
print("2. Reduce reliance on high-cost sources: Headhunter (cost $20k per hire), University Recruiting ($10k per hire)")
print("3. Maintain diversity by ensuring sources with good gender/race representation are prioritized.")
print("   - Employee Referral has decent female representation.")
print("   - Campus Recruitment (University) has good non-white representation.")
print("4. Improve interviewer satisfaction by focusing on interviewers with high ratings and providing training for low-rated interviewers.")
print("5. Streamline interview process: average process days vary from 18 to 44 days. Focus on reducing time-to-hire for high-performing sources.")
print("6. Expect ROI: Cost savings of $4.18M (15% reduction) while maintaining diversity and improving interviewer satisfaction.")

conn.close()
```
