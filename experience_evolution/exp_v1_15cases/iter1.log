'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo groups
geo_df = pd.read_sql_query("SELECT * FROM google_play__geo_market_analysis WHERE package_name = 'com.dev.photoeditor'", conn)
geo_df['revenue_group'] = np.where(geo_df['avg_transaction_value'] > 30, 'high', 'low')

# Finance data
finance_df = pd.read_sql_query("SELECT country_long, region, date_day, net_amount, transactions FROM google_play__finance_report WHERE package_name = 'com.dev.photoeditor'", conn)
finance_df['date_day'] = pd.to_datetime(finance_df['date_day'])
finance_df['month'] = finance_df['date_day'].dt.to_period('M')
country_to_group = geo_df.set_index('country_name')['revenue_group'].to_dict()
finance_df['revenue_group'] = finance_df['country_long'].map(country_to_group)
finance_df = finance_df.dropna(subset=['revenue_group'])

# Compute total revenue per group across all months
total_by_group = finance_df.groupby('revenue_group')['net_amount'].sum()
print("Total net revenue (over all months) by group:")
print(total_by_group)
print("Proportion:", total_by_group / total_by_group.sum())

# Monthly revenue share
monthly_total = finance_df.groupby('month')['net_amount'].sum().reset_index()
monthly_group = finance_df.groupby(['month', 'revenue_group'])['net_amount'].sum().reset_index()
monthly_pivot = monthly_group.pivot(index='month', columns='revenue_group', values='net_amount').fillna(0)
monthly_pivot['total'] = monthly_pivot.sum(axis=1)
monthly_pivot['high_share'] = monthly_pivot['high'] / monthly_pivot['total']
monthly_pivot['low_share'] = monthly_pivot['low'] / monthly_pivot['total']
print("\nMonthly revenue share:")
print(monthly_pivot.head(12))

# Overall performance score trend
comp_df = pd.read_sql_query("SELECT date_day, overall_performance_score, research_budget_usd FROM google_play__comprehensive_performance_dashboard WHERE package_name = 'com.dev.photoeditor' ORDER BY date_day", conn)
comp_df['date_day'] = pd.to_datetime(comp_df['date_day'])
comp_df['month'] = comp_df['date_day'].dt.to_period('M')

# Join monthly performance with high revenue share
monthly_pivot = monthly_pivot.reset_index()
comp_df = comp_df.merge(monthly_pivot, on='month', how='left')
print("\nCombined data:")
print(comp_df[['month', 'overall_performance_score', 'high_share', 'low_share', 'total']])

# Correlation between overall_performance_score and high revenue share
corr = comp_df['overall_performance_score'].corr(comp_df['high_share'])
print(f"Correlation between overall_performance_score and high revenue share: {corr:.3f}")

# Compute contribution of low revenue markets to overall performance score? Not available directly, but we can examine if overall_performance_score decline is associated with high revenue share decline.
import matplotlib.pyplot as plt
plt.figure(figsize=(8,4))
plt.plot(comp_df['month'].astype(str), comp_df['overall_performance_score'], marker='o', label='Overall Performance')
plt.plot(comp_df['month'].astype(str), comp_df['high_share']*100, marker='s', label='High Revenue Share (%)')
plt.title('Overall Performance Score vs High Revenue Share')
plt.xticks(rotation=45)
plt.legend()
plt.tight_layout()
plt.savefig('performance_vs_share.png')
print("Saved plot to performance_vs_share.png")

conn.close()
''')
