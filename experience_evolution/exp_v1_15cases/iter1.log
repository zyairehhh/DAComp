import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo market data
geo_df = pd.read_sql_query("SELECT * FROM google_play__geo_market_analysis WHERE package_name = 'com.dev.photoeditor'", conn)

# Determine high and low revenue markets based on avg_transaction_value
threshold = 30  # median approximate
geo_df['revenue_group'] = np.where(geo_df['avg_transaction_value'] > threshold, 'high', 'low')

print("Group counts:")
print(geo_df.groupby('revenue_group').size())
print()

print("Average metrics by revenue group:")
group_avg = geo_df.groupby('revenue_group')[['avg_transaction_value', 'average_revenue_per_user', 'overall_market_score', 'app_quality_score', 'daily_churn_rate', 'day_30_retention_rate', 'weekly_growth_rate', 'store_conversion_rate']].mean()
print(group_avg)
print()

print("High revenue markets:")
print(geo_df[geo_df['revenue_group'] == 'high'][['country_name', 'avg_transaction_value', 'average_revenue_per_user']])
print()
print("Low revenue markets:")
print(geo_df[geo_df['revenue_group'] == 'low'][['country_name', 'avg_transaction_value', 'average_revenue_per_user']])

# Load comprehensive dashboard data to see performance trend over time
comp_df = pd.read_sql_query("SELECT * FROM google_play__comprehensive_performance_dashboard WHERE package_name = 'com.dev.photoeditor' ORDER BY date_day", conn)
print("\nPerformance score trend:")
print(comp_df[['date_day', 'overall_performance_score']])

# Possibly compute region-specific trends from finance_report (daily revenue per country)
finance_df = pd.read_sql_query("SELECT country_long, region, date_day, net_amount, transactions FROM google_play__finance_report WHERE package_name = 'com.dev.photoeditor'", conn)
finance_df['date_day'] = pd.to_datetime(finance_df['date_day'])
finance_df['month'] = finance_df['date_day'].dt.to_period('M')
# Aggregate monthly per region
monthly_region = finance_df.groupby(['region', 'month']).agg({'net_amount': 'sum', 'transactions': 'sum'}).reset_index()
print("\nSample monthly revenue by region:")
print(monthly_region.head())

# Let's see if the drop in overall_performance_score correlates with performance in low revenue markets
# However we lack region-level performance score over time; we have only snapshot.
# We may need to infer from other metrics.

conn.close()
```
