import sqlite3, re, json

conn = sqlite3.connect('dacomp-081.sqlite')
cursor = conn.cursor()
cursor.execute("SELECT embedded_data FROM qualtrics__response WHERE embedded_data IS NOT NULL")
custom_fields = {}
value_counts = {}
for row in cursor:
    ed = row[0]
    # pattern: {custom_field_xxx:value_yyy, ...}
    matches = re.findall(r'custom_field_(\d+):value_(\d+)', ed)
    for cf, val in matches:
        custom_fields[cf] = custom_fields.get(cf, 0) + 1
        value_counts[val] = value_counts.get(val, 0) + 1

print("Top custom_field IDs by frequency:")
for cf, cnt in sorted(custom_fields.items(), key=lambda x: -x[1])[:20]:
    print(f"{cf}: {cnt}")
print("\nTop value IDs by frequency:")
for val, cnt in sorted(value_counts.items(), key=lambda x: -x[1])[:20]:
    print(f"{val}: {cnt}")
conn.close()
```
