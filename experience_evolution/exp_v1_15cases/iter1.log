promo_df = promo_df.dropna(subset=['begin_time', 'end_time'])

# For simplicity, we could aggregate sales by sku_id and compute total sales during promotion periods.
# But that's complex; we'll compute average discount depth vs total sales per category.

# Let's group by Level 1 Category and compute average discount depth and total sale_count
category_stats = promo_df.groupby(['Level 1 Category ID', 'Level 1 Category Name']).agg(
    avg_discount_depth=('discount_depth', 'mean'),
    total_promo_sales=('sale_count', 'sum'),
    promo_count=('sku_id', 'count')
).reset_index()

print(category_stats.head())

# Plot 1: Bar chart of avg discount depth by category
plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['avg_discount_depth'])
plt.title('Average Discount Depth by Level 1 Category')
plt.xlabel('Category')
plt.ylabel('Average Discount Depth')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('avg_discount_depth_by_category.png')
plt.close()

# Plot 2: Scatter of avg discount depth vs total promo sales
plt.figure(figsize=(8,6))
plt.scatter(category_stats['avg_discount_depth'], category_stats['total_promo_sales'])
plt.title('Discount Depth vs Promotion Sales by Category')
plt.xlabel('Average Discount Depth')
plt.ylabel('Total Promotion Sales')
# Annotate points with category name
for i, row in category_stats.iterrows():
    plt.text(row['avg_discount_depth'], row['total_promo_sales'], str(row['Level 1 Category ID']), fontsize=9)
plt.tight_layout()
plt.savefig('discount_depth_vs_promo_sales.png')
plt.close()

# Plot 3: Bar chart of promotion count by category
plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['promo_count'])
plt.title('Number of Promotions by Level 1 Category')
plt.xlabel('Category')
plt.ylabel('Promotion Count')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('promotion_count_by_category.png')
plt.close()

# Compute effectiveness: sales per discount depth? We'll compute ratio
category_stats['sales_per_discount'] = category_stats['total_promo_sales'] / category_stats['avg_discount_depth']
category_stats = category_stats.sort_values('sales_per_discount', ascending=False)

plt.figure(figsize=(10,6))
plt.bar(category_stats['Level 1 Category Name'], category_stats['sales_per_discount'])
plt.title('Promotion Effectiveness (Sales per Discount Depth) by Category')
plt.xlabel('Category')
plt.ylabel('Sales per Discount Depth')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('promotion_effectiveness_by_category.png')
plt.close()

conn.close()
''')
