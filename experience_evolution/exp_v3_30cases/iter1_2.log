'''
import sqlite3
import pandas as pd
import numpy as np
import re
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-100.sqlite')
# Companies and tags
companies = pd.read_sql_query('''SELECT company_id, company_name, all_company_tags FROM intercom__company_enhanced''', conn)

def parse_tags(tag_str):
    if not isinstance(tag_str, str):
        return {}
    parts = tag_str.split('|')
    tags = {}
    for part in parts:
        if '=' in part:
            key, value = part.split('=', 1)
            tags[key] = value
    return tags

company_tags = companies['all_company_tags'].apply(parse_tags)
companies['renewal_date'] = pd.to_datetime(company_tags.apply(lambda x: x.get('renewal_date')), errors='coerce')
companies['renewal_window'] = company_tags.apply(lambda x: x.get('renewal_window'))
companies['sentiment_trend'] = company_tags.apply(lambda x: x.get('sentiment_trend'))
companies['feature_adoption'] = company_tags.apply(lambda x: x.get('feature_adoption'))
companies['contract_size'] = company_tags.apply(lambda x: x.get('contract_size'))
companies['industry'] = company_tags.apply(lambda x: x.get('industry'))
companies['health_score'] = pd.to_numeric(company_tags.apply(lambda x: x.get('health_score')), errors='coerce')
companies['expansion_signal'] = company_tags.apply(lambda x: x.get('expansion_signal'))

# Load company metrics
comp_metrics = pd.read_sql_query('''SELECT company_id, total_conversations, p50_time_to_last_close_min, p50_reopens FROM intercom__company_metrics''', conn)

# Load conversation sentiment aggregated per company
conv = pd.read_sql_query('''SELECT all_contact_company_names, all_conversation_tags FROM intercom__conversation_enhanced''', conn)
conv['company_name'] = conv['all_contact_company_names']
company_name_to_id = dict(zip(companies['company_name'], companies['company_id']))
conv['company_id'] = conv['company_name'].map(company_name_to_id)

def sentiment_from_tag(tag_str):
    if not isinstance(tag_str, str):
        return None
    for part in tag_str.split('|'):
        if part.startswith('sentiment='):
            return part.split('=')[1]
    return None

conv['sentiment'] = conv['all_conversation_tags'].apply(sentiment_from_tag)
negative_list = {'risk_mitigation', 'cautious_watch', 'escalation'}
conv['is_negative'] = conv['sentiment'].apply(lambda x: x in negative_list if x else False)

# Compute negative sentiment proportion per company
sentiment_agg = conv.groupby('company_id').agg(
    total_conv=('sentiment', 'size'),
    negative_conv=('is_negative', 'sum')
).reset_index()
sentiment_agg['neg_proportion'] = sentiment_agg['negative_conv'] / sentiment_agg['total_conv']

# Merge data
companies = companies.merge(comp_metrics, on='company_id', how='left')
companies = companies.merge(sentiment_agg[['company_id', 'neg_proportion', 'total_conv']], on='company_id', how='left')
companies['neg_proportion'] = companies['neg_proportion'].fillna(0)
companies['total_conv'] = companies['total_conv'].fillna(0)

# Feature adoption coverage
def extract_coverage(feat_str):
    if isinstance(feat_str, str):
        match = re.search(r'(\d+)%', feat_str)
        if match:
            return float(match.group(1)) / 100.0
    return np.nan
companies['feature_adoption_coverage'] = companies['feature_adoption'].apply(extract_coverage)

# Target companies
target = companies[companies['renewal_window'] == 'inside_90_days'].copy()
target['label'] = target['sentiment_trend'].apply(lambda x: 1 if x == 'at-risk' else 0)

print(f"Target count: {len(target)}")
print(f"Label distribution: {target['label'].value_counts()}")

# Display columns
print(target[['company_id', 'total_conv', 'neg_proportion', 'p50_time_to_last_close_min', 'p50_reopens', 'feature_adoption_coverage', 'sentiment_trend', 'label', 'industry', 'contract_size']].head())

# Compute discriminative power
def auc_for_feature(y_true, y_score):
    # sort descending
    order = np.argsort(y_score)[::-1]
    y_true_sorted = y_true.iloc[order]
    n_pos = (y_true_sorted == 1).sum()
    n_neg = (y_true_sorted == 0).sum()
    if n_pos == 0 or n_neg == 0:
        return np.nan
    ranks = np.arange(1, len(y_true_sorted) + 1)
    sum_ranks_pos = np.sum(ranks[y_true_sorted == 1])
    auc = (sum_ranks_pos - n_pos * (n_pos + 1) / 2) / (n_pos * n_neg)
    return auc

features = ['total_conv', 'neg_proportion', 'p50_time_to_last_close_min', 'p50_reopens', 'feature_adoption_coverage']
for feat in features:
    df = target[[feat, 'label']].dropna()
    if len(df) > 0:
        auc = auc_for_feature(df['label'], df[feat])
        print(f"{feat}: AUC = {auc:.3f} (n={len(df)})")
    else:
        print(f"{feat}: No data")

# Median split differences
for feat in features:
    df = target[[feat, 'label']].dropna()
    if len(df) == 0:
        continue
    med = df[feat].median()
    high = df[df[feat] > med]['label'].mean()
    low = df[df[feat] <= med]['label'].mean()
    print(f"{feat}: median split - high risk prop {high:.3f}, low {low:.3f}, diff {high - low:.3f}")

# Segmentation by industry and contract size
print("\n--- Segmentation by industry & contract size ---")
for ind in target['industry'].dropna().unique():
    for size in target['contract_size'].dropna().unique():
        sub = target[(target['industry'] == ind) & (target['contract_size'] == size)]
        if len(sub) > 5:
            neg_mean = sub['neg_proportion'].mean()
            reopen_mean = sub['p50_reopens'].mean()
            adopt_mean = sub['feature_adoption_coverage'].mean()
            label_prop = sub['label'].mean()
            print(f"{ind}, {size}: n={len(sub)}, at-risk%={label_prop:.3f}, neg_prop={neg_mean:.3f}, reopen={reopen_mean:.3f}, adopt={adopt_mean:.3f}")

# Save features
target.to_csv('target_features_full.csv', index=False)
''')
