Action: CreateFile(filepath='product_level_analysis.py':
'''
import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-017.sqlite')
query = '''
SELECT 
    "Product",
    strftime('%Y-%m', "Order Date") as month,
    SUM(profit) as total_profit,
    SUM(Sales) as total_sales,
    AVG("Discount") as avg_discount,
    AVG("Shipping Cost") as avg_shipping_cost,
    "Shipping Method",
    "Order Priority"
FROM order_information 
WHERE "Product Category" = 'Home & Furniture'
GROUP BY "Product", month
ORDER BY "Product", month
'''
df = pd.read_sql_query(query, conn)
conn.close()

# Compute margin
df['profit_margin'] = df['total_profit'] / df['total_sales']

# For each product, compute standard deviation of margin across months (volatility)
product_volatility = df.groupby('Product')['profit_margin'].agg(['mean','std','count']).sort_values('std', ascending=False)
print("Products with highest margin volatility (std):")
print(product_volatility.head(20))

# Look at top volatile product
top_product = product_volatility.index[0]
print(f"\nTop volatile product: {top_product}")
product_data = df[df['Product'] == top_product].sort_values('month')
print(product_data[['month','profit_margin','avg_discount','avg_shipping_cost','Shipping Method','Order Priority']].head(20))

# Also get product browsing data for this product
conn = sqlite3.connect('dacomp-017.sqlite')
browsing_query = '''
SELECT * FROM product_browsing WHERE "Product Category" = 'Home & Furniture' AND Product = ?
'''
browsing = pd.read_sql_query(browsing_query, conn, params=(top_product,))
conn.close()
print(f"\nProduct browsing data for {top_product}:")
print(browsing.describe())
if not browsing.empty:
    print(f"Number of browsing records: {len(browsing)}")
    print(f"Average browsing time: {browsing['Browsing Time (minutes)'].mean():.2f} minutes")
    print(f"Total likes: {browsing['like'].sum()}, shares: {browsing['share'].sum()}, add to cart: {browsing['Add to Cart'].sum()}")
''')
