print("Normal customers count:", normal.shape[0])

for col in ['customer_lifespan_days', 'total_invoices', 'avg_invoice_amount']:
    print(f"\n--- {col} ---")
    print("High-risk: mean = {:.2f}, median = {:.2f}, std = {:.2f}, min = {:.2f}, max = {:.2f}".format(
        high_risk[col].mean(), high_risk[col].median(), high_risk[col].std(), high_risk[col].min(), high_risk[col].max()
    ))
    print("Normal: mean = {:.2f}, median = {:.2f}, std = {:.2f}, min = {:.2f}, max = {:.2f}".format(
        normal[col].mean(), normal[col].median(), normal[col].std(), normal[col].min(), normal[col].max()
    ))
''')
