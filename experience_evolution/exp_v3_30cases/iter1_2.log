df['health_score'] = df['cost_efficiency_score']*0.4 + df['conv_quality_score']*0.35 + df['competitiveness_score']*0.25

# Now we have scores. We'll produce some plots.

# Plot 1: Distribution of health scores for high-cost low-ROI campaigns vs others
high_risk = df[df['high_cost_low_roi']]
other = df[~df['high_cost_low_roi']]

plt.figure(figsize=(10,6))
plt.hist(high_risk['health_score'], bins=30, alpha=0.5, label='High-cost Low-ROI', color='red')
plt.hist(other['health_score'], bins=30, alpha=0.5, label='Other', color='green')
plt.xlabel('Health Score')
plt.ylabel('Frequency')
plt.title('Health Score Distribution: High-cost Low-ROI vs Others')
plt.legend()
plt.savefig('/workspace/health_score_dist.png', dpi=300)
plt.close()

# Plot 2: Health score breakdown by campaign_type
campaign_type_scores = df.groupby('campaign_type').agg({'health_score':'mean', 'cost':'sum', 'roi':'mean'}).reset_index()
campaign_type_scores = campaign_type_scores.sort_values('health_score', ascending=False)

plt.figure(figsize=(10,6))
plt.bar(campaign_type_scores['campaign_type'], campaign_type_scores['health_score'], color='skyblue')
plt.xlabel('Campaign Type')
plt.ylabel('Average Health Score')
plt.title('Average Health Score by Campaign Type')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/health_by_campaign_type.png', dpi=300)
plt.close()

# Plot 3: Health score breakdown by bidding_strategy
bid_scores = df.groupby('bidding_strategy').agg({'health_score':'mean', 'cost':'sum', 'roi':'mean'}).reset_index()
bid_scores = bid_scores.sort_values('health_score', ascending=False)

plt.figure(figsize=(10,6))
plt.bar(bid_scores['bidding_strategy'], bid_scores['health_score'], color='lightcoral')
plt.xlabel('Bidding Strategy')
plt.ylabel('Average Health Score')
plt.title('Average Health Score by Bidding Strategy')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/health_by_bidding.png', dpi=300)
plt.close()

# Plot 4: Health score by industry
industry_scores = df.groupby('industry').agg({'health_score':'mean', 'cost':'sum', 'roi':'mean'}).reset_index()
industry_scores = industry_scores.sort_values('health_score', ascending=False)

plt.figure(figsize=(12,6))
plt.bar(industry_scores['industry'], industry_scores['health_score'], color='orange')
plt.xlabel('Industry')
plt.ylabel('Average Health Score')
plt.title('Average Health Score by Industry')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/health_by_industry.png', dpi=300)
plt.close()

# Plot 5: Trend over months (aggregate across all high-risk campaigns)
df['year_month'] = pd.to_datetime(df['year_month'], format='%Y-%m')
high_risk_by_month = high_risk.groupby('year_month').agg({'health_score':'mean', 'cost':'sum', 'roi':'mean'}).reset_index()
high_risk_by_month = high_risk_by_month.sort_values('year_month')

plt.figure(figsize=(12,6))
plt.plot(high_risk_by_month['year_month'], high_risk_by_month['health_score'], marker='o', color='red', label='Health Score')
plt.xlabel('Month')
plt.ylabel('Average Health Score')
plt.title('Trend of Average Health Score for High-risk Campaigns Over Time')
plt.xticks(rotation=45)
plt.grid(True)
plt.tight_layout()
plt.savefig('/workspace/health_trend_high_risk.png', dpi=300)
plt.close()

print("Plots saved.")
conn.close()
''')
