import pandas as pd
import sqlite3

conn = sqlite3.connect('data.sqlite')

# Get performance data with revenue category
performance_df = pd.read_sql_query("""
    SELECT a.region, a.date, a.overall_performance_score, r.revenue_metric
    FROM app_performance a
    LEFT JOIN revenue_metrics r ON a.app_id = r.app_id AND a.region = r.region AND a.date = r.date
    WHERE a.app_id = 'com.dev.photoeditor' 
        AND a.date >= '2024-01-01' 
        AND a.date <= '2024-12-01'
""", conn)

# Compute average revenue per region over period
avg_revenue = performance_df.groupby('region')['revenue_metric'].mean().reset_index()
avg_revenue['revenue_category'] = pd.cut(avg_revenue['revenue_metric'], 
                                         bins=[-float('inf'), 3, 7, float('inf')], 
                                         labels=['Low (<$3)', 'Medium ($3-$7)', 'High (>$7)'])

# Merge back
performance_df = performance_df.merge(avg_revenue[['region', 'revenue_category']], on='region', how='left')

# Monthly average per category
monthly_avg = performance_df.groupby(['date', 'revenue_category'])['overall_performance_score'].mean().reset_index()
pivot = monthly_avg.pivot(index='date', columns='revenue_category', values='overall_performance_score')

print("Monthly average performance score by revenue category:")
print(pivot)

# Compute month-over-month change
pivot_diff = pivot.diff()
print("\nMonth-over-month change in performance (difference):")
print(pivot_diff)

# Overall trend: slope per category (linear regression approximation)
from scipy import stats
trends = {}
for cat in pivot.columns:
    y = pivot[cat].dropna().values
    x = range(len(y))
    slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)
    trends[cat] = {'slope': slope, 'r_squared': r_value**2}
print("\nLinear trend (slope per month) - negative means decreasing:")
for cat, vals in trends.items():
    print(f"{cat}: slope = {vals['slope']:.3f}, R^2 = {vals['r_squared']:.3f}")

conn.close()
```

