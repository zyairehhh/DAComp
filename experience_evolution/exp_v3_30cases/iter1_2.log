import sqlite3
import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
import statsmodels.api as sm

conn = sqlite3.connect('dacomp-070.sqlite')

# Load data
ts = pd.read_sql_query("SELECT * FROM google_play__time_series_trends", conn)
country = pd.read_sql_query("SELECT * FROM google_play__country_report", conn)
device = pd.read_sql_query("SELECT * FROM google_play__device_report", conn)

# Convert date columns
ts['date_day'] = pd.to_datetime(ts['date_day'])
country['date_day'] = pd.to_datetime(country['date_day'])
device['date_day'] = pd.to_datetime(device['date_day'])

# Check date range
print("Time range:", ts['date_day'].min(), ts['date_day'].max())

# Compute region-level conversion rate (average across countries per region per date per package)
region_conv = country.groupby(['date_day', 'region', 'package_name'])['store_listing_conversion_rate'].mean().reset_index()

# Compute device brand
device['device_brand'] = device['device'].apply(lambda x: x.split()[0] if isinstance(x, str) else x)

# Merge with quality_score and crash_rate from time_series
merged = region_conv.merge(ts[['date_day', 'package_name', 'quality_score', 'crash_rate_per_1k', 'revenue_per_active_device', 'daily_installs', 'daily_revenue']], 
                           on=['date_day', 'package_name'], how='left')

# Compute revenue per install (RPI) as efficiency metric
merged['revenue_per_install'] = merged['daily_revenue'] / merged['daily_installs'].replace(0, np.nan)

# Add month offset (days since start)
merged['days_since_start'] = (merged['date_day'] - merged['date_day'].min()).dt.days

print("Region conversion head:")
print(merged.head())
print("\nUnique regions:", merged['region'].unique())

# 1. Analyze decay patterns of conversion rate over time per region and package
# Fit linear trend for each region-package combination
decay_results = []
for region in merged['region'].unique():
    for pkg in merged['package_name'].unique():
        subset = merged[(merged['region'] == region) & (merged['package_name'] == pkg)]
        if len(subset) < 10:
            continue
        # Linear regression of conversion_rate vs days_since_start
        X = subset[['days_since_start']]
        y = subset['store_listing_conversion_rate']
        model = LinearRegression().fit(X, y)
        decay_rate = model.coef_[0]
        intercept = model.intercept_
        # compute R-squared
        r2 = model.score(X, y)
        decay_results.append({
            'region': region,
            'package': pkg,
            'decay_rate': decay_rate,
            'intercept': intercept,
            'r_squared': r2,
            'start_conv': subset['store_listing_conversion_rate'].iloc[0],
            'end_conv': subset['store_listing_conversion_rate'].iloc[-1]
        })

decay_df = pd.DataFrame(decay_results)
print("\nDecay patterns (conversion rate over time):")
print(decay_df.sort_values('decay_rate').head(20))

# 2. Non-linear relationship between store_listing_conversion_rate and quality_score / crash_rate
# Use polynomial regression
X = merged[['quality_score', 'crash_rate_per_1k']].dropna()
y = merged.loc[X.index, 'store_listing_conversion_rate']

poly = PolynomialFeatures(degree=2, include_bias=False)
X_poly = poly.fit_transform(X)
poly_cols = ['quality_score', 'crash_rate_per_1k', 'quality_score^2', 'crash_rate_per_1k^2', 'quality_score*crash_rate_per_1k']
model_poly = LinearRegression().fit(X_poly, y)
print("\nNon-linear (quadratic) model coefficients:")
for col, coef in zip(poly_cols, model_poly.coef_):
    print(f"{col}: {coef:.6f}")
print(f"Intercept: {model_poly.intercept_:.6f}")
print(f"R-squared: {model_poly.score(X_poly, y):.4f}")

# 3. Multi-dimensional user value decay model: predict revenue_per_active_device
# Use features: conversion_rate, quality_score, crash_rate, region, days_since_start
# Encode region
region_dummies = pd.get_dummies(merged['region'], prefix='region', drop_first=True)
X_val = pd.concat([merged[['store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k', 'days_since_start']], region_dummies], axis=1).dropna()
y_val = merged.loc[X_val.index, 'revenue_per_active_device']
model_val = LinearRegression().fit(X_val, y_val)
print("\nUser value decay model (revenue per active device) coefficients:")
for col, coef in zip(X_val.columns, model_val.coef_):
    print(f"{col}: {coef:.6f}")
print(f"Intercept: {model_val.intercept_:.6f}")
print(f"R-squared: {model_val.score(X_val, y_val):.4f}")

# 4. Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
# Compute daily total update events per package
update_freq = device.groupby(['date_day', 'package_name'])['update_events'].sum().reset_index()
update_freq.rename(columns={'update_events': 'total_update_events'}, inplace=True)
# Aggregate country_report by date, package, region
country_agg = country.groupby(['date_day', 'package_name', 'region']).agg({
    'active_devices_last_30_days': 'sum',
    'rolling_total_average_rating': 'mean'
}).reset_index()
merged_update = country_agg.merge(update_freq, on=['date_day', 'package_name'], how='left')

# Model interaction with region
merged_update['region_code'] = pd.Categorical(merged_update['region']).codes
merged_update['interaction'] = merged_update['total_update_events'] * merged_update['region_code']

X_active = merged_update[['total_update_events', 'region_code', 'interaction']].dropna()
y_active = merged_update.loc[X_active.index, 'active_devices_last_30_days']
model_active = LinearRegression().fit(X_active, y_active)
print("\nUpdate frequency effect on active devices:")
print(f"Coefficients: total_update_events {model_active.coef_[0]:.6f}, region_code {model_active.coef_[1]:.6f}, interaction {model_active.coef_[2]:.6f}")
print(f"R-squared: {model_active.score(X_active, y_active):.4f}")

X_rating = merged_update[['total_update_events', 'region_code', 'interaction']].dropna()
y_rating = merged_update.loc[X_rating.index, 'rolling_total_average_rating']
model_rating = LinearRegression().fit(X_rating, y_rating)
print("\nUpdate frequency effect on rolling rating:")
print(f"Coefficients: total_update_events {model_rating.coef_[0]:.6f}, region_code {model_rating.coef_[1]:.6f}, interaction {model_rating.coef_[2]:.6f}")
print(f"R-squared: {model_rating.score(X_rating, y_rating):.4f}")

# Save key results to CSV for reference
decay_df.to_csv('decay_patterns.csv', index=False)
update_effect = pd.DataFrame({
    'metric': ['active_devices', 'rolling_rating'],
    'coef_update': [model_active.coef_[0], model_rating.coef_[0]],
    'coef_region': [model_active.coef_[1], model_rating.coef_[1]],
    'coef_interaction': [model_active.coef_[2], model_rating.coef_[2]],
    'r2': [model_active.score(X_active, y_active), model_rating.score(X_rating, y_rating)]
})
update_effect.to_csv('update_effects.csv', index=False)

conn.close()
```
