import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-035.sqlite')

# Query high+severe abnormal logins only
query = """
SELECT 
    u.Department,
    u.[User ID],
    a.[Anomaly Type],
    a.[Anomaly Features],
    a.[Risk Level],
    a.[Anomaly Score],
    a.[Confirmation Status]
FROM abnormal_logins_table a
LEFT JOIN login_records_table l ON a.[Login Record ID] = l.[Login Record ID]
LEFT JOIN user_information_table u ON l.[User ID] = u.[User ID]
WHERE u.Department IS NOT NULL 
    AND a.[Risk Level] IN ('High', 'Severe')
"""
df = pd.read_sql_query(query, conn)

# Get total users per department
user_counts = pd.read_sql_query("""
    SELECT Department, COUNT(DISTINCT [User ID]) as total_users
    FROM user_information_table
    GROUP BY Department
""", conn)

# Get total logins per department (high+severe count?) Stage1 uses total logins? They likely count total abnormal high+severe logins.
# Actually they have "Total Logins" column but that might be total number of login records (not just abnormal). Need to compute.
# Let's compute total logins per department (all logins) for rate.
total_logins_per_dept = pd.read_sql_query("""
    SELECT u.Department, COUNT(l.[Login Record ID]) as total_logins
    FROM login_records_table l
    LEFT JOIN user_information_table u ON l.[User ID] = u.[User ID]
    WHERE u.Department IS NOT NULL
    GROUP BY u.Department
""", conn)

conn.close()

# Compute metrics per department
dept_stats = df.groupby('Department').agg(
    high_severe_count=('Anomaly Score', 'count'),
    avg_score=('Anomaly Score', 'mean'),
    # count distinct users involved
    users_involved=('User ID', lambda x: x.nunique())
).reset_index()

# Merge with user counts and total logins
dept_stats = dept_stats.merge(user_counts, on='Department')
dept_stats = dept_stats.merge(total_logins_per_dept, on='Department')
# Compute rates
dept_stats['high_severe_rate'] = dept_stats['high_severe_count'] / dept_stats['total_logins'] * 100
dept_stats['user_involvement_rate'] = dept_stats['users_involved'] / dept_stats['total_users'] * 100

# Sort by high_severe_count descending
