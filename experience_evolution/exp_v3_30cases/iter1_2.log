Action: CreateFile(filepath='plot_team_size_vs_deviation.py':
'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Calculate overall correlation
corr_all = df['Team Size'].corr(df['Deviation'])

fig, ax = plt.subplots(figsize=(10, 7))
colors = {'Infrastructure': 'red', 'Software Development': 'blue', 'Marketing Promotion': 'green'}
for ptype, color in colors.items():
    subset = df[df['Project Type'] == ptype]
    ax.scatter(subset['Team Size'], subset['Deviation'],
               color=color, alpha=0.6, s=50, label=ptype)

# Add trend line for all data
z = np.polyfit(df['Team Size'], df['Deviation'], 1)
p = np.poly1d(z)
ax.plot(df['Team Size'], p(df['Team Size']), "k--", linewidth=2, label=f'Overall trend (r={corr_all:.3f})')

ax.set_xlabel('Team Size', fontsize=12)
ax.set_ylabel('Cost Deviation', fontsize=12)
ax.set_title('Cost Deviation vs Team Size (colored by Project Type)', fontsize=14, pad=15)
ax.legend()
ax.grid(True, alpha=0.3)

# Annotate overall correlation
ax.text(0.05, 0.95, f'Overall correlation = {corr_all:.3f}',
        transform=ax.transAxes, fontsize=11, verticalalignment='top',
        bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))

plt.tight_layout()
plt.savefig('team_size_vs_deviation.png', dpi=150)
print("Saved team_size_vs_deviation.png")
''')
