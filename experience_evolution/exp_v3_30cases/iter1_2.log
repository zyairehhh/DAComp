Action: LOCAL_DB_SQL(file_path="/workspace/dacomp-093.sqlite", command="WITH classified AS (
  SELECT 
    *,
    CASE 
      WHEN SUBJECT LIKE '%限时折扣%' THEN 'discount'
      WHEN SUBJECT LIKE '%新品上新%' THEN 'new'
      WHEN SUBJECT LIKE '%品牌故事%' THEN 'storytelling'
      ELSE 'other'
    END AS subject_keyword,
    CASE 
      WHEN SUBJECT LIKE '%工作日%' THEN 'weekday'
      WHEN SUBJECT LIKE '%周末%' THEN 'weekend'
      WHEN SUBJECT LIKE '%节前%' THEN 'holiday'
      ELSE 
        CASE 
          WHEN CAST(strftime('%w', scheduled_to_send_at) AS INTEGER) IN (0,6) THEN 'weekend'
          ELSE 'weekday'
        END
    END AS day_type,
    CASE 
      WHEN SUBJECT LIKE '%上午%' THEN 'morning'
      WHEN SUBJECT LIKE '%下午%' THEN 'afternoon'
      WHEN SUBJECT LIKE '%晚间%' THEN 'evening'
      ELSE 
        CASE 
          WHEN CAST(strftime('%H', scheduled_to_send_at) AS INTEGER) BETWEEN 6 AND 11 THEN 'morning'
          WHEN CAST(strftime('%H', scheduled_to_send_at) AS INTEGER) BETWEEN 12 AND 17 THEN 'afternoon'
          ELSE 'evening'
        END
    END AS time_of_day,
    (count_clicked_email / count_received_email) AS click_rate,
    email_open_rate AS open_rate,
    email_click_to_open_rate AS click_to_open_rate,
    (count_placed_order / count_received_email) AS conversion_rate,
    (gmv_net / NULLIF(count_received_email,0)) AS gmv_per_recipient
  FROM klaviyo__campaigns
  WHERE count_received_email BETWEEN 8752 AND 13834
)
SELECT 
  subject_keyword,
  COUNT(*) as campaign_count,
  AVG(total_count_unique_people) as avg_audience_size,
  AVG(open_rate) as avg_open_rate,
  AVG(click_rate) as avg_click_rate,
  AVG(click_to_open_rate) as avg_click_to_open,
  AVG(conversion_rate) as avg_conversion_rate,
  AVG(gmv_per_recipient) as avg_gmv_per_recipient,
  AVG(active_days) as avg_active_days
FROM classified
GROUP BY subject_keyword
ORDER BY avg_open_rate DESC;", output="direct")
