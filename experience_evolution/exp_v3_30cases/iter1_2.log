import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-035.sqlite')

# Query for detailed breakdown
query = """
SELECT 
    u.Department,
    a.[Anomaly Type],
    a.[Risk Level],
    a.[Anomaly Score],
    a.[Confirmation Status]
FROM abnormal_logins_table a
LEFT JOIN login_records_table l ON a.[Login Record ID] = l.[Login Record ID]
LEFT JOIN user_information_table u ON l.[User ID] = u.[User ID]
WHERE u.Department IS NOT NULL
"""
df = pd.read_sql_query(query, conn)
conn.close()

print("Total abnormal logins:", len(df))
print(df.head())

# Summary per department
summary = df.groupby('Department').agg(
    total_abnormal=('Anomaly Score', 'count'),
    avg_score=('Anomaly Score', 'mean'),
    severe_count=('Risk Level', lambda x: (x == 'Severe').sum()),
    medium_count=('Risk Level', lambda x: (x == 'Medium').sum()),
    low_count=('Risk Level', lambda x: (x == 'Low').sum()),
    pending_confirmation=('Confirmation Status', lambda x: (x == 'Pending confirmation').sum())
).reset_index()

# Add proportions
summary['severe_rate'] = summary['severe_count'] / summary['total_abnormal']
summary['pending_rate'] = summary['pending_confirmation'] / summary['total_abnormal']
summary = summary.sort_values('total_abnormal', ascending=False)
print("\nSummary by Department:")
print(summary)

# Plot 1: Total abnormal logins per department (bar)
plt.figure(figsize=(8,5))
bars = plt.bar(summary['Department'], summary['total_abnormal'], color='skyblue', edgecolor='navy')
plt.xlabel('Department')
plt.ylabel('Number of Abnormal Logins')
plt.title('Total Abnormal Logins per Department', fontsize=14)
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.5, f'{int(height)}', ha='center', va='bottom')
plt.xticks(rotation=15)
plt.tight_layout()
plt.savefig('total_abnormal_per_dept.png', dpi=300)
plt.close()

# Plot 2: Average anomaly score per department (bar)
plt.figure(figsize=(8,5))
bars2 = plt.bar(summary['Department'], summary['avg_score'], color='lightcoral', edgecolor='darkred')
plt.xlabel('Department')
plt.ylabel('Average Anomaly Score')
plt.title('Average Anomaly Score per Department (higher = riskier)', fontsize=14)
for bar in bars2:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.2, f'{height:.1f}', ha='center', va='bottom')
plt.xticks(rotation=15)
plt.tight_layout()
plt.savefig('avg_score_per_dept.png', dpi=300)
plt.close()

# Plot 3: Risk level composition (stacked)
risk_counts = summary[['Department', 'severe_count', 'medium_count', 'low_count']].set_index('Department')
risk_counts = risk_counts.loc[summary['Department']]  # keep order
plt.figure(figsize=(9,5))
bottom = np.zeros(len(risk_counts))
colors = ['#ff6b6b', '#ffd166', '#06d6a0']
for i, col in enumerate(['severe_count', 'medium_count', 'low_count']):
    plt.bar(risk_counts.index, risk_counts[col], bottom=bottom, label=col.replace('_count',''), color=colors[i])
    bottom += risk_counts[col].values
plt.ylabel('Count')
plt.title('Risk Level Composition per Department', fontsize=13)
plt.legend(title='Risk Level')
plt.xticks(rotation=15)
plt.tight_layout()
plt.savefig('risk_composition.png', dpi=300)
plt.close()

# Plot 4: Scatter of total abnormal vs severe rate
plt.figure(figsize=(8,6))
plt.scatter(summary['total_abnormal'], summary['severe_rate'], s=summary['avg_score']*15, alpha=0.7, c=summary['avg_score'], cmap='viridis')
plt.xlabel('Total Abnormal Logins')
plt.ylabel('Severe Risk Proportion')
plt.title('Department Risk Profile: Volume vs Severity (Bubble size = Avg Score)', fontsize=12)
for i, row in summary.iterrows():
    plt.annotate(row['Department'], (row['total_abnormal'], row['severe_rate']), fontsize=9, alpha=0.8)
plt.colorbar(label='Average Anomaly Score')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('volume_vs_severity.png', dpi=300)
plt.close()

print("Plots saved.")
```
