import matplotlib.pyplot as plt
import seaborn as sns

# Connect to database
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-078/stage1_env/dacomp-078.sqlite')

# Load visitor table
visitor_df = pd.read_sql_query("SELECT * FROM pendo__visitor;", conn)
print("Visitor shape:", visitor_df.shape)

# Compute percentiles for sum_minutes and sum_events
percentiles = [0.5, 0.6, 0.7, 0.8, 0.9, 0.95]
print("Percentiles for sum_minutes:")
print(visitor_df['sum_minutes'].quantile(percentiles))
print("Percentiles for sum_events:")
print(visitor_df['sum_events'].quantile(percentiles))

# Define high-value label: top 20% in both sum_minutes AND sum_events
threshold_minutes = visitor_df['sum_minutes'].quantile(0.8)
threshold_events = visitor_df['sum_events'].quantile(0.8)
visitor_df['high_value'] = (visitor_df['sum_minutes'] >= threshold_minutes) & (visitor_df['sum_events'] >= threshold_events)
print(f"High-value threshold minutes: {threshold_minutes}, events: {threshold_events}")
print(f"Number of high-value visitors: {visitor_df['high_value'].sum()} ({visitor_df['high_value'].mean()*100:.2f}%)")

# Check correlation with other dimensions
numeric_cols = ['sum_minutes', 'sum_events', 'latest_nps_rating', 'count_active_days', 
                'count_active_months', 'average_daily_minutes', 'average_daily_events']
corr = visitor_df[numeric_cols].corr()
print("Correlation matrix:")
print(corr)

# Load account-level features
account_df = pd.read_sql_query("SELECT * FROM pendo__account;", conn)
print("Account shape:", account_df.shape)

# Merge visitor with account metrics? Need to join on account_id.
# For each visitor, we can enrich with account-level aggregations.
# But we need to maintain visitor-level analysis.
# Let's compute per-account aggregates and join (optional)

# Compute per visitor feature diversity: number of distinct features used
feature_df = pd.read_sql_query("SELECT visitor_id, COUNT(DISTINCT feature_id) AS num_features, SUM(sum_clicks) AS total_clicks FROM pendo__visitor_feature GROUP BY visitor_id;", conn)
visitor_df = visitor_df.merge(feature_df, on='visitor_id', how='left')
visitor_df['num_features'] = visitor_df['num_features'].fillna(0)
visitor_df['total_clicks'] = visitor_df['total_clicks'].fillna(0)

# Compute recency: days since last_visit (assuming last_visit column is date)
visitor_df['last_visit'] = pd.to_datetime(visitor_df['last_visit'])
visitor_df['first_visit_at'] = pd.to_datetime(visitor_df['first_visit_at'])
visitor_df['recency_days'] = (pd.Timestamp.now() - visitor_df['last_visit']).dt.days
visitor_df['tenure_days'] = (visitor_df['last_visit'] - visitor_df['first_visit_at']).dt.days

# Compute regularity: coefficient of variation of daily minutes? Need daily metrics.
# We'll sample for now.
# Load daily metrics for a sample of visitors to compute variability
# But due to size, we can aggregate per visitor: compute std of sum_minutes across days.
# Let's compute using SQL: for each visitor, stddev of sum_minutes across days.
# Use SQLite's aggregation functions.

print("Visitor columns:", visitor_df.columns.tolist())

# Save high-value label for later analysis
visitor_df[['visitor_id', 'account_id', 'high_value', 'sum_minutes', 'sum_events', 'latest_nps_rating', 'num_features', 'total_clicks', 'recency_days', 'tenure_days']].to_csv('/workspace/visitor_highvalue.csv', index=False)

conn.close()
