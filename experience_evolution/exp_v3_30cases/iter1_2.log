import sqlite3
import pandas as pd
import numpy as np
import os

DB_PATH = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-076/stage1_env/dacomp-076.sqlite"

def load_data():
    conn = sqlite3.connect(DB_PATH)
    df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
    conn.close()
    return df

def compute_segment_stats(df):
    segment_stats = df.groupby('profitability_segment')['retention_probability'].agg(['mean', 'std', 'count']).reset_index()
    segment_stats.rename(columns={'mean': 'segment_retention_mean'}, inplace=True)
    return segment_stats

def flag_anomalies(df, segment_stats):
    df = df.merge(segment_stats[['profitability_segment', 'segment_retention_mean']], on='profitability_segment', how='left')
    df['retention_diff'] = df['retention_probability'] - df['segment_retention_mean']
    df['abs_diff'] = abs(df['retention_diff'])
    df['is_anomaly'] = df['abs_diff'] > 0.15
    return df

def main():
    df = load_data()
    print(f"Total customers: {len(df)}")
    print(f"Profitability segments: {df['profitability_segment'].unique()}")
    
    segment_stats = compute_segment_stats(df)
    print("\nSegment retention statistics:")
    print(segment_stats)
    
    df = flag_anomalies(df, segment_stats)
    anomaly_count = df['is_anomaly'].sum()
    print(f"\nAnomaly customers (diff > 0.15): {anomaly_count} ({anomaly_count/len(df)*100:.1f}%)")
    
    # Save anomalies to CSV for further inspection
    df.to_csv('/workspace/full_data_with_anomaly_flag.csv', index=False)
    
    # Analyze characteristics of anomalies vs non-anomalies
    anomaly_df = df[df['is_anomaly']]
    normal_df = df[~df['is_anomaly']]
    
    print("\n--- Comparison of Anomaly vs Normal Customers ---")
    numeric_cols = ['total_revenue', 'net_profit', 'transaction_count', 'avg_transactions_per_month',
                    'comprehensive_customer_score', 'transaction_value_volatility', 'customer_age_days',
                    'q1_transactions', 'q2_transactions', 'q3_transactions', 'q4_transactions']
    
    for col in numeric_cols:
        if col in df.columns:
            a_mean = anomaly_df[col].mean()
            n_mean = normal_df[col].mean()
            print(f"{col}: anomaly mean={a_mean:.2f}, normal mean={n_mean:.2f}, diff={a_mean - n_mean:.2f}")
    
    # Categorical columns
    cat_cols = ['profitability_segment', 'value_tier', 'lifecycle_stage', 'activity_status',
                'retention_category', 'seasonal_preference', 'transaction_consistency',
                'growth_potential', 'recommended_action', 'engagement_frequency']
    for col in cat_cols:
        if col in df.columns:
            print(f"\n{col} distribution in anomalies:")
            print(anomaly_df[col].value_counts(normalize=True).head())
    
    # Compute seasonal balance: proportion of transactions per quarter
    total_q = anomaly_df[['q1_transactions','q2_transactions','q3_transactions','q4_transactions']].sum(axis=1)
    anomaly_df['total_q_trans'] = total_q
    # Avoid division by zero
    anomaly_df['q1_ratio'] = anomaly_df['q1_transactions'] / np.where(total_q==0, 1, total_q)
    anomaly_df['q2_ratio'] = anomaly_df['q2_transactions'] / np.where(total_q==0, 1, total_q)
    anomaly_df['q3_ratio'] = anomaly_df['q3_transactions'] / np.where(total_q==0, 1, total_q)
    anomaly_df['q4_ratio'] = anomaly_df['q4_transactions'] / np.where(total_q==0, 1, total_q)
    
    print("\nSeasonal ratios for anomalies (mean):")
    print(f"Q1: {anomaly_df['q1_ratio'].mean():.3f}, Q2: {anomaly_df['q2_ratio'].mean():.3f}, Q3: {anomaly_df['q3_ratio'].mean():.3f}, Q4: {anomaly_df['q4_ratio'].mean():.3f}")
    
    # Consistency between transaction_count and avg_transactions_per_month
    # avg_transactions_per_month * (customer_age_days/30) should approximate transaction_count
    anomaly_df['estimated_transactions'] = anomaly_df['avg_transactions_per_month'] * (anomaly_df['customer_age_days'] / 30.0)
    anomaly_df['trans_discrepancy'] = anomaly_df['transaction_count'] - anomaly_df['estimated_transactions']
    print(f"\nTransaction discrepancy mean for anomalies: {anomaly_df['trans_discrepancy'].mean():.2f}")
    
    # Alignment between comprehensive_customer_score and total_revenue
    # Compute correlation maybe
    corr = anomaly_df[['comprehensive_customer_score', 'total_revenue']].corr().iloc[0,1]
    print(f"Correlation between score and revenue for anomalies: {corr:.3f}")
    
    # Save anomaly subset
    anomaly_df.to_csv('/workspace/anomaly_customers.csv', index=False)
    
    print("\nAnalysis done.")

if __name__ == '__main__':
    main()
