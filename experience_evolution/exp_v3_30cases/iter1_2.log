import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-005.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# compute threshold
avg_margin = df['Profit Margin'].mean()
threshold = avg_margin * 0.5
df['low_margin'] = df['Profit Margin'] < threshold

print(f"Average profit margin: {avg_margin:.4f}")
print(f"Threshold (50% of avg): {threshold:.4f}")
print(f"Low-margin orders: {df['low_margin'].sum()} out of {len(df)} ({df['low_margin'].mean()*100:.2f}%)")

# compare segments
segments = df.groupby('low_margin')
summary = segments.agg({
    'Sales Quantity': ['mean', 'median', 'std', 'count'],
    'Total Logistics Revenue': ['mean', 'median', 'std'],
    'Discount Amount': ['mean', 'median', 'std'],
    'Freight Cost': ['mean', 'median', 'std'],
    'Warehousing Cost': ['mean', 'median', 'std'],
    'Other Operating Costs': ['mean', 'median', 'std'],
    'Profit': ['mean', 'median', 'std'],
    'Profit Margin': ['mean', 'median', 'std']
})
print(summary)

# categorical breakdowns
print("\n=== Destination low-margin rate (top 10) ===")
dest_counts = df.groupby('Destination').apply(lambda g: pd.Series({
    'total': len(g),
    'low_margin': g['low_margin'].sum(),
    'low_margin_rate': g['low_margin'].mean()
})).reset_index().sort_values('low_margin_rate', ascending=False)
print(dest_counts.head(10))

print("\n=== Age Range low-margin rate ===")
age_counts = df.groupby('Age Range').apply(lambda g: pd.Series({
    'total': len(g),
    'low_margin': g['low_margin'].sum(),
    'low_margin_rate': g['low_margin'].mean()
})).reset_index().sort_values('low_margin_rate', ascending=False)
print(age_counts)

print("\n=== Product low-margin rate ===")
product_counts = df.groupby('Consigned Product').apply(lambda g: pd.Series({
    'total': len(g),
    'low_margin': g['low_margin'].sum(),
    'low_margin_rate': g['low_margin'].mean()
})).reset_index().sort_values('low_margin_rate', ascending=False)
print(product_counts)

# time trends
df['month'] = pd.to_datetime(df['Date']).dt.to_period('M')
month_counts = df.groupby('month').apply(lambda g: pd.Series({
    'total': len(g),
    'low_margin': g['low_margin'].sum(),
    'low_margin_rate': g['low_margin'].mean()
})).reset_index().sort_values('month')
print("\n=== Monthly low-margin rate ===")
print(month_counts)

# compute correlation between Profit Margin and other numeric variables
numeric_cols = ['Sales Quantity', 'Total Logistics Revenue', 'Discount Amount',
                'Freight Cost', 'Warehousing Cost', 'Other Operating Costs',
                'Profit']
correlations = df[numeric_cols + ['Profit Margin']].corr()['Profit Margin'].sort_values(ascending=False)
print("\n=== Correlation with Profit Margin ===")
print(correlations)
