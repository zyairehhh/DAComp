```
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-089.sqlite')

# Load accounts with revenue
accounts = pd.read_sql_query("""
    SELECT account_id, account_name, annual_revenue, number_of_employees,
           total_contacts, industry_normalized, account_size_segment,
           company_size_category, geographic_region
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL
      AND number_of_employees > 0
""", conn)

print(f"Accounts with revenue and employees: {len(accounts)}")

# Compute top 20% revenue threshold
threshold = accounts['annual_revenue'].quantile(0.8)
print(f"80th percentile revenue: {threshold}")

# Top accounts
top_accounts = accounts[accounts['annual_revenue'] >= threshold].copy()
print(f"Top 20% accounts count: {len(top_accounts)}")

# Load contacts for those accounts
account_ids = top_accounts['account_id'].tolist()
placeholders = ','.join(['?'] * len(account_ids))
contacts = pd.read_sql_query(f"""
    SELECT account_id, contact_id, title, department
    FROM salesforce__contact_enhanced
    WHERE account_id IN ({placeholders})
""", conn, params=account_ids)

print(f"Contacts in top accounts: {len(contacts)}")

# Compute decision-maker flag
contacts['is_decision_maker'] = contacts['title'].fillna('').str.contains('Chief', case=False, na=False)

# Aggregate per account
dm_counts = contacts.groupby('account_id').agg(
    decision_makers=('is_decision_maker', 'sum'),
    total_contacts_agg=('contact_id', 'count')
).reset_index()

# Merge with top_accounts
top_accounts = top_accounts.merge(dm_counts, on='account_id', how='left')
top_accounts['decision_makers'] = top_accounts['decision_makers'].fillna(0)
top_accounts['total_contacts_agg'] = top_accounts['total_contacts_agg'].fillna(0)

# Contact Density Ratio: use total_contacts from account table (already includes all contacts)
top_accounts['contact_density_ratio'] = (
    top_accounts['total_contacts'] / top_accounts['number_of_employees'] * 1000
)

# Decision-Maker Ratio
top_accounts['decision_maker_ratio'] = (
    top_accounts['decision_makers'] / top_accounts['total_contacts_agg'].replace(0, np.nan) * 100
)
top_accounts['decision_maker_ratio'] = top_accounts['decision_maker_ratio'].fillna(0)

# Departmental Coverage Completeness: count distinct key departments
key_departments = ['Sales', 'Finance', 'Operations', 'IT', 'HR']
# For each account, get distinct departments from contacts
dept_counts = contacts.groupby('account_id')['department'].apply(
    lambda x: x.dropna().unique()
).reset_index(name='dept_list')
dept_counts['covered'] = dept_counts['dept_list'].apply(
    lambda arr: sum(1 for dept in arr if dept in key_departments)
)
dept_counts = dept_counts[['account_id', 'covered']]
top_accounts = top_accounts.merge(dept_counts, on='account_id', how='left')
top_accounts['covered'] = top_accounts['covered'].fillna(0)
top_accounts['coverage_completeness'] = top_accounts['covered'] / len(key_departments) * 100

# Show some results
print("\nSample top accounts metrics:")
print(top_accounts[['account_name', 'contact_density_ratio', 'decision_maker_ratio', 'coverage_completeness']].head(20))

# Calculate risk flags
top_accounts['density_risk'] = top_accounts['contact_density_ratio'] < 5
top_accounts['decision_maker_risk'] = top_accounts['decision_maker_ratio'] < 15
top_accounts['coverage_risk'] = top_accounts['coverage_completeness'] < 100

top_accounts['total_risks'] = top_accounts[['density_risk', 'decision_maker_risk', 'coverage_risk']].sum(axis=1)

risk_summary = top_accounts['total_risks'].value_counts().sort_index()
print("\nRisk Count Distribution:")
print(risk_summary)

# Identify high-risk accounts (2 or 3 risks)
high_risk = top_accounts[top_accounts['total_risks'] >= 2]
print(f"\nHigh-risk accounts (>=2 risks): {len(high_risk)}")

# Save to CSV for inspection
top_accounts.to_csv('top_accounts_analysis.csv', index=False)
print("Saved top_accounts_analysis.csv")

conn.close()
