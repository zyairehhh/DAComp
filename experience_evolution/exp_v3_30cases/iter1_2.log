'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import matplotlib

# Set style
plt.style.use('default')
matplotlib.rcParams['font.size'] = 10

# Connect to the database
conn = sqlite3.connect('dacomp-078.sqlite')

# Load account data
account_df = pd.read_sql_query("SELECT * FROM pendo__account", conn)
conn.close()

# 1. Plot 1: Current 2D model - sum_minutes vs sum_events with potential segmentation
plt.figure(figsize=(10, 8))
scatter = plt.scatter(account_df['sum_minutes'], account_df['sum_events'], 
                     c=account_df['avg_nps_rating'], cmap='viridis', 
                     alpha=0.6, s=50)
plt.colorbar(scatter, label='Average NPS Rating')
plt.xlabel('Total Usage Duration (minutes)')
plt.ylabel('Total Events Count')
plt.title('Current 2D Model: Usage Duration vs Frequency')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('duration_vs_frequency_2d.png', dpi=300)
plt.close()

# 2. Plot 2: Distribution of engagement metrics
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Duration distribution
axes[0, 0].hist(account_df['sum_minutes'], bins=50, edgecolor='black', alpha=0.7)
axes[0, 0].set_xlabel('Total Usage Duration (minutes)')
axes[0, 0].set_ylabel('Frequency')
axes[0, 0].set_title('Distribution of Usage Duration')
axes[0, 0].grid(True, alpha=0.3)

# Events distribution
axes[0, 1].hist(account_df['sum_events'], bins=50, edgecolor='black', alpha=0.7)
axes[0, 1].set_xlabel('Total Events Count')
axes[0, 1].set_ylabel('Frequency')
axes[0, 1].set_title('Distribution of Event Frequency')
axes[0, 1].grid(True, alpha=0.3)

# Active days distribution
axes[1, 0].hist(account_df['count_active_days'], bins=50, edgecolor='black', alpha=0.7)
axes[1, 0].set_xlabel('Active Days Count')
axes[1, 0].set_ylabel('Frequency')
axes[1, 0].set_title('Distribution of Active Days')
axes[1, 0].grid(True, alpha=0.3)

# NPS distribution (filter out nulls)
nps_data = account_df['avg_nps_rating'].dropna()
axes[1, 1].hist(nps_data, bins=20, edgecolor='black', alpha=0.7)
axes[1, 1].set_xlabel('Average NPS Rating')
axes[1, 1].set_ylabel('Frequency')
axes[1, 1].set_title('Distribution of NPS Ratings')
axes[1, 1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('engagement_distributions.png', dpi=300)
plt.close()

# 3. Plot 3: Correlation heatmap of potential dimensions
# Select relevant features for multi-dimensional analysis
features = ['sum_minutes', 'sum_events', 'count_active_days', 
            'count_active_months', 'avg_nps_rating', 
            'count_associated_visitors', 'count_feature_clicking_visitors',
            'average_daily_minutes', 'average_daily_events']

corr_df = account_df[features].corr()

plt.figure(figsize=(10, 8))
mask = np.triu(np.ones_like(corr_df, dtype=bool))
sns.heatmap(corr_df, mask=mask, annot=True, fmt='.2f', cmap='coolwarm',
            center=0, square=True, linewidths=0.5,
            cbar_kws={"shrink": 0.8})
plt.title('Correlation Matrix of Potential Value Assessment Dimensions')
plt.tight_layout()
plt.savefig('correlation_matrix.png', dpi=300)
plt.close()

# 4. Plot 4: 3D visualization (2 current dimensions + NPS as third)
from mpl_toolkits.mplot3d import Axes3D

fig = plt.figure(figsize=(12, 9))
ax = fig.add_subplot(111, projection='3d')

# Create a sample of 300 points for readability
sample_df = account_df.sample(n=300, random_state=42)

scatter = ax.scatter(sample_df['sum_minutes'], 
                     sample_df['sum_events'], 
                     sample_df['avg_nps_rating'].fillna(5),  # Fill NA for visualization
                     c=sample_df['count_active_days'], 
                     cmap='plasma', s=50, alpha=0.7)

ax.set_xlabel('Usage Duration (minutes)')
ax.set_ylabel('Event Count')
ax.set_zlabel('Average NPS Rating')
ax.set_title('Multi-Dimensional View: Duration, Frequency, and NPS\n(Color indicates Active Days)')

cbar = fig.colorbar(scatter, ax=ax, shrink=0.7)
cbar.set_label('Active Days Count')

plt.tight_layout()
plt.savefig('multi_dimensional_3d.png', dpi=300)
plt.close()

# 5. Plot 5: Feature importance analysis - Calculate variance of each dimension
# Standardize features to compare variance
from sklearn.preprocessing import StandardScaler

scaler = StandardScaler()
scaled_features = scaler.fit_transform(account_df[features].fillna(0))
variance = np.var(scaled_features, axis=0)

fig, ax = plt.subplots(figsize=(10, 6))
bars = ax.bar(range(len(features)), variance, color='steelblue')
ax.set_xlabel('Features')
ax.set_ylabel('Variance (Standardized)')
ax.set_title('Feature Variance Analysis\n(Indicates potential discriminative power)')
ax.set_xticks(range(len(features)))
ax.set_xticklabels(features, rotation=45, ha='right')

# Add value labels on bars
for bar, v in zip(bars, variance):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2., height + 0.01,
            f'{v:.3f}', ha='center', va='bottom', fontsize=8)

plt.tight_layout()
plt.savefig('feature_variance.png', dpi=300)
plt.close()

print("Visualizations created successfully!")
''')
