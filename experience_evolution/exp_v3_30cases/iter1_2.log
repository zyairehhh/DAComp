import sqlite3
import pandas as pd
import numpy as np
import os

# Use relative path
db_path = 'dacomp-027.sqlite'
if not os.path.exists(db_path):
    db_path = './dacomp-027.sqlite'
if not os.path.exists(db_path):
    db_path = '/workspace/dacomp-027.sqlite'

print(f"Using database at: {db_path}")
conn = sqlite3.connect(db_path)

# Query to join relevant data
query = """
SELECT e."Disaster Event ID",
       e."Disaster Level",
       e."Disaster Type",
       json_extract(e."Impact Indicator", '$.population.injured') as injured,
       json_extract(e."Impact Indicator", '$.population.casualties') as casualties,
       json_extract(e."Impact Indicator", '$.population.displaced') as displaced,
       json_extract(e."Impact Indicator", '$.infrastructure.water_damage_percent') as water_damage_percent,
       c."Secincident Count",
       eh."Water Quality Index",
       eh."Disease Risk",
       eh."Environmental Impact Rate",
       eh."Medical Emergency Response Capacity"
FROM disaster_events e
LEFT JOIN coordination_and_evaluation c ON e."Disaster Event ID" = c."Distribution Reference ID"
LEFT JOIN environment_and_health eh ON e."Disaster Event ID" = eh."Disaster Reference ID"
"""
df = pd.read_sql_query(query, conn)
conn.close()

print("Data shape:", df.shape)
print("Columns:", df.columns.tolist())
print("\nFirst few rows:")
print(df.head())

# Convert columns to numeric where possible
for col in ['injured', 'casualties', 'displaced', 'water_damage_percent', 'Secincident Count', 'Water Quality Index']:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Encode categoricals for correlation
df['Disease Risk Score'] = df['Disease Risk'].map({'Low':1, 'Medium':2, 'High':3})
df['Environmental Impact Score'] = df['Environmental Impact Rate'].map({'Low':1, 'Medium':2, 'High':3})
df['Medical Capacity Score'] = df['Medical Emergency Response Capacity'].map({'Critical':1, 'Limited':2, 'Adequate':3})

# Compute correlations
corr_columns = ['Secincident Count', 'injured', 'casualties', 'displaced', 'water_damage_percent',
                'Water Quality Index', 'Disease Risk Score', 'Environmental Impact Score', 'Medical Capacity Score']
corr_matrix = df[corr_columns].corr(method='pearson')

print("\n--- Correlation Matrix (Pearson) ---")
print(corr_matrix.round(3))

# Compute average secondary incidents by disaster level and type
avg_sec = df.groupby(['Disaster Level', 'Disaster Type'])['Secincident Count'].mean().unstack()
print("\n--- Average Secondary Incidents by Disaster Level and Type ---")
print(avg_sec.round(2))

# Compute average human impact by disaster level
avg_impact = df.groupby('Disaster Level')[['injured', 'casualties', 'displaced']].mean()
print("\n--- Average Human Impact by Disaster Level ---")
print(avg_impact.round(0))

# Compute average environmental impact by disaster level
avg_env = df.groupby('Disaster Level')[['Water Quality Index', 'Disease Risk Score', 'Environmental Impact Score']].mean()
print("\n--- Average Environmental Indicators by Disaster Level ---")
print(avg_env.round(2))

# Identify top disaster types for secondary incidents
top_sec = df.groupby('Disaster Type')['Secincident Count'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print("\n--- Top Disaster Types by Average Secondary Incidents ---")
print(top_sec.round(2))

# Additional analysis: compare secondary incidents with disease risk
disease_sec = df.groupby('Disease Risk')['Secincident Count'].agg(['mean', 'count'])
print("\n--- Secondary Incidents by Disease Risk ---")
print(disease_sec.round(2))

# Write summary to text file for later use
with open('/workspace/summary_stats.txt', 'w') as f:
    f.write("Summary Statistics\n")
    f.write("==================\n")
    f.write("Correlation matrix:\n")
    f.write(corr_matrix.round(3).to_string())
    f.write("\n\n")
    f.write("Average secondary incidents by Disaster Level:\n")
    f.write(df.groupby('Disaster Level')['Secincident Count'].mean().round(2).to_string())
    f.write("\n\n")
    f.write("Average casualties by Disaster Level:\n")
    f.write(df.groupby('Disaster Level')['casualties'].mean().round(0).to_string())
    f.write("\n\n")

print("\nAnalysis complete. Summary written to /workspace/summary_stats.txt")
```
