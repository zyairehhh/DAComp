import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Load computed data
df = pd.read_csv('filtered_campaigns.csv')

# Group by campaign_type
group = df.groupby('campaign_type').agg(
    avg_health=('health_score', 'mean'),
    avg_roas=('roas', 'mean'),
    count=('health_score', 'size')
).reset_index()

# Sort by avg_health
group = group.sort_values('avg_health', ascending=False)

# Plot
fig, ax1 = plt.subplots(figsize=(8,5))
x = np.arange(len(group))
width = 0.35
bars1 = ax1.bar(x - width/2, group['avg_health'], width, label='Avg Health Score', color='steelblue')
ax1.set_xlabel('Campaign Type')
ax1.set_ylabel('Average Health Score', color='steelblue')
ax1.tick_params(axis='y', labelcolor='steelblue')
ax1.set_xticks(x)
ax1.set_xticklabels(group['campaign_type'])
ax1.set_ylim(0, 100)

ax2 = ax1.twinx()
bars2 = ax2.bar(x + width/2, group['avg_roas'], width, label='Avg ROAS', color='darkorange')
ax2.set_ylabel('Average ROAS', color='darkorange')
ax2.tick_params(axis='y', labelcolor='darkorange')
# ROAS scale likely below 0.8, set reasonable ylim
roas_max = group['avg_roas'].max()
ax2.set_ylim(0, roas_max*1.2)

# Add count labels
for i, (idx, row) in enumerate(group.iterrows()):
    ax1.text(i - width/2, row['avg_health']+1, f"{row['avg_health']:.1f}", ha='center', va='bottom', fontsize=9)
    ax2.text(i + width/2, row['avg_roas']+0.01, f"{row['avg_roas']:.2f}", ha='center', va='bottom', fontsize=9)

plt.title('Campaign Type: Health Score vs ROAS (Filtered Campaigns)')
fig.tight_layout()
plt.savefig('campaign_type_health_roas.png', dpi=300)
plt.close()
''')
