import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect("dacomp-090.sqlite")

# Compute risk score for all customers
query = """
SELECT 
    customer_id,
    customer_name,
    payment_rate_percentage,
    outstanding_balance,
    credit_score,
    business_stability_score,
    (100 - payment_rate_percentage) * 0.4 + (850 - credit_score) / 850 * 100 * 0.4 + (100 - business_stability_score) * 0.2 AS risk_score
FROM quickbooks__customer_analytics
"""
df = pd.read_sql_query(query, conn)
# Flag high-risk per criteria
df['high_risk_flag'] = (df['payment_rate_percentage'] < 75.0) & (df['outstanding_balance'] > 15000)
high_risk = df[df['high_risk_flag']]
normal = df[~df['high_risk_flag']]

print("High-risk customers: ", high_risk.shape[0])
print("Normal customers: ", normal.shape[0])
print("\nRisk score statistics:")
print("High-risk: mean={:.2f}, median={:.2f}, min={:.2f}, max={:.2f}".format(
    high_risk['risk_score'].mean(), high_risk['risk_score'].median(),
    high_risk['risk_score'].min(), high_risk['risk_score'].max()
))
print("Normal: mean={:.2f}, median={:.2f}, min={:.2f}, max={:.2f}".format(
    normal['risk_score'].mean(), normal['risk_score'].median(),
    normal['risk_score'].min(), normal['risk_score'].max()
))

# Define risk tiers
def risk_tier(score):
    if score >= 70:
        return 'Critical'
    elif score >= 60:
        return 'High'
    elif score >= 50:
        return 'Moderate'
    else:
        return 'Low'

df['risk_tier'] = df['risk_score'].apply(risk_tier)
high_risk['risk_tier'] = high_risk['risk_score'].apply(risk_tier)

print("\nHigh-risk customers by risk tier:")
print(high_risk['risk_tier'].value_counts())
print("\nDistribution of risk tiers among high-risk customers (%):")
print((high_risk['risk_tier'].value_counts() / high_risk.shape[0] * 100).round(2))

# Proportion of outstanding balance per risk tier
print("\nOutstanding balance by risk tier (high-risk only):")
balance_tier = high_risk.groupby('risk_tier')['outstanding_balance'].sum()
print(balance_tier)
print("Percentage of total high-risk outstanding balance:")
print((balance_tier / balance_tier.sum() * 100).round(2))
print("\nAverage outstanding balance per tier:")
print(high_risk.groupby('risk_tier')['outstanding_balance'].mean())
