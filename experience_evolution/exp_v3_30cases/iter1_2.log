import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-093.sqlite')

# Helper functions for categorizations (same as before)
def categorize_subject(subject):
    if subject is None:
        return None
    if '折扣' in subject:
        return 'discount'
    elif '新品' in subject or '上新' in subject:
        return 'new'
    else:
        return 'storytelling'

def categorize_day_type(sent_at):
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        weekday = date_obj.weekday()  # Monday=0, Sunday=6
        return 'weekday' if weekday < 5 else 'weekend'
    except:
        return None

def categorize_time_period(sent_at):
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        hour = date_obj.hour
        if hour < 12:
            return 'morning'
        elif hour < 18:
            return 'afternoon'
        else:
            return 'evening'
    except:
        return None

def categorize_holiday(subject):
    if subject is None:
        return 'non_holiday'
    if '节前' in subject:
        return 'pre_holiday'
    else:
        return 'non_holiday'

# Load campaigns data
query = "SELECT campaign_id, SUBJECT, is_archived, variation_id, total_count_unique_people, count_received_email, count_opened_email, count_clicked_email, count_placed_order, gmv_gross, gmv_net, email_open_rate, email_click_to_open_rate, SENT_AT FROM klaviyo__campaigns"
df = pd.read_sql_query(query, conn)

# Apply categorizations
df['subject_category'] = df['SUBJECT'].apply(categorize_subject)
df['day_type'] = df['SENT_AT'].apply(categorize_day_type)
df['time_period'] = df['SENT_AT'].apply(categorize_time_period)
df['holiday_period'] = df['SUBJECT'].apply(categorize_holiday)

df = df.dropna(subset=['subject_category', 'day_type', 'time_period', 'holiday_period'])

# Compute derived rates
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open'] = df['count_clicked_email'] / df['count_opened_email'].replace(0, np.nan)
df['order_rate'] = df['count_placed_order'] / df['count_received_email']
df['gmv_per_opened'] = df['gmv_gross'] / df['count_opened_email'].replace(0, np.nan)

# Weighted aggregation function
def weighted_avg(df, value_col, weight_col='count_received_email'):
    return np.average(df[value_col], weights=df[weight_col])

# Weekday vs Weekend weighted open rate
day_type_weighted = df.groupby('day_type').apply(lambda x: pd.Series({
    'open_rate_weighted': weighted_avg(x, 'open_rate'),
    'click_rate_weighted': weighted_avg(x, 'click_rate'),
    'click_to_open_weighted': weighted_avg(x, 'click_to_open'),
}), include_groups=False).reset_index()

print("Weekday vs Weekend weighted rates:")
print(day_type_weighted)

# Subject category click‑to‑open weighted
subject_weighted = df.groupby('subject_category').apply(lambda x: pd.Series({
    'open_rate_weighted': weighted_avg(x, 'open_rate'),
    'click_to_open_weighted': weighted_avg(x, 'click_to_open'),
    'order_rate_weighted': weighted_avg(x, 'order_rate'),
}), include_groups=False).reset_index()

conn.close()

# Plotting
sns.set_style('whitegrid')
plt.rcParams.update({'font.size': 12})

# Plot A: Weekday vs Weekend Open Rate
plt.figure(figsize=(8,6))
ax = sns.barplot(x='day_type', y='open_rate_weighted', data=day_type_weighted, hue='day_type', palette='coolwarm', legend=False)
ax.set_title('Weighted Open Rate: Weekday vs Weekend')
ax.set_ylabel('Open Rate')
ax.set_xlabel('Day Type')
plt.tight_layout()
plt.savefig('weekday_weekend_open_rate.png', dpi=300)
plt.close()

# Plot B: Subject Category Click‑to‑Open Ratio
plt.figure(figsize=(8,6))
ax = sns.barplot(x='subject_category', y='click_to_open_weighted', data=subject_weighted, hue='subject_category', palette='spring', legend=False)
ax.set_title('Weighted Click‑to‑Open Ratio by Subject Category')
ax.set_ylabel('Click‑to‑Open Ratio')
ax.set_xlabel('Subject Category')
plt.tight_layout()
plt.savefig('subject_click_to_open.png', dpi=300)
plt.close()

print("Extra plots saved.")
```
