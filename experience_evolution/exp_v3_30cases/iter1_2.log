'''
import pandas as pd
import numpy as np
import sqlite3

# Load data
conn = sqlite3.connect('dacomp-013.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Data cleaning as before
df['Planned Work Hours'] = pd.to_numeric(df['Planned Work Hours'], errors='coerce')
df['Actual Work Hours'] = pd.to_numeric(df['Actual Work Hours'], errors='coerce')
df['Completion Quality Score'] = pd.to_numeric(df['Completion Quality Score'], errors='coerce')
df['Task Difficulty Coefficient'] = pd.to_numeric(df['Task Difficulty Coefficient'], errors='coerce')

# Compute derived metrics for each task
df['Completed'] = (df['Task Status'] == 'Completed').astype(int)
df['OnTime'] = ((df['Actual Completion Time'] <= df['Planned Deadline']) & (df['Completed'] == 1)).astype(int)
df['Planned Work Hours'] = df['Planned Work Hours'].replace(0, np.nan)
df['WorkHourRatio'] = (df['Planned Work Hours'] - df['Actual Work Hours']) / df['Planned Work Hours']
df['Efficiency'] = df['WorkHourRatio'].clip(-1, 1)
df['QualityNorm'] = df['Completion Quality Score'] / 10.0
df['QualityNorm'] = df['QualityNorm'].fillna(0.5)

priority_weight = {'Urgent': 4, 'High': 3, 'Medium': 2, 'Low': 1}
df['PriorityWeight'] = df['Priority'].map(priority_weight)
df['DifficultyMultiplier'] = df['Task Difficulty Coefficient'] / df['Task Difficulty Coefficient'].mean()

weights = {'Completion': 0.3, 'Quality': 0.3, 'Timeliness': 0.2, 'Efficiency': 0.2}
df['TaskScore'] = (weights['Completion'] * df['Completed'] +
                   weights['Quality'] * df['QualityNorm'] +
                   weights['Timeliness'] * df['OnTime'] +
                   weights['Efficiency'] * (df['Efficiency'] + 1) / 2)
df['PriorityAdjustedScore'] = df['TaskScore'] * df['PriorityWeight']
df['FinalTaskScore'] = df['PriorityAdjustedScore'] * df['DifficultyMultiplier']

# Aggregate per owner
owner_scores = df.groupby('Task Owner')['FinalTaskScore'].sum().reset_index(name='TotalScore')
owner_scores['TaskCount'] = df.groupby('Task Owner').size().values
owner_scores['AvgScorePerTask'] = df.groupby('Task Owner')['FinalTaskScore'].mean().values

# Compute other metrics per owner
owner_metrics = df.groupby('Task Owner').agg({
    'Completed': 'sum',
    'OnTime': 'sum',
    'PriorityWeight': 'sum',
    'Task Difficulty Coefficient': 'mean',
    'Task Type': lambda x: x.mode()[0] if not x.empty else '',
}).reset_index()
owner_metrics.rename(columns={'Completed': 'TasksCompleted', 'OnTime': 'TasksOnTime', 'PriorityWeight': 'TotalPriorityWeight', 'Task Difficulty Coefficient': 'AvgDifficulty'}, inplace=True)
owner_scores = pd.merge(owner_scores, owner_metrics, on='Task Owner', how='left')

# Classify
n_owners = owner_scores.shape[0]
excellent_cutoff = int(np.round(n_owners * 0.2))
good_cutoff = int(np.round(n_owners * 0.9))
owner_scores = owner_scores.sort_values('TotalScore', ascending=False).reset_index(drop=True)
owner_scores['PerformanceLevel'] = 'Needs Improvement'
owner_scores.loc[:excellent_cutoff-1, 'PerformanceLevel'] = 'Excellent'
owner_scores.loc[excellent_cutoff:good_cutoff-1, 'PerformanceLevel'] = 'Good'

print("Summary statistics by performance level:")
level_summary = owner_scores.groupby('PerformanceLevel').agg({
    'TotalScore': ['mean', 'std', 'min', 'max'],
    'TaskCount': ['mean', 'sum'],
    'TasksCompleted': 'mean',
    'TasksOnTime': 'mean',
    'AvgDifficulty': 'mean',
}).round(2)
print(level_summary)

# Check distribution
print("\\nDistribution:")
print(owner_scores['PerformanceLevel'].value_counts())
print(f"Total owners: {n_owners}")

# Save to csv
owner_scores.to_csv('performance_classification.csv', index=False)
''')
