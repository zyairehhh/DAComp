import sqlite3
import pandas as pd
import numpy as np

# Connect to database
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-008/stage1_env/dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Compute deviation
df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Basic stats
print("Overall:")
print(f"Count: {len(df)}")
print(f"Mean Deviation: {df['Deviation'].mean():.2f}")
print(f"Median Deviation: {df['Deviation'].median():.2f}")
print(f"Std Deviation: {df['Deviation'].std():.2f}")
print(f"Min Deviation: {df['Deviation'].min():.2f}")
print(f"Max Deviation: {df['Deviation'].max():.2f}")
print()

# By Project Type
print("By Project Type:")
group = df.groupby('Project Type')['Deviation']
for name, data in group:
    print(f"{name}: count={len(data)}, mean={data.mean():.2f}, median={data.median():.2f}, std={data.std():.2f}")
print()

# By Risk Level
print("By Risk Level:")
group_risk = df.groupby('Risk Level')['Deviation']
for name, data in group_risk:
    print(f"{name}: count={len(data)}, mean={data.mean():.2f}, median={data.median():.2f}, std={data.std():.2f}")
print()

# Team Size correlation
team_corr = df['Team Size'].corr(df['Deviation'])
print(f"Correlation between Team Size and Deviation: {team_corr:.4f}")

# Customer Satisfaction correlation
sat_corr = df['Customer Satisfaction'].corr(df['Deviation'])
print(f"Correlation between Customer Satisfaction and Deviation: {sat_corr:.4f}")

# Deviation vs Budget
budget_corr = df['Budget Amount'].corr(df['Deviation'])
print(f"Correlation between Budget Amount and Deviation: {budget_corr:.4f}")

# Deviation vs Actual Cost
actual_corr = df['Actual Cost'].corr(df['Deviation'])
print(f"Correlation between Actual Cost and Deviation: {actual_corr:.4f}")

# Categorical analysis: Project Status and Priority
print("\nBy Project Status:")
status_group = df.groupby('Project Status')['Deviation'].agg(['count', 'mean', 'median', 'std'])
print(status_group)
print("\nBy Priority:")
priority_group = df.groupby('Priority')['Deviation'].agg(['count', 'mean', 'median', 'std'])
print(priority_group)

# Additional insights: Deviation sign distribution
over_budget = (df['Deviation'] < 0).sum()
on_or_under = (df['Deviation'] >= 0).sum()
print(f"\nProjects over budget (negative deviation): {over_budget} ({over_budget/len(df)*100:.1f}%)")
print(f"Projects under or on budget: {on_or_under} ({on_or_under/len(df)*100:.1f}%)")

# Save summary to CSV
summary_df = pd.DataFrame({
    'Metric': ['Count', 'Mean', 'Median', 'Std', 'Min', 'Max'],
    'Overall': [len(df), df['Deviation'].mean(), df['Deviation'].median(), df['Deviation'].std(), df['Deviation'].min(), df['Deviation'].max()]
})
summary_df.to_csv('/workspace/deviation_summary.csv', index=False)
print("\nSummary saved to deviation_summary.csv")
```
