'''
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Load cleaned data
df = pd.read_csv('cleaned_data.csv')

# Convert Price to yuan
df['Price_in_yuan'] = df['Price'] * 10000
df['Depreciation_Rate'] = (1 - df['Price_in_yuan'] / df['New_Car_Price_Cleaned']) * 100
df_clean = df[(df['Depreciation_Rate'] >= 0) & (df['Depreciation_Rate'] <= 100)].copy()

# Get models with at least 2 samples for statistical significance
model_counts = df_clean['Title'].value_counts()
valid_models = model_counts[model_counts >= 2].index.tolist()
df_models = df_clean[df_clean['Title'].isin(valid_models)]

# Calculate average depreciation and price by model
model_stats = df_models.groupby('Title').agg(
    avg_depreciation=('Depreciation_Rate', 'mean'),
    sample_size=('Depreciation_Rate', 'count'),
    avg_price=('Price_in_yuan', 'mean'),
    avg_age=('Car_Age', 'mean'),
    avg_mileage=('Mileage_Cleaned', 'mean')
).round(2)

# Filter for reasonable sample sizes and get top 10 with lowest depreciation
top_models = model_stats[model_stats['sample_size'] >= 2].nsmallest(10, 'avg_depreciation')

# Create visualization
plt.figure(figsize=(12, 8))

# Create subplot grid
ax1 = plt.subplot(2, 1, 1)

# Bar chart of depreciation rates
bars = ax1.barh(range(len(top_models)), top_models['avg_depreciation'].values)
ax1.set_yticks(range(len(top_models)))
# Truncate model names for readability
short_names = [name[:40] + '...' if len(name) > 40 else name for name in top_models.index]
ax1.set_yticklabels(short_names)
ax1.invert_yaxis()  # Highest value at top
ax1.set_xlabel('Average Depreciation Rate (%)', fontsize=12)
ax1.set_title('Top 10 Models with Best Value Retention\n(Lowest Depreciation Rates)', 
             fontsize=14, fontweight='bold')

# Add value labels on bars
for i, bar in enumerate(bars):
    width = bar.get_width()
    ax1.text(width + 0.5, bar.get_y() + bar.get_height()/2, 
            f'{width:.1f}%', ha='left', va='center', fontweight='bold')

# Add sample size annotation
for i, (idx, row) in enumerate(top_models.iterrows()):
    ax1.text(0.5, i, f'n={int(row["sample_size"])}', 
            ha='right', va='center', color='white', fontweight='bold')

# Second plot: Price and age info
ax2 = plt.subplot(2, 1, 2)
x = np.arange(len(top_models))
width = 0.35

# Price bars
bars1 = ax2.bar(x - width/2, top_models['avg_price']/10000, width, 
                label='Avg Price (10k yuan)', color='tab:blue')
# Age bars
bars2 = ax2.bar(x + width/2, top_models['avg_age'], width, 
                label='Avg Age (years)', color='tab:orange')

ax2.set_xlabel('Model (same order as above)', fontsize=12)
ax2.set_ylabel('Price / Age', fontsize=12)
ax2.set_title('Price and Age Characteristics of Top Models', fontsize=14, fontweight='bold')
ax2.set_xticks(x)
ax2.set_xticklabels([])  # Hide x-tick labels since same as above
ax2.legend()
ax2.grid(True, alpha=0.3, axis='y')

# Add price value labels
for bar in bars1:
    height = bar.get_height()
    ax2.text(bar.get_x() + bar.get_width()/2, height + 0.5,
            f'{height:.1f}', ha='center', va='bottom', fontsize=9)

# Add age value labels
for bar in bars2:
    height = bar.get_height()
    ax2.text(bar.get_x() + bar.get_width()/2, height + 0.05,
            f'{height:.1f}', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('top_models_buyback.png', dpi=300, bbox_inches='tight')
print("Saved top_models_buyback.png")

# Print detailed information
print("=== TOP 10 MODELS FOR BUYBACK (LOWEST DEPRECIATION) ===")
print("{:<60} {:<12} {:<12} {:<12} {:<12} {:<12}".format(
    "Model", "Deprec%", "Samples", "Avg Price", "Avg Age", "Avg Mileage"))
print("=" * 120)

for idx, row in top_models.iterrows():
    # Truncate model name for display
    model_name = idx[:55] + "..." if len(idx) > 55 else idx
    print("{:<60} {:<11.1f} {:<11} {:<11.0f} {:<11.1f} {:<11.0f}".format(
        model_name, row['avg_depreciation'], int(row['sample_size']),
        row['avg_price'], row['avg_age'], row['avg_mileage']
    ))
''')
