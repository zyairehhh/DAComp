manager_cols = [col for col in df.columns if col.startswith('hm_')]
if manager_cols:
    manager_corr = df[['conv_rate'] + manager_cols].corr().loc['conv_rate', manager_cols]
    print("\nCorrelation between conversion rate and hiring manager indicators:")
    print(manager_corr.sort_values())
