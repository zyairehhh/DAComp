risk_counts = merged_df['risk_category'].value_counts()
axes[1].pie(risk_counts.values, labels=risk_counts.index, autopct='%1.1f%%', 
            colors=['green', 'yellow', 'red'], startangle=90)
axes[1].set_title('Customer Risk Category Distribution')

plt.tight_layout()
plt.savefig('plots/risk_score_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 6: Risk score vs profitability
