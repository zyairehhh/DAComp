import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Setup style
plt.style.use('seaborn-v0_8-darkgrid')
sns.set_palette("husl")

# Connect to database
conn = sqlite3.connect('dacomp-018.sqlite')

# 1. Profit by customer segment (Fashion)
query1 = '''
SELECT c."Customer Segment", SUM(o.profit) as total_profit
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c."Customer Segment"
ORDER BY total_profit DESC
'''
df_seg = pd.read_sql(query1, conn)

# 2. Profit by gender
query2 = '''
SELECT c.gender, SUM(o.profit) as total_profit
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c.gender
ORDER BY total_profit DESC
'''
df_gender = pd.read_sql(query2, conn)

# 3. Profit by region (top 10)
query3 = '''
SELECT c.Region, SUM(o.profit) as total_profit
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c.Region
ORDER BY total_profit DESC
LIMIT 10
'''
df_region = pd.read_sql(query3, conn)

# 4. Profit by age group (binned)
query4 = '''
SELECT 
    CASE 
        WHEN age < 20 THEN '<20'
        WHEN age BETWEEN 20 AND 29 THEN '20-29'
        WHEN age BETWEEN 30 AND 39 THEN '30-39'
        WHEN age BETWEEN 40 AND 49 THEN '40-49'
        WHEN age >= 50 THEN '50+'
        ELSE 'Unknown'
    END as age_group,
    SUM(o.profit) as total_profit,
    COUNT(DISTINCT o."Customer ID") as customer_count
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY age_group
ORDER BY total_profit DESC
'''
df_age = pd.read_sql(query4, conn)

# 5. Browsing engagement vs profit correlation (average browsing time per customer vs profit per customer)
query5 = '''
SELECT 
    c."Customer ID",
    SUM(pb."Browsing Time (minutes)") as total_browse_time,
    SUM(pb.like) as total_likes,
    SUM(pb.share) as total_shares,
    SUM(pb."Add to Cart") as total_add_to_cart,
    SUM(o.profit) as total_profit
FROM product_browsing pb
JOIN order_information o ON pb."Customer ID" = o."Customer ID" AND pb."Product Category" = o."Product Category" AND pb.Product = o.Product
JOIN customer_information c ON pb."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c."Customer ID"
LIMIT 500
'''
df_engage = pd.read_sql(query5, conn)

conn.close()

# Plot 1: Profit by Customer Segment
plt.figure(figsize=(8,5))
bars = plt.bar(df_seg['Customer Segment'], df_seg['total_profit'] / 1e6, color='skyblue')
plt.title('Total Profit by Customer Segment (Fashion)', fontsize=14)
plt.xlabel('Customer Segment')
plt.ylabel('Total Profit (Million USD)')
# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height, f'{height:.1f}M', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('/workspace/profit_by_segment.png', dpi=300)
plt.close()

# Plot 2: Profit by Gender
plt.figure(figsize=(6,4))
bars = plt.bar(df_gender['gender'], df_gender['total_profit'] / 1e6, color=['pink', 'blue'])
plt.title('Total Profit by Gender (Fashion)', fontsize=14)
plt.xlabel('Gender')
plt.ylabel('Total Profit (Million USD)')
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height, f'{height:.1f}M', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('/workspace/profit_by_gender.png', dpi=300)
plt.close()

# Plot 3: Profit by Region (Top 10)
plt.figure(figsize=(10,6))
bars = plt.barh(df_region['Region'], df_region['total_profit'] / 1e6, color='lightgreen')
plt.title('Total Profit by Region (Top 10, Fashion)', fontsize=14)
plt.xlabel('Total Profit (Million USD)')
plt.ylabel('Region')
# Horizontal bar labels
for i, v in enumerate(df_region['total_profit'] / 1e6):
    plt.text(v + 0.1, i, f'{v:.1f}M', va='center')
plt.tight_layout()
plt.savefig('/workspace/profit_by_region.png', dpi=300)
plt.close()

# Plot 4: Profit by Age Group
plt.figure(figsize=(8,5))
bars = plt.bar(df_age['age_group'], df_age['total_profit'] / 1e6, color='orange')
plt.title('Total Profit by Age Group (Fashion)', fontsize=14)
plt.xlabel('Age Group')
plt.ylabel('Total Profit (Million USD)')
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height, f'{height:.1f}M', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('/workspace/profit_by_age.png', dpi=300)
plt.close()

# Plot 5: Scatter of Browsing Time vs Profit
plt.figure(figsize=(8,6))
plt.scatter(df_engage['total_browse_time'], df_engage['total_profit'], alpha=0.6, c='purple')
plt.title('Customer Browsing Time vs Total Profit (Fashion)', fontsize=14)
plt.xlabel('Total Browsing Time (minutes)')
plt.ylabel('Total Profit (USD)')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('/workspace/browse_vs_profit.png', dpi=300)
plt.close()

print('Plots saved.')
```

