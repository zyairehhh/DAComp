Action: CreateFile(filepath='compute3.py':
'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-071.sqlite')

pass_reasons = ("Advanced to next stage", "Proceeding", "Hired", "Qualified")

query = """
SELECT stage,
       COUNT(*) as total_records,
       AVG(days_in_stage) as avg_days,
       AVG(days_in_stage) * 1.0 as avg_days2,
       SUM(CASE WHEN archive_reason IN """ + str(pass_reasons) + """ THEN 1 ELSE 0 END) as pass_records
FROM lever__opportunity_stage_history
WHERE stage IN ('Application Review','Phone Screening','Technical Assessment','First Interview','Second Interview','Final Interview')
GROUP BY stage;
"""

df = pd.read_sql_query(query, conn)
df['pass_rate'] = df['pass_records'] / df['total_records']
df['attrition_rate'] = 1 - df['pass_rate']
df['efficiency_index'] = df['pass_rate'] / df['avg_days'] * 100

print(df[['stage','total_records','avg_days','attrition_rate','pass_rate','efficiency_index']].to_string(index=False))

# distribution of archive_reason for each stage
for stage in df['stage'].unique():
    q = f"SELECT archive_reason, COUNT(*) as cnt FROM lever__opportunity_stage_history WHERE stage = '{stage}' GROUP BY archive_reason ORDER BY cnt DESC LIMIT 5;"
    sub = pd.read_sql_query(q, conn)
    print(f"\nTop 5 attrition reasons for {stage}:")
    print(sub.to_string(index=False))

conn.close()
''')
