import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-019.sqlite')
basic = pd.read_sql_query('SELECT * FROM basic_drug_information', conn)
inventory = pd.read_sql_query('SELECT * FROM inventory_management', conn)
pricing = pd.read_sql_query('SELECT * FROM pricing_system', conn)
conn.close()

# Merge
merged = pd.merge(basic, inventory, left_on='Drug ID', right_on='Drug ID', how='inner')
merged = pd.merge(merged, pricing, left_on='Drug ID', right_on='Drug ID', how='left')

# Filter foreign
foreign = merged[merged['Origin / Tier (Domestic/Imported/JV)'].isin(['Imported', 'Joint-venture'])]

# Compute backlog score (proportion of non-usable stock)
foreign['backlog_score'] = (foreign['Near-expiry Quantity'] + foreign['Expired Quantity']) / (foreign['Qualified Quantity'] + 1)

# Compute supply interruption score (as earlier)
alert_map = {'Normal': 0, 'Alert': 1, 'Severe': 2}
foreign['alert_score'] = foreign['Inventory Alert Status'].map(alert_map).fillna(0)
foreign['abnormal_price_score'] = (foreign['Abnormal Price Fluctuation Flag'] == 'Yes').astype(int)
foreign['quarantine_ratio'] = foreign['Quarantine Quantity'] / (foreign['Qualified Quantity'] + 1)

def parse_discrepancy_rate(s):
    if isinstance(s, str):
        s = s.replace('%', '').strip()
        try:
            return float(s) / 100.0
        except:
            return 0.0
    elif isinstance(s, (int, float)):
        return s / 100.0
    else:
        return 0.0

foreign['discrepancy_rate'] = foreign['Inventory Discrepancy Rate'].apply(parse_discrepancy_rate)

foreign['supply_interruption_score'] = (
    foreign['alert_score'] +
    foreign['abnormal_price_score'] +
    foreign['quarantine_ratio'] * 10 +
    foreign['discrepancy_rate'] * 10
)

# Compute quality risk score
quality_qty = (
    foreign['Damaged Quantity'] +
    foreign['Pest/Mold Damage Quantity'] +
    foreign['Rodent Contamination Quantity'] +
    foreign['Air Contamination Quantity'] +
    foreign['Temp/Humidity Excursion Record'] +
    foreign['Returned Quantity']
)
foreign['quality_quantity_score'] = quality_qty / (foreign['Qualified Quantity'] + 1)
foreign['has_adverse'] = foreign['Adverse Reaction Code'].notna().astype(int)
foreign['has_contraindication'] = foreign['Contraindication Code'].notna().astype(int)

foreign['quality_risk_score'] = (
    foreign['quality_quantity_score'] * 10 +
    foreign['has_adverse'] +
    foreign['has_contraindication']
)

# Rank within each origin
for origin in ['Imported', 'Joint-venture']:
    subset = foreign[foreign['Origin / Tier (Domestic/Imported/JV)'] == origin]
    print(f"\\n--- {origin} Drugs ---")
    print("Top 5 by backlog score:")
    top_backlog = subset.nlargest(5, 'backlog_score')[['Drug ID', 'Specification / Description', 'Manufacturer', 'backlog_score', 'Qualified Quantity', 'Near-expiry Quantity', 'Expired Quantity']]
    print(top_backlog.to_string(index=False))
    print("\\nTop 5 by supply interruption score:")
    top_supply = subset.nlargest(5, 'supply_interruption_score')[['Drug ID', 'Specification / Description', 'Manufacturer', 'supply_interruption_score', 'Inventory Alert Status', 'Abnormal Price Fluctuation Flag', 'Quarantine Quantity', 'Inventory Discrepancy Rate']]
    print(top_supply.to_string(index=False))
    print("\\nTop 5 by quality risk score:")
    top_quality = subset.nlargest(5, 'quality_risk_score')[['Drug ID', 'Specification / Description', 'Manufacturer', 'quality_risk_score', 'Damaged Quantity', 'Pest/Mold Damage Quantity', 'Rodent Contamination Quantity', 'Air Contamination Quantity', 'Temp/Humidity Excursion Record', 'Returned Quantity', 'Adverse Reaction Code', 'Contraindication Code']]
    print(top_quality.to_string(index=False))

# Overall combined ranking
# Normalize each score to 0-1 range
for col in ['backlog_score', 'supply_interruption_score', 'quality_risk_score']:
    max_val = foreign[col].max()
    if max_val > 0:
        foreign[col + '_norm'] = foreign[col] / max_val
    else:
        foreign[col + '_norm'] = 0

foreign['overall_risk'] = (foreign['backlog_score_norm'] + foreign['supply_interruption_score_norm'] + foreign['quality_risk_score_norm'])

print("\\n=== Overall Top 10 Drugs Requiring Prioritized Supervision ===")
top_overall = foreign.nlargest(10, 'overall_risk')[['Drug ID', 'Specification / Description', 'Manufacturer', 'Origin / Tier (Domestic/Imported/JV)', 'overall_risk', 'backlog_score', 'supply_interruption_score', 'quality_risk_score']]
print(top_overall.to_string(index=False))
''')
