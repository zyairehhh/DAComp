all_invoice_total = pd.read_sql_query("SELECT SUM(total_invoice_amount) as total FROM quickbooks__customer_analytics;", conn).iloc[0,0]
high_risk_share = high_risk_invoice_total / all_invoice_total if all_invoice_total != 0 else 0
print(f"High-risk customers' share of total invoice amount: {high_risk_share*100:.2f}%")
# At-risk inflows = total_forecast_inflows * high_risk_share * loss_probability
at_risk_inflows = total_forecast_inflows * high_risk_share * loss_probability
print(f"At-risk inflows (potential loss from forecasted inflows): {at_risk_inflows:.2f}")

conn.close()
