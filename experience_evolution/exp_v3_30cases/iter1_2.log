import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# Load merged metrics
merged = pd.read_csv('project_metrics.csv')
print("Columns:", merged.columns.tolist())
print("Rows:", merged.shape[0])

# Ensure numeric columns
merged['avg_close_time_days'] = pd.to_numeric(merged['avg_close_time_days'], errors='coerce')
merged['bug_rate_issues'] = pd.to_numeric(merged['bug_rate_issues'], errors='coerce')
merged['churn_risk_ratio'] = pd.to_numeric(merged['churn_risk_ratio'], errors='coerce')
merged['avg_regression_ratio'] = pd.to_numeric(merged['avg_regression_ratio'], errors='coerce')
merged['avg_lifecycle_quality'] = pd.to_numeric(merged['avg_lifecycle_quality'], errors='coerce')

# Plot 1: Distribution of avg_close_time_days with vertical line at 15 days
plt.figure(figsize=(8, 5))
plt.hist(merged['avg_close_time_days'].dropna(), bins=30, edgecolor='black', alpha=0.7)
plt.axvline(x=15, color='red', linestyle='--', label='15 days threshold')
plt.xlabel('Average Close Time (days)')
plt.ylabel('Number of Projects')
plt.title('Distribution of Project Delivery Speed')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('close_time_distribution.png', dpi=300)
plt.close()

# Plot 2: Scatter avg_close_time_days vs bug_rate_issues (size by total_issues)
plt.figure(figsize=(8, 6))
scatter = plt.scatter(merged['avg_close_time_days'], merged['bug_rate_issues'], 
                      c=merged['avg_lifecycle_quality'], cmap='viridis', 
                      s=merged['total_issues']/100, alpha=0.7, edgecolors='black')
plt.colorbar(scatter, label='Avg Lifecycle Quality Score')
plt.xlabel('Average Close Time (days)')
plt.ylabel('Bug Rate (Bug Count / Total Issues)')
plt.title('Project Speed vs Bug Rate (Size = Total Issues)')
plt.grid(True, alpha=0.3)
# Highlight projects with avg_close_time_days < 15
fast = merged[merged['avg_close_time_days'] < 15]
if not fast.empty:
    plt.scatter(fast['avg_close_time_days'], fast['bug_rate_issues'], 
                color='red', s=fast['total_issues']/100, edgecolors='red', label='Fast (<15 days)')
plt.legend()
plt.tight_layout()
plt.savefig('speed_vs_bug_rate.png', dpi=300)
plt.close()

# Plot 3: For projects with team metrics (churn_risk_ratio not null), scatter avg_close_time_days vs churn_risk_ratio
team_projects = merged[merged['churn_risk_ratio'].notna()]
print(f"Projects with team metrics: {team_projects.shape[0]}")
if not team_projects.empty:
    plt.figure(figsize=(8, 6))
    plt.scatter(team_projects['avg_close_time_days'], team_projects['churn_risk_ratio'], 
                s=team_projects['total_assigned_issues']/50, alpha=0.7, edgecolors='black')
    plt.xlabel('Average Close Time (days)')
    plt.ylabel('Churn Risk Ratio (Proportion of Users at Risk)')
    plt.title('Project Speed vs Team Churn Risk (Team Data Only)')
    plt.grid(True, alpha=0.3)
    # Label points with project_name
    for idx, row in team_projects.iterrows():
        plt.text(row['avg_close_time_days'], row['churn_risk_ratio']+0.01, 
                 row['project_name'], fontsize=8, alpha=0.8)
    plt.tight_layout()
    plt.savefig('speed_vs_churn_risk.png', dpi=300)
    plt.close()

# Plot 4: Bar chart comparing bug_rate and avg_regression_ratio for fast vs slow projects
merged['speed_category'] = pd.cut(merged['avg_close_time_days'], bins=[0, 15, np.inf], labels=['Fast (<15d)', 'Slow (>=15d)'])
agg = merged.groupby('speed_category').agg(
    avg_bug_rate=('bug_rate_issues', 'mean'),
    avg_regression=('avg_regression_ratio', 'mean'),
    avg_lifecycle_quality=('avg_lifecycle_quality', 'mean'),
    count=('project_id', 'count')
).reset_index()
print(agg)

if agg.shape[0] > 1:
    fig, axes = plt.subplots(1, 3, figsize=(12, 4))
    axes[0].bar(agg['speed_category'], agg['avg_bug_rate'], color=['red', 'blue'])
    axes[0].set_ylabel('Avg Bug Rate')
    axes[0].set_title('Bug Rate by Speed Category')
    axes[0].grid(axis='y', alpha=0.3)
    
    axes[1].bar(agg['speed_category'], agg['avg_regression'], color=['red', 'blue'])
    axes[1].set_ylabel('Avg Regression Ratio')
    axes[1].set_title('Regression Ratio by Speed Category')
    axes[1].grid(axis='y', alpha=0.3)
    
    axes[2].bar(agg['speed_category'], agg['avg_lifecycle_quality'], color=['red', 'blue'])
    axes[2].set_ylabel('Avg Lifecycle Quality')
    axes[2].set_title('Lifecycle Quality by Speed Category')
    axes[2].grid(axis='y', alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('quality_by_speed.png', dpi=300)
    plt.close()

print("Plots generated.")
''')
