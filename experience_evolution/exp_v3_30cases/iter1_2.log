import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-001.sqlite')
# Downstream dependency: number of distinct suppliers per enterprise (input side)
df_suppliers = pd.read_sql_query('SELECT "Enterprise Code", COUNT(DISTINCT "Seller Organization Code") as unique_suppliers FROM ch___input_invoices GROUP BY "Enterprise Code"', conn)
df_rating = pd.read_sql_query('SELECT "Enterprise Code", "Credit Rating" FROM ch___company_info', conn)
df_downstream = pd.merge(df_suppliers, df_rating, on='Enterprise Code')
plt.figure(figsize=(8,5))
sns.boxplot(x='Credit Rating', y='unique_suppliers', data=df_downstream, order=['A','B','C','D'])
plt.title('Downstream Dependency (Number of Unique Suppliers) by Credit Rating')
plt.ylabel('Unique Suppliers')
plt.tight_layout()
plt.savefig('downstream_suppliers_by_rating.png', dpi=300)
plt.close()

conn.close()
```
