import sqlite3
import pandas as pd
import numpy as np

def main():
    db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-060/stage1_env/dacomp-060.sqlite"
    conn = sqlite3.connect(db_path)
    
    # Aggregate per ad group
    query = """
    SELECT 
        ad_group_id, 
        ad_group_name, 
        campaign_name,
        SUM(clicks) as total_clicks,
        SUM(impressions) as total_impressions,
        SUM(conversions) as total_conversions
    FROM google_ads__ad_group_report
    GROUP BY ad_group_id, ad_group_name, campaign_name
    """
    df = pd.read_sql_query(query, conn)
    conn.close()
    
    # Calculate CTR and CVR
    df['ctr'] = np.where(df['total_impressions'] > 0, df['total_clicks'] / df['total_impressions'], np.nan)
    df['cvr'] = np.where(df['total_clicks'] > 0, df['total_conversions'] / df['total_clicks'], np.nan)
    
    # Remove rows where either metric is NaN (zero impressions or zero clicks)
    df_valid = df.dropna(subset=['ctr', 'cvr']).copy()
    print(f"Total ad groups with valid CTR and CVR: {len(df_valid)}")
    
    # Compute percentiles
    ctr_75 = df_valid['ctr'].quantile(0.75)
    cvr_25 = df_valid['cvr'].quantile(0.25)
    print(f"75th percentile of CTR: {ctr_75:.4f}")
    print(f"25th percentile of CVR: {cvr_25:.4f}")
    
    # Identify problematic ad groups: CTR > 75th percentile AND CVR < 25th percentile
    problematic = df_valid[(df_valid['ctr'] > ctr_75) & (df_valid['cvr'] < cvr_25)]
    print(f"\nNumber of problematic ad groups (high CTR, low CVR): {len(problematic)}")
    
    # Save problematic groups to CSV for inspection
    problematic.to_csv('problematic_ad_groups.csv', index=False)
    print("Problematic ad groups saved to problematic_ad_groups.csv")
    
    # Analyze common characteristics
    if len(problematic) > 0:
        # Campaign type patterns
        campaign_patterns = problematic['campaign_name'].value_counts().head(10)
        print("\nTop campaign names among problematic ad groups:")
        print(campaign_patterns)
        
        # Compute average metrics for problematic vs all groups
        avg_ctr_all = df_valid['ctr'].mean()
        avg_cvr_all = df_valid['cvr'].mean()
        avg_ctr_prob = problematic['ctr'].mean()
        avg_cvr_prob = problematic['cvr'].mean()
        print(f"\nAverage CTR (all): {avg_ctr_all:.4f}, (problematic): {avg_ctr_prob:.4f}")
        print(f"Average CVR (all): {avg_cvr_all:.4f}, (problematic): {avg_cvr_prob:.4f}")
        
        # Intent Match Ratio: Actual CVR / Expected CVR (expected CVR maybe average of campaign type? 
        # Since we don't have expected CVR, we can use average CVR of all ad groups as baseline)
        problematic['intent_match_ratio'] = problematic['cvr'] / avg_cvr_all
        print(f"\nIntent Match Ratio (Actual CVR / Overall Avg CVR) for problematic groups:")
        print(problematic[['ad_group_id', 'campaign_name', 'cvr', 'intent_match_ratio']].head())
        print("Mean Intent Match Ratio:", problematic['intent_match_ratio'].mean())
        
        # Traffic quality: maybe look at conversion volume relative to clicks
        problematic['conversions_per_click'] = problematic['total_conversions'] / problematic['total_clicks']
        print(f"\nConversions per click (CVR) for problematic groups (should be low):")
        print(problematic[['ad_group_id', 'campaign_name', 'conversions_per_click']].head())
        
        # Additional: keyword-level analysis? We'll need to join with keyword report.
        # For now, we can note the campaign types.
    else:
        print("No problematic ad groups found.")
    
    # Summary statistics
    print("\n=== Summary Statistics ===")
    print(df_valid[['ctr', 'cvr']].describe())
    
    # Recommendations
    print("\n=== Preliminary Recommendations ===")
    print("1. Review ad copy and landing page relevance for problematic campaigns.")
    print("2. Adjust keyword match types to better align with user intent.")
    print("3. Consider audience targeting refinement.")
    print("4. Test different ad creatives to improve conversion while maintaining click‑through.")
    
if __name__ == "__main__":
    main()
```
