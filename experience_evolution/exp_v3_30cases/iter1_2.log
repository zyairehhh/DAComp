    n1, n2 = len(group1), len(group2)
    s1, s2 = group1.std(ddof=1), group2.std(ddof=1)
    pooled_std = np.sqrt(((n1-1)*s1**2 + (n2-1)*s2**2) / (n1 + n2 - 2))
    d = (group1.mean() - group2.mean()) / pooled_std
    return d

print("\nEffect size (Cohen's d) for each feature:")
for f in features:
    d = cohen_d(high[f], low[f])
    print(f'{f:25s} d = {d:.3f}')

# Check statistical significance (t-test)
print("\nT-test p-values (assuming unequal variances):")
for f in features:
    t, p = stats.ttest_ind(high[f], low[f], equal_var=False, nan_policy='omit')
    print(f'{f:25s} p = {p:.6f}')

conn.close()
''')
