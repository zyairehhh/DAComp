import pandas as pd
import numpy as np

df = pd.read_csv('cleaned_autohome.csv')
print(f"Total rows: {len(df)}")
print(f"Rows with non-null Depreciation_Ratio: {df['Depreciation_Ratio'].notnull().sum()}")

# Filter to rows with depreciation ratio (non-null new price)
df_valid = df[df['Depreciation_Ratio'].notnull()].copy()
print(f"Valid rows for depreciation analysis: {len(df_valid)}")

# Compute additional metrics: price per year (depreciation per year)
df_valid['Price_Per_Year'] = df_valid['Price_clean'] / df_valid['Age_years']

# Compute price per 10k km (assuming mileage is in km)
df_valid['Price_Per_10k_km'] = df_valid['Price_clean'] / (df_valid['Mileage_clean'] / 10000)

# Top brands by count
brand_counts = df_valid['Brand'].value_counts().head(15)
print("\nTop brands (by count):")
print(brand_counts)

# Top brands by average depreciation ratio (higher = better value retention)
brand_dep = df_valid.groupby('Brand')['Depreciation_Ratio'].agg(['mean', 'count', 'std']).round(3)
brand_dep = brand_dep[brand_dep['count'] >= 5].sort_values('mean', ascending=False)
print("\nBrands with >=5 listings, sorted by avg Depreciation_Ratio (higher better):")
print(brand_dep.head(15))

# Analyze by Vehicle Class
vehicle_class_dep = df_valid.groupby('Vehicle Class')['Depreciation_Ratio'].agg(['mean', 'count', 'std']).round(3)
vehicle_class_dep = vehicle_class_dep[vehicle_class_dep['count'] >= 5].sort_values('mean', ascending=False)
print("\nVehicle Classes with >=5 listings, sorted by avg Depreciation_Ratio:")
print(vehicle_class_dep.head(15))

# Analyze by Fuel Type
fuel_dep = df_valid.groupby('Fuel Type')['Depreciation_Ratio'].agg(['mean', 'count', 'std']).round(3)
fuel_dep = fuel_dep[fuel_dep['count'] >= 5].sort_values('mean', ascending=False)
print("\nFuel Types with >=5 listings, sorted by avg Depreciation_Ratio:")
print(fuel_dep)

# Analyze by Transmission
trans_dep = df_valid.groupby('Transmission')['Depreciation_Ratio'].agg(['mean', 'count', 'std']).round(3)
trans_dep = trans_dep[trans_dep['count'] >= 5].sort_values('mean', ascending=False)
print("\nTransmission types with >=5 listings, sorted by avg Depreciation_Ratio:")
print(trans_dep)

# Scatter of age vs depreciation ratio
print("\nCorrelation between Age_years and Depreciation_Ratio:")
print(df_valid[['Age_years', 'Depreciation_Ratio']].corr())

# Identify specific models with high depreciation ratio (good retention)
model_dep = df_valid.groupby('Model_Group')['Depreciation_Ratio'].agg(['mean', 'count', 'min', 'max', 'std']).round(3)
model_dep = model_dep[model_dep['count'] >= 3].sort_values('mean', ascending=False)
print("\nModel groups with >=3 listings, sorted by avg Depreciation_Ratio:")
print(model_dep.head(20))

# Also consider price absolute value - some expensive cars may have lower ratio but higher absolute value retained
df_valid['Value_Retained'] = df_valid['Price_clean'] * 10000  # in yuan
df_valid['Value_Lost'] = df_valid['New_Price_clean'] - df_valid['Value_Retained']
df_valid['Value_Lost_Per_Year'] = df_valid['Value_Lost'] / df_valid['Age_years']

print("\nTop 10 listings with highest absolute value retained (yuan):")
top_value = df_valid.sort_values('Value_Retained', ascending=False)[['Title', 'Price_clean', 'New_Price_clean', 'Value_Retained', 'Age_years', 'Depreciation_Ratio']].head(10)
print(top_value.to_string())

# Save key tables to CSV for reporting
brand_dep.to_csv('brand_depreciation.csv')
vehicle_class_dep.to_csv('vehicle_class_depreciation.csv')
model_dep.to_csv('model_depreciation.csv')
df_valid.to_csv('valid_listings.csv', index=False)
```
