# Model interaction with region
formula3 = 'active_devices_last_30_days ~ total_update_events * region'
model3 = ols(formula3, data=merged_update).fit()
print("\nUpdate frequency effect on active devices (interaction with region):")
print(model3.summary())

formula4 = 'rolling_total_average_rating ~ total_update_events * region'
model4 = ols(formula4, data=merged_update).fit()
print("\nUpdate frequency effect on rolling rating (interaction with region):")
print(model4.summary())

# Save key results to CSV for reference
decay_df.to_csv('decay_patterns.csv', index=False)

