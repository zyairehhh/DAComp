import sqlite3
import pandas as pd

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-098/stage1_env/dacomp-098.sqlite')

query = '''
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.all_conversation_tags,
    ce.all_conversation_contacts AS contact_id,
    cm.time_to_first_response_minutes
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm USING (conversation_id)
WHERE ce.all_conversation_tags IS NOT NULL
'''
df = pd.read_sql_query(query, conn)

# Parse tags
def extract_tag(tags, key):
    if pd.isna(tags):
        return ''
    parts = tags.split('|')
    for p in parts:
        if p.startswith(key + ':'):
            return p.split(':', 1)[1]
    return ''

df['path'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'path'))
df['stage'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'topic'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'lifecycle'))

df['responder_type'] = df['path'].apply(lambda x: 'bot' if x == 'bot_first' else 'human' if x == 'human_first' else 'unknown')

# Determine first responder type per contact
df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
df = df.sort_values(['contact_id', 'conversation_created_at'])
contact_first = df.groupby('contact_id').first().reset_index()
contact_first = contact_first[['contact_id', 'responder_type', 'intent', 'topic', 'segment', 'region', 'lifecycle']]
contact_first.rename(columns={'responder_type': 'first_responder_type', 'intent': 'first_intent', 'topic': 'first_topic', 'segment': 'first_segment', 'region': 'first_region', 'lifecycle': 'first_lifecycle'}, inplace=True)

# Determine max stage per contact
stage_order = ['contacted', 'marketing_qualified', 'demo_booked', 'trial_started', 'trial_activated', 'proposal_sent', 'closed_won', 'closed_lost', 'expansion_in_flight']
def max_stage(stages):
    max_idx = -1
    for s in stages:
        if s in stage_order:
            idx = stage_order.index(s)
            if idx > max_idx:
                max_idx = idx
    if max_idx >= 0:
        return stage_order[max_idx]
    else:
        return None
contact_stages = df.groupby('contact_id').agg(
    stages=('stage', lambda x: list(x))
).reset_index()
contact_stages['max_stage'] = contact_stages['stages'].apply(max_stage)

contact_stages = contact_stages.merge(contact_first[['contact_id', 'first_responder_type', 'first_intent', 'first_topic', 'first_segment', 'first_region', 'first_lifecycle']], on='contact_id', how='left')

# Conversion definitions
def reached_stage(max_stage, target_list):
    if max_stage is None:
        return False
    return max_stage in target_list

contact_stages['reached_demo'] = contact_stages['max_stage'].apply(lambda x: reached_stage(x, ['demo_booked', 'trial_started', 'trial_activated', 'proposal_sent', 'closed_won', 'expansion_in_flight']))
contact_stages['reached_trial'] = contact_stages['max_stage'].apply(lambda x: reached_stage(x, ['trial_activated', 'proposal_sent', 'closed_won', 'expansion_in_flight']))
contact_stages['reached_paid'] = contact_stages['max_stage'].apply(lambda x: reached_stage(x, ['closed_won', 'expansion_in_flight']))

# Compute conversion rates by first_responder_type and intent
conv_by_intent = contact_stages.groupby(['first_responder_type', 'first_intent']).agg(
    total_contacts=('contact_id', 'count'),
    demo_conversions=('reached_demo', 'sum'),
    trial_conversions=('reached_trial', 'sum'),
    paid_conversions=('reached_paid', 'sum')
).reset_index()
conv_by_intent['demo_rate'] = conv_by_intent['demo_conversions'] / conv_by_intent['total_contacts']
conv_by_intent['trial_rate'] = conv_by_intent['trial_conversions'] / conv_by_intent['total_contacts']
conv_by_intent['paid_rate'] = conv_by_intent['paid_conversions'] / conv_by_intent['total_contacts']

print("Conversion rates by first responder type and intent:")
print(conv_by_intent.to_string())

# Similarly by topic
conv_by_topic = contact_stages.groupby(['first_responder_type', 'first_topic']).agg(
    total_contacts=('contact_id', 'count'),
    demo_conversions=('reached_demo', 'sum'),
    trial_conversions=('reached_trial', 'sum'),
    paid_conversions=('reached_paid', 'sum')
).reset_index()
conv_by_topic['demo_rate'] = conv_by_topic['demo_conversions'] / conv_by_topic['total_contacts']
conv_by_topic['trial_rate'] = conv_by_topic['trial_conversions'] / conv_by_topic['total_contacts']
conv_by_topic['paid_rate'] = conv_by_topic['paid_conversions'] / conv_by_topic['total_contacts']

print("\nConversion rates by first responder type and topic:")
print(conv_by_topic.to_string())

# Also compute average time_to_first_response_minutes by responder_type and intent
time_by_intent = df.groupby(['responder_type', 'intent'])['time_to_first_response_minutes'].mean().reset_index()
print("\nAverage time to first response (minutes) by responder_type and intent:")
print(time_by_intent.to_string())

conn.close()
