high_vol_customers = profitability_df[profitability_df['customer_margin_volatility'] >= volatility_threshold]
low_vol_customers = profitability_df[profitability_df['customer_margin_volatility'] < volatility_threshold]

# Plot distribution
axes[0].hist(profitability_df['customer_margin_volatility'].dropna(), bins=30, alpha=0.7, color='blue', edgecolor='black')
