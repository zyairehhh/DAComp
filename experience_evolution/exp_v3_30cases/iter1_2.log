import pandas as pd
import sqlite3
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
con = sqlite3.connect('/workspace/dacomp-058.sqlite')

# Load campaign report
query = """
SELECT * FROM google_ads__campaign_report
"""
df = pd.read_sql(query, con)
con.close()

# Apply screening
filtered = df[(df['cost'] > 1000) & (df['roas'] < 0.8)].copy()
print(f"Filtered rows: {len(filtered)}")

# Define health score function
def compute_health(row):
    # Normalize each metric within filtered set
    pass

# Let's compute normalized metrics
metrics = ['roas', 'cost_per_conversion', 'conversion_rate', 'ctr', 'quality_score', 'impression_share']
# We'll need avg_position, not present. We'll ignore for now.
# We'll follow Stage1: Cost Efficiency (40%): ROAS (normalized) + inverse of cost per conversion (normalized), equally weighted.
# Conversion Quality (35%): avg of conversion_rate, quality_score, CTR normalized.
# Competitiveness (25%): impression_share (60%) + normalized inverse of avg_position (40%); if avg_position missing, impression_share alone.
# Since avg_position missing, we use impression_share only => weight 100% of competitiveness.

# Compute inverse of cost per conversion (1/cost_per_conversion) but handle inf
filtered['inv_cost_per_conv'] = 1 / filtered['cost_per_conversion']

# Normalization: Min-Max scaling within filtered data
for metric in ['roas', 'inv_cost_per_conv', 'conversion_rate', 'ctr', 'quality_score', 'impression_share']:
    col = filtered[metric]
    min_val = col.min()
    max_val = col.max()
    if max_val - min_val == 0:
        filtered[f'{metric}_norm'] = 0.0
    else:
        filtered[f'{metric}_norm'] = (col - min_val) / (max_val - min_val)

# Cost Efficiency = 0.5 * roas_norm + 0.5 * inv_cost_per_conv_norm
filtered['cost_efficiency'] = 0.5 * filtered['roas_norm'] + 0.5 * filtered['inv_cost_per_conv_norm']

# Conversion Quality = average of conversion_rate_norm, quality_score_norm, ctr_norm
filtered['conversion_quality'] = (filtered['conversion_rate_norm'] + filtered['quality_score_norm'] + filtered['ctr_norm']) / 3

# Competitiveness = impression_share_norm (since no avg_position)
filtered['competitiveness'] = filtered['impression_share_norm']

# Composite health score (0-100)
filtered['health_score'] = (0.4 * filtered['cost_efficiency'] + 0.35 * filtered['conversion_quality'] + 0.25 * filtered['competitiveness']) * 100

# Risk levels based on quartiles
quartiles = filtered['health_score'].quantile([0.25, 0.5, 0.75])
q1 = quartiles[0.25]
q2 = quartiles[0.5]
q3 = quartiles[0.75]

def assign_risk(score):
    if score <= q1:
        return 'Critical'
    elif score <= q2:
        return 'High'
    elif score <= q3:
        return 'Medium'
    else:
        return 'Low'

filtered['risk'] = filtered['health_score'].apply(assign_risk)

# Save for later
filtered.to_csv('/workspace/filtered_campaigns.csv', index=False)

print("Health score computed. Summary:")
print(filtered.groupby('risk').size())
print(filtered[['campaign_type', 'bidding_strategy', 'industry', 'health_score']].head())
