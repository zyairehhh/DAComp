    FROM quickbooks__profitability_analysis
    WHERE customer_id IN ({','.join(['?']*len(high_vol_customers))})
        AND DATE(revenue_month_start) >= DATE('{start_date.date()}')
        AND DATE(revenue_month_start) <= DATE('{max_date.date()}')
    ORDER BY customer_id, revenue_month_start
"""

df = pd.read_sql_query(query, conn, params=high_vol_customers)
print(f"Rows retrieved: {df.shape[0]}")

# Compute coefficient of variation per customer
def coeff_of_variation(series):
    if len(series) < 2:
        return np.nan
    return series.std() / series.mean() if series.mean() != 0 else np.nan

cv_results = df.groupby('customer_id')['gross_profit'].agg(coeff_of_variation).reset_index()
cv_results.rename(columns={'gross_profit': 'gross_profit_cv'}, inplace=True)

# Compute variance of quarter-over-quarter invoice_total growth rate per customer
# We'll compute per quarter total invoice_total per customer, then growth rates, then variance
df['quarter'] = df['revenue_year'].astype(str) + '-Q' + df['revenue_quarter'].astype(str)
quarter_totals = df.groupby(['customer_id', 'quarter'])['invoice_total'].sum().reset_index()
quarter_totals = quarter_totals.sort_values(['customer_id', 'quarter'])

def variance_of_growth_rates(group):
    if len(group) < 2:
        return np.nan
    group = group.sort_values('quarter')
    group['invoice_total_lag'] = group['invoice_total'].shift(1)
    group['growth_rate'] = (group['invoice_total'] - group['invoice_total_lag']) / group['invoice_total_lag'].replace(0, np.nan)
    return group['growth_rate'].var(ddof=0)  # population variance

var_results = quarter_totals.groupby('customer_id').apply(variance_of_growth_rates).reset_index()
var_results.rename(columns={0: 'invoice_total_growth_var'}, inplace=True)

# Merge
metrics = pd.merge(cv_results, var_results, on='customer_id', how='left')
print("\nFirst few rows of computed metrics:")
print(metrics.head(10))
print(f"\nAverage CV: {metrics['gross_profit_cv'].mean():.3f}")
print(f"Average variance of growth rates: {metrics['invoice_total_growth_var'].mean():.3f}")

# Save to CSV for later use
metrics.to_csv('high_vol_metrics.csv', index=False)
print("Metrics saved to high_vol_metrics.csv")

conn.close()
''')
