'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-098.sqlite')
df = pd.read_sql_query("""
SELECT ce.conversation_initiated_type, ce.all_conversation_tags
FROM intercom__conversation_enhanced ce
WHERE ce.all_conversation_tags IS NOT NULL AND ce.all_conversation_tags != ''
""", conn)
conn.close()

# Parse tags
def parse_tags(tag_string):
    d = {}
    parts = tag_string.split('|')
    for part in parts:
        if ':' in part:
            key, val = part.split(':', 1)
            d[key.strip()] = val.strip()
    return d

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['path'] = df['tags_dict'].apply(lambda d: d.get('path', ''))
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))

# Filter to bot_first and human_first
df = df[df['path'].isin(['bot_first', 'human_first'])]

# Compute win rate (stage = closed_won) overall
win_counts = df.groupby('path')['stage'].apply(lambda x: (x == 'closed_won').sum()).reset_index(name='wins')
total_counts = df.groupby('path').size().reset_index(name='total')
win_df = pd.merge(win_counts, total_counts, on='path')
win_df['win_rate'] = win_df['wins'] / win_df['total'] * 100

print("Overall win rate:")
print(win_df)

# Compute win rate by intent
intent_win = df.groupby(['path', 'intent']).apply(lambda g: (g['stage'] == 'closed_won').sum()).reset_index(name='wins')
intent_total = df.groupby(['path', 'intent']).size().reset_index(name='total')
intent_df = pd.merge(intent_win, intent_total, on=['path', 'intent'])
intent_df['win_rate'] = intent_df['wins'] / intent_df['total'] * 100

# Pivot for plotting
pivot = intent_df.pivot(index='intent', columns='path', values='win_rate')
pivot = pivot.dropna(how='all')
print("Win rates by intent:")
print(pivot)

# Plot
fig, ax = plt.subplots(figsize=(10,6))
x = np.arange(len(pivot))
width = 0.35
if 'bot_first' in pivot.columns:
    bot_vals = pivot['bot_first'].values
    ax.bar(x - width/2, bot_vals, width, label='Bot First', color='skyblue')
if 'human_first' in pivot.columns:
    human_vals = pivot['human_first'].values
    ax.bar(x + width/2, human_vals, width, label='Human First', color='lightcoral')
ax.set_xlabel('Intent')
ax.set_ylabel('Win Rate (%)')
ax.set_title('Win Rate (Stage = Closed Won) by Intent and First Response Type')
ax.set_xticks(x)
ax.set_xticklabels(pivot.index, rotation=45)
ax.legend()
plt.tight_layout()
plt.savefig('win_rate_by_intent.png')
plt.close()

# Compute win rate by segment
segment_win = df.groupby(['path', 'segment']).apply(lambda g: (g['stage'] == 'closed_won').sum()).reset_index(name='wins')
segment_total = df.groupby(['path', 'segment']).size().reset_index(name='total')
segment_df = pd.merge(segment_win, segment_total, on=['path', 'segment'])
segment_df['win_rate'] = segment_df['wins'] / segment_df['total'] * 100

pivot2 = segment_df.pivot(index='segment', columns='path', values='win_rate')
pivot2 = pivot2.dropna(how='all')
print("Win rates by segment:")
print(pivot2)

fig, ax = plt.subplots(figsize=(10,6))
x = np.arange(len(pivot2))
if 'bot_first' in pivot2.columns:
    bot_vals = pivot2['bot_first'].values
    ax.bar(x - width/2, bot_vals, width, label='Bot First', color='skyblue')
if 'human_first' in pivot2.columns:
    human_vals = pivot2['human_first'].values
    ax.bar(x + width/2, human_vals, width, label='Human First', color='lightcoral')
ax.set_xlabel('Segment')
ax.set_ylabel('Win Rate (%)')
ax.set_title('Win Rate by Customer Segment and First Response Type')
ax.set_xticks(x)
ax.set_xticklabels(pivot2.index, rotation=45)
ax.legend()
plt.tight_layout()
plt.savefig('win_rate_by_segment.png')
plt.close()

print("Script done.")
''')
