contact_first = df.groupby('contact_id').first().reset_index()
contact_first = contact_first[['contact_id', 'responder_type', 'stage', 'segment', 'region', 'lifecycle']]
contact_first.rename(columns={'responder_type': 'first_responder_type', 'stage': 'first_stage', 'segment': 'first_segment', 'region': 'first_region', 'lifecycle': 'first_lifecycle'}, inplace=True)
