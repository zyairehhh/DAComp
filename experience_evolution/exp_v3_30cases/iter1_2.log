s, SUM(impressions) as total_impressions, SUM(conversions) as total_conversions FROM google_ads__ad_group_report GROUP BY ad_group_id, ad_group_name, campaign_name ), metrics AS ( SELECT *, CASE WHEN total_impressions > 0 THEN total_clicks * 1.0 / total_impressions ELSE NULL END as ctr, CASE WHEN total_clicks > 0 THEN total_conversions * 1.0 / total_clicks ELSE NULL END as cvr FROM aggregated ) SELECT * FROM metrics WHERE ctr IS NOT NULL AND cvr IS NOT NULL;", output="direct")
