We'll create a Python script to compute scoring and generate summary.

Action: CreateFile(filepath='risk_scoring.py':
'''
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-089.sqlite')
threshold = 79621808.0

# Load top accounts with metrics (use previously saved CSV)
top = pd.read_csv('top_accounts_with_risk.csv')
# Ensure columns exist
# Compute deviance scores
# 1. Contact density ratio: benchmark = 5; if below, score = 1 else 0
top['cdr_score'] = (top['contact_density_ratio'] < 5).astype(int)
# 2. Decision-maker ratio: benchmark = 15; if below, score = 1 else 0
# Note: missing ratio treated as 0
top['dmr_score'] = (top['decision_maker_ratio'] < 15).astype(int)
# 3. Department coverage: benchmark = 4; missing departments count = 4 - coverage
# but if coverage >4 (impossible) treat as 0
top['coverage_missing'] = 4 - top['key_dept_coverage']
top['coverage_missing'] = top['coverage_missing'].clip(lower=0)
# Scaling: we can assign coverage_missing as points (0-4)
# Total risk score (0-6)
top['risk_score'] = top['cdr_score'] + top['dmr_score'] + top['coverage_missing']

# Define risk levels: 0-2 Low, 3-4 Medium, 5-6 High
def risk_level(score):
    if score <= 2:
        return 'Low'
    elif score <= 4:
        return 'Medium'
    else:
        return 'High'

top['risk_level'] = top['risk_score'].apply(risk_level)

print("Risk Score Distribution:")
print(top['risk_level'].value_counts())
print("\nRisk Score counts:")
print(top['risk_score'].value_counts().sort_index())

# Identify high-risk accounts (risk level High)
high_risk = top[top['risk_level']=='High']
print(f"\nNumber of High-risk accounts: {len(high_risk)}")
if len(high_risk) > 0:
    print(high_risk[['account_id','account_name','contact_density_ratio','decision_maker_ratio','key_dept_coverage','risk_score']].head())

# Save with risk levels
top.to_csv('top_accounts_risk_scored.csv', index=False)
print("\nSaved to top_accounts_risk_scored.csv")

# Compare across industries
industry_summary = top.groupby('industry_normalized').agg(
    count=('account_id','count'),
    avg_risk_score=('risk_score','mean'),
    high_pct=('risk_level', lambda x: (x=='High').mean()*100)
).reset_index().sort_values('avg_risk_score', ascending=False)
print("\nIndustry risk summary:")
print(industry_summary)

conn.close()
''')
