'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-089.sqlite')

# Load accounts
accounts = pd.read_sql_query("""
    SELECT account_id, account_name, annual_revenue, number_of_employees,
           total_contacts, industry_normalized, account_size_segment,
           company_size_category, geographic_region
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL AND number_of_employees > 0
""", conn)

# Top 20% revenue
threshold = accounts['annual_revenue'].quantile(0.8)
top = accounts[accounts['annual_revenue'] >= threshold].copy()
print(f"Top 20% revenue accounts: {len(top)}")

# Load contacts
top_ids = top['account_id'].tolist()
placeholders = ','.join(['?'] * len(top_ids))
contacts = pd.read_sql_query(f"""
    SELECT account_id, contact_id, title, department
    FROM salesforce__contact_enhanced
    WHERE account_id IN ({placeholders})
""", conn, params=top_ids)

# Decision-maker flag
contacts['is_decision_maker'] = contacts['title'].fillna('').str.contains('Chief|VP|Vice President', case=False, na=False)

# Aggregate per account
agg = contacts.groupby('account_id').agg(
    decision_makers=('is_decision_maker', 'sum'),
    total_contacts_agg=('contact_id', 'count'),
    departments=('department', lambda x: [d for d in x.dropna().unique() if d is not None])
).reset_index()

top = top.merge(agg, on='account_id', how='left')
top['decision_makers'] = top['decision_makers'].fillna(0)
top['total_contacts_agg'] = top['total_contacts_agg'].fillna(0)

# Metrics
top['contact_density_ratio'] = top['total_contacts'] / top['number_of_employees'] * 1000
top['decision_maker_ratio'] = top['decision_makers'] / top['total_contacts_agg'].replace(0, np.nan) * 100

# Department coverage: key depts Sales, Finance, Operations, Engineering (as IT), HR
key_departments = ['Sales', 'Finance', 'Operations', 'Engineering', 'HR']
def count_coverage(dept_list):
    if isinstance(dept_list, list):
        return sum(1 for dept in dept_list if dept in key_departments)
    return 0

top['covered'] = top['departments'].apply(count_coverage)
top['coverage_completeness'] = top['covered'] / len(key_departments) * 100

# Risk flags with standard benchmarks
top['density_risk'] = top['contact_density_ratio'] < 5
top['decision_maker_risk'] = top['decision_maker_ratio'] < 15
top['coverage_risk'] = top['coverage_completeness'] < 100
top['total_risks'] = top[['density_risk', 'decision_maker_risk', 'coverage_risk']].sum(axis=1)

# Summary metrics
summary = pd.DataFrame({
    'Metric': ['Contact Density Ratio', 'Decision-Maker Ratio', 'Departmental Coverage Completeness'],
    'Mean': [top['contact_density_ratio'].mean(), top['decision_maker_ratio'].mean(), top['coverage_completeness'].mean()],
    'Median': [top['contact_density_ratio'].median(), top['decision_maker_ratio'].median(), top['coverage_completeness'].median()],
    'Below Benchmark %': [
        (top['contact_density_ratio'] < 5).mean() * 100,
        (top['decision_maker_ratio'] < 15).mean() * 100,
        (top['coverage_completeness'] < 100).mean() * 100
    ]
})
print("\n=== Overall Metrics (Standard Benchmark) ===")
print(summary.round(2))

print("\n=== Risk Distribution ===")
risk_dist = top['total_risks'].value_counts().sort_index()
for risks, cnt in risk_dist.items():
    print(f"{risks} risk(s): {cnt} accounts ({cnt/len(top):.1%})")
high_risk = len(top[top['total_risks'] >= 2])
print(f"High-risk accounts (>=2 risks): {high_risk} ({high_risk/len(top):.1%})")

# Industry-specific benchmarks
print("\n=== Industry-Specific Benchmark Medians ===")
industry_medians = top.groupby('industry_normalized').agg(
    median_density=('contact_density_ratio', 'median'),
    median_decision_maker=('decision_maker_ratio', 'median'),
    median_coverage=('coverage_completeness', 'median'),
    account_count=('account_id', 'count')
).round(2)
print(industry_medians.sort_values('median_density', ascending=False).head(20))

# Size-specific benchmarks
print("\n=== Size-Specific Benchmark Medians ===")
size_medians = top.groupby('company_size_category').agg(
    median_density=('contact_density_ratio', 'median'),
    median_decision_maker=('decision_maker_ratio', 'median'),
    median_coverage=('coverage_completeness', 'median'),
    account_count=('account_id', 'count')
).round(2)
print(size_medians)

# Differentiated risk assessment (using industry median as benchmark)
top_adj = top.copy()
for industry in top_adj['industry_normalized'].unique():
    mask = top_adj['industry_normalized'] == industry
    if mask.sum() < 5:
        continue
    sub = top_adj[mask]
    top_adj.loc[mask, 'density_bench'] = sub['contact_density_ratio'].median()
    top_adj.loc[mask, 'dm_bench'] = sub['decision_maker_ratio'].median()
    top_adj.loc[mask, 'cov_bench'] = sub['coverage_completeness'].median()

# Fill missing with global median
for col in ['density_bench', 'dm_bench', 'cov_bench']:
    top_adj[col] = top_adj[col].fillna(top_adj[col].median())

top_adj['density_risk_adj'] = top_adj['contact_density_ratio'] < top_adj['density_bench']
top_adj['decision_maker_risk_adj'] = top_adj['decision_maker_ratio'] < top_adj['dm_bench']
