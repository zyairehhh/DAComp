'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect("dacomp-066.sqlite")

# Join tables
query = """
SELECT 
    p.job_id,
    p.job_title,
    p.application_year,
    p.application_quarter,
    p.interview_rate,
    e.departments,
    e.hiring_managers
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
WHERE e.departments = 'Engineering'
"""
df = pd.read_sql_query(query, conn)

# Define role categories based on job_title keywords
def categorize_role(title):
    title_low = title.lower()
    if 'frontend' in title_low:
        return 'Frontend'
    elif 'backend' in title_low:
        return 'Backend'
    elif 'data engineer' in title_low:
        return 'Data Engineer'
    elif 'full stack' in title_low:
        return 'Full Stack'
    elif 'devops' in title_low:
        return 'DevOps'
    elif 'machine learning' in title_low or 'ml' in title_low:
        return 'Machine Learning'
    elif 'qa' in title_low or 'quality assurance' in title_low:
        return 'QA'
    elif 'mobile' in title_low:
        return 'Mobile'
    else:
        return 'Other'

df['role'] = df['job_title'].apply(categorize_role)

# Compute average conversion rate by role and quarter
grouped = df.groupby(['role', 'application_year', 'application_quarter'])['interview_rate'].mean().reset_index()
grouped['quarter_label'] = grouped['application_year'].astype(str) + 'Q' + grouped['application_quarter'].astype(str)

# Sort quarters chronologically
grouped = grouped.sort_values(['application_year', 'application_quarter'])

# Pivot for easier plotting
pivot = grouped.pivot(index='role', columns='quarter_label', values='interview_rate')
print("Conversion rates by role (quarterly):")
print(pivot.round(2))

# Compute change from Q3 to Q4 (2024 Q3 to Q4)
q3 = grouped[grouped['quarter_label'] == '2024Q3'].set_index('role')['interview_rate']
q4 = grouped[grouped['quarter_label'] == '2024Q4'].set_index('role')['interview_rate']
change = (q4 - q3).dropna()
change_sorted = change.sort_values()
print("\nChange in conversion rate (Q4 - Q3):")
print(change_sorted.round(2))

# Identify top declining roles (largest negative change)
declining = change_sorted[change_sorted < 0]
if not declining.empty:
    print("\nRoles with largest decline:")
    for role, chg in declining.head(5).items():
        print(f"{role}: {chg:.2f}% points")

conn.close()
''')
