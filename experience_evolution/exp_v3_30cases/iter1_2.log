import sqlite3
import pandas as pd
import numpy as np
import re

conn = sqlite3.connect('dacomp-100.sqlite')

# Load company_metrics
df_metrics = pd.read_sql_query("SELECT * FROM intercom__company_metrics", conn)
# Load company_enhanced for tags
df_tags = pd.read_sql_query("SELECT company_id, all_company_tags FROM intercom__company_enhanced", conn)

# Parse tags
def parse_tags(tag_string):
    if not tag_string:
        return {}
    tags = tag_string.split('|')
    parsed = {}
    for tag in tags:
        if '=' in tag:
            key, val = tag.split('=', 1)
            parsed[key] = val
    return parsed

tag_data = df_tags['all_company_tags'].apply(parse_tags)
tag_df = pd.json_normalize(tag_data)
df_tags = pd.concat([df_tags[['company_id']], tag_df], axis=1)

# Extract feature adoption percentage
def extract_percentage(s):
    if pd.isna(s):
        return None
    match = re.search(r'\((\d+)%\)', s)
    if match:
        return int(match.group(1))
    else:
        num = re.search(r'(\d+)%', s)
        if num:
            return int(num.group(1))
    return None

df_tags['feature_adoption_pct'] = df_tags['feature_adoption'].apply(extract_percentage)
df_tags['renewal_window'] = df_tags['renewal_window']
df_tags['contract_size'] = df_tags['contract_size']
df_tags['industry'] = df_tags['industry']
df_tags['acv_usd'] = pd.to_numeric(df_tags['acv_usd'], errors='coerce')
df_tags['health_score'] = pd.to_numeric(df_tags['health_score'], errors='coerce')

# Merge metrics with tags
df = df_metrics.merge(df_tags, on='company_id', how='inner')

print(f"Total companies merged: {len(df)}")

# Define features
# Communication & Interaction: average number of conversations over last 30 days? Not available.
# Use total_conversations as proxy for engagement.
# However, total_conversations is cumulative over company lifetime.
# We'll create a feature: conversations per day = total_conversations / company_age_days? but company_age_days not in metrics.
# Instead use contacts_active_30d as proxy for recent interactions.
df['comm_avg_convs_last30'] = df['contacts_active_30d']  # number of active contacts in last 30 days

# Proportion of negative sentiment: avg_conversation_rating (scale likely 1-5). Define negative if rating < 3.
df['prop_negative_sentiment'] = (df['avg_conversation_rating'] < 3).astype(float)
# Actually we need proportion of conversations with negative rating. Not available. Use average rating as proxy.

# Support Experience Features:
# average resolution time: p50_time_to_last_close_min (median minutes)
df['avg_resolution_time'] = df['p50_time_to_last_close_min']
# proportion of reopened conversations: p50_reopens (median count) but need proportion.
# Use p50_reopens as proxy for reopen rate.
df['prop_reopened'] = df['p50_reopens'] / df['total_conversations_closed'].clip(lower=1)

# Product Value Features:
df['feature_adoption_pct'] = df['feature_adoption_pct']
# time since last value milestone not available

# Target variable: renewal_window (inside_90_days, within_30_days_past, future_90_plus)
df['target_inside'] = (df['renewal_window'] == 'inside_90_days').astype(int)
df['target_past'] = (df['renewal_window'] == 'within_30_days_past').astype(int)
df['target_future'] = (df['renewal_window'] == 'future_90_plus').astype(int)

# Filter out rows with missing key values
features_list = ['comm_avg_convs_last30', 'avg_conversation_rating', 'prop_negative_sentiment', 'avg_resolution_time', 'prop_reopened', 'feature_adoption_pct']
df_clean = df.dropna(subset=features_list)
print(f"Companies with complete features: {len(df_clean)}")

# Save feature dataset
df_clean.to_csv('renewal_features.csv', index=False)

# Descriptive analysis
print("\n=== Renewal Window Distribution ===")
print(df_clean['renewal_window'].value_counts())

print("\n=== Mean Feature Values by Renewal Window ===")
for window in ['inside_90_days', 'within_30_days_past', 'future_90_plus']:
    subset = df_clean[df_clean['renewal_window'] == window]
    print(f"\n{window} (N={len(subset)}):")
    for feat in features_list:
        mean_val = subset[feat].mean()
        median_val = subset[feat].median()
        std_val = subset[feat].std()
        print(f"  {feat}: mean={mean_val:.4f}, median={median_val:.4f}, std={std_val:.4f}")

# Compute discriminative power using simple AUC approximation (Mann-Whitney U via manual)
def compute_auc_binary(feature, target):
    # target = 1 for inside_90_days, 0 for future_90_plus
    pos = feature[target == 1].values
    neg = feature[target == 0].values
    n_pos = len(pos)
    n_neg = len(neg)
    if n_pos == 0 or n_neg == 0:
        return None
    count = 0
    for p in pos:
        for n in neg:
            if p > n:
                count += 1
            elif p == n:
                count += 0.5
    auc = count / (n_pos * n_neg)
    return auc

print("\n=== AUC (Inside vs Future) for each feature ===")
inside_future = df_clean[df_clean['renewal_window'].isin(['inside_90_days', 'future_90_plus'])]
for feat in features_list:
    auc = compute_auc_binary(inside_future[feat], inside_future['target_inside'])
    print(f"{feat}: AUC = {auc:.4f}")

# Segmentation by industry and contract size
# Industry from tags, contract_size from tags
print("\n=== Segmentation by Industry and Contract Size ===")
top_industries = df_clean['industry'].value_counts().head(5).index
for ind in top_industries:
    for size in df_clean['contract_size'].dropna().unique():
        subset = df_clean[(df_clean['industry'] == ind) & (df_clean['contract_size'] == size)]
        inside_sub = subset[subset['renewal_window'] == 'inside_90_days']
        future_sub = subset[subset['renewal_window'] == 'future_90_plus']
        if len(inside_sub) > 3 and len(future_sub) > 3:
            print(f"\nIndustry: {ind}, Contract Size: {size}")
            print(f"  Inside N={len(inside_sub)}, Future N={len(future_sub)}")
            for feat in features_list:
                diff = inside_sub[feat].mean() - future_sub[feat].mean()
                auc = compute_auc_binary(subset[feat], subset['target_inside'])
                print(f"  {feat}: diff={diff:.2f}, AUC={auc:.2f}")

conn.close()
```
