Action: CreateFile(filepath='/workspace/extract_tags.sql':
'''
SELECT conversation_id,
       conversation_created_at,
       conversation_assignee_type,
       first_admin_response_at,
       time_to_first_response_minutes,
       all_conversation_tags,
       CASE
           WHEN all_conversation_tags LIKE '%path:bot_first%' THEN 'bot'
           WHEN all_conversation_tags LIKE '%path:human_first%' THEN 'human'
           ELSE 'unknown'
       END AS responder_type,
       CASE
           WHEN all_conversation_tags LIKE '%intent:%' THEN
               substr(all_conversation_tags,
                      instr(all_conversation_tags, 'intent:') + 7,
                      instr(substr(all_conversation_tags, instr(all_conversation_tags, 'intent:') + 7), '|') - 1
               )
           ELSE ''
       END AS intent,
       CASE
           WHEN all_conversation_tags LIKE '%topic:%' THEN
               substr(all_conversation_tags,
                      instr(all_conversation_tags, 'topic:') + 6,
                      instr(substr(all_conversation_tags, instr(all_conversation_tags, 'topic:') + 6), '|') - 1
               )
           ELSE ''
       END AS topic,
       CASE
           WHEN all_conversation_tags LIKE '%stage:%' THEN
               substr(all_conversation_tags,
                      instr(all_conversation_tags, 'stage:') + 6,
                      instr(substr(all_conversation_tags, instr(all_conversation_tags, 'stage:') + 6), '|') - 1
               )
           ELSE ''
       END AS stage,
       CASE
           WHEN all_conversation_tags LIKE '%segment:%' THEN
               substr(all_conversation_tags,
                      instr(all_conversation_tags, 'segment:') + 8,
                      instr(substr(all_conversation_tags, instr(all_conversation_tags, 'segment:') + 8), '|') - 1
               )
           ELSE ''
       END AS segment,
       CASE
           WHEN all_conversation_tags LIKE '%region:%' THEN
               substr(all_conversation_tags,
                      instr(all_conversation_tags, 'region:') + 7,
                      instr(substr(all_conversation_tags, instr(all_conversation_tags, 'region:') + 7), '|') - 1
               )
           ELSE ''
       END AS region,
       CASE
           WHEN all_conversation_tags LIKE '%lifecycle:%' THEN
               substr(all_conversation_tags,
                      instr(all_conversation_tags, 'lifecycle:') + 10,
                      LENGTH(all_conversation_tags) - instr(all_conversation_tags, 'lifecycle:') - 9
               )
           ELSE ''
       END AS lifecycle
FROM intercom__conversation_enhanced
LEFT JOIN intercom__conversation_metrics USING (conversation_id)
WHERE all_conversation_tags IS NOT NULL
LIMIT 10;
''')
