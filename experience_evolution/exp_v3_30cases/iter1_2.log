import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-066/stage1_env/dacomp-066.sqlite')

query = """
SELECT created_year, created_month, 
       substr(name, 1, instr(name, ' - ') - 1) as role_category,
       AVG(application_to_interview_rate) as avg_conversion_rate,
       COUNT(*) as job_count
FROM greenhouse__job_enhanced
WHERE departments='Engineering'
GROUP BY created_year, created_month, role_category
ORDER BY role_category, created_year, created_month;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Pivot to have months as columns
pivot = df.pivot_table(index='role_category', 
                       columns=['created_year','created_month'], 
                       values='avg_conversion_rate',
                       aggfunc='first')

# Compute July (2024-7) and December (2024-12) rates
july_rate = pivot[(2024, 7)]
dec_rate = pivot[(2024, 12)]
change = dec_rate - july_rate
pct_change = (change / july_rate) * 100

# Create summary DataFrame
summary = pd.DataFrame({
    'role_category': july_rate.index,
    'july_rate': july_rate.values,
    'dec_rate': dec_rate.values,
    'absolute_change': change.values,
    'percent_change': pct_change.values
})

# Sort by absolute decline (most negative)
summary = summary.sort_values('absolute_change').reset_index(drop=True)
print("Role conversion rate decline (July vs December):")
print(summary.to_string(index=False))

# Also compute average across the first 3 months (Jul-Sep) vs last 3 months (Oct-Dec)
first_months = [(2024,7),(2024,8),(2024,9)]
last_months = [(2024,10),(2024,11),(2024,12)]
first_avg = pivot[first_months].mean(axis=1)
last_avg = pivot[last_months].mean(axis=1)
avg_change = last_avg - first_avg
avg_pct_change = (avg_change / first_avg) * 100

summary2 = pd.DataFrame({
    'role_category': first_avg.index,
    'avg_first_3_months': first_avg.values,
    'avg_last_3_months': last_avg.values,
    'absolute_change': avg_change.values,
    'percent_change': avg_pct_change.values
}).sort_values('absolute_change')

print("\n\nRole conversion rate decline (first 3 months vs last 3 months):")
print(summary2.to_string(index=False))
```
