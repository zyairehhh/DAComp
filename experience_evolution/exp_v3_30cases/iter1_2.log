plt.grid(True, alpha=0.3, axis='y')
plt.tight_layout()
plt.savefig('conversions_per_impression_comparison.png', dpi=150)
plt.close()

# 7. Create summary statistics file
print("Creating summary statistics...")
summary_stats = {
    'Total ad groups analyzed': len(df),
    'Problematic ad groups identified': len(problematic),
    'Percentage problematic': f"{len(problematic)/len(df)*100:.1f}%",
    'Average CTR (problematic)': f"{problematic['CTR'].mean():.4f}",
    'Average CTR (all)': f"{df['CTR'].mean():.4f}",
    'Average CVR (problematic)': f"{problematic['CVR'].mean():.4f}",
    'Average CVR (all)': f"{df['CVR'].mean():.4f}",
    'Mean Intent-Match Ratio': f"{problematic['Intent_Match_Ratio'].mean():.3f}",
    'Conversions per impression (problematic)': f"{problematic['Conversions_per_Impression'].mean():.6f}",
    'Conversions per impression (all)': f"{df['Conversions_per_Impression'].mean():.6f}",
    'Relative performance difference': f"{(problematic['Conversions_per_Impression'].mean()/df['Conversions_per_Impression'].mean() - 1)*100:.1f}% lower"
}

with open('visualization_summary.txt', 'w') as f:
    f.write("SUMMARY STATISTICS FOR VISUALIZATIONS\n")
    f.write("="*50 + "\n")
    for key, value in summary_stats.items():
        f.write(f"{key}: {value}\n")

conn.close()
print("Visualizations generated successfully!")
