print(others_browse[['total_browse_time','total_likes','total_shares','total_add_to_cart']].mean())

# Identify which attributes are most predictive (simple mean comparison)
# We'll compute average profit per segment
segment_profit = full_df.groupby('Customer Segment')['total_profit'].mean().sort_values(ascending=False)
print("\nAverage total profit by Customer Segment:")
print(segment_profit)
region_profit = full_df.groupby('Region')['total_profit'].mean().sort_values(ascending=False)
print("\nAverage total profit by Region:")
print(region_profit)
gender_profit = full_df.groupby('gender')['total_profit'].mean().sort_values(ascending=False)
print("\nAverage total profit by gender:")
print(gender_profit)
education_profit = full_df.groupby('Education Level')['total_profit'].mean().sort_values(ascending=False)
print("\nAverage total profit by Education Level:")
print(education_profit)

# Save results to CSV for further inspection
full_df.to_csv('fashion_customer_profit.csv', index=False)
print("\nSaved detailed data to fashion_customer_profit.csv")

conn.close()
