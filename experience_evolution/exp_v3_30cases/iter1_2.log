Action: CreateFile(filepath='plot_deviation_by_risk.py':
'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Group by Risk Level
risk_stats = df.groupby('Risk Level')['Deviation'].agg(['mean', 'std', 'count']).reset_index()
# Order manually: Low, Medium, High
risk_order = ['Low', 'Medium', 'High']
risk_stats = risk_stats.set_index('Risk Level').reindex(risk_order).reset_index()

fig, ax = plt.subplots(figsize=(8, 6))
bars = ax.bar(risk_stats['Risk Level'], risk_stats['mean'],
              yerr=risk_stats['std'], capsize=7, color=['green', 'orange', 'red'], edgecolor='black')
ax.set_xlabel('Risk Level', fontsize=12)
ax.set_ylabel('Average Cost Deviation', fontsize=12)
ax.set_title('Average Cost Deviation by Risk Level', fontsize=14, pad=15)
ax.grid(True, alpha=0.3, axis='y')

# Add value labels
for bar, mean_val in zip(bars, risk_stats['mean']):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2., height + 5,
            f'{mean_val:.1f}', ha='center', va='bottom', fontsize=10, fontweight='bold')

# Annotate insight
ax.text(0.05, 0.95, 'Medium‑Risk projects have largest deviation\nHigh‑Risk moderate, Low‑Risk lowest',
        transform=ax.transAxes, fontsize=10, verticalalignment='top',
        bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.8))

plt.tight_layout()
plt.savefig('deviation_by_risk.png', dpi=150)
print("Saved deviation_by_risk.png")
''')
