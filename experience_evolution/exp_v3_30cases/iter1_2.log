```
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# Load parsed data
df = pd.read_csv('conversations_parsed.csv')
print(df.head())

# 1. Stage distribution by path
stage_order = ['demo_booked', 'trial_started', 'trial_activated', 'closed_won', 'closed_lost', 'proposal_sent', 'marketing_qualified', 'expansion_in_flight', 'contacted']
# Filter to relevant stages
df_stage = df[df['stage'].isin(stage_order)]
# Compute counts and proportions
stage_counts = df_stage.groupby(['path', 'stage']).size().unstack(fill_value=0)
stage_counts_percent = stage_counts.div(stage_counts.sum(axis=1), axis=0) * 100

# Plot stacked bar chart
fig, axes = plt.subplots(1, 2, figsize=(14, 6))
stage_counts.plot(kind='bar', stacked=True, ax=axes[0])
axes[0].set_title('Stage Count by First Response Type')
axes[0].set_ylabel('Number of Conversations')
axes[0].tick_params(axis='x', rotation=45)

stage_counts_percent.plot(kind='bar', stacked=True, ax=axes[1])
axes[1].set_title('Stage Distribution (%) by First Response Type')
axes[1].set_ylabel('Percentage')
axes[1].tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('stage_distribution_by_path.png')
plt.close()

# 2. Conversion rates for key funnel stages
funnel_stages = ['demo_booked', 'trial_activated', 'closed_won']
# Compute conversion rates as proportion of total conversations for each path
total_by_path = df['path'].value_counts()
conversion_rates = {}
for stage in funnel_stages:
    stage_counts_by_path = df[df['stage'] == stage].groupby('path').size()
    conversion_rates[stage] = stage_counts_by_path / total_by_path * 100

conversion_df = pd.DataFrame(conversion_rates).reset_index()
conversion_df_melted = pd.melt(conversion_df, id_vars='path', var_name='stage', value_name='conversion_rate')
conversion_df_melted['conversion_rate'] = conversion_df_melted['conversion_rate'].fillna(0)

plt.figure(figsize=(10,6))
sns.barplot(data=conversion_df_melted, x='stage', y='conversion_rate', hue='path')
plt.title('Conversion Rate by Stage and First Response Type')
plt.ylabel('Conversion Rate (%)')
plt.xlabel('Stage')
plt.savefig('conversion_rate_by_stage.png')
plt.close()

# 3. Response time analysis
# Time to first response
plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
sns.boxplot(data=df, x='path', y='time_to_first_response_minutes')
plt.title('Time to First Response by First Response Type')
plt.ylabel('Minutes')
plt.subplot(1,2,2)
sns.boxplot(data=df, x='path', y='time_to_admin_first_close_minutes')
plt.title('Time to Admin First Close by First Response Type')
plt.ylabel('Minutes')
plt.tight_layout()
plt.savefig('response_time_comparison.png')
plt.close()

# 4. Intent analysis - simpler: demo booked rate by intent and path
intent_counts = df['intent'].value_counts()
top_intents = intent_counts.head(5).index
df_intent = df[df['intent'].isin(top_intents)]
demo_rates = df_intent[df_intent['stage'] == 'demo_booked'].groupby(['intent', 'path']).size() / df_intent.groupby(['intent', 'path']).size() * 100
demo_rates = demo_rates.reset_index(name='demo_rate')
plt.figure(figsize=(10,6))
sns.barplot(data=demo_rates, x='intent', y='demo_rate', hue='path')
plt.title('Demo Booked Rate by Intent and First Response Type')
plt.ylabel('Demo Booked Rate (%)')
plt.xlabel('Intent')
plt.tight_layout()
plt.savefig('demo_rate_by_intent.png')
plt.close()

print("Plots generated.")
