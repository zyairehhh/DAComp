    INNER JOIN candidates c USING (account_id, advertising_channel_type, advertising_channel_subtype)
),
max_dates AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        MAX(date) as max_date
    FROM daily_data
    GROUP BY 1,2,3
),
periods AS (
    SELECT 
        d.*,
        m.max_date,
        julianday(m.max_date) - julianday(d.date) as days_ago
    FROM daily_data d
    LEFT JOIN max_dates m USING (account_id, advertising_channel_type, advertising_channel_subtype)
),
recent AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        AVG(cac) as avg_cac_recent,
        AVG(ltv_cac) as avg_ltv_cac_recent,
        COUNT(*) as n_recent
    FROM periods
    WHERE days_ago <= 30
    GROUP BY 1,2,3
    HAVING n_recent >= 1
),
prior AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        AVG(cac) as avg_cac_prior,
        AVG(ltv_cac) as avg_ltv_cac_prior,
        COUNT(*) as n_prior
    FROM periods
    WHERE days_ago > 30 AND days_ago <= 60
    GROUP BY 1,2,3
    HAVING n_prior >= 1
)
SELECT 
    c.*,
    COALESCE(r.avg_cac_recent, 0) as avg_cac_recent,
    COALESCE(r.avg_ltv_cac_recent, 0) as avg_ltv_cac_recent,
    COALESCE(r.n_recent, 0) as n_recent,
    COALESCE(p.avg_cac_prior, 0) as avg_cac_prior,
    COALESCE(p.avg_ltv_cac_prior, 0) as avg_ltv_cac_prior,
    COALESCE(p.n_prior, 0) as n_prior,
    CASE WHEN p.avg_cac_prior > 0 THEN (COALESCE(r.avg_cac_recent,0) - p.avg_cac_prior) / p.avg_cac_prior ELSE NULL END as cac_growth_rate,
    CASE WHEN p.avg_ltv_cac_prior > 0 THEN (COALESCE(r.avg_ltv_cac_recent,0) - p.avg_ltv_cac_prior) / p.avg_ltv_cac_prior ELSE NULL END as ltv_cac_change
FROM candidates c
LEFT JOIN recent r USING (account_id, advertising_channel_type, advertising_channel_subtype)
LEFT JOIN prior p USING (account_id, advertising_channel_type, advertising_channel_subtype)
WHERE r.n_recent > 0 AND p.n_prior > 0
'''
df = pd.read_sql_query(query, conn)
print(f"Candidates with both recent and prior data: {len(df)}")
if len(df) > 0:
    print(df.head())
    # filter for CAC growth > 25% and LTV/CAC decline >20%
    df_decay = df[(df['cac_growth_rate'] > 0.25) & (df['ltv_cac_change'] < -0.20)]
    print(f"\nDecay campaigns count: {len(df_decay)}")
    print(df_decay.head())
''')
