"""
Demo of the proposed multi‑dimensional customer value score.
Run this script to compute the score for the example accounts.
"""
import sqlite3
import pandas as pd
import numpy as np

def compute_customer_value_score(conn):
    df = pd.read_sql_query("""
        SELECT account_id, sum_minutes, sum_events, avg_nps_rating,
               count_active_days, count_active_months,
               count_feature_clicking_visitors, count_page_viewing_visitors,
               count_associated_visitors, first_event_on, last_event_on
        FROM pendo__account
    """, conn)
    
    # Convert dates
    df['first_event_on'] = pd.to_datetime(df['first_event_on'])
    df['last_event_on'] = pd.to_datetime(df['last_event_on'])
    cutoff = pd.to_datetime('2024-09-01')
    
    # Compute derived features
    df['recency_days'] = (cutoff - df['last_event_on']).dt.days
    df['tenure_days'] = (df['last_event_on'] - df['first_event_on']).dt.days
    
    # Normalize features (min‑max scaling)
    features = ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days',
                'count_active_months', 'count_feature_clicking_visitors',
                'count_page_viewing_visitors', 'count_associated_visitors',
                'recency_days', 'tenure_days']
    
    for col in features:
        min_val = df[col].min()
        max_val = df[col].max()
        if max_val > min_val:
            df[f'n_{col}'] = (df[col] - min_val) / (max_val - min_val)
        else:
            df[f'n_{col}'] = 0.0
    
    # Weights derived from correlation analysis
    weights = {
        'n_sum_minutes': 0.0825,
        'n_sum_events': 0.0865,
        'n_avg_nps_rating': 0.0087,
        'n_count_active_days': 0.1756,
        'n_count_active_months': 0.1715,
        'n_count_feature_clicking_visitors': 0.0068,
        'n_count_page_viewing_visitors': 0.0075,
        'n_count_associated_visitors': 0.0078,
        'n_recency_days': 0.2266,
        'n_tenure_days': 0.2265,
    }
    
    # Compute weighted sum
    df['value_score'] = sum(df[key] * w for key, w in weights.items())
    
    # Classify high‑value (threshold = 0.46 for retention)
    df['predicted_high_value'] = df['value_score'] > 0.46
    
    # Return top 10 accounts by score
    top10 = df[['account_id', 'value_score', 'predicted_high_value']].sort_values('value_score', ascending=False).head(10)
    return top10

if __name__ == '__main__':
    conn = sqlite3.connect('dacomp-078.sqlite')
    result = compute_customer_value_score(conn)
    print("Top 10 accounts by proposed multi‑dimensional value score:")
    print(result.to_string(index=False))
    conn.close()
