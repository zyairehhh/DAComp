import pandas as pd
import numpy as np
import sqlite3
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-092.sqlite')

# ========== PART 1: Identify high-volatility customers ==========
vol_df = pd.read_sql_query("""
    SELECT DISTINCT customer_id, customer_margin_volatility
    FROM quickbooks__profitability_analysis
    WHERE customer_margin_volatility IS NOT NULL
""", conn)
threshold = vol_df['customer_margin_volatility'].quantile(0.75)
high_vol_ids = vol_df[vol_df['customer_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers: {len(high_vol_ids)} (threshold={threshold:.4f})")

# ========== PART 2: Coefficient of variation of gross_profit ==========
# Use past 12 months from max date
max_date_str = pd.read_sql_query("SELECT MAX(revenue_month_start) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'][0]
max_date = pd.to_datetime(max_date_str).date()
start_date = (max_date - timedelta(days=365)).strftime('%Y-%m-%d')
max_date_str = max_date.strftime('%Y-%m-%d')

query_high = f"""
    SELECT customer_id, revenue_month_start, gross_profit, invoice_total
    FROM quickbooks__profitability_analysis
    WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
        AND DATE(revenue_month_start) >= DATE('{start_date}')
        AND DATE(revenue_month_start) <= DATE('{max_date_str}')
"""
df_high = pd.read_sql_query(query_high, conn, params=high_vol_ids)
df_high['revenue_month_start'] = pd.to_datetime(df_high['revenue_month_start'])

def coeff_of_variation(series):
    if len(series) < 2 or series.mean() == 0:
        return np.nan
    return series.std() / series.mean()

cv_per_customer = df_high.groupby('customer_id')['gross_profit'].agg(coeff_of_variation).reset_index()
cv_per_customer.rename(columns={'gross_profit':'gross_profit_cv'}, inplace=True)
print(f"Coefficient of variation computed for {cv_per_customer['gross_profit_cv'].notna().sum()} customers.")

# ========== PART 3: Variance of quarter-over-quarter invoice_total growth rate ==========
# Compute quarterly total invoice per customer
df_high['quarter'] = df_high['revenue_month_start'].dt.to_period('Q')
quarterly = df_high.groupby(['customer_id', 'quarter'])['invoice_total'].sum().reset_index()
quarterly = quarterly.sort_values(['customer_id', 'quarter'])

def var_growth_rate(group):
    if len(group) < 2:
        return np.nan
    group['invoice_total_lag'] = group['invoice_total'].shift(1)
    group['growth_rate'] = (group['invoice_total'] - group['invoice_total_lag']) / group['invoice_total_lag'].replace(0, np.nan)
    return group['growth_rate'].var(ddof=0)

growth_var = quarterly.groupby('customer_id').apply(var_growth_rate).reset_index(name='invoice_total_growth_var')
metrics = pd.merge(cv_per_customer, growth_var, on='customer_id', how='left')
print(f"Average CV: {metrics['gross_profit_cv'].mean():.3f}, Average variance: {metrics['invoice_total_growth_var'].mean():.3f}")

# ========== PART 4: Behavioral features from customer_analytics ==========
behav = pd.read_sql_query("""
    SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
           lifecycle_stage, customer_value_segment, activity_status,
           credit_grade, risk_assessment
    FROM quickbooks__customer_analytics
""", conn)
metrics = pd.merge(metrics, behav, on='customer_id', how='left')

# Relationship between volatility and segments
print("\n--- Average CV by RFM Segment ---")
print(metrics.groupby('rfm_segment')['gross_profit_cv'].mean().sort_values(ascending=False))
print("\n--- Average CV by Payment Behavior ---")
print(metrics.groupby('payment_behavior')['gross_profit_cv'].mean().sort_values(ascending=False))
print("\n--- Average CV by Lifecycle Stage ---")
print(metrics.groupby('lifecycle_stage')['gross_profit_cv'].mean().sort_values(ascending=False))

# ========== PART 5: Contribution to business_health_score & collection_rate_percentage ==========
# Compute monthly contributions for high-volatility customers vs total
# Get monthly totals from profitability_analysis
monthly_all = pd.read_sql_query(f"""
    SELECT revenue_month_start, 
           SUM(invoice_total) AS total_invoice,
           SUM(collected_amount) AS total_collected,
           SUM(gross_profit) AS total_profit,
           COUNT(DISTINCT customer_id) as total_customers
    FROM quickbooks__profitability_analysis
    WHERE DATE(revenue_month_start) >= DATE('{start_date}')
        AND DATE(revenue_month_start) <= DATE('{max_date_str}')
    GROUP BY revenue_month_start
    ORDER BY revenue_month_start
""", conn)
monthly_all['revenue_month_start'] = pd.to_datetime(monthly_all['revenue_month_start'])

monthly_high = pd.read_sql_query(f"""
    SELECT revenue_month_start,
           SUM(invoice_total) AS high_invoice,
           SUM(collected_amount) AS high_collected,
           SUM(gross_profit) AS high_profit,
           COUNT(DISTINCT customer_id) as high_customers
    FROM quickbooks__profitability_analysis
    WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
        AND DATE(revenue_month_start) >= DATE('{start_date}')
        AND DATE(revenue_month_start) <= DATE('{max_date_str}')
    GROUP BY revenue_month_start
    ORDER BY revenue_month_start
""", conn, params=high_vol_ids)
monthly_high['revenue_month_start'] = pd.to_datetime(monthly_high['revenue_month_start'])

monthly = pd.merge(monthly_all, monthly_high, on='revenue_month_start', how='left')
monthly['high_invoice_share'] = monthly['high_invoice'] / monthly['total_invoice']
monthly['high_collected_share'] = monthly['high_collected'] / monthly['total_collected']
monthly['high_profit_share'] = monthly['high_profit'] / monthly['total_profit']
# Compute collection rate
monthly['overall_collection_rate'] = monthly['total_collected'] / monthly['total_invoice']
monthly['high_collection_rate'] = monthly['high_collected'] / monthly['high_invoice']

# Compare with financial_dashboard collection_rate_percentage
dashboard = pd.read_sql_query("""
    SELECT dashboard_month, collection_rate_percentage, business_health_score
    FROM quickbooks__financial_dashboard
    WHERE DATE(dashboard_month) >= DATE('{start_date}')
        AND DATE(dashboard_month) <= DATE('{max_date_str}')
    ORDER BY dashboard_month
""".format(start_date=start_date, max_date_str=max_date_str), conn)
dashboard['dashboard_month'] = pd.to_datetime(dashboard['dashboard_month'])

# Merge by month
monthly['month'] = monthly['revenue_month_start']
dashboard['month'] = dashboard['dashboard_month']
merged_monthly = pd.merge(monthly, dashboard[['month','collection_rate_percentage','business_health_score']], on='month', how='left')

# Correlation between high-volatility profit share and business_health_score
corr = merged_monthly[['high_profit_share', 'business_health_score']].corr().iloc[0,1]
print(f"\nCorrelation between high-volatility profit share and business health score: {corr:.3f}")

# ========== PART 6: Risk exposure from accounts receivable structure ==========
# Latest AR aging buckets
ar = pd.read_sql_query("""
    SELECT account_sub_type, amount
    FROM quickbooks__balance_sheet
    WHERE account_type = 'Accounts Receivable'
        AND calendar_date = (SELECT MAX(calendar_date) FROM quickbooks__balance_sheet WHERE account_type = 'Accounts Receivable')
""", conn)
print("\n--- Accounts Receivable Aging Distribution (Latest Date) ---")
print(ar)
total_ar = ar['amount'].sum()
ar['percentage'] = ar['amount'] / total_ar
print(f"Total AR: {total_ar:,.2f}")
print(ar)

# ========== PART 7: Multi-dimensional risk rating model ==========
# Compute features per high-volatility customer: volatility metrics, behavioral, financial risk (e.g., outstanding balance, collection rate)
# Get outstanding balance per customer (latest month)
outstanding = pd.read_sql_query(f"""
    SELECT customer_id, SUM(outstanding_balance) as total_outstanding,
           AVG(invoice_gross_margin_pct) as avg_margin
    FROM quickbooks__profitability_analysis
    WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
    GROUP BY customer_id
""", conn, params=high_vol_ids)

metrics = pd.merge(metrics, outstanding, on='customer_id', how='left')
# Fill missing with zero
metrics['total_outstanding'].fillna(0, inplace=True)

# Normalize risk factors
from sklearn.preprocessing import minmax_scale
factors = ['gross_profit_cv', 'invoice_total_growth_var', 'total_outstanding']
for f in factors:
    metrics[f'{f}_norm'] = minmax_scale(metrics[f].fillna(metrics[f].median()))

# Weighted risk score (equal weights)
weights = {'gross_profit_cv_norm':0.4, 'invoice_total_growth_var_norm':0.3, 'total_outstanding_norm':0.3}
metrics['risk_score'] = sum(metrics[col] * weight for col, weight in weights.items())

# Categorize risk rating
metrics['risk_rating'] = pd.qcut(metrics['risk_score'], q=5, labels=['Very Low','Low','Medium','High','Very High'])

print("\n--- Risk Rating Distribution ---")
print(metrics['risk_rating'].value_counts().sort_index())

# Save metrics to CSV for reference
metrics.to_csv('customer_risk_ratings.csv', index=False)

conn.close()
```
