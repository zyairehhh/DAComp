import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime
import numpy as np

# Connect to database
conn = sqlite3.connect('/workspace/dacomp-094.sqlite')

# Load data
persons_df = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
campaign_flow_df = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)
events_df = pd.read_sql_query("SELECT * FROM klaviyo__events", conn)

conn.close()

# Create output directory for plots
import os
if not os.path.exists('/workspace/plots'):
    os.makedirs('/workspace/plots')

# Set style
