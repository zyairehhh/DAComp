```
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-071.sqlite')

# Define positive and negative outcomes
positive = ('Advanced to next stage', 'Proceeding', 'Hired', 'Qualified')
negative = ('Interview performance below expectations', 'Underqualified', 'Coding challenge failed',
            'Lack of required skills', 'Failed technical assessment', 'Position cancelled',
            'Communication skills insufficient', 'Experience level mismatch', 'Technical skills insufficient',
            'Declined offer', 'Failed background check', 'Cultural fit concerns', 'Availability issues',
            'Salary expectations too high', 'Better candidate selected', 'Negative reference feedback',
            'Reference check concerns')

query = """
SELECT 
    stage,
    COUNT(*) as total_entries,
    AVG(days_in_stage) as avg_days,
    SUM(CASE WHEN archive_reason IN ({}) THEN 1 ELSE 0 END) as pass_count,
    SUM(CASE WHEN archive_reason IN ({}) THEN 1 ELSE 0 END) as attrition_count
FROM lever__opportunity_stage_history
GROUP BY stage
""".format(','.join('?' for _ in positive), ','.join('?' for _ in negative))

params = [*positive, *negative]
df = pd.read_sql_query(query, conn, params=params)

# Calculate rates
df['attrition_rate'] = df['attrition_count'] / df['total_entries'] * 100
df['pass_rate'] = df['pass_count'] / df['total_entries'] * 100
df['efficiency_index'] = df['pass_rate'] / df['avg_days'] * 100

# Filter stages with at least 100 samples
df_filtered = df[df['total_entries'] >= 100].copy()

# Identify bottleneck stages: avg_days > 25 and attrition_rate > 40%
bottleneck = df_filtered[(df_filtered['avg_days'] > 25) & (df_filtered['attrition_rate'] > 40)]

# Stages with efficiency index < 1.5
low_efficiency = df_filtered[df_filtered['efficiency_index'] < 1.5]

print("All stages (>=100 samples):")
print(df_filtered.to_string())
print("\nBottleneck stages (avg_days > 25, attrition_rate > 40%):")
print(bottleneck.to_string())
print("\nStages with efficiency index < 1.5:")
print(low_efficiency.to_string())

# Save to CSV for reference
df_filtered.to_csv('stage_metrics.csv', index=False)
bottleneck.to_csv('bottleneck_stages.csv', index=False)
low_efficiency.to_csv('low_efficiency_stages.csv', index=False)
```
