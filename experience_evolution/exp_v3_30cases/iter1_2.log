import sqlite3
import pandas as pd

# Connect to database
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-090/stage1_env/dacomp-090.sqlite')

# Part 1: High-risk customers
query = """
SELECT customer_id, customer_name, payment_rate_percentage, outstanding_balance,
       credit_score, business_stability_score,
       (100 - payment_rate_percentage) * 0.4 + (850 - credit_score) / 850 * 100 * 0.4 + (100 - business_stability_score) * 0.2 AS risk_score
FROM quickbooks__customer_analytics
WHERE payment_rate_percentage < 75 AND outstanding_balance > 15000;
"""
high_risk_df = pd.read_sql_query(query, conn)
print(f"High-risk customers count: {len(high_risk_df)}")
if len(high_risk_df) > 0:
    print("Risk score summary:")
    print(high_risk_df['risk_score'].describe())

# Part 2: Gross profit proportion
# Sum total gross profit for all customers
total_profit_all = pd.read_sql_query("SELECT SUM(gross_profit) AS total FROM quickbooks__profitability_analysis;", conn).iloc[0,0]
print(f"Total gross profit all customers: {total_profit_all}")

# Sum gross profit for high-risk customers
high_risk_ids = list(high_risk_df['customer_id'])
placeholders = ','.join(['?'] * len(high_risk_ids))
profit_query = f"""
SELECT SUM(gross_profit) AS high_risk_total
FROM quickbooks__profitability_analysis
WHERE customer_id IN ({placeholders})
"""
high_risk_profit = pd.read_sql_query(profit_query, conn, params=high_risk_ids).iloc[0,0]
print(f"High-risk customers gross profit sum: {high_risk_profit}")
if total_profit_all != 0:
    proportion = high_risk_profit / total_profit_all * 100
    print(f"Proportion of high-risk customers' gross profit to total: {proportion:.2f}%")
else:
    print("Total profit is zero.")

# Part 3: Month-over-month trend of collection_rate_percentage for last 12 months
# Get last 12 months from financial_dashboard sorted by dashboard_month
trend_query = """
SELECT dashboard_month, collection_rate_percentage
FROM quickbooks__financial_dashboard
WHERE dashboard_month IS NOT NULL
ORDER BY dashboard_month DESC
LIMIT 12;
"""
trend_df = pd.read_sql_query(trend_query, conn)
# Ensure chronological order for analysis
trend_df['dashboard_month'] = pd.to_datetime(trend_df['dashboard_month'])
trend_df = trend_df.sort_values('dashboard_month')
print("\nLast 12 months collection_rate_percentage:")
print(trend_df)
# Identify consecutive months of deterioration
trend_df['prev_rate'] = trend_df['collection_rate_percentage'].shift(1)
trend_df['change'] = trend_df['collection_rate_percentage'] - trend_df['prev_rate']
trend_df['deterioration'] = trend_df['change'] < 0
# Find longest streak of consecutive deteriorations
streak = 0
max_streak = 0
for d in trend_df['deterioration'].dropna():
    if d:
        streak += 1
        if streak > max_streak:
            max_streak = streak
    else:
        streak = 0
print(f"Longest consecutive months of deterioration: {max_streak}")
# Magnitude of decline: sum of negative changes
total_decline = trend_df[trend_df['change'] < 0]['change'].sum()
print(f"Total decline (percentage points) over periods of deterioration: {total_decline:.2f}")

# Part 4: Distribution characteristics of problem customers vs normal customers
# Normal customers: payment_rate_percentage >= 75 OR outstanding_balance <= 15000
normal_query = """
SELECT customer_lifespan_days, total_invoices, avg_invoice_amount, profitability_tier
FROM quickbooks__customer_analytics
WHERE NOT (payment_rate_percentage < 75 AND outstanding_balance > 15000);
"""
normal_df = pd.read_sql_query(normal_query, conn)

problem_query = """
SELECT customer_lifespan_days, total_invoices, avg_invoice_amount, profitability_tier
FROM quickbooks__customer_analytics
WHERE payment_rate_percentage < 75 AND outstanding_balance > 15000;
"""
problem_df = pd.read_sql_query(problem_query, conn)

print("\n--- Comparison Problem vs Normal Customers ---")
print("Customer Lifespan (days):")
print(f"  Problem: mean={problem_df['customer_lifespan_days'].mean():.2f}, median={problem_df['customer_lifespan_days'].median()}")
print(f"  Normal: mean={normal_df['customer_lifespan_days'].mean():.2f}, median={normal_df['customer_lifespan_days'].median()}")
print("Total Invoices:")
print(f"  Problem: mean={problem_df['total_invoices'].mean():.2f}, median={problem_df['total_invoices'].median()}")
print(f"  Normal: mean={normal_df['total_invoices'].mean():.2f}, median={normal_df['total_invoices'].median()}")
print("Average Invoice Amount:")
print(f"  Problem: mean={problem_df['avg_invoice_amount'].mean():.2f}, median={problem_df['avg_invoice_amount'].median()}")
print(f"  Normal: mean={normal_df['avg_invoice_amount'].mean():.2f}, median={normal_df['avg_invoice_amount'].median()}")
print("Profitability Tier distribution (Problem):")
print(problem_df['profitability_tier'].value_counts())
print("Profitability Tier distribution (Normal):")
print(normal_df['profitability_tier'].value_counts())

# Part 5: Using forecast data to build risk warning model
# We'll compute potential loss scale for next 6 months based on risk score and outstanding balance.
# Simulate: loss probability = risk_score / 100 (assuming risk_score between 0-100)
# Potential loss per customer = outstanding_balance * loss probability
# Sum for high-risk customers for next 6 months.
# We'll assume each month same exposure (simplified). Could incorporate cashflow forecast.
# Let's get forecasted inflows/outflows for next 6 months and see risk impact.
forecast_query = """
SELECT forecast_month, forecasted_inflows, forecasted_outflows, forecasted_net_cash_flow,
       risk_adjusted_inflows, blended_forecast
FROM quickbooks__cashflow_forecast
ORDER BY forecast_month ASC
LIMIT 6;
"""
forecast_df = pd.read_sql_query(forecast_query, conn)
print("\n--- Cashflow Forecast Next 6 Months ---")
print(forecast_df)

# Compute total outstanding balance from high-risk customers
outstanding_total = high_risk_df['outstanding_balance'].sum()
print(f"\nTotal outstanding balance from high-risk customers: {outstanding_total}")
# Compute weighted risk score average
avg_risk = high_risk_df['risk_score'].mean()
print(f"Average risk score among high-risk: {avg_risk:.2f}")
# Estimate loss scale: outstanding_total * (avg_risk / 100)
estimated_loss = outstanding_total * (avg_risk / 100)
print(f"Estimated potential loss (assuming risk score as % probability): {estimated_loss:.2f}")

conn.close()
```
