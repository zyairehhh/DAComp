import pandas as pd
import numpy as np

target = pd.read_csv('target_features_full.csv')
print("Dataset shape:", target.shape)

features = ['total_conv', 'neg_proportion', 'p50_time_to_last_close_min', 'p50_reopens', 'feature_adoption_coverage']
print("\nFeature summary by label:")
for feat in features:
    at_risk = target[target['label'] == 1][feat].dropna()
    non_risk = target[target['label'] == 0][feat].dropna()
    print(f"{feat}:")
    print(f"  At-risk (n={len(at_risk)}): mean={at_risk.mean():.2f}, median={at_risk.median():.2f}")
    print(f"  Non-risk (n={len(non_risk)}): mean={non_risk.mean():.2f}, median={non_risk.median():.2f}")
    if len(at_risk) > 0 and len(non_risk) > 0:
        import scipy.stats as stats
        # t-test (assuming normal? just for indication)
        try:
            t_stat, p_val = stats.ttest_ind(at_risk.dropna(), non_risk.dropna(), equal_var=False)
            print(f"  t-test p-value: {p_val:.4f}")
        except:
            pass

print("\nCorrelation between features and label:")
corr = target[features + ['label']].corr()
print(corr['label'].sort_values(ascending=False))
''')
