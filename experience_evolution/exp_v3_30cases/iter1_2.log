import sqlite3
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.cluster import KMeans
from sklearn.tree import DecisionTreeClassifier, export_text
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, accuracy_score
import matplotlib.pyplot as plt

DB_PATH = "dacomp-076.sqlite"

def load_data():
    conn = sqlite3.connect(DB_PATH)
    df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
    conn.close()
    return df

def compute_segment_stats(df):
    segment_stats = df.groupby('profitability_segment')['retention_probability'].agg(['mean', 'std', 'count']).reset_index()
    segment_stats.rename(columns={'mean': 'segment_retention_mean'}, inplace=True)
    return segment_stats

def flag_anomalies(df, segment_stats):
    df = df.merge(segment_stats[['profitability_segment', 'segment_retention_mean']], on='profitability_segment', how='left')
    df['retention_diff'] = df['retention_probability'] - df['segment_retention_mean']
    df['abs_diff'] = abs(df['retention_diff'])
    df['is_anomaly'] = df['abs_diff'] > 0.15
    return df

def prepare_features(df):
    # Make a copy
    X = df.copy()
    
    # Encode categorical variables
    cat_cols = ['profitability_segment', 'value_tier', 'lifecycle_stage', 'activity_status',
                'retention_category', 'seasonal_preference', 'transaction_consistency',
                'growth_potential', 'recommended_action', 'engagement_frequency']
    label_encoders = {}
    for col in cat_cols:
        if col in X.columns:
            le = LabelEncoder()
            X[col + '_encoded'] = le.fit_transform(X[col].astype(str))
            label_encoders[col] = le
    
    # Create feature: transaction stability (combine volatility and consistency)
    # transaction_value_volatility is numeric; transaction_consistency is categorical (encoded)
    # We can create a composite score: maybe volatility * (1 - consistency_score) but simplicity: use encoded consistency and volatility
    # Let's scale volatility to 0-1 and consistency encoded to 0-1 and combine
    if 'transaction_value_volatility' in X.columns:
        # Normalize volatility
        vol_min = X['transaction_value_volatility'].min()
        vol_max = X['transaction_value_volatility'].max()
        if vol_max - vol_min > 0:
            X['volatility_norm'] = (X['transaction_value_volatility'] - vol_min) / (vol_max - vol_min)
        else:
            X['volatility_norm'] = 0.5
    
    if 'transaction_consistency_encoded' in X.columns:
        # Normalize encoded consistency
        cons_min = X['transaction_consistency_encoded'].min()
        cons_max = X['transaction_consistency_encoded'].max()
        if cons_max - cons_min > 0:
            X['consistency_norm'] = (X['transaction_consistency_encoded'] - cons_min) / (cons_max - cons_min)
        else:
            X['consistency_norm'] = 0.5
        # Higher consistency should indicate stability, lower volatility -> stability
        X['transaction_stability'] = (1 - X['volatility_norm']) * X['consistency_norm']
    else:
        X['transaction_stability'] = 1 - X['volatility_norm']
    
    # Seasonal balance: compute Herfindahl index of quarter transaction ratios (concentration)
    total_q = X[['q1_transactions','q2_transactions','q3_transactions','q4_transactions']].sum(axis=1)
    X['total_q_trans'] = total_q
    for q in ['q1','q2','q3','q4']:
        X[f'{q}_ratio'] = X[f'{q}_transactions'] / np.where(total_q==0, 1, total_q)
    # Herfindahl index: sum of squares of ratios, higher = more concentrated in certain quarters
    X['seasonal_concentration'] = X['q1_ratio']**2 + X['q2_ratio']**2 + X['q3_ratio']**2 + X['q4_ratio']**2
    
    # Customer lifecycle stage encoded (already encoded as lifecycle_stage_encoded)
    # We'll keep as is.
    
    # Additional features: discrepancy between transaction_count and avg_transactions_per_month * customer_age_days/30
    X['estimated_transactions'] = X['avg_transactions_per_month'] * (X['customer_age_days'] / 30.0)
    X['trans_discrepancy'] = X['transaction_count'] - X['estimated_transactions']
    
    # Alignment between comprehensive_customer_score and total_revenue: maybe ratio or difference
    X['score_revenue_ratio'] = X['comprehensive_customer_score'] / (X['total_revenue'] + 1)
    X['score_revenue_diff'] = X['comprehensive_customer_score'] - X['total_revenue']
    
    # Features for clustering
    feature_cols = [
        'total_revenue',
        'net_profit',
        'transaction_count',
        'avg_transactions_per_month',
        'comprehensive_customer_score',
        'transaction_value_volatility',
        'customer_age_days',
        'transaction_stability',
        'seasonal_concentration',
        'trans_discrepancy',
        'score_revenue_ratio',
        'profitability_segment_encoded',
        'value_tier_encoded',
        'lifecycle_stage_encoded',
        'activity_status_encoded',
        'retention_category_encoded',
        'seasonal_preference_encoded',
        'transaction_consistency_encoded',
        'growth_potential_encoded',
        'recommended_action_encoded',
        'engagement_frequency_encoded'
    ]
    # Filter only existing columns
    feature_cols = [col for col in feature_cols if col in X.columns]
    
    X_features = X[feature_cols]
    # Fill any missing values with column mean
    X_features = X_features.fillna(X_features.mean())
    
    return X_features, X['is_anomaly'], X

df = load_data()
segment_stats = compute_segment_stats(df)
df = flag_anomalies(df, segment_stats)

X_features, y, X_full = prepare_features(df)

print("Feature matrix shape:", X_features.shape)
print("Number of anomalies:", y.sum())
print("Feature columns:", X_features.columns.tolist())

# 1. Cluster analysis (unsupervised) on anomalies to see subgroups
anomaly_features = X_features[y]
scaler = StandardScaler()
anomaly_scaled = scaler.fit_transform(anomaly_features)

# Determine optimal k using elbow method (simplify, just use k=3)
inertias = []
for k in range(2, 8):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(anomaly_scaled)
    inertias.append(kmeans.inertia_)

# Plot elbow (optional, not needed for report)
# We'll just compute cluster assignments with k=3 (or 4) and analyze centroids
k = 3
kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
cluster_labels = kmeans.fit_predict(anomaly_scaled)
anomaly_features['cluster'] = cluster_labels
anomaly_features['cluster'] = anomaly_features['cluster'].astype(int)
X_full_anomaly = X_full[y]
X_full_anomaly['cluster'] = cluster_labels

print("\n--- Cluster Distribution ---")
print(anomaly_features['cluster'].value_counts().sort_index())

# Analyze cluster characteristics
for c in range(k):
    print(f"\nCluster {c}:")
    cluster_subset = X_full_anomaly[X_full_anomaly['cluster']==c]
    print(f"  Size: {len(cluster_subset)}")
    # Check categorical distributions
    for col in ['profitability_segment', 'value_tier', 'lifecycle_stage', 'seasonal_preference', 'transaction_consistency']:
        if col in cluster_subset.columns:
            print(f"  {col}: {cluster_subset[col].value_counts().index[0]} ({cluster_subset[col].value_counts().iloc[0]/len(cluster_subset):.1%})")
    # Numeric averages
    for col in ['total_revenue', 'transaction_value_volatility', 'transaction_stability', 'seasonal_concentration']:
        if col in cluster_subset.columns:
            print(f"  {col} mean: {cluster_subset[col].mean():.2f}")

# 2. Decision tree to predict anomaly vs normal
# Prepare data for classification
X_all_scaled = scaler.fit_transform(X_features)  # scale all data
X_train, X_test, y_train, y_test = train_test_split(X_all_scaled, y, test_size=0.3, random_state=42)

clf = DecisionTreeClassifier(max_depth=5, random_state=42)
clf.fit(X_train, y_train)
y_pred = clf.predict(X_test)
print("\n--- Decision Tree Performance ---")
print(f"Accuracy: {accuracy_score(y_test, y_pred):.3f}")
print("Classification Report:")
print(classification_report(y_test, y_pred))

# Feature importance
importance = pd.DataFrame({'feature': X_features.columns, 'importance': clf.feature_importances_})
importance = importance.sort_values('importance', ascending=False)
print("\nTop 10 Important Features for Predicting Anomaly:")
print(importance.head(10))

# Export tree rules
tree_rules = export_text(clf, feature_names=list(X_features.columns))
print("\nFirst few decision tree rules:")
print(tree_rules[:1000])

# Save results
anomaly_features.to_csv('anomaly_features_clusters.csv', index=False)
importance.to_csv('feature_importance.csv', index=False)
```
