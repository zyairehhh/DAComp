'''
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-017.sqlite')

# Query to get Home & Furniture monthly aggregates with shipping, discount, etc.
query = '''
SELECT 
    strftime('%Y-%m', "Order Date") as month,
    "Shipping Method",
    "Discount",
    "Shipping Cost",
    "Order Priority",
    "Product",
    Sales,
    profit,
    Quantity
FROM order_information 
WHERE "Product Category" = 'Home & Furniture'
'''

df = pd.read_sql_query(query, conn)
conn.close()

# Convert numeric columns, handling commas or other characters
def to_float(x):
    if isinstance(x, str):
        # Remove commas, percent signs, etc.
        x = x.replace(',', '').replace('%', '').strip()
        if x == '' or x.lower() == 'null':
            return 0.0
        try:
            return float(x)
        except:
            return 0.0
    elif x is None:
        return 0.0
    else:
        return float(x)

df['Discount_num'] = df['Discount'].apply(to_float)
df['Shipping_Cost_num'] = df['Shipping Cost'].apply(to_float)
df['Quantity_num'] = df['Quantity'].apply(to_float)

# Compute profit margin per row for weighting
df['profit_margin_row'] = df['profit'] / df['Sales']

# Aggregate by month
monthly_agg = df.groupby('month').agg({
    'profit': 'sum',
    'Sales': 'sum',
    'Discount_num': 'mean',
    'Shipping_Cost_num': 'mean',
    'Quantity_num': 'mean',
    'Shipping Method': lambda x: x.mode().iloc[0] if not x.mode().empty else None,
    'Order Priority': lambda x: x.mode().iloc[0] if not x.mode().empty else None
}).reset_index()

monthly_agg['profit_margin'] = monthly_agg['profit'] / monthly_agg['Sales']
print(monthly_agg[['month','profit_margin','Discount_num','Shipping_Cost_num','Quantity_num']])

# Correlation matrix
corr_matrix = monthly_agg[['profit_margin','Discount_num','Shipping_Cost_num','Quantity_num']].corr()
print("\nCorrelation matrix:")
print(corr_matrix)

# Investigate month with lowest margin (2024-10)
low_month = monthly_agg.loc[monthly_agg['profit_margin'].idxmin()]
print(f"\nLowest margin month: {low_month['month']} margin={low_month['profit_margin']:.6f}")
# Look at raw data for that month
low_data = df[df['month'] == low_month['month']]
print(f"Number of orders in that month: {len(low_data)}")
print("Shipping method distribution:")
print(low_data['Shipping Method'].value_counts())
print("Order priority distribution:")
print(low_data['Order Priority'].value_counts())
print("Average discount:", low_data['Discount_num'].mean())
print("Average shipping cost:", low_data['Shipping_Cost_num'].mean())
''')
