'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation enhanced with tags and conversation_initiated_type
df = pd.read_sql_query("""
SELECT conversation_id, conversation_created_at, conversation_initiated_type, all_conversation_tags
FROM intercom__conversation_enhanced 
WHERE all_conversation_tags IS NOT NULL AND all_conversation_tags != ''
""", conn)
conn.close()

# Parse tags
def parse_tags(tag_string):
    d = {}
    parts = tag_string.split('|')
    for part in parts:
        if ':' in part:
            key, val = part.split(':', 1)
            d[key.strip()] = val.strip()
    return d

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['path'] = df['tags_dict'].apply(lambda d: d.get('path', ''))
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))

# Filter only bot_first and human_first
df = df[df['path'].isin(['bot_first', 'human_first'])]

print("Total conversations:", len(df))
print("Path distribution:")
print(df['path'].value_counts())
print("Stage distribution:")
print(df['stage'].value_counts())

# Compute conversion counts per path per stage
conversion_counts = df.groupby(['path', 'stage']).size().unstack(fill_value=0)

# Define funnel stages in order
funnel_stages = ['contacted', 'marketing_qualified', 'demo_booked', 'trial_started', 'trial_activated', 'closed_won']
# Ensure we have all stages
for stage in funnel_stages:
    if stage not in conversion_counts.columns:
        conversion_counts[stage] = 0

# Sort columns as per funnel
conversion_counts = conversion_counts[funnel_stages]

# Plot stacked bar chart for funnel volumes
fig, ax = plt.subplots(figsize=(10,6))
bot_counts = conversion_counts.loc['bot_first', funnel_stages].values
human_counts = conversion_counts.loc['human_first', funnel_stages].values
x = np.arange(len(funnel_stages))
width = 0.35
ax.bar(x - width/2, bot_counts, width, label='Bot First', color='skyblue')
ax.bar(x + width/2, human_counts, width, label='Human First', color='lightcoral')
ax.set_xlabel('Funnel Stage')
ax.set_ylabel('Number of Conversations')
ax.set_title('Conversation Counts per Funnel Stage by First Response Type')
ax.set_xticks(x)
ax.set_xticklabels([s.replace('_', ' ').title() for s in funnel_stages])
ax.legend()
plt.tight_layout()
plt.savefig('funnel_counts.png')
plt.close()

# Compute conversion rates (as percentage of total conversations per path)
total_conversations = df['path'].value_counts()
conversion_rates = conversion_counts.div(total_conversations, axis=0) * 100

# Plot conversion rates
fig, ax = plt.subplots(figsize=(10,6))
x = np.arange(len(funnel_stages))
ax.plot(x, conversion_rates.loc['bot_first', funnel_stages].values, marker='o', label='Bot First', color='skyblue')
ax.plot(x, conversion_rates.loc['human_first', funnel_stages].values, marker='s', label='Human First', color='lightcoral')
ax.set_xlabel('Funnel Stage')
ax.set_ylabel('Conversion Rate (% of total conversations)')
ax.set_title('Conversion Rate across Funnel Stages by First Response Type')
ax.set_xticks(x)
ax.set_xticklabels([s.replace('_', ' ').title() for s in funnel_stages])
ax.legend()
ax.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('funnel_conversion_rates.png')
plt.close()

# Compute stage durations using conversation timestamps? Not available.
# Instead compute time_to_first_response from conversation_metrics
conn = sqlite3.connect('dacomp-098.sqlite')
df_metrics = pd.read_sql_query("""
SELECT cm.conversation_id, cm.time_to_first_response_minutes, ce.conversation_initiated_type
FROM intercom__conversation_metrics cm
JOIN intercom__conversation_enhanced ce ON cm.conversation_id = ce.conversation_id
WHERE ce.all_conversation_tags IS NOT NULL AND ce.all_conversation_tags != ''
""", conn)
conn.close()
df_metrics['path'] = df_metrics['conversation_initiated_type'].map({'bot_first':'bot_first','human_first':'human_first'})
df_metrics = df_metrics.dropna(subset=['time_to_first_response_minutes', 'path'])

# Boxplot of response time
fig, ax = plt.subplots(figsize=(8,6))
box_data = [df_metrics[df_metrics['path']=='bot_first']['time_to_first_response_minutes'].dropna(),
            df_metrics[df_metrics['path']=='human_first']['time_to_first_response_minutes'].dropna()]
ax.boxplot(box_data, labels=['Bot First', 'Human First'])
ax.set_ylabel('Time to First Response (minutes)')
ax.set_title('Distribution of Time to First Response by First Response Type')
plt.tight_layout()
plt.savefig('response_time_boxplot.png')
plt.close()

# Compute average response time per path
avg_response = df_metrics.groupby('path')['time_to_first_response_minutes'].mean()
print("Average response time per path:")
print(avg_response)

# Intent analysis: distribution of intents per path
intent_counts = df.groupby(['path', 'intent']).size().unstack(fill_value=0)
intent_percentage = intent_counts.div(intent_counts.sum(axis=1), axis=0) * 100

# Plot intent distribution
fig, ax = plt.subplots(figsize=(12,6))
intent_percentage.T.plot(kind='bar', ax=ax)
ax.set_xlabel('Intent')
ax.set_ylabel('Percentage of Conversations')
ax.set_title('Intent Distribution by First Response Type')
ax.legend(title='First Response')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('intent_distribution.png')
plt.close()

print("Script executed successfully.")
''')
