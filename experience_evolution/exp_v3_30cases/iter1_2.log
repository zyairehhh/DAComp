Action: CreateFile(filepath='plot_deviation_by_status_priority.py':
'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Plot for Project Status
status_stats = df.groupby('Project Status')['Deviation'].mean().reset_index()
status_order = ['In‑Progress', 'Completed', 'Delayed']
# Ensure order, some status names might differ
status_stats = status_stats.set_index('Project Status').reindex(status_order).reset_index()

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

# Subplot 1: Project Status
bars1 = ax1.bar(status_stats['Project Status'], status_stats['Deviation'],
                color=['skyblue', 'lightgreen', 'salmon'], edgecolor='black')
ax1.set_xlabel('Project Status', fontsize=12)
ax1.set_ylabel('Average Cost Deviation', fontsize=12)
ax1.set_title('Average Deviation by Project Status', fontsize=14, pad=15)
ax1.grid(True, alpha=0.3, axis='y')
for bar, val in zip(bars1, status_stats['Deviation']):
    height = bar.get_height()
    ax1.text(bar.get_x() + bar.get_width()/2., height + 5,
             f'{val:.1f}', ha='center', va='bottom', fontsize=10)

# Subplot 2: Priority
priority_stats = df.groupby('Priority')['Deviation'].mean().reset_index()
priority_order = ['High', 'Medium', 'Low']
priority_stats = priority_stats.set_index('Priority').reindex(priority_order).reset_index()
bars2 = ax2.bar(priority_stats['Priority'], priority_stats['Deviation'],
                color=['red', 'orange', 'yellow'], edgecolor='black')
ax2.set_xlabel('Priority', fontsize=12)
ax2.set_ylabel('Average Cost Deviation', fontsize=12)
ax2.set_title('Average Deviation by Priority', fontsize=14, pad=15)
ax2.grid(True, alpha=0.3, axis='y')
for bar, val in zip(bars2, priority_stats['Deviation']):
    height = bar.get_height()
    ax2.text(bar.get_x() + bar.get_width()/2., height + 5,
             f'{val:.1f}', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('deviation_by_status_priority.png', dpi=150)
print("Saved deviation_by_status_priority.png")
''')
