import sqlite3
import pandas as pd
import numpy as np
import re
from datetime import datetime

conn = sqlite3.connect('dacomp-098.sqlite')

# Extract tags into columns
query = '''
SELECT 
    ce.conversation_id,
    ce.conversation_created_at AS initiated_at,
    ce.conversation_initiated_type,
    ce.all_conversation_tags,
    cm.first_admin_response_at AS first_response_at,
    cm.time_to_first_response_minutes,
    ce.conversation_author_type,
    ce.conversation_subject,
    ce.conversation_rating,
    ce.conversation_remark
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
    ON ce.conversation_id = cm.conversation_id
WHERE ce.all_conversation_tags IS NOT NULL 
    AND ce.all_conversation_tags != ''
'''
df = pd.read_sql_query(query, conn)
print(f"Total conversations: {len(df)}")
print(df.head())

# Parse tags
def parse_tag(tag_string, key):
    # tag_string format: key1:value1|key2:value2...
    if pd.isna(tag_string):
        return None
    parts = tag_string.split('|')
    for part in parts:
        if ':' in part:
            k, v = part.split(':', 1)
            if k == key:
                return v
    return None

df['path'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'path'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))
df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))

# Determine responder_type: bot_first vs human_first
# conversation_initiated_type might already be human_first or bot_first?
print(df['conversation_initiated_type'].unique())
print(df['path'].unique())

# We'll use path if available else conversation_initiated_type
df['responder_type'] = df['path'].fillna(df['conversation_initiated_type'])
print(df['responder_type'].value_counts(dropna=False))

# Check stage distribution
print(df['stage'].value_counts(dropna=False))

# Convert timestamps
df['initiated_at'] = pd.to_datetime(df['initiated_at'])
df['first_response_at'] = pd.to_datetime(df['first_response_at'])

# Compute time to first response in days
df['time_to_first_response_days'] = df['time_to_first_response_minutes'] / (60 * 24)
# For those missing time_to_first_response_minutes, compute from timestamps
mask = df['time_to_first_response_minutes'].isna() & df['first_response_at'].notna()
df.loc[mask, 'time_to_first_response_days'] = (df.loc[mask, 'first_response_at'] - df.loc[mask, 'initiated_at']).dt.total_seconds() / (3600 * 24)

print(df[['conversation_id', 'initiated_at', 'first_response_at', 'time_to_first_response_days']].head())
conn.close()

# Save parsed data to CSV for further analysis
df.to_csv('/workspace/conversations_parsed.csv', index=False)
print("Parsed data saved.")
```
