import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-057.sqlite')
# Step 1: Get candidate combinations with lifespan >120 days
query = '''
SELECT 
    account_id,
    advertising_channel_type,
    advertising_channel_subtype,
    MIN(substr(date_day,1,10)) as first_day,
    MAX(substr(date_day,1,10)) as last_day,
    julianday(MAX(substr(date_day,1,10))) - julianday(MIN(substr(date_day,1,10))) as lifespan_days,
    -- we also need campaign_lifecycle_stage (choose the most recent one)
    MAX(CASE WHEN substr(date_day,1,10) = MAX(substr(date_day,1,10)) THEN campaign_lifecycle_stage END) as latest_stage,
    MAX(CASE WHEN substr(date_day,1,10) = MAX(substr(date_day,1,10)) THEN account_maturity_stage END) as latest_account_maturity,
    MAX(CASE WHEN substr(date_day,1,10) = MAX(substr(date_day,1,10)) THEN customer_maturity_stage END) as latest_customer_maturity
FROM google_ads__customer_acquisition_analysis
GROUP BY account_id, advertising_channel_type, advertising_channel_subtype
HAVING lifespan_days > 120
'''
df_candidates = pd.read_sql_query(query, conn)
print("Candidates count:", len(df_candidates))
df_candidates.head()
