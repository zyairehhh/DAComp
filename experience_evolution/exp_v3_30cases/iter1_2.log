```
import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

conn = sqlite3.connect('/workspace/dacomp-001.sqlite')

# Load company info with credit rating
company_df = pd.read_sql_query('SELECT "Enterprise Code", "Credit Rating", "Defaulted" FROM ch___company_info', conn)
print(f"Total companies with credit history: {len(company_df)}")

# Load sales invoices
sales_df = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax" FROM ch___sales_invoices', conn)
sales_df['Invoice Date'] = pd.to_datetime(sales_df['Invoice Date'])
# Load input invoices
input_df = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax" FROM ch___input_invoices', conn)
input_df['Invoice Date'] = pd.to_datetime(input_df['Invoice Date'])

# Compute total sales and inputs per company
total_sales = sales_df.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_sales')
total_input = input_df.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_input')
# Combine
financial_df = pd.concat([total_sales, total_input], axis=1).fillna(0)
financial_df['profit'] = financial_df['total_sales'] - financial_df['total_input']
financial_df['profit_margin'] = np.where(financial_df['total_sales'] > 0, financial_df['profit'] / financial_df['total_sales'], 0)

# Compute revenue capacity: we can use total sales as proxy, but maybe per year average.
# Let's compute annual sales per company
sales_df['year'] = sales_df['Invoice Date'].dt.year
annual_sales = sales_df.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().reset_index()
input_df['year'] = input_df['Invoice Date'].dt.year
annual_input = input_df.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().reset_index()

# Merge annual sales and input
annual = pd.merge(annual_sales, annual_input, on=['Enterprise Code', 'year'], how='outer', suffixes=('_sales', '_input'))
annual.fillna(0, inplace=True)
annual['annual_profit'] = annual['Amount Including Tax_sales'] - annual['Amount Including Tax_input']

# Compute stability metrics per company: coefficient of variation of profit across years
def cv(x):
    if len(x) > 1 and x.mean() != 0:
        return x.std() / x.mean()
    else:
        return np.nan

profit_cv = annual.groupby('Enterprise Code')['annual_profit'].apply(cv).rename('profit_cv')
profit_std = annual.groupby('Enterprise Code')['annual_profit'].std().rename('profit_std')
profit_mean = annual.groupby('Enterprise Code')['annual_profit'].mean().rename('profit_mean')
# Count years
year_count = annual.groupby('Enterprise Code')['year'].nunique().rename('years')

# Compute upstream/downstream dependency metrics
# Downstream dependency concentration: for each company, count unique buyers and compute HHI of sales to each buyer
buyer_sales = sales_df.groupby(['Enterprise Code', 'Buyer organization code'])['Amount Including Tax'].sum().reset_index()
def hhi(x):
    total = x.sum()
    if total == 0:
        return np.nan
    share = x / total
    return (share ** 2).sum() * 10000  # HHI index (0-10000)
buyer_hhi = buyer_sales.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('downstream_hhi')
buyer_unique = buyer_sales.groupby('Enterprise Code')['Buyer organization code'].nunique().rename('num_buyers')

# Upstream dependency concentration: similar for sellers in input
seller_input = input_df.groupby(['Enterprise Code', 'Seller Organization Code'])['Amount Including Tax'].sum().reset_index()
seller_hhi = seller_input.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('upstream_hhi')
seller_unique = seller_input.groupby('Enterprise Code')['Seller Organization Code'].nunique().rename('num_sellers')

# Combine all features
features = pd.concat([financial_df, profit_cv, profit_std, profit_mean, year_count, buyer_hhi, buyer_unique, seller_hhi, seller_unique], axis=1)
features = features.fillna(0)

# Merge with company info
company_features = company_df.set_index('Enterprise Code').join(features, how='inner')
print(company_features.head())

# Save features for later
company_features.to_csv('/workspace/company_features.csv')
print("Features saved to company_features.csv")
```
