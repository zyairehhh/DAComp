# Incorporate churn into credit limit adjustment: maybe reduce limit for high churn.
# For each rating, we have churn rate at assigned interest rate.
def get_churn_at_rate(rating, rate, churn_df):
    if rating == 'D':
        return 1.0  # assume 100% churn (default)
    col = f'Credit Rating {rating} Customer Churn Rate'
    # find row where rate matches exactly
    match = churn_df[churn_df['Annual Loan Interest Rate'] == rate]
    if not match.empty:
        return match.iloc[0][col]
    else:
        # interpolate
        # find nearest rate
        idx = (churn_df['Annual Loan Interest Rate'] - rate).abs().idxmin()
        return churn_df.loc[idx, col]

df['churn_rate'] = df.apply(lambda row: get_churn_at_rate(row['Credit Rating'], row['interest_rate'], churn), axis=1)
# Adjust credit limit by (1 - churn_rate) to reflect expected loss
print("\nAdjusting credit limits by churn probability...")
df['credit_limit_adjusted'] = df['credit_limit'] * (1 - df['churn_rate'])
# Renormalize to keep total credit same? We can either keep total constant or allow reduction.
# To keep total credit allocation at 100m, renormalize.
df['credit_limit_adjusted'] = df['credit_limit_adjusted'] / df['credit_limit_adjusted'].sum() * total_credit

print("\nAdjusted Credit Allocation Summary (top 20):")
print(df[['Enterprise Code', 'Credit Rating', 'churn_rate', 'credit_limit', 'credit_limit_adjusted', 'interest_rate']].head(20))
print(f"\nTotal adjusted credit: {df['credit_limit_adjusted'].sum():,.2f} RMB")

print("\nFinal allocation by rating:")
final_allocation = df.groupby('Credit Rating').agg({'credit_limit_adjusted':'sum', 'interest_rate':'mean'}).reset_index()
