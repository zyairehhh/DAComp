import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation data with tags
query = '''
SELECT conversation_id, conversation_initiated_type, 
       all_conversation_tags,
       time_to_first_response_minutes,
       time_to_admin_first_close_minutes,
       conversation_created_at,
       conversation_last_updated_at
FROM intercom__conversation_enhanced
'''
df = pd.read_sql(query, conn)
conn.close()

# Parse tags into columns
def parse_tag(tag_str):
    if not tag_str:
        return {}
    tags = {}
    for item in tag_str.split('|'):
        if ':' in item:
            key, val = item.split(':', 1)
            tags[key] = val
    return tags

df['tags'] = df['all_conversation_tags'].apply(parse_tag)
df['stage'] = df['tags'].apply(lambda x: x.get('stage', ''))
df['intent'] = df['tags'].apply(lambda x: x.get('intent', ''))
df['topic'] = df['tags'].apply(lambda x: x.get('topic', ''))
df['segment'] = df['tags'].apply(lambda x: x.get('segment', ''))
df['region'] = df['tags'].apply(lambda x: x.get('region', ''))
df['lifecycle'] = df['tags'].apply(lambda x: x.get('lifecycle', ''))

# Path column (conversation_initiated_type)
df['path'] = df['conversation_initiated_type']  # human_first / bot_first

print(f"Total conversations: {len(df)}")
print(df['path'].value_counts())
print(df['stage'].value_counts())

# Define stage mapping to funnel stages
# We'll consider stages that represent conversions
# demo_booked, trial_started, trial_activated, closed_won (paid), closed_lost
# We'll compute conversion rates across these

# Save data for further use if needed
df.to_csv('conversations_parsed.csv', index=False)
print("Data saved to conversations_parsed.csv")
```
