'''
import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-019.sqlite')

# Load tables
basic = pd.read_sql_query('SELECT * FROM basic_drug_information', conn)
inventory = pd.read_sql_query('SELECT * FROM inventory_management', conn)
pricing = pd.read_sql_query('SELECT * FROM pricing_system', conn)

conn.close()

# Rename duplicate column for clarity
inventory.rename(columns={'Near-expiry Quantity.1': 'Expired Quantity_dup'}, inplace=True)
# Actually expired quantity column is separate; we can keep both.

# Merge basic and inventory on Drug ID
merged = pd.merge(basic, inventory, left_on='Drug ID', right_on='Drug ID', how='inner')
# Merge pricing
merged = pd.merge(merged, pricing, left_on='Drug ID', right_on='Drug ID', how='left')

# For safety, ensure we have all rows
print(f"Merged shape: {merged.shape}")

# Filter for Imported and Joint-venture
merged_foreign = merged[merged['Origin / Tier (Domestic/Imported/JV)'].isin(['Imported', 'Joint-venture'])]
print(f"Foreign drugs count: {merged_foreign.shape[0]}")

# Compute backlog score: near-expiry + expired relative to qualified quantity
# Avoid division by zero
merged_foreign['backlog_score'] = (merged_foreign['Near-expiry Quantity'] + merged_foreign['Expired Quantity']) / (merged_foreign['Qualified Quantity'] + 1)

# Supply interruption score components
# 1. Inventory Alert Status: Normal -> 0, Alert -> 1, Severe -> 2?
alert_map = {'Normal': 0, 'Alert': 1, 'Severe': 2}
merged_foreign['alert_score'] = merged_foreign['Inventory Alert Status'].map(alert_map).fillna(0)

# 2. Abnormal Price Fluctuation Flag: Yes -> 1, No -> 0
merged_foreign['abnormal_price_score'] = (merged_foreign['Abnormal Price Fluctuation Flag'] == 'Yes').astype(int)

# 3. Quarantine Quantity (normalized by qualified quantity)
merged_foreign['quarantine_ratio'] = merged_foreign['Quarantine Quantity'] / (merged_foreign['Qualified Quantity'] + 1)

# 4. Inventory Discrepancy Rate: convert string to float
def parse_discrepancy_rate(s):
    if isinstance(s, str):
        s = s.replace('%', '').strip()
        try:
            return float(s) / 100.0  # convert to fraction
        except:
            return 0.0
    elif isinstance(s, (int, float)):
        return s / 100.0
    else:
        return 0.0

merged_foreign['discrepancy_rate'] = merged_foreign['Inventory Discrepancy Rate'].apply(parse_discrepancy_rate)

# Composite supply interruption score (can weight as needed)
merged_foreign['supply_interruption_score'] = (
    merged_foreign['alert_score'] +
    merged_foreign['abnormal_price_score'] +
    merged_foreign['quarantine_ratio'] * 10 +  # scale up because small ratio
    merged_foreign['discrepancy_rate'] * 10
)

# Quality risk score
# Contamination and damage quantities
quality_qty = (
    merged_foreign['Damaged Quantity'] +
    merged_foreign['Pest/Mold Damage Quantity'] +
    merged_foreign['Rodent Contamination Quantity'] +
    merged_foreign['Air Contamination Quantity'] +
    merged_foreign['Temp/Humidity Excursion Record'] +
    merged_foreign['Returned Quantity']
)
# Normalize by qualified quantity?
merged_foreign['quality_quantity_score'] = quality_qty / (merged_foreign['Qualified Quantity'] + 1)

# Adverse reaction and contraindication presence
merged_foreign['has_adverse'] = merged_foreign['Adverse Reaction Code'].notna().astype(int)
merged_foreign['has_contraindication'] = merged_foreign['Contraindication Code'].notna().astype(int)

merged_foreign['quality_risk_score'] = (
    merged_foreign['quality_quantity_score'] * 10 +  # scale
    merged_foreign['has_adverse'] +
    merged_foreign['has_contraindication']
)

# Select columns for output
cols_of_interest = [
    'Drug ID', 'Specification / Description', 'Manufacturer',
    'Origin / Tier (Domestic/Imported/JV)',
    'backlog_score', 'supply_interruption_score', 'quality_risk_score',
    'Qualified Quantity', 'Near-expiry Quantity', 'Expired Quantity',
    'Quarantine Quantity', 'Inventory Alert Status',
    'Abnormal Price Fluctuation Flag', 'Inventory Discrepancy Rate',
    'Damaged Quantity', 'Pest/Mold Damage Quantity',
    'Rodent Contamination Quantity', 'Air Contamination Quantity',
    'Temp/Humidity Excursion Record', 'Returned Quantity',
    'Adverse Reaction Code', 'Contraindication Code'
]

result = merged_foreign[cols_of_interest].copy()

# Rank within each origin type for each risk dimension
result['backlog_rank'] = result.groupby('Origin / Tier (Domestic/Imported/JV)')['backlog_score'].rank(ascending=False, method='min')
result['supply_rank'] = result.groupby('Origin / Tier (Domestic/Imported/JV)')['supply_interruption_score'].rank(ascending=False, method='min')
result['quality_rank'] = result.groupby('Origin / Tier (Domestic/Imported/JV)')['quality_risk_score'].rank(ascending=False, method='min')

# Overall risk score as sum of normalized ranks? Or sum of scores.
# Normalize scores per dimension
for col in ['backlog_score', 'supply_interruption_score', 'quality_risk_score']:
    max_val = result[col].max()
    if max_val > 0:
        result[col + '_norm'] = result[col] / max_val
    else:
        result[col + '_norm'] = 0

result['overall_risk_score'] = (result['backlog_score_norm'] + result['supply_interruption_score_norm'] + result['quality_risk_score_norm'])

result['overall_rank'] = result.groupby('Origin / Tier (Domestic/Imported/JV)')['overall_risk_score'].rank(ascending=False, method='min')

# Sort by overall_risk_score descending
result_sorted = result.sort_values('overall_risk_score', ascending=False)

# Save to CSV for inspection
result_sorted.to_csv('risk_scores_foreign.csv', index=False)
print("Saved risk_scores_foreign.csv")
print("Top 10 drugs requiring prioritized supervision:")
print(result_sorted.head(10)[['Drug ID', 'Specification / Description', 'Origin / Tier (Domestic/Imported/JV)', 'overall_risk_score', 'backlog_score', 'supply_interruption_score', 'quality_risk_score']])
''')
