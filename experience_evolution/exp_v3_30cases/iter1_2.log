import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Load stage metrics
df = pd.read_csv('stage_metrics.csv')
print(df)

# Compute pass_rate: for Hired stage, pass_rate = 1.0 (since all are hired). For other stages, pass_rate = advanced_count / total_entries
df['pass_rate'] = df.apply(lambda row: row['advanced_count'] / row['total_entries'] if row['stage'] != 'Hired' else 1.0, axis=1)
df['attrition_rate'] = 1 - df['pass_rate']

# Compute efficiency index: pass_rate / avg_days * 100
df['efficiency_index'] = df['pass_rate'] / df['avg_days'] * 100

# Identify bottlenecks: avg_days > 25 and attrition_rate > 0.4
df['bottleneck'] = (df['avg_days'] > 25) & (df['attrition_rate'] > 0.4)
df['low_efficiency'] = df['efficiency_index'] < 1.5

print("\nMetrics with bottlenecks:")
print(df[['stage','avg_days','attrition_rate','efficiency_index','bottleneck','low_efficiency']])

# Filter for stages with at least 100 samples (all stages already have >100 except Reference Check, Offer Discussion, Background Check, Hired)
df_filtered = df[df['total_entries'] >= 100].copy()

# Prepare for plotting: stage order as per stage_id
order = ['STAGE_01','STAGE_02','STAGE_03','STAGE_04','STAGE_05','STAGE_06','STAGE_07','STAGE_08','STAGE_09','STAGE_10']
df['order'] = pd.Categorical(df['stage_id'], categories=order, ordered=True)
df = df.sort_values('order')
df_filtered['order'] = pd.Categorical(df_filtered['stage_id'], categories=order, ordered=True)
df_filtered = df_filtered.sort_values('order')

# Plot 1: Average days per stage (bar chart)
plt.figure(figsize=(10, 6))
bars = plt.bar(df['stage'], df['avg_days'], color='skyblue', edgecolor='black')
# Highlight those exceeding 25 days
for bar, stage in zip(bars, df['stage']):
    if df.loc[df['stage'] == stage, 'avg_days'].values[0] > 25:
        bar.set_color('red')
plt.axhline(y=25, color='r', linestyle='--', label='Threshold (25 days)')
plt.title('Average Days Spent in Each Hiring Stage')
plt.xlabel('Stage')
plt.ylabel('Average Days')
plt.xticks(rotation=45, ha='right')
plt.legend()
plt.tight_layout()
plt.savefig('avg_days_per_stage.png', dpi=300)
plt.close()

# Plot 2: Attrition Rate per stage
plt.figure(figsize=(10, 6))
bars = plt.bar(df['stage'], df['attrition_rate']*100, color='lightcoral', edgecolor='black')
# Highlight those > 40%
for bar, stage in zip(bars, df['stage']):
    if df.loc[df['stage'] == stage, 'attrition_rate'].values[0] > 0.4:
        bar.set_color('darkred')
plt.axhline(y=40, color='r', linestyle='--', label='Threshold (40%)')
plt.title('Attrition Rate per Hiring Stage (%)')
plt.xlabel('Stage')
plt.ylabel('Attrition Rate (%)')
plt.xticks(rotation=45, ha='right')
plt.legend()
plt.tight_layout()
plt.savefig('attrition_rate_per_stage.png', dpi=300)
plt.close()

# Plot 3: Efficiency Index per stage
plt.figure(figsize=(10, 6))
bars = plt.bar(df['stage'], df['efficiency_index'], color='lightgreen', edgecolor='black')
# Highlight those below 1.5
for bar, stage in zip(bars, df['stage']):
    if df.loc[df['stage'] == stage, 'efficiency_index'].values[0] < 1.5:
        bar.set_color('darkred')
plt.axhline(y=1.5, color='r', linestyle='--', label='Threshold (1.5)')
plt.title('Efficiency Index per Hiring Stage')
plt.xlabel('Stage')
plt.ylabel('Efficiency Index (pass_rate / avg_days * 100)')
plt.xticks(rotation=45, ha='right')
plt.legend()
plt.tight_layout()
plt.savefig('efficiency_index_per_stage.png', dpi=300)
plt.close()

# Save metrics to CSV for reference
df.to_csv('stage_metrics_with_calculations.csv', index=False)

# Print summary of bottlenecks
bottleneck_stages = df[df['bottleneck']][['stage', 'avg_days', 'attrition_rate']]
print(f"\nBottleneck stages (avg_days > 25 & attrition > 40%):")
print(bottleneck_stages)

low_efficiency_stages = df[df['low_efficiency']][['stage', 'efficiency_index','avg_days','pass_rate']]
print(f"\nStages with efficiency index < 1.5:")
print(low_efficiency_stages)
