Action: CreateFile(filepath='/workspace/trend_analysis.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-078/stage1_env/dacomp-078.sqlite')

# Monthly aggregates for each visitor
monthly_df = pd.read_sql_query('''
SELECT visitor_id, 
       strftime('%Y-%m', date_day) as month,
       SUM(sum_minutes) as monthly_minutes,
       SUM(sum_events) as monthly_events
FROM pendo__visitor_daily_metrics
GROUP BY visitor_id, month
ORDER BY visitor_id, month
''', conn)
print("Monthly aggregates shape:", monthly_df.shape)

# Compute slope of minutes over time (month index) per visitor
def compute_slope(group):
    months = group['month'].values
    # convert month string to ordinal (e.g., 2024-01 -> 1)
    # but easier: use index of order
    x = np.arange(len(months))
    y = group['monthly_minutes'].values
    if len(x) >= 2:
        slope = np.polyfit(x, y, 1)[0]
        return slope
    else:
        return np.nan

slopes = monthly_df.groupby('visitor_id').apply(compute_slope).reset_index(name='slope_minutes')
slopes = slopes.dropna()
print("Visitors with slope computed:", slopes.shape[0])

# Load high-value label (previous definition)
visitor_df = pd.read_sql_query("SELECT visitor_id, sum_minutes, sum_events FROM pendo__visitor;", conn)
threshold_minutes = visitor_df['sum_minutes'].quantile(0.8)
threshold_events = visitor_df['sum_events'].quantile(0.8)
visitor_df['high_value'] = (visitor_df['sum_minutes'] >= threshold_minutes) & (visitor_df['sum_events'] >= threshold_events)

# Merge
merged = visitor_df.merge(slopes, on='visitor_id', how='inner')

# Correlation between slope and high_value
corr = merged[['high_value', 'slope_minutes']].corr().iloc[0,1]
print(f"Correlation between high_value and slope of monthly minutes: {corr:.4f}")

# Distribution of slope for high vs low
print("\nSlope statistics:")
print("High-value mean slope:", merged[merged['high_value']]['slope_minutes'].mean())
print("Non-high-value mean slope:", merged[~merged['high_value']]['slope_minutes'].mean())

# Compute slope of events similarly
def compute_slope_events(group):
    x = np.arange(len(group))
    y = group['monthly_events'].values
    if len(x) >= 2:
        slope = np.polyfit(x, y, 1)[0]
        return slope
    else:
        return np.nan

slopes_events = monthly_df.groupby('visitor_id').apply(compute_slope_events).reset_index(name='slope_events')
slopes_events = slopes_events.dropna()
merged = merged.merge(slopes_events, on='visitor_id', how='left')
corr_events = merged[['high_value', 'slope_events']].corr().iloc[0,1]
print(f"Correlation between high_value and slope of monthly events: {corr_events:.4f}")

# Also compute volatility (std of monthly minutes)
volatility = monthly_df.groupby('visitor_id')['monthly_minutes'].std().reset_index(name='volatility_minutes')
merged = merged.merge(volatility, on='visitor_id', how='left')
corr_vol = merged[['high_value', 'volatility_minutes']].corr().iloc[0,1]
print(f"Correlation between high_value and volatility of monthly minutes: {corr_vol:.4f}")

# Compute ratio of last month to first month (growth factor)
def growth_factor(group):
    if len(group) >= 2:
        first = group['monthly_minutes'].iloc[0]
        last = group['monthly_minutes'].iloc[-1]
        if first > 0:
            return last / first
        else:
            return np.nan
    else:
        return np.nan
