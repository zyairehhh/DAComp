import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

print("Creating additional visualizations...")

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# Get ad group data
query = """
SELECT 
    campaign_name,
    ad_group_name,
    SUM(clicks) as clicks,
    SUM(impressions) as impressions,
    SUM(conversions) as conversions
FROM google_ads__ad_group_report
GROUP BY campaign_name, ad_group_name
HAVING impressions > 0 AND clicks > 0
"""

df = pd.read_sql_query(query, conn)
print(f"Loaded {len(df)} ad groups")

# Calculate metrics
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
df['Conversions_per_Impression'] = df['conversions'] / df['impressions']

# Clean data
df.replace([np.inf, -np.inf], np.nan, inplace=True)
df.dropna(subset=['CTR', 'CVR'], inplace=True)

# Calculate percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

# Identify problematic groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
non_problematic = df[~((df['CTR'] > ctr_75) & (df['CVR'] < cvr_25))].copy()

print(f"Problematic: {len(problematic)}, Non-problematic: {len(non_problematic)}")

# ================== 1. Traffic Quality Comparison ==================
# Plot conversions per impression comparison
plt.figure(figsize=(10, 6))

# Calculate averages
avg_conv_per_imp_problematic = problematic['Conversions_per_Impression'].mean()
avg_conv_per_imp_non_problematic = non_problematic['Conversions_per_Impression'].mean()

categories = ['Problematic Groups', 'Non-problematic Groups']
values = [avg_conv_per_imp_problematic, avg_conv_per_imp_non_problematic]

bars = plt.bar(categories, values, color=['coral', 'skyblue'], alpha=0.8)
plt.ylabel('Conversions per Impression')
plt.title('Traffic Quality: Conversions per Impression Comparison')
plt.grid(True, alpha=0.3, axis='y')

# Add value labels on bars
for bar, value in zip(bars, values):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.00005,
             f'{value:.5f}', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('traffic_quality_comparison.png', dpi=150)
plt.close()
print("Saved traffic_quality_comparison.png")

# ================== 2. Keyword Match Type Analysis ==================
# Get keyword data for problematic groups
keyword_query = """
SELECT 
    k.keyword_match_type,
    COUNT(*) as keyword_count
FROM google_ads__keyword_report k
WHERE k.ad_group_name IN (
    SELECT ad_group_name 
    FROM google_ads__ad_group_report 
    GROUP BY ad_group_name
    HAVING SUM(clicks) > 0 AND SUM(impressions) > 0
    AND SUM(clicks)/SUM(impressions) > ? 
    AND SUM(conversions)/SUM(clicks) < ?
)
GROUP BY k.keyword_match_type
ORDER BY keyword_count DESC
"""

keyword_df = pd.read_sql_query(keyword_query, conn, params=[ctr_75, cvr_25])
print(f"Keyword match type data: {len(keyword_df)} categories")

if len(keyword_df) > 0:
    plt.figure(figsize=(10, 6))
    colors = plt.cm.Set3(np.linspace(0, 1, len(keyword_df)))
    bars = plt.bar(keyword_df['keyword_match_type'], keyword_df['keyword_count'], 
                   color=colors, edgecolor='black')
    plt.xlabel('Keyword Match Type')
    plt.ylabel('Keyword Count')
    plt.title('Keyword Match Types in Problematic Ad Groups')
    plt.xticks(rotation=45, ha='right')
    plt.grid(True, alpha=0.3, axis='y')
    
    # Add value labels on bars
    for bar in bars:
        height = bar.get_height()
        plt.text(bar.get_x() + bar.get_width()/2, height + 5,
                 f'{int(height)}', ha='center', va='bottom', fontsize=9)
    
    plt.tight_layout()
    plt.savefig('keyword_match_types.png', dpi=150)
    plt.close()
    print("Saved keyword_match_types.png")

