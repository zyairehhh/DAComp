import sqlite3
import pandas as pd
import json
from collections import defaultdict

conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation enhanced with tags
df = pd.read_sql_query("SELECT conversation_id, conversation_created_at, conversation_initiated_type, all_conversation_tags FROM intercom__conversation_enhanced WHERE all_conversation_tags IS NOT NULL AND all_conversation_tags != ''", conn)
conn.close()

# Parse tags
def parse_tags(tag_string):
    d = {}
    parts = tag_string.split('|')
    for part in parts:
        if ':' in part:
            key, val = part.split(':', 1)
            d[key.strip()] = val.strip()
    return d

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['path'] = df['tags_dict'].apply(lambda d: d.get('path', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['topic'] = df['tags_dict'].apply(lambda d: d.get('topic', ''))
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))
df['lifecycle'] = df['tags_dict'].apply(lambda d: d.get('lifecycle', ''))

# Keep only bot_first vs human_first
df = df[df['path'].isin(['bot_first', 'human_first'])]

print(df.head())
print(df['stage'].value_counts())
print(df['path'].value_counts())
```
