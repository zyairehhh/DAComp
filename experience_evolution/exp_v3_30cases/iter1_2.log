import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-066.sqlite')

# Query to get conversion rates per job with department info
query = """
SELECT 
    r.job_id,
    r.job_title,
    r.interview_rate,
    r.application_year,
    r.application_quarter,
    j.departments,
    j.hiring_managers
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced j ON r.job_id = j.job_id
WHERE r.interview_rate IS NOT NULL
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Categorize job titles into roles
def categorize_role(title):
    title_lower = str(title).lower()
    if 'frontend' in title_lower or 'front end' in title_lower:
        return 'Frontend'
    elif 'backend' in title_lower or 'back end' in title_lower:
        return 'Backend'
    elif 'data' in title_lower:
        return 'Data'
    elif 'full stack' in title_lower or 'fullstack' in title_lower:
        return 'Full Stack'
    else:
        return 'Other Engineer'

df['role'] = df['job_title'].apply(categorize_role)

# Filter for Engineering department
eng_df = df[df['departments'] == 'Engineering'].copy()

# Compute quarter as numeric for sorting
eng_df['quarter_num'] = eng_df['application_year'] + eng_df['application_quarter'] / 4

# Group by role and quarter to get average conversion rate
trend = eng_df.groupby(['role', 'application_year', 'application_quarter']).agg(
    avg_interview_rate=('interview_rate', 'mean'),
    count=('job_id', 'count')
).reset_index()
trend['quarter_label'] = trend['application_year'].astype(str) + 'Q' + trend['application_quarter'].astype(str)

# Plot trend lines for each role
plt.figure(figsize=(10,6))
roles = ['Frontend', 'Backend', 'Data', 'Full Stack', 'Other Engineer']
colors = plt.cm.Set2(np.linspace(0,1,len(roles)))
for i, role in enumerate(roles):
    role_data = trend[trend['role'] == role]
    if len(role_data) > 0:
        plt.plot(role_data['quarter_label'], role_data['avg_interview_rate'], marker='o', label=role, color=colors[i])

plt.title('Engineering Department: Application to Interview Conversion Rate by Role')
plt.xlabel('Quarter')
plt.ylabel('Conversion Rate (%)')
plt.legend(title='Role')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('engineering_role_conversion_trend.png')
plt.close()

# Also compute overall Engineering vs Marketing department trend
dept_trend = df.groupby(['departments', 'application_year', 'application_quarter']).agg(
    avg_interview_rate=('interview_rate', 'mean'),
    count=('job_id', 'count')
).reset_index()
dept_trend['quarter_label'] = dept_trend['application_year'].astype(str) + 'Q' + dept_trend['application_quarter'].astype(str)

plt.figure(figsize=(10,6))
for dept in ['Engineering', 'Marketing']:
    dept_data = dept_trend[dept_trend['departments'] == dept]
    if len(dept_data) > 0:
        plt.plot(dept_data['quarter_label'], dept_data['avg_interview_rate'], marker='s', label=dept)

plt.title('Engineering vs Marketing: Application to Interview Conversion Rate')
plt.xlabel('Quarter')
plt.ylabel('Conversion Rate (%)')
plt.legend(title='Department')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('engineering_vs_marketing.png')
plt.close()

print("Plots saved.")
```
