           SUM(monthly_gross_profit) as total_gross_profit
    FROM quickbooks__profitability_analysis
    GROUP BY revenue_month_start
    ORDER BY revenue_month_start
""", conn)
df_monthly['revenue_month_start'] = pd.to_datetime(df_monthly['revenue_month_start'])
print(f"\nMonthly aggregated revenue records: {len(df_monthly)}")

# For simplicity, compute high-volatility customers' profit share
high_vol_monthly = pd.merge(df_profit, high_vol_customers[['customer_id']], on='customer_id', how='inner')
if not high_vol_monthly.empty:
    high_vol_monthly['month'] = high_vol_monthly['transaction_date'].dt.to_period('M').dt.to_timestamp()
    monthly_high = high_vol_monthly.groupby('month')['gross_profit'].sum().reset_index()
    # Merge with total monthly profit from df_monthly (approximate)
    # align months
    df_monthly['month'] = df_monthly['revenue_month_start']
    merged = pd.merge(df_monthly, monthly_high, on='month', how='left', suffixes=('_total', '_high_vol'))
    merged['profit_share_high_vol'] = merged['gross_profit'] / merged['total_gross_profit']
    # Merge with dashboard by month (dashboard_month is start of month? assume same)
    merged['dashboard_month'] = merged['month']
    df_dash['dashboard_month'] = pd.to_datetime(df_dash['dashboard_month'])
    dash_merged = pd.merge(df_dash, merged[['dashboard_month', 'profit_share_high_vol']], on='dashboard_month', how='left')
    # Correlation between profit share and business_health_score
    corr_health = dash_merged['profit_share_high_vol'].corr(dash_merged['business_health_score'])
    corr_collection = dash_merged['profit_share_high_vol'].corr(dash_merged['collection_rate_percentage'])
    print(f"\nCorrelation between high-volatility profit share and business_health_score: {corr_health:.4f}")
    print(f"Correlation between high-volatility profit share and collection_rate_percentage: {corr_collection:.4f}")
else:
    print("\nNo high-volatility profit data in past 12 months.")

# 6. Risk exposure distribution based on accounts receivable structure
df_ar = pd.read_sql_query("""
    SELECT account_class, account_type, account_name, amount, period_last_day
    FROM quickbooks__balance_sheet
    WHERE account_class = 'Accounts Receivable' OR account_type = 'Accounts Receivable'
    ORDER BY period_last_day DESC
""", conn)
print(f"\nAccounts receivable records: {len(df_ar)}")
if not df_ar.empty:
    latest_ar = df_ar[df_ar['period_last_day'] == df_ar['period_last_day'].max()]
    total_ar = latest_ar['amount'].sum()
    print(f"Total AR amount (latest period): {total_ar:.2f}")
    print("Distribution by account_name (top 10):")
    print(latest_ar.groupby('account_name')['amount'].sum().sort_values(ascending=False).head(10))

# 7. Multi-dimensional customer risk rating model (simplified)
# Combine metrics: customer_margin_volatility, cv_gross_profit, var_qoq_growth, revenue_trend_correlation, risk_assessment, credit_score
df_risk = df_cust[['customer_id', 'customer_margin_volatility', 'revenue_trend_correlation', 'risk_assessment', 'credit_score']]
df_risk = df_risk.merge(cv_df, on='customer_id', how='left')
df_risk = df_risk.merge(growth_var, on='customer_id', how='left')
# Normalize each metric (min-max scaling) and assign weights
# For simplicity, we'll compute a risk score ranging 0-1 where higher is riskier.
# We'll invert revenue_trend_correlation and credit_score (higher correlation and credit scores reduce risk)
df_risk['volatility_norm'] = (df_risk['customer_margin_volatility'] - df_risk['customer_margin_volatility'].min()) / (df_risk['customer_margin_volatility'].max() - df_risk['customer_margin_volatility'].min())
df_risk['cv_norm'] = (df_risk['cv_gross_profit'] - df_risk['cv_gross_profit'].min()) / (df_risk['cv_gross_profit'].max() - df_risk['cv_gross_profit'].min())
df_risk['var_growth_norm'] = (df_risk['var_qoq_growth'] - df_risk['var_qoq_growth'].min()) / (df_risk['var_qoq_growth'].max() - df_risk['var_qoq_growth'].min())
df_risk['rev_trend_norm'] = 1 - (df_risk['revenue_trend_correlation'] - df_risk['revenue_trend_correlation'].min()) / (df_risk['revenue_trend_correlation'].max() - df_risk['revenue_trend_correlation'].min())
# Risk assessment mapping: assume categorical values
risk_map = {'High': 1.0, 'Medium': 0.5, 'Low': 0.0}
df_risk['risk_assessment_score'] = df_risk['risk_assessment'].map(risk_map)
df_risk['risk_assessment_score'] = df_risk['risk_assessment_score'].fillna(0.5)
df_risk['credit_norm'] = 1 - (df_risk['credit_score'] - df_risk['credit_score'].min()) / (df_risk['credit_score'].max() - df_risk['credit_score'].min())
# Compute weighted risk score
weights = {'volatility': 0.3, 'cv': 0.2, 'var_growth': 0.2, 'rev_trend': 0.1, 'risk_assess': 0.1, 'credit': 0.1}
df_risk['risk_score'] = (df_risk['volatility_norm'] * weights['volatility'] +
                         df_risk['cv_norm'] * weights['cv'] +
                         df_risk['var_growth_norm'] * weights['var_growth'] +
                         df_risk['rev_trend_norm'] * weights['rev_trend'] +
                         df_risk['risk_assessment_score'] * weights['risk_assess'] +
                         df_risk['credit_norm'] * weights['credit'])
print("\nRisk score distribution (for high-volatility customers):")
high_vol_risk = df_risk[df_risk['customer_id'].isin(high_vol_customers['customer_id'])]
print(high_vol_risk['risk_score'].describe())

# 8. Propose targeted customer management strategies based on segments
# Identify high-risk customers (risk_score > 0.7) and examine their behavioral features
high_risk = high_vol_risk[high_vol_risk['risk_score'] > 0.7]
print(f"\nNumber of high-risk high-volatility customers: {len(high_risk)}")
if len(high_risk) > 0:
    print("Lifecycle stage distribution of high-risk customers:")
    high_risk_details = high_risk.merge(df_cust[['customer_id', 'lifecycle_stage', 'payment_behavior', 'rfm_segment']], on='customer_id')
    print(high_risk_details['lifecycle_stage'].value_counts())
    print("\nPayment behavior distribution:")
    print(high_risk_details['payment_behavior'].value_counts())

conn.close()

# Write summary to markdown
with open('stage1.md', 'w') as f:
    f.write("# Profitability Volatility and Customer Risk Analysis\n\n")
    f.write("## 1. High-Volatility Customer Segment\n")
    f.write(f"- **Total customers**: {len(df_vol)}\n")
    f.write(f"- **High-volatility customers (top 25%)**: {len(high_vol_customers)}\n")
    f.write(f"- **Threshold customer_margin_volatility**: {threshold:.4f}\n\n")
    f.write("## 2. Profit Stability Metrics\n")
    f.write(f"- **Average coefficient of variation (CV) of gross profit** over past 12 months: {cv_df['cv_gross_profit'].mean():.4f} (std: {cv_df['cv_gross_profit'].std():.4f})\n")
    f.write(f"- **Median CV**: {cv_df['cv_gross_profit'].median():.4f}\n")
    f.write(f"- **Variance of quarter-over-quarter invoice total growth rate** average: {growth_var['var_qoq_growth'].mean():.6f} (std: {growth_var['var_qoq_growth'].std():.6f})\n\n")
    f.write("## 3. Relationship with Customer Lifecycle and Payment Patterns\n")
    f.write("### High-volatility customers by lifecycle stage:\n")
    for stage, count in high_vol_behavior['lifecycle_stage'].value_counts().items():
        f.write(f"- {stage}: {count} ({count/len(high_vol_behavior)*100:.1f}%)\n")
    f.write("\n### High-volatility customers by payment behavior:\n")
    for behavior, count in high_vol_behavior['payment_behavior'].value_counts().items():
        f.write(f"- {behavior}: {count} ({count/len(high_vol_behavior)*100:.1f}%)\n")
    f.write("\n### High-volatility customers by RFM segment (top 5):\n")
    top_rfm = high_vol_behavior['rfm_segment'].value_counts().head(5)
    for seg, count in top_rfm.items():
        f.write(f"- {seg}: {count}\n")
    f.write("\n## 4. Contribution to Business Health and Collection Rate\n")
    if 'corr_health' in locals():
        f.write(f"- Correlation between high-volatility profit share and business health score: **{corr_health:.4f}**\n")
        f.write(f"- Correlation between high-volatility profit share and collection rate percentage: **{corr_collection:.4f}**\n")
    else:
        f.write("- Insufficient data for correlation analysis.\n")
    f.write("\n## 5. Accounts Receivable Risk Exposure\n")
    if not df_ar.empty:
        f.write(f"- Total accounts receivable (latest period): **{total_ar:,.2f}**\n")
        f.write("- Top account components:\n")
        top_accounts = latest_ar.groupby('account_name')['amount'].sum().sort_values(ascending=False).head(5)
        for acc, amt in top_accounts.items():
            f.write(f"  - {acc}: {amt:,.2f}\n")
    else:
        f.write("- No accounts receivable data found.\n")
    f.write("\n## 6. Multi-Dimensional Customer Risk Rating Model\n")
    f.write("Risk score computed using normalized metrics: customer margin volatility, CV of gross profit, variance of quarterly growth, revenue trend correlation, risk assessment, and credit score.\n")
    f.write(f"- **Average risk score** among high-volatility customers: {high_vol_risk['risk_score'].mean():.4f}\n")
    f.write(f"- **High-risk customers (risk score > 0.7)**: {len(high_risk)} out of {len(high_vol_customers)} high-volatility customers.\n")
    if len(high_risk) > 0:
        f.write("\n### High-Risk Customer Characteristics:\n")
        f.write("- **Lifecycle stage distribution**:\n")
        for stage, count in high_risk_details['lifecycle_stage'].value_counts().items():
            f.write(f"  - {stage}: {count}\n")
        f.write("- **Payment behavior distribution**:\n")
        for behav, count in high_risk_details['payment_behavior'].value_counts().items():
            f.write(f"  - {behav}: {count}\n")
    f.write("\n## 7. Recommendations for Targeted Customer Management\n")
    f.write("1. **High-volatility, high-risk customers** require tailored pricing and credit terms to mitigate profit instability.\n")
    f.write("2. **Customers in 'New Customer' lifecycle stage** exhibit higher volatility; consider onboarding programs to stabilize their purchasing patterns.\n")
    f.write("3. **Improve collection rate** by focusing on high-volatility customers with poor payment behavior, offering early payment discounts.\n")
    f.write("4. **Monitor accounts receivable concentration** and diversify exposure across customer segments.\n")
    f.write("5. **Implement dynamic credit limits** based on the risk score; auto-adjust based on recent volatility.\n")
    f.write("6. **Develop proactive retention programs** for high-value but volatile customers to reduce churn.\n")

print("\nReport written to stage1.md")
''')
