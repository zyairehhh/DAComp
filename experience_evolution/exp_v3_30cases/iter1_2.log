collection_threshold = df['collection_rate'].quantile(0.25)
df['collection_risk_score'] = np.where(df['collection_rate'] <= collection_threshold, 1, 0)

# Calculate composite risk score (weights can be adjusted)
df['composite_risk_score'] = (
    df['volatility_score'] * 0.3 +
