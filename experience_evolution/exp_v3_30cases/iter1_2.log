'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Connect to database
conn = sqlite3.connect('dacomp-092.sqlite')

# Load profitability data
profitability_df = pd.read_sql_query("SELECT * FROM quickbooks__profitability_analysis", conn)

# Identify high-volatility customers (top 25%)
volatility_threshold = profitability_df['customer_margin_volatility'].quantile(0.75)
high_vol_customers = profitability_df[profitability_df['customer_margin_volatility'] >= volatility_threshold]
low_vol_customers = profitability_df[profitability_df['customer_margin_volatility'] < volatility_threshold]

# Calculate stability metrics
# For each group, compute coefficient of variation (CV) of profit metrics
# Since we don't have time-series for each customer in one row, we'll use existing metrics
# Calculate CV using available profit-related columns
profit_cols = ['customer_gross_margin_pct', 'customer_total_profit', 'customer_avg_profit_per_invoice']

cv_data = []
for col in profit_cols:
    cv_high = high_vol_customers[col].std() / high_vol_customers[col].mean() if high_vol_customers[col].mean() != 0 else np.nan
    cv_low = low_vol_customers[col].std() / low_vol_customers[col].mean() if low_vol_customers[col].mean() != 0 else np.nan
    cv_data.append({'Metric': col.replace('_', ' ').title(), 
                    'High Volatility CV': cv_high, 
                    'Low Volatility CV': cv_low})

cv_df = pd.DataFrame(cv_data)

# Plot 1: Coefficient of Variation comparison
fig, ax = plt.subplots(figsize=(10, 6))
x = np.arange(len(cv_df))
width = 0.35

bars1 = ax.bar(x - width/2, cv_df['High Volatility CV'], width, label='High Volatility', color='red', alpha=0.7)
bars2 = ax.bar(x + width/2, cv_df['Low Volatility CV'], width, label='Low Volatility', color='green', alpha=0.7)

ax.set_xlabel('Profitability Metric')
ax.set_ylabel('Coefficient of Variation (Std/Mean)')
ax.set_title('Profit Stability: Coefficient of Variation Comparison')
ax.set_xticks(x)
ax.set_xticklabels(cv_df['Metric'], rotation=45, ha='right')
ax.legend()
ax.grid(True, alpha=0.3, axis='y')

# Add value labels on bars
def add_labels(bars):
    for bar in bars:
        height = bar.get_height()
        if not np.isnan(height):
            ax.text(bar.get_x() + bar.get_width()/2., height + 0.01,
                   f'{height:.3f}', ha='center', va='bottom', fontsize=8)

add_labels(bars1)
add_labels(bars2)

plt.tight_layout()
plt.savefig('plots/profit_stability_cv_comparison.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 2: Quarter-over-quarter growth analysis
# First, check if quarter-over-quarter data exists
# Group by revenue_quarter and calculate average metrics
if 'revenue_quarter' in profitability_df.columns:
    quarterly_data = profitability_df.groupby('revenue_quarter').agg({
        'invoice_total': 'mean',
        'gross_profit': 'mean',
        'customer_total_revenue': 'mean'
    }).reset_index()
    
    # Calculate quarter-over-quarter growth rates
    quarterly_data['invoice_qoq_growth'] = quarterly_data['invoice_total'].pct_change() * 100
    quarterly_data['profit_qoq_growth'] = quarterly_data['gross_profit'].pct_change() * 100
    
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10))
    
    # Plot QoQ growth rates
    quarters = quarterly_data['revenue_quarter'].unique()
    x_pos = np.arange(len(quarters))
    
    ax1.bar(x_pos - 0.2, quarterly_data['invoice_qoq_growth'], width=0.4, label='Invoice Total QoQ %', color='blue', alpha=0.7)
    ax1.bar(x_pos + 0.2, quarterly_data['profit_qoq_growth'], width=0.4, label='Gross Profit QoQ %', color='orange', alpha=0.7)
    ax1.set_xlabel('Revenue Quarter')
    ax1.set_ylabel('Quarter-over-Quarter Growth (%)')
    ax1.set_title('Quarterly Growth Rate Analysis')
    ax1.set_xticks(x_pos)
    ax1.set_xticklabels([f'Q{q}' for q in quarters])
    ax1.legend()
    ax1.grid(True, alpha=0.3, axis='y')
    
    # Add growth rate values
    for i, (inv, prof) in enumerate(zip(quarterly_data['invoice_qoq_growth'], quarterly_data['profit_qoq_growth'])):
        if not np.isnan(inv):
            ax1.text(i - 0.2, inv + (0.1 if inv >= 0 else -0.5), f'{inv:.1f}%', ha='center', va='bottom' if inv >= 0 else 'top', fontsize=8)
        if not np.isnan(prof):
            ax1.text(i + 0.2, prof + (0.1 if prof >= 0 else -0.5), f'{prof:.1f}%', ha='center', va='bottom' if prof >= 0 else 'top', fontsize=8)
    
    # Plot variances separately for high vs low volatility groups
    if len(high_vol_customers) > 1 and len(low_vol_customers) > 1:
        # Calculate variance of profit growth (simplified - using available metric variations)
        var_high = high_vol_customers['customer_gross_margin_pct'].var()
        var_low = low_vol_customers['customer_gross_margin_pct'].var()
        
        growth_vars = [var_high, var_low]
        labels = ['High Volatility', 'Low Volatility']
        colors = ['red', 'green']
        
        ax2.bar(range(2), growth_vars, color=colors, alpha=0.7, edgecolor='black')
        ax2.set_xlabel('Customer Group')
        ax2.set_ylabel('Variance of Gross Margin %')
        ax2.set_title('Profit Metric Variance Comparison')
        ax2.set_xticks(range(2))
        ax2.set_xticklabels(labels)
        ax2.grid(True, alpha=0.3, axis='y')
        
        # Add variance values
        for i, v in enumerate(growth_vars):
            ax2.text(i, v + (max(growth_vars) * 0.02), f'{v:.4f}', ha='center', va='bottom', fontsize=10)
    else:
        ax2.text(0.5, 0.5, 'Insufficient data for variance comparison', 
                ha='center', va='center', transform=ax2.transAxes)
    
    plt.tight_layout()
    plt.savefig('plots/quarterly_growth_analysis.png', dpi=300, bbox_inches='tight')
    plt.close()

print("Additional plots generated!")
''')
