import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')
sns.set_style("whitegrid")

conn = sqlite3.connect('dacomp-070.sqlite')
package = 'com.studio.videostreaming'

# region decay
df_country = pd.read_sql_query(f"""
    SELECT date_day, region, store_listing_conversion_rate 
    FROM google_play__country_report 
    WHERE package_name = '{package}'
    ORDER BY date_day, region
""", conn, parse_dates=['date_day'])

# device decay
df_device = pd.read_sql_query(f"""
    SELECT date_day, device, device_installs 
    FROM google_play__device_report 
    WHERE package_name = '{package}'
    ORDER BY date_day, device
""", conn, parse_dates=['date_day'])
conn.close()

# Plot region conversion rate decay
plt.figure(figsize=(12,6))
regions = df_country['region'].unique()
for region in regions:
    subset = df_country[df_country['region']==region]
    # No need to group; each region has single row per date
    plt.plot(subset['date_day'], subset['store_listing_conversion_rate'], label=region, linewidth=2)
plt.xlabel('Date')
plt.ylabel('Store Listing Conversion Rate')
plt.title('Conversion Rate Decay by Region (6‑Month Trend)')
plt.legend(title='Region', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('plot5_region_decay.png', dpi=300, bbox_inches='tight')
plt.close()
print("Plot 5 saved.")

# Plot device installs decay
plt.figure(figsize=(12,6))
devices = df_device['device'].unique()
for device in devices:
    subset = df_device[df_device['device']==device]
    plt.plot(subset['date_day'], subset['device_installs'], label=device, linewidth=2)
plt.xlabel('Date')
plt.ylabel('Device Installs (Daily)')
plt.title('Install Decay by Device Type (6‑Month Trend)')
plt.legend(title='Device', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('plot6_device_decay.png', dpi=300, bbox_inches='tight')
plt.close()
print("Plot 6 saved.")
''')
