import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from datetime import datetime

# Connect to database
conn = sqlite3.connect('dacomp-019.sqlite')

# Load tables
drug_info = pd.read_sql_query("SELECT * FROM basic_drug_information", conn)
inventory = pd.read_sql_query("SELECT * FROM inventory_management", conn)

# Merge on Drug ID
df = pd.merge(inventory, drug_info, on='Drug ID', how='inner')

print(f"Total merged records: {len(df)}")

# Convert date columns to datetime
df['Last Inbound Date'] = pd.to_datetime(df['Last Inbound Date'])
df['Last Outbound Date'] = pd.to_datetime(df['Last Outbound Date'])

# Current date for recency calculations (assuming today as max date in dataset)
current_date = df['Last Inbound Date'].max()  # or use datetime.now, but using max for consistency

# Calculate days since last inbound
df['Days Since Last Inbound'] = (current_date - df['Last Inbound Date']).dt.days

# Clean numeric columns: remove % from Inventory Discrepancy Rate and convert to float
def clean_percentage(val):
    if isinstance(val, str):
        return float(val.replace('%', '')) / 100.0
    elif isinstance(val, (int, float)):
        return float(val) / 100.0 if val > 1 else float(val)
    else:
        return np.nan

df['Inventory Discrepancy Rate'] = df['Inventory Discrepancy Rate'].apply(clean_percentage)

# Ensure other quantity columns are numeric (they appear to be ints)
quantity_cols = ['Near-expiry Quantity', 'Quarantine Quantity', 'Expired Quantity',
                 'Damaged Quantity', 'Pest/Mold Damage Quantity', 
                 'Rodent Contamination Quantity', 'Air Contamination Quantity',
                 'Temp/Humidity Excursion Record', 'Returned Quantity', 
                 'Qualified Quantity', 'Near-expiry Quantity.1']
for col in quantity_cols:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors='coerce')

# Compute metrics per drug ID (aggregating across warehouses maybe)
# Since a drug can be in multiple warehouses, we sum quantities
agg_dict = {
    'Near-expiry Quantity': 'sum',
    'Quarantine Quantity': 'sum',
    'Expired Quantity': 'sum',
    'Damaged Quantity': 'sum',
    'Pest/Mold Damage Quantity': 'sum',
    'Rodent Contamination Quantity': 'sum',
    'Air Contamination Quantity': 'sum',
    'Temp/Humidity Excursion Record': 'sum',
    'Returned Quantity': 'sum',
    'Qualified Quantity': 'sum',
    'Inventory Discrepancy Rate': 'mean',  # average discrepancy rate
    'Days Since Last Inbound': 'max',  # longest time since inbound
    'Origin / Tier (Domestic/Imported/JV)': 'first'  # keep origin
}
# For categorical columns, we can create counts
# Create indicator columns for alert and non-normal status
df['Alert_Status'] = df['Inventory Alert Status'].apply(lambda x: 1 if x == 'Alert' else 0)
df['Severe_Status'] = df['Inventory Alert Status'].apply(lambda x: 1 if x == 'Severe' else 0)
df['NonNormal_Status'] = df['Inventory Status (Normal/Frozen/Scrapped)'].apply(lambda x: 1 if x != 'Normal' else 0)

agg_dict.update({
    'Alert_Status': 'sum',
    'Severe_Status': 'sum',
    'NonNormal_Status': 'sum'
})

grouped = df.groupby('Drug ID').agg(agg_dict).reset_index()

# Calculate composite scores for three perspectives (higher score = higher risk)
# Normalize each metric to 0-1 scale per origin group? or overall.
def normalize(series):
    if series.max() == series.min():
        return pd.Series([0.5] * len(series), index=series.index)
    return (series - series.min()) / (series.max() - series.min())

# Inventory backlog score: based on Near-expiry, Expired, Quarantine, Returned
grouped['backlog_score'] = (normalize(grouped['Near-expiry Quantity']) +
                            normalize(grouped['Expired Quantity']) +
                            normalize(grouped['Quarantine Quantity']) +
                            normalize(grouped['Returned Quantity'])) / 4.0

# Supply interruption score: based on Days Since Last Inbound, Alert count, Severe count, Non-normal status count
grouped['interruption_score'] = (normalize(grouped['Days Since Last Inbound']) +
                                 normalize(grouped['Alert_Status']) +
                                 normalize(grouped['Severe_Status']) +
                                 normalize(grouped['NonNormal_Status'])) / 4.0

# Quality risk score: based on Damaged, Pest/Mold, Rodent, Air contamination, Temp/Humidity excursions
grouped['quality_score'] = (normalize(grouped['Damaged Quantity']) +
                            normalize(grouped['Pest/Mold Damage Quantity']) +
                            normalize(grouped['Rodent Contamination Quantity']) +
                            normalize(grouped['Air Contamination Quantity']) +
                            normalize(grouped['Temp/Humidity Excursion Record'])) / 5.0

# Overall risk score (weighted average)
weights = {'backlog': 0.4, 'interruption': 0.3, 'quality': 0.3}
grouped['overall_score'] = (weights['backlog'] * grouped['backlog_score'] +
                            weights['interruption'] * grouped['interruption_score'] +
                            weights['quality'] * grouped['quality_score'])

# Add origin column (already there as 'Origin / Tier (Domestic/Imported/JV)')
# For readability rename
grouped.rename(columns={'Origin / Tier (Domestic/Imported/JV)': 'Origin'}, inplace=True)

# Filter to only imported and JV
imported_jv = grouped[grouped['Origin'].isin(['Imported', 'Joint-venture'])]

# Sort by overall_score descending
imported_jv_sorted = imported_jv.sort_values('overall_score', ascending=False)

print(f"Top 10 imported/JV drugs by overall risk:")
print(imported_jv_sorted[['Drug ID', 'Origin', 'overall_score', 'backlog_score', 'interruption_score', 'quality_score']].head(10))

# Save to CSV for reference
imported_jv_sorted.to_csv('imported_jv_risk_scores.csv', index=False)

# Now create visualizations

# 1. Bar plot of overall risk scores for top 20 imported/JV drugs
plt.figure(figsize=(12, 6))
top_n = 20
top_df = imported_jv_sorted.head(top_n)
x = range(len(top_df))
plt.bar(x, top_df['overall_score'], color='steelblue', edgecolor='black')
plt.xticks(x, top_df['Drug ID'], rotation=90)
plt.xlabel('Drug ID')
plt.ylabel('Overall Risk Score')
plt.title('Top 20 Imported & JV Drugs by Overall Risk Score')
plt.tight_layout()
plt.savefig('overall_risk_top20.png', dpi=300)
plt.close()

# 2. Stacked bar of three risk components for top 10
plt.figure(figsize=(10, 6))
top10 = imported_jv_sorted.head(10)
x = range(len(top10))
width = 0.5
plt.bar(x, top10['backlog_score'], width, label='Backlog', color='lightcoral')
plt.bar(x, top10['interruption_score'], width, bottom=top10['backlog_score'], label='Interruption', color='gold')
plt.bar(x, top10['quality_score'], width, bottom=top10['backlog_score'] + top10['interruption_score'], label='Quality', color='lightgreen')
plt.xticks(x, top10['Drug ID'], rotation=90)
plt.ylabel('Risk Score')
plt.title('Risk Component Breakdown for Top 10 Imported/JV Drugs')
plt.legend()
plt.tight_layout()
plt.savefig('risk_components_top10.png', dpi=300)
plt.close()

# 3. Comparison of average risk scores by origin (Imported vs JV vs Domestic)
avg_by_origin = grouped.groupby('Origin')[['backlog_score', 'interruption_score', 'quality_score', 'overall_score']].mean().reset_index()
# Reorder for plotting
avg_by_origin = avg_by_origin.sort_values('overall_score', ascending=False)
plt.figure(figsize=(8,5))
x = range(len(avg_by_origin))
plt.bar(x, avg_by_origin['overall_score'], color=['firebrick', 'darkorange', 'darkgreen'][:len(avg_by_origin)])
plt.xticks(x, avg_by_origin['Origin'])
plt.ylabel('Average Overall Risk Score')
plt.title('Average Overall Risk Score by Drug Origin')
plt.tight_layout()
plt.savefig('avg_risk_by_origin.png', dpi=300)
plt.close()

# 4. Scatter plot of backlog vs interruption scores colored by origin
plt.figure(figsize=(8,6))
colors = {'Domestic': 'blue', 'Imported': 'red', 'Joint-venture': 'orange'}
for origin, group in grouped.groupby('Origin'):
    plt.scatter(group['backlog_score'], group['interruption_score'], 
                label=origin, alpha=0.6, s=50, c=colors.get(origin, 'gray'))
plt.xlabel('Backlog Risk Score')
plt.ylabel('Supply Interruption Risk Score')
plt.title('Backlog vs Interruption Risk by Origin')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('scatter_backlog_interruption.png', dpi=300)
plt.close()

# 5. Heatmap of risk components correlation matrix for imported/JV drugs
imported_jv_corr = imported_jv[['backlog_score', 'interruption_score', 'quality_score']].corr()
plt.figure(figsize=(6,5))
sns.heatmap(imported_jv_corr, annot=True, cmap='coolwarm', center=0, square=True)
plt.title('Correlation of Risk Components (Imported & JV Drugs)')
plt.tight_layout()
plt.savefig('correlation_heatmap.png', dpi=300)
plt.close()

print("Visualizations saved.")
```
