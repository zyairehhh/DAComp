'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Group by Project Type
type_stats = df.groupby('Project Type')['Deviation'].agg(['mean', 'std', 'count']).reset_index()
