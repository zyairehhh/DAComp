'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('./dacomp-058.sqlite')
df_device = pd.read_sql_query("SELECT * FROM google_ads__device_report", conn)
df_campaign = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)

# Merge with campaign information? We can compute health scores per device group.
# For simplicity, we can compute average health metrics per device_type.
df_device['roi'] = df_device['conversion_value'] / df_device['cost']
# Normalize within device?
# We'll compute a simple health metric as weighted average of normalized metrics.

# Normalize each component across the device report data
imp_min = df_device['impression_share'].min()
imp_max = df_device['impression_share'].max()
qual_min = df_device['quality_score'].min()
qual_max = df_device['quality_score'].max()
ctr_min = df_device['ctr'].min()
ctr_max = df_device['ctr'].max()
roi_min = df_device['roi'].min()
roi_max = df_device['roi'].max()
conv_min = df_device['conversion_rate'].min()
conv_max = df_device['conversion_rate'].max()

df_device['imp_norm'] = (df_device['impression_share'] - imp_min) / (imp_max - imp_min) * 100
df_device['qual_norm'] = (df_device['quality_score'] - qual_min) / (qual_max - qual_min) * 100
df_device['ctr_norm'] = (df_device['ctr'] - ctr_min) / (ctr_max - ctr_min) * 100
df_device['roi_norm'] = (df_device['roi'] - roi_min) / (roi_max - roi_min) * 100
df_device['conv_norm'] = (df_device['conversion_rate'] - conv_min) / (conv_max - conv_min) * 100

# Health score: weightings as before
df_device['health_score'] = df_device['roi_norm']*0.4 + df_device['conv_norm']*0.35 + (df_device['imp_norm']*0.4 + df_device['qual_norm']*0.4 + df_device['ctr_norm']*0.2)*0.25

# Aggregate by device_type
device_scores = df_device.groupby('device_type').agg({'health_score':'mean', 'cost':'sum', 'roi':'mean'}).reset_index()
device_scores = device_scores.sort_values('health_score', ascending=False)

plt.figure(figsize=(8,5))
plt.bar(device_scores['device_type'], device_scores['health_score'], color='purple')
plt.xlabel('Device Type')
plt.ylabel('Average Health Score')
plt.title('Average Health Score by Device Type')
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig('./health_by_device.png', dpi=300)
plt.close()

# Also plot cost vs health score bubble
plt.figure(figsize=(10,6))
plt.scatter(device_scores['roi'], device_scores['health_score'], s=device_scores['cost']/5000, alpha=0.7, c='blue')
for i, row in device_scores.iterrows():
    plt.annotate(row['device_type'], (row['roi'], row['health_score']), fontsize=9)
plt.xlabel('Average ROI')
plt.ylabel('Average Health Score')
plt.title('Device Type: ROI vs Health Score (Bubble size = total cost)')
plt.grid(True)
plt.tight_layout()
plt.savefig('./device_roi_vs_health.png', dpi=300)
plt.close()

conn.close()
print('Device plots saved.')
''')

