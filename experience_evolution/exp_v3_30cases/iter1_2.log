import pandas as pd

funnel = pd.read_csv('contact_funnel.csv')
print(funnel.columns)
# convert timestamps
for col in ['first_response_time', 'demo_booked', 'trial_activated', 'closed_won']:
    if col in funnel.columns:
        funnel[col] = pd.to_datetime(funnel[col])
        print(col, funnel[col].notna().sum())

# Compute durations
funnel['resp_to_demo'] = (funnel['demo_booked'] - funnel['first_response_time']).dt.total_seconds() / (3600*24)
funnel['demo_to_trial'] = (funnel['trial_activated'] - funnel['demo_booked']).dt.total_seconds() / (3600*24)
funnel['trial_to_paid'] = (funnel['closed_won'] - funnel['trial_activated']).dt.total_seconds() / (3600*24)

# Show negative durations
neg = funnel[funnel['demo_to_trial'] < 0]
print(f"Negative demo_to_trial count: {len(neg)}")
if len(neg) > 0:
    print(neg[['contact_id', 'responder_type', 'demo_booked', 'trial_activated', 'demo_to_trial']].head())
    # Also check stage tags ordering
    # Maybe trial_activated tag assigned earlier but demo booked later? Might be data error.
    
# Show stats by responder_type
for rt in funnel['responder_type'].dropna().unique():
    sub = funnel[funnel['responder_type'] == rt]
    print(f"\nResponder: {rt}")
    print(f"Count: {len(sub)}")
    print(f"avg resp_to_demo: {sub['resp_to_demo'].mean(skipna=True):.2f}")
    print(f"avg demo_to_trial: {sub['demo_to_trial'].mean(skipna=True):.2f}")
    print(f"avg trial_to_paid: {sub['trial_to_paid'].mean(skipna=True):.2f}")
    print(f"negative demo_to_trial proportion: {(sub['demo_to_trial'] < 0).sum() / sub['demo_to_trial'].notna().sum():.2%}")

