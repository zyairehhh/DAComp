import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-001.sqlite')
# Load data
company = pd.read_sql_query('SELECT "Enterprise Code", "Credit Rating", "Defaulted" FROM ch___company_info', conn)
sales = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax", "Buyer organization code" FROM ch___sales_invoices', conn)
inputs = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax", "Seller Organization Code" FROM ch___input_invoices', conn)
churn = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)

sales['Invoice Date'] = pd.to_datetime(sales['Invoice Date'])
inputs['Invoice Date'] = pd.to_datetime(inputs['Invoice Date'])

# Compute total sales and profit per company
total_sales = sales.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_sales')
total_input = inputs.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_input')
profit = total_sales - total_input

# Revenue capacity: total_sales
# Profit stability: compute coefficient of variation of annual profit
sales['year'] = sales['Invoice Date'].dt.year
inputs['year'] = inputs['Invoice Date'].dt.year
annual_sales = sales.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().rename('annual_sales')
annual_input = inputs.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().rename('annual_input')
annual = pd.concat([annual_sales, annual_input], axis=1).fillna(0)
annual['annual_profit'] = annual['annual_sales'] - annual['annual_input']

def cv(x):
    if len(x) > 1 and x.mean() != 0:
        return x.std() / x.mean()
    else:
        return np.nan

profit_cv = annual.groupby('Enterprise Code')['annual_profit'].apply(cv).rename('profit_cv')
profit_mean = annual.groupby('Enterprise Code')['annual_profit'].mean().rename('profit_mean')
profit_std = annual.groupby('Enterprise Code')['annual_profit'].std().rename('profit_std')

# Dependency: HHI for buyers and sellers
def hhi(group):
    total = group.sum()
    if total == 0:
        return np.nan
    share = group / total
    return (share ** 2).sum() * 10000

buyer_hhi = sales.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('buyer_hhi')
seller_hhi = inputs.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('seller_hhi')
num_buyers = sales.groupby('Enterprise Code')['Buyer organization code'].nunique().rename('num_buyers')
num_sellers = inputs.groupby('Enterprise Code')['Seller Organization Code'].nunique().rename('num_sellers')

# Combine all features
