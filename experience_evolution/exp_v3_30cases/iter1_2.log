growth = growth.dropna()
merged = merged.merge(growth, on='visitor_id', how='left')
corr_growth = merged[['high_value', 'growth_factor']].corr().iloc[0,1]
print(f"Correlation between high_value and growth factor (last/first): {corr_growth:.4f}")

conn.close()
''')
