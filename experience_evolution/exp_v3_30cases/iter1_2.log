'''
import sqlite3
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-022.sqlite')

# Define rating bins
bins = [3.0, 3.5, 4.0, 4.5, 5.0]
labels = ['3.0-3.5', '3.5-4.0', '4.0-4.5', '4.5-5.0']

# Query with binning
query = '''
SELECT "Driver Ratings" as rating,
       "Booking Value",
       "Ride Distance"
FROM sheet1
WHERE "Driver Ratings" IS NOT NULL
'''

df = pd.read_sql_query(query, conn)
conn.close()

# Bin the ratings
df['rating_bin'] = pd.cut(df['rating'], bins=bins, labels=labels, right=False, include_lowest=True)

# Group by bin
grouped = df.groupby('rating_bin').agg(
    total_revenue=('Booking Value', 'sum'),
    total_distance=('Ride Distance', 'sum'),
    trip_count=('rating', 'count')
).reset_index()
grouped['fare_per_km'] = grouped['total_revenue'] / grouped['total_distance']

print(grouped)

# Plot
plt.figure(figsize=(8,6))
bars = plt.bar(grouped['rating_bin'], grouped['fare_per_km'], color='seagreen')
plt.title('Fare per Kilometer by Driver Rating Bin', fontsize=14, fontweight='bold')
plt.xlabel('Driver Rating Bin', fontsize=12)
plt.ylabel('Fare per Kilometer (currency/km)', fontsize=12)
plt.grid(axis='y', linestyle='--', alpha=0.7)

# Annotate values
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.2f}', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('rating_fare_per_km.png', dpi=300)
print('Plot saved as rating_fare_per_km.png')
''')
