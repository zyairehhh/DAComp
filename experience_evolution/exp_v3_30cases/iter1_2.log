import pandas as pd
import sqlite3
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-094.sqlite')

# Query combined data
query = """
WITH combined AS (
  SELECT 
    f.last_touch_campaign_id AS campaign_id,
    f.person_id,
    f.first_event_at AS send_time,
    f.count_received_email,
    f.count_opened_email,
    f.count_clicked_email,
    CAST(f.count_opened_email AS FLOAT) / NULLIF(f.count_received_email, 0) AS open_rate,
    CAST(f.count_clicked_email AS FLOAT) / NULLIF(f.count_received_email, 0) AS click_rate,
    e.campaign_subject_line AS subject_line,
    p.active_retention_rate_week,
    p.active_retention_rate_month
  FROM klaviyo__person_campaign_flow f
  LEFT JOIN (
    SELECT last_touch_campaign_id, MAX(campaign_subject_line) AS campaign_subject_line
    FROM klaviyo__events
    GROUP BY last_touch_campaign_id
  ) e ON f.last_touch_campaign_id = e.last_touch_campaign_id
  LEFT JOIN klaviyo__persons p ON f.person_id = p.person_id
)
SELECT 
  *,
  CASE 
    WHEN subject_line LIKE '%Product Launch%' THEN 'new product launch'
    WHEN subject_line LIKE '%Seasonal%' THEN 'discount-related'
    ELSE 'other'
  END AS theme,
  CAST(strftime('%w', send_time) AS INTEGER) AS day_of_week,
  CASE 
    WHEN CAST(strftime('%w', send_time) AS INTEGER) IN (0, 6) THEN 'weekend'
    ELSE 'weekday'
  END AS weekday_weekend,
  CAST(strftime('%H', send_time) AS INTEGER) AS hour_of_day,
  CASE 
    WHEN CAST(strftime('%H', send_time) AS INTEGER) < 12 THEN 'morning'
    ELSE 'afternoon'
  END AS morning_afternoon
FROM combined
"""
df = pd.read_sql_query(query, conn)
conn.close()

print("Combined data:")
print(df)
print("\n--- Theme Aggregates ---")
theme_agg = df.groupby('theme').agg(
    campaign_count=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
print(theme_agg)

print("\n--- Weekday vs Weekend ---")
weekday_agg = df.groupby('weekday_weekend').agg(
    campaign_count=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
print(weekday_agg)

print("\n--- Morning vs Afternoon ---")
time_agg = df.groupby('morning_afternoon').agg(
    campaign_count=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
print(time_agg)

print("\n--- Combined Theme + Weekday/Weekend ---")
combined_agg = df.groupby(['theme', 'weekday_weekend']).agg(
    campaign_count=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
print(combined_agg)

print("\n--- Combined Theme + Morning/Afternoon ---")
combined_agg2 = df.groupby(['theme', 'morning_afternoon']).agg(
    campaign_count=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
print(combined_agg2)

# Save to CSV for reference
df.to_csv('combined_analysis.csv', index=False)
theme_agg.to_csv('theme_aggregates.csv', index=False)
weekday_agg.to_csv('weekday_aggregates.csv', index=False)
time_agg.to_csv('time_aggregates.csv', index=False)
combined_agg.to_csv('theme_weekday_aggregates.csv', index=False)
combined_agg2.to_csv('theme_time_aggregates.csv', index=False)
print("\nData exported to CSV files.")
```
