problem_ids = high_risk_ids

# For each group, get profitability_tier distribution from profitability_analysis (all rows)
def get_tier_counts(customer_ids, label):
    if not customer_ids:
        return {}
    placeholders = ','.join(['?'] * len(customer_ids))
    tier_sql = f"""
    SELECT profitability_tier, COUNT(*) as cnt
    FROM quickbooks__profitability_analysis
    WHERE customer_id IN ({placeholders})
    GROUP BY profitability_tier
    """
    df = pd.read_sql_query(tier_sql, conn, params=customer_ids)
    total = df['cnt'].sum()
    df['percentage'] = df['cnt'] / total * 100
    print(f"\nProfitability Tier Distribution ({label}):")
    for _, row in df.iterrows():
        print(f"  {row['profitability_tier']}: {row['cnt']} ({row['percentage']:.1f}%)")
    return dict(zip(df['profitability_tier'], df['cnt']))

