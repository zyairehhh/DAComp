'''
import sqlite3
conn = sqlite3.connect('dacomp-069.sqlite')
c = conn.cursor()
c.execute("SELECT country, revenue_last_30_days, avg_active_devices, average_revenue_per_user FROM google_play__geo_market_analysis WHERE package_name='com.dev.photoeditor'")
rows = c.fetchall()
for r in rows:
    country = r[0]
    rev = r[1]
    devices = r[2]
    arpu = r[3]
    per_device = rev / devices if devices != 0 else 0
    print(f'Country {country}: revenue per active device (30d): ${per_device:.2f}, ARPU: ${arpu}')
conn.close()
''')
