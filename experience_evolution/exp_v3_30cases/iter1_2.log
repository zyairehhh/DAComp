```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-061.sqlite')

# Load project enhanced
project_df = pd.read_sql_query("SELECT project_id, project_name, avg_close_time_days, count_closed_issues, count_open_issues FROM jira__project_enhanced", conn)
print(f"Projects: {project_df.shape[0]}")

# Load team performance and aggregate per project_name
team_df = pd.read_sql_query("SELECT project_name, consistency_percentage, at_churn_risk, inactive_recently, poor_estimation, bug_issues, total_assigned_issues FROM jira__team_performance_dashboard", conn)
print(f"Team rows: {team_df.shape[0]}")

# Compute per-project team metrics
team_agg = team_df.groupby('project_name').agg(
    avg_consistency=('consistency_percentage', 'mean'),
    churn_risk_ratio=('at_churn_risk', 'mean'),  # proportion of users flagged as at_churn_risk
    inactive_ratio=('inactive_recently', 'mean'),
    poor_estimation_ratio=('poor_estimation', 'mean'),
    total_bug_issues=('bug_issues', 'sum'),
    total_assigned_issues=('total_assigned_issues', 'sum')
).reset_index()
team_agg['bug_rate'] = team_agg['total_bug_issues'] / team_agg['total_assigned_issues']
print(f"Unique projects in team data: {team_agg.shape[0]}")

# Load issue intelligence and aggregate per project_name
issue_df = pd.read_sql_query("SELECT project_name, issue_type, regression_ratio, lifecycle_quality_score FROM jira__issue_intelligence_analytics", conn)
print(f"Issue rows: {issue_df.shape[0]}")

# Compute per-project issue metrics
issue_agg = issue_df.groupby('project_name').agg(
    total_issues=('issue_type', 'count'),
    bug_count=('issue_type', lambda x: (x == 'Bug').sum()),
    avg_regression_ratio=('regression_ratio', 'mean'),
    avg_lifecycle_quality=('lifecycle_quality_score', 'mean')
).reset_index()
issue_agg['bug_rate_issues'] = issue_agg['bug_count'] / issue_agg['total_issues']
print(f"Unique projects in issue data: {issue_agg.shape[0]}")

# Merge all three datasets on project_name
merged = project_df.merge(team_agg, on='project_name', how='left')
merged = merged.merge(issue_agg, on='project_name', how='left')
print(f"Merged rows: {merged.shape[0]}")
print(merged.head())

# Save merged for reference
merged.to_csv('project_metrics.csv', index=False)
print("Saved project_metrics.csv")

conn.close()
```
