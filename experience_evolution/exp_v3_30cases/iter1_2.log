import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

# Connect to the database
conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome", conn)
conn.close()

# Function to extract numeric value from price strings
def extract_numeric(value_str):
    if pd.isna(value_str):
        return np.nan
    # Remove commas and "yuan"
    value_str = str(value_str).replace(',', '').replace('yuan', '').strip()
    # Extract all numbers (including decimals)
    numbers = re.findall(r'\d+\.?\d*', value_str)
    if numbers:
        return float(numbers[0])
    return np.nan

# Test with first row
print("Testing price parsing:")
print(f"Title: {df.loc[0, 'Title']}")
print(f"Price raw: {df.loc[0, 'Price']}")
print(f"New Car Price raw: {df.loc[0, 'New Car Price (incl. tax)']}")

# Clean prices
df['Price_Cleaned'] = df['Price']  # Price seems to already be numeric
df['New_Car_Price_Cleaned'] = df['New Car Price (incl. tax)'].apply(extract_numeric)
print(f"\nExtracted New Car Price for first row: {df.loc[0, 'New_Car_Price_Cleaned']}")

# Convert Price from ten thousand yuan to yuan? Let's check ratio
df['Price_in_yuan'] = df['Price_Cleaned'] * 10000  # Assume ten thousand yuan
print(f"\nIf Price is in ten thousand yuan, then Price in yuan: {df.loc[0, 'Price_in_yuan']}")
print(f"Ratio (New Car Price / Price in yuan): {df.loc[0, 'New_Car_Price_Cleaned'] / df.loc[0, 'Price_in_yuan']:.2f}")

# Check multiple rows
for i in range(5):
    price_yuan = df.loc[i, 'Price_Cleaned'] * 10000
    new_price = df.loc[i, 'New_Car_Price_Cleaned']
    if new_price > 0:
        ratio = new_price / price_yuan
        print(f"Row {i}: Price={df.loc[i, 'Price_Cleaned']}, New Price={new_price:.0f}, Ratio={ratio:.2f}")

# Actually, looking at sample: Audi A6L has Price 34.98, New Car Price 551,400
# 551,400 / 34.98 = 15,765, not 10,000
# So maybe Price is in some other unit, or there's data error
# Let's check if Price actually represents something else

print(f"\nChecking Price column type and values:")
print(f"Price dtype: {df['Price'].dtype}")
print(f"Price min: {df['Price'].min()}, max: {df['Price'].max()}, median: {df['Price'].median()}")

# Create visualization to understand relationship
plt.figure(figsize=(10, 6))
plt.scatter(df['Price_Cleaned'], df['New_Car_Price_Cleaned'], alpha=0.5)
plt.xlabel('Price (as stored)')
plt.ylabel('New Car Price (yuan)')
plt.title('Relationship between Used Price and New Car Price')
plt.grid(True, alpha=0.3)
plt.savefig('price_relationship.png', dpi=300, bbox_inches='tight')
print("\nSaved price_relationship.png")
''')
