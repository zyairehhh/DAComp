import pandas as pd
import numpy as np

owner_stats = pd.read_csv('owner_performance.csv')
print("Performance Level Counts:")
print(owner_stats['performance_level'].value_counts())
print("\nPerformance Level Proportions:")
print(owner_stats['performance_level'].value_counts(normalize=True).round(3))
print("\nPerformance by Primary Task Type:")
perf_by_type = pd.crosstab(owner_stats['primary_type'], owner_stats['performance_level'], margins=True)
print(perf_by_type)
print("\nCorrelation between Composite Score and Average Difficulty:")
corr = owner_stats['avg_difficulty'].corr(owner_stats['composite_score'])
print(f"{corr:.3f}")
print("\nAverage Difficulty by Performance Level:")
print(owner_stats.groupby('performance_level')['avg_difficulty'].mean().round(3))
print("\nComposite Score Stats:")
print(owner_stats['composite_score'].describe().round(3))
```
