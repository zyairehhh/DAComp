    device = pd.read_sql_query("SELECT device_type, SUM(cost) as total_cost, AVG(roas) as avg_roas FROM google_ads__device_report GROUP BY device_type ORDER BY total_cost DESC", conn)
    f.write('**Device Performance**:\n')
    for _, r in device.iterrows():
        f.write(f'- {r["device_type"]}: ${r["total_cost"]:,.0f}, ROAS {r["avg_roas"]:.2f}\n')
    f.write('\n')
    
    f.write('## 6. Trend Analysis – 18 Months (Feb 2023 – Jun 2024)\n')
    f.write('**Monthly Cost and ROAS Trends**:\n')
    f.write(f'- Total monthly spend grew from ${monthly["total_cost"].iloc[0]:,.0f} to ${monthly["total_cost"].iloc[-1]:,.0f}.\n')
    f.write(f'- Year‑over‑year growth rate (latest month vs same month last year): Cost {monthly["cost_yoy"].iloc[-1]:.1%}, ROAS {monthly["roas_yoy"].iloc[-1]:.1%}.\n')
    f.write(f'- Month‑over‑month growth volatility (std): Cost {monthly["cost_growth_mom"].std():.3f}, ROAS {monthly["roas_growth_mom"].std():.3f}\n')
    f.write('**Seasonal Patterns (average by month)**:\n')
    for _, r in seasonal.iterrows():
        f.write(f'- Month {r["month"]}: avg cost ${r["avg_cost"]:,.0f}, avg ROAS {r["avg_roas"]:.2f}, avg CTR {r["avg_ctr"]:.4f}\n')
    f.write('\n')
    
    f.write('## 7. High‑Risk Campaigns – Diagnosis & Recommendations\n')
    f.write('| Campaign ID | Campaign Name | Health Score | Risk Level | Weakest Dimension | Core Problem Diagnosis | Optimization Recommendations |\n')
    f.write('|------------|---------------|--------------|------------|-------------------|------------------------|------------------------------|\n')
    high_risk = df[df['risk_level']=='High'].sort_values('health_score')
    for _, row in high_risk.iterrows():
        diagnosis = []
        if row['avg_roas'] < 1.0:
            diagnosis.append('ROAS < 1')
        if row['avg_conversion_rate'] < df['avg_conversion_rate'].median():
            diagnosis.append('Low conversion rate')
        if row['avg_impression_share'] < 0.6:
            diagnosis.append(f'Impression share {row["avg_impression_share"]:.1%}')
        if row['avg_position'] > 3.0:
            diagnosis.append(f'Avg position {row["avg_position"]:.1f}')
        if row['geo_hhi'] > 0.5:
            diagnosis.append('High geo concentration')
        if row['device_hhi'] > 0.5:
            diagnosis.append('High device concentration')
        diag_text = '; '.join(diagnosis) if diagnosis else 'No major issues'
        # Recommendations
        rec = []
        if row['avg_roas'] < 1.0:
            rec.append('Reduce budget or pause')
        if row['avg_impression_share'] < 0.6:
            rec.append('Increase bids or improve targeting')
        if row['avg_conversion_rate'] < df['avg_conversion_rate'].median():
            rec.append('Optimize landing pages/ad copy')
        if row['avg_position'] > 3.0:
            rec.append('Improve ad rank via quality score')
        if row['geo_hhi'] > 0.5:
            rec.append('Expand geographic reach')
        if row['device_hhi'] > 0.5:
            rec.append('Adjust device bid adjustments')
        rec_text = '; '.join(rec) if rec else 'Maintain current performance'
        f.write(f'| {row["campaign_id"]} | {row["campaign_name"]} | {row["health_score"]:.1f} | {row["risk_level"]} | {row["weakest_dimension"]} | {diag_text} | {rec_text} |\n')
    f.write('\n')
    
    f.write('## 8. High‑Cost Low‑ROI Campaigns (Initial Screening)\n')
    high_cost = df[df['high_cost_low_roi_flag']==1]
    f.write('| Campaign ID | Campaign Name | Avg Monthly Cost | ROAS | Health Score | Risk Level |\n')
    f.write('|------------|---------------|------------------|------|--------------|------------|\n')
    for _, row in high_cost.iterrows():
        avg_monthly = row['total_cost'] / row['months_active']
        f.write(f'| {row["campaign_id"]} | {row["campaign_name"]} | ${avg_monthly:,.0f} | {row["avg_roas"]:.2f} | {row["health_score"]:.1f} | {row["risk_level"]} |\n')
    f.write('\n')
    
    f.write('## 9. Strategic Optimization Plan\n')
    f.write('### Immediate Actions (0‑1 month)\n')
    f.write('1. **Budget reallocation**: Shift spend from high‑cost low‑ROI campaigns to Shopping and Search campaigns.\n')
    f.write('2. **Bidding adjustments**: For Target CPA campaigns, test Target ROAS with conservative targets.\n')
    f.write('3. **Keyword optimization**: Pause low‑performing keywords in high‑risk campaigns; add negative match for irrelevant queries.\n')
    f.write('4. **Geographic adjustments**: Expand into Australia and Canada to diversify geographic risk.\n')
    f.write('### Short‑term Enhancements (1‑3 months)\n')
    f.write('1. **Ad creative testing**: A/B test ad copies for Display and Video campaigns to improve CTR.\n')
    f.write('2. **Landing page optimization**: Focus on Travel and Finance campaigns to increase conversion rate.\n')
    f.write('3. **Device bidding**: Increase mobile bids where conversion rate exceeds desktop; reduce tablet bids if underperforming.\n')
    f.write('### Long‑term Initiatives (3‑6 months)\n')
    f.write('1. **Campaign consolidation**: Merge fragmented campaigns to improve management efficiency.\n')
    f.write('2. **Seasonal planning**: Align budget increases with high‑ROAS months (July, November).\n')
    f.write('3. **Automated health monitoring**: Implement dashboard tracking health‑score components and alerts.\n')
    f.write('4. **Competitive analysis**: Regularly benchmark impression share, quality score, and position against industry averages.\n')
    f.write('\n')
    
    f.write('## 10. Conclusion\n')
    f.write('The health‑score model successfully identifies 12 high‑risk and 11 high‑cost low‑ROI campaigns. Shopping campaigns are the healthiest, while Display and Video need urgent attention. Finance and Travel industries require deeper market analysis. Recommendations focus on budget reallocation, bidding optimization, and geographic/device adjustments to improve overall ROI. Seasonal trends highlight opportunities for timing budget adjustments.\n')
    
    f.write('\n---\n')
    f.write('*Report generated by Campaign Health Assessment System. Data period: Feb 2023 – Jun 2024.*\n')

conn.close()
print("Report generated.")
