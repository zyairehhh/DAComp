'''
import sqlite3
import pandas as pd
import numpy as np

# Load and clean data
conn = sqlite3.connect('dacomp-013.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Data cleaning
df['Planned Work Hours'] = pd.to_numeric(df['Planned Work Hours'], errors='coerce')
df['Actual Work Hours'] = pd.to_numeric(df['Actual Work Hours'], errors='coerce')
df['Completion Quality Score'] = pd.to_numeric(df['Completion Quality Score'], errors='coerce')
df['Task Difficulty Coefficient'] = pd.to_numeric(df['Task Difficulty Coefficient'], errors='coerce')
df['Rework Count'] = pd.to_numeric(df['Rework Count'], errors='coerce')

date_cols = ['Planned Start Date', 'Planned Deadline', 'Actual Start Date', 'Actual Completion Time']
for col in date_cols:
    df[col] = pd.to_datetime(df[col], errors='coerce')

# Derived fields
df['Completed'] = (df['Task Status'] == 'Completed').astype(int)
df['OnTime'] = ((df['Actual Completion Time'] <= df['Planned Deadline']) & (df['Completed'] == 1)).astype(int)
# Efficiency: (Planned - Actual) / Planned, bound to [-1,1]
df['Planned Work Hours'] = df['Planned Work Hours'].replace(0, np.nan)
df['WorkHourRatio'] = (df['Planned Work Hours'] - df['Actual Work Hours']) / df['Planned Work Hours']
df['Efficiency'] = df['WorkHourRatio'].clip(-1, 1)

# Quality normalized to 0-1 (assuming max 10)
df['QualityNorm'] = df['Completion Quality Score'] / 10.0
df['QualityNorm'] = df['QualityNorm'].fillna(0.5)  # default to average

# Priority weight
priority_weight = {'Urgent': 4, 'High': 3, 'Medium': 2, 'Low': 1}
df['PriorityWeight'] = df['Priority'].map(priority_weight)

# Task difficulty adjustment: we can reward handling difficult tasks
# Use difficulty coefficient as multiplier (scale maybe 1-5)
df['DifficultyMultiplier'] = df['Task Difficulty Coefficient'] / df['Task Difficulty Coefficient'].mean()

# Now compute per-task score
# Weight for each dimension (customizable)
weights = {
    'Completion': 0.3,
    'Quality': 0.3,
    'Timeliness': 0.2,
    'Efficiency': 0.2
}
df['TaskScore'] = (
    weights['Completion'] * df['Completed'] +
    weights['Quality'] * df['QualityNorm'] +
    weights['Timeliness'] * df['OnTime'] +
    weights['Efficiency'] * (df['Efficiency'] + 1) / 2  # map efficiency from [-1,1] to [0,1]
)

# Adjust by priority weight (so high-priority tasks have higher contribution)
df['PriorityAdjustedScore'] = df['TaskScore'] * df['PriorityWeight']

# Adjust for difficulty (so harder tasks increase score)
df['FinalTaskScore'] = df['PriorityAdjustedScore'] * df['DifficultyMultiplier']

# Compute owner total score (sum of FinalTaskScore across tasks)
owner_scores = df.groupby('Task Owner')['FinalTaskScore'].sum().reset_index(name='TotalScore')
owner_scores['AvgScorePerTask'] = df.groupby('Task Owner')['FinalTaskScore'].mean().values
owner_scores['TaskCount'] = df.groupby('Task Owner').size().values

# Additional metrics for report
owner_metrics = df.groupby('Task Owner').agg({
    'Completed': 'sum',
    'OnTime': 'sum',
    'PriorityWeight': 'sum',
    'Task Difficulty Coefficient': 'mean',
}).reset_index()
owner_metrics.rename(columns={'Completed': 'TasksCompleted', 'OnTime': 'TasksOnTime', 'PriorityWeight': 'TotalPriorityWeight', 'Task Difficulty Coefficient': 'AvgDifficulty'}, inplace=True)

owner_scores = pd.merge(owner_scores, owner_metrics, on='Task Owner', how='left')

# Classification
n_owners = owner_scores.shape[0]
excellent_cutoff = int(n_owners * 0.2)
good_cutoff = int(n_owners * 0.9)  # top 20% excellent, next 70% good, bottom 10% needs improvement

owner_scores = owner_scores.sort_values('TotalScore', ascending=False).reset_index(drop=True)
owner_scores['PerformanceLevel'] = 'Needs Improvement'
owner_scores.loc[:excellent_cutoff-1, 'PerformanceLevel'] = 'Excellent'
owner_scores.loc[excellent_cutoff:good_cutoff-1, 'PerformanceLevel'] = 'Good'

# Validate distribution
dist = owner_scores['PerformanceLevel'].value_counts()
print("Performance level distribution:")
print(dist)
print(f"Total owners: {n_owners}")
print(f"Expected Excellent: {excellent_cutoff}, Good: {good_cutoff - excellent_cutoff}, Needs Improvement: {n_owners - good_cutoff}")
print("\\nTop 10 Excellent performers:")
print(owner_scores[owner_scores['PerformanceLevel'] == 'Excellent'].head(10)[['Task Owner', 'TotalScore', 'TaskCount', 'TasksCompleted', 'TasksOnTime', 'AvgDifficulty']])
print("\\nSome Good performers sample:")
print(owner_scores[owner_scores['PerformanceLevel'] == 'Good'].iloc[::30][['Task Owner', 'TotalScore', 'TaskCount', 'TasksCompleted', 'TasksOnTime', 'AvgDifficulty']])
print("\\nNeeds Improvement performers:")
print(owner_scores[owner_scores['PerformanceLevel'] == 'Needs Improvement'][['Task Owner', 'TotalScore', 'TaskCount', 'TasksCompleted', 'TasksOnTime', 'AvgDifficulty']].head(10))

# Save results to CSV for reference
owner_scores.to_csv('owner_performance_evaluation.csv', index=False)
print("\\nEvaluation saved to owner_performance_evaluation.csv")
''')
