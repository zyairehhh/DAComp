import pandas as pd
import numpy as np
df = pd.read_csv('category_year_margin.csv')
print("Data sample:")
print(df.head())
print("\nUnique categories:", df['Product Category'].nunique())
# Compute swing metrics
swing = df.groupby('Product Category')['profit_margin'].agg(['min','max','std', 'mean'])
swing['range'] = swing['max'] - swing['min']
swing = swing.sort_values('range', ascending=False)
print("\nTop categories by profit margin range:")
print(swing.head(15))
# Identify category with largest swing
largest_swing_category = swing.index[0]
largest_range = swing.iloc[0]['range']
print(f"\nCategory with largest swing: {largest_swing_category} (range = {largest_range:.4f})")
# Extract the data for that category
cat_data = df[df['Product Category'] == largest_swing_category]
print(f"\nProfit margins for {largest_swing_category} across years:")
print(cat_data)
```
