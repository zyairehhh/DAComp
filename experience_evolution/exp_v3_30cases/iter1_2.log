  MAX(CASE WHEN row_num = total * 0.25 THEN count_received_email END) AS q25,
  MAX(CASE WHEN row_num = total * 0.5 THEN count_received_email END) AS q50,
  MAX(CASE WHEN row_num = total * 0.75 THEN count_received_email END) AS q75,
  MAX(count_received_email) AS q100
FROM ordered;", output="direct")
