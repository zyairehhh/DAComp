import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-027/stage1_env/dacomp-027.sqlite')

disaster_events = pd.read_sql_query("SELECT * FROM disaster_events", conn)
environment_and_health = pd.read_sql_query("SELECT * FROM environment_and_health", conn)
beneficiaries_and_assessments = pd.read_sql_query("SELECT * FROM beneficiaries_and_assessments", conn)

df = pd.merge(disaster_events, environment_and_health, left_on='Disaster Event ID', right_on='Disaster Reference ID', how='inner')
df = pd.merge(df, beneficiaries_and_assessments, left_on='Disaster Event ID', right_on='Distribution reference ID', how='inner')

# Secondary hazard indicators
secondary_cols = [
    'Environmental Impact Rate',
    'Waste Management Status',
    'Disease Risk',
    'Medical Emergency Response Capacity',
    'Carbon Emissions (tons)',
    'Water Quality Index',
    'Sanitation Coverage Rate',
    'Vaccination Coverage Rate',
    'Mental Health Assistance'
]

# People impact indicators
people_cols = [
    'Vulnerability assessment',
    'Needs assessment status',
    'Allocation fairness index',
    'Affected population feedback score',
    'Community engagement level',
    'Local capacity building'
]

# Mapping for categorical variables (higher score = worse)
def map_env_impact(val):
    return {'Low': 1, 'Medium': 2, 'High': 3}.get(val, 0)

def map_waste(val):
    return {'Adequate': 1, 'Limited': 2, 'Critical': 3}.get(val, 0)

def map_disease(val):
    return {'Low': 1, 'Medium': 2, 'High': 3}.get(val, 0)

def map_med_capacity(val):
    return {'Adequate': 1, 'Limited': 2, 'Critical': 3}.get(val, 0)

def map_mental(val):
    return {'Available': 1, 'Limited': 2}.get(val, 0)

# Normalize numeric columns (0-1 where 1 is worse)
def normalize_worse(series, higher_worse=True):
    if higher_worse:
        return (series - series.min()) / (series.max() - series.min())
    else:
        # lower is worse, invert
        return 1 - ((series - series.min()) / (series.max() - series.min()))

# Compute secondary hazard score per event
df['secondary_score'] = (
    df['Environmental Impact Rate'].apply(map_env_impact) +
    df['Waste Management Status'].apply(map_waste) +
    df['Disease Risk'].apply(map_disease) +
    df['Medical Emergency Response Capacity'].apply(map_med_capacity) +
    normalize_worse(df['Carbon Emissions (tons)'], higher_worse=True) * 3 +
    normalize_worse(df['Water Quality Index'], higher_worse=False) * 3 +
    normalize_worse(df['Sanitation Coverage Rate'], higher_worse=False) * 3 +
    normalize_worse(df['Vaccination Coverage Rate'], higher_worse=False) * 3 +
    df['Mental Health Assistance'].apply(map_mental) * 1.5
)

# People impact score (higher = worse)
def map_vulnerability(val):
    return {'Pending': 3, 'In Progress': 2, 'Complete': 1}.get(val, 0)

def map_needs(val):
    return {'Overdue': 3, 'Due': 2, 'Updated': 1}.get(val, 0)

def map_engagement(val):
    return {'Low': 3, 'Medium': 2, 'High': 1}.get(val, 0)

def map_local_capacity(val):
    return {'Limited': 3, 'Developing': 2, 'Advanced': 1}.get(val, 0)

df['people_impact_score'] = (
    df['Vulnerability assessment'].apply(map_vulnerability) +
    df['Needs assessment status'].apply(map_needs) +
    normalize_worse(df['Allocation fairness index'], higher_worse=False) * 3 +
    normalize_worse(df['Affected population feedback score'], higher_worse=False) * 3 +  # lower feedback worse
    df['Community engagement level'].apply(map_engagement) +
    df['Local capacity building'].apply(map_local_capacity)
)

# Analysis: secondary score by disaster level and type
print("=== Secondary Hazard Score by Disaster Level (higher = worse) ===")
level_summary = df.groupby('Disaster Level').agg(
    mean_secondary=('secondary_score', 'mean'),
    std_secondary=('secondary_score', 'std'),
    count=('Disaster Event ID', 'count')
).sort_values('mean_secondary', ascending=False)
print(level_summary)

print("\n=== People Impact Score by Disaster Level (higher = worse) ===")
people_level_summary = df.groupby('Disaster Level').agg(
    mean_people=('people_impact_score', 'mean'),
    std_people=('people_impact_score', 'std'),
    count=('Disaster Event ID', 'count')
).sort_values('mean_people', ascending=False)
print(people_level_summary)

print("\n=== Secondary Hazard Score by Disaster Type ===")
type_summary = df.groupby('Disaster Type').agg(
    mean_secondary=('secondary_score', 'mean'),
    std_secondary=('secondary_score', 'std'),
    count=('Disaster Event ID', 'count')
).sort_values('mean_secondary', ascending=False)
print(type_summary)

print("\n=== People Impact Score by Disaster Type ===")
people_type_summary = df.groupby('Disaster Type').agg(
    mean_people=('people_impact_score', 'mean'),
    std_people=('people_impact_score', 'std'),
    count=('Disaster Event ID', 'count')
).sort_values('mean_people', ascending=False)
print(people_type_summary)

# Cross-tab: Level vs Type for secondary score
pivot = pd.pivot_table(df, values='secondary_score', index='Disaster Level', columns='Disaster Type', aggfunc='mean', fill_value=0)
print("\n=== Secondary Score Heatmap (Level x Type) ===")
print(pivot)

# Identify which specific secondary hazards are most problematic per level
secondary_components = ['Environmental Impact Rate', 'Waste Management Status', 'Disease Risk', 'Medical Emergency Response Capacity', 'Carbon Emissions (tons)', 'Water Quality Index', 'Sanitation Coverage Rate', 'Vaccination Coverage Rate', 'Mental Health Assistance']

for col in secondary_components:
    if col in ['Carbon Emissions (tons)', 'Water Quality Index', 'Sanitation Coverage Rate', 'Vaccination Coverage Rate']:
        # Compute average, but for water quality lower is worse, but we'll just show raw avg
        avg_by_level = df.groupby('Disaster Level')[col].mean()
        print(f"\nAverage {col} by Disaster Level:")
        print(avg_by_level)
    else:
        # For categorical, compute proportion of worst category
        if col == 'Environmental Impact Rate':
            worst = 'High'
        elif col == 'Waste Management Status':
            worst = 'Critical'
        elif col == 'Disease Risk':
            worst = 'High'
        elif col == 'Medical Emergency Response Capacity':
            worst = 'Critical'
        elif col == 'Mental Health Assistance':
            worst = 'Limited'
        else:
            worst = None
        if worst:
            def calc_prop(series):
                total = series.count()
                worst_count = (series == worst).sum()
                return worst_count / total if total > 0 else 0
            prop_by_level = df.groupby('Disaster Level')[col].apply(calc_prop).sort_values(ascending=False)
            print(f"\nProportion of {col} = '{worst}' by Disaster Level:")
            print(prop_by_level)

# Save detailed data for further reference
df[['Disaster Event ID', 'Disaster Level', 'Disaster Type', 'secondary_score', 'people_impact_score']].to_csv('detailed_scores.csv', index=False)
conn.close()
