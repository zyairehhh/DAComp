import pandas as pd

df = pd.read_csv('fashion_customer_profit.csv')
print("Rows:", df.shape[0])
print("Average total profit per customer:", df['total_profit'].mean())

# Top region-segment combos (with at least 5 customers)
comb = df.groupby(['Region', 'Customer Segment'])['total_profit'].agg(['mean','count']).reset_index()
comb = comb[comb['count'] >= 5].sort_values('mean', ascending=False)
print("\\nTop Region+Segment combos (mean total profit):")
print(comb.head(10))
print()

# Top gender+education combos
comb2 = df.groupby(['gender', 'Education Level'])['total_profit'].agg(['mean','count']).reset_index()
comb2 = comb2[comb2['count'] >= 5].sort_values('mean', ascending=False)
print("Top Gender+Education combos:")
print(comb2.head(10))
print()

# Top age groups
df['age_group'] = pd.cut(df['age'], bins=[18,25,35,50,70], labels=['18-25','26-35','36-50','51+'])
age_profit = df.groupby('age_group')['total_profit'].agg(['mean','count']).sort_values('mean', ascending=False)
print("Age group profitability:")
print(age_profit)
print()

# Marital status + gender
comb3 = df.groupby(['Marital Status', 'gender'])['total_profit'].agg(['mean','count']).reset_index()
comb3 = comb3.sort_values('mean', ascending=False)
print("Marital Status + Gender profitability:")
print(comb3)
print()

# Browsing correlation
if 'total_browse_time' in df.columns:
    corr = df[['total_profit','total_browse_time','total_likes','total_shares','total_add_to_cart']].corr()
    print("Correlation with browsing metrics:")
    print(corr['total_profit'].sort_values(ascending=False))
''')
