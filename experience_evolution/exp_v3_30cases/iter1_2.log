```python
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import os

# Connect to the database
conn = sqlite3.connect('dacomp-005.sqlite')

# Threshold from Stage1 report
avg_margin = 0.795287
low_margin_threshold = avg_margin / 2  # 50% of average

# Query to get data
query = '''
SELECT 
    "Sales Quantity",
    "Profit Margin",
    "Freight Cost",
    "Warehousing Cost",
    "Other Operating Costs",
    "Total Logistics Revenue",
    "Discount Amount",
    "List Price Revenue",
    "Logistics Unit Price",
    "Destination",
    "Date",
    "Consigned Product",
    "Customer Gender",
    "Age Range",
    "Customer Age",
    CASE 
        WHEN "Profit Margin" < ? THEN 1 
        ELSE 0 
    END as low_margin_flag
FROM sheet1
'''

df = pd.read_sql_query(query, conn, params=(low_margin_threshold,))
conn.close()

# Create output directory for plots
os.makedirs('plots', exist_ok=True)

# 1. Sales Quantity Distribution Comparison
plt.figure(figsize=(10, 6))
low_margin = df[df['low_margin_flag'] == 1]['Sales Quantity']
normal = df[df['low_margin_flag'] == 0]['Sales Quantity']

# Create bins for histogram
bins = np.arange(0, max(df['Sales Quantity'].max(), 200)+1, 1)
plt.hist(low_margin, bins=bins, alpha=0.7, label='Low-Margin Orders', color='red', density=True)
plt.hist(normal, bins=bins, alpha=0.7, label='Normal Orders', color='blue', density=True)
plt.xlim(0, 50)  # Focus on the most relevant range
plt.xlabel('Sales Quantity (units)')
plt.ylabel('Density')
plt.title('Distribution of Sales Quantity: Low-Margin vs Normal Orders')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('plots/sales_quantity_distribution.png', dpi=300)
plt.close()

# 2. Per-Unit Cost Comparison (Bar chart)
# Calculate per-unit costs
df['Freight_per_unit'] = df['Freight Cost'] / df['Sales Quantity']
df['Warehousing_per_unit'] = df['Warehousing Cost'] / df['Sales Quantity']
df['Other_cost_per_unit'] = df['Other Operating Costs'] / df['Sales Quantity']

low_margin_means = df[df['low_margin_flag'] == 1][['Freight_per_unit', 'Warehousing_per_unit', 'Other_cost_per_unit']].mean()
normal_means = df[df['low_margin_flag'] == 0][['Freight_per_unit', 'Warehousing_per_unit', 'Other_cost_per_unit']].mean()

categories = ['Freight per unit', 'Warehousing per unit', 'Other costs per unit']
x = np.arange(len(categories))
width = 0.35

plt.figure(figsize=(10, 6))
plt.bar(x - width/2, low_margin_means.values, width, label='Low-Margin Orders', color='red')
plt.bar(x + width/2, normal_means.values, width, label='Normal Orders', color='blue')
plt.xlabel('Cost Component')
plt.ylabel('Cost per Unit (currency)')
plt.title('Per-Unit Cost Comparison: Low-Margin vs Normal Orders')
plt.xticks(x, categories, rotation=15)
plt.legend()
plt.grid(True, alpha=0.3, axis='y')
plt.tight_layout()
plt.savefig('plots/per_unit_cost_comparison.png', dpi=300)
plt.close()

# 3. Discount Behavior
plt.figure(figsize=(10, 6))
# Calculate discount ratio
df['Discount_ratio'] = df['Discount Amount'] / df['List Price Revenue'] * 100  # in percentage

# Boxplot of discount ratio
box_data = [df[df['low_margin_flag'] == 1]['Discount_ratio'].dropna(), 
            df[df['low_margin_flag'] == 0]['Discount_ratio'].dropna()]
plt.boxplot(box_data, labels=['Low-Margin Orders', 'Normal Orders'])
plt.ylabel('Discount Ratio (%)')
plt.title('Discount Behavior: Low-Margin vs Normal Orders')
plt.grid(True, alpha=0.3, axis='y')
plt.tight_layout()
plt.savefig('plots/discount_behavior.png', dpi=300)
plt.close()

# 4. Top destinations with high low-margin rates
# Calculate low-margin rate by destination (only for destinations with sufficient orders)
destination_stats = df.groupby('Destination').agg(
    total_orders=('low_margin_flag', 'size'),
    low_margin_orders=('low_margin_flag', 'sum')
).reset_index()
destination_stats['low_margin_rate'] = destination_stats['low_margin_orders'] / destination_stats['total_orders'] * 100

# Filter for destinations with at least 100 orders
top_destinations = destination_stats[destination_stats['total_orders'] >= 100].sort_values('low_margin_rate', ascending=False)

plt.figure(figsize=(12, 6))
bars = plt.bar(top_destinations['Destination'].head(10), top_destinations['low_margin_rate'].head(10), color='coral')
plt.xlabel('Destination')
plt.ylabel('Low-Margin Rate (%)')
plt.title('Top 10 Destinations with Highest Low-Margin Rates (≥100 orders)')
plt.xticks(rotation=45, ha='right')
plt.grid(True, alpha=0.3, axis='y')

# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.1,
            f'{height:.1f}%', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('plots/destination_low_margin_rates.png', dpi=300)
plt.close()

print("Visualization script created successfully")
```
