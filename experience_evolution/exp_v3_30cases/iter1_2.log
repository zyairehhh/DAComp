'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-078/stage1_env/dacomp-078.sqlite')

# Get monthly aggregates sorted by month
monthly = pd.read_sql_query('''
SELECT visitor_id, 
       strftime('%Y-%m', date_day) as month,
       SUM(sum_minutes) as monthly_minutes,
       SUM(sum_events) as monthly_events
FROM pendo__visitor_daily_metrics
GROUP BY visitor_id, month
ORDER BY visitor_id, month
''', conn)

# For each visitor, compute last two months and compute growth rate
def compute_mom_growth(group):
    if len(group) >= 2:
        # Assume months are sorted ascending
        last = group.iloc[-1]['monthly_minutes']
        second_last = group.iloc[-2]['monthly_minutes']
        if second_last > 0:
            return (last - second_last) / second_last
        else:
            return np.nan
    else:
        return np.nan

mom = monthly.groupby('visitor_id').apply(compute_mom_growth).reset_index(name='mom_growth')
mom = mom.dropna()

# Load high-value label
visitor_df = pd.read_sql_query("SELECT visitor_id, sum_minutes, sum_events FROM pendo__visitor;", conn)
threshold_minutes = visitor_df['sum_minutes'].quantile(0.8)
threshold_events = visitor_df['sum_events'].quantile(0.8)
visitor_df['high_value'] = (visitor_df['sum_minutes'] >= threshold_minutes) & (visitor_df['sum_events'] >= threshold_events)

merged = visitor_df.merge(mom, on='visitor_id', how='inner')
corr = merged[['high_value', 'mom_growth']].corr().iloc[0,1]
print(f"Correlation between high_value and month-over-month growth (last two months): {corr:.4f}")
print("High-value mean mom_growth:", merged[merged['high_value']]['mom_growth'].mean())
print("Non-high-value mean mom_growth:", merged[~merged['high_value']]['mom_growth'].mean())

# Also compute average monthly growth across all months (excluding first)
def avg_growth(group):
    vals = group['monthly_minutes'].values
    if len(vals) >= 2:
        diffs = np.diff(vals)
        rel = diffs / vals[:-1]
        return np.mean(rel)
    else:
        return np.nan

avg_g = monthly.groupby('visitor_id').apply(avg_growth).reset_index(name='avg_growth')
avg_g = avg_g.dropna()
merged = merged.merge(avg_g, on='visitor_id', how='left')
corr2 = merged[['high_value', 'avg_growth']].corr().iloc[0,1]
print(f"Correlation between high_value and average monthly growth: {corr2:.4f}")

conn.close()
''')
