import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')

# Connect to database
db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-008/stage1_env/dacomp-008.sqlite"
conn = sqlite3.connect(db_path)
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Compute cost deviation
df['Cost_Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Basic statistics
print("Overall cost deviation statistics:")
print(df['Cost_Deviation'].describe())
print()

# By Project Type
print("Cost deviation by Project Type:")
group = df.groupby('Project Type')['Cost_Deviation']
agg = group.agg(['count', 'mean', 'std', 'min', 'max', 'median'])
print(agg)
print()

# Distribution metrics (skewness, kurtosis)
from scipy import stats
for ptype in df['Project Type'].unique():
    sub = df[df['Project Type'] == ptype]['Cost_Deviation']
    skew = stats.skew(sub)
    kurt = stats.kurtosis(sub)
    print(f"{ptype}: skew={skew:.2f}, kurtosis={kurt:.2f}")

# Relationships with Team Size, Risk Level, Customer Satisfaction
# Correlation matrix
numeric_cols = ['Cost_Deviation', 'Team Size', 'Customer Satisfaction']
corr = df[numeric_cols].corr()
print("\nCorrelation matrix (numeric):")
print(corr)

# Risk Level mapping to ordinal
risk_mapping = {'Low': 0, 'Medium': 1, 'High': 2}
df['Risk_Level_Ordinal'] = df['Risk Level'].map(risk_mapping)
corr_with_risk = df[['Cost_Deviation', 'Risk_Level_Ordinal']].corr()
print("\nCorrelation with risk level (ordinal):")
print(corr_with_risk)

# By Risk Level
print("\nCost deviation by Risk Level:")
risk_group = df.groupby('Risk Level')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max'])
print(risk_group)

# By Priority
print("\nCost deviation by Priority:")
priority_group = df.groupby('Priority')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max'])
print(priority_group)

# By Project Status
print("\nCost deviation by Project Status:")
status_group = df.groupby('Project Status')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max'])
print(status_group)

# Additional analysis: regression or grouping across multiple factors
print("\nInteraction: Project Type and Risk Level combined:")
interaction = df.groupby(['Project Type', 'Risk Level'])['Cost_Deviation'].agg(['count', 'mean', 'std']).reset_index()
print(interaction)

# Save results to CSV for reference
agg.to_csv('/workspace/cost_deviation_by_type.csv')
interaction.to_csv('/workspace/interaction_type_risk.csv')
df.to_csv('/workspace/full_data_with_deviation.csv', index=False)
print("\nData saved to CSV files.")
