import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings("ignore")

conn = sqlite3.connect('/workspace/dacomp-070.sqlite')

# Helper for linear regression slope
def linear_slope(x, y):
    n = len(x)
    if n < 2:
        return 0, 0, 0
    x_mean = np.mean(x)
    y_mean = np.mean(y)
    numerator = np.sum((x - x_mean) * (y - y_mean))
    denominator = np.sum((x - x_mean) ** 2)
    if denominator == 0:
        return 0, 0, 0
    slope = numerator / denominator
    intercept = y_mean - slope * x_mean
    # R-squared
    ss_total = np.sum((y - y_mean) ** 2)
    ss_residual = np.sum((y - (intercept + slope * x)) ** 2)
    r_squared = 1 - (ss_residual / ss_total) if ss_total != 0 else 0
    return slope, intercept, r_squared

# 1. Region conversion rate decay over past 6 months
region_query = """
SELECT region, strftime('%Y-%m', date_day) as month, AVG(store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__country_report
WHERE region IS NOT NULL
GROUP BY region, month
ORDER BY region, month
"""
region_df = pd.read_sql(region_query, conn)

region_decay = {}
for region in region_df['region'].unique():
    sub = region_df[region_df['region']==region].copy()
    sub = sub.sort_values('month')
    sub['month_num'] = np.arange(len(sub))
    if len(sub) >= 2:
        slope, intercept, r_squared = linear_slope(sub['month_num'].values, sub['avg_conversion_rate'].values)
        # p-value not computed (skip)
        region_decay[region] = {'slope': slope, 'r_squared': r_squared, 'trend': 'decreasing' if slope < 0 else 'increasing'}

# 2. Device install per active device decay
device_query = """
SELECT device, strftime('%Y-%m', date_day) as month,
       SUM(device_installs) as total_device_installs,
       SUM(active_devices_last_30_days) as total_active_devices
FROM google_play__device_report
GROUP BY device, month
ORDER BY device, month
"""
device_df = pd.read_sql(device_query, conn)
device_df['installs_per_active'] = device_df['total_device_installs'] / device_df['total_active_devices']

device_decay = {}
for device in device_df['device'].unique():
    sub = device_df[device_df['device']==device].copy()
    sub = sub.sort_values('month')
    sub['month_num'] = np.arange(len(sub))
    if len(sub) >= 2:
        slope, intercept, r_squared = linear_slope(sub['month_num'].values, sub['installs_per_active'].values)
        device_decay[device] = {'slope': slope, 'r_squared': r_squared, 'trend': 'decreasing' if slope < 0 else 'increasing'}

# 3. Non-linear relationship between store_listing_conversion_rate and quality_score/crash_rate_per_1k
nonlin_query = """
SELECT c.store_listing_conversion_rate, t.quality_score, t.crash_rate_per_1k
FROM google_play__country_report c
JOIN google_play__time_series_trends t ON c.date_day = t.date_day AND c.package_name = t.package_name
WHERE c.store_listing_conversion_rate IS NOT NULL AND t.quality_score IS NOT NULL AND t.crash_rate_per_1k IS NOT NULL
LIMIT 10000
"""
nonlin_df = pd.read_sql(nonlin_query, conn)

# Compute correlations
corr_quality = nonlin_df['store_listing_conversion_rate'].corr(nonlin_df['quality_score'])
corr_crash = nonlin_df['store_listing_conversion_rate'].corr(nonlin_df['crash_rate_per_1k'])

# 4. Multi-dimensional user value decay model: revenue_per_active_device vs market maturity
rev_query = """
SELECT strftime('%Y-%m', date_day) as month,
       AVG(revenue_per_active_device) as avg_rev_per_active,
       AVG(daily_installs) as avg_daily_installs,
       AVG(active_devices) as avg_active_devices
FROM google_play__time_series_trends
GROUP BY month
ORDER BY month
"""
rev_df = pd.read_sql(rev_query, conn)
rev_df['month_num'] = np.arange(len(rev_df))
if len(rev_df) >= 2:
    slope_rev, intercept_rev, r_sq_rev = linear_slope(rev_df['month_num'].values, rev_df['avg_rev_per_active'].values)
else:
    slope_rev = None
    r_sq_rev = None

# 5. Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
update_query = """
SELECT strftime('%Y-%m', date_day) as month, package_name,
       SUM(update_events) as total_updates,
       AVG(active_devices_last_30_days) as avg_active_devices,
       AVG(rolling_total_average_rating) as avg_rolling_rating
FROM google_play__device_report
GROUP BY month, package_name
HAVING total_updates > 0
"""
update_df = pd.read_sql(update_query, conn)
update_df['updates_per_active'] = update_df['total_updates'] / update_df['avg_active_devices']

corr_update_rating = update_df['updates_per_active'].corr(update_df['avg_rolling_rating'])
corr_update_active = update_df['updates_per_active'].corr(update_df['avg_active_devices'])

# 6. Output results
print("=== REGION CONVERSION RATE DECAY ===")
for region, metrics in region_decay.items():
    print(f"{region}: slope={metrics['slope']:.6f}, R²={metrics['r_squared']:.4f}, trend={metrics['trend']}")

print("\n=== DEVICE INSTALL PER ACTIVE DEVICE DECAY ===")
for device, metrics in list(device_decay.items())[:5]:
    print(f"{device}: slope={metrics['slope']:.6f}, R²={metrics['r_squared']:.4f}, trend={metrics['trend']}")
print("... (remaining devices)")

print("\n=== NON-LINEAR RELATIONSHIP: CONVERSION RATE VS QUALITY/CRASH ===")
print(f"Correlation with quality_score: {corr_quality:.4f}")
print(f"Correlation with crash_rate_per_1k: {corr_crash:.4f}")

print("\n=== REVENUE PER ACTIVE DEVICE DECAY OVER TIME (MARKET MATURITY) ===")
if slope_rev is not None:
    print(f"Slope of avg revenue per active device vs month: {slope_rev:.6f} (R²={r_sq_rev:.4f})")
    print(f"Trend: {'decreasing' if slope_rev < 0 else 'increasing'}")

print("\n=== INTERACTION EFFECT OF UPDATE FREQUENCY ===")
print(f"Correlation between updates per active device and rolling rating: {corr_update_rating:.4f}")
print(f"Correlation between updates per active device and active devices: {corr_update_active:.4f}")

conn.close()
```
