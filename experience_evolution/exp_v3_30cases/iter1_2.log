```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
import os

# Set plotting style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("Set2")

# Connect to database
conn = sqlite3.connect('dacomp-076.sqlite')

# Query 1: Get segment-level anomaly rates (simplified)
query1 = """
SELECT 
    profitability_segment,
    ROUND(AVG(retention_probability), 3) as segment_avg_retention,
    COUNT(*) as total_customers
FROM netsuite2_customer_analytics
GROUP BY profitability_segment
ORDER BY segment_avg_retention DESC
"""

segment_avgs = pd.read_sql_query(query1, conn)

# Compute anomalies for each segment
anomaly_counts = []
for _, row in segment_avgs.iterrows():
    segment = row['profitability_segment']
    segment_avg = row['segment_avg_retention']
    
    query = f"""
    SELECT COUNT(*) as anomaly_count
    FROM netsuite2_customer_analytics
    WHERE profitability_segment = '{segment}' 
    AND ABS(retention_probability - {segment_avg}) > 0.15
    """
    
    result = pd.read_sql_query(query, conn)
    anomaly_counts.append(result['anomaly_count'].iloc[0])

segment_avgs['anomaly_count'] = anomaly_counts
segment_avgs['anomaly_rate_percent'] = round(100.0 * segment_avgs['anomaly_count'] / segment_avgs['total_customers'], 1)

# Query 2: Get anomaly vs normal customer characteristics - simpler approach
query2_base = """
SELECT 
    retention_probability,
    transaction_count,
    avg_transactions_per_month,
    transaction_value_volatility,
    comprehensive_customer_score,
    total_revenue,
    q1_transactions,
    q2_transactions,
    q3_transactions,
    q4_transactions
FROM netsuite2_customer_analytics
WHERE profitability_segment = '{segment}'
"""

# First, let's compute segment averages for anomaly detection
segment_list = segment_avgs['profitability_segment'].tolist()
all_customers = []

for segment in segment_list:
    segment_avg = segment_avgs[segment_avgs['profitability_segment'] == segment]['segment_avg_retention'].iloc[0]
    
    query = f"""
    SELECT 
        '{segment}' as segment,
        retention_probability,
        CASE WHEN ABS(retention_probability - {segment_avg}) > 0.15 THEN 1 ELSE 0 END as is_anomaly,
        transaction_count,
        avg_transactions_per_month,
        transaction_value_volatility,
        comprehensive_customer_score,
        total_revenue,
        q1_transactions,
        q2_transactions,
        q3_transactions,
        q4_transactions
    FROM netsuite2_customer_analytics
    WHERE profitability_segment = '{segment}'
    """
    
    segment_data = pd.read_sql_query(query, conn)
    all_customers.append(segment_data)

all_data = pd.concat(all_customers, ignore_index=True)

# Compute summary statistics for normal vs anomaly
summary_stats = all_data.groupby('is_anomaly').agg({
    'transaction_count': 'mean',
    'avg_transactions_per_month': 'mean',
    'transaction_value_volatility': 'mean',
    'comprehensive_customer_score': 'mean',
    'total_revenue': 'mean',
    'q1_transactions': 'mean',
    'q2_transactions': 'mean',
    'q3_transactions': 'mean',
    'q4_transactions': 'mean'
}).reset_index()

# Calculate Q4 percentage
summary_stats['q4_percentage'] = 100.0 * summary_stats['q4_transactions'] / (
    summary_stats['q1_transactions'] + summary_stats['q2_transactions'] + 
    summary_stats['q3_transactions'] + summary_stats['q4_transactions']
)

# Compute seasonal HHI for all customers
all_data['total_transactions'] = (all_data['q1_transactions'] + all_data['q2_transactions'] + 
                                  all_data['q3_transactions'] + all_data['q4_transactions'])
all_data['seasonal_hhi'] = (all_data['q1_transactions']**2 + all_data['q2_transactions']**2 + 
                           all_data['q3_transactions']**2 + all_data['q4_transactions']**2) / all_data['total_transactions']**2
all_data['seasonal_hhi'] = all_data['seasonal_hhi'].fillna(0)

# Compute value alignment z-scores
score_mean = all_data['comprehensive_customer_score'].mean()
score_std = all_data['comprehensive_customer_score'].std()
revenue_mean = all_data['total_revenue'].mean()
revenue_std = all_data['total_revenue'].std()

all_data['score_z'] = (all_data['comprehensive_customer_score'] - score_mean) / score_std
all_data['revenue_z'] = (all_data['total_revenue'] - revenue_mean) / revenue_std
all_data['z_diff'] = all_data['score_z'] - all_data['revenue_z']

conn.close()

# Create visualizations directory if it doesn't exist
os.makedirs('visualizations', exist_ok=True)

# Plot 1: Anomaly Rates by Segment
plt.figure(figsize=(10, 6))
bars = plt.bar(segment_avgs['profitability_segment'], segment_avgs['anomaly_rate_percent'], color='steelblue', alpha=0.7)
plt.title('Classification Anomaly Rates by Profitability Segment', fontsize=16, fontweight='bold')
plt.xlabel('Profitability Segment', fontsize=12)
plt.ylabel('Anomaly Rate (%)', fontsize=12)
plt.xticks(rotation=45)
plt.grid(axis='y', alpha=0.3)

# Add value labels on top of bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.5,
             f'{height:.1f}%', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('visualizations/anomaly_rates_by_segment.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 1 saved: visualizations/anomaly_rates_by_segment.png")

# Plot 2: Seasonal Distribution Comparison
plt.figure(figsize=(10, 6))
categories = ['Q1', 'Q2', 'Q3', 'Q4']
normal_vals = [summary_stats.loc[0, 'q1_transactions'], summary_stats.loc[0, 'q2_transactions'], 
               summary_stats.loc[0, 'q3_transactions'], summary_stats.loc[0, 'q4_transactions']]
anomaly_vals = [summary_stats.loc[1, 'q1_transactions'], summary_stats.loc[1, 'q2_transactions'], 
                summary_stats.loc[1, 'q3_transactions'], summary_stats.loc[1, 'q4_transactions']]

x = np.arange(len(categories))
width = 0.35

plt.bar(x - width/2, normal_vals, width, label='Normal Customers', color='lightgreen', alpha=0.7)
plt.bar(x + width/2, anomaly_vals, width, label='Anomaly Customers', color='salmon', alpha=0.7)

plt.title('Average Quarterly Transaction Distribution: Normal vs Anomaly Customers', fontsize=16, fontweight='bold')
plt.xlabel('Quarter', fontsize=12)
plt.ylabel('Average Transaction Count', fontsize=12)
plt.xticks(x, categories)
plt.legend()
plt.grid(axis='y', alpha=0.3)

plt.tight_layout()
plt.savefig('visualizations/seasonal_distribution_comparison.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 2 saved: visualizations/seasonal_distribution_comparison.png")

# Plot 3: Q4 Concentration Difference
plt.figure(figsize=(8, 6))
q4_data = [summary_stats.loc[0, 'q4_percentage'], summary_stats.loc[1, 'q4_percentage']]
labels = ['Normal Customers', 'Anomaly Customers']
colors = ['lightgreen', 'salmon']

bars = plt.bar(labels, q4_data, color=colors, alpha=0.7)
plt.title('Q4 Transaction Concentration', fontsize=16, fontweight='bold')
plt.ylabel('Q4 Transactions (%)', fontsize=12)
plt.ylim(0, max(q4_data) * 1.2)

for bar, val in zip(bars, q4_data):
    plt.text(bar.get_x() + bar.get_width()/2., val + 0.5,
             f'{val:.1f}%', ha='center', va='bottom', fontsize=11, fontweight='bold')

plt.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('visualizations/q4_concentration.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 3 saved: visualizations/q4_concentration.png")

# Plot 4: Transaction Behavioral Comparison
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

metrics_data = {
    'avg_transaction_count': summary_stats['transaction_count'].tolist(),
    'avg_monthly_transactions': summary_stats['avg_transactions_per_month'].tolist(),
    'avg_volatility': summary_stats['transaction_value_volatility'].tolist()
}

metric_labels = ['Transaction Count', 'Monthly Transactions', 'Value Volatility']
normal_vals = [summary_stats.loc[0, 'transaction_count'], summary_stats.loc[0, 'avg_transactions_per_month'], summary_stats.loc[0, 'transaction_value_volatility']]
anomaly_vals = [summary_stats.loc[1, 'transaction_count'], summary_stats.loc[1, 'avg_transactions_per_month'], summary_stats.loc[1, 'transaction_value_volatility']]

for idx, (ax, label, n_val, a_val) in enumerate(zip(axes, metric_labels, normal_vals, anomaly_vals)):
    bars = ax.bar(['Normal', 'Anomaly'], [n_val, a_val], color=['lightgreen', 'salmon'], alpha=0.7)
    ax.set_title(f'{label}', fontsize=12, fontweight='bold')
    ax.set_ylabel(label, fontsize=10)
    ax.grid(axis='y', alpha=0.3)
    
    # Add value labels
    for bar, val in zip(bars, [n_val, a_val]):
        height = bar.get_height()
        ax.text(bar.get_x() + bar.get_width()/2., height + 0.01,
               f'{val:.2f}', ha='center', va='bottom', fontsize=9)

fig.suptitle('Transaction Behavior: Normal vs Anomaly Customers', fontsize=16, fontweight='bold')
plt.tight_layout()
plt.savefig('visualizations/transaction_behavior_comparison.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 4 saved: visualizations/transaction_behavior_comparison.png")

# Plot 5: Value Realization Gap (Z-score difference)
z_diff_means = all_data.groupby('is_anomaly')['z_diff'].mean()

plt.figure(figsize=(10, 6))
categories = ['Normal', 'Anomaly']
z_diff_vals = [z_diff_means[0], z_diff_means[1]]

bars = plt.bar(categories, z_diff_vals, color=['lightgreen', 'salmon'], alpha=0.7)
plt.title('Value Realization Gap (Score Z-score - Revenue Z-score)', fontsize=16, fontweight='bold')
plt.ylabel('Z-score Difference', fontsize=12)
plt.axhline(y=0, color='black', linestyle='-', alpha=0.3)

for bar, val in zip(bars, z_diff_vals):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.01,
             f'{val:.3f}', ha='center', va='bottom', fontsize=11, 
             color='red' if val < 0 else 'green')

plt.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('visualizations/value_realization_gap.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 5 saved: visualizations/value_realization_gap.png")

# Plot 6: Seasonal Concentration (HHI) Distribution
plt.figure(figsize=(10, 6))
normal_hhi = all_data[all_data['is_anomaly'] == 0]['seasonal_hhi']
anomaly_hhi = all_data[all_data['is_anomaly'] == 1]['seasonal_hhi']

plt.hist(normal_hhi, bins=20, alpha=0.5, label='Normal Customers', color='lightgreen', density=True)
plt.hist(anomaly_hhi, bins=20, alpha=0.5, label='Anomaly Customers', color='salmon', density=True)

plt.title('Seasonal Concentration Distribution (HHI)', fontsize=16, fontweight='bold')
plt.xlabel('Seasonal Concentration Index (HHI)', fontsize=12)
plt.ylabel('Density', fontsize=12)
plt.legend()
plt.grid(alpha=0.3)

# Add mean lines
plt.axvline(x=normal_hhi.mean(), color='green', linestyle='--', alpha=0.8, label=f'Normal Mean: {normal_hhi.mean():.3f}')
plt.axvline(x=anomaly_hhi.mean(), color='red', linestyle='--', alpha=0.8, label=f'Anomaly Mean: {anomaly_hhi.mean():.3f}')

plt.legend()
plt.tight_layout()
