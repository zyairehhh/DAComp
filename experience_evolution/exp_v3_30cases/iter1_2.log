```python
import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-069.sqlite')

# Monthly total net per region
df = pd.read_sql_query("""
SELECT strftime('%Y-%m', date_day) AS month, region, SUM(net_amount) as total_net
FROM google_play__finance_report
WHERE package_name = 'com.dev.photoeditor'
GROUP BY month, region
ORDER BY month, region
""", conn)

# Compute overall total per month
monthly_total = df.groupby('month')['total_net'].sum().reset_index(name='overall_total')
df = pd.merge(df, monthly_total, on='month')
df['share'] = df['total_net'] / df['overall_total']

print("Monthly region contributions:")
print(df.pivot(index='month', columns='region', values='share').fillna(0))

# Compute for each region the trend slope (linear regression)
from sklearn.linear_model import LinearRegression
import numpy as np

regions = df['region'].unique()
for r in regions:
    sub = df[df['region'] == r].sort_values('month')
    if len(sub) < 2:
        continue
    X = np.arange(len(sub)).reshape(-1, 1)
    y = sub['total_net'].values
    model = LinearRegression().fit(X, y)
    print(f"Region {r}: slope {model.coef_[0]:.2f} (growth per month), R^2 {model.score(X, y):.3f}")

# Compute correlation between region revenue and overall_performance_score
df_perf = pd.read_sql_query("SELECT strftime('%Y-%m', date_day) AS month, overall_performance_score FROM google_play__comprehensive_performance_dashboard WHERE package_name = 'com.dev.photoeditor' ORDER BY month", conn)
df_perf['month'] = df_perf['month'].astype(str)
df_combined = pd.merge(df, df_perf, on='month', how='left')
corr_matrix = df_combined[['total_net', 'overall_performance_score']].corr()
print("\nCorrelation between region net revenue and overall_performance_score:")
print(corr_matrix)

conn.close()
```
