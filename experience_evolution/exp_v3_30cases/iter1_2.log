import sqlite3
import pandas as pd
import datetime as dt

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-017/stage1_env/dacomp-017.sqlite')

# Compute RFM for Home & Furniture customers
query = """
SELECT 
    "Customer ID",
    MAX("Order Date") as last_purchase,
    COUNT(DISTINCT "Order ID") as frequency,
    SUM(profit) as monetary
FROM order_information 
WHERE "Product Category" = 'Home & Furniture'
GROUP BY "Customer ID"
"""
rfm = pd.read_sql(query, conn)
rfm['last_purchase'] = pd.to_datetime(rfm['last_purchase'])
max_date = pd.to_datetime('2024-12-31 00:00:00')  # from earlier max date
rfm['recency_days'] = (max_date - rfm['last_purchase']).dt.days

# Assign quartile scores (1-4) where 4 is best
rfm['R_score'] = pd.qcut(rfm['recency_days'], q=4, labels=[4,3,2,1])  # reverse so lower days = higher score
rfm['F_score'] = pd.qcut(rfm['frequency'], q=4, labels=[1,2,3,4])
rfm['M_score'] = pd.qcut(rfm['monetary'], q=4, labels=[1,2,3,4])

rfm['RFM_total'] = rfm['R_score'].astype(int) + rfm['F_score'].astype(int) + rfm['M_score'].astype(int)
rfm['segment'] = 'Mid'
rfm.loc[rfm['RFM_total'] >= 10, 'segment'] = 'High'
rfm.loc[rfm['RFM_total'] <= 5, 'segment'] = 'Low'

print("RFM segment counts:")
print(rfm['segment'].value_counts())

# Now get product mix per customer per year for core vs others
# Get customer IDs of high segment
high_customers = rfm[rfm['segment'] == 'High']['Customer ID'].tolist()
low_customers = rfm[rfm['segment'] == 'Low']['Customer ID'].tolist()

# Fetch order details for high segment
query_high = f"""
SELECT 
    strftime('%Y', "Order Date") as year,
    "Product",
    SUM(Sales) as sales,
    SUM(profit) as profit,
    COUNT(*) as orders
FROM order_information 
WHERE "Product Category" = 'Home & Furniture'
    AND "Customer ID" IN ({','.join('?' * len(high_customers))})
GROUP BY year, "Product"
ORDER BY year, sales DESC
"""
high_data = pd.read_sql(query_high, conn, params=high_customers)

# Fetch for low segment
query_low = f"""
SELECT 
    strftime('%Y', "Order Date") as year,
    "Product",
    SUM(Sales) as sales,
    SUM(profit) as profit,
    COUNT(*) as orders
FROM order_information 
WHERE "Product Category" = 'Home & Furniture'
    AND "Customer ID" IN ({','.join('?' * len(low_customers))})
GROUP BY year, "Product"
ORDER BY year, sales DESC
"""
low_data = pd.read_sql(query_low, conn, params=low_customers)

# Compute margin per segment per year
def compute_margin(df):
    if df.empty:
        return pd.DataFrame()
    margin = df.groupby('year').apply(lambda x: x['profit'].sum() / x['sales'].sum()).reset_index(name='margin')
    return margin

high_margin = compute_margin(high_data)
low_margin = compute_margin(low_data)

print("\nHigh segment margin per year:")
print(high_margin)
print("\nLow segment margin per year:")
print(low_margin)

# Compute product shift: check share of high-margin products (Towels, Sofa Covers, Bed Sheets) in sales
high_products = high_data.pivot_table(index='year', columns='Product', values='sales', aggfunc='sum', fill_value=0)
high_products['total_sales'] = high_products.sum(axis=1)
high_margin_products = ['Towels', 'Sofa Covers', 'Bed Sheets']
high_products['share_high_margin'] = high_products[high_margin_products].sum(axis=1) / high_products['total_sales']
print("\nHigh segment share of high-margin products:")
print(high_products[['total_sales', 'share_high_margin']])

low_products = low_data.pivot_table(index='year', columns='Product', values='sales', aggfunc='sum', fill_value=0)
low_products['total_sales'] = low_products.sum(axis=1)
low_products['share_high_margin'] = low_products[high_margin_products].sum(axis=1) / low_products['total_sales']
print("\nLow segment share of high-margin products:")
print(low_products[['total_sales', 'share_high_margin']])

conn.close()
```
