'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-019.sqlite')

# Load data
drug_info = pd.read_sql_query('SELECT "Drug ID", "Origin / Tier (Domestic/Imported/JV)" FROM basic_drug_information', conn)
# Rename column for easier handling
drug_info = drug_info.rename(columns={'Origin / Tier (Domestic/Imported/JV)': 'Origin'})
inventory = pd.read_sql_query('SELECT * FROM inventory_management', conn)

# Compute per-drug aggregated risk metrics
# Quality Risk (QR): sum of problematic quantities
quality_cols = [
    'Near-expiry Quantity',
    'Near-expiry Quantity.1',  # duplicate? but keep both
    'Quarantine Quantity',
    'Expired Quantity',
    'Returned Quantity',
    'Damaged Quantity',
    'Pest/Mold Damage Quantity',
    'Rodent Contamination Quantity',
    'Air Contamination Quantity',
    'Temp/Humidity Excursion Record'
]
# Ensure numeric
for col in quality_cols:
    inventory[col] = pd.to_numeric(inventory[col], errors='coerce').fillna(0)

inventory['Quality_Risk_Raw'] = inventory[quality_cols].sum(axis=1)

# Backlog Risk (BR): Qualified Quantity * Inventory Discrepancy Rate (convert % to decimal)
# Discrepancy rate is stored as string with % sign, e.g., "0.64%"
def parse_discrepancy_rate(rate_str):
    try:
        # Remove '%' and convert to float
        return float(str(rate_str).strip().rstrip('%')) / 100.0
    except:
        return 0.0

inventory['Discrepancy_Rate'] = inventory['Inventory Discrepancy Rate'].apply(parse_discrepancy_rate)
inventory['Backlog_Risk_Raw'] = inventory['Qualified Quantity'] * inventory['Discrepancy_Rate']

# Supply Risk (SR): count of records where Alert Status is "Alert" or "Severe" OR Inventory Status not "Normal"
inventory['Alert_Severe'] = inventory['Inventory Alert Status'].apply(lambda x: 1 if str(x).strip().lower() in ['alert', 'severe'] else 0)
inventory['Non_Normal'] = inventory['Inventory Status (Normal/Frozen/Scrapped)'].apply(lambda x: 1 if str(x).strip().lower() != 'normal' else 0)
inventory['Supply_Risk_Raw'] = inventory['Alert_Severe'] + inventory['Non_Normal']  # max 2 per record

# Aggregate per drug
agg = inventory.groupby('Drug ID').agg(
    Quality_Raw=('Quality_Risk_Raw', 'sum'),
    Backlog_Raw=('Backlog_Risk_Raw', 'sum'),
    Supply_Raw=('Supply_Risk_Raw', 'sum')
).reset_index()

# Merge with origin
df = pd.merge(agg, drug_info, left_on='Drug ID', right_on='Drug ID', how='left')
# Fill missing origins if any (should not)
df['Origin'] = df['Origin'].fillna('Unknown')

# Normalize scores (0‑1) across all drugs
for col in ['Quality_Raw', 'Backlog_Raw', 'Supply_Raw']:
    max_val = df[col].max()
    if max_val > 0:
        df[col + '_Norm'] = df[col] / max_val
    else:
        df[col + '_Norm'] = 0.0

# Overall risk score: weighted sum (Quality 40%, Backlog 30%, Supply 30%)
df['Overall_Risk'] = 0.4 * df['Quality_Raw_Norm'] + 0.3 * df['Backlog_Raw_Norm'] + 0.3 * df['Supply_Raw_Norm']

# Filter for Imported and Joint‑venture only
df_imported_jv = df[df['Origin'].isin(['Imported', 'Joint‑venture'])]
# Sort by Overall_Risk descending
df_top10 = df_imported_jv.sort_values('Overall_Risk', ascending=False).head(10)

print("Top 10 Imported/JV Drugs by Overall Risk:")
print(df_top10[['Drug ID', 'Origin', 'Overall_Risk', 'Quality_Raw', 'Backlog_Raw', 'Supply_Raw']].to_string(index=False))

# Plot 1: Top 10 Imported/JV Drugs – Stacked bar of normalized risk scores
plt.figure(figsize=(10,6))
x = np.arange(len(df_top10))
width = 0.6
colors = ['#ff7f0e', '#1f77b4', '#2ca02c']
plt.bar(x, df_top10['Quality_Raw_Norm'], width, label='Quality Risk (norm)', color=colors[0])
plt.bar(x, df_top10['Backlog_Raw_Norm'], width, bottom=df_top10['Quality_Raw_Norm'], label='Backlog Risk (norm)', color=colors[1])
plt.bar(x, df_top10['Supply_Raw_Norm'], width, bottom=df_top10['Quality_Raw_Norm'] + df_top10['Backlog_Raw_Norm'], label='Supply Risk (norm)', color=colors[2])
plt.xlabel('Drug (Imported/JV)')
plt.ylabel('Normalized Risk Score')
plt.title('Risk Composition of Top 10 Imported/JV Drugs')
plt.xticks(x, df_top10['Drug ID'], rotation=45, ha='right')
plt.legend()
plt.tight_layout()
plt.savefig('top10_risk_composition.png', dpi=300)
plt.close()

# Plot 2: Average risk scores by origin (including Domestic for comparison)
origin_avg = df.groupby('Origin')[['Quality_Raw_Norm', 'Backlog_Raw_Norm', 'Supply_Raw_Norm', 'Overall_Risk']].mean().reset_index()
# Order origins as in report: Domestic, Imported, Joint‑venture
origin_order = ['Domestic', 'Imported', 'Joint‑venture']
# Ensure we have all three
origin_avg = origin_avg[origin_avg['Origin'].isin(origin_order)]
origin_avg = origin_avg.set_index('Origin').reindex(origin_order).reset_index()

plt.figure(figsize=(8,5))
x = np.arange(len(origin_avg))
width = 0.2
plt.bar(x - width, origin_avg['Quality_Raw_Norm'], width, label='Quality Risk', color='#ff7f0e')
plt.bar(x, origin_avg['Backlog_Raw_Norm'], width, label='Backlog Risk', color='#1f77b4')
plt.bar(x + width, origin_avg['Supply_Raw_Norm'], width, label='Supply Risk', color='#2ca02c')
plt.xlabel('Drug Origin')
plt.ylabel('Average Normalized Risk Score')
plt.title('Average Risk Scores by Drug Origin')
plt.xticks(x, origin_avg['Origin'])
plt.legend()
plt.tight_layout()
plt.savefig('average_risk_by_origin.png', dpi=300)
plt.close()

# Plot 3: Prevalence of risk indicators (any supply risk, high quality risk, high backlog risk) per origin
# Define "any supply risk": Supply_Raw > 0
df['Any_Supply_Risk'] = df['Supply_Raw'] > 0
# Define "high quality risk": top 25% of Quality_Raw across all drugs
quality_threshold = df['Quality_Raw'].quantile(0.75)
df['High_Quality_Risk'] = df['Quality_Raw'] >= quality_threshold
backlog_threshold = df['Backlog_Raw'].quantile(0.75)
df['High_Backlog_Risk'] = df['Backlog_Raw'] >= backlog_threshold

prev = df.groupby('Origin').agg(
    pct_supply=('Any_Supply_Risk', 'mean'),
    pct_high_quality=('High_Quality_Risk', 'mean'),
    pct_high_backlog=('High_Backlog_Risk', 'mean')
).reset_index()
prev = prev[prev['Origin'].isin(origin_order)]
prev = prev.set_index('Origin').reindex(origin_order).reset_index()

plt.figure(figsize=(8,5))
x = np.arange(len(prev))
width = 0.25
plt.bar(x - width, prev['pct_supply']*100, width, label='Any Supply Risk', color='#2ca02c')
plt.bar(x, prev['pct_high_quality']*100, width, label='High Quality Risk (top 25%)', color='#ff7f0e')
plt.bar(x + width, prev['pct_high_backlog']*100, width, label='High Backlog Risk (top 25%)', color='#1f77b4')
plt.xlabel('Drug Origin')
plt.ylabel('Percentage of Drugs (%)')
plt.title('Prevalence of Risk Indicators by Origin')
plt.xticks(x, prev['Origin'])
plt.legend()
plt.tight_layout()
plt.savefig('risk_prevalence_by_origin.png', dpi=300)
plt.close()

# Plot 4: Triple-high-risk drugs (top 25% quality, top 25% backlog, any supply risk)
triple_high = df[(df['High_Quality_Risk']) & (df['High_Backlog_Risk']) & (df['Any_Supply_Risk'])]
triple_high_imported_jv = triple_high[triple_high['Origin'].isin(['Imported', 'Joint‑venture'])]
triple_high_imported_jv = triple_high_imported_jv.sort_values('Overall_Risk', ascending=False)

if not triple_high_imported_jv.empty:
    plt.figure(figsize=(9,5))
    x = np.arange(len(triple_high_imported_jv))
    width = 0.6
    plt.bar(x, triple_high_imported_jv['Overall_Risk'], width, color='crimson')
    plt.xlabel('Drug (Imported/JV)')
    plt.ylabel('Overall Risk Score')
    plt.title('Triple-High-Risk Imported/JV Drugs\n(Top 25% Quality & Backlog + Any Supply Risk)')
    plt.xticks(x, triple_high_imported_jv['Drug ID'], rotation=45, ha='right')
    # Annotate scores
    for i, v in enumerate(triple_high_imported_jv['Overall_Risk']):
        plt.text(i, v + 0.01, f'{v:.2f}', ha='center', fontsize=9)
    plt.tight_layout()
    plt.savefig('triple_high_risk_drugs.png', dpi=300)
    plt.close()
else:
    print("No triple-high-risk imported/JV drugs found.")

print("\nOrigin averages:")
print(origin_avg.to_string(index=False))
print("\nPrevalence percentages:")
print(prev.to_string(index=False))
print(f"\nNumber of triple-high-risk imported/JV drugs: {len(triple_high_imported_jv)}")
conn.close()
''')
