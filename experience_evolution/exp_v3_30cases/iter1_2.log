'''
import sqlite3
import pandas as pd
import numpy as np
import math

conn = sqlite3.connect('dacomp-013.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Data cleaning
df['Planned Work Hours'] = pd.to_numeric(df['Planned Work Hours'], errors='coerce')
df['Actual Work Hours'] = pd.to_numeric(df['Actual Work Hours'], errors='coerce')
df['Completion Quality Score'] = pd.to_numeric(df['Completion Quality Score'], errors='coerce')
df['Task Difficulty Coefficient'] = pd.to_numeric(df['Task Difficulty Coefficient'], errors='coerce')
df['Rework Count'] = pd.to_numeric(df['Rework Count'], errors='coerce')

date_cols = ['Planned Start Date', 'Planned Deadline', 'Actual Start Date', 'Actual Completion Time']
for col in date_cols:
    df[col] = pd.to_datetime(df[col], errors='coerce')

# Derived fields
df['Completed'] = df['Task Status'] == 'Completed'
df['OnTime'] = (df['Actual Completion Time'] <= df['Planned Deadline']) & df['Completed']

# Efficiency: (Planned - Actual) / Planned, but if actual > planned, negative; if planned 0, set to 0
df['Planned Work Hours'] = df['Planned Work Hours'].replace(0, np.nan)
df['WorkHourRatio'] = (df['Planned Work Hours'] - df['Actual Work Hours']) / df['Planned Work Hours']
# Higher positive ratio means more efficient (less hours used)
# For tasks not completed, efficiency not meaningful; we'll treat as 0? We'll consider only completed tasks for efficiency.

# Priority weight mapping
priority_weight = {'Urgent': 4, 'High': 3, 'Medium': 2, 'Low': 1}
df['PriorityWeight'] = df['Priority'].map(priority_weight)

# For each owner, compute weighted scores across tasks
def compute_metrics(group):
    total_tasks = group.shape[0]
    completed_tasks = group['Completed'].sum()
    completion_rate = completed_tasks / total_tasks if total_tasks > 0 else 0
    
    # Average quality among completed (ignore missing)
    quality_vals = group.loc[group['Completed'], 'Completion Quality Score'].dropna()
    avg_quality = quality_vals.mean() if not quality_vals.empty else np.nan
    
    # On-time rate among completed
    ontime_vals = group.loc[group['Completed'], 'OnTime']
    ontime_rate = ontime_vals.mean() if len(ontime_vals) > 0 else np.nan
    
    # Efficiency across completed (where work hours exist)
    eff_vals = group.loc[group['Completed'], 'WorkHourRatio'].dropna()
    avg_efficiency = eff_vals.mean() if not eff_vals.empty else np.nan
    
    # Weighted sum of priority per task (to account for priority exposure)
    total_priority_weight = group['PriorityWeight'].sum()
    
    # Weighted by task difficulty coefficient (maybe for fairness)
    total_difficulty = group['Task Difficulty Coefficient'].sum()
    
    # Compute raw score (simple average of metrics scaled 0-1)
    # Quality is 0-10? Let's assume max 10.
    scaled_quality = avg_quality / 10.0 if not pd.isna(avg_quality) else 0.5  # default to 0.5 if missing
    # Efficiency is -inf to +1, we need to normalize. Let's assume typical range -0.5 to 0.5? We'll compute later.
    scaled_efficiency = avg_efficiency if not pd.isna(avg_efficiency) else 0
    
    # Raw combined metric (weighted equally)
    # We'll compute after normalization across all owners.
    return pd.Series({
        'TotalTasks': total_tasks,
        'CompletedTasks': completed_tasks,
        'CompletionRate': completion_rate,
        'AvgQuality': avg_quality,
        'OnTimeRate': ontime_rate,
        'AvgEfficiency': avg_efficiency,
        'TotalPriorityWeight': total_priority_weight,
        'AvgDifficulty': total_difficulty / total_tasks if total_tasks > 0 else 0
    })

owner_metrics = df.groupby('Task Owner').apply(compute_metrics).reset_index()

print("Owner metrics sample:")
print(owner_metrics.head(20))
print("\\nDescriptive stats:")
print(owner_metrics.describe())
''')
