import pandas as pd
import numpy as np

# Load data
df = pd.read_csv('visitor_segment_raw.csv')
df['single_feature_use'] = df['distinct_features'] < 5
segment_single = df[df['single_feature_use']]
segment_normal = df[~df['single_feature_use']]

# Distribution of average_daily_minutes
print("Average daily minutes - descriptive stats:")
print("Single-feature-use:")
print(segment_single['average_daily_minutes'].describe())
print("\nNormal:")
print(segment_normal['average_daily_minutes'].describe())

# Difference of means test via permutation (approximate)
def permutation_test(x, y, n_perm=10000):
    observed = x.mean() - y.mean()
    pooled = np.concatenate([x, y])
    count = 0
    for _ in range(n_perm):
        np.random.shuffle(pooled)
        perm_diff = pooled[:len(x)].mean() - pooled[len(x):].mean()
        if perm_diff <= observed:
            count += 1
    p_val = count / n_perm
    return observed, p_val

obs_diff, p_val = permutation_test(segment_single['average_daily_minutes'].values, segment_normal['average_daily_minutes'].values, n_perm=5000)
print(f"\nPermutation test for average_daily_minutes difference:")
print(f"Observed difference (single - normal): {obs_diff:.3f}")
print(f"P-value (proportion of permutations <= observed): {p_val:.5f}")

# Correlation between distinct_features and average_daily_minutes
corr = df['distinct_features'].corr(df['average_daily_minutes'])
print(f"\nCorrelation between distinct_features and average_daily_minutes: {corr:.3f}")

# Check if single-feature-use users have higher or lower average_daily_events
print("\nAverage daily events:")
print(f"Single-feature-use mean: {segment_single['average_daily_events'].mean():.2f}")
print(f"Normal mean: {segment_normal['average_daily_events'].mean():.2f}")

# Examine proportion of users with high average_daily_minutes > 100
prop_high_single = (segment_single['average_daily_minutes'] > 100).mean()
prop_high_normal = (segment_normal['average_daily_minutes'] > 100).mean()
print(f"\nProportion of users with average_daily_minutes > 100:")
print(f"Single-feature-use: {prop_high_single:.2%}")
print(f"Normal: {prop_high_normal:.2%}")

# Also compute proportion of users with average_daily_minutes < 10
prop_low_single = (segment_single['average_daily_minutes'] < 10).mean()
prop_low_normal = (segment_normal['average_daily_minutes'] < 10).mean()
print(f"\nProportion of users with average_daily_minutes < 10:")
print(f"Single-feature-use: {prop_low_single:.2%}")
print(f"Normal: {prop_low_normal:.2%}")

# Compute average distinct features per segment (redundant)
print(f"\nMean distinct features single: {segment_single['distinct_features'].mean():.1f}")
print(f"Mean distinct features normal: {segment_normal['distinct_features'].mean():.1f}")
```
