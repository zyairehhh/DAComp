import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
import os

# Load data
df_top = pd.read_csv('top_accounts_metrics.csv')

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette('husl')

# 1. Contact Density Ratio distribution
plt.figure(figsize=(10, 6))
plt.hist(df_top['contact_density_ratio'].clip(upper=500), bins=50, edgecolor='black', alpha=0.7)
plt.axvline(x=5, color='red', linestyle='--', linewidth=2, label='Benchmark (≥5)')
plt.xlabel('Contact Density Ratio (contacts per 1,000 employees)', fontsize=12)
plt.ylabel('Number of Accounts', fontsize=12)
plt.title('Distribution of Contact Density Ratio (Top 20% Accounts)', fontsize=14)
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('plot_cdr_distribution.png', dpi=300)
plt.close()

# 2. Decision‑Maker Ratio distribution
plt.figure(figsize=(10, 6))
# Exclude infinite values? Already zero because ratio is 0 if contact_count=0
plt.hist(df_top['decision_maker_ratio'].clip(upper=100), bins=20, edgecolor='black', alpha=0.7)
plt.axvline(x=15, color='red', linestyle='--', linewidth=2, label='Benchmark (≥15%)')
plt.xlabel('Decision‑Maker Ratio (%)', fontsize=12)
plt.ylabel('Number of Accounts', fontsize=12)
plt.title('Distribution of Decision‑Maker Ratio (Top 20% Accounts)', fontsize=14)
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('plot_dmr_distribution.png', dpi=300)
plt.close()

# 3. Departmental coverage across accounts
dept_cols = ['sales_flag', 'finance_flag', 'ops_flag', 'eng_flag', 'hr_flag']
dept_names = ['Sales', 'Finance', 'Operations', 'Engineering', 'HR']
coverage_pct = [df_top[col].mean() * 100 for col in dept_cols]

plt.figure(figsize=(8, 5))
bars = plt.bar(dept_names, coverage_pct, color='steelblue', edgecolor='black')
plt.xlabel('Department', fontsize=12)
plt.ylabel('% of Accounts with Contact', fontsize=12)
plt.title('Departmental Coverage Across Top 20% Accounts', fontsize=14)
plt.ylim(0, 100)
# Add value labels
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 1,
             f'{height:.1f}%', ha='center', va='bottom', fontsize=10)
plt.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('plot_dept_coverage.png', dpi=300)
plt.close()

# 4. Risk distribution: uniform vs industry‑adjusted
# Need to compute industry‑adjusted risk; we'll replicate Stage1 logic.
# For each account, compare with industry median (or size median).
# Let's compute industry medians from df_top
industry_medians = df_top.groupby('industry_normalized').agg({
    'contact_density_ratio': 'median',
    'decision_maker_ratio': 'median',
    'dept_coverage': 'median'
}).reset_index()
industry_medians.columns = ['industry_normalized', 'cdr_median', 'dmr_median', 'cov_median']

# Merge back
df_risk = df_top.merge(industry_medians, on='industry_normalized', how='left')

# If industry median missing, use overall median
overall_cdr_median = df_top['contact_density_ratio'].median()
overall_dmr_median = df_top['decision_maker_ratio'].median()
overall_cov_median = df_top['dept_coverage'].median()

df_risk['cdr_median'] = df_risk['cdr_median'].fillna(overall_cdr_median)
df_risk['dmr_median'] = df_risk['dmr_median'].fillna(overall_dmr_median)
df_risk['cov_median'] = df_risk['cov_median'].fillna(overall_cov_median)

# Uniform risk: benchmark 5, 15, 100
df_risk['risk_uniform_cdr'] = df_risk['contact_density_ratio'] < 5
df_risk['risk_uniform_dmr'] = df_risk['decision_maker_ratio'] < 15
df_risk['risk_uniform_cov'] = df_risk['dept_coverage'] < 100
df_risk['uniform_risk_count'] = df_risk[['risk_uniform_cdr', 'risk_uniform_dmr', 'risk_uniform_cov']].sum(axis=1)

# Adjusted risk: below industry median
df_risk['risk_adj_cdr'] = df_risk['contact_density_ratio'] < df_risk['cdr_median']
df_risk['risk_adj_dmr'] = df_risk['decision_maker_ratio'] < df_risk['dmr_median']
df_risk['risk_adj_cov'] = df_risk['dept_coverage'] < df_risk['cov_median']
df_risk['adj_risk_count'] = df_risk[['risk_adj_cdr', 'risk_adj_dmr', 'risk_adj_cov']].sum(axis=1)

# Count accounts per risk level
uniform_counts = df_risk['uniform_risk_count'].value_counts().sort_index()
adj_counts = df_risk['adj_risk_count'].value_counts().sort_index()

# Align indices 0–3
for i in range(4):
    if i not in uniform_counts:
        uniform_counts[i] = 0
    if i not in adj_counts:
        adj_counts[i] = 0
uniform_counts = uniform_counts.sort_index()
adj_counts = adj_counts.sort_index()

x = np.arange(4)  # 0‑3 risks
width = 0.35

plt.figure(figsize=(10, 6))
plt.bar(x - width/2, uniform_counts.values, width, label='Uniform Benchmarks', color='coral', edgecolor='black')
plt.bar(x + width/2, adj_counts.values, width, label='Industry‑Adjusted Benchmarks', color='lightseagreen', edgecolor='black')
plt.xlabel('Number of Risk Flags (out of 3)', fontsize=12)
plt.ylabel('Number of Accounts', fontsize=12)
plt.title('Risk Distribution: Uniform vs Industry‑Adjusted Benchmarks', fontsize=14)
plt.xticks(x, ['0', '1', '2', '3'])
plt.legend()
plt.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('plot_risk_comparison.png', dpi=300)
plt.close()

print("Plots saved.")
```
