'''
import pandas as pd
import numpy as np
import os

# Load cleaned data
script_dir = os.path.dirname(os.path.abspath(__file__))
csv_path = os.path.join(script_dir, 'cleaned_data.csv')
print("Loading from:", csv_path)
df = pd.read_csv(csv_path)
print("Data shape:", df.shape)
print("Columns:", df.columns.tolist())

# Residual ratio = Price_yuan / NewCarPrice_cleaned ? Already computed.
# Examine top models with at least 5 listings
model_stats = df.groupby('Model').agg(
    Count=('ResidualRatio', 'size'),
    AvgResidualRatio=('ResidualRatio', 'mean'),
    MedianResidualRatio=('ResidualRatio', 'median'),
    AvgMileage_km=('Mileage_km', 'mean'),
    AvgAge_years=('Age_years', 'mean')
).reset_index()
model_stats['TotalPrice'] = model_stats['Count'] * model_stats['AvgResidualRatio']
significant = model_stats[model_stats['Count'] >= 5]
significant = significant.sort_values('AvgResidualRatio', ascending=False)

print("\nTop 15 models with at least 5 listings by residual ratio:")
print(significant.head(15).to_string())

# Residual ratio by vehicle class and fuel type (with >=5 samples)
if 'Vehicle Class' in df.columns and 'Fuel Type' in df.columns:
    class_fuel = df.groupby(['Vehicle Class','Fuel Type']).agg(
        Count=('ResidualRatio','size'),
        AvgResidualRatio=('ResidualRatio','mean'),
        AvgAge=('Age_years','mean'),
        AvgMileage=('Mileage_km','mean')
    ).reset_index()
    class_fuel = class_fuel.sort_values('AvgResidualRatio', ascending=False)
    print("\nTop combinations of Vehicle Class and Fuel Type by residual ratio, min samples >=5:")
    class_fuel = class_fuel[class_fuel['Count'] >= 5]
    print(class_fuel.to_string())

# Examine outliers: which models have low residual ratio (<0.5) with relatively low age? potential bargains?
bargain_candidates = df[(df['ResidualRatio'] < 0.5) & (df['Age_years'] < 2)]
