ORDER BY region, date_day;
"""
df_decay = pd.read_sql_query(query2, conn)

# Convert date_day to datetime
df_decay['date_day'] = pd.to_datetime(df_decay['date_day'])
# Smooth with rolling average
df_decay['conversion_smooth'] = df_decay.groupby('region')['avg_conversion_rate'].transform(lambda x: x.rolling(window=7, min_periods=1).mean())

plt.figure(figsize=(12,6))
for region in df_decay['region'].unique():
    subset = df_decay[df_decay['region'] == region]
    plt.plot(subset['date_day'], subset['conversion_smooth'], label=region, linewidth=2)
plt.xlabel('Date')
plt.ylabel('Smoothed Conversion Rate (7-day moving average)')
plt.title('User Acquisition Cost-Efficiency Decay Trend (Smoothed)')
plt.legend(title='Region')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('conversion_decay_smoothed.png')
plt.close()

# Non-linear relationship: conversion rate vs crash rate
query3 = """
SELECT 
    c.region,
    t.crash_rate_per_1k,
    c.store_listing_conversion_rate
FROM google_play__country_report c
JOIN google_play__time_series_trends t
    ON c.date_day = t.date_day AND c.package_name = t.package_name
LIMIT 10000;
"""
df_crash = pd.read_sql_query(query3, conn)

plt.figure(figsize=(10,6))
scatter = plt.scatter(df_crash['crash_rate_per_1k'], df_crash['store_listing_conversion_rate'], c=pd.factorize(df_crash['region'])[0], cmap='Set2', alpha=0.6)
plt.xlabel('Crash Rate per 1k')
plt.ylabel('Store Listing Conversion Rate')
plt.title('Impact of Crash Rate on Conversion Rate')
plt.colorbar(scatter).set_label('Region (coded)')
# Add trend line
z = np.polyfit(df_crash['crash_rate_per_1k'], df_crash['store_listing_conversion_rate'], 2)
p = np.poly1d(z)
x_sorted = np.sort(df_crash['crash_rate_per_1k'])
plt.plot(x_sorted, p(x_sorted), 'k--', label='quadratic fit')
plt.legend()
plt.tight_layout()
plt.savefig('conversion_vs_crash.png')
plt.close()

conn.close()
print("Additional plots saved.")
''')
