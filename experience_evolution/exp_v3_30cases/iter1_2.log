import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
# Use default English font, no SimHei
# matplotlib.rcParams['font.sans-serif'] = ['DejaVu Sans'] # optional
# matplotlib.rcParams['axes.unicode_minus'] = False

# Load stage metrics
df = pd.read_csv('stage_metrics.csv')
print(df)

# Compute pass_rate and attrition_rate
def compute_pass_rate(row):
    if row['stage'] == 'Hired':
        # All hires passed this stage
        return 1.0
    else:
        return row['advanced_count'] / row['total_entries']

df['pass_rate'] = df.apply(compute_pass_rate, axis=1)
df['attrition_rate'] = 1 - df['pass_rate']

# Compute efficiency index = pass_rate / avg_days * 100
df['efficiency_index'] = df['pass_rate'] / df['avg_days'] * 100

# Identify bottleneck stages: avg_days > 25 and attrition_rate > 0.4
df['is_bottleneck'] = (df['avg_days'] > 25) & (df['attrition_rate'] > 0.4)
# Stages with efficiency index < 1.5
df['low_efficiency'] = df['efficiency_index'] < 1.5

print("\nStage metrics with derived columns:")
print(df[['stage', 'total_entries', 'avg_days', 'attrition_rate', 'efficiency_index', 'is_bottleneck', 'low_efficiency']])

# Save enriched metrics for reference
df.to_csv('stage_metrics_enriched.csv', index=False)

# Plot 1: Average Days per Stage
plt.figure(figsize=(10, 6))
bars = plt.bar(df['stage'], df['avg_days'], color='skyblue')
plt.axhline(y=25, color='r', linestyle='--', label='Threshold (25 days)')
plt.xlabel('Stage')
plt.ylabel('Average Days')
plt.title('Average Days Spent per Hiring Stage')
plt.xticks(rotation=45, ha='right')
# Annotate values
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.5,
             f'{height:.1f}', ha='center', va='bottom')
plt.legend()
plt.tight_layout()
plt.savefig('avg_days_per_stage.png', dpi=300)
plt.close()

# Plot 2: Attrition Rate per Stage
plt.figure(figsize=(10, 6))
bars = plt.bar(df['stage'], df['attrition_rate'], color='lightcoral')
plt.axhline(y=0.4, color='r', linestyle='--', label='Threshold (40%)')
plt.xlabel('Stage')
plt.ylabel('Attrition Rate')
plt.title('Attrition Rate per Hiring Stage')
plt.xticks(rotation=45, ha='right')
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.005,
             f'{height:.2f}', ha='center', va='bottom')
plt.legend()
plt.tight_layout()
plt.savefig('attrition_rate_per_stage.png', dpi=300)
plt.close()

# Plot 3: Efficiency Index per Stage (bar with threshold)
plt.figure(figsize=(10, 6))
bars = plt.bar(df['stage'], df['efficiency_index'], color='lightgreen')
plt.axhline(y=1.5, color='r', linestyle='--', label='Threshold (1.5)')
plt.xlabel('Stage')
plt.ylabel('Efficiency Index')
plt.title('Efficiency Index per Hiring Stage (Pass Rate / Avg Days * 100)')
plt.xticks(rotation=45, ha='right')
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.5,
             f'{height:.2f}', ha='center', va='bottom')
plt.legend()
plt.tight_layout()
plt.savefig('efficiency_index_per_stage.png', dpi=300)
plt.close()

# Plot 4: Combined scatter plot of avg_days vs attrition_rate, colored by efficiency index
plt.figure(figsize=(10, 8))
scatter = plt.scatter(df['avg_days'], df['attrition_rate'], c=df['efficiency_index'], cmap='viridis', s=200, alpha=0.7)
plt.colorbar(scatter, label='Efficiency Index')
# Annotate stage names
for i, row in df.iterrows():
    plt.annotate(row['stage'], (row['avg_days'], row['attrition_rate']), 
                 textcoords="offset points", xytext=(0,10), ha='center', fontsize=9)
plt.axvline(x=25, color='r', linestyle='--', alpha=0.5)
plt.axhline(y=0.4, color='r', linestyle='--', alpha=0.5)
plt.xlabel('Average Days')
plt.ylabel('Attrition Rate')
plt.title('Bottleneck Identification: Avg Days vs Attrition Rate')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('bottleneck_scatter.png', dpi=300)
plt.close()

print("\nPlots saved as avg_days_per_stage.png, attrition_rate_per_stage.png, efficiency_index_per_stage.png, bottleneck_scatter.png")
```


