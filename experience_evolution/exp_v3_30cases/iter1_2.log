import sqlite3
import pandas as pd
import numpy as np

def main():
    conn = sqlite3.connect('dacomp-060.sqlite')
    query = '''
    SELECT 
        ad_group_id,
        ad_group_name,
        campaign_name,
        SUM(clicks) as clicks,
        SUM(impressions) as impressions,
        SUM(conversions) as conversions
    FROM google_ads__ad_group_report
    GROUP BY ad_group_id, ad_group_name, campaign_name
    '''
    df = pd.read_sql_query(query, conn)
    conn.close()
    
    # CTR and CVR
    df['ctr'] = df['clicks'] / df['impressions']
    df['cvr'] = df['conversions'] / df['clicks']
    df_valid = df.dropna(subset=['ctr', 'cvr']).copy()
    
    # Percentiles
    ctr_75 = df_valid['ctr'].quantile(0.75)
    cvr_25 = df_valid['cvr'].quantile(0.25)
    print(f'75th percentile of CTR: {ctr_75:.6f}')
    print(f'25th percentile of CVR: {cvr_25:.6f}')
    
    # Problematic groups
    mask = (df_valid['ctr'] > ctr_75) & (df_valid['cvr'] < cvr_25)
    problematic = df_valid[mask]
    print(f'Number of problematic ad groups: {len(problematic)}')
    
    if len(problematic) > 0:
        print('\nFirst 20 problematic ad groups:')
        print(problematic[['ad_group_id', 'ad_group_name', 'campaign_name', 'ctr', 'cvr']].head(20).to_string())
        print('\nAverage CTR of problematic groups:', problematic['ctr'].mean())
        print('Average CVR of problematic groups:', problematic['cvr'].mean())
        print('Overall average CTR:', df_valid['ctr'].mean())
        print('Overall average CVR:', df_valid['cvr'].mean())
        
        # Intent Match Ratio (Actual CVR / Expected CVR)
        # Expected CVR = average of all ad groups (or maybe per campaign). Use overall average.
        problematic['intent_match_ratio'] = problematic['cvr'] / df_valid['cvr'].mean()
        print('\nIntent Match Ratio (Actual CVR / Overall Avg CVR) for problematic groups:')
        print(problematic[['ad_group_id', 'campaign_name', 'cvr', 'intent_match_ratio']].head(10).to_string())
        print('Mean intent_match_ratio:', problematic['intent_match_ratio'].mean())
        
        # Traffic quality: conversions per click (already CVR)
        # Additional quality metrics: maybe bounce rate? Not available.
        # We can compute conversion volume per impression as a proxy.
        problematic['conversions_per_impression'] = problematic['conversions'] / problematic['impressions']
        print('\nConversions per impression for problematic groups:')
        print(problematic[['ad_group_id', 'campaign_name', 'conversions_per_impression']].head(10).to_string())
        
        # Campaign distribution
        campaign_counts = problematic['campaign_name'].value_counts()
        print('\nTop campaigns among problematic groups:')
        print(campaign_counts.head(10))
    else:
        print('No problematic ad groups found.')
    
    # Save problematic groups to CSV
    problematic.to_csv('problematic_ad_groups_analysis.csv', index=False)
    print('\nProblematic ad groups saved to problematic_ad_groups_analysis.csv')

if __name__ == '__main__':
    main()
```
