Action: LOCAL_DB_SQL(file_path="dacomp-079.sqlite", command="WITH visitor_features AS ( SELECT v.visitor_id, v.sum_minutes, v.sum_events, CASE WHEN COUNT(DISTINCT vf.feature_id) < 5 AND v.count_active_days > 60 THEN 1 ELSE 0 END as is_segment FROM pendo__visitor v LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id GROUP BY v.visitor_id ) SELECT SUM(CASE WHEN is_segment = 1 THEN sum_minutes ELSE 0 END) * 1.0 / SUM(sum_minutes) as segment_minutes_share, SUM(CASE WHEN is_segment = 1 THEN sum_events ELSE 0 END) * 1.0 / SUM(sum_events) as segment_events_share FROM visitor_features", output="direct")
