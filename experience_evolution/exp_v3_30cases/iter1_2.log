import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-027.sqlite')

# Load tables
disaster_events = pd.read_sql_query("SELECT \"Disaster Event ID\", \"Disaster Type\", \"Disaster Level\" FROM disaster_events", conn)
environment_and_health = pd.read_sql_query("SELECT * FROM environment_and_health", conn)
beneficiaries = pd.read_sql_query("SELECT * FROM beneficiaries_and_assessments", conn)

# Merge
df = pd.merge(disaster_events, environment_and_health, left_on="Disaster Event ID", right_on="Disaster Reference ID", how="inner")
print("Columns in merged df:", df.columns.tolist())

# Ensure Disaster Level order
level_order = ["Level 1", "Level 2", "Level 3", "Level 4", "Level 5"]

# 1. Secondary Hazard Score per Level (simplified)
# Let's compute a composite score similar to Stage1: For each record, compute a normalized score
# We'll replicate the components as per report: Environmental Impact Rate, Waste Management Status,
# Disease Risk, Medical Emergency Response Capacity, Mental Health Assistance (categorical),
# Carbon Emissions (tons), Water Quality Index, Sanitation Coverage Rate, Vaccination Coverage Rate (numeric)
# We'll map categorical to numeric: High=3, Medium=2, Low=1 (for Environmental Impact, Disease Risk)
# Waste Management: Critical=3, Inadequate=2, Adequate=1
# Medical Emergency Response Capacity: Critical=3, Limited=2, Adequate=1
# Mental Health Assistance: Limited=2, Available=1 (maybe also other categories?)
# Let's examine unique values
print("Unique Environmental Impact Rate:", df["Environmental Impact Rate"].unique())
print("Unique Waste Management Status:", df["Waste Management Status"].unique())
print("Unique Disease Risk:", df["Disease Risk"].unique())
print("Unique Medical Emergency Response Capacity:", df["Medical Emergency Response Capacity"].unique())
print("Unique Mental Health Assistance:", df["Mental Health Assistance"].unique())

# Mapping
cat_mapping = {
    "Environmental Impact Rate": {"Low": 1, "Medium": 2, "High": 3},
    "Waste Management Status": {"Adequate": 1, "Inadequate": 2, "Critical": 3},
    "Disease Risk": {"Low": 1, "Medium": 2, "High": 3},
    "Medical Emergency Response Capacity": {"Adequate": 1, "Limited": 2, "Critical": 3},
    "Mental Health Assistance": {"Available": 1, "Limited": 2}
}

# Apply mappings
df["env_impact_score"] = df["Environmental Impact Rate"].map(cat_mapping["Environmental Impact Rate"])
df["waste_score"] = df["Waste Management Status"].map(cat_mapping["Waste Management Status"])
df["disease_score"] = df["Disease Risk"].map(cat_mapping["Disease Risk"])
df["medical_score"] = df["Medical Emergency Response Capacity"].map(cat_mapping["Medical Emergency Response Capacity"])
df["mental_score"] = df["Mental Health Assistance"].map(cat_mapping["Mental Health Assistance"])

# Normalize numeric columns to 0-1 scale (min-max) then scale to 1-3 maybe? But we can just sum after min-max.
numeric_cols = ["Carbon Emissions (tons)", "Water Quality Index", "Sanitation Coverage Rate", "Vaccination Coverage Rate"]
# For Water Quality Index, lower is worse; for Sanitation and Vaccination, lower is worse.
# We'll invert Water Quality so that higher score = worse.
# Let's compute normalized scores: (value - min) / (max - min) for each numeric column, then multiply by appropriate weight.
# However, we can simply compute mean per level for each component and plot bar charts.

# Compute mean per level for each component (categorical scores and numeric values)
level_means = df.groupby("Disaster Level")[["env_impact_score","waste_score","disease_score","medical_score","mental_score"]].mean().reindex(level_order)
# Compute mean numeric per level
numeric_means = df.groupby("Disaster Level")[numeric_cols].mean().reindex(level_order)

print("Categorical score means per level:")
print(level_means)
print("\nNumeric means per level:")
print(numeric_means)

# Plot 1: Secondary Hazard Score (composite) per level (as per stage1 table)
# We'll compute composite as sum of categorical scores + normalized numeric scores.
# For simplicity, we can use the same weights as Stage1? Not given. We'll compute a simple average of all normalized components.
# Normalize each component to 0-1 across entire dataset, then average.
all_scores = pd.concat([df[["env_impact_score","waste_score","disease_score","medical_score","mental_score"]], df[numeric_cols]], axis=1)
# Normalize numeric columns: (value - min)/(max - min)
for col in numeric_cols:
    min_val = all_scores[col].min()
    max_val = all_scores[col].max()
    all_scores[col + "_norm"] = (all_scores[col] - min_val) / (max_val - min_val)
# For Water Quality Index: lower is worse, we need to invert so higher score = worse.
# We'll compute (max - value)/(max - min) so that low water quality yields high score.
all_scores["Water Quality Index_norm"] = (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"]) / (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"].min())
# Replace previous normalized column
all_scores["Water Quality Index_norm"] = (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"]) / (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"].min())

# Now compute composite: average of all 9 components (5 categorical + 4 numeric)
categorical_component_cols = ["env_impact_score","waste_score","disease_score","medical_score","mental_score"]
numeric_norm_cols = [col + "_norm" for col in numeric_cols if col != "Water Quality Index"] + ["Water Quality Index_norm"]
all_scores["composite"] = all_scores[categorical_component_cols + numeric_norm_cols].mean(axis=1)

# Add Disaster Level to all_scores
all_scores["Disaster Level"] = df["Disaster Level"].values

# Compute mean composite per level
composite_by_level = all_scores.groupby("Disaster Level")["composite"].mean().reindex(level_order)
print("\nComposite secondary hazard score (mean) per level:")
print(composite_by_level)

# Plot bar chart
plt.figure(figsize=(8,5))
bars = plt.bar(composite_by_level.index, composite_by_level.values, color='skyblue')
plt.title('Secondary Hazard Score by Disaster Level', fontweight='bold')
plt.xlabel('Disaster Level')
plt.ylabel('Mean Composite Score (higher = worse)')
# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.01, f'{height:.2f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('secondary_hazard_by_level.png', dpi=300)
plt.close()

# Plot 2: People Impact Score
# We need to merge beneficiaries with disaster_events. There's no direct link. Let's see if there's a relation via Distribution reference ID or Action reference ID.
# However, beneficiaries_and_assessments table includes "Distribution reference ID" and "Action reference ID". 
# Could join with disaster_events via "Disaster Event ID"? Not obvious.
# Let's examine beneficiaries sample more.
print("\nBeneficiaries columns:", beneficiaries.columns.tolist())
