Action: CreateFile(filepath='/workspace/report_calc.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-001.sqlite')
company = pd.read_sql_query('SELECT "Enterprise Code", "Credit Rating", "Defaulted" FROM ch___company_info', conn)
sales = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax", "Buyer organization code" FROM ch___sales_invoices', conn)
inputs = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax", "Seller Organization Code" FROM ch___input_invoices', conn)
churn = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)

sales['Invoice Date'] = pd.to_datetime(sales['Invoice Date'])
inputs['Invoice Date'] = pd.to_datetime(inputs['Invoice Date'])

# Total sales per company
total_sales = sales.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_sales')
total_input = inputs.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_input')
profit = total_sales - total_input

# Profit stability: CV of annual profit
sales['year'] = sales['Invoice Date'].dt.year
inputs['year'] = inputs['Invoice Date'].dt.year
annual_sales = sales.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().rename('annual_sales')
annual_input = inputs.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().rename('annual_input')
annual = pd.concat([annual_sales, annual_input], axis=1).fillna(0)
annual['annual_profit'] = annual['annual_sales'] - annual['annual_input']

def cv(x):
    if len(x) > 1 and x.mean() != 0:
        return x.std() / x.mean()
    else:
        return np.nan
profit_cv = annual.groupby('Enterprise Code')['annual_profit'].apply(cv).rename('profit_cv')

# HHI
def hhi(group):
    total = group.sum()
    if total == 0:
        return np.nan
    share = group / total
    return (share ** 2).sum() * 10000

buyer_hhi = sales.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('buyer_hhi')
seller_hhi = inputs.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('seller_hhi')

# Merge
df = company.set_index('Enterprise Code').join(pd.concat([total_sales, total_input, profit, profit_cv, buyer_hhi, seller_hhi], axis=1), how='inner')
df = df.reset_index()
df['profit_cv'] = df['profit_cv'].fillna(0)
df['avg_hhi'] = (df['buyer_hhi'] + df['seller_hhi']) / 2

# Risk score
rating_map = {'A':1, 'B':2, 'C':3, 'D':4}
df['rating_score'] = df['Credit Rating'].map(rating_map)
df['default_score'] = df['Defaulted'].apply(lambda x: 1 if x=='Yes' else 0)
df['sales_percentile'] = df['total_sales'].rank(pct=True, ascending=False)
df['profit_cv_inv'] = 1 / (1 + df['profit_cv'].abs())
df['hhi_percentile'] = df['avg_hhi'].rank(pct=True, ascending=True)

weights = {'rating': 0.3, 'default': 0.2, 'sales': 0.2, 'cv': 0.15, 'hhi': 0.15}
df['risk_score'] = (
    df['rating_score'] * weights['rating'] +
    df['default_score'] * weights['default'] +
    (1 - df['sales_percentile']) * weights['sales'] +
    (1 - df['profit_cv_inv']) * weights['cv'] +
    df['hhi_percentile'] * weights['hhi']
)
df['risk_score_norm'] = (df['risk_score'] - df['risk_score'].min()) / (df['risk_score'].max() - df['risk_score'].min())

# Allocate credit
total_credit = 100_000_000
df['capacity_factor'] = df['total_sales'] / df['total_sales'].sum()
df['risk_adjustment'] = 1 - df['risk_score_norm']
df['raw_limit'] = df['capacity_factor'] * df['risk_adjustment']
df['credit_limit'] = df['raw_limit'] / df['raw_limit'].sum() * total_credit

# Interest rates based on rating with churn threshold 0.2
def assign_rate(rating):
    if rating == 'D':
        return 0.15
    col = f'Credit Rating {rating} Customer Churn Rate'
    # find rate where churn <=0.2 and maximize interest
    subset = churn[churn[col] <= 0.2]
    if not subset.empty:
        return subset['Annual Loan Interest Rate'].max()
    else:
        # fallback to min churn
        idx = churn[col].idxmin()
        return churn.loc[idx, 'Annual Loan Interest Rate']

df['interest_rate'] = df['Credit Rating'].apply(assign_rate)

# Churn at assigned rate
def get_churn(row):
    rating = row['Credit Rating']
    if rating == 'D':
        return 1.0
    col = f'Credit Rating {rating} Customer Churn Rate'
    rate = row['interest_rate']
    match = churn[churn['Annual Loan Interest Rate'] == rate]
    if not match.empty:
        return match.iloc[0][col]
    else:
        # nearest
        idx = (churn['Annual Loan Interest Rate'] - rate).abs().idxmin()
        return churn.loc[idx, col]

df['churn_rate'] = df.apply(get_churn, axis=1)

# Adjust credit limit by churn
df['credit_limit_adj'] = df['credit_limit'] * (1 - df['churn_rate'])
df['credit_limit_adj'] = df['credit_limit_adj'] / df['credit_limit_adj'].sum() * total_credit

# Summary by rating
summary = df.groupby('Credit Rating').agg(
    count=('Enterprise Code', 'count'),
    defaulted=('default_score', 'sum'),
    avg_total_sales=('total_sales', 'mean'),
    avg_profit_cv=('profit_cv', 'mean'),
    avg_avg_hhi=('avg_hhi', 'mean'),
    avg_risk_score=('risk_score_norm', 'mean'),
    interest_rate=('interest_rate', 'mean'),
    total_credit_original=('credit_limit', 'sum'),
    total_credit_adjusted=('credit_limit_adj', 'sum'),
    avg_churn_rate=('churn_rate', 'mean')
).reset_index()

print("Summary by Credit Rating:")
print(summary.to_string(index=False))

# Overall metrics
print(f"\nOverall total credit allocated: {df['credit_limit_adj'].sum():,.2f} RMB")
print(f"Overall average interest rate: {df['interest_rate'].mean():.4f}")
print(f"Expected loss due to churn: {(df['credit_limit_adj'] * df['churn_rate']).sum():,.2f} RMB")
print(f"Expected loss rate: {((df['credit_limit_adj'] * df['churn_rate']).sum() / df['credit_limit_adj'].sum()):.4f}")

# Write final report to Markdown
with open('stage1.md', 'w', encoding='utf-8') as f:
    f.write('# Credit Risk Analysis and Credit Allocation Plan\n\n')
    f.write('## 1. Data Overview\n')
    f.write(f'- Total enterprises with credit history: {len(df)}\n')
    f.write('- Distribution by credit rating:\n')
    for _, row in summary.iterrows():
        f.write(f'  - Rating {row["Credit Rating"]}: {row["count"]} enterprises, default rate {row["defaulted"]/row["count"]:.2%}\n')
    f.write('\n## 2. Risk Assessment Components\n')
    f.write('We constructed a composite risk score using five factors:\n')
    f.write('1. **Credit rating** (weight 30%): ordinal mapping A=1, B=2, C=3, D=4.\n')
    f.write('2. **Default history** (weight 20%): 1 if previously defaulted, else 0.\n')
    f.write('3. **Revenue capacity** (weight 20%): percentile rank of total sales (higher sales → lower risk).\n')
    f.write('4. **Profit stability** (weight 15%): coefficient of variation of annual profit (lower CV → lower risk).\n')
    f.write('5. **Upstream/downstream dependency** (weight 15%): average HHI of buyer and seller concentration (lower HHI → lower risk).\n')
    f.write('\n## 3. Allocation of Credit Limits\n')
    f.write(f'The bank’s total credit budget is **RMB 100 million**. Credit limits are allocated proportionally to each enterprise’s revenue capacity and inversely to its risk score.\n')
    f.write('**Allocation formula**:\n')
    f.write('```\n')
    f.write('Base capacity factor = enterprise total sales / sum of all sales\n')
    f.write('Risk adjustment = 1 – normalized risk score\n')
    f.write('Raw limit = capacity factor × risk adjustment\n')
    f.write('Credit limit = raw limit / sum(raw limits) × total budget\n')
    f.write('```\n')
    f.write('\n## 4. Interest Rate Setting Using Churn Data\n')
    f.write('The provided churn table shows how customer churn probability varies with loan interest rate for each credit rating.\n')
    f.write('We adopt a conservative policy: for each rating, we select the highest interest rate that keeps churn probability **below 20%**.\n')
    f.write('\nSelected rates and corresponding churn probabilities:\n')
    f.write('| Credit Rating | Interest Rate | Churn Rate |\n')
    f.write('| --- | --- | --- |\n')
    for rating in ['A','B','C','D']:
        sub = df[df['Credit Rating']==rating].iloc[0]
        f.write(f'| {rating} | {sub["interest_rate"]:.4f} | {sub["churn_rate"]:.4f} |\n')
    f.write('\n## 5. Adjusted Credit Limits for Expected Loss\n')
    f.write('To account for expected churn (interpreted as default probability), we further adjust credit limits by multiplying the initial limit by (1 – churn rate).\n')
    f.write('\n**Final allocation summary by rating:**\n')
    f.write(summary[['Credit Rating', 'count', 'total_credit_adjusted', 'interest_rate', 'avg_churn_rate']].to_markdown(index=False))
    f.write('\n\n## 6. Key Results\n')
    f.write(f'- **Total allocated credit**: RMB {df["credit_limit_adj"].sum():,.2f} (fully utilizes the budget).\n')
    f.write(f'- **Average interest rate**: {df["interest_rate"].mean():.4f}.\n')
    f.write(f'- **Expected credit loss due to churn**: RMB {(df["credit_limit_adj"] * df["churn_rate"]).sum():,.2f} ({((df["credit_limit_adj"] * df["churn_rate"]).sum() / df["credit_limit_adj"].sum()):.2%} of allocated credit).\n')
    f.write('\n## 7. Business Insights & Recommendations\n')
    f.write('1. **Rating D enterprises** have 100% default history; we assign them the highest interest rate (15%) and drastically reduce credit limits. However, given their default risk, the bank may consider excluding them from new credit.\n')
    f.write('2. **Rating A & B enterprises** exhibit low churn even at moderate interest rates (4.65%). They receive the bulk of credit because of large sales volumes and low risk scores.\n')
    f.write('3. **Profit stability and dependency concentration** are useful discriminators within each rating, enabling finer differentiation of risk.\n')
    f.write('4. The churn table indicates that raising interest rates above 5% sharply increases churn for all ratings, especially for A-rated customers. Hence, keeping rates below 5% helps retain high-quality customers.\n')
    f.write('5. The allocation plan ensures that the total credit exposed to high‑churn segments (C and D) is limited, thus protecting the bank’s overall portfolio quality.\n')
    f.write('\n---\n')
    f.write('*Report generated using quantitative analysis of enterprise credit, revenue, profit stability, and upstream/downstream dependency.*\n')

print("Report written to stage1.md")
''')
