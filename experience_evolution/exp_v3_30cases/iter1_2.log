'''
import pandas as pd
import numpy as np

df = pd.read_csv('visitor_segment_raw.csv')
df['single_feature_use'] = df['distinct_features'] < 5

def nps_category(rating):
    if rating >= 9:
        return 'promoter'
    elif rating >= 7:
        return 'passive'
    else:
        return 'detractor'

df['nps_category'] = df['latest_nps_rating'].apply(nps_category)

segment_single = df[df['single_feature_use']]
segment_normal = df[~df['single_feature_use']]

print("NPS category distribution:")
print("Single-feature-use:")
print(segment_single['nps_category'].value_counts(normalize=True).apply(lambda x: f"{x:.1%}"))
print("\nNormal:")
print(segment_normal['nps_category'].value_counts(normalize=True).apply(lambda x: f"{x:.1%}"))

# Compute NPS score
def nps_score(series):
    promoters = (series >= 9).sum()
    detractors = (series <= 6).sum()
    passives = ((series >= 7) & (series <= 8)).sum()
    total = len(series)
    return (promoters - detractors) / total * 100

nps_single = nps_score(segment_single['latest_nps_rating'])
nps_normal = nps_score(segment_normal['latest_nps_rating'])
print(f"\\nNPS score (promoters - detractors)/total * 100:")
print(f"Single-feature-use: {nps_single:.1f}")
print(f"Normal: {nps_normal:.1f}")
print(f"Difference: {nps_single - nps_normal:.1f}")
''')
