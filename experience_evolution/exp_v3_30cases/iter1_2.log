import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Rating counts from earlier
ratings = ['A', 'B', 'C', 'D']
counts = [27, 38, 34, 24]

# Churn rates at interest rate 4.65% (from table) and assumed for D
churn = {
    'A': 0.135727,
    'B': 0.135052,
    'C': 0.122099,
    'D': 0.30  # assumed, not in table
}
churn_rates = [churn[r] for r in ratings]

# Compute risk weight: inverse of churn (higher churn -> lower weight)
weights = [1 / (cr + 0.05) for cr in churn_rates]  # add small constant to avoid extreme values

# Weighted allocation per enterprise
weighted_counts = [w * c for w, c in zip(weights, counts)]
total_weight = sum(weighted_counts)
total_credit = 100_000_000  # 100 million RMB

# Allocation per rating = (weighted share) * total credit
allocation = [wc / total_weight * total_credit for wc in weighted_counts]

# Create DataFrame for display
df_allocation = pd.DataFrame({
    'Rating': ratings,
    'Number of Enterprises': counts,
    'Churn Rate': churn_rates,
    'Allocation (RMB)': allocation,
    'Allocation per Enterprise (RMB)': [a/c if c>0 else 0 for a,c in zip(allocation, counts)]
})
print(df_allocation)

# Plot allocation per rating
plt.figure(figsize=(8,5))
bars = plt.bar(df_allocation['Rating'], df_allocation['Allocation (RMB)'] / 1e6,
               color=['green','gold','orange','red'], edgecolor='black')
plt.xlabel('Credit Rating', fontsize=12)
plt.ylabel('Total Credit Limit (million RMB)', fontsize=12)
plt.title('Proposed Credit Limit Allocation by Rating\n(Total Portfolio: 100 million RMB)', fontsize=14)
for bar, alloc in zip(bars, allocation):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.1,
             f'{alloc/1e6:.2f}M', ha='center', va='bottom', fontsize=10)
plt.tight_layout()
plt.savefig('credit_allocation.png', dpi=300)
plt.close()

# Optionally, plot allocation per enterprise
plt.figure(figsize=(8,5))
bars2 = plt.bar(df_allocation['Rating'], df_allocation['Allocation per Enterprise (RMB)'] / 1e6,
                color=['green','gold','orange','red'], edgecolor='black')
plt.xlabel('Credit Rating', fontsize=12)
plt.ylabel('Average Credit per Enterprise (million RMB)', fontsize=12)
plt.title('Average Credit Limit per Enterprise by Rating', fontsize=14)
for bar, val in zip(bars2, df_allocation['Allocation per Enterprise (RMB)']):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.01,
             f'{val/1e6:.2f}M', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('credit_per_enterprise.png', dpi=300)
plt.close()
''')
