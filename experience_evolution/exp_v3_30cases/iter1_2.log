import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Read credit rating counts
df = pd.read_csv('credit_rating_counts.csv')
print(df)

# Bar chart
plt.figure(figsize=(8,5))
bars = plt.bar(df['Credit Rating'], df['count'], color='steelblue', edgecolor='black')
plt.xlabel('Credit Rating', fontsize=12)
plt.ylabel('Number of Enterprises', fontsize=12)
plt.title('Distribution of Credit Ratings (Credit History Enterprises)', fontsize=14)
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 1,
             f'{int(height)}', ha='center', va='bottom', fontsize=10)
plt.tight_layout()
plt.savefig('credit_rating_dist.png', dpi=300)
plt.close()
```')
