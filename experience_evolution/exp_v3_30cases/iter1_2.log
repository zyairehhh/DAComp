    'Anomaly': df[df['is_anomaly']][quarter_cols].mean().values,
    'Normal': df[~df['is_anomaly']][quarter_cols].mean().values
}).set_index('Quarter')

plt.figure(figsize=(8, 6))
sns.heatmap(heatmap_data, annot=True, fmt='.2f', cmap='YlOrRd', cbar_kws={'label': 'Average Transactions'})
plt.title('Average Quarterly Transactions: Anomaly vs Normal Customers')
plt.tight_layout()
plt.savefig('/workspace/quarterly_transactions_heatmap.png', dpi=100)
plt.close()

# 4. Transaction consistency vs volatility for anomalies
plt.figure(figsize=(10, 6))
plt.scatter(df['transaction_count'], df['avg_transactions_per_month'], 
            c=df['transaction_value_volatility'], s=50, alpha=0.6, cmap='viridis')
plt.colorbar(label='Transaction Value Volatility')
plt.xlabel('Transaction Count')
plt.ylabel('Average Transactions per Month')
plt.title('Transaction Behavior: Consistency vs Volatility')
plt.tight_layout()
plt.savefig('/workspace/transaction_consistency_volatility.png', dpi=100)
plt.close()

# 5. Create composite dimensions as per Stage1 report
# Transaction stability metric
df['transaction_stability'] = df['transaction_count'] / df['avg_transactions_per_month'].replace(0, 1)
df['transaction_stability'] = (df['transaction_stability'] - df['transaction_stability'].mean()) / df['transaction_stability'].std()

# Seasonal balance indicator (entropy)
def calculate_entropy(row):
    quarters = [row['q1_transactions'], row['q2_transactions'], row['q3_transactions'], row['q4_transactions']]
    total = sum(quarters)
    if total == 0:
        return 0
    probs = [q/total for q in quarters]
    entropy = -sum(p * np.log(p + 1e-10) for p in probs)
    return entropy / np.log(4)  # normalized to [0,1]

df['seasonal_entropy'] = df.apply(calculate_entropy, axis=1)

# Lifecycle stage (simplified based on tenure)
def assign_lifecycle(row):
    if row['customer_age_days'] < 365:
        return 'Acquisition'
    elif row['customer_age_days'] < 730:
        return 'Growth'
    elif row['customer_age_days'] < 1460:
        return 'Maturity'
    else:
        return 'Decline'

df['lifecycle_stage_derived'] = df.apply(assign_lifecycle, axis=1)

# 6. Parallel coordinates plot for behavioral clusters
from pandas.plotting import parallel_coordinates

# Perform k-means clustering on the three new dimensions
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

features = df[['transaction_stability', 'seasonal_entropy', 'transaction_value_volatility']].fillna(0)
scaler = StandardScaler()
scaled_features = scaler.fit_transform(features)

kmeans = KMeans(n_clusters=4, random_state=42)
df['behavior_cluster'] = kmeans.fit_predict(scaled_features)

# Prepare data for parallel coordinates
parallel_data = df[['behavior_cluster', 'transaction_stability', 'seasonal_entropy', 'transaction_value_volatility']].copy()
# Normalize for better visualization
for col in ['transaction_stability', 'seasonal_entropy', 'transaction_value_volatility']:
    parallel_data[col] = (parallel_data[col] - parallel_data[col].min()) / (parallel_data[col].max() - parallel_data[col].min())

plt.figure(figsize=(12, 6))
parallel_coordinates(parallel_data, 'behavior_cluster', colormap='viridis', alpha=0.5)
plt.title('Parallel Coordinates: Behavioral Clusters Based on New Dimensions')
plt.xlabel('Dimensions')
plt.ylabel('Normalized Value')
plt.xticks(rotation=45)
plt.legend(title='Cluster', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.tight_layout()
plt.savefig('/workspace/parallel_coordinates_clusters.png', dpi=100)
plt.close()

# 7. Bar chart: anomaly percentage by profitability segment
anomaly_by_segment = df.groupby('profitability_segment')['is_anomaly'].mean().reset_index()
anomaly_by_segment.columns = ['profitability_segment', 'anomaly_percentage']

plt.figure(figsize=(10, 6))
bars = plt.bar(anomaly_by_segment['profitability_segment'], anomaly_by_segment['anomaly_percentage'] * 100)
plt.title('Percentage of Anomaly Customers by Profitability Segment')
plt.xlabel('Profitability Segment')
plt.ylabel('Anomaly Percentage (%)')
plt.xticks(rotation=45)

# Add percentage labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.5,
             f'{height:.1f}%', ha='center', va='bottom')

plt.tight_layout()
plt.savefig('/workspace/anomaly_percentage_by_segment.png', dpi=100)
plt.close()

# 8. Decision tree feature importance visualization
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.model_selection import train_test_split

# Prepare features for decision tree
X = df[['transaction_stability', 'seasonal_entropy', 'transaction_value_volatility',
        'comprehensive_customer_score', 'total_revenue']].fillna(0)
y = df['is_anomaly']

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)

dt_classifier = DecisionTreeClassifier(max_depth=3, random_state=42)
dt_classifier.fit(X_train, y_train)

# Plot decision tree
plt.figure(figsize=(20, 10))
plot_tree(dt_classifier, feature_names=X.columns, class_names=['Normal', 'Anomaly'], 
          filled=True, rounded=True, fontsize=10)
plt.title('Decision Tree for Anomaly Classification')
plt.tight_layout()
plt.savefig('/workspace/decision_tree.png', dpi=150)
plt.close()

# Feature importance
feature_importance = pd.DataFrame({
    'feature': X.columns,
    'importance': dt_classifier.feature_importances_
}).sort_values('importance', ascending=False)

plt.figure(figsize=(10, 6))
plt.barh(feature_importance['feature'], feature_importance['importance'])
plt.title('Feature Importance for Predicting Anomaly Customers')
plt.xlabel('Importance')
plt.ylabel('Feature')
plt.gca().invert_yaxis()
plt.tight_layout()
plt.savefig('/workspace/feature_importance.png', dpi=100)
plt.close()

# Print summary statistics
print(f"Total customers: {len(df)}")
print(f"Anomaly customers (deviation > 0.15): {df['is_anomaly'].sum()} ({df['is_anomaly'].mean()*100:.1f}%)")
print("\nAnomaly distribution by profitability segment:")
print(df.groupby('profitability_segment')['is_anomaly'].agg(['sum', 'mean']).round(3))

print("\nAnomaly characteristics summary:")
anomaly_stats = df.groupby('is_anomaly').agg({
    'transaction_count': 'mean',
    'avg_transactions_per_month': 'mean',
    'transaction_value_volatility': 'mean',
    'comprehensive_customer_score': 'mean',
    'total_revenue': 'mean'
}).round(2)
print(anomaly_stats)

