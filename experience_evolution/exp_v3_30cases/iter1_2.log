import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-070.sqlite')
ts = pd.read_sql_query("SELECT * FROM google_play__time_series_trends", conn)
country = pd.read_sql_query("SELECT * FROM google_play__country_report", conn)
device = pd.read_sql_query("SELECT * FROM google_play__device_report", conn)
conn.close()

ts['date_day'] = pd.to_datetime(ts['date_day'])
country['date_day'] = pd.to_datetime(country['date_day'])
device['date_day'] = pd.to_datetime(device['date_day'])

# 1. Decay patterns: average conversion rate change per region over time
region_conv = country.groupby(['date_day', 'region', 'package_name'])['store_listing_conversion_rate'].mean().reset_index()
region_conv['month'] = region_conv['date_day'].dt.to_period('M')
monthly_region = region_conv.groupby(['region', 'month', 'package_name'])['store_listing_conversion_rate'].mean().reset_index()
# Compute change from first to last month for each region-package
first_month = monthly_region.groupby(['region', 'package_name'])['month'].min().reset_index()
last_month = monthly_region.groupby(['region', 'package_name'])['month'].max().reset_index()
first_values = pd.merge(monthly_region, first_month, on=['region', 'package_name', 'month'])
last_values = pd.merge(monthly_region, last_month, on=['region', 'package_name', 'month'])
change = pd.merge(first_values[['region', 'package_name', 'store_listing_conversion_rate']],
                  last_values[['region', 'package_name', 'store_listing_conversion_rate']],
                  on=['region', 'package_name'], suffixes=('_first', '_last'))
change['absolute_change'] = change['store_listing_conversion_rate_last'] - change['store_listing_conversion_rate_first']
change['pct_change'] = change['absolute_change'] / change['store_listing_conversion_rate_first'] * 100
print("Conversion Rate Change (First vs Last Month):")
print(change.head(20))

# 2. Device installs trends by brand
device['device_brand'] = device['device'].apply(lambda x: x.split()[0] if isinstance(x, str) else x)
device['month'] = device['date_day'].dt.to_period('M')
brand_monthly = device.groupby(['device_brand', 'month', 'package_name'])['install_events'].sum().reset_index()
# Compute growth rate for each brand-package
brand_monthly_sorted = brand_monthly.sort_values(['device_brand', 'package_name', 'month'])
brand_monthly_sorted['prev_installs'] = brand_monthly_sorted.groupby(['device_brand', 'package_name'])['install_events'].shift(1)
brand_monthly_sorted['monthly_growth'] = (brand_monthly_sorted['install_events'] - brand_monthly_sorted['prev_installs']) / brand_monthly_sorted['prev_installs'] * 100
avg_growth = brand_monthly_sorted.groupby(['device_brand', 'package_name'])['monthly_growth'].mean().reset_index()
print("\nAverage Monthly Install Growth by Device Brand:")
print(avg_growth.sort_values('monthly_growth'))

# 3. Revenue per active device by region
# Need revenue per region? Not available. Use time series revenue per package, allocate by region proportion of active devices? Use country active devices.
country_active = country.groupby(['date_day', 'region', 'package_name'])['active_devices_last_30_days'].sum().reset_index()
total_active = country_active.groupby(['date_day', 'package_name'])['active_devices_last_30_days'].sum().reset_index()
region_share = pd.merge(country_active, total_active, on=['date_day', 'package_name'], suffixes=('_region', '_total'))
region_share['share'] = region_share['active_devices_last_30_days_region'] / region_share['active_devices_last_30_days_total']
# Merge with revenue
ts_rev = ts[['date_day', 'package_name', 'daily_revenue']]
region_rev = pd.merge(region_share, ts_rev, on=['date_day', 'package_name'])
region_rev['region_revenue'] = region_rev['daily_revenue'] * region_rev['share']
region_rev['revenue_per_active_device'] = region_rev['region_revenue'] / region_rev['active_devices_last_30_days_region'].replace(0, np.nan)
# Average over time
avg_rev_per_device = region_rev.groupby(['region', 'package_name'])['revenue_per_active_device'].mean().reset_index()
print("\nAverage Revenue per Active Device by Region and Package:")
print(avg_rev_per_device.sort_values('revenue_per_active_device', ascending=False).head(20))

# 4. Update frequency effect: correlation between total_update_events and active_devices/rating
update_freq = device.groupby(['date_day', 'package_name'])['update_events'].sum().reset_index()
update_freq.rename(columns={'update_events': 'total_update_events'}, inplace=True)
country_agg = country.groupby(['date_day', 'package_name', 'region']).agg({
    'active_devices_last_30_days': 'sum',
    'rolling_total_average_rating': 'mean'
}).reset_index()
merged_update = country_agg.merge(update_freq, on=['date_day', 'package_name'], how='left')
# Compute correlation per region
corr_by_region = merged_update.groupby('region').apply(lambda df: df[['total_update_events', 'active_devices_last_30_days', 'rolling_total_average_rating']].corr().iloc[0,1:]).reset_index()
print("\nCorrelation between Update Events and Metrics per Region:")
print(corr_by_region)

# Save key tables to CSV for reporting
change.to_csv('conversion_change.csv', index=False)
avg_growth.to_csv('device_brand_growth.csv', index=False)
avg_rev_per_device.to_csv('revenue_per_device_region.csv', index=False)
corr_by_region.to_csv('update_correlation_region.csv', index=False)
```
