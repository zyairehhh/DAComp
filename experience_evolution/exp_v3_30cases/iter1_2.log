import sqlite3
import pandas as pd

conn = sqlite3.connect("dacomp-090.sqlite")
df = pd.read_sql_query("""
SELECT dashboard_month, collection_rate_percentage 
FROM quickbooks__financial_dashboard 
WHERE dashboard_month >= '2024-10-01'
ORDER BY dashboard_month
""", conn)
df['change'] = df['collection_rate_percentage'].diff()
print(df)
streaks = []
current_streak = 0
for change in df['change'][1:]:  # skip first NaN
    if change < 0:
        current_streak += 1
    else:
        if current_streak > 0:
            streaks.append(current_streak)
            current_streak = 0
if current_streak > 0:
    streaks.append(current_streak)
print("\nConsecutive months of deterioration lengths:", streaks)
print("Maximum consecutive months of deterioration:", max(streaks) if streaks else 0)
# compute magnitude of decline for each streak: sum of negative changes
neg_changes = df['change'][df['change'] < 0]
print("Total magnitude of decline (sum of negative changes):", neg_changes.sum())
print("Average negative change:", neg_changes.mean())
```
