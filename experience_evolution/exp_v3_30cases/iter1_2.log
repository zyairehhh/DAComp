companies['renewal_date'] = company_tags.apply(lambda x: get_tag(x, 'renewal_date'))
companies['renewal_window'] = company_tags.apply(lambda x: get_tag(x, 'renewal_window'))
companies['feature_adoption'] = company_tags.apply(lambda x: get_tag(x, 'feature_adoption'))
companies['sentiment_trend'] = company_tags.apply(lambda x: get_tag(x, 'sentiment_trend'))
companies['communication_cadence'] = company_tags.apply(lambda x: get_tag(x, 'communication_cadence'))
companies['success_manager'] = company_tags.apply(lambda x: get_tag(x, 'success_manager'))
companies['playbook'] = company_tags.apply(lambda x: get_tag(x, 'playbook'))
