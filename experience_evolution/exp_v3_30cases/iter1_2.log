            part = part[:-1]
        # normalize case and spaces
        part = part.lower().replace('  ', ' ')
        # synonyms mapping
        synonyms = {
            'five insurances': 'five social insurances',
            'high temperature allowance': 'high-temperature allowance',
            'double pay at the end of the year': 'double salary at the end of the year',
