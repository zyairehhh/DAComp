import pandas as pd

# Load data
drug_metrics = pd.read_csv('drug_risk_metrics.csv')
imported_jv = pd.read_csv('imported_jv_prioritized.csv')

# Top 10 overall risk
top10 = imported_jv.head(10)

# Compute proportion of drugs with supply alert (Inventory Alert Status > 0) per origin
# Actually we need to compute from original inventory data, but we can approximate from aggregated supply_risk_raw > 0
# Since supply_risk_raw is count of alert + non-normal, if >0 indicates at least one alert or non-normal status.
supply_risk_drugs = drug_metrics[drug_metrics['supply_risk_raw'] > 0]
supply_by_origin = supply_risk_drugs.groupby('Origin / Tier (Domestic/Imported/JV)').size()
total_by_origin = drug_metrics.groupby('Origin / Tier (Domestic/Imported/JV)').size()
supply_prop = (supply_by_origin / total_by_origin * 100).round(2)

# Quality risk: drugs with high quality risk (top quartile)
quality_threshold = drug_metrics['quality_risk_raw'].quantile(0.75)
high_quality_risk = drug_metrics[drug_metrics['quality_risk_raw'] >= quality_threshold]
high_quality_by_origin = high_quality_risk.groupby('Origin / Tier (Domestic/Imported/JV)').size()
quality_prop = (high_quality_by_origin / total_by_origin * 100).round(2)

# Backlog risk similarly
backlog_threshold = drug_metrics['backlog_risk_raw'].quantile(0.75)
high_backlog_risk = drug_metrics[drug_metrics['backlog_risk_raw'] >= backlog_threshold]
high_backlog_by_origin = high_backlog_risk.groupby('Origin / Tier (Domestic/Imported/JV)').size()
backlog_prop = (high_backlog_by_origin / total_by_origin * 100).round(2)

print("Proportion of drugs with supply risk (alert/non-normal) per origin:")
print(supply_prop)
print("\nProportion of drugs with high quality risk (top 25%) per origin:")
print(quality_prop)
print("\nProportion of drugs with high backlog risk (top 25%) per origin:")
print(backlog_prop)

# Identify drugs that are in top 25% of all three risks
combined_high = drug_metrics[
    (drug_metrics['quality_risk_raw'] >= quality_threshold) &
    (drug_metrics['backlog_risk_raw'] >= backlog_threshold) &
    (drug_metrics['supply_risk_raw'] > 0)
]
print(f"\nNumber of drugs with high risk across all three dimensions: {len(combined_high)}")
print("Breakdown by origin:")
print(combined_high['Origin / Tier (Domestic/Imported/JV)'].value_counts())

# For imported/JV drugs, list those with combined high risk
combined_high_imported_jv = combined_high[combined_high['Origin / Tier (Domestic/Imported/JV)'].isin(['Imported', 'Joint-venture'])]
print("\nImported/JV drugs with high risk across all three dimensions:")
print(combined_high_imported_jv[['Drug ID', 'Origin / Tier (Domestic/Imported/JV)', 'quality_risk_raw', 'backlog_risk_raw', 'supply_risk_raw']])

# Write summary to a text file for later inclusion in markdown
with open('risk_summary.txt', 'w') as f:
    f.write("=== Risk Analysis Summary ===\n")
    f.write(f"Total drugs analyzed: {len(drug_metrics)}\n")
    f.write(f"Domestic: {total_by_origin['Domestic']} drugs\n")
    f.write(f"Imported: {total_by_origin['Imported']} drugs\n")
    f.write(f"Joint-venture: {total_by_origin['Joint-venture']} drugs\n\n")
    f.write("Supply risk proportion (any alert/non-normal):\n")
    f.write(supply_prop.to_string() + "\n\n")
    f.write("High quality risk proportion (top 25%):\n")
    f.write(quality_prop.to_string() + "\n\n")
    f.write("High backlog risk proportion (top 25%):\n")
    f.write(backlog_prop.to_string() + "\n\n")
    f.write(f"Drugs with triple-high risk: {len(combined_high)}\n")
    f.write("Breakdown by origin:\n")
    f.write(combined_high['Origin / Tier (Domestic/Imported/JV)'].value_counts().to_string() + "\n\n")
    f.write("Imported/JV drugs with triple-high risk:\n")
    f.write(combined_high_imported_jv[['Drug ID', 'Origin / Tier (Domestic/Imported/JV)']].to_string(index=False))
