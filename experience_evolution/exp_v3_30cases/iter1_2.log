'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-057.sqlite')
# First, get max date in dataset
max_date_q = "SELECT MAX(date_day) AS max_date FROM google_ads__campaign_report"
max_date = pd.read_sql_query(max_date_q, conn).iloc[0,0]
print(f"Max date in campaign_report: {max_date}")
# Convert string to datetime
max_date = pd.to_datetime(max_date)

# Compute campaign age (days since first appearance)
campaign_age_q = """
SELECT 
    campaign_id,
    MIN(date_day) as first_date,
    MAX(date_day) as last_date,
    COUNT(DISTINCT date_day) as days_active
FROM google_ads__campaign_report
GROUP BY campaign_id;
"""
campaign_age = pd.read_sql_query(campaign_age_q, conn)
campaign_age['first_date'] = pd.to_datetime(campaign_age['first_date'])
campaign_age['last_date'] =pd.to_datetime(campaign_age['last_date'])
campaign_age['age_days'] = (max_date - campaign_age['first_date']).dt.days
print(f"Campaign age summary:")
print(campaign_age['age_days'].describe())

# Filter campaigns older than 120 days
old_campaigns = campaign_age[campaign_age['age_days'] > 120]
print(f"Number of campaigns >120 days: {len(old_campaigns)}")

# For each campaign, compute CAC and LTV/CAC for last 30 days and previous 30 days
# We need to join with customer_acquisition_analysis? Not directly.
# But we can compute CAC from campaign_report? Not available. So we need to join on date_day, account_id maybe?
# Let's examine join possibilities: both tables have account_id, date_day, advertising_channel_type.
# We can assume each campaign maps to a specific advertising_channel_type and account.

# For simplicity, I'll compute using customer_acquisition_analysis aggregated by campaign_lifecycle_stage and advertising_channel_type etc.
# That's more aligned with the multi-dimensional analysis asked.

# Let's get data from customer_acquisition_analysis
df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)
df['date_day'] = pd.to_datetime(df['date_day'])

# Determine most recent 30 days and previous 30 days
df_recent = df[df['date_day'] > (max_date - pd.Timedelta(days=30))]
df_prev = df[(df['date_day'] > (max_date - pd.Timedelta(days=60))) & (df['date_day'] <= (max_date - pd.Timedelta(days=30)))]

print(f"Recent rows: {len(df_recent)}, Previous rows: {len(df_prev)}")

# Compute average CAC and LTV/CAC ratio per dimension
dimensions = ['campaign_lifecycle_stage', 'advertising_channel_type', 'customer_maturity_stage', 'account_maturity_stage']
for dim in dimensions:
    if dim in df.columns:
        # recent
        recent_agg = df_recent.groupby(dim).agg(
            avg_cac=('customer_acquisition_cost', 'mean'),
            avg_ltv_cac=('ltv_cac_ratio', 'mean'),
            count=('customer_acquisition_cost', 'size')
        ).reset_index()
        prev_agg = df_prev.groupby(dim).agg(
            avg_cac=('customer_acquisition_cost', 'mean'),
            avg_ltv_cac=('ltv_cac_ratio', 'mean'),
            count=('customer_acquisition_cost', 'size')
        ).reset_index()
        # merge
        merged = pd.merge(recent_agg, prev_agg, on=dim, suffixes=('_recent', '_prev'))
        # compute growth and decline
        merged['cac_growth_pct'] = (merged['avg_cac_recent'] - merged['avg_cac_prev']) / merged['avg_cac_prev'] * 100
        merged['ltv_cac_decline_pct'] = (merged['avg_ltv_cac_prev'] - merged['avg_ltv_cac_recent']) / merged['avg_ltv_cac_prev'] * 100
        print(f"\\nDimension {dim}:")
        print(merged.head())

conn.close()
''')
