# merge
flow_with_name = flow_df.merge(campaign_id_to_name, on='last_touch_campaign_id', how='left')
print("Flow with name shape:", flow_with_name.shape)
print("Flow with name columns:", flow_with_name.columns.tolist())
print("Flow with name head:")
print(flow_with_name[['person_id', 'last_touch_campaign_id', 'campaign_name']])
# Earliest events
events_df['occurred_at'] = pd.to_datetime(events_df['occurred_at'])
earliest = events_df.groupby(['person_id', 'campaign_name'])['occurred_at'].min().reset_index()
earliest.rename(columns={'occurred_at':'first_event_at'}, inplace=True)
print("Earliest events shape:", earliest.shape)
print("Earliest events:")
print(earliest)
# Merge
flow_with_time = flow_with_name.merge(earliest, on=['person_id', 'campaign_name'], how='left')
print("Flow with time shape:", flow_with_time.shape)
print("Flow with time columns:", flow_with_time.columns.tolist())
print("Flow with time head:")
print(flow_with_time[['person_id', 'campaign_name', 'first_event_at']])
