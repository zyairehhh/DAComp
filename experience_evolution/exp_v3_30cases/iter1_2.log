import matplotlib.pyplot as plt

# Connect to database
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-076/stage1_env/dacomp-076.sqlite')
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
print("Data shape:", df.shape)
print(df.head())

# 1. Segment averages and anomalies
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'seg_avg_retention']
df = df.merge(segment_avg, on='profitability_segment')
df['retention_diff'] = abs(df['retention_probability'] - df['seg_avg_retention'])
anomaly = df[df['retention_diff'] > 0.15]
print(f"Number of anomaly customers: {len(anomaly)}")
print(anomaly[['customer_id', 'profitability_segment', 'retention_probability', 'seg_avg_retention', 'retention_diff']].head())

# 2. Analyze dimensions for anomaly customers
# Transactional behavior: consistency between transaction_count and avg_transactions_per_month
# Let's compute ratio: transaction_count / avg_transactions_per_month (if avg > 0)
df['trans_consistency_ratio'] = df['transaction_count'] / df['avg_transactions_per_month'].replace(0, np.nan)
# Transaction value volatility
# Seasonal patterns: balance across Q1-Q4
seasonal_cols = ['q1_transactions', 'q2_transactions', 'q3_transactions', 'q4_transactions']
df['total_seasonal'] = df[seasonal_cols].sum(axis=1)
for col in seasonal_cols:
    df[f'{col}_pct'] = df[col] / df['total_seasonal'].replace(0, np.nan)
# Value realization: alignment between comprehensive_customer_score and total_revenue
# We can compute correlation per segment? but for each customer, we can see if score high but revenue low.
# Create a binary flag for anomaly vs normal
df['is_anomaly'] = df['retention_diff'] > 0.15

# 3. Compare anomaly vs normal across dimensions
print("\n--- Comparison of means ---")
for col in ['transaction_count', 'avg_transactions_per_month', 'trans_consistency_ratio', 
            'transaction_value_volatility', 'total_revenue', 'comprehensive_customer_score']:
    if col in df.columns:
        norm = df.loc[~df['is_anomaly'], col].mean()
        anom = df.loc[df['is_anomaly'], col].mean()
        print(f"{col}: normal {norm:.2f}, anomaly {anom:.2f}, diff {anom - norm:.2f}")

# Seasonal distribution percentages
print("\n--- Seasonal percentages ---")
for col in seasonal_cols:
    pct_col = f'{col}_pct'
    norm = df.loc[~df['is_anomaly'], pct_col].mean()
    anom = df.loc[df['is_anomaly'], pct_col].mean()
    print(f"{col}: normal {norm:.3f}, anomaly {anom:.3f}, diff {anom - norm:.3f}")

# 4. Cluster analysis to identify new dimensions
# Use features: transaction_count, avg_transactions_per_month, transaction_value_volatility, q1-q4 percentages, total_revenue, comprehensive_customer_score
features = ['transaction_count', 'avg_transactions_per_month', 'transaction_value_volatility',
            'q1_transactions_pct', 'q2_transactions_pct', 'q3_transactions_pct', 'q4_transactions_pct',
            'total_revenue', 'comprehensive_customer_score']
X = df[features].fillna(0)
# Standardize
from sklearn.preprocessing import StandardScaler
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
# KMeans with 5 clusters (or use elbow method but simplified)
kmeans = KMeans(n_clusters=5, random_state=42, n_init=10)
df['cluster'] = kmeans.fit_predict(X_scaled)
# Analyze cluster composition wrt anomaly
cluster_summary = df.groupby('cluster').agg(
    count=('customer_id', 'size'),
    anomaly_rate=('is_anomaly', 'mean'),
    avg_retention=('retention_probability', 'mean')
).reset_index()
print("\n--- Clusters ---")
print(cluster_summary)
# Also show mean features per cluster
for feat in features:
    cluster_means = df.groupby('cluster')[feat].mean()
    print(f"\n{feat} per cluster:")
    print(cluster_means)

# 5. Decision tree to predict anomaly from features (interpretable)
tree = DecisionTreeClassifier(max_depth=4, random_state=42)
tree.fit(X.fillna(0), df['is_anomaly'])
tree_rules = export_text(tree, feature_names=features)
print("\n--- Decision tree rules for anomaly ---")
print(tree_rules)

# 6. Additional insights: segment-wise anomaly rates
segment_anomaly = df.groupby('profitability_segment').agg(
    total=('customer_id', 'size'),
    anomalies=('is_anomaly', 'sum'),
    anomaly_rate=('is_anomaly', 'mean')
).reset_index()
print("\n--- Anomaly rates per segment ---")
print(segment_anomaly)

# Save anomaly customers to CSV for further manual inspection
anomaly.to_csv('anomaly_customers.csv', index=False)
print("\nAnomaly customers saved to anomaly_customers.csv")

conn.close()
