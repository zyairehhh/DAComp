import sqlite3
import pandas as pd
import numpy as np
import re
from datetime import datetime, timedelta
import math

conn = sqlite3.connect('dacomp-100.sqlite')
companies = pd.read_sql_query("SELECT * FROM intercom__company_enhanced", conn)

def parse_tags(tag_str):
    if not isinstance(tag_str, str):
        return {}
    parts = tag_str.split('|')
    tags = {}
    for part in parts:
        if '=' in part:
            key, value = part.split('=', 1)
            tags[key] = value
    return tags

company_tags = companies['all_company_tags'].apply(parse_tags)
companies['renewal_date'] = pd.to_datetime(company_tags.apply(lambda x: x.get('renewal_date')), errors='coerce')
companies['renewal_window'] = company_tags.apply(lambda x: x.get('renewal_window'))
companies['sentiment_trend'] = company_tags.apply(lambda x: x.get('sentiment_trend'))
companies['feature_adoption'] = company_tags.apply(lambda x: x.get('feature_adoption'))
companies['contract_size'] = company_tags.apply(lambda x: x.get('contract_size'))
companies['industry'] = company_tags.apply(lambda x: x.get('industry'))
companies['health_score'] = pd.to_numeric(company_tags.apply(lambda x: x.get('health_score')), errors='coerce')
companies['expansion_signal'] = company_tags.apply(lambda x: x.get('expansion_signal'))

# Load conversations
conv = pd.read_sql_query("SELECT * FROM intercom__conversation_enhanced", conn)
conv['conv_created'] = pd.to_datetime(conv['conversation_created_at'])
conv['company_name'] = conv['all_contact_company_names']
company_name_to_id = dict(zip(companies['company_name'], companies['company_id']))
conv['company_id'] = conv['company_name'].map(company_name_to_id)

# Parse conversation sentiment
conv_tags = conv['all_conversation_tags'].apply(parse_tags)
conv['sentiment'] = conv_tags.apply(lambda x: x.get('sentiment', None))

# Load conversation metrics for resolution times and reopens
conv_metrics = pd.read_sql_query("SELECT conversation_id, time_to_last_close_minutes, count_reopens FROM intercom__conversation_metrics", conn)
conv = conv.merge(conv_metrics, on='conversation_id', how='left')
conv['time_to_last_close_minutes'] = pd.to_numeric(conv['time_to_last_close_minutes'], errors='coerce')
conv['count_reopens'] = pd.to_numeric(conv['count_reopens'], errors='coerce')

# Filter companies due within next 90 days
target_companies = companies[companies['renewal_window'] == 'inside_90_days'].copy()
target_companies['label'] = target_companies['sentiment_trend'].apply(lambda x: 1 if x == 'at-risk' else 0)

# Compute features for each target company
def compute_features(company_row):
    cid = company_row['company_id']
    renewal_date = company_row['renewal_date']
    if pd.isnull(renewal_date):
        return None
    start_date = renewal_date - timedelta(days=30)
    conv_company = conv[(conv['company_id'] == cid) &
                        (conv['conv_created'] >= start_date) &
                        (conv['conv_created'] <= renewal_date)]
    n_convs = len(conv_company)
    # Communication features
    avg_conversations = n_convs
    # Negative sentiment proportion
    negative_keywords = ['executive_focus', 'data_required', 'risk_mitigation', 'cautious_watch', 'escalation']
    conv_company['is_negative'] = conv_company['sentiment'].apply(lambda x: x in negative_keywords)
    neg_count = conv_company['is_negative'].sum()
    neg_prop = neg_count / n_convs if n_convs > 0 else 0
    # Support experience features
    avg_resolution_time = conv_company['time_to_last_close_minutes'].mean() if n_convs > 0 else np.nan
    reopened_count = (conv_company['count_reopens'] > 0).sum()
    reopen_prop = reopened_count / n_convs if n_convs > 0 else 0
    # Product value features
    feature_adoption_str = company_row['feature_adoption']
    coverage = np.nan
    if isinstance(feature_adoption_str, str):
        match = re.search(r'(\d+)%', feature_adoption_str)
        if match:
            coverage = float(match.group(1)) / 100.0  # convert to fraction
    # Time since last value milestone (not available), will skip
    time_since_milestone = np.nan
    return pd.Series({
        'company_id': cid,
        'avg_conversations_last30': avg_conversations,
        'neg_proportion': neg_prop,
        'avg_resolution_time_min': avg_resolution_time,
        'reopen_proportion': reopen_prop,
        'feature_adoption_coverage': coverage,
        'sentiment_trend': company_row['sentiment_trend'],
        'label': company_row['label'],
        'industry': company_row['industry'],
        'contract_size': company_row['contract_size']
    })

features_list = []
for idx, row in target_companies.iterrows():
    feats = compute_features(row)
    if feats is not None:
        features_list.append(feats)

features_df = pd.DataFrame(features_list)
print(f"Number of target companies with features: {len(features_df)}")
print(f"Label distribution: {features_df['label'].value_counts()}")

# Compute AUC for each numeric feature
def auc_for_feature(y_true, y_score):
    # y_true: 0/1, y_score: numeric, higher for positive class (higher risk)
    # sort by score descending
    sorted_idx = np.argsort(y_score)[::-1]
    y_true_sorted = y_true.iloc[sorted_idx]
    # compute number of positive and negative
    n_pos = (y_true_sorted == 1).sum()
    n_neg = (y_true_sorted == 0).sum()
    if n_pos == 0 or n_neg == 0:
        return np.nan
    # sum of ranks of positive samples
    ranks = np.arange(1, len(y_true_sorted) + 1)
    sum_ranks_pos = np.sum(ranks[y_true_sorted == 1])
    auc = (sum_ranks_pos - n_pos * (n_pos + 1) / 2) / (n_pos * n_neg)
    return auc

numeric_features = ['avg_conversations_last30', 'neg_proportion', 'avg_resolution_time_min', 'reopen_proportion', 'feature_adoption_coverage']
for feat in numeric_features:
    valid = features_df[[feat, 'label']].dropna()
    if len(valid) == 0:
        print(f"{feat}: No valid data")
        continue
    auc = auc_for_feature(valid['label'], valid[feat])
    print(f"{feat}: AUC = {auc:.3f}")

# Compute median split differences
for feat in numeric_features:
    df = features_df[[feat, 'label']].dropna()
    med = df[feat].median()
    high_risk = df[df[feat] > med]['label'].mean()
    low_risk = df[df[feat] <= med]['label'].mean()
    print(f"{feat}: Prop at-risk high vs low: high={high_risk:.3f}, low={low_risk:.3f}, diff={high_risk - low_risk:.3f}")

# Save features
features_df.to_csv('target_companies_features_labeled.csv', index=False)

# Now segmentation by industry and contract size
print("\n--- Segmentation by industry & contract size ---")
for ind in features_df['industry'].dropna().unique():
    for size in features_df['contract_size'].dropna().unique():
        sub = features_df[(features_df['industry'] == ind) & (features_df['contract_size'] == size)]
        if len(sub) > 10:
            neg_prop_mean = sub['neg_proportion'].mean()
            reopen_mean = sub['reopen_proportion'].mean()
            adopt_mean = sub['feature_adoption_coverage'].mean()
            print(f"{ind}, {size}: n={len(sub)}, neg_prop={neg_prop_mean:.3f}, reopen={reopen_mean:.3f}, adopt={adopt_mean:.3f}")
''')
