'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from datetime import datetime
import warnings
warnings.filterwarnings('ignore')

sns.set_style("whitegrid")
plt.rcParams.update({'font.size': 10})

# Load data
conn = sqlite3.connect('dacomp-070.sqlite')
package = 'com.studio.videostreaming'

# time series trends
df_trend = pd.read_sql_query(f"""
    SELECT * 
    FROM google_play__time_series_trends 
    WHERE package_name = '{package}'
    ORDER BY date_day
""", conn, parse_dates=['date_day'])

# country_report for region analysis
df_country = pd.read_sql_query(f"""
    SELECT * 
    FROM google_play__country_report 
    WHERE package_name = '{package}'
    ORDER BY date_day, region
""", conn, parse_dates=['date_day'])

# device_report for device type analysis
df_device = pd.read_sql_query(f"""
    SELECT * 
    FROM google_play__device_report 
    WHERE package_name = '{package}'
    ORDER BY date_day, device
""", conn, parse_dates=['date_day'])
conn.close()

print("Data loaded.")

# Merge country_report with time series for quality_score and crash_rate_per_1k
# Since quality_score and crash_rate are daily aggregates across all regions,
# we can join on date_day

# Aggregate country_report per day to get average conversion rate per region
df_country_agg = df_country.groupby(['date_day', 'region']).agg({
    'store_listing_conversion_rate': 'mean',
    'rolling_store_conversion_rate': 'mean',
    'active_devices_last_30_days': 'sum',
    'rolling_total_average_rating': 'mean',
    'update_events': 'sum',
    'store_listing_acquisitions': 'sum',
    'store_listing_visitors': 'sum'
}).reset_index()

# Merge with trend data
df_merged = pd.merge(df_country_agg, df_trend[['date_day', 'quality_score', 'crash_rate_per_1k', 'revenue_per_active_device', 'active_devices']], on='date_day', how='left')

# For device, we may also aggregate per day and device type
df_device_agg = df_device.groupby(['date_day', 'device']).agg({
    'active_devices_last_30_days': 'sum',
    'rolling_total_average_rating': 'mean',
    'update_events': 'sum',
    'device_installs': 'sum',
    'device_uninstalls': 'sum'
}).reset_index()

print("Data merged.")
''')
