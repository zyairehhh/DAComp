import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

# Connect to the database (file is in current directory)
conn = sqlite3.connect('dacomp-019.sqlite')

# Read tables
basic_df = pd.read_sql_query('SELECT * FROM basic_drug_information', conn)
inventory_df = pd.read_sql_query('SELECT * FROM inventory_management', conn)
pricing_df = pd.read_sql_query('SELECT * FROM pricing_system', conn)

# Examine columns
print("Basic columns:", basic_df.columns.tolist())
print("Inventory columns:", inventory_df.columns.tolist())

# Merge inventory with basic on Drug ID
merged_df = pd.merge(inventory_df, basic_df, left_on='Drug ID', right_on='Drug ID', how='inner')

# For each drug, compute aggregated metrics
# Group by Drug ID and Origin
drug_origin = basic_df[['Drug ID', 'Origin / Tier (Domestic/Imported/JV)']]
# Compute inventory aggregates per drug
agg_inventory = inventory_df.groupby('Drug ID').agg({
    'Qualified Quantity': 'sum',
    'Near-expiry Quantity': 'sum',
    'Expired Quantity': 'sum',
    'Quarantine Quantity': 'sum',
    'Damaged Quantity': 'sum',
    'Pest/Mold Damage Quantity': 'sum',
    'Rodent Contamination Quantity': 'sum',
    'Air Contamination Quantity': 'sum',
    'Temp/Humidity Excursion Record': 'sum',
    'Inventory Discrepancy Rate': 'mean',
    'Inventory Alert Status': lambda x: (x.isin(['Alert', 'Severe'])).sum(),
    'Inventory Status (Normal/Frozen/Scrapped)': lambda x: (x != 'Normal').sum()
}).reset_index()

# Merge with origin
drug_metrics = pd.merge(agg_inventory, drug_origin, on='Drug ID', how='left')

# Compute risk scores (simple weighted sum)
# Quality risk: sum of quantities that indicate quality issues (near-expiry, expired, quarantine, damaged, pest/mold, rodent, air contamination, temp/humidity)
drug_metrics['quality_risk_raw'] = (drug_metrics['Near-expiry Quantity'] + 
                                    drug_metrics['Expired Quantity'] +
                                    drug_metrics['Quarantine Quantity'] +
                                    drug_metrics['Damaged Quantity'] +
                                    drug_metrics['Pest/Mold Damage Quantity'] +
                                    drug_metrics['Rodent Contamination Quantity'] +
                                    drug_metrics['Air Contamination Quantity'] +
                                    drug_metrics['Temp/Humidity Excursion Record'])

# Inventory backlog risk: high qualified quantity maybe indicates overstock, but also high discrepancy rate?
# Let's compute backlog as qualified quantity * (inventory discrepancy rate) maybe.
drug_metrics['backlog_risk_raw'] = drug_metrics['Qualified Quantity'] * drug_metrics['Inventory Discrepancy Rate']

# Supply interruption risk: count of alert status (Alert+Severe) and count of non-normal inventory status
drug_metrics['supply_risk_raw'] = drug_metrics['Inventory Alert Status'] + drug_metrics['Inventory Status (Normal/Frozen/Scrapped)']

# Normalize each risk score by max to get 0-1 scale
for col in ['quality_risk_raw', 'backlog_risk_raw', 'supply_risk_raw']:
    max_val = drug_metrics[col].max()
    if max_val > 0:
        drug_metrics[col.replace('_raw', '_score')] = drug_metrics[col] / max_val
    else:
        drug_metrics[col.replace('_raw', '_score')] = 0

# Overall risk = weighted sum (equal weight)
weights = {'quality_weight': 0.4, 'backlog_weight': 0.3, 'supply_weight': 0.3}
drug_metrics['overall_risk_score'] = (
    weights['quality_weight'] * drug_metrics['quality_risk_score'] +
    weights['backlog_weight'] * drug_metrics['backlog_risk_score'] +
    weights['supply_weight'] * drug_metrics['supply_risk_score']
)

# Filter for imported and JV drugs
imported_jv = drug_metrics[drug_metrics['Origin / Tier (Domestic/Imported/JV)'].isin(['Imported', 'Joint-venture'])]

# Sort by overall risk score descending
prioritized = imported_jv.sort_values('overall_risk_score', ascending=False)

print("Top 20 drugs requiring prioritized supervision:")
print(prioritized[['Drug ID', 'Origin / Tier (Domestic/Imported/JV)', 'overall_risk_score', 'quality_risk_raw', 'backlog_risk_raw', 'supply_risk_raw']].head(20))

# Compute average risk scores per origin
avg_risk_by_origin = drug_metrics.groupby('Origin / Tier (Domestic/Imported/JV)')[['quality_risk_score', 'backlog_risk_score', 'supply_risk_score', 'overall_risk_score']].mean()
print("\nAverage risk scores by origin:")
print(avg_risk_by_origin)

# Additional insights: count of drugs with any quality issues, backlog issues, supply issues
# Define thresholds (maybe above zero)
quality_issue = drug_metrics['quality_risk_raw'] > 0
backlog_issue = drug_metrics['backlog_risk_raw'] > 0  # backlog_risk_raw could be >0
supply_issue = drug_metrics['supply_risk_raw'] > 0

print(f"\nDrugs with at least one quality issue: {quality_issue.sum()}")
print(f"Drugs with at least one backlog issue: {backlog_issue.sum()}")
print(f"Drugs with at least one supply issue: {supply_issue.sum()}")

# Save detailed results to CSV for reference
drug_metrics.to_csv('/workspace/drug_risk_metrics.csv', index=False)
prioritized.to_csv('/workspace/imported_jv_prioritized.csv', index=False)

conn.close()
