import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-076/stage1_env/dacomp-076.sqlite')
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)

# Segment averages
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'seg_avg_retention']
df = df.merge(segment_avg, on='profitability_segment')
df['retention_diff'] = df['retention_probability'] - df['seg_avg_retention']
df['abs_diff'] = abs(df['retention_diff'])
df['is_anomaly'] = df['abs_diff'] > 0.15

# 1. Segmentation effectiveness overview
print("=== SEGMENTATION EFFECTIVENESS ===")
print("Segment average retention probability:")
print(segment_avg.sort_values('seg_avg_retention', ascending=False))
print("\nAnomaly counts and rates per segment:")
seg_summary = df.groupby('profitability_segment').agg(
    total=('customer_id', 'size'),
    anomalies=('is_anomaly', 'sum'),
    anomaly_rate=('is_anomaly', 'mean'),
    avg_retention=('retention_probability', 'mean'),
    avg_abs_diff=('abs_diff', 'mean')
).reset_index()
print(seg_summary)

# 2. Characteristics of anomaly customers vs normal
print("\n=== CHARACTERISTICS OF ANOMALY CUSTOMERS ===")
numeric_cols = ['transaction_count', 'avg_transactions_per_month', 'transaction_value_volatility', 
                'total_revenue', 'comprehensive_customer_score', 'customer_age_days']
for col in numeric_cols:
    norm = df.loc[~df['is_anomaly'], col].mean()
    anom = df.loc[df['is_anomaly'], col].mean()
    diff = anom - norm
    pct = diff / norm * 100 if norm != 0 else np.nan
    print(f"{col}: normal {norm:.2f}, anomaly {anom:.2f}, diff {diff:.2f} ({pct:.1f}%)")

# 3. Transactional behavior consistency
df['trans_consistency_ratio'] = df['transaction_count'] / df['avg_transactions_per_month'].replace(0, np.nan)
print("\n--- Transaction consistency ratio ---")
print(f"Overall: mean {df['trans_consistency_ratio'].mean():.2f}, std {df['trans_consistency_ratio'].std():.2f}")
print(f"Normal: {df.loc[~df['is_anomaly'], 'trans_consistency_ratio'].mean():.2f}")
print(f"Anomaly: {df.loc[df['is_anomaly'], 'trans_consistency_ratio'].mean():.2f}")

# 4. Seasonal patterns
seasonal_cols = ['q1_transactions', 'q2_transactions', 'q3_transactions', 'q4_transactions']
df['total_seasonal'] = df[seasonal_cols].sum(axis=1)
for col in seasonal_cols:
    df[f'{col}_pct'] = df[col] / df['total_seasonal'].replace(0, np.nan)
print("\n--- Seasonal distribution (percentage) ---")
for col in seasonal_cols:
    pct_col = f'{col}_pct'
    norm = df.loc[~df['is_anomaly'], pct_col].mean()
    anom = df.loc[df['is_anomaly'], pct_col].mean()
    print(f"{col}: normal {norm:.3f}, anomaly {anom:.3f}, diff {anom - norm:.3f}")

# Concentration index: Herfindahl-Hirschman Index
df['seasonal_hhi'] = df[[f'{c}_pct' for c in seasonal_cols]].pow(2).sum(axis=1)
print(f"\nSeasonal concentration (HHI): normal {df.loc[~df['is_anomaly'], 'seasonal_hhi'].mean():.3f}, anomaly {df.loc[df['is_anomaly'], 'seasonal_hhi'].mean():.3f}")

# 5. Value realization path: alignment between comprehensive_customer_score and total_revenue
# Compute correlation per segment
print("\n=== VALUE REALIZATION ALIGNMENT ===")
for seg in df['profitability_segment'].unique():
    seg_df = df[df['profitability_segment'] == seg]
    corr = seg_df['comprehensive_customer_score'].corr(seg_df['total_revenue'])
    print(f"Segment {seg}: correlation = {corr:.3f}")
# Overall correlation
overall_corr = df['comprehensive_customer_score'].corr(df['total_revenue'])
print(f"Overall correlation: {overall_corr:.3f}")

# Compute alignment metric: deviation from expected revenue based on score
# Use linear regression within each segment to predict revenue from score, then compute residual
from scipy import stats
df['revenue_residual'] = np.nan
for seg in df['profitability_segment'].unique():
    seg_df = df[df['profitability_segment'] == seg]
    slope, intercept, r_value, p_value, std_err = stats.linregress(seg_df['comprehensive_customer_score'], seg_df['total_revenue'])
    df.loc[df['profitability_segment'] == seg, 'revenue_residual'] = df.loc[df['profitability_segment'] == seg, 'total_revenue'] - (slope * df.loc[df['profitability_segment'] == seg, 'comprehensive_customer_score'] + intercept)
print("Revenue residual (actual - predicted) mean:")
print(f"Normal: {df.loc[~df['is_anomaly'], 'revenue_residual'].mean():.2f}")
print(f"Anomaly: {df.loc[df['is_anomaly'], 'revenue_residual'].mean():.2f}")

# 6. Decision tree alternative: rule discovery using pivot tables
print("\n=== RULES FOR ANOMALY IDENTIFICATION ===")
# High level categories
cat_vars = ['value_tier', 'lifecycle_stage', 'activity_status', 'seasonal_preference', 'transaction_consistency', 'growth_potential', 'recommended_action', 'engagement_frequency']
for var in cat_vars:
    if var in df.columns:
        rates = df.groupby(var)['is_anomaly'].mean().sort_values(ascending=False)
        top = rates.head(3)
        print(f"{var}: highest anomaly rates -> {list(zip(top.index, top.values.round(3)))}")

# 7. Cluster-like segmentation using derived dimensions
# Create groups based on transaction stability, seasonal preference, and value alignment
df['trans_stability'] = pd.qcut(df['transaction_value_volatility'], q=3, labels=['low', 'medium', 'high'])
df['seasonal_balance'] = pd.qcut(df['seasonal_hhi'], q=3, labels=['concentrated', 'moderate', 'balanced'])
df['value_alignment'] = pd.qcut(df['revenue_residual'], q=3, labels=['underperforming', 'aligned', 'overperforming'])
print("\n=== Anomaly rates by derived dimensions ===")
for var in ['trans_stability', 'seasonal_balance', 'value_alignment']:
    rates = df.groupby(var)['is_anomaly'].mean()
    print(f"{var}: {rates.to_dict()}")

# 8. Recommendations: which dimensions could improve segmentation
print("\n=== DIMENSIONS FOR IMPROVED SEGMENTATION ===")
# Compare anomaly rates across combinations of existing segment and new dimensions
# Cross-tab profitability_segment with seasonal_balance
cross = pd.crosstab(df['profitability_segment'], df['seasonal_balance'], values=df['is_anomaly'], aggfunc='mean')
print("Anomaly rate by segment x seasonal balance:")
print(cross.round(3))

# Save detailed data for inspection
df.to_csv('detailed_customers.csv', index=False)
print("\nDetailed data saved to detailed_customers.csv")

conn.close()
```
