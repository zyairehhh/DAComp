import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Load data
df = pd.read_csv('data.csv')
# Ensure numeric columns are numeric
df['Budget Amount'] = pd.to_numeric(df['Budget Amount'], errors='coerce')
df['Actual Cost'] = pd.to_numeric(df['Actual Cost'], errors='coerce')
df['Team Size'] = pd.to_numeric(df['Team Size'], errors='coerce')
df['Customer Satisfaction'] = pd.to_numeric(df['Customer Satisfaction'], errors='coerce')
df['Cost Deviation'] = df['Budget Amount'] - df['Actual Cost']

# 1. Bar chart: Average Cost Deviation per Project Type
plt.figure(figsize=(8,5))
avg_dev = df.groupby('Project Type')['Cost Deviation'].mean().sort_values()
ax = avg_dev.plot(kind='bar', color='steelblue')
plt.title('Average Cost Deviation (Budget - Actual) by Project Type', fontsize=14)
plt.xlabel('Project Type')
plt.ylabel('Average Cost Deviation')
# Add value labels on bars
for i, v in enumerate(avg_dev):
    ax.text(i, v + 0.5, f'{v:.1f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('avg_deviation_by_type.png', dpi=300)
plt.close()

# 2. Box plot: Distribution of Cost Deviation per Project Type
plt.figure(figsize=(10,6))
df.boxplot(column='Cost Deviation', by='Project Type', grid=False)
plt.title('Distribution of Cost Deviation across Project Types', fontsize=14)
plt.suptitle('')
plt.xlabel('Project Type')
plt.ylabel('Cost Deviation')
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig('boxplot_deviation_by_type.png', dpi=300)
plt.close()

# 3. Scatter: Cost Deviation vs Team Size, colored by Risk Level
risk_color = {'Low Risk': 'green', 'Medium Risk': 'orange', 'High Risk': 'red'}
df['Risk Color'] = df['Risk Level'].map(risk_color)

plt.figure(figsize=(8,6))
for risk, color in risk_color.items():
    subset = df[df['Risk Level'] == risk]
    plt.scatter(subset['Team Size'], subset['Cost Deviation'], c=color, label=risk, alpha=0.7)
plt.title('Cost Deviation vs Team Size (colored by Risk Level)', fontsize=14)
plt.xlabel('Team Size')
plt.ylabel('Cost Deviation')
plt.legend(title='Risk Level')
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('scatter_dev_vs_team_risk.png', dpi=300)
plt.close()

# 4. Scatter: Cost Deviation vs Customer Satisfaction
plt.figure(figsize=(8,6))
plt.scatter(df['Customer Satisfaction'], df['Cost Deviation'], alpha=0.7)
plt.title('Cost Deviation vs Customer Satisfaction', fontsize=14)
plt.xlabel('Customer Satisfaction (rating)')
plt.ylabel('Cost Deviation')
plt.grid(alpha=0.3)
plt.tight_layout()

# Add trend line
z = np.polyfit(df['Customer Satisfaction'].dropna(), df['Cost Deviation'].dropna(), 1)
p = np.poly1d(z)
x_range = np.linspace(df['Customer Satisfaction'].min(), df['Customer Satisfaction'].max(), 100)
plt.plot(x_range, p(x_range), "r--", linewidth=2)
plt.savefig('scatter_dev_vs_satisfaction.png', dpi=300)
plt.close()

print("Plots generated.")
```
