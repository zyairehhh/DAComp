'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Create budget quartiles
df['Budget Quartile'] = pd.qcut(df['Budget Amount'], q=4, labels=['Q1 (lowest)', 'Q2', 'Q3', 'Q4 (highest)'])
quartile_stats = df.groupby('Budget Quartile')['Deviation'].mean().reset_index()

fig, ax = plt.subplots(figsize=(9, 6))
bars = ax.bar(quartile_stats['Budget Quartile'], quartile_stats['Deviation'],
              color=['lightblue', 'steelblue', 'darkblue', 'navy'], edgecolor='black')
ax.set_xlabel('Budget Quartile', fontsize=12)
ax.set_ylabel('Average Cost Deviation', fontsize=12)
ax.set_title('Average Cost Deviation by Budget Quartile', fontsize=14, pad=15)
ax.grid(True, alpha=0.3, axis='y')

for bar, val in zip(bars, quartile_stats['Deviation']):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2., height + 3,
            f'{val:.1f}', ha='center', va='bottom', fontsize=10, fontweight='bold')

# Add correlation annotation
corr = df['Budget Amount'].corr(df['Deviation'])
ax.text(0.05, 0.95, f'Correlation between Budget and Deviation = {corr:.3f}',
        transform=ax.transAxes, fontsize=11, verticalalignment='top',
        bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.8))

plt.tight_layout()
plt.savefig('deviation_by_budget_quartile.png', dpi=150)
print("Saved deviation_by_budget_quartile.png")
''')
