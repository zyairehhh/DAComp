Action: CreateFile(filepath='segmented_analysis.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-089.sqlite')
threshold = 79621808.0

top_accounts_query = f"""
SELECT account_id, annual_revenue, industry_normalized, account_size_segment, total_contacts, number_of_employees
FROM salesforce__customer_360_view
WHERE annual_revenue >= {threshold}
"""
top_accounts = pd.read_sql_query(top_accounts_query, conn)

# Compute contact density ratio (CDR)
top_accounts['contact_density_ratio'] = (top_accounts['total_contacts'] / top_accounts['number_of_employees']) * 1000

# Decision-maker ratio
dm_query = """
SELECT account_id,
       COUNT(*) as total_contacts_per_account,
       SUM(CASE WHEN title LIKE '%Chief%' THEN 1 ELSE 0 END) as chief_count
FROM salesforce__contact_enhanced
WHERE account_id IN (
    SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue >= ?
)
GROUP BY account_id
"""
dm_df = pd.read_sql_query(dm_query, conn, params=(threshold,))
top_accounts = top_accounts.merge(dm_df, on='account_id', how='left')
top_accounts['total_contacts_per_account'] = top_accounts['total_contacts_per_account'].fillna(0)
top_accounts['chief_count'] = top_accounts['chief_count'].fillna(0)
top_accounts['decision_maker_ratio'] = (top_accounts['chief_count'] / top_accounts['total_contacts_per_account'].replace(0, pd.NA)) * 100

# Department coverage (key depts: Sales, Finance, Operations, HR)
key_depts = ['Sales', 'Finance', 'Operations', 'HR']
dept_query = """
SELECT account_id, department
FROM salesforce__contact_enhanced
WHERE account_id IN (
    SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue >= ?
)
AND department IS NOT NULL
"""
dept_df = pd.read_sql_query(dept_query, conn, params=(threshold,))
dept_df = dept_df[dept_df['department'].isin(key_depts)]
coverage_df = dept_df.groupby('account_id')['department'].nunique().reset_index()
coverage_df.rename(columns={'department': 'key_dept_coverage'}, inplace=True)
top_accounts = top_accounts.merge(coverage_df, on='account_id', how='left')
top_accounts['key_dept_coverage'] = top_accounts['key_dept_coverage'].fillna(0)

# Segment by industry and size
segments = []
for industry in top_accounts['industry_normalized'].unique():
    for size in top_accounts['account_size_segment'].unique():
        subset = top_accounts[(top_accounts['industry_normalized']==industry) & (top_accounts['account_size_segment']==size)]
        if len(subset) == 0:
            continue
        # Compute metrics
        cdr_median = subset['contact_density_ratio'].median()
        cdr_p25 = subset['contact_density_ratio'].quantile(0.25)
        cdr_p75 = subset['contact_density_ratio'].quantile(0.75)
        dmr_median = subset['decision_maker_ratio'].median()
        dmr_p25 = subset['decision_maker_ratio'].quantile(0.25)
        dmr_p75 = subset['decision_maker_ratio'].quantile(0.75)
        coverage_median = subset['key_dept_coverage'].median()
        coverage_p25 = subset['key_dept_coverage'].quantile(0.25)
        coverage_p75 = subset['key_dept_coverage'].quantile(0.75)
        segments.append({
            'industry': industry,
            'size_segment': size,
            'count': len(subset),
            'cdr_median': cdr_median,
            'cdr_p25': cdr_p25,
            'cdr_p75': cdr_p75,
            'dmr_median': dmr_median,
            'dmr_p25': dmr_p25,
            'dmr_p75': dmr_p75,
            'coverage_median': coverage_median,
            'coverage_p25': coverage_p25,
            'coverage_p75': coverage_p75
        })

segments_df = pd.DataFrame(segments)
print("Segmented Metrics (Median and IQR):")
print(segments_df.to_string())

# Save to CSV
segments_df.to_csv('segmented_metrics.csv', index=False)
print("\nSaved to segmented_metrics.csv")

# Identify high-risk accounts using standard benchmarks
top_accounts['cdr_compliant'] = top_accounts['contact_density_ratio'] >= 5
top_accounts['cdr_compliant'] = top_accounts['cdr_compliant'].fillna(False)
top_accounts['dmr_compliant'] = top_accounts['decision_maker_ratio'] >= 15
top_accounts['dmr_compliant'] = top_accounts['dmr_compliant'].fillna(False)
top_accounts['coverage_compliant'] = top_accounts['key_dept_coverage'] == 4  # target all 4 departments
top_accounts['high_risk'] = ~(top_accounts['cdr_compliant'] & top_accounts['dmr_compliant'] & top_accounts['coverage_compliant'])

# How many high-risk per segment?
risk_segment = top_accounts.groupby(['industry_normalized','account_size_segment'])['high_risk'].agg(['count','sum']).reset_index()
risk_segment['risk_pct'] = risk_segment['sum'] / risk_segment['count'] * 100
print("\nHigh-risk accounts by segment:")
print(risk_segment.sort_values('risk_pct', ascending=False).to_string())

# Save top accounts with risk flag
top_accounts.to_csv('top_accounts_with_risk.csv', index=False)
print("\nTop accounts with risk flag saved to top_accounts_with_risk.csv")

conn.close()
''')
