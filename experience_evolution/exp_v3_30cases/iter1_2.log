import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re

conn = sqlite3.connect('dacomp-100.sqlite')
company_df = pd.read_sql_query("SELECT * FROM intercom__company_enhanced", conn)
metrics_df = pd.read_sql_query("SELECT * FROM intercom__company_metrics", conn)
conn.close()

def parse_tags(tag_string):
    tags = {}
    if isinstance(tag_string, str):
        parts = tag_string.split('|')
        for part in parts:
            if '=' in part:
                key, value = part.split('=', 1)
                tags[key.strip()] = value.strip()
    return tags

tag_records = company_df['all_company_tags'].apply(parse_tags)
tag_df = pd.DataFrame(tag_records.tolist())
company_df = pd.concat([company_df, tag_df], axis=1)

df = company_df.merge(metrics_df, on='company_id', how='left')

# Map sentiment score
sentiment_map = {
    'uplift': 2,
    'positive': 1,
    'stable': 0,
    'watch': -1,
    'at-risk': -2
}
df['sentiment_score'] = df['sentiment_trend'].map(sentiment_map)

# Focus on renewal window inside 90 days
df_renewal = df[df['renewal_window'] == 'inside_90_days'].copy()

# Group by industry
industry_sentiment = df_renewal.groupby('industry')['sentiment_score'].mean().sort_values(ascending=False)
print(industry_sentiment)

plt.figure(figsize=(10,6))
industry_sentiment.plot(kind='bar', color='skyblue', edgecolor='black')
plt.title('Average Sentiment Score by Industry (Renewal Window <90 days)')
plt.xlabel('Industry')
plt.ylabel('Average Sentiment Score (higher = better)')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('sentiment_by_industry.png', dpi=150)
print("Saved sentiment_by_industry.png")

# Also group by plan_name (contract size)
plan_sentiment = df_renewal.groupby('plan_name')['sentiment_score'].mean().sort_values()
print("\nSentiment by plan:")
print(plan_sentiment)

plt.figure(figsize=(8,5))
plan_sentiment.plot(kind='bar', color='lightgreen', edgecolor='black')
plt.title('Average Sentiment Score by Contract Size (Renewal Window <90 days)')
plt.xlabel('Plan (Contract Size)')
plt.ylabel('Average Sentiment Score')
plt.tight_layout()
plt.savefig('sentiment_by_plan.png', dpi=150)
print("Saved sentiment_by_plan.png")
```
