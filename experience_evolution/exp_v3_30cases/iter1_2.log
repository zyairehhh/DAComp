import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

# Connect to the database
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Analyze accounts receivable structure from balance sheet
balance_sheet_query = """
SELECT 
  account_type,
  account_sub_type,
  account_name,
  amount,
  converted_amount,
  calendar_date
FROM quickbooks__balance_sheet 
WHERE account_type = 'Accounts Receivable' 
  OR account_sub_type LIKE '%Receivable%'
  OR account_name LIKE '%Receivable%'
ORDER BY calendar_date DESC
"""

balance_df = pd.read_sql_query(balance_sheet_query, conn)

# Summarize accounts receivable by account type
if not balance_df.empty:
    ar_by_type = balance_df.groupby('account_sub_type')['amount'].sum().sort_values(ascending=False)
    ar_by_type = ar_by_type[ar_by_type > 0]  # Only positive amounts
    
    print("Accounts Receivable by Sub-type:")
    print(ar_by_type)
    
    # Visualization 1: Accounts receivable structure
    plt.figure(figsize=(12, 6))
    if len(ar_by_type) > 0:
        ar_by_type.plot(kind='bar', color='steelblue', alpha=0.7)
        plt.title('Accounts Receivable Structure by Account Sub-type')
        plt.xlabel('Account Sub-type')
        plt.ylabel('Total Amount')
        plt.grid(axis='y', alpha=0.3)
    else:
        plt.text(0.5, 0.5, 'No accounts receivable data available', 
                 ha='center', va='center', transform=plt.gca().transAxes)
    plt.tight_layout()
    plt.savefig('accounts_receivable_structure.png', dpi=300, bbox_inches='tight')
    plt.close()
else:
    print("No accounts receivable data found in balance sheet")

# 2. Analyze risk distribution based on customer characteristics
customer_risk_query = """
SELECT 
  ca.customer_id,
  pa.customer_margin_volatility,
  ca.payment_behavior,
  ca.credit_score,
  ca.risk_assessment,
  ca.days_since_last_invoice,
  ca.outstanding_balance,
  ca.payment_rate_percentage,
  pa.customer_gross_margin_pct,
  pa.customer_profit_growth_pct
FROM quickbooks__customer_analytics ca
LEFT JOIN quickbooks__profitability_analysis pa ON ca.customer_id = pa.customer_id
WHERE ca.customer_id IS NOT NULL 
  AND pa.customer_id IS NOT NULL
"""

risk_df = pd.read_sql_query(customer_risk_query, conn)

# Create a simple risk score based on multiple factors
# Higher risk score indicates higher risk
if not risk_df.empty:
    # Normalize and weight different risk factors
    risk_df = risk_df.copy()
    
    # Define risk weights (adjust based on business priorities)
    weights = {
        'volatility_weight': 0.3,
        'payment_behavior_weight': 0.25,
        'credit_score_weight': 0.2,
        'days_since_last_invoice_weight': 0.15,
        'outstanding_balance_weight': 0.1
    }
    
    # Normalize volatility (0-1 scale, higher = more volatile)
    risk_df['volatility_norm'] = (risk_df['customer_margin_volatility'] - 
                                   risk_df['customer_margin_volatility'].min()) / \
                                  (risk_df['customer_margin_volatility'].max() - 
                                   risk_df['customer_margin_volatility'].min())
    
    # Map payment behavior to numeric risk score (1=Excellent, 4=Poor)
    payment_map = {'Excellent': 1, 'Good': 2, 'Average': 3, 'Poor': 4}
    risk_df['payment_risk'] = risk_df['payment_behavior'].map(payment_map)
    risk_df['payment_risk_norm'] = (risk_df['payment_risk'] - 1) / 3  # Normalize to 0-1
    
    # Normalize days since last invoice (higher = higher risk)
    max_days = 365  # Assume max 1 year
    risk_df['days_risk_norm'] = risk_df['days_since_last_invoice'].clip(upper=max_days) / max_days
    
    # Normalize outstanding balance (higher = higher risk)
    risk_df['balance_risk_norm'] = (risk_df['outstanding_balance'] - 
                                     risk_df['outstanding_balance'].min()) / \
                                    (risk_df['outstanding_balance'].max() - 
                                     risk_df['outstanding_balance'].min())
    
    # Normalize credit score (lower = higher risk, inverted)
    risk_df['credit_risk_norm'] = 1 - ((risk_df['credit_score'] - 
                                        risk_df['credit_score'].min()) / 
                                       (risk_df['credit_score'].max() - 
                                        risk_df['credit_score'].min()))
    
    # Calculate composite risk score
    risk_df['composite_risk_score'] = (
        risk_df['volatility_norm'] * weights['volatility_weight'] +
        risk_df['payment_risk_norm'] * weights['payment_behavior_weight'] +
        risk_df['credit_risk_norm'] * weights['credit_score_weight'] +
        risk_df['days_risk_norm'] * weights['days_since_last_invoice_weight'] +
        risk_df['balance_risk_norm'] * weights['outstanding_balance_weight']
    )
    
    # Categorize risk levels
    risk_df['risk_level'] = pd.cut(risk_df['composite_risk_score'], 
                                   bins=[0, 0.25, 0.5, 0.75, 1], 
                                   labels=['Low', 'Medium', 'High', 'Critical'])
    
    # Summary statistics
    print(f"\nRisk Level Distribution (based on composite score):")
    print(risk_df['risk_level'].value_counts().sort_index())
    
    # Visualization 2: Risk level distribution
    plt.figure(figsize=(10, 6))
    risk_counts = risk_df['risk_level'].value_counts().sort_index()
    colors = ['green', 'yellow', 'orange', 'red']
    risk_counts.plot(kind='bar', color=colors, alpha=0.7)
    plt.title('Customer Risk Level Distribution')
    plt.xlabel('Risk Level')
    plt.ylabel('Number of Customers')
    plt.grid(axis='y', alpha=0.3)
    plt.savefig('customer_risk_distribution.png', dpi=300, bbox_inches='tight')
    plt.close()
    
    # Visualization 3: Risk score vs customer margin volatility
    plt.figure(figsize=(10, 6))
    plt.scatter(risk_df['customer_margin_volatility'], risk_df['composite_risk_score'], 
                c=risk_df['composite_risk_score'], cmap='RdYlGn_r', alpha=0.6)
    plt.colorbar(label='Risk Score')
    plt.xlabel('Customer Margin Volatility')
    plt.ylabel('Composite Risk Score')
    plt.title('Customer Margin Volatility vs Composite Risk Score')
    plt.grid(True, alpha=0.3)
    plt.savefig('volatility_vs_risk_score.png', dpi=300, bbox_inches='tight')
    plt.close()
    
    # Visualization 4: Risk by payment behavior
    payment_risk = risk_df.groupby('payment_behavior')['composite_risk_score'].mean().sort_index()
    plt.figure(figsize=(8, 6))
    payment_risk.plot(kind='bar', color='lightcoral', alpha=0.7)
    plt.title('Average Risk Score by Payment Behavior')
    plt.xlabel('Payment Behavior')
    plt.ylabel('Average Risk Score')
    plt.grid(axis='y', alpha=0.3)
    plt.tight_layout()
    plt.savefig('risk_by_payment_behavior.png', dpi=300, bbox_inches='tight')
    plt.close()
    
    # Calculate correlations between risk factors
    correlation_matrix = risk_df[['volatility_norm', 'payment_risk_norm', 
                                  'credit_risk_norm', 'days_risk_norm', 
                                  'balance_risk_norm', 'composite_risk_score']].corr()
    
    print(f"\nCorrelation Matrix of Risk Factors:")
    print(correlation_matrix)
    
    # Save the risk assessment data
    risk_df.to_csv('customer_risk_assessment.csv', index=False)
    print(f"\nRisk assessment data saved to 'customer_risk_assessment.csv'")

else:
    print("No customer risk data available")

conn.close()

print("\nRisk exposure analysis complete.")
```

