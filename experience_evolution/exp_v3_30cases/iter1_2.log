plt.xlabel('Credit Rating', fontsize=12)
plt.ylabel('Total Credit Limit (million RMB)', fontsize=12)
plt.title('Proposed Credit Limit Allocation by Rating\n(Total Portfolio: 100 million RMB)', fontsize=14)
for bar, alloc in zip(bars, allocation):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.1,
             f'{alloc/1e6:.2f}M', ha='center', va='bottom', fontsize=10)
plt.tight_layout()
plt.savefig('credit_allocation.png', dpi=300)
plt.close()

# Optionally, plot allocation per enterprise
plt.figure(figsize=(8,5))
bars2 = plt.bar(df_allocation['Rating'], df_allocation['Allocation per Enterprise (RMB)'] / 1e6,
                color=['green','gold','orange','red'], edgecolor='black')
plt.xlabel('Credit Rating', fontsize=12)
plt.ylabel('Average Credit per Enterprise (million RMB)', fontsize=12)
plt.title('Average Credit Limit per Enterprise by Rating', fontsize=14)
for bar, val in zip(bars2, df_allocation['Allocation per Enterprise (RMB)']):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.01,
             f'{val/1e6:.2f}M', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('credit_per_enterprise.png', dpi=300)
plt.close()
