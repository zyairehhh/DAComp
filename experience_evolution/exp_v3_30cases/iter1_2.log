'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

conn = sqlite3.connect('dacomp-066.sqlite')

query = """
SELECT 
    j.job_id,
    j.hiring_managers,
    j.departments,
    r.interview_rate,
    r.total_interviews,
    r.completed_interviews,
    r.avg_interview_score,
    j.count_total_interviews,
    j.count_completed_interviews,
    j.avg_job_rating,
    j.overall_conversion_rate,
    j.rating_completion_rate
FROM greenhouse__job_enhanced j
JOIN greenhouse__recruitment_performance r ON j.job_id = r.job_id
WHERE j.departments = 'Engineering'
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Clean hiring_managers: sometimes multiple separated by comma
df['hiring_manager_list'] = df['hiring_managers'].str.split(',')
df['num_hiring_managers'] = df['hiring_manager_list'].apply(lambda x: len(x) if isinstance(x, list) else 1)
# Use first hiring manager for grouping
df['primary_hiring_manager'] = df['hiring_manager_list'].apply(lambda x: x[0].strip() if isinstance(x, list) and len(x) > 0 else '')

# Compute interview completion rate (completed_interviews / total_interviews)
df['interview_completion_rate'] = df['completed_interviews'] / df['total_interviews'].replace(0, np.nan)

# Group by primary hiring manager and aggregate
hm_stats = df.groupby('primary_hiring_manager').agg(
    job_count=('job_id', 'count'),
    avg_interview_rate=('interview_rate', 'mean'),
    avg_interview_completion=('interview_completion_rate', 'mean'),
    avg_interview_score=('avg_interview_score', 'mean'),
    avg_rating_completion=('rating_completion_rate', 'mean'),
    total_interviews_sum=('total_interviews', 'sum')
).reset_index()
hm_stats = hm_stats[hm_stats['job_count'] >= 5]  # Only managers with at least 5 jobs

# Plot hiring manager performance
fig, axes = plt.subplots(2, 2, figsize=(12, 10))
axes = axes.flatten()

# 1. Interview Rate vs Number of Jobs
axes[0].scatter(hm_stats['job_count'], hm_stats['avg_interview_rate'], alpha=0.7)
axes[0].set_xlabel('Number of Jobs Managed')
axes[0].set_ylabel('Average Interview Conversion Rate (%)')
axes[0].set_title('Hiring Manager Experience (Job Count) vs Conversion Rate')
axes[0].grid(True, linestyle='--', alpha=0.5)

# 2. Interview Rate vs Interview Completion Rate
axes[1].scatter(hm_stats['avg_interview_completion'], hm_stats['avg_interview_rate'], alpha=0.7)
axes[1].set_xlabel('Average Interview Completion Rate')
axes[1].set_ylabel('Average Interview Conversion Rate (%)')
axes[1].set_title('Impact of Interview Completion on Conversion')
axes[1].grid(True, linestyle='--', alpha=0.5)

# 3. Interview Rate vs Average Interview Score
axes[2].scatter(hm_stats['avg_interview_score'], hm_stats['avg_interview_rate'], alpha=0.7)
axes[2].set_xlabel('Average Interview Score')
axes[2].set_ylabel('Average Interview Conversion Rate (%)')
axes[2].set_title('Interview Quality vs Conversion')
axes[2].grid(True, linestyle='--', alpha=0.5)

# 4. Interview Rate vs Rating Completion Rate
axes[3].scatter(hm_stats['avg_rating_completion'], hm_stats['avg_interview_rate'], alpha=0.7)
axes[3].set_xlabel('Average Rating Completion Rate')
axes[3].set_ylabel('Average Interview Conversion Rate (%)')
axes[3].set_title('Performance Rating Completion vs Conversion')
axes[3].grid(True, linestyle='--', alpha=0.5)

fig.suptitle('Engineering Department: Hiring Manager Impact Analysis')
plt.tight_layout()
plt.savefig('hiring_manager_impact.png')
plt.close()

# Identify lowest performing hiring managers
low_performers = hm_stats.sort_values('avg_interview_rate').head(5)
print("Lowest performing hiring managers (Engineering):")
print(low_performers[['primary_hiring_manager', 'job_count', 'avg_interview_rate']])

# Also compute correlation matrix
corr_cols = ['avg_interview_rate', 'job_count', 'avg_interview_completion', 'avg_interview_score', 'avg_rating_completion']
corr = hm_stats[corr_cols].corr()
plt.figure(figsize=(8,6))
sns.heatmap(corr, annot=True, cmap='coolwarm', center=0)
plt.title('Correlation of Factors with Interview Conversion Rate (Engineering)')
plt.tight_layout()
plt.savefig('correlation_matrix.png')
plt.close()

print("Analysis and plots saved.")
'''
