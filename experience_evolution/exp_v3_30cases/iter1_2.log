# Annotate findings from Stage1
ax.text(0.05, 0.95, 'Infrastructure & Software Development have highest deviations',
        transform=ax.transAxes, fontsize=11, verticalalignment='top',
        bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.8))

plt.tight_layout()
plt.savefig('deviation_by_type.png', dpi=150)
print("Saved deviation_by_type.png")
