import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-089.sqlite')
accounts = pd.read_sql_query("""
    SELECT account_id, account_name, annual_revenue, number_of_employees,
           total_contacts, industry_normalized, account_size_segment,
           company_size_category, geographic_region
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL AND number_of_employees > 0
""", conn)
threshold = accounts['annual_revenue'].quantile(0.8)
top = accounts[accounts['annual_revenue'] >= threshold].copy()
top_ids = top['account_id'].tolist()
placeholders = ','.join(['?'] * len(top_ids))
contacts = pd.read_sql_query(f"""
    SELECT account_id, contact_id, title, department
    FROM salesforce__contact_enhanced
    WHERE account_id IN ({placeholders})
""", conn, params=top_ids)

contacts['is_decision_maker'] = contacts['title'].fillna('').str.contains('Chief|VP|Vice President', case=False, na=False)
agg = contacts.groupby('account_id').agg(
    decision_makers=('is_decision_maker', 'sum'),
    total_contacts_agg=('contact_id', 'count'),
    departments=('department', lambda x: [d for d in x.dropna().unique() if d is not None])
).reset_index()
top = top.merge(agg, on='account_id', how='left')
top['decision_makers'] = top['decision_makers'].fillna(0)
top['total_contacts_agg'] = top['total_contacts_agg'].fillna(0)
key_departments = ['Sales', 'Finance', 'Operations', 'Engineering', 'HR']
def count_coverage(dept_list):
    if isinstance(dept_list, list):
        return sum(1 for dept in dept_list if dept in key_departments)
    return 0
top['covered'] = top['departments'].apply(count_coverage)
top['coverage_completeness'] = top['covered'] / len(key_departments) * 100

# Additional stats
print("=== Additional Statistics ===")
print(f"Total contacts in top accounts: {len(contacts)}")
print(f"Average contacts per account: {top['total_contacts_agg'].mean():.1f}")
print(f"Median contacts per account: {top['total_contacts_agg'].median():.1f}")
print(f"Accounts with zero contacts: {(top['total_contacts_agg'] == 0).sum()} ({(top['total_contacts_agg'] == 0).mean():.1%})")
print(f"Accounts with at least one decision-maker: {(top['decision_makers'] > 0).sum()} ({(top['decision_makers'] > 0).mean():.1%})")
print(f"Total decision-makers: {top['decision_makers'].sum()}")
# Count of accounts missing each key department
for dept in key_departments:
    has = top['departments'].apply(lambda lst: dept in lst if isinstance(lst, list) else False).sum()
    missing = len(top) - has
    print(f"Missing {dept}: {missing} accounts ({missing/len(top):.1%})")

# Revenue risk correlation
top['revenue_log'] = np.log(top['annual_revenue'])
print("\nCorrelation between revenue and contact density ratio: {:.3f}".format(top['revenue_log'].corr(top['contact_density_ratio'])))
print("Correlation between revenue and decision-maker ratio: {:.3f}".format(top['revenue_log'].corr(top['decision_maker_ratio'].fillna(0))))
print("Correlation between revenue and coverage completeness: {:.3f}".format(top['revenue_log'].corr(top['coverage_completeness'])))

# Industry risk summary
industry_summary = top.groupby('industry_normalized').agg(
    accounts=('account_id', 'count'),
    avg_density=('contact_density_ratio', 'mean'),
    avg_dm_ratio=('decision_maker_ratio', 'mean'),
    avg_coverage=('coverage_completeness', 'mean'),
    pct_high_risk=('total_contacts_agg', lambda x: (x == 0).mean())
).round(2)
print("\n=== Industry Summary (Top 5 by avg density) ===")
print(industry_summary.sort_values('avg_density', ascending=False).head())
conn.close()
```
