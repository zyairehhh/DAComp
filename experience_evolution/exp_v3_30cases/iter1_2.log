import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-089.sqlite')

# Load accounts with revenue
accounts = pd.read_sql_query("""
    SELECT account_id, account_name, annual_revenue, number_of_employees,
           total_contacts, industry_normalized, account_size_segment,
           company_size_category, geographic_region
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL
      AND number_of_employees > 0
""", conn)

threshold = accounts['annual_revenue'].quantile(0.8)
top_accounts = accounts[accounts['annual_revenue'] >= threshold].copy()

account_ids = top_accounts['account_id'].tolist()
placeholders = ','.join(['?'] * len(account_ids))
contacts = pd.read_sql_query(f"""
    SELECT account_id, contact_id, title, department
    FROM salesforce__contact_enhanced
    WHERE account_id IN ({placeholders})
""", conn, params=account_ids)

# Compute decision-maker flag (C-level + VP-level)
def is_decision_maker(title):
    if pd.isna(title):
        return False
    title_lower = title.lower()
    return ('chief' in title_lower) or ('vp' in title_lower) or ('vice president' in title_lower)

contacts['is_decision_maker'] = contacts['title'].apply(is_decision_maker)

# Aggregate per account
agg = contacts.groupby('account_id').agg(
    decision_makers=('is_decision_maker', 'sum'),
    total_contacts_agg=('contact_id', 'count'),
    departments=('department', lambda x: x.dropna().unique())
).reset_index()

top_accounts = top_accounts.merge(agg, on='account_id', how='left')
top_accounts['decision_makers'] = top_accounts['decision_makers'].fillna(0)
top_accounts['total_contacts_agg'] = top_accounts['total_contacts_agg'].fillna(0)

# Metrics
top_accounts['contact_density_ratio'] = top_accounts['total_contacts'] / top_accounts['number_of_employees'] * 1000
top_accounts['decision_maker_ratio'] = top_accounts['decision_makers'] / top_accounts['total_contacts_agg'].replace(0, np.nan) * 100

key_departments = ['Sales', 'Finance', 'Operations', 'IT', 'HR']
def count_coverage(dept_array):
    if isinstance(dept_array, list):
        return sum(1 for dept in dept_array if dept in key_departments)
    return 0

top_accounts['covered'] = top_accounts['departments'].apply(count_coverage)
top_accounts['coverage_completeness'] = top_accounts['covered'] / len(key_departments) * 100

# Summary statistics
print("=== Summary of Metrics for Top 20% Revenue Accounts ===")
print(f"Number of accounts: {len(top_accounts)}")
print("\nContact Density Ratio:")
print(top_accounts['contact_density_ratio'].describe())
print(f"Proportion below benchmark 5: {(top_accounts['contact_density_ratio'] < 5).mean():.2%}")

print("\nDecision-Maker Ratio:")
print(top_accounts['decision_maker_ratio'].describe())
print(f"Proportion below benchmark 15%: {(top_accounts['decision_maker_ratio'] < 15).mean():.2%}")

print("\nDepartmental Coverage Completeness:")
print(top_accounts['coverage_completeness'].describe())
print(f"Proportion below 100% (missing at least one dept): {(top_accounts['coverage_completeness'] < 100).mean():.2%}")

# Risk flags
top_accounts['density_risk'] = top_accounts['contact_density_ratio'] < 5
top_accounts['decision_maker_risk'] = top_accounts['decision_maker_ratio'] < 15
top_accounts['coverage_risk'] = top_accounts['coverage_completeness'] < 100
top_accounts['total_risks'] = top_accounts[['density_risk', 'decision_maker_risk', 'coverage_risk']].sum(axis=1)

risk_summary = top_accounts['total_risks'].value_counts().sort_index()
print("\n=== Risk Distribution ===")
print(risk_summary)
print("\nHigh-risk accounts (2+ risks):", len(top_accounts[top_accounts['total_risks'] >= 2]))

# Save data for deeper analysis
top_accounts.to_csv('top_accounts_detailed.csv', index=False)

# Break down by industry, size, region
print("\n=== Risk by Industry ===")
industry_risk = top_accounts.groupby('industry_normalized').agg(
    accounts=('account_id', 'count'),
    avg_density=('contact_density_ratio', 'mean'),
    avg_decision_maker=('decision_maker_ratio', 'mean'),
    avg_coverage=('coverage_completeness', 'mean'),
    pct_high_risk=('total_risks', lambda x: (x >= 2).mean())
).round(2)
print(industry_risk.sort_values('pct_high_risk', ascending=False).head(20))

print("\n=== Risk by Company Size Category ===")
size_risk = top_accounts.groupby('company_size_category').agg(
    accounts=('account_id', 'count'),
    avg_density=('contact_density_ratio', 'mean'),
    avg_decision_maker=('decision_maker_ratio', 'mean'),
    avg_coverage=('coverage_completeness', 'mean'),
    pct_high_risk=('total_risks', lambda x: (x >= 2).mean())
).round(2)
print(size_risk)

print("\n=== Risk by Geographic Region ===")
region_risk = top_accounts.groupby('geographic_region').agg(
    accounts=('account_id', 'count'),
    avg_density=('contact_density_ratio', 'mean'),
    avg_decision_maker=('decision_maker_ratio', 'mean'),
    avg_coverage=('coverage_completeness', 'mean'),
    pct_high_risk=('total_risks', lambda x: (x >= 2).mean())
).round(2)
print(region_risk.sort_values('pct_high_risk', ascending=False).head(20))

conn.close()
```
