'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-066/stage1_env/dacomp-066.sqlite')

query = """
SELECT hiring_managers, created_year, created_month, 
       AVG(application_to_interview_rate) as avg_conversion_rate,
       COUNT(*) as job_count
FROM greenhouse__job_enhanced
