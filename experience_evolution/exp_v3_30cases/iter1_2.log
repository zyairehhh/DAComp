'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
sns.set_style('whitegrid')

conn = sqlite3.connect("dacomp-066.sqlite")

# 1. Engineering vs Marketing conversion rate trend
query1 = """
SELECT 
    e.departments,
    p.application_year,
    p.application_quarter,
    AVG(p.interview_rate) as avg_conversion_rate,
    COUNT(*) as job_count
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
WHERE e.departments IN ('Engineering', 'Marketing')
GROUP BY e.departments, p.application_year, p.application_quarter
ORDER BY e.departments, p.application_year, p.application_quarter
"""
df_dept = pd.read_sql_query(query1, conn)
df_dept['quarter_label'] = df_dept['application_year'].astype(str) + 'Q' + df_dept['application_quarter'].astype(str)

plt.figure(figsize=(8,5))
for dept in df_dept['departments'].unique():
    sub = df_dept[df_dept['departments'] == dept]
    plt.plot(sub['quarter_label'], sub['avg_conversion_rate'], marker='o', label=dept)
plt.xlabel('Quarter')
plt.ylabel('Average Conversion Rate (%)')
plt.title('Application to Interview Conversion Rate: Engineering vs Marketing')
plt.legend()
plt.tight_layout()
plt.savefig('dept_trend.png', dpi=150)
plt.close()
print("Saved dept_trend.png")

# 2. Conversion rate change by role
def categorize_role(title):
    title_low = title.lower()
    if 'frontend' in title_low:
        return 'Frontend'
    elif 'backend' in title_low:
        return 'Backend'
    elif 'data engineer' in title_low:
        return 'Data Engineer'
    elif 'full stack' in title_low:
        return 'Full Stack'
    elif 'devops' in title_low:
        return 'DevOps'
    elif 'machine learning' in title_low or 'ml' in title_low:
        return 'Machine Learning'
    elif 'qa' in title_low or 'quality assurance' in title_low:
        return 'QA'
    elif 'mobile' in title_low:
        return 'Mobile'
    else:
        return 'Other'

query2 = """
SELECT 
    p.job_title,
    p.application_year,
    p.application_quarter,
    p.interview_rate,
    e.departments
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
WHERE e.departments = 'Engineering'
"""
df_role = pd.read_sql_query(query2, conn)
df_role['role'] = df_role['job_title'].apply(categorize_role)
grouped = df_role.groupby(['role', 'application_year', 'application_quarter'])['interview_rate'].mean().reset_index()
grouped['quarter_label'] = grouped['application_year'].astype(str) + 'Q' + grouped['application_quarter'].astype(str)
pivot = grouped.pivot(index='role', columns='quarter_label', values='interview_rate')
# compute change
pivot['change'] = pivot['2024Q4'] - pivot['2024Q3']
pivot = pivot.sort_values('change')
# plot
plt.figure(figsize=(10,6))
bars = plt.barh(pivot.index, pivot['change'], color=['red' if x < 0 else 'green' for x in pivot['change']])
plt.xlabel('Change in Conversion Rate (Q4 - Q3) percentage points')
plt.title('Decline in Conversion Rate by Engineering Role (Q3 to Q4)')
# add value labels
for bar in bars:
    width = bar.get_width()
    plt.text(width, bar.get_y() + bar.get_height()/2, f'{width:.2f}', 
             ha='left' if width > 0 else 'right', va='center')
plt.tight_layout()
plt.savefig('role_decline.png', dpi=150)
plt.close()
print("Saved role_decline.png")

# 3. Hiring manager performance (top 10 worst)
query3 = """
SELECT 
    e.hiring_managers,
    p.interview_rate,
    e.count_total_applications
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
WHERE e.departments = 'Engineering'
"""
df_manager = pd.read_sql_query(query3, conn)
df_manager['hiring_manager'] = df_manager['hiring_managers'].str.split(',').str[0].str.strip()
manager_avg = df_manager.groupby('hiring_manager').agg(
    avg_conversion=('interview_rate', 'mean'),
    job_count=('interview_rate', 'count')
).reset_index()
manager_avg = manager_avg[manager_avg['job_count'] >= 5].sort_values('avg_conversion')
top10_worst = manager_avg.head(10)

plt.figure(figsize=(10,6))
bars = plt.barh(top10_worst['hiring_manager'], top10_worst['avg_conversion'], color='coral')
plt.xlabel('Average Conversion Rate (%)')
plt.title('Top 10 Hiring Managers with Lowest Conversion Rates (Engineering)')
plt.gca().invert_yaxis()
for bar in bars:
    width = bar.get_width()
    plt.text(width, bar.get_y() + bar.get_height()/2, f'{width:.2f}', ha='left', va='center')
plt.tight_layout()
plt.savefig('worst_managers.png', dpi=150)
plt.close()
print("Saved worst_managers.png")

# 4. Scatter: conversion rate vs avg interviews per application
query4 = """
SELECT 
    p.interview_rate,
    e.avg_interviews_per_application,
    e.count_total_interviews,
    e.count_total_applications,
    e.hiring_managers
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
WHERE e.departments = 'Engineering'
"""
df_scatter = pd.read_sql_query(query4, conn)
plt.figure(figsize=(8,5))
plt.scatter(df_scatter['avg_interviews_per_application'], df_scatter['interview_rate'], alpha=0.6)
plt.xlabel('Average Interviews per Application')
plt.ylabel('Conversion Rate (%)')
plt.title('Conversion Rate vs Interview Intensity (Engineering)')
# add trend line
z = np.polyfit(df_scatter['avg_interviews_per_application'], df_scatter['interview_rate'], 1)
p = np.poly1d(z)
x_range = np.linspace(df_scatter['avg_interviews_per_application'].min(), df_scatter['avg_interviews_per_application'].max(), 100)
plt.plot(x_range, p(x_range), 'r--', label='Trend line')
plt.legend()
plt.tight_layout()
plt.savefig('scatter_interviews.png', dpi=150)
plt.close()
print("Saved scatter_interviews.png")

# 5. Bonus: correlation matrix (optional)
# Compute correlation between conversion rate and numeric factors
numeric_cols = ['interview_rate', 'avg_interviews_per_application', 'count_total_applications', 'count_total_interviews']
corr = df_scatter[numeric_cols].corr()
print("\nCorrelation matrix:")
print(corr.round(3))

conn.close()
''')
