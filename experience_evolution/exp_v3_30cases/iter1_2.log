FROM quickbooks__financial_dashboard
WHERE date >= '2024-10-01' AND date <= '2025-09-30'
ORDER BY date
"""

collection_df = pd.read_sql_query(collection_query, conn)

# Ensure data is complete (12 months)
if len(collection_df) >= 12:
    collection_df = collection_df.tail(12)  # Take last 12 months

# Create line chart
fig3, ax3 = plt.subplots(figsize=(12, 6))
months = collection_df['month'].tolist()
rates = collection_df['collection_rate_percentage'].tolist()

