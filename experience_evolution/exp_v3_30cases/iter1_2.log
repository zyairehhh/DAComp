Action: CreateFile(filepath="compute_metrics.sql"):
```
WITH dept_users AS (
    SELECT Department, COUNT(*) as user_count
    FROM user_information_table
    GROUP BY Department
),
dept_abnormal AS (
    SELECT 
        u.Department,
        COUNT(*) as abnormal_count,
        AVG(a."Anomaly Score") as avg_anomaly_score,
        SUM(CASE WHEN a."Risk Level" = 'Severe' THEN 1 ELSE 0 END) as severe_count,
        SUM(CASE WHEN a."Risk Level" = 'Medium' THEN 1 ELSE 0 END) as medium_count,
        SUM(CASE WHEN a."Risk Level" = 'Low' THEN 1 ELSE 0 END) as low_count,
        SUM(CASE WHEN a."Confirmation Status" = 'Confirmed' THEN 1 ELSE 0 END) as confirmed_count
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    JOIN user_information_table u ON l."User ID" = u."User ID"
    GROUP BY u.Department
)
SELECT 
    d.Department,
    d.user_count,
    da.abnormal_count,
    ROUND(da.abnormal_count * 1.0 / d.user_count, 3) as abnormal_per_user,
    ROUND(da.avg_anomaly_score, 2) as avg_anomaly_score,
    da.severe_count,
    da.medium_count,
    da.low_count,
    da.confirmed_count,
    ROUND(da.confirmed_count * 1.0 / da.abnormal_count, 3) as confirmation_rate
FROM dept_users d
JOIN dept_abnormal da ON d.Department = da.Department
ORDER BY abnormal_per_user DESC;
```
