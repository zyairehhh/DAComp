axes[1].set_ylabel('Average Displaced Population', fontsize=12)
axes[1].legend()
axes[1].grid(True, alpha=0.3)
axes[1].set_xticks(range(1, 13))

plt.tight_layout()
plt.savefig('monthly_trends.png', dpi=300)
plt.close()

print("Visualizations created successfully!")
for filename in ['infrastructure_damage_by_level.png', 'population_impacts_by_level.png', 
