```
import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('./dacomp-060.sqlite')

# Load aggregated ad groups
df = pd.read_csv('all_ad_groups_agg.csv')
problematic = pd.read_csv('problematic_ad_groups.csv')

overall_cvr = df['total_conversions'].sum() / df['total_clicks'].sum()
print("Overall CVR:", overall_cvr)

# Problematic groups stats
print("Problematic ad groups count:", len(problematic))
print("Problematic groups with zero conversions:", len(problematic[problematic['total_conversions'] == 0]))
print("Average clicks per problematic group:", problematic['total_clicks'].mean())
print("Average impressions per problematic group:", problematic['total_impressions'].mean())
print("Average CTR of problematic groups:", problematic['CTR'].mean())
print("Average CVR of problematic groups:", problematic['CVR'].mean())
print("Median Intent Match Ratio:", (problematic['CVR'] / overall_cvr).median())

# Compare with non-problematic groups
non_problematic = df[~df['ad_group_id'].isin(problematic['ad_group_id'])]
print("\nNon-problematic groups count:", len(non_problematic))
print("Non-problematic average CTR:", non_problematic['CTR'].mean())
print("Non-problematic average CVR:", non_problematic['CVR'].mean())

# Keyword-level analysis: join keyword_report with problematic ad groups
keyword_query = """
SELECT ad_group_id, keyword_match_type, keyword_text,
       SUM(clicks) as clicks, SUM(conversions) as conversions
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type, keyword_text
"""
keyword_df = pd.read_sql(keyword_query, conn)
keyword_df['keyword_cvr'] = keyword_df['conversions'] / keyword_df['clicks']
keyword_df['keyword_cvr'] = keyword_df['keyword_cvr'].fillna(0)

keyword_problematic = keyword_df[keyword_df['ad_group_id'].isin(problematic['ad_group_id'])]
print(f"\nKeyword records for problematic groups: {len(keyword_problematic)}")
if len(keyword_problematic) > 0:
    # Aggregate by match type
    match_agg = keyword_problematic.groupby('keyword_match_type').agg({'clicks':'sum','conversions':'sum'}).reset_index()
    match_agg['cvr'] = match_agg['conversions'] / match_agg['clicks']
    print("Keyword match type distribution (problematic):")
    print(match_agg)
    
    # Top keywords by clicks in problematic groups
    top_keywords = keyword_problematic.sort_values('clicks', ascending=False).head(20)
    print("\nTop keywords by clicks in problematic groups:")
    print(top_keywords[['keyword_text', 'keyword_match_type', 'clicks', 'conversions', 'keyword_cvr']])

# Search term analysis (already done but let's compute average CVR per search term for problematic vs non-problematic)
search_query = """
SELECT ad_group_id, search_term, search_term_match_type,
       SUM(clicks) as clicks, SUM(conversions) as conversions
FROM google_ads__search_term_report
GROUP BY ad_group_id, search_term, search_term_match_type
"""
search_df = pd.read_sql(search_query, conn)
search_df['search_cvr'] = search_df['conversions'] / search_df['clicks']
search_df['search_cvr'] = search_df['search_cvr'].fillna(0)

search_problematic = search_df[search_df['ad_group_id'].isin(problematic['ad_group_id'])]
search_non_problematic = search_df[~search_df['ad_group_id'].isin(problematic['ad_group_id'])]

print(f"\nSearch term records: problematic {len(search_problematic)}, non-problematic {len(search_non_problematic)}")
if len(search_problematic) > 0:
    avg_cvr_problematic = (search_problematic['conversions'].sum() / search_problematic['clicks'].sum())
    avg_cvr_non = (search_non_problematic['conversions'].sum() / search_non_problematic['clicks'].sum())
    print("Average CVR from search terms - problematic:", avg_cvr_problematic)
    print("Average CVR from search terms - non-problematic:", avg_cvr_non)
    
    # Search term match type distribution
    match_search = search_problematic.groupby('search_term_match_type').agg({'clicks':'sum','conversions':'sum'}).reset_index()
    match_search['cvr'] = match_search['conversions'] / match_search['clicks']
    print("\nSearch term match type distribution (problematic):")
    print(match_search)

conn.close()
```
