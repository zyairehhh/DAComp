ax2.grid(True, alpha=0.3)
ax2.legend()
plt.tight_layout()
plt.savefig('risk_vs_balance.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created risk_vs_balance.png")

# 2. Collection rate trend over 12 months
print("Creating collection rate trend visualization...")
collection_query = """
SELECT 
    substr(date, 1, 7) as month,
