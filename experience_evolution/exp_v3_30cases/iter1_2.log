import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Connect to database
conn = sqlite3.connect('dacomp-057.sqlite')

# Load tables
campaign_df = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)
cac_df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)

# Convert date columns to datetime
campaign_df['date_day'] = pd.to_datetime(campaign_df['date_day'].str[:10])
cac_df['date_day'] = pd.to_datetime(cac_df['date_day'].str[:10])

# Compute campaign duration
campaign_duration = campaign_df.groupby('campaign_id').agg(
    start_date=('date_day', 'min'),
    end_date=('date_day', 'max')
).reset_index()
campaign_duration['days_running'] = (campaign_duration['end_date'] - campaign_duration['start_date']).dt.days

# Filter campaigns running >120 days
long_campaigns = campaign_duration[campaign_duration['days_running'] > 120]['campaign_id']

# Merge campaign data with CAC data on account_id, date_day, advertising_channel_type
# Note: there may be multiple rows per day per campaign; we need to aggregate.
# We'll group by campaign_id and date_day to get daily spend and conversions from campaign table
campaign_daily = campaign_df.groupby(['campaign_id', 'date_day']).agg({
    'spend': 'sum',
    'conversions': 'sum',
    'conversions_value': 'sum',
    'clicks': 'sum',
    'impressions': 'sum'
}).reset_index()

# Merge with CAC data using account_id and date_day? Need to map campaign_id to account_id.
campaign_account_map = campaign_df[['campaign_id', 'account_id', 'advertising_channel_type']].drop_duplicates()
campaign_daily = campaign_daily.merge(campaign_account_map, on='campaign_id', how='left')

# Merge with CAC data on account_id, date_day, advertising_channel_type (assuming match)
merged = campaign_daily.merge(cac_df[['account_id', 'date_day', 'advertising_channel_type',
                                       'customer_acquisition_cost', 'ltv_cac_ratio',
                                       'campaign_lifecycle_stage', 'customer_maturity_stage',
                                       'account_maturity_stage', 'acquisition_sophistication_score',
                                       'cac_efficiency_percentile', 'channel_diversity_count',
                                       'strategic_customer_segment', 'retention_risk',
                                       'scale_opportunity']],
                              on=['account_id', 'date_day', 'advertising_channel_type'], how='inner')

# Define analysis date range
latest_date = campaign_daily['date_day'].max()
cutoff_30 = latest_date - pd.Timedelta(days=30)
cutoff_60 = latest_date - pd.Timedelta(days=60)

# Compute average CAC and LTV/CAC for last 30 days and previous 30 days per campaign
mask_last30 = (merged['date_day'] > cutoff_30) & (merged['date_day'] <= latest_date)
mask_prev30 = (merged['date_day'] > cutoff_60) & (merged['date_day'] <= cutoff_30)

# Aggregate per campaign
campaign_last30 = merged[mask_last30].groupby('campaign_id').agg(
    avg_cac_last30=('customer_acquisition_cost', 'mean'),
    avg_ltv_cac_last30=('ltv_cac_ratio', 'mean')
).reset_index()

campaign_prev30 = merged[mask_prev30].groupby('campaign_id').agg(
    avg_cac_prev30=('customer_acquisition_cost', 'mean'),
    avg_ltv_cac_prev30=('ltv_cac_ratio', 'mean')
).reset_index()

# Merge
campaign_metrics = pd.merge(campaign_last30, campaign_prev30, on='campaign_id', how='inner')
campaign_metrics['cac_growth_rate'] = (campaign_metrics['avg_cac_last30'] - campaign_metrics['avg_cac_prev30']) / campaign_metrics['avg_cac_prev30']
campaign_metrics['ltv_cac_decline_rate'] = (campaign_metrics['avg_ltv_cac_prev30'] - campaign_metrics['avg_ltv_cac_last30']) / campaign_metrics['avg_ltv_cac_prev30']

# Filter those with CAC growth >0.25 and LTV/CAC decline >0.2
decay_campaigns = campaign_metrics[
    (campaign_metrics['cac_growth_rate'] > 0.25) &
    (campaign_metrics['ltv_cac_decline_rate'] > 0.2)
]

# Add campaign attributes
campaign_info = merged[['campaign_id', 'campaign_lifecycle_stage', 'advertising_channel_type',
                        'customer_maturity_stage', 'account_maturity_stage',
                        'acquisition_sophistication_score', 'cac_efficiency_percentile',
                        'channel_diversity_count', 'strategic_customer_segment',
                        'retention_risk', 'scale_opportunity']].drop_duplicates()
decay_campaigns = decay_campaigns.merge(campaign_info, on='campaign_id', how='left')

print(f"Number of decay campaigns: {len(decay_campaigns)}")
print(decay_campaigns.head())

# Save to CSV for reference
decay_campaigns.to_csv('decay_campaigns.csv', index=False)

# Visualizations
# 1. Scatter plot of CAC growth vs LTV/CAC decline for all campaigns
plt.figure(figsize=(10,6))
plt.scatter(campaign_metrics['cac_growth_rate'], campaign_metrics['ltv_cac_decline_rate'], alpha=0.5, label='All campaigns')
plt.scatter(decay_campaigns['cac_growth_rate'], decay_campaigns['ltv_cac_decline_rate'], color='red', label='Decay campaigns')
plt.axvline(0.25, color='gray', linestyle='--', linewidth=0.5)
plt.axhline(0.2, color='gray', linestyle='--', linewidth=0.5)
plt.xlabel('CAC Growth Rate (last 30d vs previous 30d)')
plt.ylabel('LTV/CAC Decline Rate')
plt.title('Campaign Decay Identification: CAC Growth vs LTV/CAC Decline')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('scatter_cac_growth_vs_ltv_decline.png', dpi=300)
plt.close()

# 2. Distribution of decay campaigns by campaign_lifecycle_stage
if not decay_campaigns.empty:
    stage_counts = decay_campaigns['campaign_lifecycle_stage'].value_counts()
    plt.figure(figsize=(8,5))
    stage_counts.plot(kind='bar', color='steelblue')
    plt.title('Decay Campaigns by Campaign Lifecycle Stage')
    plt.xlabel('Lifecycle Stage')
    plt.ylabel('Count')
    plt.tight_layout()
    plt.savefig('decay_by_lifecycle_stage.png', dpi=300)
    plt.close()

# 3. Distribution by advertising_channel_type
if not decay_campaigns.empty:
    channel_counts = decay_campaigns['advertising_channel_type'].value_counts()
    plt.figure(figsize=(8,5))
    channel_counts.plot(kind='bar', color='seagreen')
    plt.title('Decay Campaigns by Advertising Channel')
    plt.xlabel('Channel Type')
    plt.ylabel('Count')
    plt.tight_layout()
    plt.savefig('decay_by_channel.png', dpi=300)
    plt.close()

# 4. Boxplots of acquisition_sophistication_score vs decay status
merged['is_decay'] = merged['campaign_id'].isin(decay_campaigns['campaign_id'])
plt.figure(figsize=(8,5))
sns.boxplot(x='is_decay', y='acquisition_sophistication_score', data=merged)
plt.xlabel('Decay Campaign')
plt.ylabel('Acquisition Sophistication Score')
plt.title('Acquisition Sophistication Score Distribution')
plt.xticks([0,1], ['Non-decay', 'Decay'])
plt.tight_layout()
plt.savefig('boxplot_soph_score.png', dpi=300)
plt.close()

# 5. Heatmap of decay risk across combinations
# We'll compute decay probability per combination of campaign_lifecycle_stage and advertising_channel_type
decay_risk = merged.groupby(['campaign_lifecycle_stage', 'advertising_channel_type']).apply(
    lambda grp: grp['is_decay'].mean() * 100
).reset_index(name='decay_pct')
decay_pivot = decay_risk.pivot(index='campaign_lifecycle_stage', columns='advertising_channel_type', values='decay_pct')
plt.figure(figsize=(10,6))
sns.heatmap(decay_pivot, annot=True, fmt='.1f', cmap='Reds', cbar_kws={'label': 'Decay %'})
plt.title('Decay Campaign Percentage by Lifecycle Stage and Channel')
plt.tight_layout()
plt.savefig('heatmap_decay_risk.png', dpi=300)
plt.close()

# 6. Time series of CAC and LTV/CAC for a few example decay campaigns (if any)
if not decay_campaigns.empty:
    example_campaign = decay_campaigns.iloc[0]['campaign_id']
    example_data = merged[merged['campaign_id']==example_campaign].sort_values('date_day')
    fig, ax1 = plt.subplots(figsize=(10,5))
    ax1.plot(example_data['date_day'], example_data['customer_acquisition_cost'], color='tab:blue', label='CAC')
    ax1.set_xlabel('Date')
    ax1.set_ylabel('Customer Acquisition Cost', color='tab:blue')
    ax1.tick_params(axis='y', labelcolor='tab:blue')
    ax2 = ax1.twinx()
    ax2.plot(example_data['date_day'], example_data['ltv_cac_ratio'], color='tab:orange', label='LTV/CAC')
    ax2.set_ylabel('LTV/CAC Ratio', color='tab:orange')
    ax2.tick_params(axis='y', labelcolor='tab:orange')
    plt.title(f'CAC and LTV/CAC Trend for Campaign {example_campaign} (Decay)')
    plt.tight_layout()
    plt.savefig('example_campaign_trend.png', dpi=300)
    plt.close()

print("Visualizations saved.")
```
