ax1.set_ylim(0, 100)

# 2. Scatter: Price vs Mileage
ax2 = plt.subplot(2, 3, 2)
# Sample to avoid overplotting
sample_df = df_clean.sample(min(300, len(df_clean)), random_state=42)
scatter = ax2.scatter(sample_df['Mileage_Cleaned']/10000, sample_df['Price_in_yuan']/10000, 
                      alpha=0.6, c=sample_df['Car_Age'], cmap='viridis')
ax2.set_xlabel('Mileage (10,000 km)', fontsize=12)
ax2.set_ylabel('Price (10,000 yuan)', fontsize=12)
ax2.set_title('Price vs Mileage (Color: Car Age)', fontsize=14, fontweight='bold')
cbar = plt.colorbar(scatter, ax=ax2)
cbar.set_label('Car Age (years)', fontsize=12)
ax2.grid(True, alpha=0.3)

# 3. Scatter: Price vs Car Age
ax3 = plt.subplot(2, 3, 3)
scatter2 = ax3.scatter(df_clean['Car_Age'], df_clean['Price_in_yuan']/10000, 
                       alpha=0.6, c=df_clean['Mileage_Cleaned']/10000, cmap='plasma')
ax3.set_xlabel('Car Age (years)', fontsize=12)
ax3.set_ylabel('Price (10,000 yuan)', fontsize=12)
ax3.set_title('Price vs Car Age (Color: Mileage)', fontsize=14, fontweight='bold')
cbar2 = plt.colorbar(scatter2, ax=ax3)
cbar2.set_label('Mileage (10,000 km)', fontsize=12)
ax3.grid(True, alpha=0.3)

# 4. Average depreciation by vehicle class
ax4 = plt.subplot(2, 3, 4)
# Get top vehicle classes by count
top_classes = df_clean['Vehicle Class'].value_counts().head(8).index.tolist()
df_class = df_clean[df_clean['Vehicle Class'].isin(top_classes)].copy()
class_means = df_class.groupby('Vehicle Class')['Depreciation_Rate'].mean().sort_values()
sns.barplot(x=class_means.values, y=class_means.index, ax=ax4, palette='rocket')
ax4.set_title('Average Depreciation by Vehicle Class', fontsize=14, fontweight='bold')
ax4.set_xlabel('Average Depreciation Rate (%)', fontsize=12)
ax4.set_ylabel('Vehicle Class', fontsize=12)

# 5. Histogram of car prices
ax5 = plt.subplot(2, 3, 5)
ax5.hist(df_clean['Price_in_yuan']/10000, bins=30, edgecolor='black', alpha=0.7)
ax5.set_xlabel('Price (10,000 yuan)', fontsize=12)
ax5.set_ylabel('Frequency', fontsize=12)
ax5.set_title('Distribution of Used Car Prices', fontsize=14, fontweight='bold')
ax5.grid(True, alpha=0.3)

# 6. Top 10 models with lowest depreciation (at least 5 samples)
ax6 = plt.subplot(2, 3, 6)
# Extract model from title (simplified)
def extract_model(title):
    # Take first 3 words or whole title if short
    words = str(title).split()
    return ' '.join(words[:3]) if len(words) >= 3 else title

df_clean['Model_Short'] = df_clean['Title'].apply(extract_model)
# Filter models with at least 3 samples
model_counts = df_clean['Model_Short'].value_counts()
valid_models = model_counts[model_counts >= 3].index.tolist()
df_models = df_clean[df_clean['Model_Short'].isin(valid_models)]

# Calculate average depreciation by model
model_avg = df_models.groupby('Model_Short')['Depreciation_Rate'].mean()
# Get top 10 models with LOWEST depreciation (best value retention)
top_models = model_avg.nsmallest(10).sort_values()

if len(top_models) > 0:
    sns.barplot(x=top_models.values, y=top_models.index, ax=ax6, palette='crest')
    ax6.set_title('Top 10 Models with Lowest Depreciation', fontsize=14, fontweight='bold')
    ax6.set_xlabel('Average Depreciation Rate (%)', fontsize=12)
    ax6.set_ylabel('Model', fontsize=12)

plt.tight_layout()
plt.savefig('buyback_analysis.png', dpi=300, bbox_inches='tight')
print("Saved buyback_analysis.png")

# Save key statistics
print("\\n=== KEY STATISTICS ===")
print(f"Total vehicles analyzed: {len(df_clean)}")
print(f"Overall average depreciation: {df_clean['Depreciation_Rate'].mean():.1f}%")
print(f"Median depreciation: {df_clean['Depreciation_Rate'].median():.1f}%")

# Best and worst brands by depreciation
brand_stats = df_clean.groupby('Brand').agg(
    avg_depreciation=('Depreciation_Rate', 'mean'),
    count=('Depreciation_Rate', 'count'),
    avg_price=('Price_in_yuan', 'mean')
).round(1)

print("\\n=== BEST BRANDS (LOWEST DEPRECIATION) ===")
print(brand_stats[brand_stats['count'] >= 5].sort_values('avg_depreciation').head(10))

print("\\n=== WORST BRANDS (HIGHEST DEPRECIATION) ===")
print(brand_stats[brand_stats['count'] >= 5].sort_values('avg_depreciation', ascending=False).head(10))
''')
