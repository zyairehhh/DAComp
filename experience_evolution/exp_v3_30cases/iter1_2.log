import sqlite3
import pandas as pd
import re
import matplotlib.pyplot as plt

# Connect to database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1 WHERE `Education Requirement` = 'Vocational school or above'", conn)
conn.close()

print(f"Total rows (vocational): {len(df)}")

# Function to extract lower bound salary
def extract_salary_lower(salary_str):
    if pd.isna(salary_str):
        return None
    salary_str = str(salary_str).strip()
    # Remove commas
    salary_str = salary_str.replace(',', '')
    # Find all numbers in the string
    numbers = re.findall(r'\d+', salary_str)
    if not numbers:
        return None
    # Assume first number sequence is lower bound (typical "xxxx-yyyy")
    try:
        lower = int(numbers[0])
        return lower
    except:
        return None

df['salary_lower'] = df['Salary Range'].apply(extract_salary_lower)
df_valid = df[df['salary_lower'].notna()].copy()
print(f"Valid salary rows: {len(df_valid)}")

# Salary distribution histogram (as per Stage1 bins)
bins = [0, 2000, 3000, 4000, 5000, 6000, 8000, 10000, 15000, 20000, float('inf')]
labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-8k', '8k-10k', '10k-15k', '15k-20k', '>20k']
df_valid.loc[:, 'salary_bin'] = pd.cut(df_valid['salary_lower'], bins=bins, labels=labels, right=False)

# Plot salary distribution bar chart
bin_counts = df_valid['salary_bin'].value_counts().sort_index()
print(bin_counts)

plt.figure(figsize=(10,6))
bin_counts.plot(kind='bar', color='skyblue')
plt.title('Starting Salary Distribution for Vocational School Graduates')
plt.xlabel('Salary Range (yuan/month)')
plt.ylabel('Number of Job Postings')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('salary_distribution.png')
print("Saved salary_distribution.png")

# Salary statistics
mean_salary = df_valid['salary_lower'].mean()
median_salary = df_valid['salary_lower'].median()
std_salary = df_valid['salary_lower'].std()
print(f"Mean: {mean_salary:.2f}, Median: {median_salary:.2f}, Std: {std_salary:.2f}")

# Benefits distribution (top 10) - using Stage1 data
top_benefits = [
    'Five social insurances',
    'Paid annual leave',
    'Holiday benefits',
    'Performance bonus',
    'Full attendance bonus',
    'Double salary at the end of the year',
    'Employee travel',
    'Housing provident fund',
    'Professional training',
    'Overtime pay'
]
frequencies = [
    6380, 4221, 4164, 3502, 2888, 2659, 2220, 2166, 2124, 2011
]
percentages = [80.4, 53.2, 52.5, 44.1, 36.4, 33.5, 28.0, 27.3, 26.8, 25.3]

# Create DataFrame for benefits
df_benefits = pd.DataFrame({
    'Benefit': top_benefits,
    'Frequency': frequencies,
    'Percentage': percentages
})

# Plot top 10 benefits
plt.figure(figsize=(12,6))
plt.barh(df_benefits['Benefit'], df_benefits['Percentage'], color='lightgreen')
plt.xlabel('Percentage of Postings (%)')
plt.title('Top 10 Benefits Offered to Vocational School Graduates')
plt.gca().invert_yaxis()  # highest on top
plt.tight_layout()
plt.savefig('benefits_top10.png')
print("Saved benefits_top10.png")

# Work experience vs salary with better categorization
def categorize_experience(exp_str):
    if pd.isna(exp_str):
        return 'No limit'
    exp_str = str(exp_str).strip().lower()
    # Chinese patterns
    if '应届生' in exp_str or 'fresh' in exp_str:
        return 'Fresh graduates'
    if '不限' in exp_str or 'no limit' in exp_str or '无经验' in exp_str:
        return 'No limit'
    # Extract years pattern like "1年以上", "3年", "10年"
    match = re.search(r'(\d+)\s*年', exp_str)
    if match:
        years = int(match.group(1))
        if years >= 10:
            return '10+ years'
        elif years >= 8:
            return '8+ years'
        elif years >= 6:
            return '6+ years'
        elif years >= 5:
            return '5+ years'
        elif years >= 4:
            return '4+ years'
        elif years >= 3:
            return '3+ years'
        elif years >= 2:
            return '2+ years'
        elif years >= 1:
            return '1+ years'
    # Fallback
    return 'No limit'

df_valid.loc[:, 'exp_category'] = df_valid['Work Experience Requirement'].apply(categorize_experience)
exp_salary = df_valid.groupby('exp_category')['salary_lower'].agg(['mean', 'count']).reset_index()
print(exp_salary)

# Order categories as per Stage1
category_order = ['Fresh graduates', 'No limit', '1+ years', '2+ years', '3+ years',
                  '4+ years', '5+ years', '6+ years', '8+ years', '10+ years']
# Keep only categories present
exp_salary['exp_category'] = pd.Categorical(exp_salary['exp_category'], categories=category_order, ordered=True)
exp_salary = exp_salary.sort_values('exp_category')

plt.figure(figsize=(10,6))
plt.bar(exp_salary['exp_category'], exp_salary['mean'], color='orange')
plt.title('Average Starting Salary by Work Experience Requirement')
plt.xlabel('Work Experience Requirement')
plt.ylabel('Average Salary (yuan/month)')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('salary_vs_experience.png')
print("Saved salary_vs_experience.png")

# Gender requirement analysis
def categorize_gender(gender_str):
    if pd.isna(gender_str):
        return 'Not specified'
    gender_str = str(gender_str).strip().lower()
    if 'female' in gender_str or '女' in gender_str:
        return 'Female'
    if 'male' in gender_str or '男' in gender_str:
        return 'Male'
    return 'Not specified'

df_valid.loc[:, 'gender_category'] = df_valid['Gender Requirement'].apply(categorize_gender)
gender_salary = df_valid.groupby('gender_category')['salary_lower'].agg(['mean', 'count']).reset_index()
print(gender_salary)

plt.figure(figsize=(8,5))
plt.bar(gender_salary['gender_category'], gender_salary['mean'], color=['blue', 'pink', 'gray'])
plt.title('Average Starting Salary by Gender Requirement')
plt.xlabel('Gender Requirement')
plt.ylabel('Average Salary (yuan/month)')
plt.tight_layout()
plt.savefig('salary_vs_gender.png')
print("Saved salary_vs_gender.png")

# Location analysis (crude city extraction) as per Stage1
def extract_city(location_str):
    if pd.isna(location_str):
        return None
    loc = str(location_str)
    # Simple extraction: assume city is first part before comma or space, but we'll just take whole for demo
    # We'll implement a simple mapping for major cities mentioned
    if '厦门' in loc or 'Xiamen' in loc:
        return 'Xiamen'
    if '泉州' in loc or 'Quanzhou' in loc:
        return 'Quanzhou'
    if '福建' in loc or 'Fujian' in loc:
        return 'Fujian'
    return 'Other'

df_valid['city'] = df_valid['Work Location'].apply(extract_city)
city_salary = df_valid.groupby('city')['salary_lower'].agg(['mean', 'count']).reset_index()
city_salary = city_salary[city_salary['count'] > 10]  # filter small samples
print(city_salary)

if len(city_salary) > 1:
    plt.figure(figsize=(8,5))
    plt.bar(city_salary['city'], city_salary['mean'], color='purple')
    plt.title('Average Starting Salary by Location (Major Cities)')
    plt.xlabel('Location')
    plt.ylabel('Average Salary (yuan/month)')
    plt.tight_layout()
    plt.savefig('salary_vs_location.png')
    print("Saved salary_vs_location.png")

print("All visualizations generated.")
