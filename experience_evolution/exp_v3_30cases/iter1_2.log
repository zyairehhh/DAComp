Action: LOCAL_DB_SQL(file_path="/workspace/dacomp-057.sqlite", command="
WITH candidates AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        julianday(MAX(substr(date_day,1,10))) - julianday(MIN(substr(date_day,1,10))) as lifespan_days
    FROM google_ads__customer_acquisition_analysis
    GROUP BY account_id, advertising_channel_type, advertising_channel_subtype
    HAVING lifespan_days > 120
),
daily AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        substr(date_day,1,10) as date,
        customer_acquisition_cost as cac,
        ltv_cac_ratio as ltv_cac,
        campaign_lifecycle_stage,
        account_maturity_stage,
        customer_maturity_stage,
        acquisition_sophistication_score,
        cac_efficiency_percentile,
        channel_diversity_count,
        strategic_customer_segment,
        retention_risk,
        scale_opportunity
    FROM google_ads__customer_acquisition_analysis
),
max_dates AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        MAX(date) as max_date
    FROM daily
    GROUP BY 1,2,3
),
periods AS (
    SELECT 
        d.*,
        m.max_date,
        julianday(m.max_date) - julianday(d.date) as days_ago
    FROM daily d
    JOIN max_dates m USING (account_id, advertising_channel_type, advertising_channel_subtype)
    JOIN candidates c USING (account_id, advertising_channel_type, advertising_channel_subtype)
),
recent AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        AVG(cac) as avg_cac_recent,
        AVG(ltv_cac) as avg_ltv_cac_recent,
        COUNT(*) as n_recent
    FROM periods
    WHERE days_ago <= 30
    GROUP BY 1,2,3
),
prior AS (
    SELECT 
        account_id,
        advertising_channel_type,
        advertising_channel_subtype,
        AVG(cac) as avg_cac_prior,
        AVG(ltv_cac) as avg_ltv_cac_prior,
        COUNT(*) as n_prior
    FROM periods
    WHERE days_ago > 30 AND days_ago <= 60
    GROUP BY 1,2,3
)
SELECT 
    c.*,
    r.avg_cac_recent,
    r.avg_ltv_cac_recent,
    r.n_recent,
    p.avg_cac_prior,
    p.avg_ltv_cac_prior,
    p.n_prior,
    (r.avg_cac_recent - p.avg_cac_prior) / p.avg_cac_prior AS cac_growth_rate,
    (r.avg_ltv_cac_recent - p.avg_ltv_cac_prior) / p.avg_ltv_cac_prior AS ltv_cac_change
FROM candidates c
JOIN recent r USING (account_id, advertising_channel_type, advertising_channel_subtype)
JOIN prior p USING (account_id, advertising_channel_type, advertising_channel_subtype)
WHERE cac_growth_rate > 0.25 AND ltv_cac_change < -0.20
", output="campaigns_decay.csv")
