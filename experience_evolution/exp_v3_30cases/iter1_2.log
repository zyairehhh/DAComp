import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta

conn = sqlite3.connect("dacomp-057.sqlite")

# Load data
query = """
SELECT 
    account_id,
    advertising_channel_type,
    date_day,
    customer_acquisition_cost as cac,
    ltv_cac_ratio,
    campaign_lifecycle_stage,
    customer_maturity_stage,
    account_maturity_stage,
    acquisition_sophistication_score,
    cac_efficiency_percentile,
    channel_diversity_count,
    strategic_customer_segment,
    retention_risk,
    scale_opportunity,
    acquisition_cohort,
    advertising_channel_subtype,
    account_name
FROM google_ads__customer_acquisition_analysis
"""
df = pd.read_sql_query(query, conn)
conn.close()

print("Total rows:", len(df))
print("Columns:", df.columns.tolist())

# Convert date_day to datetime (strip timezone offset)
df['date_day'] = pd.to_datetime(df['date_day'].str.replace(' +0800', '', regex=False))
df['acquisition_cohort'] = pd.to_datetime(df['acquisition_cohort'].str.replace(' +0800', '', regex=False))

# Compute max date in dataset
max_date = df['date_day'].max()
print("Max date:", max_date)
# Define last 30 days window
last_start = max_date - timedelta(days=30)
prev_start = last_start - timedelta(days=30)
prev_end = last_start - timedelta(days=1)

print("Last 30 days:", last_start, "to", max_date)
print("Previous 30 days:", prev_start, "to", prev_end)

# Helper to compute average cac and average ltv_cac_ratio per period for each campaign
def compute_avg(df_period):
    # group by campaign (account_id + advertising_channel_type)
    agg = df_period.groupby(['account_id', 'advertising_channel_type']).agg({
        'cac': 'mean',
        'ltv_cac_ratio': 'mean'
    }).reset_index()
    return agg

# Filter periods
last_30 = df[(df['date_day'] >= last_start) & (df['date_day'] <= max_date)]
prev_30 = df[(df['date_day'] >= prev_start) & (df['date_day'] <= prev_end)]

print("Last 30 days rows:", len(last_30))
print("Previous 30 days rows:", len(prev_30))

last_avg = compute_avg(last_30)
prev_avg = compute_avg(prev_30)

# Merge to compare
merged = pd.merge(last_avg, prev_avg, on=['account_id', 'advertising_channel_type'], suffixes=('_last', '_prev'), how='inner')
print("Campaigns with data in both periods:", len(merged))

# Compute growth rate and decline
merged['cac_growth_rate'] = (merged['cac_last'] - merged['cac_prev']) / merged['cac_prev']
merged['ltv_cac_decline'] = (merged['ltv_cac_ratio_prev'] - merged['ltv_cac_ratio_last']) / merged['ltv_cac_ratio_prev']  # positive means decline

# Filter growth >25% and decline >20%
filtered = merged[(merged['cac_growth_rate'] > 0.25) & (merged['ltv_cac_decline'] > 0.20)]
print("Campaigns with CAC growth >25% and LTV/CAC decline >20%:", len(filtered))
print(filtered[['account_id', 'advertising_channel_type', 'cac_growth_rate', 'ltv_cac_decline']])

# Now compute campaign age (days between acquisition_cohort and max_date)
# get the earliest acquisition_cohort per campaign (should be same)
campaign_age = df.groupby(['account_id', 'advertising_channel_type'])['acquisition_cohort'].min().reset_index()
campaign_age['campaign_age_days'] = (max_date - campaign_age['acquisition_cohort']).dt.days

print("\nCampaign age distribution:")
print(campaign_age['campaign_age_days'].describe())

# Keep campaigns with age > 120
filtered_age = campaign_age[campaign_age['campaign_age_days'] > 120]
print("Campaigns age >120 days:", len(filtered_age))

# Merge with filtered campaigns to get final list
final_campaigns = pd.merge(filtered, filtered_age, on=['account_id', 'advertising_channel_type'], how='inner')
print("\nFinal campaigns meeting all criteria:", len(final_campaigns))
print(final_campaigns[['account_id', 'advertising_channel_type', 'cac_growth_rate', 'ltv_cac_decline', 'campaign_age_days']])

# Save to CSV for further analysis
final_campaigns.to_csv('/workspace/final_campaigns.csv', index=False)
print("Saved to final_campaigns.csv")
