import sqlite3
import pandas as pd
import numpy as np

def main():
    conn = sqlite3.connect('dacomp-066.sqlite')
    # Get recruitment performance data
    query = """
    SELECT p.job_id, p.job_title, p.application_year, p.application_quarter,
           p.interview_rate, p.total_applications, p.completed_interviews,
           e.departments, e.hiring_managers
    FROM greenhouse__recruitment_performance p
    JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
    """
    df = pd.read_sql_query(query, conn)
    conn.close()
    print(f"Total rows: {len(df)}")
    # Extract role category
    df['role_category'] = df['job_title'].str.split(' - ').str[0]
    # Filter for Engineering department
    eng_df = df[df['departments'] == 'Engineering'].copy()
    print(f"Engineering rows: {len(eng_df)}")
    # Group by role_category and quarter to compute avg interview_rate
    summary = eng_df.groupby(['role_category', 'application_quarter']).agg(
        avg_interview_rate=('interview_rate', 'mean'),
        total_jobs=('job_id', 'count'),
        total_applications=('total_applications', 'sum'),
        total_interviews=('completed_interviews', 'sum')
    ).reset_index()
    print(summary)
    # Compute change from Q3 to Q4
    q3 = summary[summary['application_quarter'] == 3]
    q4 = summary[summary['application_quarter'] == 4]
    merged = pd.merge(q3, q4, on='role_category', suffixes=('_q3', '_q4'), how='outer')
    merged['change'] = merged['avg_interview_rate_q4'] - merged['avg_interview_rate_q3']
    merged['perc_change'] = (merged['change'] / merged['avg_interview_rate_q3']) * 100
    merged = merged.sort_values('change')
    print("\nRoles with biggest decline (Q3 vs Q4):")
    print(merged[['role_category', 'avg_interview_rate_q3', 'avg_interview_rate_q4', 'change', 'perc_change']].head(10))
    print("\nRoles with biggest improvement:")
    print(merged[['role_category', 'avg_interview_rate_q3', 'avg_interview_rate_q4', 'change', 'perc_change']].sort_values('change', ascending=False).head(10))
    # Overall engineering conversion rate
    overall_q3 = eng_df[eng_df['application_quarter'] == 3]['interview_rate'].mean()
    overall_q4 = eng_df[eng_df['application_quarter'] == 4]['interview_rate'].mean()
    print(f"\nOverall Engineering conversion rate Q3: {overall_q3:.2f}%")
    print(f"Overall Engineering conversion rate Q4: {overall_q4:.2f}%")
    # Marketing conversion rate
    mkt_df = df[df['departments'] == 'Marketing'].copy()
    mkt_q3 = mkt_df[mkt_df['application_quarter'] == 3]['interview_rate'].mean()
    mkt_q4 = mkt_df[mkt_df['application_quarter'] == 4]['interview_rate'].mean()
    print(f"\nMarketing conversion rate Q3: {mkt_q3:.2f}%")
    print(f"Marketing conversion rate Q4: {mkt_q4:.2f}%")
    # Write summary to CSV (current directory)
    summary.to_csv('eng_conversion_by_role.csv', index=False)
    merged.to_csv('eng_role_change.csv', index=False)
    # Now analyze hiring managers
    hm_summary = eng_df.groupby(['hiring_managers', 'application_quarter']).agg(
        avg_interview_rate=('interview_rate', 'mean'),
        job_count=('job_id', 'count'),
        total_applications=('total_applications', 'sum'),
        total_interviews=('completed_interviews', 'sum')
    ).reset_index()
    hm_change = pd.pivot_table(hm_summary, values='avg_interview_rate', index='hiring_managers', columns='application_quarter', aggfunc='mean')
    hm_change['change'] = hm_change[4] - hm_change[3]
    hm_change = hm_change.sort_values('change')
    print("\nHiring managers with biggest drop in conversion rate (Q3->Q4):")
    print(hm_change.head(10))
    # Write hiring manager analysis
    hm_change.to_csv('hiring_manager_change.csv')
    # Additional analysis: number of interviewers impact.
    # Need to get number of interviewers from greenhouse__job_enhanced? The column 'recruiters' maybe? Actually interviewers not directly given.
    # Let's explore columns of greenhouse__job_enhanced.
    conn = sqlite3.connect('dacomp-066.sqlite')
    columns = pd.read_sql_query("PRAGMA table_info(greenhouse__job_enhanced)", conn)
    print(columns)
    conn.close()
    # Check if there is interviewer count column.
    # For now we can compute using recruiters count? But not ideal.
if __name__ == '__main__':
    main()
