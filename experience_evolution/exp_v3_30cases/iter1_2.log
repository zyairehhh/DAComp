'''
import sqlite3
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-022.sqlite')

# Query data for completed rides
query = '''
SELECT "Vehicle Type" as vehicle_type,
       COUNT(*) as trips,
       SUM("Booking Value") as total_revenue,
       SUM("Ride Distance") as total_distance,
       SUM("Booking Value") / SUM("Ride Distance") as fare_per_km
FROM sheet1
WHERE "Driver Ratings" IS NOT NULL
GROUP BY "Vehicle Type"
ORDER BY fare_per_km DESC
'''

df = pd.read_sql_query(query, conn)
conn.close()

# Plot
fig, ax1 = plt.subplots(figsize=(10, 6))

# Bar chart for trips
bars = ax1.bar(range(len(df)), df['trips'], color='lightblue', edgecolor='gray', alpha=0.7, label='Number of Trips')
ax1.set_xlabel('Vehicle Type', fontsize=12)
ax1.set_ylabel('Number of Completed Trips', fontsize=12, color='darkblue')
ax1.tick_params(axis='y', labelcolor='darkblue')
ax1.set_xticks(range(len(df)))
ax1.set_xticklabels(df['vehicle_type'], rotation=45, ha='right')

# Annotate trip counts on bars
for i, bar in enumerate(bars):
    height = bar.get_height()
    ax1.text(bar.get_x() + bar.get_width()/2., height,
             f'{int(height):,}', ha='center', va='bottom', fontsize=9, color='darkblue')

# Second axis for fare per km
ax2 = ax1.twinx()
ax2.plot(range(len(df)), df['fare_per_km'], color='red', marker='o', linewidth=2, label='Fare per km')
ax2.set_ylabel('Fare per Kilometer (currency/km)', fontsize=12, color='red')
ax2.tick_params(axis='y', labelcolor='red')

# Annotate fare per km values
for i, (x, y) in enumerate(zip(range(len(df)), df['fare_per_km'])):
    ax2.text(x, y, f'{y:.2f}', ha='center', va='bottom', fontsize=10, color='red')

plt.title('Trade-off: Trip Volume vs Fare per Kilometer by Vehicle Type', fontsize=14, fontweight='bold')
fig.legend(loc='upper left', bbox_to_anchor=(0.1, 0.9))
plt.tight_layout()
plt.savefig('volume_vs_fare.png', dpi=300)
print('Plot saved as volume_vs_fare.png')
''')
