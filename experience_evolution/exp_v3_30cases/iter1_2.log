ax.grid(True, alpha=0.3, axis='y')

# Add count labels on bars
for bar, count in zip(bars2, distinct_df['user_count']):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2, height + 10, f'{int(count)}', 
           ha='center', va='bottom', fontsize=9)

# Add vertical line at 5 features
ax.axvline(x=4.5, color='red', linestyle='--', alpha=0.7, linewidth=2)
ax.text(4.5, ax.get_ylim()[1]*0.9, 'Threshold: <5 features', 
        ha='right', va='top', color='red', fontsize=11, fontweight='bold')

plt.tight_layout()
plt.savefig('feature_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

