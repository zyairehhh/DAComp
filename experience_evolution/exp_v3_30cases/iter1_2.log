import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import os

# Ensure using default fonts for English
matplotlib.rcParams.update({'font.size': 10})

# Connect to database
db_path = '/workspace/dacomp-069.sqlite'
conn = sqlite3.connect(db_path)

# 1. Time series data
query_ts = """
SELECT date_day, quality_score, daily_revenue, daily_installs, daily_churn_rate
FROM google_play__time_series_trends
WHERE package_name = 'com.dev.photoeditor'
ORDER BY date_day;
"""
df_ts = pd.read_sql_query(query_ts, conn)
df_ts['date_day'] = pd.to_datetime(df_ts['date_day'])
df_ts.set_index('date_day', inplace=True)

# 2. Geo market data
query_geo = """
SELECT country, region, avg_daily_revenue, avg_transaction_value, 
       average_revenue_per_user, weekly_growth_rate, day_30_retention_rate,
       revenue_last_30_days, market_tier, revenue_tier
FROM google_play__geo_market_analysis
WHERE package_name = 'com.dev.photoeditor';
"""
df_geo = pd.read_sql_query(query_geo, conn)

# Close connection
conn.close()

# Plot 1: Time series of quality_score (overall performance)
fig1, ax1 = plt.subplots(figsize=(10, 6))
ax1.plot(df_ts.index, df_ts['quality_score'], marker='o', color='b', linewidth=2)
ax1.set_title('PhotoEditor App: Overall Performance Score (Quality Score) Over Time', fontsize=14)
ax1.set_xlabel('Date')
ax1.set_ylabel('Quality Score')
ax1.grid(True)
ax1.axhline(y=85, color='g', linestyle='--', label='Initial (85)')
ax1.axhline(y=72, color='r', linestyle='--', label='Current (72)')
ax1.legend()
fig1.savefig('/workspace/quality_score_trend.png', dpi=300)
plt.close(fig1)

# Plot 2: Bar chart of average_revenue_per_user by country
df_geo_sorted = df_geo.sort_values('average_revenue_per_user', ascending=False)
fig2, ax2 = plt.subplots(figsize=(12, 6))
bars = ax2.bar(df_geo_sorted['country'], df_geo_sorted['average_revenue_per_user'], 
               color=['green' if x >= 7 else 'orange' for x in df_geo_sorted['average_revenue_per_user']])
ax2.set_title('Average Revenue Per User (ARPU) by Country', fontsize=14)
ax2.set_xlabel('Country')
ax2.set_ylabel('ARPU ($)')
ax2.axhline(y=7, color='green', linestyle='--', label='>$7')
# No country under $3, but for illustration
ax2.axhline(y=3, color='red', linestyle='--', label='<$3')
ax2.legend()
# Annotate values
for bar in bars:
    height = bar.get_height()
    ax2.text(bar.get_x() + bar.get_width() / 2, height + 0.5, f'{height:.1f}', ha='center', va='bottom', fontsize=8)
fig2.savefig('/workspace/arpu_by_country.png', dpi=300)
plt.close(fig2)

# Plot 3: Scatter plot of growth vs ARPU, bubble size = revenue_last_30_days
fig3, ax3 = plt.subplots(figsize=(10, 8))
# Determine if we need to classify by low/high transaction value? Use avg_transaction_value > 35 as high
df_geo['size'] = df_geo['revenue_last_30_days'] / 1e6  # scale to millions for bubble size
high_tx = df_geo['avg_transaction_value'] > 35
sc1 = ax3.scatter(df_geo.loc[high_tx, 'weekly_growth_rate'],
                  df_geo.loc[high_tx, 'average_revenue_per_user'],
                  s=df_geo.loc[high_tx, 'size'] * 100,
                  c='blue', alpha=0.7, label='High Transaction (>$35)')
sc2 = ax3.scatter(df_geo.loc[~high_tx, 'weekly_growth_rate'],
                  df_geo.loc[~high_tx, 'average_revenue_per_user'],
                  s=df_geo.loc[~high_tx, 'size'] * 100,
                  c='orange', alpha=0.7, label='Low Transaction (<=$35)')
ax3.set_title('Growth vs ARPU, Bubble Size = Revenue Last 30 Days (millions)', fontsize=14)
ax3.set_xlabel('Weekly Growth Rate')
ax3.set_ylabel('Average Revenue Per User ($)')
ax3.axhline(y=7, color='grey', linestyle=':', alpha=0.5)
ax3.axvline(x=0, color='grey', linestyle=':', alpha=0.5)
# Add country labels
for idx, row in df_geo.iterrows():
    ax3.annotate(row['country'], (row['weekly_growth_rate'], row['average_revenue_per_user']),
                 fontsize=8, alpha=0.8)
ax3.legend()
fig3.savefig('/workspace/growth_vs_arpu.png', dpi=300)
plt.close(fig3)

print('Plots saved: quality_score_trend.png, arpu_by_country.png, growth_vs_arpu.png')
```

