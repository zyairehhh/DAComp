# 4. Profitability tier analysis
print("Creating profitability tier visualization...")
profitability_query = """
SELECT 
    CASE 
        WHEN profitability_tier = 'Loss Making' THEN 'Loss Making'
        WHEN profitability_tier = 'Break Even' THEN 'Break Even'
        WHEN profitability_tier = 'Profitable' THEN 'Profitable'
        WHEN profitability_tier = 'Highly Profitable' THEN 'Highly Profitable'
        ELSE 'Other'
    END as tier,
    COUNT(*) as count
FROM quickbooks__profitability_analysis
GROUP BY tier
ORDER BY 
    CASE tier
        WHEN 'Loss Making' THEN 1
        WHEN 'Break Even' THEN 2
        WHEN 'Profitable' THEN 3
        WHEN 'Highly Profitable' THEN 4
        ELSE 5
    END
"""

profitability_df = pd.read_sql_query(profitability_query, conn)

