'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Set style
plt.rcParams.update({'font.size': 12})

conn = sqlite3.connect('dacomp-057.sqlite')

# Determine max date from campaign_report
max_date_q = "SELECT MAX(date_day) AS max_date FROM google_ads__campaign_report"
max_date = pd.read_sql_query(max_date_q, conn).iloc[0,0]
max_date = pd.to_datetime(max_date)

# 1. Select campaigns older than 120 days
campaign_age_q = """
SELECT 
    campaign_id,
    MIN(date_day) as first_date,
    MAX(date_day) as last_date,
    COUNT(DISTINCT date_day) as days_active
FROM google_ads__campaign_report
GROUP BY campaign_id
HAVING (JULIANDAY(?) - JULIANDAY(MIN(date_day))) > 120
"""
campaign_age = pd.read_sql_query(campaign_age_q, conn, params=(max_date,))
print(f"Campaigns >120 days: {len(campaign_age)}")

# For each campaign, compute CAC and LTV/CAC for last 30 days and previous 30 days
# We need to join with customer_acquisition_analysis on account_id, date_day, advertising_channel_type.
# Let's grab campaign daily data with advertising_channel_type
campaign_daily_q = """
SELECT 
    cr.campaign_id,
    cr.account_id,
    cr.date_day,
    cr.advertising_channel_type,
    cr.advertising_channel_subtype,
    cr.spend as campaign_spend,
    cr.clicks,
    cr.conversions,
    cr.conversions_value,
    ca.customer_acquisition_cost,
    ca.ltv_cac_ratio,
    ca.acquisition_sophistication_score,
    ca.cac_efficiency_percentile,
    ca.channel_diversity_count,
    ca.campaign_lifecycle_stage,
    ca.customer_maturity_stage,
    ca.account_maturity_stage,
    ca.strategic_customer_segment,
    ca.retention_risk,
    ca.scale_opportunity,
    ca.negative_roi_alert,
    ca.high_cac_alert
FROM google_ads__campaign_report cr
LEFT JOIN google_ads__customer_acquisition_analysis ca
    ON cr.account_id = ca.account_id 
    AND cr.date_day = ca.date_day
    AND cr.advertising_channel_type = ca.advertising_channel_type
WHERE cr.campaign_id IN ({})
""".format(','.join(['?']*len(campaign_age)))
campaign_ids = campaign_age['campaign_id'].tolist()
# Because SQLite limits number of parameters, but we have 80 campaigns, fine.
campaign_daily = pd.read_sql_query(campaign_daily_q, conn, params=tuple(campaign_ids))
campaign_daily['date_day'] = pd.to_datetime(campaign_daily['date_day'])

print(f"Campaign daily joined rows: {len(campaign_daily)}")

# Compute last 30 days and previous 30 days
recent_start = max_date - pd.Timedelta(days=30)
prev_start = max_date - pd.Timedelta(days=60)

df_recent = campaign_daily[(campaign_daily['date_day'] > recent_start) & (campaign_daily['date_day'] <= max_date)]
df_prev = campaign_daily[(campaign_daily['date_day'] > prev_start) & (campaign_daily['date_day'] <= recent_start)]

print(f"Recent rows: {len(df_recent)}, Previous rows: {len(df_prev)}")

# Group by campaign and compute average CAC and LTV/CAC
campaign_metrics_recent = df_recent.groupby('campaign_id').agg(
    avg_cac=('customer_acquisition_cost', 'mean'),
    avg_ltv_cac=('ltv_cac_ratio', 'mean')
).reset_index()
campaign_metrics_prev = df_prev.groupby('campaign_id').agg(
    avg_cac=('customer_acquisition_cost', 'mean'),
    avg_ltv_cac=('ltv_cac_ratio', 'mean')
).reset_index()

# Merge
campaign_metrics = pd.merge(campaign_metrics_recent, campaign_metrics_prev, on='campaign_id', suffixes=('_recent', '_prev'))
campaign_metrics['cac_growth_pct'] = (campaign_metrics['avg_cac_recent'] - campaign_metrics['avg_cac_prev']) / campaign_metrics['avg_cac_prev'] * 100
campaign_metrics['ltv_cac_decline_pct'] = (campaign_metrics['avg_ltv_cac_prev'] - campaign_metrics['avg_ltv_cac_recent']) / campaign_metrics['avg_ltv_cac_prev'] * 100

# Filter campaigns with CAC growth >25% AND LTV/CAC decline >20%
decay_campaigns = campaign_metrics[(campaign_metrics['cac_growth_pct'] > 25) & (campaign_metrics['ltv_cac_decline_pct'] > 20)]
print(f"Decay campaigns count: {len(decay_campaigns)}")
print(decay_campaigns.head())

# Merge with campaign dimensions
campaign_info = campaign_daily[['campaign_id', 'advertising_channel_type', 'campaign_lifecycle_stage', 
                                 'customer_maturity_stage', 'account_maturity_stage', 
                                 'acquisition_sophistication_score', 'cac_efficiency_percentile', 
                                 'channel_diversity_count', 'strategic_customer_segment',
                                 'retention_risk', 'scale_opportunity']].drop_duplicates(subset='campaign_id')
decay_campaigns_details = pd.merge(decay_campaigns, campaign_info, on='campaign_id', how='left')
print(f"Decay campaigns details shape: {decay_campaigns_details.shape}")
print(decay_campaigns_details.head())

# Save to CSV for reference
decay_campaigns_details.to_csv('decay_campaigns.csv', index=False)

conn.close()
''')
