Let's compile final summary tables and write the stage1.md report. We'll create a markdown file with analysis and business insights.

First, create a Python script to compute a composite risk score per department for easy comparison.

Action: CreateFile(filepath="/workspace/compute_risk.py"):
```
import sqlite3
import pandas as pd

conn = sqlite3.connect('/workspace/dacomp-035.sqlite')

# 1. total users per dept
query = """
SELECT Department, COUNT(DISTINCT `User ID`) AS total_users
FROM user_information_table
GROUP BY Department
"""
dept_users = pd.read_sql_query(query, conn)

# 2. high+severe abnormal user count and rate
query = """
SELECT u.Department,
       COUNT(DISTINCT u.`User ID`) AS hs_users
FROM abnormal_logins_table a
JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
JOIN user_information_table u ON l.`User ID` = u.`User ID`
WHERE a.`Risk Level` IN ('High', 'Severe')
GROUP BY u.Department
"""
hs_counts = pd.read_sql_query(query, conn)

# 3. high+severe counts per dept and rate per login
query = """
WITH dept_logins AS (
    SELECT u.Department, COUNT(l.`Login Record ID`) AS total_logins
    FROM login_records_table l
    JOIN user_information_table u ON l.`User ID` = u.`User ID`
    GROUP BY u.Department
),
dept_hs AS (
    SELECT u.Department, COUNT(a.`Anomaly ID`) AS hs_count
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
    JOIN user_information_table u ON l.`User ID` = u.`User ID`
    WHERE a.`Risk Level` IN ('High', 'Severe')
    GROUP BY u.Department
)
SELECT d.Department, d.total_logins, h.hs_count,
       ROUND(h.hs_count * 100.0 / d.total_logins, 2) AS hs_rate_pct
FROM dept_logins d
JOIN dept_hs h ON d.Department = h.Department
ORDER BY hs_rate_pct DESC
"""
hs_rate = pd.read_sql_query(query, conn)

# 4. average anomaly score for high+severe anomalies per dept
query = """
SELECT u.Department,
       AVG(a.`Anomaly Score`) AS avg_score,
       COUNT(*) AS hs_events
FROM abnormal_logins_table a
JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
JOIN user_information_table u ON l.`User ID` = u.`User ID`
WHERE a.`Risk Level` IN ('High', 'Severe')
GROUP BY u.Department
ORDER BY avg_score DESC
"""
avg_score = pd.read_sql_query(query, conn)

# 5. confirmation status counts per dept for high+severe
query = """
SELECT u.Department,
       a.`Confirmation Status`,
       COUNT(*) AS count
FROM abnormal_logins_table a
JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
JOIN user_information_table u ON l.`User ID` = u.`User ID`
WHERE a.`Risk Level` IN ('High', 'Severe')
GROUP BY u.Department, a.`Confirmation Status`
ORDER BY u.Department, a.`Confirmation Status`
"""
conf_status = pd.read_sql_query(query, conn)

# 6. anomaly type distribution per dept for high+severe
query = """
SELECT u.Department,
       a.`Anomaly Type`,
       COUNT(*) AS count
FROM abnormal_logins_table a
JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
JOIN user_information_table u ON l.`User ID` = u.`User ID`
WHERE a.`Risk Level` IN ('High', 'Severe')
GROUP BY u.Department, a.`Anomaly Type`
ORDER BY u.Department, count DESC
"""
anom_type = pd.read_sql_query(query, conn)

# 7. anomaly features distribution per dept for high+severe
query = """
SELECT u.Department,
       a.`Anomaly Features`,
       COUNT(*) AS count
FROM abnormal_logins_table a
JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
JOIN user_information_table u ON l.`User ID` = u.`User ID`
WHERE a.`Risk Level` IN ('High', 'Severe')
GROUP BY u.Department, a.`Anomaly Features`
ORDER BY u.Department, count DESC
"""
anom_features = pd.read_sql_query(query, conn)

conn.close()

# Merge into a summary table
summary = dept_users.copy()
summary = summary.merge(hs_counts, on='Department', how='left')
summary['hs_user_pct'] = round(summary['hs_users'] * 100.0 / summary['total_users'], 2)
summary = summary.merge(hs_rate[['Department', 'hs_rate_pct']], on='Department', how='left')
summary = summary.merge(avg_score[['Department', 'avg_score']], on='Department', how='left')
summary = summary.sort_values(by='hs_user_pct', ascending=False)
summary = summary.reset_index(drop=True)

print("=== Department Risk Summary ===")
print(summary.to_string(index=False))

print("\n=== Confirmation Status (High+Severe) ===")
print(conf_status.to_string(index=False))

print("\n=== Top Anomaly Types per Department (High+Severe) ===")
print(anom_type.to_string(index=False))

print("\n=== Top Anomaly Features per Department (High+Severe) ===")
print(anom_features.to_string(index=False))
```

