'''
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

df = pd.read_csv('filtered_campaigns.csv')
group = df.groupby('bidding_strategy').agg(
    avg_health=('health_score', 'mean'),
    count=('health_score', 'size')
).reset_index()
# Compute critical rate
critical_counts = df[df['risk']=='Critical'].groupby('bidding_strategy').size().reset_index(name='critical')
group = group.merge(critical_counts, how='left', on='bidding_strategy')
group['critical_rate'] = group['critical'] / group['count'] * 100
group = group.sort_values('avg_health', ascending=False)

# Plot
fig, ax1 = plt.subplots(figsize=(8,5))
x = np.arange(len(group))
width = 0.35
bars1 = ax1.bar(x - width/2, group['avg_health'], width, label='Avg Health Score', color='steelblue')
ax1.set_xlabel('Bidding Strategy')
ax1.set_ylabel('Average Health Score', color='steelblue')
ax1.tick_params(axis='y', labelcolor='steelblue')
ax1.set_xticks(x)
ax1.set_xticklabels(group['bidding_strategy'])
ax1.set_ylim(0, 100)

ax2 = ax1.twinx()
bars2 = ax2.bar(x + width/2, group['critical_rate'], width, label='Critical Rate (%)', color='crimson')
ax2.set_ylabel('Critical Rate (%)', color='crimson')
ax2.tick_params(axis='y', labelcolor='crimson')
ax2.set_ylim(0, 100)

# Add labels
for i, (idx, row) in enumerate(group.iterrows()):
    ax1.text(i - width/2, row['avg_health']+1, f"{row['avg_health']:.1f}", ha='center', va='bottom', fontsize=9)
    ax2.text(i + width/2, row['critical_rate']+1, f"{row['critical_rate']:.1f}%", ha='center', va='bottom', fontsize=9)

plt.title('Bidding Strategy: Health Score vs Critical Rate')
fig.tight_layout()
plt.savefig('bidding_health_critical.png', dpi=300)
plt.close()
''')
