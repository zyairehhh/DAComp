'''
import sqlite3
import pandas as pd
import numpy as np
import statsmodels.api as sm
from scipy.stats import pearsonr

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-066/stage1_env/dacomp-066.sqlite')

# Join tables
query = """
SELECT 
    j.application_to_interview_rate as conv_rate,
    j.count_total_interviews,
    j.count_completed_interviews,
    j.avg_interviews_per_application,
    j.hiring_managers,
    j.departments,
    r.avg_process_days,
    r.performance_tier,
    r.total_interviews,
    r.completed_interviews,
    r.avg_interview_score,
    r.hire_rate,
    r.interview_rate
FROM greenhouse__job_enhanced j
LEFT JOIN greenhouse__recruitment_performance r ON j.job_id = r.job_id
WHERE j.departments='Engineering';
"""
df = pd.read_sql_query(query, conn)
conn.close()

print("Number of rows:", len(df))
print("\nFirst few rows:")
print(df.head())

# Convert performance_tier to numeric? Let's encode as ordinal: Low=0, Medium=1, High=2
tier_map = {'Low':0, 'Medium':1, 'High':2}
df['performance_tier_numeric'] = df['performance_tier'].map(tier_map)
# Hiring manager as categorical - we'll create dummy variables
df = pd.get_dummies(df, columns=['hiring_managers'], drop_first=True)

# Features for correlation
numeric_cols = ['conv_rate', 'count_total_interviews', 'count_completed_interviews',
                'avg_interviews_per_application', 'avg_process_days', 'avg_interview_score',
                'hire_rate', 'interview_rate']
corr_matrix = df[numeric_cols].corr()
print("\nCorrelation matrix of numeric features:")
print(corr_matrix.round(3))

# Focus on correlation with conv_rate
print("\nCorrelation with conversion rate:")
print(corr_matrix['conv_rate'].sort_values(ascending=False))

# Linear regression to quantify impact
features = ['count_total_interviews', 'count_completed_interviews', 
            'avg_interviews_per_application', 'avg_process_days', 
            'avg_interview_score', 'hire_rate', 'interview_rate']
X = df[features].fillna(df[features].median())
y = df['conv_rate']

X = sm.add_constant(X)
model = sm.OLS(y, X).fit()
print("\nOLS regression results:")
print(model.summary())

# Check effect of hiring managers (categorical)
# We'll do separate analysis: average conversion rate per manager
manager_avg = df.groupby('hiring_managers')['conv_rate'].mean().sort_values()
print("\nAverage conversion rate by hiring manager:")
print(manager_avg)

# Also test if number of interviewers (count_total_interviews) impacts conversion rate
# Scatter plot (summary)
print("\nSummary stats of conversion rate by total interviews bins:")
df['interview_bin'] = pd.qcut(df['count_total_interviews'], q=4)
bin_summary = df.groupby('interview_bin')['conv_rate'].agg(['mean', 'count'])
print(bin_summary)
''')
