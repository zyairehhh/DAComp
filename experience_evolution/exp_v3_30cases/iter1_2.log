    print(f"  At-risk (n={len(at_risk)}): mean={at_risk.mean():.2f}, median={at_risk.median():.2f}")
    print(f"  Non-risk (n={len(non_risk)}): mean={non_risk.mean():.2f}, median={non_risk.median():.2f}")
    mean_diff = at_risk.mean() - non_risk.mean()
    # compute Cohen's d
    pooled_std = np.sqrt((at_risk.std()**2 + non_risk.std()**2)/2)
    if pooled_std > 0:
        d = mean_diff / pooled_std
        print(f"  Effect size (Cohen's d): {d:.3f}")

print("\nCorrelation between features and label:")
corr = target[features + ['label']].corr()
print(corr['label'].sort_values(ascending=False))
