'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-018.sqlite')
query = '''
SELECT 
    o."Customer ID",
    SUM(o.profit) AS total_profit,
    c."Customer Segment",
    c."Region",
    c."gender",
    c."Education Level",
    c."Marital Status"
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY o."Customer ID"
'''
df = pd.read_sql_query(query, conn)
print("Top combinations by average profit (limited to segments with enough customers)")
# Cross-tab gender + education
cross = df.groupby(['gender', 'Education Level'])['total_profit'].agg(['mean','count']).sort_values('mean', ascending=False)
print("Gender + Education Level:")
print(cross.head(10))
print()
# Region + Customer Segment
cross2 = df.groupby(['Region', 'Customer Segment'])['total_profit'].agg(['mean','count']).sort_values('mean', ascending=False)
print("Region + Customer Segment:")
print(cross2.head(10))
print()
# Age groups
df['age_group'] = pd.cut(df['age'], bins=[18,25,35,50,70], labels=['18-25','26-35','36-50','51+'])
age_profit = df.groupby('age_group')['total_profit'].agg(['mean','count']).sort_values('mean', ascending=False)
print("Age group profitability:")
print(age_profit)
print()
# Marital Status + gender
cross3 = df.groupby(['Marital Status', 'gender'])['total_profit'].agg(['mean','count']).sort_values('mean', ascending=False)
print("Marital Status + Gender:")
print(cross3.head())
conn.close()
''')
