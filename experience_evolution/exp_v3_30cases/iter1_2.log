Action: CreateFile(filepath='plot5_scatter_cost_roas.py':
'''
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

df = pd.read_csv('filtered_campaigns.csv')
risk_color_map = {'Critical': 'red', 'High': 'orange', 'Medium': 'gold', 'Low': 'green'}
colors = df['risk'].map(risk_color_map)

plt.figure(figsize=(10,6))
scatter = plt.scatter(df['cost'], df['roas'], c=colors, s=df['health_score']/2, alpha=0.7, edgecolors='gray')
plt.xscale('log')
plt.xlabel('Cost (log scale)')
plt.ylabel('ROAS')
plt.title('Cost vs ROAS (bubble size = health score, color = risk level)')
plt.grid(True, linestyle='--', alpha=0.5)

# Legend
for risk, col in risk_color_map.items():
    plt.scatter([], [], c=col, label=risk, alpha=0.7, edgecolors='gray')
plt.legend(title='Risk Level')

# Annotate some outliers
# Find points with high cost and low ROAS
high_cost_low_roas = df[(df['cost'] > df['cost'].quantile(0.9)) & (df['roas'] < df['roas'].quantile(0.1))]
for idx, row in high_cost_low_roas.iterrows():
    plt.annotate(f"Health:{row['health_score']:.0f}", (row['cost'], row['roas']), 
                 xytext=(5, -5), textcoords='offset points', fontsize=8, color='black')

plt.tight_layout()
plt.savefig('scatter_cost_roas.png', dpi=300)
plt.close()
''')
