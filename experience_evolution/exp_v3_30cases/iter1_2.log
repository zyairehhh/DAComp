import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-005.sqlite')
avg_margin = 0.795287
low_margin_threshold = avg_margin / 2

# Query with date parsing
query = """
SELECT 
    "Date",
    "Consigned Product",
    "Profit Margin",
    "Sales Quantity",
    CASE 
        WHEN "Profit Margin" < ? THEN 1 
        ELSE 0 
    END as low_margin_flag
FROM sheet1
WHERE "Date" IS NOT NULL
"""

df = pd.read_sql_query(query, conn, params=(low_margin_threshold,))
conn.close()

# Convert Date to datetime
df['Date'] = pd.to_datetime(df['Date'])

# 1. Time trend: Monthly low-margin rate
df['YearMonth'] = df['Date'].dt.to_period('M').astype(str)
monthly_stats = df.groupby('YearMonth').agg(
    total_orders=('low_margin_flag', 'size'),
    low_margin_orders=('low_margin_flag', 'sum')
).reset_index()
monthly_stats['low_margin_rate'] = monthly_stats['low_margin_orders'] / monthly_stats['total_orders'] * 100

plt.figure(figsize=(12, 6))
plt.plot(monthly_stats['YearMonth'], monthly_stats['low_margin_rate'], marker='o', linewidth=2, markersize=6, color='darkred')
plt.xlabel('Month (2023)')
plt.ylabel('Low-Margin Rate (%)')
plt.title('Monthly Low-Margin Rate Trend (2023)')
plt.grid(True, alpha=0.3)
plt.xticks(rotation=45)
plt.ylim(0, max(monthly_stats['low_margin_rate']) * 1.1)

# Add value labels
for i, (ym, rate) in enumerate(zip(monthly_stats['YearMonth'], monthly_stats['low_margin_rate'])):
    plt.text(i, rate + 0.1, f'{rate:.1f}%', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('plots/monthly_trend.png', dpi=300)
plt.close()

# 2. Product composition: Low-margin rate by product
product_stats = df.groupby('Consigned Product').agg(
    total_orders=('low_margin_flag', 'size'),
    low_margin_orders=('low_margin_flag', 'sum')
).reset_index()
product_stats['low_margin_rate'] = product_stats['low_margin_orders'] / product_stats['total_orders'] * 100
product_stats = product_stats.sort_values('low_margin_rate', ascending=False)

plt.figure(figsize=(12, 6))
bars = plt.bar(product_stats['Consigned Product'], product_stats['low_margin_rate'], color='steelblue')
plt.xlabel('Product Category')
plt.ylabel('Low-Margin Rate (%)')
plt.title('Low-Margin Rate by Product Category')
plt.xticks(rotation=45, ha='right')
plt.grid(True, alpha=0.3, axis='y')

# Add value labels
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.1,
            f'{height:.1f}%', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('plots/product_low_margin_rates.png', dpi=300)
plt.close()

print("Additional plots created")
```
