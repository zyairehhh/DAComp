axes[0].set_xlabel('Customer Margin Volatility')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Distribution of Customer Margin Volatility')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# Compare profitability between high and low volatility customers
profit_means = [high_vol_customers['customer_gross_margin_pct'].mean(), 
                low_vol_customers['customer_gross_margin_pct'].mean()]
profit_std = [high_vol_customers['customer_gross_margin_pct'].std(), 
              low_vol_customers['customer_gross_margin_pct'].std()]

x_pos = [0, 1]
axes[1].bar(x_pos, profit_means, yerr=profit_std, capsize=10, alpha=0.7, 
