'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-005.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

avg_margin = df['Profit Margin'].mean()
threshold = avg_margin * 0.5
df['low_margin'] = df['Profit Margin'] < threshold

# per unit metrics
df['freight_per_unit'] = df['Freight Cost'] / df['Sales Quantity']
df['warehousing_per_unit'] = df['Warehousing Cost'] / df['Sales Quantity']
df['other_cost_per_unit'] = df['Other Operating Costs'] / df['Sales Quantity']
df['revenue_per_unit'] = df['Total Logistics Revenue'] / df['Sales Quantity']
df['discount_per_unit'] = df['Discount Amount'] / df['Sales Quantity']

segments = df.groupby('low_margin')
print("=== Per-unit metrics ===")
print(segments[['freight_per_unit', 'warehousing_per_unit', 'other_cost_per_unit',
                'revenue_per_unit', 'discount_per_unit']].agg(['mean', 'median', 'std']))

print("\n=== Logistics Unit Price and List Price Revenue ===")
print(segments[['Logistics Unit Price', 'List Price Revenue']].agg(['mean', 'median', 'std']))

# examine distribution of Sales Quantity
print("\n=== Sales Quantity distribution ===")
print(segments['Sales Quantity'].describe())

# check if low-margin orders have extreme discount ratio (Discount Amount / List Price Revenue)
df['discount_ratio'] = df['Discount Amount'] / df['List Price Revenue']
print("\n=== Discount ratio (discount / list price) ===")
print(segments['discount_ratio'].agg(['mean', 'median', 'std']))

# examine cost structure as proportion of revenue
df['total_cost'] = df['Freight Cost'] + df['Warehousing Cost'] + df['Other Operating Costs']
df['cost_to_revenue'] = df['total_cost'] / df['Total Logistics Revenue']
print("\n=== Cost to Revenue ratio ===")
print(segments['cost_to_revenue'].agg(['mean', 'median', 'std']))

# segment by Sales Quantity categories
df['qty_category'] = pd.cut(df['Sales Quantity'], bins=[0, 10, 50, 100, 1000],
                             labels=['tiny (1-10)', 'small (11-50)', 'medium (51-100)', 'large (101+)'])
cat_summary = df.groupby('qty_category').apply(lambda g: pd.Series({
    'total': len(g),
    'low_margin': g['low_margin'].sum(),
    'low_margin_rate': g['low_margin'].mean(),
    'avg_profit_margin': g['Profit Margin'].mean()
})).reset_index()
print("\n=== Sales Quantity category analysis ===")
print(cat_summary)

# also see if low-margin orders are concentrated in certain postal codes (maybe remote areas)
postal_summary = df.groupby('Postal Code').apply(lambda g: pd.Series({
    'total': len(g),
    'low_margin': g['low_margin'].sum(),
    'low_margin_rate': g['low_margin'].mean()
})).reset_index().sort_values('low_margin_rate', ascending=False)
print("\n=== Top 10 Postal Codes by low-margin rate (with at least 10 orders) ===")
postal_summary = postal_summary[postal_summary['total'] >= 10]
print(postal_summary.head(10))

# examine profit margin distribution
print("\n=== Profit Margin percentiles for low-margin vs normal ===")
print("Low-margin percentiles:")
print(df[df['low_margin']]['Profit Margin'].quantile([0.01, 0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99]))
print("\nNormal percentiles:")
print(df[~df['low_margin']]['Profit Margin'].quantile([0.01, 0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99]))
''')
