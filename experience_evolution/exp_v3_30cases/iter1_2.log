import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-094.sqlite')

# Load data
persons_df = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
campaign_flow_df = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)
events_df = pd.read_sql_query("SELECT * FROM klaviyo__events", conn)

conn.close()

# Create output directory for plots in current directory
current_dir = os.getcwd()
plots_dir = os.path.join(current_dir, 'plots')
if not os.path.exists(plots_dir):
    os.makedirs(plots_dir)

# Set style
plt.style.use('default')
sns.set_palette("husl")

print("Dataset sizes:")
print(f"- Persons: {len(persons_df)} rows")
print(f"- Campaign Flow: {len(campaign_flow_df)} rows") 
print(f"- Events: {len(events_df)} rows")

# 1. Campaign Performance Comparison
print("\n1. Creating Campaign Performance Comparison...")
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

# Get campaign stats
campaign_stats = campaign_flow_df.groupby('last_touch_campaign_id').agg({
    'email_open_rate_touch': 'mean',
    'email_click_to_open_rate_touch': 'mean',
    'net_revenue_touch': 'sum',
    'count_opened_email': 'sum',
    'count_clicked_email': 'sum'
}).reset_index()

# Merge with events to get campaign names
if 'campaign_name' in events_df.columns:
    campaign_names = events_df[['last_touch_campaign_id', 'campaign_name']].drop_duplicates()
    campaign_stats = pd.merge(campaign_stats, campaign_names, 
                            left_on='last_touch_campaign_id', 
                            right_on='last_touch_campaign_id', 
                            how='left')
    
    # Open Rate
    axes[0].bar(range(len(campaign_stats)), campaign_stats['email_open_rate_touch'])
    axes[0].set_title('Email Open Rate by Campaign')
    axes[0].set_xlabel('Campaign')
    axes[0].set_ylabel('Open Rate')
    axes[0].set_xticks(range(len(campaign_stats)))
    campaign_labels = [f"CMP{row['last_touch_campaign_id'][-4:]}" for _, row in campaign_stats.iterrows()]
    axes[0].set_xticklabels(campaign_labels)
    
    # Click-to-Open Rate
    axes[1].bar(range(len(campaign_stats)), campaign_stats['email_click_to_open_rate_touch'])
    axes[1].set_title('Click-to-Open Rate by Campaign')
    axes[1].set_xlabel('Campaign')
    axes[1].set_ylabel('Click-to-Open Rate')
    axes[1].set_xticks(range(len(campaign_stats)))
    axes[1].set_xticklabels(campaign_labels)
    
    # Net Revenue
    axes[2].bar(range(len(campaign_stats)), campaign_stats['net_revenue_touch'])
    axes[2].set_title('Net Revenue by Campaign')
    axes[2].set_xlabel('Campaign')
    axes[2].set_ylabel('Net Revenue ($)')
    axes[2].set_xticks(range(len(campaign_stats)))
    axes[2].set_xticklabels(campaign_labels)
    
    # Add value labels
    for ax_idx, ax in enumerate(axes):
        for i, v in enumerate(campaign_stats.iloc[:, ax_idx+1]):  # +1 because first column is campaign_id
            ax.text(i, v + 0.01 if ax_idx < 2 else v + 10, 
                   f'{v:.3f}' if ax_idx < 2 else f'${v:.0f}', 
                   ha='center', va='bottom', fontsize=9)

plt.tight_layout()
campaign_path = os.path.join(plots_dir, '1_campaign_performance.png')
plt.savefig(campaign_path, dpi=300, bbox_inches='tight')
plt.close()
print(f"   Saved to {campaign_path}")

# 2. Time Window Analysis
print("\n2. Creating Time Window Analysis...")
if len(events_df) > 0 and 'occurred_at' in events_df.columns:
    events_df['occurred_at'] = pd.to_datetime(events_df['occurred_at'])
    events_df['hour'] = events_df['occurred_at'].dt.hour
    events_df['day_of_week'] = events_df['occurred_at'].dt.dayofweek
    events_df['month'] = events_df['occurred_at'].dt.month
    
    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    
    # Hour distribution
    hour_counts = events_df['hour'].value_counts().sort_index()
    axes[0, 0].bar(hour_counts.index, hour_counts.values)
    axes[0, 0].set_title('Email Events by Hour of Day')
    axes[0, 0].set_xlabel('Hour (0-23)')
    axes[0, 0].set_ylabel('Count')
    axes[0, 0].axvline(x=12, color='red', linestyle='--', alpha=0.5, label='Noon')
    axes[0, 0].legend()
    
    # Day of week distribution
    day_names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
    day_counts = events_df['day_of_week'].value_counts().sort_index()
    axes[0, 1].bar(range(len(day_counts)), day_counts.values)
    axes[0, 1].set_title('Email Events by Day of Week')
    axes[0, 1].set_xlabel('Day')
    axes[0, 1].set_ylabel('Count')
    axes[0, 1].set_xticks(range(len(day_counts)))
    axes[0, 1].set_xticklabels([day_names[i] for i in day_counts.index])
    
    # Month distribution
    month_names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
    month_counts = events_df['month'].value_counts().sort_index()
    axes[1, 0].bar([month_names[i-1] for i in month_counts.index], month_counts.values)
    axes[1, 0].set_title('Email Events by Month')
    axes[1, 0].set_xlabel('Month')
    axes[1, 0].set_ylabel('Count')
    axes[1, 0].tick_params(axis='x', rotation=45)
    
    # Campaign timeline
    axes[1, 1].text(0.5, 0.5, 'Timeline Analysis:\nLimited data points\nfor detailed timeline',
                   ha='center', va='center', transform=axes[1, 1].transAxes, fontsize=12)
    axes[1, 1].set_title('Campaign Timeline (Limited Data)')
    axes[1, 1].axis('off')
    
    plt.tight_layout()
    time_path = os.path.join(plots_dir, '2_time_analysis.png')
    plt.savefig(time_path, dpi=300, bbox_inches='tight')
    plt.close()
    print(f"   Saved to {time_path}")
else:
    print("   Skipped: No time data available")

# 3. Retention vs Engagement Analysis
print("\n3. Creating Retention vs Engagement Analysis...")
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Email open rate vs weekly retention
if 'email_open_rate' in persons_df.columns and 'active_retention_rate_week' in persons_df.columns:
    axes[0].scatter(persons_df['email_open_rate'], persons_df['active_retention_rate_week'], alpha=0.6)
    axes[0].set_title('Email Open Rate vs Weekly Active Retention')
    axes[0].set_xlabel('Individual Email Open Rate')
    axes[0].set_ylabel('Weekly Active Retention Rate')
    axes[0].grid(True, alpha=0.3)
    
    # Add trend line
    z = np.polyfit(persons_df['email_open_rate'], persons_df['active_retention_rate_week'], 1)
    p = np.poly1d(z)
    x_range = np.linspace(persons_df['email_open_rate'].min(), persons_df['email_open_rate'].max(), 100)
    axes[0].plot(x_range, p(x_range), "r--", alpha=0.8, label=f'Trend: y={z[0]:.3f}x+{z[1]:.3f}')
    axes[0].legend()

# Email click rate vs monthly retention
if 'email_click_to_open_rate_touch' in campaign_flow_df.columns and 'active_retention_rate_month' in persons_df.columns:
    # Aggregate click rate per person
    person_click_rate = campaign_flow_df.groupby('person_id').agg({
        'email_click_to_open_rate_touch': 'mean'
    }).reset_index()
    
    retention_analysis = pd.merge(persons_df[['person_id', 'active_retention_rate_month']], 
                                 person_click_rate, on='person_id', how='inner')
    
    if not retention_analysis.empty:
        axes[1].scatter(retention_analysis['email_click_to_open_rate_touch'], 
                       retention_analysis['active_retention_rate_month'], alpha=0.6)
        axes[1].set_title('Email Click Rate vs Monthly Active Retention')
        axes[1].set_xlabel('Email Click-to-Open Rate')
        axes[1].set_ylabel('Monthly Active Retention Rate')
        axes[1].grid(True, alpha=0.3)
        
        # Add trend line if enough points
        if len(retention_analysis) > 1:
            z = np.polyfit(retention_analysis['email_click_to_open_rate_touch'], 
                          retention_analysis['active_retention_rate_month'], 1)
            p = np.poly1d(z)
            x_range = np.linspace(retention_analysis['email_click_to_open_rate_touch'].min(), 
                                 retention_analysis['email_click_to_open_rate_touch'].max(), 100)
            axes[1].plot(x_range, p(x_range), "r--", alpha=0.8, label=f'Trend: y={z[0]:.3f}x+{z[1]:.3f}')
            axes[1].legend()

plt.tight_layout()
retention_path = os.path.join(plots_dir, '3_retention_analysis.png')
plt.savefig(retention_path, dpi=300, bbox_inches='tight')
plt.close()
print(f"   Saved to {retention_path}")

# 4. Subject Line Analysis
print("\n4. Creating Subject Line Analysis...")
if 'campaign_subject_line' in events_df.columns and len(events_df) > 0:
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))
    
    # Subject line themes
    subject_analysis = []
    for idx, row in events_df.iterrows():
        subject = str(row['campaign_subject_line'])
        theme = 'Other'
        if 'Launch' in subject:
            theme = 'Product Launch'
        elif 'Seasonal' in subject:
            theme = 'Seasonal Offer'
        elif 'Unlock' in subject:
            theme = 'Promotional'
        
        subject_analysis.append({
            'subject': subject[:30] + '...' if len(subject) > 30 else subject,
            'theme': theme,
            'length': len(subject),
            'campaign': row['campaign_name'] if 'campaign_name' in row else 'Unknown'
        })
    
    subject_df = pd.DataFrame(subject_analysis)
    
    # Theme distribution
    theme_counts = subject_df['theme'].value_counts()
    axes[0].bar(range(len(theme_counts)), theme_counts.values)
    axes[0].set_title('Subject Line Themes Distribution')
    axes[0].set_xlabel('Theme')
    axes[0].set_ylabel('Count')
    axes[0].set_xticks(range(len(theme_counts)))
    axes[0].set_xticklabels(theme_counts.index, rotation=45, ha='right')
    
    # Add count labels
    for i, v in enumerate(theme_counts.values):
        axes[0].text(i, v + 0.1, str(v), ha='center', va='bottom')
    
    # Subject length analysis
