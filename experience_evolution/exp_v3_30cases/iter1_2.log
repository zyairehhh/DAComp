'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

print("Starting visualization script...")

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')
print("Connected to database")

# Get ad group data
query = """
SELECT 
    campaign_name,
    ad_group_name,
    SUM(clicks) as clicks,
    SUM(impressions) as impressions,
    SUM(conversions) as conversions
FROM google_ads__ad_group_report
GROUP BY campaign_name, ad_group_name
HAVING impressions > 0 AND clicks > 0
"""

df = pd.read_sql_query(query, conn)
print(f"Loaded {len(df)} ad groups")

# Calculate metrics
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
df['Conversions_per_Impression'] = df['conversions'] / df['impressions']

# Clean data
df.replace([np.inf, -np.inf], np.nan, inplace=True)
df.dropna(subset=['CTR', 'CVR'], inplace=True)
print(f"After cleaning: {len(df)} ad groups")

# Calculate percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)
print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# Identify problematic groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
print(f"Found {len(problematic)} problematic ad groups")

# Generate Plot 1: CTR vs CVR scatter
plt.figure(figsize=(10, 6))
plt.scatter(df['CTR'], df['CVR'], alpha=0.5, s=20, color='blue')
plt.scatter(problematic['CTR'], problematic['CVR'], alpha=0.7, s=30, color='red', label='Problematic')
plt.axvline(x=ctr_75, color='gray', linestyle='--', alpha=0.5, label='75th pct CTR')
plt.axhline(y=cvr_25, color='gray', linestyle='-.', alpha=0.5, label='25th pct CVR')
plt.xlabel('Click-Through Rate (CTR)')
plt.ylabel('Conversion Rate (CVR)')
plt.title('Ad Groups: CTR vs CVR (Problematic Groups Highlighted)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('ctr_cvr_scatter.png', dpi=150)
plt.close()
print("Saved ctr_cvr_scatter.png")

# Calculate Intent-Match Ratio for problematic groups
if len(problematic) > 0:
    campaign_avg_cvr = df.groupby('campaign_name')['CVR'].mean().reset_index()
    campaign_avg_cvr.rename(columns={'CVR': 'expected_cvr'}, inplace=True)
    problematic = problematic.merge(campaign_avg_cvr, on='campaign_name', how='left')
    problematic['Intent_Match_Ratio'] = problematic['CVR'] / problematic['expected_cvr']
    
    # Plot 2: Intent-Match Ratio distribution
    plt.figure(figsize=(10, 6))
    plt.hist(problematic['Intent_Match_Ratio'].clip(upper=2), bins=20, 
             edgecolor='black', alpha=0.7, color='coral')
    plt.axvline(x=problematic['Intent_Match_Ratio'].mean(), 
               color='red', linestyle='--', linewidth=2, 
               label=f'Mean: {problematic["Intent_Match_Ratio"].mean():.2f}')
    plt.xlabel('Intent-Match Ratio (Actual CVR / Expected CVR)')
    plt.ylabel('Number of Ad Groups')
    plt.title('Intent-Match Ratio Distribution for Problematic Ad Groups')
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig('intent_match_ratio_histogram.png', dpi=150)
    plt.close()
print("Script completed")
''')
