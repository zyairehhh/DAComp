import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

def load_and_clean():
    conn = sqlite3.connect('dacomp-013.sqlite')
    df = pd.read_sql_query("SELECT * FROM sheet1", conn)
    conn.close()
    # Convert numeric columns
    df['Planned Work Hours'] = pd.to_numeric(df['Planned Work Hours'], errors='coerce')
    df['Actual Work Hours'] = pd.to_numeric(df['Actual Work Hours'].replace('-', np.nan), errors='coerce')
    df['Completion Quality Score'] = pd.to_numeric(df['Completion Quality Score'].replace('-', np.nan), errors='coerce')
    df['Task Difficulty Coefficient'] = pd.to_numeric(df['Task Difficulty Coefficient'], errors='coerce')
    df['Rework Count'] = pd.to_numeric(df['Rework Count'].replace('-', np.nan), errors='coerce')
    # Dates
    df['Planned Deadline'] = pd.to_datetime(df['Planned Deadline'], errors='coerce')
    df['Actual Completion Time'] = pd.to_datetime(df['Actual Completion Time'], errors='coerce')
    df['Planned Start Date'] = pd.to_datetime(df['Planned Start Date'], errors='coerce')
    df['Actual Start Date'] = pd.to_datetime(df['Actual Start Date'], errors='coerce')
    # Priority mapping
    priority_map = {'Urgent': 4, 'High': 3, 'Medium': 2, 'Low': 1}
    df['Priority Weight'] = df['Priority'].map(priority_map)
    return df

def compute_metrics(df):
    # We'll compute per owner metrics
    # First compute task type averages for normalization
    completed = df[df['Task Status'] == 'Completed'].copy()
    # Efficiency: planned/actual, cap at 2, ignore where actual hours zero or missing
    completed['Efficiency'] = completed['Planned Work Hours'] / completed['Actual Work Hours']
    completed['Efficiency'] = completed['Efficiency'].clip(upper=2)
    # On-time: completed on or before deadline
    completed['On Time'] = completed['Actual Completion Time'] <= completed['Planned Deadline']
    # Rework: lower is better, invert (max rework - rework) / max rework
    max_rework = completed['Rework Count'].max()
    if pd.isna(max_rework) or max_rework == 0:
        completed['Rework Score'] = 1.0
    else:
        completed['Rework Score'] = 1 - (completed['Rework Count'] / max_rework)
    # Quality: we will compute z-score per task type
    type_stats = completed.groupby('Task Type')['Completion Quality Score'].agg(['mean', 'std']).rename(columns={'mean': 'q_mean', 'std': 'q_std'})
    # Merge back
    completed = completed.merge(type_stats, left_on='Task Type', right_index=True, how='left')
    completed['Quality Z'] = (completed['Completion Quality Score'] - completed['q_mean']) / completed['q_std'].replace(0, 1)
    # Efficiency also normalize per type
    type_eff_stats = completed.groupby('Task Type')['Efficiency'].agg(['mean', 'std']).rename(columns={'mean': 'eff_mean', 'std': 'eff_std'})
    completed = completed.merge(type_eff_stats, left_on='Task Type', right_index=True, how='left')
    completed['Efficiency Z'] = (completed['Efficiency'] - completed['eff_mean']) / completed['eff_std'].replace(0, 1)
    # Rework score normalize per type
    type_rw_stats = completed.groupby('Task Type')['Rework Score'].agg(['mean', 'std']).rename(columns={'mean': 'rw_mean', 'std': 'rw_std'})
    completed = completed.merge(type_rw_stats, left_on='Task Type', right_index=True, how='left')
    completed['Rework Z'] = (completed['Rework Score'] - completed['rw_mean']) / completed['rw_std'].replace(0, 1)
    
    # Compute per-owner metrics
    owner_metrics = []
    for owner, group in df.groupby('Task Owner'):
        total_tasks = len(group)
        if total_tasks < 1:
            continue
        # Weighted completion rate
        total_weight = group['Priority Weight'].sum()
        completed_group = group[group['Task Status'] == 'Completed']
        completed_weight = completed_group['Priority Weight'].sum()
        weighted_completion = completed_weight / total_weight if total_weight > 0 else 0
        
        # For other metrics, only consider completed tasks
        comp = completed[completed['Task Owner'] == owner]
        if len(comp) == 0:
            avg_quality_z = 0
            on_time_rate = 0
            avg_efficiency_z = 0
            avg_rework_z = 0
        else:
            avg_quality_z = comp['Quality Z'].mean()
            on_time_rate = comp['On Time'].mean()
            avg_efficiency_z = comp['Efficiency Z'].mean()
            avg_rework_z = comp['Rework Z'].mean()
        
        owner_metrics.append({
            'Task Owner': owner,
            'Total Tasks': total_tasks,
            'Completed Tasks': len(completed_group),
            'Weighted Completion': weighted_completion,
            'Avg Quality Z': avg_quality_z,
            'On Time Rate': on_time_rate,
            'Avg Efficiency Z': avg_efficiency_z,
            'Avg Rework Z': avg_rework_z
        })
    return pd.DataFrame(owner_metrics), completed

def main():
    df = load_and_clean()
    print(f"Total tasks: {len(df)}")
    print(f"Unique owners: {df['Task Owner'].nunique()}")
    owner_metrics, completed = compute_metrics(df)
    # Combine scores into composite
    # Normalize each metric to 0-1 scale (except Z-scores may be negative)
    # We'll convert Z-scores to percentile using CDF? For simplicity, we'll scale to [0,1] within the dataset.
    for col in ['Weighted Completion', 'On Time Rate', 'Avg Quality Z', 'Avg Efficiency Z', 'Avg Rework Z']:
        # Min-max scaling
        min_val = owner_metrics[col].min()
        max_val = owner_metrics[col].max()
        if max_val > min_val:
            owner_metrics[col + '_scaled'] = (owner_metrics[col] - min_val) / (max_val - min_val)
        else:
            owner_metrics[col + '_scaled'] = 0.5
    
    # Composite score: average of scaled metrics
    score_cols = ['Weighted Completion_scaled', 'On Time Rate_scaled', 'Avg Quality Z_scaled', 'Avg Efficiency Z_scaled', 'Avg Rework Z_scaled']
    owner_metrics['Composite Score'] = owner_metrics[score_cols].mean(axis=1)
    # Rank owners by composite score
    owner_metrics = owner_metrics.sort_values('Composite Score', ascending=False)
    owner_metrics['Rank'] = owner_metrics['Composite Score'].rank(method='first', ascending=False).astype(int)
    # Determine percentiles
    total_owners = len(owner_metrics)
    owner_metrics['Percentile'] = owner_metrics['Rank'] / total_owners
    # Assign performance levels
    def assign_level(pct):
        if pct <= 0.2:
            return 'Excellent'
        elif pct <= 0.9:
            return 'Good'
        else:
            return 'Needs Improvement'
    owner_metrics['Performance Level'] = owner_metrics['Percentile'].apply(assign_level)
    
    # Output summary
    print("\nPerformance Level Distribution:")
    print(owner_metrics['Performance Level'].value_counts())
    print("\nTop 10 owners:")
    print(owner_metrics[['Task Owner', 'Composite Score', 'Performance Level']].head(10))
    print("\nBottom 10 owners:")
    print(owner_metrics[['Task Owner', 'Composite Score', 'Performance Level']].tail(10))
    # Save to CSV for review
    owner_metrics.to_csv('/workspace/owner_performance.csv', index=False)
    print("\nSaved to owner_performance.csv")
    # Also compute per Task Type averages to see fairness
    type_stats = completed.groupby('Task Type')[['Quality Z', 'Efficiency Z', 'Rework Z']].mean()
    print("\nAverage Z-scores per Task Type:")
    print(type_stats)

if __name__ == '__main__':
    main()
