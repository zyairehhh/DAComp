import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-094.sqlite')
flow = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)
events = pd.read_sql_query("SELECT * FROM klaviyo__events", conn)
campaign_subject = events[['last_touch_campaign_id', 'campaign_subject_line']].drop_duplicates()
flow = flow.merge(campaign_subject, on='last_touch_campaign_id', how='left')
flow['first_event_at'] = pd.to_datetime(flow['first_event_at'])
flow['day_of_week'] = flow['first_event_at'].dt.dayofweek
flow['is_weekend'] = flow['day_of_week'] >= 5
flow['hour'] = flow['first_event_at'].dt.hour
flow['time_window'] = flow['hour'].apply(lambda x: 'Morning (0-12h)' if x < 12 else 'Afternoon (12-24h)')
flow['subject_category'] = flow['campaign_subject_line'].apply(lambda x: 'New Product Launch' if 'Product Launch' in x else 'Discount-Related')

summary = flow.groupby(['subject_category', 'is_weekend', 'time_window']).agg(
    open_rate=('email_open_rate_touch', 'mean'),
    retention_week=('active_retention_rate_week', 'mean'),
    retention_month=('active_retention_rate_month', 'mean')
).reset_index()

print(summary.to_markdown(index=False))

# Create a grouped bar chart for open_rate by subject and time window
plt.figure(figsize=(10,6))
sns.barplot(x='subject_category', y='open_rate', hue='time_window', data=flow, ci=None)
plt.title('Open Rate by Subject Category and Time Window')
plt.ylabel('Open Rate')
plt.xlabel('Subject Category')
plt.tight_layout()
plt.savefig('open_rate_subject_time.png')
plt.close()

# Retention by subject category
plt.figure(figsize=(8,5))
retention_long = flow.melt(id_vars=['subject_category'], value_vars=['active_retention_rate_week', 'active_retention_rate_month'],
                         var_name='retention_type', value_name='retention_rate')
sns.barplot(x='subject_category', y='retention_rate', hue='retention_type', data=retention_long)
plt.title('Retention Rates by Subject Category')
plt.ylabel('Retention Rate')
plt.xlabel('Subject Category')
plt.tight_layout()
plt.savefig('retention_by_subject_category.png')
plt.close()

# Open rate by weekend vs weekday
flow['weekend_label'] = flow['is_weekend'].map({True: 'Weekend', False: 'Weekday'})
plt.figure(figsize=(8,5))
sns.barplot(x='subject_category', y='email_open_rate_touch', hue='weekend_label', data=flow, ci=None)
plt.title('Open Rate by Subject Category and Weekend/Weekday')
plt.ylabel('Open Rate')
plt.xlabel('Subject Category')
plt.tight_layout()
plt.savefig('open_rate_weekend_subject.png')
plt.close()

conn.close()
```
