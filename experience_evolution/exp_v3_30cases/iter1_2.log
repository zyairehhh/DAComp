import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import json
import numpy as np
from matplotlib import rcParams

# Connect to the database
conn = sqlite3.connect('dacomp-027.sqlite')

# Query disaster events with cascading hazard information
query = """
SELECT 
    "Disaster Event ID",
    "Timestamp",
    "Disaster Level",
    "Disaster Type",
    "Affected Area",
    json_extract("Impact Indicator", '$.damage_level') as damage_level,
    json_extract("Impact Indicator", '$.population.injured') as injured,
    json_extract("Impact Indicator", '$.population.missing') as missing,
    json_extract("Impact Indicator", '$.population.affected') as affected,
    json_extract("Impact Indicator", '$.population.displaced') as displaced,
    json_extract("Impact Indicator", '$.population.casualties') as casualties,
    json_extract("Impact Indicator", '$.infrastructure.damage_percent') as infrastructure_damage,
    json_extract("Impact Indicator", '$.infrastructure.power_outage_percent') as power_outage,
    json_extract("Impact Indicator", '$.infrastructure.water_damage_percent') as water_damage,
    json_extract("Impact Indicator", '$.communication') as communication,
    json_extract("Impact Indicator", '$.transportation') as transportation
FROM disaster_events
WHERE "Disaster Level" IN ('Level 1', 'Level 2', 'Level 3', 'Level 4', 'Level 5')
ORDER BY "Disaster Level"
"""

df = pd.read_sql_query(query, conn)
conn.close()

print(f"Total disaster events: {len(df)}")
print("\nDisaster Level distribution:")
print(df['Disaster Level'].value_counts())
print("\nDisaster Type distribution:")
print(df['Disaster Type'].value_counts())

# Clean and convert numeric columns
numeric_cols = ['injured', 'missing', 'affected', 'displaced', 'casualties', 
                'infrastructure_damage', 'power_outage', 'water_damage']
for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Create visualizations

# 1. Box plot of infrastructure damage by disaster level
plt.figure(figsize=(10, 6))
damage_data = [df[df['Disaster Level'] == level]['infrastructure_damage'].dropna() 
               for level in sorted(df['Disaster Level'].unique())]
positions = range(1, len(damage_data) + 1)
box = plt.boxplot(damage_data, positions=positions, patch_artist=True, 
                  tick_labels=sorted(df['Disaster Level'].unique()))
# Color boxes
colors = ['lightblue', 'lightgreen', 'lightcoral', 'lightsalmon', 'lightseagreen']
