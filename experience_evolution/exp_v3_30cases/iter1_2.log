import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-079.sqlite')

# 1. Identify single-feature-use segment
query = """
WITH visitor_features AS (
    SELECT 
        v.visitor_id,
        v.count_active_days,
        v.latest_nps_rating,
        v.average_daily_minutes,
        COUNT(DISTINCT vf.feature_id) as distinct_features
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id
    GROUP BY v.visitor_id, v.count_active_days, v.latest_nps_rating, v.average_daily_minutes
)
SELECT 
    *,
    CASE 
        WHEN count_active_days > 60 AND distinct_features < 5 THEN 'single_feature_use'
        WHEN count_active_days > 60 AND distinct_features >= 5 THEN 'normal_active'
        ELSE 'other'
    END as user_segment
FROM visitor_features
"""

df = pd.read_sql_query(query, conn)

# Calculate metrics
single_feature = df[df['user_segment'] == 'single_feature_use']
normal_active = df[df['user_segment'] == 'normal_active']
other = df[df['user_segment'] == 'other']

print(f"Total visitors: {len(df)}")
print(f"Single-feature-use users (>60 days, <5 features): {len(single_feature)} ({len(single_feature)/len(df)*100:.1f}%)")
print(f"Normal active users (>60 days, >=5 features): {len(normal_active)} ({len(normal_active)/len(df)*100:.1f}%)")
print(f"Other users: {len(other)} ({len(other)/len(df)*100:.1f}%)")
print()
print(f"Average NPS - Single-feature-use: {single_feature['latest_nps_rating'].mean():.2f}")
print(f"Average NPS - Normal active: {normal_active['latest_nps_rating'].mean():.2f}")
print(f"NPS difference: {normal_active['latest_nps_rating'].mean() - single_feature['latest_nps_rating'].mean():.2f}")
print()
print(f"Average daily minutes - Single-feature-use: {single_feature['average_daily_minutes'].mean():.2f}")
print(f"Average daily minutes - Normal active: {normal_active['average_daily_minutes'].mean():.2f}")
print(f"Minutes difference: {normal_active['average_daily_minutes'].mean() - single_feature['average_daily_minutes'].mean():.2f}")

# 2. Analyze which features single-feature-use users focus on
feature_query = """
SELECT 
    f.feature_name,
    f.product_area_name,
    COUNT(DISTINCT vf.visitor_id) as user_count,
    AVG(vf.sum_clicks) as avg_clicks,
    AVG(vf.sum_minutes) as avg_minutes
FROM pendo__visitor_feature vf
JOIN pendo__feature f ON vf.feature_id = f.feature_id
WHERE vf.visitor_id IN (
    SELECT v.visitor_id
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf2 ON v.visitor_id = vf2.visitor_id
    GROUP BY v.visitor_id
    HAVING v.count_active_days > 60 AND COUNT(DISTINCT vf2.feature_id) < 5
)
GROUP BY f.feature_id, f.feature_name, f.product_area_name
ORDER BY user_count DESC
LIMIT 20
"""

features_df = pd.read_sql_query(feature_query, conn)
print("\nTop features used by single-feature-use users:")
print(features_df.head(10))

# 3. Check retention (count_active_months)
retention_query = """
SELECT 
    user_segment,
    AVG(count_active_months) as avg_active_months,
    AVG(count_active_days) as avg_active_days,
    COUNT(*) as user_count
FROM (
    SELECT 
        v.visitor_id,
        v.count_active_months,
        v.count_active_days,
        CASE 
            WHEN v.count_active_days > 60 AND COUNT(DISTINCT vf.feature_id) < 5 THEN 'single_feature_use'
            WHEN v.count_active_days > 60 AND COUNT(DISTINCT vf.feature_id) >= 5 THEN 'normal_active'
            ELSE 'other'
        END as user_segment
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id
    GROUP BY v.visitor_id, v.count_active_months, v.count_active_days
) 
GROUP BY user_segment
"""

retention_df = pd.read_sql_query(retention_query, conn)
print("\nRetention metrics:")
print(retention_df)

conn.close()
```
