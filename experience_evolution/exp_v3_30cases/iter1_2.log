print(merged['payment_behavior'].value_counts(dropna=False).head(10))
print("\n=== Lifecycle Stage distribution ===")
print(merged['lifecycle_stage'].value_counts(dropna=False).head(10))
print("\n=== Customer Maturity Stage distribution ===")
print(merged['customer_maturity_stage'].value_counts(dropna=False).head(10))

# Compute average CV by segment
print("\n=== Average gross_profit CV by RFM Segment ===")
cv_by_rfm = merged.groupby('rfm_segment')['gross_profit_cv'].mean().sort_values(ascending=False)
print(cv_by_rfm.head(10))
print("\n=== Average gross_profit CV by Payment Behavior ===")
cv_by_pay = merged.groupby('payment_behavior')['gross_profit_cv'].mean().sort_values(ascending=False)
print(cv_by_pay.head(10))
print("\n=== Average CV by Lifecycle Stage ===")
cv_by_life = merged.groupby('lifecycle_stage')['gross_profit_cv'].mean().sort_values(ascending=False)
print(cv_by_life.head(10))

# Save merged dataset for further analysis
merged.to_csv('high_vol_with_behavior.csv', index=False)
print("\nSaved merged dataset to high_vol_with_behavior.csv")

conn.close()
