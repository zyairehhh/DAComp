import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-001.sqlite')
# Upstream dependency: number of distinct buyers per enterprise (sales side)
df_buyers = pd.read_sql_query('SELECT "Enterprise Code", COUNT(DISTINCT "Buyer organization code") as unique_buyers FROM ch___sales_invoices GROUP BY "Enterprise Code"', conn)
df_rating = pd.read_sql_query('SELECT "Enterprise Code", "Credit Rating" FROM ch___company_info', conn)
df_upstream = pd.merge(df_buyers, df_rating, on='Enterprise Code')
plt.figure(figsize=(8,5))
sns.boxplot(x='Credit Rating', y='unique_buyers', data=df_upstream, order=['A','B','C','D'])
plt.title('Upstream Dependency (Number of Unique Buyers) by Credit Rating')
plt.ylabel('Unique Buyers')
plt.tight_layout()
plt.savefig('upstream_buyers_by_rating.png', dpi=300)
plt.close()

# Downstream dependency: using input_invoices (purchases) - we need to see if there is a supplier column.
# Let's inspect the ch___input_invoices schema.
df_schema = pd.read_sql_query('PRAGMA table_info(ch___input_invoices);', conn)
print(df_schema)
conn.close()
```
