import pandas as pd
import sqlite3
import numpy as np
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-057.sqlite')
df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)
df['date_day'] = pd.to_datetime(df['date_day'])
print("Rows:", df.shape[0])

# Determine campaigns (account, channel, stage)
campaign_cols = ['account_id', 'advertising_channel_type', 'campaign_lifecycle_stage']
campaign_groups = df.groupby(campaign_cols)

campaign_data = []
for name, group in campaign_groups:
    group = group.sort_values('date_day')
    # remove rows with missing essential metrics
    group = group.dropna(subset=['customer_acquisition_cost', 'ltv_cac_ratio'])
    if len(group) < 10:
        continue
    # linear regression slope for CAC and ratio
    x = np.arange(len(group))
    y_cac = group['customer_acquisition_cost'].values
    y_ratio = group['ltv_cac_ratio'].values
    slope_cac, _ = np.polyfit(x, y_cac, 1)
    slope_ratio, _ = np.polyfit(x, y_ratio, 1)
    # percentage slope relative to average
    avg_cac = np.mean(y_cac)
    avg_ratio = np.mean(y_ratio)
    slope_cac_pct = slope_cac / avg_cac if avg_cac != 0 else np.nan
    slope_ratio_pct = slope_ratio / avg_ratio if avg_ratio != 0 else np.nan
    
    # other metrics averages
    avg_soph_score = group['acquisition_sophistication_score'].mean()
    avg_cac_eff = group['cac_efficiency_percentile'].mean()
    avg_channel_diversity = group['channel_diversity_count'].mean()
    avg_retention_risk = group['retention_risk'].mean()
    avg_scale_opportunity = group['scale_opportunity'].mean()
    if group['strategic_customer_segment'].notna().any():
        top_segment = group['strategic_customer_segment'].mode().iloc[0]
    else:
        top_segment = None
    
    duration = (group['date_day'].max() - group['date_day'].min()).days
    # check if active in last 30 days
    latest_date = df['date_day'].max()
    last_start = latest_date - timedelta(days=30)
    active_last_30 = group['date_day'].max() >= last_start
    
    campaign_data.append({
        'account_id': name[0],
        'advertising_channel_type': name[1],
        'campaign_lifecycle_stage': name[2],
        'duration_days': duration,
        'active_last_30': active_last_30,
        'slope_cac': slope_cac,
        'slope_ratio': slope_ratio,
        'slope_cac_pct': slope_cac_pct,
        'slope_ratio_pct': slope_ratio_pct,
        'avg_cac': avg_cac,
        'avg_ltv_cac_ratio': avg_ratio,
        'avg_acquisition_sophistication_score': avg_soph_score,
        'avg_cac_efficiency_percentile': avg_cac_eff,
        'avg_channel_diversity_count': avg_channel_diversity,
        'avg_retention_risk': avg_retention_risk,
        'avg_scale_opportunity': avg_scale_opportunity,
        'top_strategic_segment': top_segment,
        'data_points': len(group)
    })

campaign_df = pd.DataFrame(campaign_data)
print(f"Campaings with sufficient data: {len(campaign_df)}")
campaign_df.to_csv('campaign_summary.csv', index=False)
print(campaign_df.head())

# Identify campaigns with deterioration: positive CAC slope and negative ratio slope, also with significant magnitude
campaign_df['cac_increasing'] = campaign_df['slope_cac_pct'] > 0.25  # >25% trend over whole period
campaign_df['ratio_declining'] = campaign_df['slope_ratio_pct'] < -0.20
decay_candidates = campaign_df[campaign_df['cac_increasing'] & campaign_df['ratio_declining']]
print(f"\nDecay candidate campaigns (trend CAC up >25% and ratio down >20%): {len(decay_candidates)}")
print(decay_candidates[['account_id','advertising_channel_type','campaign_lifecycle_stage','duration_days','slope_cac_pct','slope_ratio_pct']])
