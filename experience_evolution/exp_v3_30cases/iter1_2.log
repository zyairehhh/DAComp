df['dept_coverage'] = df[dept_cols].sum(axis=1) / 5 * 100  # percent

# Keep top 20% only
df_top = df[df['is_top20'] == 1].copy()
print(f"Top 20% accounts: {len(df_top)}")

# Save to CSV for reference
df_top.to_csv('/workspace/top_accounts_metrics.csv', index=False)

