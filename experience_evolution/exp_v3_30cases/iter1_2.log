        ROW_NUMBER() OVER (PARTITION BY pa.customer_id ORDER BY pa.transaction_date DESC) as rn
    FROM quickbooks__profitability_analysis pa
),
distinct_vol AS (
    SELECT customer_id, customer_margin_volatility
    FROM latest_volatility
    WHERE rn = 1
),
ordered_vol AS (
    SELECT customer_id, customer_margin_volatility,
           ROW_NUMBER() OVER (ORDER BY customer_margin_volatility DESC) as row_num,
           COUNT(*) OVER () as total
    FROM distinct_vol
)
SELECT 
    MIN(customer_margin_volatility) as vol_at_75th_percentile
FROM ordered_vol
WHERE row_num <= CAST(total * 0.25 AS INTEGER);", output="direct")
