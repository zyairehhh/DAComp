high_risk_df['category'] = 'High-Risk'
normal_df['category'] = 'Normal'

# Combine for comparison
comparison_df = pd.concat([high_risk_df[['category', 'customer_lifespan_days', 'total_invoices', 'avg_invoice_amount']],
                          normal_df[['category', 'customer_lifespan_days', 'total_invoices', 'avg_invoice_amount']]])

# 3.1 Comparative box plots
fig4, axes = plt.subplots(1, 3, figsize=(15, 5))
metrics = ['customer_lifespan_days', 'total_invoices', 'avg_invoice_amount']
metric_names = ['Customer Lifespan (Days)', 'Total Invoices', 'Average Invoice Amount ($)']
colors = ['#2E86AB', '#D1495B']

for idx, (metric, metric_name) in enumerate(zip(metrics, metric_names)):
    data = [comparison_df[comparison_df['category'] == 'High-Risk'][metric].dropna(), 
            comparison_df[comparison_df['category'] == 'Normal'][metric].dropna()]
    
    bp = axes[idx].boxplot(data, patch_artist=True, labels=['High-Risk', 'Normal'])
    
    # Color boxes
    for patch, color in zip(bp['boxes'], colors):
        patch.set_facecolor(color)
    
    axes[idx].set_title(f'{metric_name} Comparison', fontsize=12, fontweight='bold')
    axes[idx].set_ylabel(metric_name, fontsize=10)
    axes[idx].grid(True, alpha=0.3)

fig4.suptitle('Comparative Analysis: High-Risk vs. Normal Customers', fontsize=16, fontweight='bold')
plt.tight_layout()
plt.savefig('customer_comparison.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created customer_comparison.png")

# 4. Profitability tier analysis
print("Creating profitability tier visualization...")
profitability_query = """
SELECT 
    CASE 
        WHEN profitability_tier = 'Loss Making' THEN 'Loss Making'
        WHEN profitability_tier = 'Break Even' THEN 'Break Even'
        WHEN profitability_tier = 'Profitable' THEN 'Profitable'
        WHEN profitability_tier = 'Highly Profitable' THEN 'Highly Profitable'
        ELSE 'Other'
    END as tier,
    COUNT(*) as count
FROM quickbooks__profitability_analysis
GROUP BY tier
ORDER BY 
    CASE tier
        WHEN 'Loss Making' THEN 1
        WHEN 'Break Even' THEN 2
        WHEN 'Profitable' THEN 3
        WHEN 'Highly Profitable' THEN 4
        ELSE 5
    END
"""

profitability_df = pd.read_sql_query(profitability_query, conn)

# Create bar chart
fig5, ax5 = plt.subplots(figsize=(10, 6))
bars = ax5.bar(profitability_df['tier'], profitability_df['count'], 
               color=['#D1495B', '#EDAE49', '#2E86AB', '#59CD90'])

ax5.set_xlabel('Profitability Tier', fontsize=12)
ax5.set_ylabel('Number of Customers', fontsize=12)
ax5.set_title('Customer Distribution by Profitability Tier', fontsize=14, fontweight='bold')

# Add count labels on bars
for bar in bars:
    height = bar.get_height()
    ax5.text(bar.get_x() + bar.get_width()/2., height + 5,
            f'{height:,}', ha='center', va='bottom', fontsize=10)

ax5.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('profitability_tiers.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created profitability_tiers.png")

# 5. Cash flow forecast for next 6 months
print("Creating cash flow forecast visualization...")
cashflow_query = """
SELECT 
    forecast_date,
    net_cash_flow
FROM quickbooks__cashflow_forecast
WHERE forecast_date >= '2025-10-01'
ORDER BY forecast_date
LIMIT 6
"""

cashflow_df = pd.read_sql_query(cashflow_query, conn)

if not cashflow_df.empty:
    fig6, ax6 = plt.subplots(figsize=(10, 6))
    
    # Convert dates to month names
    cashflow_df['month'] = pd.to_datetime(cashflow_df['forecast_date']).dt.strftime('%b %Y')
    
    ax6.plot(cashflow_df['month'], cashflow_df['net_cash_flow'], 
             marker='o', linewidth=2, markersize=8, color='#2E86AB')
    
    # Fill area under line
    ax6.fill_between(cashflow_df['month'], cashflow_df['net_cash_flow'], 
                     alpha=0.2, color='#2E86AB')
    
    ax6.set_xlabel('Month', fontsize=12)
    ax6.set_ylabel('Net Cash Flow ($)', fontsize=12)
    ax6.set_title('6-Month Cash Flow Forecast', fontsize=14, fontweight='bold')
    
    # Add value labels
    for x, y in zip(cashflow_df['month'], cashflow_df['net_cash_flow']):
        ax6.text(x, y + 500, f'${y:,.0f}', ha='center', va='bottom', fontsize=10)
    
    ax6.grid(True, alpha=0.3)
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig('cashflow_forecast.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created cashflow_forecast.png")
else:
    print("No cash flow forecast data found for next 6 months")

# Create tiered risk segmentation visualization based on Stage1 report
print("Creating tiered risk segmentation visualization...")

# Create risk tiers based on Stage1 report
high_risk_df['risk_tier'] = pd.cut(high_risk_df['risk_score'], 
                                   bins=[0, 45, 60, 100], 
                                   labels=['Green Zone (< 45)', 'Yellow Zone (45-60)', 'Red Zone (> 60)'])

tier_counts = high_risk_df['risk_tier'].value_counts().sort_index()

fig7, ax7 = plt.subplots(figsize=(10, 6))
colors = ['#59CD90', '#EDAE49', '#D1495B']
bars = ax7.bar([str(x) for x in tier_counts.index], tier_counts.values, color=colors)

ax7.set_xlabel('Risk Tier', fontsize=12)
ax7.set_ylabel('Number of Customers', fontsize=12)
ax7.set_title('High-Risk Customer Segmentation by Risk Score', fontsize=14, fontweight='bold')

# Add percentage labels
total_high_risk = len(high_risk_df)
for bar in bars:
    height = bar.get_height()
    percentage = (height / total_high_risk) * 100
    ax7.text(bar.get_x() + bar.get_width()/2., height + 2,
            f'{height} ({percentage:.1f}%)', ha='center', va='bottom', fontsize=10)

ax7.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('risk_tier_segmentation.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created risk_tier_segmentation.png")

# 6. Outstanding balance by risk tier
print("Creating outstanding balance by risk tier visualization...")

if 'risk_tier' in high_risk_df.columns:
