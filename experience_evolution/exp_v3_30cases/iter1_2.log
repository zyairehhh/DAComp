import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
# Use default fonts for English; no Chinese characters needed.
matplotlib.rcParams.update({'font.size': 12})

conn = sqlite3.connect('dacomp-018.sqlite')

# 1. Profit per customer by Segment
query1 = """
SELECT c."Customer Segment",
       SUM(o.profit) as total_profit,
       COUNT(DISTINCT o."Customer ID") as num_customers,
       SUM(o.profit)*1.0/COUNT(DISTINCT o."Customer ID") as profit_per_customer
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c."Customer Segment"
ORDER BY profit_per_customer DESC
"""
df1 = pd.read_sql_query(query1, conn)
fig, ax = plt.subplots(figsize=(8,5))
bars = ax.bar(df1['Customer Segment'], df1['profit_per_customer'], color='skyblue')
ax.set_title('Profit per Customer for Fashion by Customer Segment')
ax.set_ylabel('Profit per Customer ($)')
ax.set_xlabel('Customer Segment')
# Add value labels
for bar in bars:
    height = bar.get_height()
    ax.annotate(f'{height:,.0f}',
                xy=(bar.get_x() + bar.get_width() / 2, height),
                xytext=(0, 3), textcoords="offset points",
                ha='center', va='bottom')
plt.tight_layout()
plt.savefig('profit_per_customer_by_segment.png', dpi=300)
plt.close()

# 2. Profit by Age Group
query2 = """
SELECT CASE WHEN c.age < 20 THEN '<20'
            WHEN c.age BETWEEN 20 AND 29 THEN '20-29'
            WHEN c.age BETWEEN 30 AND 39 THEN '30-39'
            WHEN c.age BETWEEN 40 AND 49 THEN '40-49'
            WHEN c.age BETWEEN 50 AND 59 THEN '50-59'
            ELSE '60+' END as age_group,
       SUM(o.profit) as total_profit,
       COUNT(DISTINCT o."Customer ID") as num_customers,
       SUM(o.profit)*1.0/COUNT(DISTINCT o."Customer ID") as profit_per_customer
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY age_group
ORDER BY total_profit DESC
"""
df2 = pd.read_sql_query(query2, conn)
fig, ax = plt.subplots(figsize=(8,5))
bars2 = ax.bar(df2['age_group'], df2['profit_per_customer'], color='lightcoral')
ax.set_title('Profit per Customer for Fashion by Age Group')
ax.set_ylabel('Profit per Customer ($)')
ax.set_xlabel('Age Group')
for bar in bars2:
    height = bar.get_height()
    ax.annotate(f'{height:,.0f}',
                xy=(bar.get_x() + bar.get_width() / 2, height),
                xytext=(0, 3), textcoords="offset points",
                ha='center', va='bottom')
plt.tight_layout()
plt.savefig('profit_per_customer_by_age.png', dpi=300)
plt.close()

# 3. Profit per customer by Region (top 10)
query3 = """
SELECT c.Region,
       SUM(o.profit) as total_profit,
       COUNT(DISTINCT o."Customer ID") as num_customers,
       SUM(o.profit)*1.0/COUNT(DISTINCT o."Customer ID") as profit_per_customer
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
   AND c.Region IS NOT NULL
GROUP BY c.Region
HAVING num_customers >= 5
ORDER BY profit_per_customer DESC
LIMIT 10
"""
df3 = pd.read_sql_query(query3, conn)
fig, ax = plt.subplots(figsize=(10,5))
bars3 = ax.bar(df3['Region'], df3['profit_per_customer'], color='lightgreen')
ax.set_title('Top 10 Regions by Profit per Customer (Fashion)')
ax.set_ylabel('Profit per Customer ($)')
ax.set_xlabel('Region')
plt.xticks(rotation=45, ha='right')
for bar in bars3:
    height = bar.get_height()
    ax.annotate(f'{height:,.0f}',
                xy=(bar.get_x() + bar.get_width() / 2, height),
                xytext=(0, 3), textcoords="offset points",
                ha='center', va='bottom')
plt.tight_layout()
plt.savefig('profit_per_customer_by_region_top10.png', dpi=300)
plt.close()

# 4. Browsing engagement vs profit correlation (average profit per customer vs avg likes, shares, cart)
query4 = """
SELECT pb."Customer ID",
       AVG(pb."like") as avg_like,
       AVG(pb.share) as avg_share,
       AVG(pb."Add to Cart") as avg_cart,
       SUM(o.profit) as total_profit,
       COUNT(o."Order ID") as order_count
FROM product_browsing pb
LEFT JOIN order_information o ON pb."Customer ID" = o."Customer ID" AND pb."Product Category" = o."Product Category" AND pb.Product = o.Product
WHERE pb."Product Category" = 'Fashion'
GROUP BY pb."Customer ID"
HAVING order_count > 0
LIMIT 1000
"""
df4 = pd.read_sql_query(query4, conn)
# Scatter plot: avg_like vs total_profit
fig, axes = plt.subplots(1, 3, figsize=(15, 4))
axes[0].scatter(df4['avg_like'], df4['total_profit'], alpha=0.5, s=10)
axes[0].set_xlabel('Average Likes per Browsing Session')
axes[0].set_ylabel('Total Profit ($)')
axes[0].set_title('Profit vs Likes')
axes[1].scatter(df4['avg_share'], df4['total_profit'], alpha=0.5, s=10, color='orange')
axes[1].set_xlabel('Average Shares per Browsing Session')
axes[1].set_ylabel('Total Profit ($)')
axes[1].set_title('Profit vs Shares')
axes[2].scatter(df4['avg_cart'], df4['total_profit'], alpha=0.5, s=10, color='green')
axes[2].set_xlabel('Average Add to Cart per Browsing Session')
axes[2].set_ylabel('Total Profit ($)')
axes[2].set_title('Profit vs Add to Cart')
plt.tight_layout()
plt.savefig('profit_vs_engagement.png', dpi=300)
plt.close()

conn.close()
print("Plots saved.")
```
