import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
import os

# Set plotting style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("Set2")

# Connect to database
conn = sqlite3.connect('dacomp-076.sqlite')

# Query 1: Get segment-level anomaly rates (fixed SQL)
query1 = """
WITH segment_avgs AS (
    SELECT 
        profitability_segment,
        AVG(retention_probability) as segment_avg_retention,
        COUNT(*) as total_customers
    FROM netsuite2_customer_analytics
    GROUP BY profitability_segment
),
customer_flags AS (
    SELECT 
        n.*,
        s.segment_avg_retention,
        CASE WHEN ABS(n.retention_probability - s.segment_avg_retention) > 0.15 THEN 1 ELSE 0 END as is_anomaly
    FROM netsuite2_customer_analytics n
    JOIN segment_avgs s ON n.profitability_segment = s.profitability_segment
),
segment_stats AS (
    SELECT 
        profitability_segment,
        segment_avg_retention,
        total_customers,
        SUM(is_anomaly) as anomaly_count
    FROM customer_flags
    GROUP BY profitability_segment, segment_avg_retention, total_customers
)
SELECT 
    profitability_segment,
    ROUND(segment_avg_retention, 3) as segment_avg_retention,
    total_customers,
    anomaly_count,
    ROUND(100.0 * anomaly_count / total_customers, 1) as anomaly_rate_percent
FROM segment_stats
ORDER BY segment_avg_retention DESC
"""

segment_df = pd.read_sql_query(query1, conn)

# Query 2: Get anomaly vs normal customer characteristics
query2 = """
WITH segment_avgs AS (
    SELECT 
        profitability_segment,
        AVG(retention_probability) as segment_avg
    FROM netsuite2_customer_analytics
    GROUP BY profitability_segment
),
customer_flags AS (
    SELECT 
        a.*,
        s.segment_avg,
        CASE WHEN ABS(a.retention_probability - s.segment_avg) > 0.15 THEN 1 ELSE 0 END as is_anomaly
    FROM netsuite2_customer_analytics a
    JOIN segment_avgs s ON a.profitability_segment = s.profitability_segment
)
SELECT 
    is_anomaly,
    COUNT(*) as customer_count,
    AVG(transaction_count) as avg_transaction_count,
    AVG(avg_transactions_per_month) as avg_monthly_transactions,
    AVG(transaction_value_volatility) as avg_volatility,
    AVG(comprehensive_customer_score) as avg_score,
    AVG(total_revenue) as avg_revenue,
    AVG(100.0 * q4_transactions / (q1_transactions + q2_transactions + q3_transactions + q4_transactions)) as q4_percentage,
    AVG(q1_transactions) as avg_q1,
    AVG(q2_transactions) as avg_q2,
    AVG(q3_transactions) as avg_q3,
    AVG(q4_transactions) as avg_q4
FROM customer_flags
GROUP BY is_anomaly
"""

anomaly_df = pd.read_sql_query(query2, conn)

# Query 3: Get seasonal concentration (HHI) - compute in Python
query3 = """
WITH segment_avgs AS (
    SELECT 
        profitability_segment,
        AVG(retention_probability) as segment_avg
    FROM netsuite2_customer_analytics
    GROUP BY profitability_segment
)
SELECT 
    a.*,
    CASE WHEN ABS(a.retention_probability - s.segment_avg) > 0.15 THEN 1 ELSE 0 END as is_anomaly,
    q1_transactions,
    q2_transactions,
    q3_transactions,
    q4_transactions
FROM netsuite2_customer_analytics a
JOIN segment_avgs s ON a.profitability_segment = s.profitability_segment
"""

hhi_data = pd.read_sql_query(query3, conn)

# Compute HHI in Python
def compute_hhi(row):
    total = row['q1_transactions'] + row['q2_transactions'] + row['q3_transactions'] + row['q4_transactions']
    if total > 0:
        hhi = (row['q1_transactions']**2 + row['q2_transactions']**2 + 
               row['q3_transactions']**2 + row['q4_transactions']**2) / (total**2)
        return hhi
    return 0

hhi_data['seasonal_hhi'] = hhi_data.apply(compute_hhi, axis=1)

# Query 4: Get value alignment data
query4 = """
WITH segment_avgs AS (
    SELECT 
        profitability_segment,
        AVG(retention_probability) as segment_avg
    FROM netsuite2_customer_analytics
    GROUP BY profitability_segment
),
customer_flags AS (
