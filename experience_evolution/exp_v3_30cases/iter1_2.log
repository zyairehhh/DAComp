import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import calendar

# Connect to database
conn = sqlite3.connect('dacomp-094.sqlite')

# Load tables
persons_df = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
flow_df = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)
events_df = pd.read_sql_query("SELECT * FROM klaviyo__events", conn)

print("Persons rows:", persons_df.shape[0])
print("Flow rows:", flow_df.shape[0])
print("Events rows:", events_df.shape[0])

# Mapping campaign id to subject line
campaign_subject = events_df[['campaign_name', 'campaign_subject_line']].drop_duplicates()
print("\nCampaign-subject mapping:")
print(campaign_subject)

# For each person-campaign in flow, find earliest event timestamp
# We'll join on person_id and campaign_name via last_touch_campaign_id
campaign_id_to_name = events_df[['last_touch_campaign_id', 'campaign_name']].drop_duplicates()
print("\nCampaign ID to name mapping:")
print(campaign_id_to_name)

# Merge flow with campaign_id_to_name
flow_with_name = flow_df.merge(campaign_id_to_name, on='last_touch_campaign_id', how='left')
# Rename original first_event_at column to avoid conflict
flow_with_name = flow_with_name.rename(columns={'first_event_at': 'flow_first_event_at'})
# Drop rows where campaign_name is missing (no corresponding event)
flow_with_name = flow_with_name.dropna(subset=['campaign_name'])
print("\nFlow with campaign name (after dropping missing):")
print(flow_with_name[['person_id', 'last_touch_campaign_id', 'campaign_name']])

# Now get earliest event timestamp per person and campaign
events_df['occurred_at'] = pd.to_datetime(events_df['occurred_at'])
earliest_events = events_df.groupby(['person_id', 'campaign_name'])['occurred_at'].min().reset_index()
earliest_events.rename(columns={'occurred_at': 'first_event_at'}, inplace=True)

# Merge flow_with_name with earliest_events on person_id and campaign_name
flow_with_time = flow_with_name.merge(earliest_events, on=['person_id', 'campaign_name'], how='left')
print("\nFlow with first event time:")
print(flow_with_time[['person_id', 'campaign_name', 'first_event_at']])

# Merge with subject line
flow_with_time_subject = flow_with_time.merge(campaign_subject, on='campaign_name', how='left')
print("\nFlow with subject line:")
print(flow_with_time_subject[['person_id', 'campaign_name', 'campaign_subject_line', 'first_event_at']])

# Compute open_rate and click_rate from flow table
flow_with_time_subject['open_rate'] = flow_with_time_subject['count_opened_email'] / flow_with_time_subject['count_received_email']
flow_with_time_subject['click_rate'] = flow_with_time_subject['count_clicked_email'] / flow_with_time_subject['count_received_email']
flow_with_time_subject['click_to_open_rate'] = flow_with_time_subject['email_click_to_open_rate_touch']

# Merge with persons to get retention rates
person_retention = persons_df[['person_id', 'active_retention_rate_week', 'active_retention_rate_month']]
merged_df = flow_with_time_subject.merge(person_retention, on='person_id', how='left')

print("\nFinal data sample:")
print(merged_df[['person_id', 'campaign_name', 'campaign_subject_line', 'first_event_at', 'open_rate', 'click_rate', 'active_retention_rate_week', 'active_retention_rate_month']])

# Compute time window categories
def classify_weekday(dt):
    if pd.isna(dt):
        return None
    # 0 Monday, 6 Sunday
    return 'Weekend' if dt.weekday() >= 5 else 'Weekday'

merged_df['weekday_weekend'] = merged_df['first_event_at'].apply(classify_weekday)

def classify_time_of_day(dt):
    if pd.isna(dt):
        return None
    hour = dt.hour
    return 'Morning' if hour < 12 else 'Afternoon'

merged_df['time_of_day'] = merged_df['first_event_at'].apply(classify_time_of_day)

# Holiday proximity (US federal holidays list for 2023-2024)
holidays = [
    '2023-01-01', '2023-01-16', '2023-02-20', '2023-05-29', '2023-06-19', '2023-07-04',
    '2023-09-04', '2023-10-09', '2023-11-10', '2023-11-23', '2023-12-25',
    '2024-01-01', '2024-01-15', '2024-02-19', '2024-05-27', '2024-06-19', '2024-07-04',
    '2024-09-02', '2024-10-14', '2024-11-11', '2024-11-28', '2024-12-25'
]
holiday_dates = pd.to_datetime(holidays)

def days_to_nearest_holiday(dt):
    if pd.isna(dt):
        return None
    # Compute absolute difference to each holiday
    diffs = [(dt - h).days for h in holiday_dates]
    min_diff = min(abs(d) for d in diffs)
    return min_diff

merged_df['days_to_holiday'] = merged_df['first_event_at'].apply(lambda x: days_to_nearest_holiday(x) if pd.notna(x) else None)

def classify_holiday_proximity(dt):
    if pd.isna(dt):
        return None
    diff = days_to_nearest_holiday(dt)
    if diff <= 3:
        # Determine before or after holiday by checking sign of difference
        diffs = [(dt - h).days for h in holiday_dates]
        # find holiday with minimum absolute diff
        abs_diffs = [abs(d) for d in diffs]
        idx = abs_diffs.index(min(abs_diffs))
        signed_diff = diffs[idx]
        if signed_diff >= -3 and signed_diff < 0:
            return 'Before Holiday'
        elif signed_diff >= 0 and signed_diff <= 3:
            return 'After Holiday'
        else:
            return 'Not Near'
    else:
        return 'Not Near'

merged_df['holiday_proximity'] = merged_df['first_event_at'].apply(lambda x: classify_holiday_proximity(x) if pd.notna(x) else None)

print("\nData with time windows:")
print(merged_df[['campaign_subject_line', 'weekday_weekend', 'time_of_day', 'holiday_proximity', 'open_rate', 'click_rate', 'active_retention_rate_week', 'active_retention_rate_month']])

# Group by subject line and time windows to compute aggregated metrics
group_cols = ['campaign_subject_line', 'weekday_weekend', 'time_of_day', 'holiday_proximity']
# Remove rows where any grouping column is None
agg_df = merged_df.dropna(subset=group_cols)
agg_df = agg_df.groupby(group_cols).apply(
    lambda x: pd.Series({
        'num_persons': len(x),
        'total_received': x['count_received_email'].sum(),
        'avg_open_rate': (x['open_rate'] * x['count_received_email']).sum() / x['count_received_email'].sum() if x['count_received_email'].sum() > 0 else 0,
        'avg_click_rate': (x['click_rate'] * x['count_received_email']).sum() / x['count_received_email'].sum() if x['count_received_email'].sum() > 0 else 0,
        'avg_click_to_open': (x['click_to_open_rate'] * x['count_opened_email']).sum() / x['count_opened_email'].sum() if x['count_opened_email'].sum() > 0 else 0,
        'avg_retention_week': x['active_retention_rate_week'].mean(),
        'avg_retention_month': x['active_retention_rate_month'].mean()
    })
).reset_index()

print("\nAggregated metrics per segment:")
print(agg_df.to_string())

# Also aggregate by subject line alone
subject_agg = merged_df.groupby('campaign_subject_line').apply(
    lambda x: pd.Series({
        'num_persons': len(x),
        'total_received': x['count_received_email'].sum(),
        'avg_open_rate': (x['open_rate'] * x['count_received_email']).sum() / x['count_received_email'].sum(),
        'avg_click_rate': (x['click_rate'] * x['count_received_email']).sum() / x['count_received_email'].sum(),
        'avg_retention_week': x['active_retention_rate_week'].mean(),
        'avg_retention_month': x['active_retention_rate_month'].mean()
    })
).reset_index()
print("\nAggregated by subject line:")
print(subject_agg.to_string())

# Save results to CSV for manual review
agg_df.to_csv('aggregated_segments.csv', index=False)
subject_agg.to_csv('aggregated_subject.csv', index=False)
merged_df.to_csv('merged_data.csv', index=False)

conn.close()
