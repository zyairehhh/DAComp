import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-071.sqlite')

pass_reasons = ("Advanced to next stage", "Proceeding", "Hired", "Qualified")

query = """
SELECT stage,
       COUNT(*) as total_records,
       AVG(days_in_stage) as avg_days,
       SUM(CASE WHEN archive_reason IN """ + str(pass_reasons) + """ THEN 1 ELSE 0 END) as pass_records
FROM lever__opportunity_stage_history
GROUP BY stage
HAVING total_records >= 100
ORDER BY stage;
"""

df = pd.read_sql_query(query, conn)
print(df)

df['pass_rate'] = df['pass_records'] / df['total_records']
df['attrition_rate'] = 1 - df['pass_rate']
df['efficiency_index'] = df['pass_rate'] / df['avg_days'] * 100

print("\nAll stages with at least 100 samples:")
print(df[['stage','total_records','avg_days','attrition_rate','pass_rate','efficiency_index']])

print("\nFilter: avg_days > 25 and attrition_rate > 0.4:")
filtered = df[(df['avg_days'] > 25) & (df['attrition_rate'] > 0.4)]
print(filtered[['stage','total_records','avg_days','attrition_rate','pass_rate','efficiency_index']])

print("\nFilter: efficiency_index < 1.5:")
low_efficiency = df[df['efficiency_index'] < 1.5]
print(low_efficiency[['stage','total_records','avg_days','attrition_rate','pass_rate','efficiency_index']])

