import pandas as pd
import numpy as np

# Load metrics
metrics = pd.read_csv('enterprise_metrics.csv')
# Load churn and optimal rates
optimal_rates = {'A': 0.0465, 'B': 0.0825, 'C': 0.1105, 'D': None}
# Default probabilities from earlier
default_prob = {'A': 0.0, 'B': 1/38, 'C': 2/34, 'D': 1.0}
# Churn at optimal rate (need churn data)
import sqlite3
conn = sqlite3.connect('dacomp-001.sqlite')
churn_df = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)
conn.close()

# Interpolate to get churn at optimal rates
def get_churn(rating, rate):
    col = f'Credit Rating {rating} Customer Churn Rate'
    # find nearest rate in table
    idx = (churn_df['Annual Loan Interest Rate'] - rate).abs().argmin()
    return churn_df.loc[idx, col]
    
churn_at_opt = {rating: get_churn(rating, optimal_rates[rating]) if rating != 'D' else None for rating in ['A','B','C']}
print("Optimal churn:", churn_at_opt)

# Compute for each enterprise
metrics['optimal_rate'] = metrics['Credit Rating'].map(optimal_rates)
metrics['default_prob'] = metrics['Credit Rating'].map(default_prob)
metrics['churn'] = metrics.apply(lambda row: get_churn(row['Credit Rating'], row['optimal_rate']) if row['Credit Rating'] != 'D' else np.nan, axis=1)
metrics['prob_taking'] = 1 - metrics['churn']

# Expected profit per unit credit
def expected_profit(row):
    if row['Credit Rating'] == 'D':
        return -1  # negative
    r = row['optimal_rate']
    d = row['default_prob']
    c = row['churn']
    # simplified formula: (1 - c) * (r * (1 - d) - d)
    return (1 - c) * (r * (1 - d) - d)

metrics['expected_profit_per_unit'] = metrics.apply(expected_profit, axis=1)
print(metrics[['Enterprise Code', 'Credit Rating', 'optimal_rate', 'churn', 'default_prob', 'expected_profit_per_unit']].head())

# Compute a capacity score based on total_sales (maybe normalized)
# Risk weight based on profit stability and dependency
# Normalize profit_cv (lower is better) and dependency (lower is better)
# Manual min-max normalization
def minmax_normalize(series):
    min_val = series.min()
    max_val = series.max()
    if max_val == min_val:
        return pd.Series([0.5]*len(series), index=series.index)
    return (series - min_val) / (max_val - min_val)

# Profit stability: higher cv indicates lower stability; we can use 1/(1+cv) already computed as profit_stability
metrics['profit_stability_norm'] = minmax_normalize(metrics['profit_stability'])

# Combine supplier and buyer dependency (higher dependency = riskier); we can take max
metrics['dependency'] = metrics[['supplier_dependency','buyer_dependency']].max(axis=1)
metrics['dependency_norm'] = 1 - minmax_normalize(metrics['dependency'])  # higher is better

# Combine into a risk score weight (0 risky, 1 safe) with equal weights
metrics['risk_weight'] = 0.5 * metrics['profit_stability_norm'] + 0.5 * metrics['dependency_norm']
# Adjust for rating: multiply by (1 - default_prob)
metrics['risk_weight'] *= (1 - metrics['default_prob'])

# Capacity score = total_sales * risk_weight * expected_profit_per_unit (or just total_sales)
metrics['capacity_score'] = metrics['total_sales'] * metrics['risk_weight'] * metrics['expected_profit_per_unit'].clip(lower=0)

# Exclude rating D
eligible = metrics[metrics['Credit Rating'] != 'D'].copy()
# Normalize capacity score to sum to 1
total_score = eligible['capacity_score'].sum()
if total_score == 0:
    eligible['score_norm'] = 1 / len(eligible)  # fallback equal distribution
else:
    eligible['score_norm'] = eligible['capacity_score'] / total_score

# Total credit limit
total_credit = 100_000_000  # RMB 100 million
eligible['credit_limit'] = eligible['score_norm'] * total_credit

print(f"Total allocated to A, B, C: {eligible['credit_limit'].sum():,.2f}")
summary = eligible.groupby('Credit Rating').agg(
    count=('Enterprise Code', 'count'),
    avg_credit_limit=('credit_limit', 'mean'),
    sum_credit_limit=('credit_limit', 'sum')
).reset_index()
print(summary)

# Save allocation
eligible[['Enterprise Code', 'Credit Rating', 'total_sales', 'profit_cv', 'dependency', 'risk_weight', 'expected_profit_per_unit', 'credit_limit', 'optimal_rate']].to_csv('credit_allocation.csv', index=False)
print("Allocation saved to credit_allocation.csv")

# Compute total expected profit
eligible['expected_profit'] = eligible['credit_limit'] * eligible['expected_profit_per_unit']
print(f"Total expected profit per annum: {eligible['expected_profit'].sum():,.2f} RMB")

# Also compute total interest revenue and default loss
eligible['interest_revenue'] = eligible['credit_limit'] * eligible['optimal_rate'] * eligible['prob_taking']
eligible['expected_default_loss'] = eligible['credit_limit'] * eligible['default_prob']
print(f"Total expected interest revenue: {eligible['interest_revenue'].sum():,.2f} RMB")
print(f"Total expected default loss: {eligible['expected_default_loss'].sum():,.2f} RMB")
print(f"Expected net profit (revenue - loss): {eligible['interest_revenue'].sum() - eligible['expected_default_loss'].sum():,.2f} RMB")
```
