import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from datetime import datetime, timedelta
import matplotlib

# Set style
sns.set_style("whitegrid")

# Connect to database
conn = sqlite3.connect('dacomp-094.sqlite')

# 1. Load persons data
persons = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)

# 2. Load person_campaign_flow data
flow = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)

# 3. Load events data
events = pd.read_sql_query("SELECT * FROM klaviyo__events", conn)

# 4. Merge flow with subject line from events (distinct campaign-subject mapping)
campaign_subject = events[['last_touch_campaign_id', 'campaign_subject_line']].drop_duplicates()
flow = flow.merge(campaign_subject, on='last_touch_campaign_id', how='left')

# 5. Compute derived metrics for flow
flow['first_event_at'] = pd.to_datetime(flow['first_event_at'])
flow['day_of_week'] = flow['first_event_at'].dt.dayofweek  # Monday=0
flow['hour'] = flow['first_event_at'].dt.hour
flow['is_weekend'] = flow['day_of_week'] >= 5
flow['time_window'] = flow['hour'].apply(lambda x: 'Morning (0-12h)' if x < 12 else 'Afternoon (12-24h)')

# 6. Compute open_rate and click_rate from flow? Actually email_open_rate_touch is present
# Let's compute click rate from counts if available
if 'count_clicked_email' in flow.columns and 'count_received_email' in flow.columns:
    flow['click_rate'] = flow['count_clicked_email'] / flow['count_received_email'].replace(0, np.nan)
if 'email_open_rate_touch' in flow.columns:
    flow['open_rate'] = flow['email_open_rate_touch']

# 7. Compute retention rates from persons? We'll need to join persons with flow.
# Since each flow row has a person_id, we can join with persons.
flow = flow.merge(persons[['person_id', 'active_retention_rate_week', 'active_retention_rate_month', 'email_open_rate']],
                  on='person_id', how='left', suffixes=('_flow', '_person'))

# 8. Plot 1: Open rate by subject line
plt.figure(figsize=(8,5))
subject_open = flow.groupby('campaign_subject_line')['email_open_rate_touch'].mean().reset_index()
sns.barplot(x='campaign_subject_line', y='email_open_rate_touch', data=subject_open, palette='Blues_d')
plt.title('Average Email Open Rate by Subject Line Theme')
plt.xlabel('Subject Line Theme')
plt.ylabel('Open Rate')
plt.tight_layout()
plt.savefig('open_rate_by_subject.png')
plt.close()

# 9. Plot 2: Open rate by weekday vs weekend
plt.figure(figsize=(8,5))
weekend_open = flow.groupby('is_weekend')['email_open_rate_touch'].mean().reset_index()
weekend_open['is_weekend'] = weekend_open['is_weekend'].map({True: 'Weekend', False: 'Weekday'})
sns.barplot(x='is_weekend', y='email_open_rate_touch', data=weekend_open, palette='Greens_d')
plt.title('Email Open Rate: Weekday vs Weekend')
plt.xlabel('Day Type')
plt.ylabel('Open Rate')
plt.tight_layout()
plt.savefig('open_rate_weekday_weekend.png')
plt.close()

# 10. Plot 3: Open rate by morning vs afternoon
plt.figure(figsize=(8,5))
time_open = flow.groupby('time_window')['email_open_rate_touch'].mean().reset_index()
sns.barplot(x='time_window', y='email_open_rate_touch', data=time_open, palette='Oranges_d')
plt.title('Email Open Rate: Morning vs Afternoon')
plt.xlabel('Time Window')
plt.ylabel('Open Rate')
plt.tight_layout()
plt.savefig('open_rate_morning_afternoon.png')
plt.close()

# 11. Plot 4: Active retention rates by subject line
retention_cols = ['active_retention_rate_week', 'active_retention_rate_month']
for col in retention_cols:
    plt.figure(figsize=(8,5))
    retention = flow.groupby('campaign_subject_line')[col].mean().reset_index()
    sns.barplot(x='campaign_subject_line', y=col, data=retention, palette='Purples_d')
    plt.title(f'Average {col.replace("_", " ").title()} by Subject Line')
    plt.xlabel('Subject Line Theme')
    plt.ylabel('Retention Rate')
    plt.tight_layout()
    plt.savefig(f'{col}_by_subject.png')
    plt.close()

# 12. Plot 5: Click-through rate (if available)
if 'click_rate' in flow.columns:
    plt.figure(figsize=(8,5))
    click_subject = flow.groupby('campaign_subject_line')['click_rate'].mean().reset_index()
    sns.barplot(x='campaign_subject_line', y='click_rate', data=click_subject, palette='Reds_d')
    plt.title('Average Click Rate by Subject Line')
    plt.xlabel('Subject Line Theme')
    plt.ylabel('Click Rate')
    plt.tight_layout()
    plt.savefig('click_rate_by_subject.png')
    plt.close()

# 13. Plot 6: Interaction between time window and subject line (heatmap)
# Since limited data, maybe skip.

# 14. Output summary statistics
summary = flow.groupby(['campaign_subject_line', 'is_weekend', 'time_window']).agg(
    open_rate=('email_open_rate_touch', 'mean'),
    retention_week=('active_retention_rate_week', 'mean'),
    retention_month=('active_retention_rate_month', 'mean')
).reset_index()
summary.to_csv('summary_statistics.csv', index=False)

conn.close()
print("Visualizations generated.")
```
