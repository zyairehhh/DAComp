normal_query = """
SELECT customer_id, customer_lifespan_days, total_invoices, avg_invoice_amount
FROM quickbooks__customer_analytics
WHERE NOT (payment_rate_percentage < 75.0 AND outstanding_balance > 15000)
"""
normal = pd.read_sql_query(normal_query, conn)

