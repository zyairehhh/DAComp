import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-013.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()
# Clean data
df['Planned Work Hours'] = pd.to_numeric(df['Planned Work Hours'], errors='coerce')
df['Actual Work Hours'] = pd.to_numeric(df['Actual Work Hours'].replace('-', np.nan), errors='coerce')
df['Completion Quality Score'] = pd.to_numeric(df['Completion Quality Score'].replace('-', np.nan), errors='coerce')
df['Task Difficulty Coefficient'] = pd.to_numeric(df['Task Difficulty Coefficient'], errors='coerce')
df['Rework Count'] = pd.to_numeric(df['Rework Count'].replace('-', np.nan), errors='coerce')
df['is_completed'] = df['Task Status'] == 'Completed'

# Compute per-task difficulty-adjusted quality?
# For each completed task, compute quality deviation from type average
type_avg = df.groupby('Task Type')['Completion Quality Score'].mean().to_dict()
df['quality_dev'] = df.apply(lambda row: row['Completion Quality Score'] - type_avg.get(row['Task Type'], np.nan) if pd.notnull(row['Completion Quality Score']) else np.nan, axis=1)

# Load performance results
perf = pd.read_csv('owner_performance.csv')
# Merge with average difficulty per owner
owner_diff = df.groupby('Task Owner')['Task Difficulty Coefficient'].mean().reset_index()
perf = perf.merge(owner_diff, on='Task Owner', how='left')
print("Correlation between composite score and average difficulty:")
print(perf[['composite_score', 'Task Difficulty Coefficient']].corr())
print("\nAverage difficulty by performance level:")
print(perf.groupby('performance_level')['Task Difficulty Coefficient'].describe())

# Also compute correlations with other metrics
metrics = ['weighted_completion_rate', 'quality_avg', 'on_time_rate', 'efficiency_avg', 'rework_avg']
corr_list = []
for m in metrics:
    corr = perf[[m, 'Task Difficulty Coefficient']].corr().iloc[0,1]
    corr_list.append((m, corr))
print("\nCorrelation of each metric with difficulty:")
for m, c in corr_list:
    print(f"{m}: {c:.4f}")

# Check if high difficulty owners are penalized unfairly
print("\nMean composite score by difficulty tertile:")
perf['difficulty_tertile'] = pd.qcut(perf['Task Difficulty Coefficient'], q=3, labels=['Low', 'Medium', 'High'])
print(perf.groupby('difficulty_tertile')['composite_score'].mean())
print(perf.groupby('difficulty_tertile')['performance_level'].value_counts(normalize=True))
```
