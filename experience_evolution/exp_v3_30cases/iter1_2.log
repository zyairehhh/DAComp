df_proj = pd.read_sql_query("""
SELECT project_id, project_name, avg_close_time_days
FROM jira__project_enhanced
""", conn)

# Get issue metrics per project
df_issues = pd.read_sql_query("""
SELECT project_name,
       AVG(regression_ratio) AS avg_regression_ratio,
       AVG(lifecycle_quality_score) AS avg_lifecycle_quality,
       AVG(lifecycle_deviation_ratio) AS avg_lifecycle_deviation,
       AVG(total_risk_score) AS avg_total_risk,
       AVG(high_complexity_risk) AS avg_high_complexity_risk,
       AVG(completion_probability) AS avg_completion_probability,
       COUNT(*) AS issue_count
FROM jira__issue_intelligence_analytics
GROUP BY project_name
""", conn)

# Merge
df = pd.merge(df_proj, df_issues, on='project_name', how='inner')

# Classify fast projects (<15 days) vs others
df['is_fast'] = df['avg_close_time_days'] < 15

print(f"Total projects: {len(df)}")
print(f"Fast projects (<15 days): {df['is_fast'].sum()}")
print(f"Slow projects (>=15 days): {len(df) - df['is_fast'].sum()}")

# Compute average quality metrics per group
fast = df[df['is_fast']]
slow = df[~df['is_fast']]

print("\n=== Fast Projects (<15 days) ===")
print(fast[['project_name', 'avg_close_time_days', 'avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation', 'avg_total_risk', 'issue_count']].head())
print("\nAverage metrics for fast projects:")
print(fast[['avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation', 'avg_total_risk', 'avg_high_complexity_risk', 'avg_completion_probability']].mean())

print("\n=== Slow Projects (>=15 days) ===")
print("Average metrics for slow projects:")
print(slow[['avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation', 'avg_total_risk', 'avg_high_complexity_risk', 'avg_completion_probability']].mean())

# Compute difference
print("\n=== Difference (Fast - Slow) ===")
fast_means = fast[['avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation', 'avg_total_risk', 'avg_high_complexity_risk', 'avg_completion_probability']].mean()
slow_means = slow[['avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation', 'avg_total_risk', 'avg_high_complexity_risk', 'avg_completion_probability']].mean()
diff = fast_means - slow_means
print(diff)

# Team stability proxy: maybe assignee churn? Let's compute distinct assignees per project and number of issues per assignee.
# We'll also compute a stability index: 1 - (unique_assignees / total_issues) (lower means more churn?)
df_assignee = pd.read_sql_query("""
SELECT project_name,
       COUNT(DISTINCT assignee_name) AS unique_assignees,
       COUNT(*) AS total_issues
FROM jira__issue_intelligence_analytics
WHERE assignee_name IS NOT NULL AND assignee_name != ''
GROUP BY project_name
""", conn)

df = pd.merge(df, df_assignee, on='project_name', how='left')
df['assignee_per_issue'] = df['unique_assignees'] / df['total_issues']
df['stability_index'] = 1 - df['assignee_per_issue']  # higher when fewer assignees per issue (i.e., more stable team)

print("\n=== Team Stability Proxy ===")
fast_stab = df[df['is_fast']]['stability_index'].mean()
slow_stab = df[~df['is_fast']]['stability_index'].mean()
print("Fast projects stability index mean:", fast_stab)
print("Slow projects stability index mean:", slow_stab)
print("Difference (Fast - Slow):", fast_stab - slow_stab)

# Additional metrics: bug issues per project from team_performance dashboard? Not per project.
# Let's compute bug issues per project by counting bug_issues from team_performance? No, that's per user aggregated across all projects.
# Instead, we can count bug issues from issue_intelligence based on issue_type? Not available.

# Compute rework frequency: maybe lifecycle_deviation_ratio is a good proxy.
print("\n=== Rework Frequency (Lifecycle Deviation Ratio) ===")
print("Fast projects deviation ratio mean:", fast['avg_lifecycle_deviation'].mean())
print("Slow projects deviation ratio mean:", slow['avg_lifecycle_deviation'].mean())

# Compute bug rate: regression ratio
print("\n=== Bug Rate (Regression Ratio) ===")
print("Fast projects regression ratio mean:", fast['avg_regression_ratio'].mean())
print("Slow projects regression ratio mean:", slow['avg_regression_ratio'].mean())

# Compute code quality: lifecycle_quality_score (higher is better)
print("\n=== Code Quality (Lifecycle Quality Score) ===")
print("Fast projects quality score mean:", fast['avg_lifecycle_quality'].mean())
print("Slow projects quality score mean:", slow['avg_lifecycle_quality'].mean())

# Risk scores
print("\n=== Total Risk Score ===")
print("Fast projects risk mean:", fast['avg_total_risk'].mean())
print("Slow projects risk mean:", slow['avg_total_risk'].mean())

# Save results for further analysis
df.to_csv('/workspace/project_metrics.csv', index=False)
print("\nSaved project_metrics.csv")

conn.close()
''')
