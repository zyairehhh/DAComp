import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
# Use default fonts, no Chinese

conn = sqlite3.connect('dacomp-093.sqlite')
# Load campaigns data
df = pd.read_sql_query("SELECT * FROM klaviyo__campaigns", conn)
conn.close()

# Parse datetime
df['scheduled_to_send_at'] = pd.to_datetime(df['scheduled_to_send_at'])
df['send_hour'] = df['scheduled_to_send_at'].dt.hour
df['send_weekday'] = df['scheduled_to_send_at'].dt.weekday  # Monday=0, Sunday=6
df['is_weekend'] = df['send_weekday'] >= 5
# time window: morning 5-11, afternoon 12-17, evening 18-23, night 0-4
def time_window(h):
    if 5 <= h <= 11:
        return 'morning'
    elif 12 <= h <= 17:
        return 'afternoon'
    elif 18 <= h <= 23:
        return 'evening'
    else:
        return 'night'
df['time_of_day'] = df['send_hour'].apply(time_window)

# Subject keyword grouping
def subject_group(subject):
    sub = subject.lower()
    if 'discount' in sub or '折' in sub:
        return 'discount'
    elif 'new' in sub or '新品' in sub or '上新' in sub:
        return 'new'
    elif 'story' in sub or '品牌故事' in sub or '用户故事' in sub or 'storytelling' in sub:
        return 'storytelling'
    else:
        return 'other'
df['subject_group'] = df['SUBJECT'].apply(subject_group)

# De-noising: exclude outliers where count_received_email is too far from median?
# We'll do a simple filter: keep rows where count_received_email between 0.5 and 2 times the median
median_received = df['count_received_email'].median()
df = df[(df['count_received_email'] >= 0.5 * median_received) & (df['count_received_email'] <= 2 * median_received)]

# Also filter out campaigns with very small audience size? We'll keep all.

# Compute aggregated metrics
agg = df.groupby(['is_archived', 'variation_id', 'is_weekend', 'time_of_day', 'subject_group']).agg(
    avg_open_rate=('email_open_rate', 'mean'),
    avg_click_to_open_rate=('email_click_to_open_rate', 'mean'),
    avg_active_days=('active_days', 'mean'),
    count_campaigns=('campaign_id', 'count')
).reset_index()

# Write to CSV for reference
agg.to_csv('aggregated_metrics.csv', index=False)

# Plot 1: Open rate by subject group and weekend/weekday, faceted by is_archived and variation_id
# Use bar plot.
