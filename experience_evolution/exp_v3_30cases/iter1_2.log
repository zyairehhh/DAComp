'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-078.sqlite')

df = pd.read_sql_query("SELECT account_id, sum_minutes, sum_events, last_event_on, avg_nps_rating FROM pendo__account", conn)
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
cutoff = pd.to_datetime('2024-09-01')
df['still_active'] = df['last_event_on'] >= cutoff  # true label: retained

# Existing model: high-value if sum_minutes > median and sum_events > median
med_minutes = df['sum_minutes'].median()
med_events = df['sum_events'].median()
df['existing_pred'] = (df['sum_minutes'] > med_minutes) & (df['sum_events'] > med_events)

# Compute accuracy
from sklearn.metrics import accuracy_score
acc = accuracy_score(df['still_active'], df['existing_pred'])
print("Accuracy of existing model (duration+frequency) vs retention as high-value:", acc)

# Confusion matrix
from sklearn.metrics import confusion_matrix
print("Confusion matrix:")
print(confusion_matrix(df['still_active'], df['existing_pred']))

# Precision, recall, f1
from sklearn.metrics import precision_score, recall_score, f1_score
precision = precision_score(df['still_active'], df['existing_pred'])
recall = recall_score(df['still_active'], df['existing_pred'])
f1 = f1_score(df['still_active'], df['existing_pred'])
print(f"Precision: {precision:.3f}, Recall: {recall:.3f}, F1: {f1:.3f}")

# Let's see if adding NPS improves prediction
df['high_nps'] = df['avg_nps_rating'] >= 8
df['new_pred'] = (df['existing_pred']) & (df['high_nps'])
acc2 = accuracy_score(df['still_active'], df['new_pred'])
print("Accuracy with added NPS condition (AND):", acc2)

# Try logistic regression but without sklearn (we'll just do simple weighted score)
# Compute weighted score: sum of normalized features
from sklearn.preprocessing import MinMaxScaler
scaler = MinMaxScaler()
features = df[['sum_minutes', 'sum_events', 'avg_nps_rating']].fillna(0)
scaled = scaler.fit_transform(features)
df['score'] = scaled[:,0]*0.4 + scaled[:,1]*0.4 + scaled[:,2]*0.2  # weights
# Determine threshold that maximizes accuracy
thresholds = [i/100 for i in range(10, 91)]
best_acc = 0
best_th = 0
for th in thresholds:
    pred = df['score'] > th
    acc_t = accuracy_score(df['still_active'], pred)
    if acc_t > best_acc:
        best_acc = acc_t
        best_th = th
print(f"Best threshold: {best_th}, Accuracy: {best_acc:.3f}")

# Check other features: count_active_days, count_active_months, count_feature_clicking_visitors
# Let's get more features
df2 = pd.read_sql_query("SELECT account_id, count_active_days, count_active_months, count_feature_clicking_visitors, count_page_viewing_visitors FROM pendo__account", conn)
df = pd.merge(df, df2, on='account_id')

# Normalize and compute a multi-dimensional score with more weights
features2 = df[['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors']].fillna(0)
scaler2 = MinMaxScaler()
scaled2 = scaler2.fit_transform(features2)
weights = [0.25, 0.25, 0.2, 0.15, 0.15]
df['score2'] = np.dot(scaled2, weights)

# Find best threshold
best_acc2 = 0
best_th2 = 0
for th in thresholds:
    pred = df['score2'] > th
    acc_t = accuracy_score(df['still_active'], pred)
    if acc_t > best_acc2:
        best_acc2 = acc_t
        best_th2 = th
print(f"Multi-dimensional score (5 features) best threshold: {best_th2}, Accuracy: {best_acc2:.3f}")

conn.close()
''')
