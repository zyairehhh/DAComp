import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import seaborn as sns
import os

# Connect to database
db_path = 'dacomp-089.sqlite'
if not os.path.exists(db_path):
    raise FileNotFoundError(f"Database not found: {db_path}")
conn = sqlite3.connect(db_path)

# 1. Identify top 20% accounts by revenue
query_accounts = """
WITH filtered_accounts AS (
    SELECT 
        account_id,
        account_name,
        annual_revenue,
        number_of_employees,
        industry_normalized,
        company_size_category as size_category,
        total_contacts
    FROM salesforce__customer_360_view 
    WHERE annual_revenue IS NOT NULL 
        AND number_of_employees IS NOT NULL
),
percentile_threshold AS (
    SELECT annual_revenue as threshold
    FROM filtered_accounts
    ORDER BY annual_revenue DESC
    LIMIT 1 OFFSET (SELECT CAST(COUNT(*) * 0.2 AS INTEGER) FROM filtered_accounts)
)
SELECT 
    a.*,
    CASE WHEN a.annual_revenue >= (SELECT threshold FROM percentile_threshold) THEN 1 ELSE 0 END as is_top20
FROM filtered_accounts a
"""
df_accounts = pd.read_sql_query(query_accounts, conn)

# 2. Get contacts per account and decision‑maker info
query_contacts = """
SELECT 
    account_id,
    COUNT(*) as contact_count,
    SUM(CASE WHEN title LIKE '%C-Level%' OR title LIKE '%VP%' OR title LIKE '%Vice President%' OR title LIKE '%Chief%' OR title LIKE '%President%' THEN 1 ELSE 0 END) as decision_maker_count,
    MAX(CASE WHEN department IN ('Sales', 'Finance', 'Operations', 'Engineering', 'HR') THEN 1 ELSE 0 END) as has_sales,  -- will aggregate later
    MAX(CASE WHEN department = 'Sales' THEN 1 ELSE 0 END) as sales_flag,
    MAX(CASE WHEN department = 'Finance' THEN 1 ELSE 0 END) as finance_flag,
    MAX(CASE WHEN department = 'Operations' THEN 1 ELSE 0 END) as ops_flag,
    MAX(CASE WHEN department = 'Engineering' THEN 1 ELSE 0 END) as eng_flag,
    MAX(CASE WHEN department = 'HR' THEN 1 ELSE 0 END) as hr_flag
FROM salesforce__contact_enhanced
WHERE account_id IN (SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue IS NOT NULL AND number_of_employees IS NOT NULL)
GROUP BY account_id
"""
df_contacts = pd.read_sql_query(query_contacts, conn)

# Merge
df = pd.merge(df_accounts, df_contacts, on='account_id', how='left')
df['contact_count'] = df['contact_count'].fillna(0)
df['decision_maker_count'] = df['decision_maker_count'].fillna(0)

# Compute metrics
df['contact_density_ratio'] = df['contact_count'] / df['number_of_employees'] * 1000
df['decision_maker_ratio'] = df['decision_maker_count'] / df['contact_count'] * 100
df['decision_maker_ratio'] = df['decision_maker_ratio'].fillna(0)

# Departmental coverage
dept_cols = ['sales_flag', 'finance_flag', 'ops_flag', 'eng_flag', 'hr_flag']
for col in dept_cols:
    df[col] = df[col].fillna(0).astype(int)
df['dept_coverage'] = df[dept_cols].sum(axis=1) / 5 * 100  # percent

# Keep top 20% only
df_top = df[df['is_top20'] == 1].copy()
print(f"Top 20% accounts: {len(df_top)}")

# Save to CSV for reference
df_top.to_csv('/workspace/top_accounts_metrics.csv', index=False)

conn.close()

print("Data prepared.")
```
