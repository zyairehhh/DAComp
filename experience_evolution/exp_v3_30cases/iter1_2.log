            ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY transaction_date DESC) as rn2
        FROM quickbooks__profitability_analysis
    ) sub ON pa.customer_id = sub.customer_id AND sub.rn2 = 1
    WHERE sub.customer_margin_volatility >= 0.256729
)
SELECT p.customer_id,
       COUNT(*) as obs_count,
