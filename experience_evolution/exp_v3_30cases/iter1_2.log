```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-090.sqlite')

# 1. Filter high-risk customers: payment_rate_percentage < 75 AND outstanding_balance > 15000
query_customers = """
SELECT 
    customer_id,
    customer_name,
    payment_rate_percentage,
    outstanding_balance,
    credit_score,
    business_stability_score,
    customer_lifespan_days,
    total_invoices,
    avg_invoice_amount,
    profitability_tier,
    credit_grade,
    rfm_segment,
    payment_behavior,
    customer_value_segment,
    risk_assessment,
    overall_customer_score
FROM quickbooks__customer_analytics
WHERE payment_rate_percentage < 75 AND outstanding_balance > 15000;
"""
high_risk_df = pd.read_sql_query(query_customers, conn)
print(f"Number of high-risk customers: {len(high_risk_df)}")

# Compute risk score
# Risk Score = (100 - payment_rate_percentage) * 0.4 + (850 - credit_score) / 850 * 100 * 0.4 + (100 - business_stability_score) * 0.2
high_risk_df['risk_score'] = (100 - high_risk_df['payment_rate_percentage']) * 0.4 + (850 - high_risk_df['credit_score']) / 850 * 100 * 0.4 + (100 - high_risk_df['business_stability_score']) * 0.2

# Save high-risk customers with risk score for later use
high_risk_df.to_csv('high_risk_customers.csv', index=False)

# 2. Calculate proportion of these customers' gross_profit to total profit of all customers
# Get gross_profit from profitability_analysis for high-risk customers
profit_query = """
SELECT 
    p.customer_id,
    p.gross_profit
FROM quickbooks__profitability_analysis p
WHERE p.customer_id IN (SELECT customer_id FROM quickbooks__customer_analytics 
                        WHERE payment_rate_percentage < 75 AND outstanding_balance > 15000);
"""
high_risk_profits = pd.read_sql_query(profit_query, conn)
total_gross_high_risk = high_risk_profits['gross_profit'].sum()

# Total gross profit across all customers
total_profit_query = "SELECT SUM(gross_profit) as total_gross_profit FROM quickbooks__profitability_analysis;"
total_gross_all = pd.read_sql_query(total_profit_query, conn).iloc[0,0]

prop = total_gross_high_risk / total_gross_all if total_gross_all != 0 else 0
print(f"Total gross profit from high-risk customers: {total_gross_high_risk}")
print(f"Total gross profit all customers: {total_gross_all}")
print(f"Proportion: {prop:.2%}")

# 3. Analyze month-over-month trend of collection_rate_percentage for last 12 months
trend_query = """
SELECT 
    dashboard_month,
    collection_rate_percentage
FROM quickbooks__financial_dashboard
ORDER BY dashboard_month DESC
LIMIT 12;
"""
trend_df = pd.read_sql_query(trend_query, conn)
trend_df['dashboard_month'] = pd.to_datetime(trend_df['dashboard_month'])
trend_df = trend_df.sort_values('dashboard_month')

# Calculate month-over-month change
trend_df['collection_change'] = trend_df['collection_rate_percentage'].diff()
trend_df['is_deterioration'] = trend_df['collection_change'] < 0

# Identify consecutive months of deterioration
consecutive = 0
max_consecutive = 0
for val in trend_df['is_deterioration']:
    if val:
        consecutive += 1
        max_consecutive = max(max_consecutive, consecutive)
    else:
        consecutive = 0
print(f"Max consecutive months of deterioration: {max_consecutive}")
# Magnitude of decline: sum of negative changes
