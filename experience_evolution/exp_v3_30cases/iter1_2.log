# Actually 34.98 vs 55.14 suggests current is about 63% of new? Let's check.
df['Price_clean'] = df['Price']  # already numeric float

# Clean new car price
df['New_Price_clean'] = df['New Car Price (incl. tax)'].apply(clean_price)

# Compute depreciation ratio
df['Depreciation_Ratio'] = df['Price_clean'] / (df['New_Price_clean'] / 10000)  # because Price is in 10k yuan units

# Clean mileage
def clean_mileage(mileage_str):
    if pd.isna(mileage_str):
        return np.nan
    s = str(mileage_str)
    # Remove commas, spaces
    s = s.replace(',', '').replace(' ', '')
    # Check if contains 'ten thousand km'
    if 'tenthousandkm' in s.replace(' ', ''):
        # Extract number before 'ten'
        match = re.search(r'([\d\.]+)', s)
        if match:
            return float(match.group(1)) * 10000
    elif 'km' in s.lower():
        # Extract number before 'km'
        match = re.search(r'([\d\.]+)', s)
        if match:
            return float(match.group(1))
    # Try convert directly
    try:
        return float(s)
    except:
        return np.nan

df['Mileage_clean'] = df['Mileage'].apply(clean_mileage)

# Parse registration date to compute age in years
df['Registration_Date'] = pd.to_datetime(df['Registration Date'], errors='coerce')
current_date = pd.Timestamp('2024-12-01')  # assume current date for analysis
df['Age_years'] = (current_date - df['Registration_Date']).dt.days / 365.25

# Extract brand from Title (first word before space)
df['Brand'] = df['Title'].str.split(' ').str[0]

# Extract model (simplified: first 2-3 words)
def extract_model(title):
    if pd.isna(title):
        return ''
    parts = title.split(' ')
    if len(parts) >= 2:
        return ' '.join(parts[:2])
    else:
        return parts[0]

df['Model_Group'] = df['Title'].apply(extract_model)

print("First few rows with cleaned columns:")
print(df[['Title', 'Price_clean', 'New_Price_clean', 'Depreciation_Ratio', 'Mileage_clean', 'Age_years', 'Brand']].head(10))

# Summary statistics
print("\nSummary of Depreciation Ratio:")
print(df['Depreciation_Ratio'].describe())

print("\nMissing values:")
print(df[['Price_clean', 'New_Price_clean', 'Depreciation_Ratio', 'Mileage_clean', 'Age_years']].isnull().sum())

# Save cleaned data for further SQL analysis
df.to_csv('cleaned_autohome.csv', index=False)
