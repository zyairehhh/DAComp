import pandas as pd
import sqlite3
conn = sqlite3.connect('dacomp-093.sqlite')
df = pd.read_sql_query('SELECT * FROM klaviyo__campaigns', conn)
conn.close()
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['order_rate'] = df['count_placed_order'] / df['count_received_email']
grouped = df.groupby('is_archived').apply(lambda g: pd.Series({
    'open_weighted': (g['open_rate'] * g['count_received_email']).sum() / g['count_received_email'].sum(),
    'click_weighted': (g['click_rate'] * g['count_received_email']).sum() / g['count_received_email'].sum(),
    'order_weighted': (g['order_rate'] * g['count_received_email']).sum() / g['count_received_email'].sum(),
    'gmv_per_opened': (g['gmv_net']).sum() / g['count_opened_email'].sum()
}))
print(grouped)
```)

