'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Connect to the database
conn = sqlite3.connect('dacomp-092.sqlite')

# Get customer data for risk rating model
query = """
SELECT 
  pa.customer_id,
  pa.customer_margin_volatility,
  pa.customer_gross_margin_pct,
  pa.customer_profit_growth_pct,
  ca.lifecycle_stage,
  ca.payment_behavior,
  ca.rfm_segment,
  ca.overall_customer_score,
  ca.risk_assessment,
  (pa.collected_amount / NULLIF(pa.invoice_total, 0)) * 100 as collection_rate
FROM quickbooks__profitability_analysis pa
LEFT JOIN quickbooks__customer_analytics ca ON pa.customer_id = ca.customer_id
WHERE pa.customer_id IS NOT NULL
"""

df = pd.read_sql_query(query, conn)
conn.close()

# Normalize the volatility score (higher = more volatile)
volatility_threshold = df['customer_margin_volatility'].quantile(0.75)
df['volatility_score'] = np.where(df['customer_margin_volatility'] >= volatility_threshold, 1, 0)

# Normalize other risk factors
# Lower gross margin = higher risk
margin_threshold = df['customer_gross_margin_pct'].quantile(0.25)
df['margin_risk_score'] = np.where(df['customer_gross_margin_pct'] <= margin_threshold, 1, 0)

# Negative profit growth = higher risk
df['growth_risk_score'] = np.where(df['customer_profit_growth_pct'] < 0, 1, 0)

# Payment behavior risk (Poor = higher risk)
payment_risk_map = {'Excellent': 0, 'Good': 1, 'Average': 2, 'Poor': 3}
df['payment_risk_score'] = df['payment_behavior'].map(payment_risk_map).fillna(2) / 3

# Lifecycle risk (New/At Risk = higher risk)
lifecycle_risk_map = {
    'New Customer': 3,
    'At Risk': 3,
    'Need Attention': 2,
    'Potential Loyalists': 1,
    'Loyal Customer': 0,
    'Mature': 0,
    'Growing': 1
}
df['lifecycle_risk_score'] = df['lifecycle_stage'].map(lifecycle_risk_map).fillna(2) / 3

# Collection rate risk (lower = higher risk)
collection_threshold = df['collection_rate'].quantile(0.25)
df['collection_risk_score'] = np.where(df['collection_rate'] <= collection_threshold, 1, 0)

# Calculate composite risk score (weights can be adjusted)
df['composite_risk_score'] = (
    df['volatility_score'] * 0.3 +
    df['margin_risk_score'] * 0.2 +
    df['growth_risk_score'] * 0.15 +
    df['payment_risk_score'] * 0.15 +
    df['lifecycle_risk_score'] * 0.1 +
    df['collection_risk_score'] * 0.1
)

# Classify customers into risk categories
def classify_risk(score):
    if score >= 0.7:
        return 'High Risk'
    elif score >= 0.4:
        return 'Medium Risk'
    else:
        return 'Low Risk'

df['risk_category'] = df['composite_risk_score'].apply(classify_risk)

print("Risk Rating Model Results:")
print(f"Total customers analyzed: {len(df)}")
print(f"\nRisk Category Distribution:")
risk_counts = df['risk_category'].value_counts()
for category, count in risk_counts.items():
    percentage = (count / len(df)) * 100
    print(f"  {category}: {count} customers ({percentage:.1f}%)")

print(f"\nHigh-volatility customers ({volatility_threshold:.3f}+) breakdown by risk:")
high_vol_risk = df[df['volatility_score'] == 1]['risk_category'].value_counts()
for category, count in high_vol_risk.items():
    percentage = (count / len(df[df['volatility_score'] == 1])) * 100
    print(f"  {category}: {count} customers ({percentage:.1f}%)")

# Visualize the risk rating model
plt.style.use('default')
fig, axes = plt.subplots(2, 3, figsize=(18, 12))

# Plot 1: Composite risk score distribution
ax1 = axes[0, 0]
bins = np.linspace(0, 1, 21)
ax1.hist(df['composite_risk_score'], bins=bins, alpha=0.7, color='steelblue', edgecolor='black')
ax1.axvline(x=0.4, color='orange', linestyle='--', linewidth=1.5, label='Medium Risk Threshold')
ax1.axvline(x=0.7, color='red', linestyle='--', linewidth=1.5, label='High Risk Threshold')
ax1.set_title('Distribution of Composite Risk Scores')
ax1.set_xlabel('Risk Score (0=Low, 1=High)')
ax1.set_ylabel('Number of Customers')
ax1.legend()
ax1.grid(True, alpha=0.3)

# Plot 2: Risk category distribution
ax2 = axes[0, 1]
colors = {'Low Risk': 'green', 'Medium Risk': 'orange', 'High Risk': 'red'}
