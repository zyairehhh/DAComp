import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-027/stage1_env/dacomp-027.sqlite')

# Load three main tables
disaster_events = pd.read_sql_query("SELECT * FROM disaster_events", conn)
environment_and_health = pd.read_sql_query("SELECT * FROM environment_and_health", conn)
beneficiaries_and_assessments = pd.read_sql_query("SELECT * FROM beneficiaries_and_assessments", conn)

# Merge
df = pd.merge(disaster_events, environment_and_health, left_on='Disaster Event ID', right_on='Disaster Reference ID', how='inner')
df = pd.merge(df, beneficiaries_and_assessments, left_on='Disaster Event ID', right_on='Distribution reference ID', how='inner')

# Define function to map categorical to severity scores
def env_impact_rate_score(val):
    mapping = {'Low': 1, 'Medium': 2, 'High': 3}
    return mapping.get(val, 0)

def waste_status_score(val):
    # Adequate is good, Critical is bad
    mapping = {'Adequate': 1, 'Limited': 2, 'Critical': 3}
    return mapping.get(val, 0)

def disease_risk_score(val):
    mapping = {'Low': 1, 'Medium': 2, 'High': 3}
    return mapping.get(val, 0)

def med_capacity_score(val):
    mapping = {'Adequate': 1, 'Limited': 2, 'Critical': 3}
    return mapping.get(val, 0)

def mental_health_score(val):
    mapping = {'Limited': 1, 'Adequate': 2, 'Comprehensive': 3}
    return mapping.get(val, 0)

# Secondary hazard numeric columns: higher is worse?
# Carbon Emissions higher worse, Water Quality lower worse, Sanitation Coverage lower worse, Vaccination lower worse
# We'll normalize within dataset for consistency.

# Compute secondary hazard score (higher = more severe secondary hazards)
df['secondary_score'] = (
    df['Environmental Impact Rate'].apply(env_impact_rate_score) +
    df['Waste Management Status'].apply(waste_status_score) +
    df['Disease Risk'].apply(disease_risk_score) +
    df['Medical Emergency Response Capacity'].apply(med_capacity_score) +
    (df['Carbon Emissions (tons)'] / df['Carbon Emissions (tons)'].max()) * 3 +  # scale 0-3
    ((100 - df['Water Quality Index']) / 100) * 3 +  # lower quality worse
    ((100 - df['Sanitation Coverage Rate']) / 100) * 3 +
    ((100 - df['Vaccination Coverage Rate']) / 100) * 3
)

# Impact on people score (higher = worse for people)
def vulnerability_score(val):
    mapping = {'Pending': 1, 'In Progress': 2, 'Complete': 3}
    return mapping.get(val, 0)

def needs_assessment_score(val):
    mapping = {'Overdue': 3, 'Due': 2, 'Updated': 1}
    return mapping.get(val, 0)

def community_engagement_score(val):
    mapping = {'Low': 3, 'Medium': 2, 'High': 1}
    return mapping.get(val, 0)

def local_capacity_score(val):
    mapping = {'Limited': 3, 'Developing': 2, 'Advanced': 1}
    return mapping.get(val, 0)

df['people_impact_score'] = (
    (3 - df['Vulnerability assessment'].apply(vulnerability_score)) +  # inverted
    df['Needs assessment status'].apply(needs_assessment_score) +
    (1 - df['Allocation fairness index']) * 3 +  # lower fairness worse
    (5 - df['Affected population feedback score']) +  # lower feedback worse, but max 5?
    df['Community engagement level'].apply(community_engagement_score) +
    df['Local capacity building'].apply(local_capacity_score)
)

# Group by Disaster Level
grouped = df.groupby('Disaster Level').agg(
    avg_secondary=('secondary_score', 'mean'),
    avg_people_impact=('people_impact_score', 'mean'),
    count=('Disaster Event ID', 'count')
).reset_index()

print("Secondary Hazard Score and People Impact by Disaster Level:")
print(grouped)

# Also compute by Disaster Type
grouped_type = df.groupby('Disaster Type').agg(
    avg_secondary=('secondary_score', 'mean'),
    avg_people_impact=('people_impact_score', 'mean'),
    count=('Disaster Event ID', 'count')
).reset_index()
print("\nBy Disaster Type:")
print(grouped_type)

# Check correlation between disaster level numeric and secondary score
level_mapping = {'Level 1': 1, 'Level 2': 2, 'Level 3': 3, 'Level 4': 4, 'Level 5': 5}
df['disaster_level_numeric'] = df['Disaster Level'].map(level_mapping)
corr = df[['disaster_level_numeric', 'secondary_score', 'people_impact_score']].corr()
print("\nCorrelation matrix:")
print(corr)

# Save to CSV for reference
grouped.to_csv('level_analysis.csv', index=False)
grouped_type.to_csv('type_analysis.csv', index=False)

conn.close()
```
