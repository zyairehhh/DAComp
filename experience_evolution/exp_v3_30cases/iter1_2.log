import sqlite3
import pandas as pd
from datetime import datetime, timedelta
import numpy as np

conn = sqlite3.connect('dacomp-057.sqlite')
df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)
df['date_day'] = pd.to_datetime(df['date_day'])
latest_date = df['date_day'].max()
last_start = latest_date - timedelta(days=30)
prev_start = last_start - timedelta(days=30)

campaign_cols = ['account_id', 'advertising_channel_type', 'campaign_lifecycle_stage']

# Determine which campaigns are active in last 30 days and running >120 days
campaign_dates = df.groupby(campaign_cols)['date_day'].agg(['min', 'max']).reset_index()
campaign_dates['min'] = pd.to_datetime(campaign_dates['min'])
campaign_dates['max'] = pd.to_datetime(campaign_dates['max'])
campaign_dates['days_running'] = (campaign_dates['max'] - campaign_dates['min']).dt.days
campaign_dates['active_last_30'] = campaign_dates['max'] >= last_start

# Filter campaigns with >120 days running and active in last 30 days
eligible = campaign_dates[(campaign_dates['days_running'] > 120) & campaign_dates['active_last_30']]
print(f"Eligible campaigns (running >120 days and active in last 30 days): {len(eligible)}")
print(eligible)

# For each eligible campaign, compute metrics
results = []
for _, row in eligible.iterrows():
    acc = row['account_id']
    channel = row['advertising_channel_type']
    stage = row['campaign_lifecycle_stage']
    sub = df[(df['account_id']==acc) & (df['advertising_channel_type']==channel) & (df['campaign_lifecycle_stage']==stage)]
    print(f"Campaign: {acc}, {channel}, {stage} - total rows {len(sub)}")
    # last 30 days subset
    last_sub = sub[sub['date_day'] >= last_start]
    # previous 30 days subset
    prev_sub = sub[(sub['date_day'] >= prev_start) & (sub['date_day'] < last_start)]
    print(f"  last_30 rows: {len(last_sub)}, prev_30 rows: {len(prev_sub)}")
    # need at least 1 day in each period
    if len(last_sub) >= 1 and len(prev_sub) >= 1:
        avg_cac_last = last_sub['customer_acquisition_cost'].mean()
        avg_cac_prev = prev_sub['customer_acquisition_cost'].mean()
        avg_ratio_last = last_sub['ltv_cac_ratio'].mean()
        avg_ratio_prev = prev_sub['ltv_cac_ratio'].mean()
        cac_growth_rate = (avg_cac_last - avg_cac_prev) / avg_cac_prev if avg_cac_prev != 0 else np.nan
        ratio_decline_rate = (avg_ratio_last - avg_ratio_prev) / avg_ratio_prev if avg_ratio_prev != 0 else np.nan
        results.append({
            'account_id': acc,
            'advertising_channel_type': channel,
            'campaign_lifecycle_stage': stage,
            'days_running': row['days_running'],
            'avg_cac_last': avg_cac_last,
            'avg_cac_prev': avg_cac_prev,
            'avg_ratio_last': avg_ratio_last,
            'avg_ratio_prev': avg_ratio_prev,
            'cac_growth_rate': cac_growth_rate,
            'ratio_decline_rate': ratio_decline_rate,
            'days_last': len(last_sub),
            'days_prev': len(prev_sub)
        })

results_df = pd.DataFrame(results)
print(f"Camps with at least 1 day in both periods: {len(results_df)}")
print(results_df)
```
