'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-098/stage1_env/dacomp-098.sqlite')

# Load conversations with tags and metrics
query = '''
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.all_conversation_tags,
    ce.all_conversation_contacts AS contact_id,
    cm.first_admin_response_at,
    cm.time_to_first_response_minutes,
    cm.conversation_rating
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm USING (conversation_id)
WHERE ce.all_conversation_tags IS NOT NULL
'''
df = pd.read_sql_query(query, conn)
print(f"Total conversations with tags: {len(df)}")

# Parse tags into columns
def extract_tag(tags, key):
    if pd.isna(tags):
        return ''
    parts = tags.split('|')
    for p in parts:
        if p.startswith(key + ':'):
            return p.split(':', 1)[1]
    return ''

df['path'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'path'))
df['stage'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'topic'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'lifecycle'))

# Map path to responder_type
df['responder_type'] = df['path'].apply(lambda x: 'bot' if x == 'bot_first' else 'human' if x == 'human_first' else 'unknown')
print(df['responder_type'].value_counts())

# For each contact, determine first conversation's responder_type
df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
df = df.sort_values(['contact_id', 'conversation_created_at'])
contact_first = df.groupby('contact_id').first().reset_index()
contact_first = contact_first[['contact_id', 'responder_type', 'stage', 'segment', 'region', 'lifecycle']]
contact_first.rename(columns={'responder_type': 'first_responder_type', 'stage': 'first_stage', 'segment': 'first_segment', 'region': 'first_region', 'lifecycle': 'first_lifecycle'}, inplace=True)
print("Unique contacts:", len(contact_first))
print(contact_first['first_responder_type'].value_counts())

# Merge back to get all conversations with first responder type
df = df.merge(contact_first[['contact_id', 'first_responder_type']], on='contact_id', how='left')

# Now compute conversion funnel: we need to define stages progression per contact.
# For each contact, we need to see if they have stage 'demo_booked', 'trial_activated', 'closed_won' (maybe paid)
# We'll create flags per contact
contact_stages = df.groupby('contact_id').agg(
    earliest_conversation=('conversation_created_at', 'min'),
    latest_conversation=('conversation_created_at', 'max'),
    stages=('stage', lambda x: list(x))
).reset_index()

# Determine max stage reached per contact (assuming ordered)
stage_order = ['contacted', 'marketing_qualified', 'demo_booked', 'trial_started', 'trial_activated', 'proposal_sent', 'closed_won', 'closed_lost', 'expansion_in_flight']
def max_stage(stages):
    # return highest stage according to order
    max_idx = -1
    for s in stages:
        if s in stage_order:
            idx = stage_order.index(s)
            if idx > max_idx:
                max_idx = idx
    if max_idx >= 0:
        return stage_order[max_idx]
    else:
        return None
contact_stages['max_stage'] = contact_stages['stages'].apply(max_stage)

# Merge with first responder type
contact_stages = contact_stages.merge(contact_first[['contact_id', 'first_responder_type']], on='contact_id', how='left')
print(contact_stages['first_responder_type'].value_counts(dropna=False))

# Compute conversion rates per responder_type
conversion_defs = {
    'demo_booked': ['demo_booked', 'trial_started', 'trial_activated', 'proposal_sent', 'closed_won', 'expansion_in_flight'],
    'trial_activated': ['trial_activated', 'proposal_sent', 'closed_won', 'expansion_in_flight'],
    'paid': ['closed_won', 'expansion_in_flight']  # assuming closed_won indicates payment
}
def reached_stage(max_stage, target_list):
    if max_stage is None:
        return False
    return max_stage in target_list

for stage_name, target_list in conversion_defs.items():
    contact_stages[f'reached_{stage_name}'] = contact_stages['max_stage'].apply(lambda x: reached_stage(x, target_list))

# Group by first_responder_type
conv_rates = contact_stages.groupby('first_responder_type').agg(
    total_contacts=('contact_id', 'count'),
    reached_demo_booked=('reached_demo_booked', 'sum'),
    reached_trial_activated=('reached_trial_activated', 'sum'),
    reached_paid=('reached_paid', 'sum')
).reset_index()
conv_rates['demo_booked_rate'] = conv_rates['reached_demo_booked'] / conv_rates['total_contacts']
conv_rates['trial_activated_rate'] = conv_rates['reached_trial_activated'] / conv_rates['total_contacts']
conv_rates['paid_rate'] = conv_rates['reached_paid'] / conv_rates['total_contacts']
print("Conversion rates by first responder type:")
print(conv_rates)

# Compute stage duration (average time between stages)
# For each contact, we need timestamps of demo_booked, trial_activated, closed_won
# Let's extract first occurrence of each stage per contact
stage_timestamps = {}
for stage in ['demo_booked', 'trial_activated', 'closed_won']:
    # Get first conversation where stage matches
    stage_df = df[df['stage'] == stage].sort_values(['contact_id', 'conversation_created_at'])
