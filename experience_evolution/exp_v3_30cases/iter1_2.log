# Connect to database
db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-029/stage1_env/dacomp-029.sqlite'
conn = sqlite3.connect(db_path)
df = pd.read_sql_query('SELECT * FROM autohome', conn)
conn.close()

print(f"Total rows: {len(df)}")
print(df.columns)

# Helper functions to parse numeric values
def parse_price(price_str):
    if isinstance(price_str, (int, float)):
        return float(price_str)
    if not isinstance(price_str, str):
        return np.nan
    # Remove commas and 'yuan' and any Chinese characters
    s = re.sub(r'[^\d.]', '', price_str)
    if s == '':
        return np.nan
    return float(s)

def parse_mileage(mileage_str):
    if isinstance(mileage_str, (int, float)):
        return float(mileage_str)
    if not isinstance(mileage_str, str):
        return np.nan
    # Two patterns: 'X ten thousand km' or 'XX,XXX km'
    if 'ten thousand km' in mileage_str:
        num_part = re.search(r'([\d.]+)', mileage_str)
        if num_part:
            return float(num_part.group(1)) * 10000  # convert to km
    else:
        # Remove commas and 'km'
        s = re.sub(r'[^\d]', '', mileage_str)
        if s == '':
            return np.nan
        return float(s)
    return np.nan

# Apply parsing
df['Price_cleaned'] = df['Price']  # Already numeric? Check dtype
if df['Price'].dtype == object:
    df['Price_cleaned'] = df['Price'].apply(parse_price)
else:
    df['Price_cleaned'] = df['Price'].astype(float)

df['NewCarPrice_cleaned'] = df['New Car Price (incl. tax)'].apply(parse_price)
df['Mileage_km'] = df['Mileage'].apply(parse_mileage)

# Compute residual ratio: used price / new price
# Note: Price column likely in ten thousand yuan, NewCarPrice in yuan? Let's examine.
# Example: Audi A6L: Price 34.98, New Car Price 551,400 yuan. 34.98 * 10000 = 349800, which is less than 551400.
# So Price is in ten thousand yuan, NewCarPrice in yuan.
# Convert Price to yuan: Price_yuan = Price_cleaned * 10000
df['Price_yuan'] = df['Price_cleaned'] * 10000
df['ResidualRatio'] = df['Price_yuan'] / df['NewCarPrice_cleaned']

print("Sample after cleaning:")
print(df[['Title', 'Price_yuan', 'NewCarPrice_cleaned', 'ResidualRatio', 'Mileage_km']].head())

# Distribution of ResidualRatio
print("\nResidualRatio stats:")
print(df['ResidualRatio'].describe())

# Identify models with highest residual ratio
# Extract model from Title (first few words)
def extract_model(title):
    # Take first 3-4 words? We'll just use first 2 words for brand/model
    parts = title.split()
    if len(parts) >= 2:
        return ' '.join(parts[:2])
    else:
        return title

df['Model'] = df['Title'].apply(extract_model)

# Group by Model and compute average residual ratio, count
model_stats = df.groupby('Model').agg(
    Count=('ResidualRatio', 'size'),
    AvgResidualRatio=('ResidualRatio', 'mean'),
    MedianResidualRatio=('ResidualRatio', 'median'),
    AvgMileage_km=('Mileage_km', 'mean'),
    AvgAge_years=('Registration Date', lambda x: (pd.to_datetime('2024-01-01') - pd.to_datetime(x)).dt.days.mean() / 365)
).reset_index()

model_stats = model_stats.sort_values('AvgResidualRatio', ascending=False)
print("\nTop 20 models by average residual ratio:")
print(model_stats.head(20).to_string())

# Also group by vehicle class, fuel type, transmission etc.
if 'Vehicle Class' in df.columns:
    class_stats = df.groupby('Vehicle Class').agg(
        Count=('ResidualRatio', 'size'),
        AvgResidualRatio=('ResidualRatio', 'mean'),
        AvgMileage_km=('Mileage_km', 'mean')
    ).reset_index().sort_values('AvgResidualRatio', ascending=False)
    print("\nResidual ratio by Vehicle Class:")
    print(class_stats.to_string())

if 'Fuel Type' in df.columns:
    fuel_stats = df.groupby('Fuel Type').agg(
        Count=('ResidualRatio', 'size'),
        AvgResidualRatio=('ResidualRatio', 'mean')
    ).reset_index().sort_values('AvgResidualRatio', ascending=False)
    print("\nResidual ratio by Fuel Type:")
    print(fuel_stats.to_string())

if 'Transmission' in df.columns:
    trans_stats = df.groupby('Transmission').agg(
        Count=('ResidualRatio', 'size'),
        AvgResidualRatio=('ResidualRatio', 'mean')
    ).reset_index().sort_values('AvgResidualRatio', ascending=False)
    print("\nResidual ratio by Transmission:")
    print(trans_stats.to_string())

# We'll also compute correlation between mileage, age, and residual ratio
# Convert Registration Date to age in years
df['RegDate'] = pd.to_datetime(df['Registration Date'])
df['Age_years'] = (pd.to_datetime('2024-01-01') - df['RegDate']).dt.days / 365
print("\nCorrelation matrix (Price_yuan, NewCarPrice_cleaned, Mileage_km, Age_years, ResidualRatio):")
corr = df[['Price_yuan', 'NewCarPrice_cleaned', 'Mileage_km', 'Age_years', 'ResidualRatio']].corr()
print(corr)

# Save cleaned dataset for further analysis
df.to_csv('/workspace/cleaned_data.csv', index=False)
print("\nCleaned data saved to /workspace/cleaned_data.csv")
''')
