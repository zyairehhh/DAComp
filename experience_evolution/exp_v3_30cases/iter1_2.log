       STDDEV(p.gross_profit) as std_gross_profit,
       CASE WHEN AVG(p.gross_profit) = 0 THEN NULL ELSE (STDDEV(p.gross_profit) / AVG(p.gross_profit)) END as coeff_variation
FROM past_12_months p
INNER JOIN high_vol_customers h ON p.customer_id = h.customer_id
WHERE h.rn = 1
GROUP BY p.customer_id
ORDER BY coeff_variation DESC
LIMIT 10;", output="direct")
