Action: LOCAL_DB_SQL(file_path="dacomp-092.sqlite", command="
WITH latest_volatility AS (
    SELECT customer_id, MAX(transaction_date) as latest_date
    FROM quickbooks__profitability_analysis
    GROUP BY customer_id
),
vol_values AS (
    SELECT pa.customer_id, pa.customer_margin_volatility
    FROM quickbooks__profitability_analysis pa
    INNER JOIN latest_volatility lv ON pa.customer_id = lv.customer_id AND pa.transaction_date = lv.latest_date
)
SELECT 
    COUNT(*) as cnt,
    MIN(customer_margin_volatility) as min_vol,
    MAX(customer_margin_volatility) as max_vol,
    AVG(customer_margin_volatility) as avg_vol,
    customer_margin_volatility
FROM vol_values
GROUP BY customer_margin_volatility
LIMIT 10;", output="direct")
