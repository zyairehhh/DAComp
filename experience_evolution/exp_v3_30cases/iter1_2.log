if all(m in months for m in deterioration_months):
    indices = [months.index(m) for m in deterioration_months]
    ax3.plot([months[i] for i in indices], [rates[i] for i in indices], 
             marker='s', linewidth=3, markersize=10, color='#D1495B', 
             label='3-Month Deterioration Streak')

# Add threshold line
ax3.axhline(y=50, color='red', linestyle='--', alpha=0.5, label='50% Threshold')

ax3.set_xlabel('Month', fontsize=12)
ax3.set_ylabel('Collection Rate Percentage (%)', fontsize=12)
ax3.set_title('Month-over-Month Collection Rate Trend (Last 12 Months)', fontsize=14, fontweight='bold')
ax3.legend()
ax3.grid(True, alpha=0.3)

# Rotate x-axis labels for better readability
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('collection_rate_trend.png', dpi=300, bbox_inches='tight')
plt.close()

