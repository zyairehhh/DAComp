import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-089.sqlite')

# Threshold
threshold = 79621808.0

# Get top accounts
top_accounts = pd.read_sql_query(f"""
SELECT account_id, account_name, annual_revenue, total_contacts, number_of_employees
FROM salesforce__customer_360_view
WHERE annual_revenue >= {threshold}
""", conn)

# Contact density ratio
top_accounts['contact_density_ratio'] = (top_accounts['total_contacts'] / top_accounts['number_of_employees']) * 1000

# Decision maker ratio
dm_query = """
SELECT account_id,
       COUNT(*) as total_contacts_per_account,
       SUM(CASE WHEN title LIKE '%Chief%' THEN 1 ELSE 0 END) as chief_count
FROM salesforce__contact_enhanced
WHERE account_id IN (
    SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue >= ?
)
GROUP BY account_id
"""
dm_df = pd.read_sql_query(dm_query, conn, params=(threshold,))
top_accounts = top_accounts.merge(dm_df, on='account_id', how='left')
top_accounts['total_contacts_per_account'] = top_accounts['total_contacts_per_account'].fillna(0)
top_accounts['chief_count'] = top_accounts['chief_count'].fillna(0)
top_accounts['decision_maker_ratio'] = (top_accounts['chief_count'] / top_accounts['total_contacts_per_account'].replace(0, pd.NA)) * 100

# Department coverage - define key departments (excluding IT because not present)
key_depts = ['Sales', 'Finance', 'Operations', 'HR']
# Map department column to key dept (if not in key, ignore)
dept_query = """
SELECT account_id, department
FROM salesforce__contact_enhanced
WHERE account_id IN (
    SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue >= ?
)
AND department IS NOT NULL
"""
dept_df = pd.read_sql_query(dept_query, conn, params=(threshold,))
# Filter to only key depts
dept_df = dept_df[dept_df['department'].isin(key_depts)]
# For each account, count distinct key departments
coverage_df = dept_df.groupby('account_id')['department'].nunique().reset_index()
coverage_df.rename(columns={'department': 'key_dept_coverage'}, inplace=True)
top_accounts = top_accounts.merge(coverage_df, on='account_id', how='left')
top_accounts['key_dept_coverage'] = top_accounts['key_dept_coverage'].fillna(0)

# Compliance
top_accounts['cdr_compliant'] = top_accounts['contact_density_ratio'] >= 5
top_accounts['cdr_compliant'] = top_accounts['cdr_compliant'].fillna(False)
top_accounts['dmr_compliant'] = top_accounts['decision_maker_ratio'] >= 15
top_accounts['dmr_compliant'] = top_accounts['dmr_compliant'].fillna(False)
top_accounts['coverage_compliant'] = top_accounts['key_dept_coverage'] == len(key_depts)  # 4

top_accounts['high_risk'] = ~(top_accounts['cdr_compliant'] & top_accounts['dmr_compliant'] & top_accounts['coverage_compliant'])

print("=== Summary for Top 20% Accounts ===")
print(f"Total accounts: {len(top_accounts)}")
print(f"Contact Density Ratio >=5: {top_accounts['cdr_compliant'].sum()} ({top_accounts['cdr_compliant'].mean()*100:.1f}%)")
print(f"Decision-Maker Ratio >=15%: {top_accounts['dmr_compliant'].sum()} ({top_accounts['dmr_compliant'].mean()*100:.1f}%)")
print(f"Department Coverage =={len(key_depts)} (Sales,Finance,Ops,HR): {top_accounts['coverage_compliant'].sum()} ({top_accounts['coverage_compliant'].mean()*100:.1f}%)")
print(f"High-risk accounts (fail at least one benchmark): {top_accounts['high_risk'].sum()} ({top_accounts['high_risk'].mean()*100:.1f}%)")

# Distribution of contact density ratio
print("\n=== Contact Density Ratio Distribution ===")
print(top_accounts['contact_density_ratio'].describe(percentiles=[0.1,0.25,0.5,0.75,0.9]))
print(f"Median: {top_accounts['contact_density_ratio'].median()}")

# Distribution of decision maker ratio
print("\n=== Decision-Maker Ratio Distribution ===")
print(top_accounts['decision_maker_ratio'].describe(percentiles=[0.1,0.25,0.5,0.75,0.9]))
print(f"Median: {top_accounts['decision_maker_ratio'].median()}")

# Distribution of department coverage
print("\n=== Key Department Coverage Distribution ===")
print(top_accounts['key_dept_coverage'].value_counts().sort_index())
print(f"Accounts with 0 key departments: {(top_accounts['key_dept_coverage']==0).sum()}")

# Identify accounts that are compliant on all three (low risk)
low_risk = top_accounts[top_accounts['high_risk']==False]
print(f"\nLow-risk accounts (meet all 3 benchmarks): {len(low_risk)}")
if len(low_risk) > 0:
    print(low_risk[['account_id','account_name','contact_density_ratio','decision_maker_ratio','key_dept_coverage']].head())

# Save detailed metrics
top_accounts.to_csv('top_accounts_metrics_detailed.csv', index=False)
print("\nDetailed metrics saved to top_accounts_metrics_detailed.csv")

conn.close()
''')
