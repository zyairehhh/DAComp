'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-066/stage1_env/dacomp-066.sqlite')

# Join tables
query = """
SELECT 
    j.application_to_interview_rate as conv_rate,
    j.count_total_interviews,
    j.count_completed_interviews,
    j.avg_interviews_per_application,
    j.hiring_managers,
    j.departments,
    r.avg_process_days,
    r.performance_tier,
    r.total_interviews,
    r.completed_interviews,
    r.avg_interview_score,
    r.hire_rate,
    r.interview_rate
FROM greenhouse__job_enhanced j
LEFT JOIN greenhouse__recruitment_performance r ON j.job_id = r.job_id
WHERE j.departments='Engineering';
"""
df = pd.read_sql_query(query, conn)
conn.close()

print("Number of rows:", len(df))
print("\nFirst few rows:")
print(df.head())

# Convert performance_tier to numeric: Low=0, Medium=1, High=2
tier_map = {'Low':0, 'Medium':1, 'High':2}
df['performance_tier_numeric'] = df['performance_tier'].map(tier_map)
# Hiring manager as categorical - we'll create dummy variables
manager_dummies = pd.get_dummies(df['hiring_managers'], prefix='hm', drop_first=False)
df = pd.concat([df, manager_dummies], axis=1)

# Features for correlation
numeric_cols = ['conv_rate', 'count_total_interviews', 'count_completed_interviews',
                'avg_interviews_per_application', 'avg_process_days', 'avg_interview_score',
                'hire_rate', 'interview_rate', 'performance_tier_numeric']
corr_matrix = df[numeric_cols].corr()
print("\nCorrelation matrix of numeric features (excluding manager dummies):")
print(corr_matrix.round(3))

# Focus on correlation with conv_rate
print("\nCorrelation with conversion rate:")
print(corr_matrix['conv_rate'].sort_values(ascending=False))

# Simple linear regression using numpy (OLS)
# We'll do a multiple regression but we can compute coefficient of each variable individually
# Use statsmodels not available, we'll compute using numpy's least squares
# But we can do simple analysis: binning and averages
print("\n------ Impact of number of total interviews on conversion rate ------")
df['interview_bin'] = pd.qcut(df['count_total_interviews'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
bin_summary = df.groupby('interview_bin')['conv_rate'].agg(['mean', 'std', 'count'])
print(bin_summary)

print("\n------ Impact of avg interviews per application on conversion rate ------")
df['avg_interview_bin'] = pd.qcut(df['avg_interviews_per_application'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
bin_summary2 = df.groupby('avg_interview_bin')['conv_rate'].agg(['mean', 'std', 'count'])
print(bin_summary2)

print("\n------ Impact of hiring managers (average conversion rate) ------")
manager_avg = df.groupby('hiring_managers')['conv_rate'].agg(['mean', 'count']).sort_values('mean')
print(manager_avg)

print("\n------ Impact of process days on conversion rate ------")
df['process_days_bin'] = pd.qcut(df['avg_process_days'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
bin_summary3 = df.groupby('process_days_bin')['conv_rate'].agg(['mean', 'std', 'count'])
print(bin_summary3)

print("\n------ Impact of performance tier on conversion rate ------")
tier_avg = df.groupby('performance_tier')['conv_rate'].agg(['mean', 'count'])
print(tier_avg)
'''
