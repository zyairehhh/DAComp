import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib

# Use default fonts; no SimHei needed for English-only
conn = sqlite3.connect('dacomp-035.sqlite')

# 1. Get user counts per department
user_counts = pd.read_sql_query('''
SELECT Department, COUNT(*) AS user_count
FROM user_information_table
GROUP BY Department
''', conn)

# 2. Get abnormal logins with department info
abnormal_df = pd.read_sql_query('''
SELECT a."Anomaly ID", a."Anomaly Type", a."Risk Level", a."Anomaly Score",
       a."Confirmation Status", ui.Department
FROM abnormal_logins_table a
JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
JOIN user_information_table ui ON l."User ID" = ui."User ID"
''', conn)

# 3. Compute metrics per department
metrics = abnormal_df.groupby('Department').apply(lambda x: pd.Series({
    'abnormal_count': x.shape[0],
    'affected_users_count': x['Department'].count(), # Actually this is same as abnormal_count with duplicates; need distinct user IDs. Let's recompute with distinct.
})).reset_index()

# Compute distinct affected users
distinct_users = pd.read_sql_query('''
SELECT ui.Department, COUNT(DISTINCT l."User ID") AS affected_users_count
FROM abnormal_logins_table a
JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
JOIN user_information_table ui ON l."User ID" = ui."User ID"
GROUP BY ui.Department
''', conn)

metrics = metrics.drop('affected_users_count', axis=1).merge(distinct_users, on='Department')

# Merge with user_counts
metrics = metrics.merge(user_counts, on='Department')
metrics['abnormal_per_user'] = metrics['abnormal_count'] / metrics['user_count']

# Compute avg_anomaly_score, severe_high_rate, confirmation_rate
aggs = abnormal_df.groupby('Department').agg(
    avg_anomaly_score=('Anomaly Score', 'mean'),
    severe_high_rate=('Risk Level', lambda s: ((s.isin(['Severe','High'])).sum() / len(s)) * 100),
    confirmation_rate=('Confirmation Status', lambda s: ((s == 'Confirmed').sum() / len(s)) * 100)
).reset_index()

metrics = metrics.merge(aggs, on='Department')

# Compute score per affected user = total anomaly score across all abnormal records / affected_users_count
total_score = abnormal_df.groupby('Department')['Anomaly Score'].sum().reset_index(name='total_anomaly_score')
metrics = metrics.merge(total_score, on='Department')
metrics['score_per_affected_user'] = metrics['total_anomaly_score'] / metrics['affected_users_count']

# Compute composite Security Risk Index
# Weighted average of: Abnormal per User (40%), Score per Affected User (30%), Severe+High Rate (20%), Confirmation Rate (10%)
# Normalize each metric to 0-100? They might have used raw percentages. Let's scale each metric to 0-1 by dividing by max across departments.
# However from Stage1 table, index values are around 20. Let's replicate using same formula: 
# Index = 0.4*(Abnormal per User) + 0.3*(Score per Affected User) + 0.2*(Severe+High Rate) + 0.1*(Confirmation Rate)
# But Abnormal per User is around 0.6, Score per Affected User around 70-80, Severe+High Rate around 45-62, Confirmation Rate around 38-58.
# That would produce index around (0.4*0.6 + 0.3*70 + 0.2*50 + 0.1*50) ~ 0.24+21+10+5 = 36, but table shows around 20. So they likely scaled.
# Let's compute as they did: maybe they normalized each metric to a 0-100 scale by dividing by the maximum across departments.
# Let's compute normalized values.
for col in ['abnormal_per_user', 'score_per_affected_user', 'severe_high_rate', 'confirmation_rate']:
    max_val = metrics[col].max()
    metrics[f'{col}_norm'] = metrics[col] / max_val * 100

# Compute index using normalized values with weights
metrics['risk_index'] = (0.4 * metrics['abnormal_per_user_norm'] +
                         0.3 * metrics['score_per_affected_user_norm'] +
                         0.2 * metrics['severe_high_rate_norm'] +
                         0.1 * metrics['confirmation_rate_norm'])

# Print metrics to verify
print(metrics.to_markdown(index=False))

# Plot 1: Security Risk Index (bar chart)
plt.figure(figsize=(8, 5))
bars = plt.bar(metrics['Department'], metrics['risk_index'], color='steelblue')
plt.title('Security Risk Index by Department')
plt.ylabel('Risk Index (weighted composite)')
plt.xticks(rotation=45, ha='right')
# Add value labels on top
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, height + 0.5,
             f'{height:.1f}', ha='center', va='bottom', fontsize=10)
plt.tight_layout()
plt.savefig('risk_index.png', dpi=150)
plt.close()

# Plot 2: Abnormal per User vs Severe+High Rate (scatter with department labels)
plt.figure(figsize=(8, 5))
for idx, row in metrics.iterrows():
    plt.scatter(row['abnormal_per_user'], row['severe_high_rate'], s=100, alpha=0.7)
    plt.text(row['abnormal_per_user'] + 0.002, row['severe_high_rate'] + 0.5,
             row['Department'].replace(' Department', ''), fontsize=9)
plt.xlabel('Abnormal Logins per User')
plt.ylabel('Severe+High Rate (%)')
plt.title('Risk Profile: Incident Frequency vs Severity')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('scatter_freq_vs_severity.png', dpi=150)
plt.close()

# Plot 3: Anomaly Type Breakdown per Department (stacked bar)
anomaly_type_counts = pd.crosstab(abnormal_df['Department'], abnormal_df['Anomaly Type'])
# Normalize to percentage
anomaly_type_pct = anomaly_type_counts.div(anomaly_type_counts.sum(axis=1), axis=0) * 100
# Plot
ax = anomaly_type_pct.plot(kind='bar', stacked=True, figsize=(10, 6))
plt.title('Anomaly Type Distribution by Department (%)')
plt.ylabel('Percentage')
plt.xlabel('Department')
plt.xticks(rotation=45, ha='right')
# Add legend outside
plt.legend(title='Anomaly Type', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.tight_layout()
plt.savefig('anomaly_type_distribution.png', dpi=150, bbox_inches='tight')
plt.close()

# Plot 4: Confirmation Rate vs Abnormal Count (bubble chart)
plt.figure(figsize=(8, 5))
for idx, row in metrics.iterrows():
    plt.scatter(row['confirmation_rate'], row['abnormal_count'],
                s=row['score_per_affected_user']*2, alpha=0.6, label=row['Department'])
plt.xlabel('Confirmation Rate (%)')
plt.ylabel('Total Abnormal Login Count')
plt.title('Confirmation Rate vs Volume (bubble size = Score per Affected User)')
# Add legend
handles, labels = plt.gca().get_legend_handles_labels()
by_label = dict(zip(labels, handles))
plt.legend(by_label.values(), by_label.keys(), title='Department', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('bubble_confirmation_vs_volume.png', dpi=150, bbox_inches='tight')
plt.close()

print("Plots saved.")
```
