import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib import font_manager
import os

# Connect to database
conn = sqlite3.connect('dacomp-092.sqlite')

# Load key tables
profitability_df = pd.read_sql_query("SELECT * FROM quickbooks__profitability_analysis", conn)
customer_df = pd.read_sql_query("SELECT * FROM quickbooks__customer_analytics", conn)
financial_df = pd.read_sql_query("SELECT * FROM quickbooks__financial_dashboard", conn)
balance_df = pd.read_sql_query("SELECT * FROM quickbooks__balance_sheet", conn)

print(f"Profitability rows: {profitability_df.shape[0]}")
print(f"Customer analytics rows: {customer_df.shape[0]}")
print(f"Financial dashboard rows: {financial_df.shape[0]}")
print(f"Balance sheet rows: {balance_df.shape[0]}")

# For English-only run, use default fonts
plt.rcParams.update({'font.size': 10})

# Ensure output directory
os.makedirs('plots', exist_ok=True)

# Plot 1: Distribution of customer margin volatility
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Identify top 25% high volatility customers
volatility_threshold = profitability_df['customer_margin_volatility'].quantile(0.75)
high_vol_customers = profitability_df[profitability_df['customer_margin_volatility'] >= volatility_threshold]
low_vol_customers = profitability_df[profitability_df['customer_margin_volatility'] < volatility_threshold]

# Plot distribution
axes[0].hist(profitability_df['customer_margin_volatility'].dropna(), bins=30, alpha=0.7, color='blue', edgecolor='black')
axes[0].axvline(volatility_threshold, color='red', linestyle='--', label=f'75th percentile: {volatility_threshold:.2f}')
axes[0].set_xlabel('Customer Margin Volatility')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Distribution of Customer Margin Volatility')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# Compare profitability between high and low volatility customers
profit_means = [high_vol_customers['customer_gross_margin_pct'].mean(), 
                low_vol_customers['customer_gross_margin_pct'].mean()]
profit_std = [high_vol_customers['customer_gross_margin_pct'].std(), 
              low_vol_customers['customer_gross_margin_pct'].std()]

x_pos = [0, 1]
axes[1].bar(x_pos, profit_means, yerr=profit_std, capsize=10, alpha=0.7, 
            color=['red', 'green'], edgecolor='black')
axes[1].set_xticks(x_pos)
axes[1].set_xticklabels(['High Volatility\n(Top 25%)', 'Low Volatility\n(Bottom 75%)'])
axes[1].set_ylabel('Average Gross Margin %')
axes[1].set_title('Profitability Comparison: High vs Low Volatility Customers')
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('plots/volatility_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 2: Relationship between volatility and customer behavioral features
