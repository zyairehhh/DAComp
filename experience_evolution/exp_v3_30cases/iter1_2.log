        campaign_name,
        SUM(clicks) as clicks,
        SUM(impressions) as impressions,
        SUM(conversions) as conversions
    FROM google_ads__ad_group_report
    GROUP BY ad_group_id, ad_group_name, campaign_name
    """
    df_ag = pd.read_sql_query(query, conn)
    df_ag['ctr'] = df_ag['clicks'] / df_ag['impressions']
    df_ag['cvr'] = df_ag['conversions'] / df_ag['clicks']
    df_valid = df_ag.dropna(subset=['ctr', 'cvr']).copy()
    
    # Percentiles
    ctr_75 = df_valid['ctr'].quantile(0.75)
    cvr_25 = df_valid['cvr'].quantile(0.25)
    print(f"CTR 75th percentile: {ctr_75:.6f}")
    print(f"CVR 25th percentile: {cvr_25:.6f}")
    
    # Problematic ad groups
    problematic = df_valid[(df_valid['ctr'] > ctr_75) & (df_valid['cvr'] < cvr_25)].copy()
    print(f"Number of problematic ad groups: {len(problematic)}")
    problematic.to_csv('problematic_groups.csv', index=False)
    
    # Step 2: Compute expected CVR per campaign (overall average per campaign)
    campaign_avg = df_valid.groupby('campaign_name')['cvr'].mean().rename('expected_cvr')
    problematic = problematic.merge(campaign_avg, left_on='campaign_name', right_index=True, how='left')
    problematic['intent_match_ratio'] = problematic['cvr'] / problematic['expected_cvr']
    print(f"\nIntent Match Ratio (actual CVR / campaign average CVR) for problematic groups:")
    print(f"Mean: {problematic['intent_match_ratio'].mean():.3f}")
    print(f"Std: {problematic['intent_match_ratio'].std():.3f}")
    print("Distribution:")
    print(problematic['intent_match_ratio'].describe())
    
    # Step 3: Traffic quality - conversions per impression (a proxy)
    problematic['conversions_per_impression'] = problematic['conversions'] / problematic['impressions']
    print(f"\nConversions per impression (traffic quality) for problematic groups:")
    print(f"Mean: {problematic['conversions_per_impression'].mean():.6f}")
    print(f"Overall average conversions per impression: {(df_valid['conversions'] / df_valid['impressions']).mean():.6f}")
    
    # Step 4: Keyword match type analysis for problematic groups
    print("\nKeyword match type distribution within problematic ad groups:")
    # Load keyword report for those ad groups
    problematic_ids = tuple(problematic['ad_group_id'].unique())
    if len(problematic_ids) == 0:
        print("No problematic ad groups to analyze.")
        conn.close()
        return
    # SQL query with placeholders
    query = f"""
    SELECT 
        keyword_match_type,
        COUNT(*) as keyword_count,
        SUM(clicks) as total_clicks,
        SUM(impressions) as total_impressions,
        SUM(conversions) as total_conversions
    FROM google_ads__keyword_report
    WHERE ad_group_id IN ({','.join(['?']*len(problematic_ids))})
    GROUP BY keyword_match_type
    ORDER BY keyword_count DESC
    """
    keyword_summary = pd.read_sql_query(query, conn, params=problematic_ids)
    print(keyword_summary)
    
    # Step 5: Identify top campaigns contributing to problematic groups
    print("\nTop campaigns by number of problematic ad groups:")
    campaign_counts = problematic['campaign_name'].value_counts()
    print(campaign_counts.head(20))
    
    # Step 6: Recommendations
    print("\n=== ANALYSIS SUMMARY ===")
    print(f"Total ad groups with valid data: {len(df_valid)}")
    print(f"Problematic ad groups (high CTR > {ctr_75:.4f}, low CVR < {cvr_25:.4f}): {len(problematic)} ({len(problematic)/len(df_valid):.1%})")
    print(f"Average Intent Match Ratio: {problematic['intent_match_ratio'].mean():.3f} (values <1 indicate performance below campaign average)")
    print(f"Keyword match types in problematic groups: {list(keyword_summary['keyword_match_type'])}")
    
    # Additional: analyze search term report for high-impression low-conversion terms
    # Could be heavy; skip for now.
    
    conn.close()
    
    # Write final results to a text file
    with open('analysis_summary.txt', 'w') as f:
        f.write("Analysis Summary\n")
        f.write(f"Problematic ad groups count: {len(problematic)}\n")
        f.write(f"Avg Intent Match Ratio: {problematic['intent_match_ratio'].mean():.3f}\n")
        f.write(f"Avg conversions per impression: {problematic['conversions_per_impression'].mean():.6f}\n")
        f.write(f"Keyword match type distribution:\n")
        f.write(keyword_summary.to_string())
        f.write("\nTop campaigns:\n")
        f.write(campaign_counts.head(20).to_string())
    
    print("\nAnalysis summary saved to analysis_summary.txt")

if __name__ == '__main__':
    main()
