```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import os

# Connect to database
conn = sqlite3.connect('dacomp-018.sqlite')

# 1. Profit by customer segment (Fashion)
query1 = '''
SELECT c."Customer Segment", SUM(o.profit) as total_profit
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c."Customer Segment"
ORDER BY total_profit DESC
'''
df_seg = pd.read_sql(query1, conn)
print(df_seg)

# 2. Profit by gender
query2 = '''
SELECT c.gender, SUM(o.profit) as total_profit
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c.gender
ORDER BY total_profit DESC
'''
df_gender = pd.read_sql(query2, conn)
print(df_gender)

# 3. Profit by region (top 10)
query3 = '''
SELECT c.Region, SUM(o.profit) as total_profit
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c.Region
ORDER BY total_profit DESC
LIMIT 10
'''
df_region = pd.read_sql(query3, conn)
print(df_region)

# 4. Profit by age group (binned)
query4 = '''
SELECT 
    CASE 
        WHEN age < 20 THEN '<20'
        WHEN age BETWEEN 20 AND 29 THEN '20-29'
        WHEN age BETWEEN 30 AND 39 THEN '30-39'
        WHEN age BETWEEN 40 AND 49 THEN '40-49'
        WHEN age >= 50 THEN '50+'
        ELSE 'Unknown'
    END as age_group,
    SUM(o.profit) as total_profit,
    COUNT(DISTINCT o."Customer ID") as customer_count
FROM order_information o
JOIN customer_information c ON o."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY age_group
ORDER BY total_profit DESC
'''
df_age = pd.read_sql(query4, conn)
print(df_age)

# 5. Browsing engagement vs profit correlation (average browsing time per customer vs profit per customer)
query5 = '''
SELECT 
    c."Customer ID",
    SUM(pb."Browsing Time (minutes)") as total_browse_time,
    SUM(pb.like) as total_likes,
    SUM(pb.share) as total_shares,
    SUM(pb."Add to Cart") as total_add_to_cart,
    SUM(o.profit) as total_profit
FROM product_browsing pb
JOIN order_information o ON pb."Customer ID" = o."Customer ID" AND pb."Product Category" = o."Product Category" AND pb.Product = o.Product
JOIN customer_information c ON pb."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c."Customer ID"
LIMIT 100
'''
df_engage = pd.read_sql(query5, conn)
print(df_engage.head())

conn.close()
```
