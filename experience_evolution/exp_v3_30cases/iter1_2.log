import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-022.sqlite')

# 1. Vehicle type vs fare per km
query1 = """
SELECT 
    `Vehicle Type`,
    AVG(`Booking Value` / NULLIF(`Ride Distance`, 0)) AS avg_fare_per_km,
    COUNT(*) AS completed_rides
FROM sheet1 
WHERE `Booking Status` = 'COMPLETED' 
  AND `Ride Distance` > 0
GROUP BY `Vehicle Type`
ORDER BY avg_fare_per_km DESC
"""
df_vehicle = pd.read_sql_query(query1, conn)

# 2. Hour vs fare per km
query2 = """
SELECT 
    CAST(SUBSTR(`Time`, 1, 2) AS INTEGER) AS hour,
    AVG(`Booking Value` / NULLIF(`Ride Distance`, 0)) AS avg_fare_per_km,
    COUNT(*) AS total_bookings,
    SUM(CASE WHEN `Booking Status` = 'COMPLETED' THEN 1 ELSE 0 END) * 1.0 / COUNT(*) AS completion_rate
FROM sheet1 
WHERE `Ride Distance` > 0
GROUP BY hour
ORDER BY hour
"""
df_hour = pd.read_sql_query(query2, conn)

# 3. Vehicle-hour combinations
query3 = """
SELECT 
    `Vehicle Type`,
    CAST(SUBSTR(`Time`, 1, 2) AS INTEGER) AS hour,
    AVG(`Booking Value` / NULLIF(`Ride Distance`, 0)) AS avg_fare_per_km,
    COUNT(*) AS completed_rides
FROM sheet1 
WHERE `Booking Status` = 'COMPLETED' 
  AND `Ride Distance` > 0
GROUP BY `Vehicle Type`, hour
HAVING completed_rides >= 100
ORDER BY avg_fare_per_km DESC
LIMIT 10
"""
df_vehicle_hour = pd.read_sql_query(query3, conn)

# 4. Driver cancellation reasons
query4 = """
SELECT 
    `Driver Cancellation Reason`,
    COUNT(*) as count
FROM sheet1 
WHERE `Driver Cancellation Reason` IS NOT NULL 
  AND `Driver Cancellation Reason` != ''
GROUP BY `Driver Cancellation Reason`
ORDER BY count DESC
LIMIT 10
"""
df_driver_cancel = pd.read_sql_query(query4, conn)

# 5. Customer cancellation reasons
query5 = """
SELECT 
    `Reason for cancelling by Customer`,
    COUNT(*) as count
FROM sheet1 
WHERE `Reason for cancelling by Customer` IS NOT NULL 
  AND `Reason for cancelling by Customer` != ''
GROUP BY `Reason for cancelling by Customer`
ORDER BY count DESC
LIMIT 10
"""
df_customer_cancel = pd.read_sql_query(query5, conn)

# 6. Driver rating buckets vs fare per km
query6 = """
SELECT 
    CASE 
        WHEN `Driver Ratings` >= 3.0 AND `Driver Ratings` < 3.5 THEN '3.0-3.5'
        WHEN `Driver Ratings` >= 3.5 AND `Driver Ratings` < 4.0 THEN '3.5-4.0'
        WHEN `Driver Ratings` >= 4.0 AND `Driver Ratings` < 4.5 THEN '4.0-4.5'
        WHEN `Driver Ratings` >= 4.5 AND `Driver Ratings` <= 5.0 THEN '4.5-5.0'
        ELSE 'Other'
    END AS rating_bucket,
    AVG(`Booking Value` / NULLIF(`Ride Distance`, 0)) AS avg_fare_per_km,
    COUNT(*) AS completed_rides
FROM sheet1 
WHERE `Booking Status` = 'COMPLETED' 
  AND `Ride Distance` > 0
  AND `Driver Ratings` IS NOT NULL
GROUP BY rating_bucket
ORDER BY rating_bucket
"""
df_rating = pd.read_sql_query(query6, conn)

conn.close()

# Create visualization directory
os.makedirs('visualizations', exist_ok=True)

# Plot 1: Vehicle Type vs Average Fare per KM
plt.figure(figsize=(10, 6))
bars = plt.bar(df_vehicle['Vehicle Type'], df_vehicle['avg_fare_per_km'], color='skyblue')
plt.title('Average Fare per Kilometer by Vehicle Type', fontsize=16)
plt.xlabel('Vehicle Type', fontsize=12)
plt.ylabel('Average Fare per KM', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.grid(axis='y', alpha=0.3)

# Add value labels on bars
for bar, val in zip(bars, df_vehicle['avg_fare_per_km']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.1, 
             f'{val:.2f}', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('visualizations/vehicle_type_fare_per_km.png', dpi=300)
plt.close()

# Plot 2: Hour vs Average Fare per KM
plt.figure(figsize=(12, 6))
plt.plot(df_hour['hour'], df_hour['avg_fare_per_km'], marker='o', linewidth=2, markersize=8, color='darkorange')
plt.title('Average Fare per Kilometer by Hour of Day', fontsize=16)
plt.xlabel('Hour of Day', fontsize=12)
plt.ylabel('Average Fare per KM', fontsize=12)
plt.xticks(range(0, 24))
plt.grid(alpha=0.4)

# Highlight peak hours
peak_hours = df_hour.nlargest(3, 'avg_fare_per_km')['hour']
for hour in peak_hours:
    plt.axvline(x=hour, color='red', linestyle='--', alpha=0.5, label=f'Peak hour {hour}:00' if hour == peak_hours.iloc[0] else None)

plt.tight_layout()
plt.savefig('visualizations/hourly_fare_per_km.png', dpi=300)
plt.close()

# Plot 3: Top Vehicle-Hour Combinations
plt.figure(figsize=(12, 6))
# Create combination labels
df_vehicle_hour['label'] = df_vehicle_hour['Vehicle Type'] + ' at ' + df_vehicle_hour['hour'].astype(str) + ':00'
bars = plt.barh(df_vehicle_hour['label'], df_vehicle_hour['avg_fare_per_km'], color='lightgreen')
plt.title('Top Vehicle-Hour Combinations by Fare per Kilometer', fontsize=16)
plt.xlabel('Average Fare per KM', fontsize=12)
plt.ylabel('Vehicle-Hour Combination', fontsize=12)
plt.gca().invert_yaxis()  # Highest on top

# Add value labels
for bar, val, rides in zip(bars, df_vehicle_hour['avg_fare_per_km'], df_vehicle_hour['completed_rides']):
    plt.text(bar.get_width() + 0.1, bar.get_y() + bar.get_height()/2, 
             f'{val:.2f} ({rides} rides)', va='center', fontsize=9)

plt.tight_layout()
plt.savefig('visualizations/top_vehicle_hour_combinations.png', dpi=300)
plt.close()

# Plot 4: Driver Cancellation Reasons (Top 10)
plt.figure(figsize=(12, 8))
bars = plt.barh(df_driver_cancel['Driver Cancellation Reason'], df_driver_cancel['count'], color='lightcoral')
plt.title('Top 10 Driver Cancellation Reasons', fontsize=16)
plt.xlabel('Number of Cancellations', fontsize=12)
plt.ylabel('Cancellation Reason', fontsize=12)
plt.gca().invert_yaxis()

# Add value labels
for bar, val in zip(bars, df_driver_cancel['count']):
    plt.text(bar.get_width() + 5, bar.get_y() + bar.get_height()/2, 
             f'{int(val)}', va='center', fontsize=9)

plt.tight_layout()
plt.savefig('visualizations/driver_cancellation_reasons.png', dpi=300)
plt.close()

# Plot 5: Customer Cancellation Reasons (Top 10)
plt.figure(figsize=(12, 8))
bars = plt.barh(df_customer_cancel['Reason for cancelling by Customer'], df_customer_cancel['count'], color='lightblue')
plt.title('Top 10 Customer Cancellation Reasons', fontsize=16)
plt.xlabel('Number of Cancellations', fontsize=12)
plt.ylabel('Cancellation Reason', fontsize=12)
plt.gca().invert_yaxis()

# Add value labels
for bar, val in zip(bars, df_customer_cancel['count']):
    plt.text(bar.get_width() + 5, bar.get_y() + bar.get_height()/2, 
             f'{int(val)}', va='center', fontsize=9)

plt.tight_layout()
plt.savefig('visualizations/customer_cancellation_reasons.png', dpi=300)
plt.close()

# Plot 6: Driver Rating Buckets vs Fare per KM
plt.figure(figsize=(10, 6))
bars = plt.bar(df_rating['rating_bucket'], df_rating['avg_fare_per_km'], color='mediumpurple')
plt.title('Average Fare per Kilometer by Driver Rating Bucket', fontsize=16)
plt.xlabel('Driver Rating Bucket', fontsize=12)
plt.ylabel('Average Fare per KM', fontsize=12)
plt.grid(axis='y', alpha=0.3)

# Add value labels
for bar, val in zip(bars, df_rating['avg_fare_per_km']):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.05, 
             f'{val:.2f}', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('visualizations/rating_bucket_fare_per_km.png', dpi=300)
plt.close()

print("Visualizations created successfully in 'visualizations' folder")
```
