Action: LOCAL_DB_SQL(file_path="dacomp-079.sqlite", command="WITH segment_visitors AS ( SELECT v.visitor_id FROM pendo__visitor v LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id GROUP BY v.visitor_id HAVING v.count_active_days > 60 AND COUNT(DISTINCT vf.feature_id) < 5 ) SELECT f.feature_name, COUNT(DISTINCT sv.visitor_id) as visitor_count, SUM(vf.sum_clicks) as total_clicks, SUM(vf.count_click_events) as total_events FROM segment_visitors sv JOIN pendo__visitor_feature vf ON sv.visitor_id = vf.visitor_id JOIN pendo__feature f ON vf.feature_id = f.feature_id GROUP BY f.feature_id, f.feature_name ORDER BY visitor_count DESC LIMIT 20", output="direct")
