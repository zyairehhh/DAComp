import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Load computed key accounts metrics
if not os.path.exists('key_accounts_metrics.csv'):
    # If not exist, run previous script
    import plot_metrics
    # but easier: compute again inline
    pass

df = pd.read_csv('key_accounts_metrics.csv')

# 1. Histogram of Contact Density Ratio (CDR)
plt.figure(figsize=(8,5))
plt.hist(df['CDR'], bins=30, edgecolor='black', alpha=0.7)
plt.axvline(x=5, color='red', linestyle='--', label='Benchmark (CDR >=5)')
plt.xlabel('Contact Density Ratio (CDR)')
plt.ylabel('Number of Key Accounts')
plt.title('Distribution of Contact Density Ratio among Key Accounts')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('cdr_distribution.png', dpi=300)
plt.close()

# 2. Histogram of Decision-Maker Ratio (DMR)
plt.figure(figsize=(8,5))
plt.hist(df['DMR'], bins=30, edgecolor='black', alpha=0.7)
plt.axvline(x=15, color='red', linestyle='--', label='Benchmark (DMR >=15%)')
plt.xlabel('Decision-Maker Ratio (DMR) (%)')
plt.ylabel('Number of Key Accounts')
plt.title('Distribution of Decision-Maker Ratio among Key Accounts')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('dmr_distribution.png', dpi=300)
plt.close()

# 3. Department Coverage Score (DCS) histogram
plt.figure(figsize=(8,5))
plt.hist(df['DCS'], bins=10, edgecolor='black', alpha=0.7)
plt.axvline(x=100, color='red', linestyle='--', label='Target (100%)')
plt.xlabel('Department Coverage Score (DCS) (%)')
plt.ylabel('Number of Key Accounts')
plt.title('Distribution of Department Coverage Score among Key Accounts')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('dcs_distribution.png', dpi=300)
plt.close()

# 4. Risk distribution bar chart
risk_counts = df['Risk'].value_counts().reindex(['High','Medium','Low'], fill_value=0)
plt.figure(figsize=(6,4))
bars = plt.bar(risk_counts.index, risk_counts.values, color=['#FF6B6B','#FFD166','#06D6A0'])
plt.xlabel('Risk Level')
plt.ylabel('Number of Key Accounts')
plt.title('Risk Level Distribution among Key Accounts')
for i, v in enumerate(risk_counts.values):
    plt.text(i, v + 5, str(v), ha='center', va='bottom')
plt.tight_layout()
plt.savefig('risk_distribution.png', dpi=300)
plt.close()

# 5. Scatter plot CDR vs DMR colored by Risk
plt.figure(figsize=(8,6))
colors = {'High':'red', 'Medium':'orange', 'Low':'green'}
for risk, color in colors.items():
    subset = df[df['Risk'] == risk]
    plt.scatter(subset['CDR'], subset['DMR'], c=color, label=risk, alpha=0.6, edgecolors='w', linewidth=0.5)
plt.axhline(y=15, color='grey', linestyle=':', alpha=0.5)
plt.axvline(x=5, color='grey', linestyle=':', alpha=0.5)
plt.xlabel('Contact Density Ratio (CDR)')
plt.ylabel('Decision-Maker Ratio (DMR) (%)')
plt.title('CDR vs DMR for Key Accounts (colored by Risk)')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.3)
plt.tight_layout()
plt.savefig('cdr_vs_dmr_scatter.png', dpi=300)
plt.close()

# 6. Department coverage gaps: count of accounts missing each key department
# Need original contacts data to compute missing departments per account
contacts = pd.read_csv('data/contacts.csv')
key_depts = ['Sales', 'Finance', 'Operations', 'IT', 'HR']
# For each key account, see which departments are present
key_account_ids = df['account_id'].unique()
dept_presence = {dept: [] for dept in key_depts}
for acc_id in key_account_ids:
    acc_contacts = contacts[contacts['account_id'] == acc_id]
    present_depts = set(acc_contacts['department'].dropna().unique())
    for dept in key_depts:
        dept_presence[dept].append(dept in present_depts)
# Count missing per department
missing_counts = {dept: sum(1 for present in dept_presence[dept] if not present) for dept in key_depts}
plt.figure(figsize=(8,5))
bars = plt.bar(missing_counts.keys(), missing_counts.values(), color='skyblue')
plt.xlabel('Department')
plt.ylabel('Number of Key Accounts Missing Department')
plt.title('Department Coverage Gaps among Key Accounts')
for i, v in enumerate(missing_counts.values()):
    plt.text(i, v + 5, str(v), ha='center', va='bottom')
plt.tight_layout()
plt.savefig('department_gaps.png', dpi=300)
plt.close()

print("Plots generated.")
