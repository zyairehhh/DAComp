    AvgAge=('Age_years','mean')
).reset_index()
print("\nResidual ratio by Mileage Group:")
print(mileage_stats.to_string())

# Combine vehicle class and fuel type
if 'Vehicle Class' in df.columns and 'Fuel Type' in df.columns:
    class_fuel = df.groupby(['Vehicle Class','Fuel Type']).agg(
        Count=('ResidualRatio','size'),
        AvgResidualRatio=('ResidualRatio','mean'),
        AvgAge=('Age_years','mean'),
        AvgMileage=('Mileage_km','mean')
    ).reset_index()
    class_fuel = class_fuel.sort_values('AvgResidualRatio', ascending=False)
    print("\nTop combinations of Vehicle Class and Fuel Type by residual ratio:")
    print(class_fuel.head(20).to_string())

# Analyze by number of previous owners
if 'Number of Previous Owners' in df.columns:
    # Clean column: extract numeric part
    def extract_num_owners(s):
        if isinstance(s, str):
            # examples: "4 times (subject to vehicle registration certificate)"
            match = re.search(r'(\d+)', s)
            if match:
                return int(match.group(1))
        return np.nan
    df['PrevOwners'] = df['Number of Previous Owners'].apply(extract_num_owners)
    owner_stats = df.groupby('PrevOwners').agg(
        Count=('ResidualRatio','size'),
        AvgResidualRatio=('ResidualRatio','mean'),
        AvgAge=('Age_years','mean')
    ).reset_index()
    print("\nResidual ratio by Number of Previous Owners:")
    print(owner_stats.to_string())

# Examine top models with at least 5 listings for statistical significance
model_stats = df.groupby('Model').agg(
    Count=('ResidualRatio', 'size'),
    AvgResidualRatio=('ResidualRatio', 'mean'),
    MedianResidualRatio=('ResidualRatio', 'median'),
    AvgMileage_km=('Mileage_km', 'mean'),
    AvgAge_years=('Age_years', 'mean')
).reset_index()
significant_models = model_stats[model_stats['Count'] >= 5]
significant_models = significant_models.sort_values('AvgResidualRatio', ascending=False)
print("\nModels with at least 5 listings, sorted by residual ratio:")
print(significant_models.head(20).to_string())

# Also check if there are any outliers: high price vs new price ratio > 0.9 or < 0.4
outliers_high = df[df['ResidualRatio'] > 0.9]
outliers_low = df[df['ResidualRatio'] < 0.4]
print(f"\nHigh residual outliers (>0.9): {len(outliers_high)} rows")
if len(outliers_high) > 0:
    print(outliers_high[['Title','Price_yuan','NewCarPrice_cleaned','ResidualRatio']].head(10).to_string())
else:
    print("None")
print(f"\nLow residual outliers (<0.4): {len(outliers_low)} rows")
if len(outliers_low) > 0:
    print(outliers_low[['Title','Price_yuan','NewCarPrice_cleaned','ResidualRatio']].head(10).to_string())
else:
    print("None")

# Regression coefficients: ResidualRatio ~ Age_years + Mileage_km
X = df[['Age_years','Mileage_km']]
X = sm.add_constant(X)
y = df['ResidualRatio']
model = sm.OLS(y, X, missing='drop').fit()
print("\nRegression coefficients (ResidualRatio ~ Age + Mileage):")
print(model.summary().tables[1])
