'''
import pandas as pd
import numpy as np
import sqlite3
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-057.sqlite')
df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)
df['date_day'] = pd.to_datetime(df['date_day'])

# Identify campaigns
campaign_cols = ['account_id', 'advertising_channel_type', 'campaign_lifecycle_stage']
grouped = df.groupby(campaign_cols)

# Compute aggregated metrics per campaign (including maturity stages)
campaign_stats = []
for name, group in grouped:
    group = group.sort_values('date_day')
    # skip if too few rows
    if len(group) < 10:
        continue
    # trend calculations
    x = np.arange(len(group))
    y_cac = group['customer_acquisition_cost'].values
    y_ratio = group['ltv_cac_ratio'].values
    slope_cac, _ = np.polyfit(x, y_cac, 1)
    slope_ratio, _ = np.polyfit(x, y_ratio, 1)
    avg_cac = np.mean(y_cac)
    avg_ratio = np.mean(y_ratio)
    slope_cac_pct = slope_cac / avg_cac if avg_cac != 0 else np.nan
    slope_ratio_pct = slope_ratio / avg_ratio if avg_ratio != 0 else np.nan
    
    # maturity stages: most common
    account_maturity = group['account_maturity_stage'].mode().iloc[0] if group['account_maturity_stage'].notna().any() else None
    customer_maturity = group['customer_maturity_stage'].mode().iloc[0] if group['customer_maturity_stage'].notna().any() else None
    
    # other averages
    avg_soph_score = group['acquisition_sophistication_score'].mean()
    avg_cac_eff = group['cac_efficiency_percentile'].mean()
    avg_channel_diversity = group['channel_diversity_count'].mean()
    avg_retention_risk = group['retention_risk'].mean()
    avg_scale_opportunity = group['scale_opportunity'].mean()
    strategic_segment = group['strategic_customer_segment'].mode().iloc[0] if group['strategic_customer_segment'].notna().any() else None
    
    # duration
    duration = (group['date_day'].max() - group['date_day'].min()).days
    active_last_30 = group['date_day'].max() >= (df['date_day'].max() - timedelta(days=30))
    
    # recent 30 days vs previous 30 days metrics (if available)
    latest_date = df['date_day'].max()
    last_start = latest_date - timedelta(days=30)
    prev_start = last_start - timedelta(days=30)
    last_sub = group[group['date_day'] >= last_start]
    prev_sub = group[(group['date_day'] >= prev_start) & (group['date_day'] < last_start)]
    if len(last_sub) >= 1 and len(prev_sub) >= 1:
        cac_growth = (last_sub['customer_acquisition_cost'].mean() - prev_sub['customer_acquisition_cost'].mean()) / prev_sub['customer_acquisition_cost'].mean() if prev_sub['customer_acquisition_cost'].mean() != 0 else np.nan
        ratio_decline = (last_sub['ltv_cac_ratio'].mean() - prev_sub['ltv_cac_ratio'].mean()) / prev_sub['ltv_cac_ratio'].mean() if prev_sub['ltv_cac_ratio'].mean() != 0 else np.nan
    else:
        cac_growth = np.nan
        ratio_decline = np.nan
    
    campaign_stats.append({
        'account_id': name[0],
        'advertising_channel_type': name[1],
        'campaign_lifecycle_stage': name[2],
        'account_maturity_stage': account_maturity,
        'customer_maturity_stage': customer_maturity,
        'duration_days': duration,
        'active_last_30': active_last_30,
        'slope_cac_pct': slope_cac_pct,
        'slope_ratio_pct': slope_ratio_pct,
        'avg_cac': avg_cac,
        'avg_ltv_cac_ratio': avg_ratio,
        'acquisition_sophistication_score': avg_soph_score,
        'cac_efficiency_percentile': avg_cac_eff,
        'channel_diversity_count': avg_channel_diversity,
        'retention_risk': avg_retention_risk,
        'scale_opportunity': avg_scale_opportunity,
        'strategic_customer_segment': strategic_segment,
        'cac_growth_last_vs_prev': cac_growth,
        'ratio_decline_last_vs_prev': ratio_decline,
        'data_points': len(group)
    })

campaign_df = pd.DataFrame(campaign_stats)
print(f"Campaigns analyzed: {len(campaign_df)}")

# Filter campaigns that are active in last 30 days and running >120 days
eligible = campaign_df[(campaign_df['duration_days'] > 120) & (campaign_df['active_last_30'])]
print(f"Eligible campaigns (running >120 days and active last 30): {len(eligible)}")

# Identify campaigns with CAC growth >25% and ratio decline >20% (using recent 30-day comparison)
problem = eligible[(eligible['cac_growth_last_vs_prev'] > 0.25) & (eligible['ratio_decline_last_vs_prev'] < -0.2)]
print(f"Problem campaigns (CAC growth >25%, ratio decline >20% in last 30 days vs previous 30): {len(problem)}")
if len(problem) > 0:
    print(problem[['account_id','advertising_channel_type','campaign_lifecycle_stage','cac_growth_last_vs_prev','ratio_decline_last_vs_prev']])
    
# Identify campaigns with positive CAC trend and negative ratio trend (overall)
trend_problem = eligible[(eligible['slope_cac_pct'] > 0.25) & (eligible['slope_ratio_pct'] < -0.2)]
print(f"Trend problem campaigns (overall trend CAC up >25% and ratio down >20%): {len(trend_problem)}")
if len(trend_problem) > 0:
    print(trend_problem[['account_id','advertising_channel_type','campaign_lifecycle_stage','slope_cac_pct','slope_ratio_pct']])

# Save for reporting
campaign_df.to_csv('campaign_detailed.csv', index=False)
print("Detailed campaign data saved.")
''')
