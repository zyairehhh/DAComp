```
import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv('churn_data.csv')
print(df.head())
plt.figure(figsize=(8,5))
plt.plot(df['Annual Loan Interest Rate'], df['Credit Rating A Customer Churn Rate'], marker='o', label='Rating A')
plt.plot(df['Annual Loan Interest Rate'], df['Credit Rating B Customer Churn Rate'], marker='s', label='Rating B')
plt.plot(df['Annual Loan Interest Rate'], df['Credit Rating C Customer Churn Rate'], marker='^', label='Rating C')
plt.xlabel('Annual Loan Interest Rate', fontsize=12)
plt.ylabel('Customer Churn Rate', fontsize=12)
plt.title('Churn Rate vs. Interest Rate by Credit Rating', fontsize=14)
plt.grid(True, linestyle='--', alpha=0.7)
plt.legend()
plt.tight_layout()
plt.savefig('churn_vs_rate.png', dpi=300)
plt.close()
```
