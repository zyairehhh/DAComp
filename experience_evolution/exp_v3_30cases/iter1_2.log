First, let's get hiring manager analysis. Write a script to compute average conversion rate per hiring manager (for engineering) and show top worst.

Action: CreateFile(filepath='manager_analysis.py':
'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect("dacomp-066.sqlite")

# Join and compute conversion rate per hiring manager
query = """
SELECT 
    e.hiring_managers,
    p.application_year,
    p.application_quarter,
    p.interview_rate,
    e.count_total_interviews,
    e.count_total_applications,
    e.avg_interviews_per_application
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
WHERE e.departments = 'Engineering'
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Split hiring_managers (some rows have multiple? Let's treat as string)
df['hiring_manager'] = df['hiring_managers'].str.split(',').str[0].str.strip()  # take first manager

# Compute average conversion rate per hiring manager across all quarters
manager_avg = df.groupby('hiring_manager')['interview_rate'].agg(['mean', 'count']).round(2)
manager_avg = manager_avg.sort_values('mean').reset_index()
print("Hiring Manager conversion rate (average):")
print(manager_avg.head(10))

# Identify managers with at least 5 jobs to avoid small sample
manager_avg = manager_avg[manager_avg['count'] >= 5]
print("\nManagers with at least 5 jobs, sorted by worst conversion:")
print(manager_avg.head(10))

# Visualize top 10 worst managers (bar chart)
plt.figure(figsize=(10,6))
worst_managers = manager_avg.head(10)
plt.barh(worst_managers['hiring_manager'], worst_managers['mean'])
plt.xlabel('Average Conversion Rate (%)')
plt.title('Top 10 Hiring Managers with Lowest Conversion Rates (Engineering)')
plt.gca().invert_yaxis()
plt.tight_layout()
plt.savefig('worst_managers.png', dpi=150)
plt.close()
print("\nSaved worst_managers.png")
''')
