import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Identify high-volatility customers (top 25% of customer_margin_volatility)
# Use latest value per customer
query = """
WITH latest_volatility AS (
    SELECT 
        pa.customer_id,
        pa.customer_margin_volatility,
        ROW_NUMBER() OVER (PARTITION BY pa.customer_id ORDER BY pa.transaction_date DESC) as rn
    FROM quickbooks__profitability_analysis pa
)
SELECT customer_id, customer_margin_volatility
FROM latest_volatility
WHERE rn = 1
"""
df_vol = pd.read_sql_query(query, conn)
# Compute 75th percentile threshold
threshold = df_vol['customer_margin_volatility'].quantile(0.75)
high_vol_customers = df_vol[df_vol['customer_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"Total customers: {len(df_vol)}")
print(f"High-volatility customers (top 25%): {len(high_vol_customers)}")
print(f"Threshold customer_margin_volatility: {threshold:.6f}")

# 2. Coefficient of variation (std/mean) of gross_profit over past 12 months for each high-volatility customer
# Determine max transaction date
max_date = pd.read_sql_query("SELECT MAX(transaction_date) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'][0]
max_date = pd.Timestamp(max_date)
start_date = max_date - pd.DateOffset(months=12)
print(f"Max date: {max_date}, 12 months ago: {start_date}")

query_profit = """
SELECT customer_id, gross_profit, transaction_date
FROM quickbooks__profitability_analysis
WHERE transaction_date >= ?
"""
df_profit_all = pd.read_sql_query(query_profit, conn, params=[start_date])
# Filter high-volatility customers
df_profit_high = df_profit_all[df_profit_all['customer_id'].isin(high_vol_customers)]

# Compute coefficient of variation per customer
def coeff_var(series):
    mean = series.mean()
    if mean == 0:
        return np.nan
    return series.std() / mean

cv_gross_profit = df_profit_high.groupby('customer_id')['gross_profit'].apply(coeff_var).reset_index()
cv_gross_profit.columns = ['customer_id', 'cv_gross_profit']
print(f"Average coefficient of variation of gross profit for high-volatility customers: {cv_gross_profit['cv_gross_profit'].mean():.4f}")
# summary stats
print(cv_gross_profit.describe())

# Save to CSV for later use
cv_gross_profit.to_csv('cv_gross_profit.csv', index=False)
print("Saved cv_gross_profit.csv")

# 3. Variance of quarter-over-quarter invoice_total growth rate for each high-volatility customer
# We need to aggregate invoice totals per quarter per customer
if len(high_vol_customers) == 0:
    print("No high-volatility customers found!")
else:
    placeholders = ','.join(['?']*len(high_vol_customers))
    df_invoice = pd.read_sql_query(f"""
        SELECT customer_id, invoice_total, transaction_date, revenue_year, revenue_quarter
        FROM quickbooks__profitability_analysis
        WHERE customer_id IN ({placeholders})
    """, conn, params=high_vol_customers)

    # Determine quarter start date
    df_invoice['transaction_date'] = pd.to_datetime(df_invoice['transaction_date'])
    df_invoice['quarter'] = df_invoice['transaction_date'].dt.to_period('Q')

    # Sum invoice_total per quarter per customer
    quarterly = df_invoice.groupby(['customer_id', 'quarter'])['invoice_total'].sum().reset_index()
    # Calculate quarter-over-quarter growth rate
    quarterly = quarterly.sort_values(['customer_id', 'quarter'])
    quarterly['prev_total'] = quarterly.groupby('customer_id')['invoice_total'].shift(1)
    quarterly['qoq_growth'] = (quarterly['invoice_total'] - quarterly['prev_total']) / quarterly['prev_total']
    # Compute variance of growth rates per customer (excluding NaN)
    growth_var = quarterly.groupby('customer_id')['qoq_growth'].var().reset_index()
    growth_var.columns = ['customer_id', 'var_qoq_growth']
    print(f"Average variance of qoq growth: {growth_var['var_qoq_growth'].mean():.6f}")
    print(growth_var.describe())
    growth_var.to_csv('growth_var.csv', index=False)
    print("Saved growth_var.csv")

    # Combine metrics
    metrics = cv_gross_profit.merge(growth_var, on='customer_id', how='outer')

    # 4. Behavioral features from customer_analytics
    df_customer = pd.read_sql_query(f"""
        SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
               lifecycle_stage, customer_maturity_stage, risk_assessment, credit_score
        FROM quickbooks__customer_analytics
        WHERE customer_id IN ({placeholders})
    """, conn, params=high_vol_customers)

    metrics = metrics.merge(df_customer, on='customer_id', how='left')
    print(f"Loaded {len(df_customer)} customer analytics records for high-volatility customers")
    print(metrics.head())

# 5. Financial dashboard data
df_fin = pd.read_sql_query("""
    SELECT dashboard_month, business_health_score, collection_rate_percentage
    FROM quickbooks__financial_dashboard
    ORDER BY dashboard_month DESC
""", conn)
print(f"Financial dashboard records: {df_fin.shape[0]}")
print(df_fin.head())

# 6. Accounts receivable structure from balance_sheet
df_ar = pd.read_sql_query("""
    SELECT account_class, account_type, account_name, amount, period_last_day
    FROM quickbooks__balance_sheet
    WHERE account_class = 'Accounts Receivable' OR account_type = 'Accounts Receivable'
    ORDER BY period_last_day DESC
""", conn)
print(f"Accounts receivable records: {df_ar.shape[0]}")
if not df_ar.empty:
    print(df_ar.head())

# 7. Build a multi-dimensional customer risk rating model
# This will be done in analysis part.

conn.close()
print("Analysis completed.")
```
