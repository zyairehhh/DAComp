print("Creating Plot 1: Email open rates by campaign type...")

# Extract campaign info from events
events_df['occurred_at'] = pd.to_datetime(events_df['occurred_at'])
events_df['day_of_week'] = events_df['occurred_at'].dt.dayofweek
events_df['is_weekend'] = events_df['day_of_week'] >= 5
events_df['hour_of_day'] = events_df['occurred_at'].dt.hour
events_df['is_morning'] = events_df['hour_of_day'] < 12

# Group by campaign type
campaign_stats = events_df.groupby(['campaign_name', 'campaign_subject_line']).agg({
    'event_id': 'count',
    'day_of_week': 'first',
    'hour_of_day': 'first'
}).reset_index()

# Join with campaign flow metrics
campaign_performance = pd.merge(
    campaign_flow_df.groupby('last_touch_campaign_id').agg({
        'email_open_rate_touch': 'mean',
        'email_click_to_open_rate_touch': 'mean',
        'net_revenue_touch': 'sum'
    }).reset_index(),
    campaign_stats,
    left_on='last_touch_campaign_id',
    right_on='campaign_name',
    how='inner'
)

# Plot 1: Email metrics by campaign
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

# Open rate
axes[0].bar(range(len(campaign_performance)), campaign_performance['email_open_rate_touch'])
axes[0].set_title('Email Open Rate by Campaign')
axes[0].set_xlabel('Campaign')
axes[0].set_ylabel('Open Rate')
axes[0].set_xticks(range(len(campaign_performance)))
axes[0].set_xticklabels([f"{row['campaign_name']}\n({row['campaign_subject_line'][:15]}...)" 
                          for _, row in campaign_performance.iterrows()], rotation=45, ha='right')

# Click-to-open rate
axes[1].bar(range(len(campaign_performance)), campaign_performance['email_click_to_open_rate_touch'])
axes[1].set_title('Click-to-Open Rate by Campaign')
axes[1].set_xlabel('Campaign')
axes[1].set_ylabel('Click-to-Open Rate')
axes[1].set_xticks(range(len(campaign_performance)))
axes[1].set_xticklabels([f"{row['campaign_name']}\n({row['campaign_subject_line'][:15]}...)" 
                          for _, row in campaign_performance.iterrows()], rotation=45, ha='right')

# Net revenue
axes[2].bar(range(len(campaign_performance)), campaign_performance['net_revenue_touch'])
axes[2].set_title('Net Revenue by Campaign')
axes[2].set_xlabel('Campaign')
axes[2].set_ylabel('Net Revenue ($)')
axes[2].set_xticks(range(len(campaign_performance)))
axes[2].set_xticklabels([f"{row['campaign_name']}\n({row['campaign_subject_line'][:15]}...)" 
                          for _, row in campaign_performance.iterrows()], rotation=45, ha='right')

plt.tight_layout()
plt.savefig('/workspace/plots/campaign_performance.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 1 saved as /workspace/plots/campaign_performance.png")

# Plot 2: Time-based analysis
print("\nCreating Plot 2: Time-based analysis...")

fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Weekday vs Weekend performance
weekday_mask = ~events_df['is_weekend']
weekend_mask = events_df['is_weekend']

if len(events_df) > 0:
    # Email events by time of day
    morning_mask = events_df['is_morning']
    afternoon_mask = ~events_df['is_morning']
    
    # Time distribution
    ax1 = axes[0, 0]
    time_counts = events_df['hour_of_day'].value_counts().sort_index()
    ax1.bar(time_counts.index, time_counts.values)
    ax1.set_title('Distribution of Email Events by Hour')
    ax1.set_xlabel('Hour of Day')
    ax1.set_ylabel('Number of Events')
    ax1.axvline(x=12, color='red', linestyle='--', alpha=0.5, label='Noon')
    ax1.legend()
    
    # Day of week distribution
    ax2 = axes[0, 1]
    day_names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
    day_counts = events_df['day_of_week'].value_counts().sort_index()
    if not day_counts.empty:
        ax2.bar(range(len(day_counts)), day_counts.values)
        ax2.set_title('Distribution of Email Events by Day of Week')
        ax2.set_xlabel('Day of Week')
        ax2.set_ylabel('Number of Events')
        ax2.set_xticks(range(len(day_counts)))
        ax2.set_xticklabels([day_names[i] for i in day_counts.index])
        ax2.axhline(y=day_counts.mean(), color='red', linestyle='--', alpha=0.5, label=f'Avg: {day_counts.mean():.1f}')
        ax2.legend()
    
    # Holiday analysis (simplified - check for events around major holidays)
    # For this small dataset, we'll just note the distribution
    ax3 = axes[1, 0]
    months_counts = events_df['occurred_at'].dt.month.value_counts().sort_index()
    month_names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
    if not months_counts.empty:
        ax3.bar([month_names[i-1] for i in months_counts.index], months_counts.values)
        ax3.set_title('Distribution of Email Events by Month')
        ax3.set_xlabel('Month')
        ax3.set_ylabel('Number of Events')
        ax3.tick_params(axis='x', rotation=45)
    
    # Campaign performance over time
    ax4 = axes[1, 1]
    campaign_dates = events_df.groupby('campaign_name')['occurred_at'].min().sort_values()
    for i, (campaign, date) in enumerate(campaign_dates.items()):
        ax4.scatter(date, i, s=100, label=campaign)
    
    ax4.set_title('Campaign Launch Timeline')
    ax4.set_xlabel('Date')
    ax4.set_ylabel('Campaign Index')
    ax4.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
    ax4.tick_params(axis='x', rotation=45)

plt.tight_layout()
