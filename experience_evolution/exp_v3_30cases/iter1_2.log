        weekday = date_obj.weekday()  # Monday=0, Sunday=6
        return 'weekday' if weekday < 5 else 'weekend'
    except:
        return None

def categorize_time_period(sent_at):
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        hour = date_obj.hour
        if hour < 12:
            return 'morning'
        elif hour < 18:
