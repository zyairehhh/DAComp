ax3.tick_params(axis='x', rotation=45)
ax3.grid(True, alpha=0.3)

# Plot 4: Payment behavior distribution
ax4 = axes[1, 0]
if len(payment_counts) > 0:
    payment_counts.plot(kind='bar', ax=ax4, color='lightgreen', alpha=0.7)
    ax4.set_title('High-Volatility Customers by Payment Behavior')
    ax4.set_xlabel('Payment Behavior')
    ax4.set_ylabel('Count')
else:
    ax4.text(0.5, 0.5, 'No payment behavior data', 
             ha='center', va='center', transform=ax4.transAxes)
    ax4.set_title('High-Volatility Customers by Payment Behavior')
ax4.tick_params(axis='x', rotation=45)
ax4.grid(True, alpha=0.3)

# Plot 5: RFM segment distribution (top 10)
ax5 = axes[1, 1]
if len(rfm_counts) > 0:
    top_rfm = rfm_counts.head(10)  # Top 10 segments
    top_rfm.plot(kind='bar', ax=ax5, color='skyblue', alpha=0.7)
