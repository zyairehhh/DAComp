import pandas as pd
import numpy as np
import sqlite3

# Load health scores
df = pd.read_csv('campaign_health_scores.csv')
print(df.shape)

# Connect to DB for raw data
conn = sqlite3.connect('dacomp-058.sqlite')

# 1. Compare performance across campaign_type
group_by_type = df.groupby('campaign_type').agg(
    avg_health_score=('health_score', 'mean'),
    avg_cost_efficiency=('cost_efficiency_score', 'mean'),
    avg_conversion_quality=('conversion_quality_score', 'mean'),
    avg_competitiveness=('competitiveness_score', 'mean'),
    high_risk_count=('risk_level', lambda x: (x == 'High').sum()),
    total_campaigns=('campaign_id', 'count')
).reset_index()
print("\n=== Performance by Campaign Type ===")
print(group_by_type)

# 2. By bidding_strategy
group_by_bidding = df.groupby('bidding_strategy').agg(
    avg_health_score=('health_score', 'mean'),
    avg_cost_efficiency=('cost_efficiency_score', 'mean'),
    avg_conversion_quality=('conversion_quality_score', 'mean'),
    avg_competitiveness=('competitiveness_score', 'mean'),
    high_risk_count=('risk_level', lambda x: (x == 'High').sum()),
    total_campaigns=('campaign_id', 'count')
).reset_index()
print("\n=== Performance by Bidding Strategy ===")
print(group_by_bidding)

# 3. By industry
group_by_industry = df.groupby('industry').agg(
    avg_health_score=('health_score', 'mean'),
    avg_cost_efficiency=('cost_efficiency_score', 'mean'),
    avg_conversion_quality=('conversion_quality_score', 'mean'),
    avg_competitiveness=('competitiveness_score', 'mean'),
    high_risk_count=('risk_level', lambda x: (x == 'High').sum()),
    total_campaigns=('campaign_id', 'count')
).reset_index()
print("\n=== Performance by Industry ===")
print(group_by_industry)

# 4. Geographic distribution analysis: we need geo_target from geo_report
geo_query = """
SELECT 
    g.geo_target,
    c.campaign_type,
    c.bidding_strategy,
    c.industry,
    SUM(g.cost) as total_cost,
    SUM(g.conversions) as total_conversions,
    AVG(g.roas) as avg_roas,
    AVG(g.conversion_rate) as avg_conversion_rate,
    AVG(g.impression_share) as avg_impression_share,
    AVG(g.quality_score) as avg_quality_score,
    COUNT(DISTINCT g.campaign_id) as campaigns_count
FROM google_ads__geo_report g
JOIN campaigns c ON g.campaign_id = c.campaign_id
GROUP BY g.geo_target, c.campaign_type, c.bidding_strategy, c.industry
ORDER BY total_cost DESC
"""
geo_df = pd.read_sql_query(geo_query, conn)
print("\n=== Top 10 Geographies by Cost ===")
print(geo_df.head(10))

# 5. Device type analysis
device_query = """
SELECT 
    d.device_type,
    c.campaign_type,
    c.bidding_strategy,
    c.industry,
    SUM(d.cost) as total_cost,
    SUM(d.conversions) as total_conversions,
    AVG(d.roas) as avg_roas,
    AVG(d.conversion_rate) as avg_conversion_rate,
    AVG(d.impression_share) as avg_impression_share,
    AVG(d.quality_score) as avg_quality_score,
    COUNT(DISTINCT d.campaign_id) as campaigns_count
FROM google_ads__device_report d
JOIN campaigns c ON d.campaign_id = c.campaign_id
GROUP BY d.device_type, c.campaign_type, d.bidding_strategy, c.industry
ORDER BY total_cost DESC
"""
device_df = pd.read_sql_query(device_query, conn)
print("\n=== Device Performance ===")
print(device_df)

# 6. Trend changes over 18 months: we need monthly aggregated data per campaign to compute YoY growth rates and seasonal fluctuations.
# Let's compute overall monthly performance across all campaigns
monthly_query = """
SELECT 
    year_month,
    SUM(cost) as total_cost,
    SUM(conversions) as total_conversions,
    SUM(conversion_value) as total_conversion_value,
    AVG(roas) as avg_roas,
    AVG(conversion_rate) as avg_conversion_rate,
    AVG(ctr) as avg_ctr,
    AVG(impression_share) as avg_impression_share,
    AVG(quality_score) as avg_quality_score,
    COUNT(DISTINCT campaign_id) as campaigns_active
FROM google_ads__campaign_report
GROUP BY year_month
ORDER BY year_month
"""
monthly_df = pd.read_sql_query(monthly_query, conn)
print("\n=== Monthly Trend ===")
print(monthly_df)

# Compute year-over-year growth: need to compare same month year over year, we have from Feb 2023 to Jun 2024.
# Let's compute month-over-month growth and YoY growth via pandas.
monthly_df['year_month'] = pd.to_datetime(monthly_df['year_month'], format='%Y-%m')
monthly_df = monthly_df.set_index('year_month')
monthly_df['cost_growth_mom'] = monthly_df['total_cost'].pct_change()
monthly_df['roas_growth_mom'] = monthly_df['avg_roas'].pct_change()
# YoY: shift by 12 months
monthly_df['cost_yoy'] = monthly_df['total_cost'].pct_change(periods=12)
monthly_df['roas_yoy'] = monthly_df['avg_roas'].pct_change(periods=12)
print("\n=== Monthly Growth Rates (last 5 rows) ===")
print(monthly_df.tail())

# Seasonal fluctuation: group by month (1-12) to see average performance per month
monthly_df['month'] = monthly_df.index.month
seasonal = monthly_df.groupby('month').agg(
    avg_cost=('total_cost', 'mean'),
    avg_roas=('avg_roas', 'mean'),
    avg_conversion_rate=('avg_conversion_rate', 'mean')
).reset_index()
print("\n=== Seasonal Patterns by Month (across years) ===")
print(seasonal)

# 7. High-risk campaigns detailed diagnosis
high_risk_campaigns = df[df['risk_level'] == 'High']
high_risk_details = high_risk_campaigns[[
    'campaign_id', 'campaign_name', 'campaign_type', 'bidding_strategy', 'industry',
    'total_cost', 'total_conversions', 'total_conversion_value', 'avg_roas',
    'avg_conversion_rate', 'avg_quality_score', 'avg_impression_share', 'avg_ctr',
    'avg_position', 'geo_hhi', 'device_hhi', 'health_score', 'risk_level'
]]
print("\n=== High Risk Campaigns Details ===")
print(high_risk_details)

# 8. High-cost low ROI campaigns (initial screening)
high_cost_low_roi = df[df['high_cost_low_roi'] == 1]
print(f"\n=== High-Cost Low ROI Campaigns (count: {len(high_cost_low_roi)}) ===")
print(high_cost_low_roi[['campaign_id', 'campaign_name', 'total_cost', 'avg_roas']])

# Generate insights and recommendations (to be written into markdown)
conn.close()
```
