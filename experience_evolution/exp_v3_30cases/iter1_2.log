# Solve OLS
coeff, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)
print("Regression coefficients (including intercept):")
print("Intercept:", coeff[0])
for i, col in enumerate(X_cols, start=1):
    print(f"{col}: {coeff[i]:.4f}")

# Interpret
print("\nInterpretation:")
print(f"Each additional total interview is associated with {coeff[1]:.3f} percentage point increase in conversion rate, holding other variables constant.")
print(f"Each additional day in average process length is associated with {coeff[2]:.3f} percentage point change.")
print(f"Each one-level increase in performance tier (Low->Medium->High) is associated with {coeff[3]:.3f} percentage point increase.")

# Impact of hiring managers relative to baseline (David Thompson)
print("\nImpact of hiring managers relative to David Thompson:")
for i, col in enumerate([col for col in X_cols if col.startswith('hiring_managers_')], start=len(['count_total_interviews', 'avg_process_days', 'performance_tier_numeric'])+1):
    print(f"{col}: {coeff[i]:.3f} percentage points difference")

# R-squared
y_pred = X @ coeff
ss_res = np.sum((y - y_pred) ** 2)
ss_tot = np.sum((y - np.mean(y)) ** 2)
r_squared = 1 - (ss_res / ss_tot)
print(f"\nR-squared: {r_squared:.3f}")
```
