import pandas as pd

# Load user clicks and distinct features
clicks = pd.read_csv('user_clicks_features.csv')
visitors = pd.read_csv('visitor_segment_raw.csv')
merged = pd.merge(visitors, clicks, on='visitor_id', how='left')
merged['clicks_per_feature'] = merged['total_clicks'] / merged['distinct_features_y']
merged['single_feature_use'] = merged['distinct_features_x'] < 5
segment_single = merged[merged['single_feature_use']]
segment_normal = merged[~merged['single_feature_use']]

print("Average total clicks per user:")
print(f"Single-feature-use: {segment_single['total_clicks'].mean():.1f}")
print(f"Normal: {segment_normal['total_clicks'].mean():.1f}")

print("\nAverage clicks per distinct feature:")
print(f"Single-feature-use: {segment_single['clicks_per_feature'].mean():.1f}")
print(f"Normal: {segment_normal['clicks_per_feature'].mean():.1f}")

# Check if single-feature-use users have higher clicks per feature (i.e., they repeat same features)
print("\nClicks per feature distribution:")
print("Single-feature-use:")
print(segment_single['clicks_per_feature'].describe())
print("\nNormal:")
print(segment_normal['clicks_per_feature'].describe())
''')
