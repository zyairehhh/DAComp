Action: CreateFile(filepath="health_score_calculations.py"):
```
import pandas as pd
import numpy as np

# Load filtered campaigns
df = pd.read_csv('filtered_campaigns.csv')
print(df.shape)

# Ensure numeric columns
numeric_cols = ['cost', 'conversions', 'roas', 'quality_score', 'impression_share', 'ctr', 'conversion_rate', 'impressions', 'clicks', 'conversion_value']
for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# 1. Cost Efficiency: combine ROAS (higher better) and cost per conversion (lower better)
# compute cost per conversion = cost/conversions if conversions>0 else inf
df['cost_per_conversion'] = df.apply(lambda row: row['cost']/row['conversions'] if row['conversions']>0 else float('inf'), axis=1)
# Normalize ROAS: higher ROAS better, but all filtered ROAS < 0.8, so we want low ROAS to be bad.
# We'll compute a percentile rank within filtered set (since all are low). Actually we want efficiency: higher ROAS better, lower cost per conversion better.
# Let's compute min-max scaling (0-1) then invert cost per conversion.
def min_max_scale(series):
    if series.nunique() == 0:
        return 0
    return (series - series.min()) / (series.max() - series.min())
df['roas_norm'] = min_max_scale(df['roas'])
df['cpc_norm'] = 1 - min_max_scale(df['cost_per_conversion'])  # lower cost per conversion -> higher score
df['cost_efficiency_score'] = 0.5 * df['roas_norm'] + 0.5 * df['cpc_norm']  # weight equally, later scaled to 0-40

# 2. Conversion Quality: conversion_rate, quality_score, ctr
df['conversion_rate_norm'] = min_max_scale(df['conversion_rate'])
df['quality_score_norm'] = min_max_scale(df['quality_score'])
df['ctr_norm'] = min_max_scale(df['ctr'])
df['conversion_quality_score'] = (df['conversion_rate_norm'] + df['quality_score_norm'] + df['ctr_norm']) / 3

# 3. Competitiveness: impression_share (higher better), perhaps avg_position from keyword_report (lower avg_position better)
# Load avg_position aggregated by campaign and quarter
avg_pos = pd.read_csv('avg_position_by_campaign_quarter.csv')
# need to map quarter to month (approximate). We'll join on campaign_id and assume quarter values apply to each month within quarter.
# We'll create a mapping: quarter string to month range; for simplicity assign to middle month.
# Let's assume first month of quarter: e.g., 2023-Q1 -> month = 2023-01
def quarter_to_month(q):
    year, qnum = q.split('-')
    month = int(qnum[1])*3 - 2  # first month of quarter
    return f"{year}-{month:02d}"
avg_pos['year_month'] = avg_pos['year_quarter'].apply(quarter_to_month)
# Merge with df on campaign_id and year_month
df = df.merge(avg_pos[['campaign_id','year_month','avg_position']], on=['campaign_id','year_month'], how='left')
# Normalize avg_position: lower is better (position 1 is top). So compute 1/avg_position? Actually rank.
df['avg_position_norm'] = 1 - min_max_scale(df['avg_position'])  # lower position -> higher score
df['impression_share_norm'] = min_max_scale(df['impression_share'])
df['competitiveness_score'] = 0.6 * df['impression_share_norm'] + 0.4 * df['avg_position_norm']  # weights

# Now combine to total health score (0-100)
df['health_score'] = df['cost_efficiency_score']*40 + df['conversion_quality_score']*35 + df['competitiveness_score']*25
df['health_score'] = df['health_score'].round(2)

# Add risk level based on health score quartiles
q1 = df['health_score'].quantile(0.25)
q2 = df['health_score'].quantile(0.5)
q3 = df['health_score'].quantile(0.75)
def risk_level(score):
    if score <= q1:
        return 'Critical'
    elif score <= q2:
        return 'High'
    elif score <= q3:
        return 'Medium'
    else:
        return 'Low'
df['risk_level'] = df['health_score'].apply(risk_level)

# Save to CSV
df.to_csv('campaign_health_scores.csv', index=False)
print(df.head())
print(df['risk_level'].value_counts())
```
