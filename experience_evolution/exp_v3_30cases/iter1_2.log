Let me create one more visualization: a time-based analysis of customer engagement patterns using the daily metrics table.

Action: CreateFile(filepath='time_analysis.py':
'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import matplotlib

# Set style
plt.style.use('default')
matplotlib.rcParams['font.size'] = 10

# Connect to the database
conn = sqlite3.connect('dacomp-078.sqlite')

# Load visitor daily metrics
daily_df = pd.read_sql_query("SELECT * FROM pendo__visitor_daily_metrics", conn)
conn.close()

# Convert date_day to datetime
daily_df['date_day'] = pd.to_datetime(daily_df['date_day'])
daily_df['month'] = daily_df['date_day'].dt.to_period('M')

# Aggregate by month
monthly_engagement = daily_df.groupby('month').agg({
    'sum_minutes': 'sum',
    'sum_events': 'sum',
    'count_event_records': 'sum',
    'count_pages_viewed': 'sum',
    'count_features_clicked': 'sum',
    'visitor_id': pd.Series.nunique  # Count unique visitors
}).reset_index()

# Convert month back to string for plotting
monthly_engagement['month_str'] = monthly_engagement['month'].astype(str)

# Create figure with multiple subplots
fig, axes = plt.subplots(3, 2, figsize=(14, 12))
fig.suptitle('Monthly Engagement Patterns for 3-6 Month Trend Prediction', fontsize=14, y=0.98)

# Plot 1: Total minutes over time
axes[0, 0].plot(monthly_engagement['month_str'], monthly_engagement['sum_minutes'], 
                marker='o', linewidth=2, markersize=6)
axes[0, 0].set_title('Total Usage Duration by Month')
axes[0, 0].set_xlabel('Month')
axes[0, 0].set_ylabel('Total Minutes')
axes[0, 0].grid(True, alpha=0.3)
axes[0, 0].tick_params(axis='x', rotation=45)

# Plot 2: Total events over time
axes[0, 1].plot(monthly_engagement['month_str'], monthly_engagement['sum_events'], 
                marker='s', linewidth=2, markersize=6, color='orange')
axes[0, 1].set_title('Total Events by Month')
axes[0, 1].set_xlabel('Month')
axes[0, 1].set_ylabel('Total Events')
axes[0, 1].grid(True, alpha=0.3)
axes[0, 1].tick_params(axis='x', rotation=45)

# Plot 3: Unique visitors over time
axes[1, 0].plot(monthly_engagement['month_str'], monthly_engagement['visitor_id'], 
                marker='^', linewidth=2, markersize=6, color='green')
axes[1, 0].set_title('Active Visitors by Month')
axes[1, 0].set_xlabel('Month')
axes[1, 0].set_ylabel('Unique Visitors')
axes[1, 0].grid(True, alpha=0.3)
axes[1, 0].tick_params(axis='x', rotation=45)

# Plot 4: Pages vs Features clicked
bar_width = 0.35
x_indices = np.arange(len(monthly_engagement['month_str']))
axes[1, 1].bar(x_indices - bar_width/2, monthly_engagement['count_pages_viewed'], 
              width=bar_width, label='Pages Viewed', alpha=0.7)
axes[1, 1].bar(x_indices + bar_width/2, monthly_engagement['count_features_clicked'], 
              width=bar_width, label='Features Clicked', alpha=0.7)
axes[1, 1].set_title('Engagement Types by Month')
axes[1, 1].set_xlabel('Month')
axes[1, 1].set_ylabel('Count')
axes[1, 1].set_xticks(x_indices)
axes[1, 1].set_xticklabels(monthly_engagement['month_str'], rotation=45)
axes[1, 1].legend()
axes[1, 1].grid(True, alpha=0.3)

# Plot 5: Average engagement per visitor
monthly_engagement['avg_minutes_per_visitor'] = monthly_engagement['sum_minutes'] / monthly_engagement['visitor_id']
monthly_engagement['avg_events_per_visitor'] = monthly_engagement['sum_events'] / monthly_engagement['visitor_id']

axes[2, 0].plot(monthly_engagement['month_str'], monthly_engagement['avg_minutes_per_visitor'], 
                marker='d', linewidth=2, markersize=6, color='purple', label='Minutes/Visitor')
axes[2, 0].set_title('Average Engagement per Visitor')
axes[2, 0].set_xlabel('Month')
axes[2, 0].set_ylabel('Minutes per Visitor')
axes[2, 0].grid(True, alpha=0.3)
axes[2, 0].tick_params(axis='x', rotation=45)

ax2 = axes[2, 0].twinx()
