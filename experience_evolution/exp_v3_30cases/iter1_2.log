    AVG(cost_per_conversion) as avg_cpcv,
    COUNT(DISTINCT year_month) as months_active,
    -- flag if any month had cost > 1000 and roas < 0.8
    MAX(CASE WHEN cost > 1000 AND roas < 0.8 THEN 1 ELSE 0 END) as high_cost_low_roi_flag
FROM google_ads__campaign_report
GROUP BY campaign_id, campaign_name, campaign_type, bidding_strategy, industry
"""
campaign_df = pd.read_sql_query(campaign_agg_query, conn)

# Load keyword report aggregated per campaign to get avg_position
keyword_agg_query = """
SELECT 
    campaign_id,
    AVG(avg_position) as avg_position,
    AVG(impression_share) as keyword_imp_share,
    AVG(quality_score) as keyword_quality_score
FROM google_ads__keyword_report
GROUP BY campaign_id
"""
keyword_df = pd.read_sql_query(keyword_agg_query, conn)

# Merge
df = pd.merge(campaign_df, keyword_df, on='campaign_id', how='left')

# Fill missing avg_position with median
df['avg_position'].fillna(df['avg_position'].median(), inplace=True)
# Fill other missing with campaign-level averages
df['keyword_imp_share'].fillna(df['avg_impression_share'], inplace=True)
df['keyword_quality_score'].fillna(df['avg_quality_score'], inplace=True)

# Load geo and device distribution metrics (optional)
# For competitiveness we might want geographic concentration or device split
# For simplicity, we compute entropy of geo distribution?
# Let's compute geo concentration: Herfindahl index
geo_query = """
SELECT 
    campaign_id,
    geo_target,
    SUM(cost) as geo_cost
FROM google_ads__geo_report
GROUP BY campaign_id, geo_target
"""
geo_df = pd.read_sql_query(geo_query, conn)
# Compute HHI per campaign
def compute_hhi(group):
    shares = group / group.sum()
    hhi = (shares ** 2).sum()
    return hhi
geo_hhi = geo_df.groupby('campaign_id')['geo_cost'].apply(compute_hhi).reset_index(name='geo_hhi')
df = pd.merge(df, geo_hhi, on='campaign_id', how='left')
df['geo_hhi'].fillna(0, inplace=True)

# Device distribution concentration
device_query = """
SELECT 
    campaign_id,
    device_type,
    SUM(cost) as device_cost
FROM google_ads__device_report
GROUP BY campaign_id, device_type
"""
device_df = pd.read_sql_query(device_query, conn)
device_hhi = device_df.groupby('campaign_id')['device_cost'].apply(compute_hhi).reset_index(name='device_hhi')
df = pd.merge(df, device_hhi, on='campaign_id', how='left')
df['device_hhi'].fillna(0, inplace=True)

# Now compute dimension scores
# For each metric, we need to map to a 0-100 scale where higher is better.
# We'll use percentile rank (0-100) across campaigns.
# Define metrics per dimension:
# Cost Efficiency: avg_roas (higher better), avg_cpc (lower better), avg_cpcv (lower better) 
# We'll invert cpc and cpcv.
# Conversion Quality: avg_conversion_rate (higher better), avg_quality_score (higher better)
# Competitiveness: avg_impression_share (higher better), avg_ctr (higher better), avg_position (lower better -> higher rank), geo_hhi (lower concentration better? Actually high concentration may be negative, but maybe geographic focus is good? Let's assume high concentration means risk; we want diversification), device_hhi similarly.
# We'll also include keyword_imp_share and keyword_quality_score maybe.

# Let's compute percentile rank for each metric (higher score = better).
# For metrics where lower is better (avg_cpc, avg_cpcv, avg_position, geo_hhi, device_hhi), we invert by computing (1 - percentile) or compute rank based on ascending order.

def percentile_rank(series):
    # returns 0-100 percentile rank (higher value = higher better)
    return series.rank(pct=True) * 100

def inv_percentile_rank(series):
    # lower better: rank ascending
    return (1 - series.rank(pct=True)) * 100

# Cost Efficiency metrics
df['roas_rank'] = percentile_rank(df['avg_roas'])
df['cpc_rank'] = inv_percentile_rank(df['avg_cpc'])
df['cpcv_rank'] = inv_percentile_rank(df['avg_cpcv'])
# Weighted sum: we can assign weights arbitrarily within dimension, but we'll just average.
df['cost_efficiency_score'] = (df['roas_rank'] * 0.5 + df['cpc_rank'] * 0.25 + df['cpcv_rank'] * 0.25)  # weights can be adjusted

# Conversion Quality metrics
df['conv_rate_rank'] = percentile_rank(df['avg_conversion_rate'])
df['quality_score_rank'] = percentile_rank(df['avg_quality_score'])
df['keyword_quality_rank'] = percentile_rank(df['keyword_quality_score'])
df['conversion_quality_score'] = (df['conv_rate_rank'] * 0.4 + df['quality_score_rank'] * 0.3 + df['keyword_quality_rank'] * 0.3)

# Competitiveness metrics
df['imp_share_rank'] = percentile_rank(df['avg_impression_share'])
df['ctr_rank'] = percentile_rank(df['avg_ctr'])
df['position_rank'] = inv_percentile_rank(df['avg_position'])  # lower position better
df['geo_diversity_rank'] = inv_percentile_rank(df['geo_hhi'])  # lower HHI better
df['device_diversity_rank'] = inv_percentile_rank(df['device_hhi'])
df['competitiveness_score'] = (df['imp_share_rank'] * 0.3 + df['ctr_rank'] * 0.2 + df['position_rank'] * 0.2 + df['geo_diversity_rank'] * 0.15 + df['device_diversity_rank'] * 0.15)

# Overall health score weighted sum
df['health_score'] = df['cost_efficiency_score'] * 0.4 + df['conversion_quality_score'] * 0.35 + df['competitiveness_score'] * 0.25

# Risk level based on health score percentiles: High risk (bottom 25%), Medium risk (25-75%), Low risk (top 25%)
df['risk_percentile'] = df['health_score'].rank(pct=True)
df['risk_level'] = pd.cut(df['risk_percentile'], bins=[0, 0.25, 0.75, 1], labels=['High', 'Medium', 'Low'], include_lowest=True)

# Also add flag for high-cost low ROI campaigns (initial screening)
df['high_cost_low_roi'] = df['high_cost_low_roi_flag']

# Save to CSV for inspection
df.to_csv('campaign_health_scores.csv', index=False)

print("Health scores computed. Sample:")
print(df[['campaign_id', 'campaign_name', 'health_score', 'risk_level', 'high_cost_low_roi']].head())
print(f"\nTotal campaigns: {len(df)}")
print(f"High risk count: {len(df[df['risk_level']=='High'])}")
print(f"High-cost low ROI count: {df['high_cost_low_roi'].sum()}")

conn.close()
''')
