'''
import pandas as pd
import sqlite3
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-092.sqlite')

# Determine max date and past 12 months
max_date_str = pd.read_sql_query("SELECT MAX(revenue_month_start) as max_date FROM quickbooks__profitability_analysis", conn)['max_date'][0]
max_date = pd.to_datetime(max_date_str).date()
start_date = (max_date - timedelta(days=365)).strftime('%Y-%m-%d')
max_date_str = max_date.strftime('%Y-%m-%d')

# 1. Identify high-volatility customers (top 25% volatility)
vol_df = pd.read_sql_query("""
    SELECT DISTINCT customer_id, customer_margin_volatility
    FROM quickbooks__profitability_analysis
    WHERE customer_margin_volatility IS NOT NULL
""", conn)
threshold = vol_df['customer_margin_volatility'].quantile(0.75)
high_vol_ids = vol_df[vol_df['customer_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customer count: {len(high_vol_ids)}")

# 2. Fetch all profitability data for past 12 months
query_all = f"""
    SELECT customer_id, revenue_month_start, invoice_total, collected_amount, gross_profit
    FROM quickbooks__profitability_analysis
    WHERE DATE(revenue_month_start) >= DATE('{start_date}')
        AND DATE(revenue_month_start) <= DATE('{max_date_str}')
"""
df_all = pd.read_sql_query(query_all, conn)
print(f"All transactions (past 12 months): {df_all.shape[0]}")

# 3. Compute overall totals (including all customers)
total_invoice = df_all['invoice_total'].sum()
total_collected = df_all['collected_amount'].sum()
total_profit = df_all['gross_profit'].sum()
overall_collection_rate = total_collected / total_invoice if total_invoice > 0 else 0
overall_profit_margin = total_profit / total_invoice if total_invoice > 0 else 0

print(f"Overall total invoice: {total_invoice:,.2f}")
print(f"Overall total collected: {total_collected:,.2f}")
print(f"Overall total profit: {total_profit:,.2f}")
print(f"Overall collection rate: {overall_collection_rate:.2%}")
print(f"Overall profit margin: {overall_profit_margin:.2%}")

# 4. Compute totals for high-volatility customers
df_high = df_all[df_all['customer_id'].isin(high_vol_ids)]
high_invoice = df_high['invoice_total'].sum()
high_collected = df_high['collected_amount'].sum()
high_profit = df_high['gross_profit'].sum()
high_collection_rate = high_collected / high_invoice if high_invoice > 0 else 0
high_profit_margin = high_profit / high_invoice if high_invoice > 0 else 0

print(f"\nHigh-volatility customer segment:")
print(f"  - Invoice total: {high_invoice:,.2f} ({high_invoice/total_invoice:.2%} of overall)")
print(f"  - Collected amount: {high_collected:,.2f} ({high_collected/total_collected:.2%} of overall)")
print(f"  - Gross profit: {high_profit:,.2f} ({high_profit/total_profit:.2%} of overall)")
print(f"  - Collection rate: {high_collection_rate:.2%} (overall: {overall_collection_rate:.2%})")
print(f"  - Profit margin: {high_profit_margin:.2%} (overall: {overall_profit_margin:.2%})")

# 5. Compare with financial_dashboard metrics (latest month)
dashboard = pd.read_sql_query("""
    SELECT dashboard_month, business_health_score, collection_rate_percentage
    FROM quickbooks__financial_dashboard
    ORDER BY dashboard_month DESC LIMIT 1
""", conn)
print(f"\nLatest dashboard month: {dashboard['dashboard_month'][0]}")
print(f"Business health score: {dashboard['business_health_score'][0]:.2f}")
print(f"Collection rate %: {dashboard['collection_rate_percentage'][0]:.2f}")

# 6. Compute contribution to business_health_score? Hard to compute directly.
# We'll compute a derived metric: contribution ratio of high-volatility profit vs overall profit.
# Assume business_health_score is impacted by profit stability.
# We'll compute stability metrics (CV) and see correlation.

# 7. Analyze risk exposure from balance_sheet (accounts receivable structure)
# Let's examine accounts receivable entries.
balance = pd.read_sql_query("""
    SELECT account_class, account_type, account_sub_type, amount, calendar_date
    FROM quickbooks__balance_sheet
    WHERE account_class = 'Accounts Receivable'
    AND calendar_date = (SELECT MAX(calendar_date) FROM quickbooks__balance_sheet)
""", conn)
print(f"\nAccounts Receivable breakdown at latest date:")
print(balance.groupby(['account_type','account_sub_type'])['amount'].sum().reset_index())

# Summarize total AR
total_ar = balance['amount'].sum()
print(f"Total Accounts Receivable: {total_ar:,.2f}")

conn.close()
''')
