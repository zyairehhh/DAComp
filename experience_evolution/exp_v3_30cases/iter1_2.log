import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re
from datetime import datetime
import os

# Connect to database
db_path = 'dacomp-100.sqlite'  # relative to workspace
if not os.path.exists(db_path):
    db_path = '/workspace/dacomp-100.sqlite'
print(f"Using DB path: {db_path}")
conn = sqlite3.connect(db_path)

# Load company enhanced data
company_df = pd.read_sql_query("SELECT * FROM intercom__company_enhanced", conn)
# Load company metrics
company_metrics_df = pd.read_sql_query("SELECT * FROM intercom__company_metrics", conn)
# Load conversation metrics
conv_df = pd.read_sql_query("SELECT * FROM intercom__conversation_metrics", conn)
conn.close()

# Parse all_company_tags into columns
def parse_tags(tag_string):
    tags = {}
    if isinstance(tag_string, str):
        parts = tag_string.split('|')
        for part in parts:
            if '=' in part:
                key, value = part.split('=', 1)
                tags[key.strip()] = value.strip()
    return tags

# Apply parsing
tag_records = company_df['all_company_tags'].apply(parse_tags)
tag_df = pd.DataFrame(tag_records.tolist())

# Combine with company_df
company_parsed = pd.concat([company_df, tag_df], axis=1)

# Extract renewal outcome: we can infer renewal from renewal_history positive percentages?
# For simplicity, define renewal outcome: if renewal_window is 'within_30_days_past' AND renewal_history positive? 
# Let's check distinct renewal_history values
print("Renewal history values sample:", company_parsed['renewal_history'].dropna().unique()[:10])
print("Renewal window values:", company_parsed['renewal_window'].dropna().unique())

# We need to define binary target: renewed vs churned.
# Since we don't have explicit label, we can use health_score as proxy or infer from renewal_history.
# Let's compute feature adoption percentage from feature_adoption column (e.g., "High (94%)" -> 94)
def extract_percentage(val):
    if isinstance(val, str):
        match = re.search(r'(\d+)%', val)
        if match:
            return int(match.group(1)) / 100.0
    return np.nan

company_parsed['feature_adoption_pct'] = company_parsed['feature_adoption'].apply(extract_percentage)

# Extract sentiment trend categories
print("Sentiment trend values:", company_parsed['sentiment_trend'].dropna().unique())

# Compute communication & interaction features from conversation data.
# Need avg number of conversations last 30 days per company.
# But conversation_metrics has conversation_created_at; we can filter last 30 days relative to some reference date.
# Since we don't have a reference date, maybe use current date max conversation date.
# Let's compute overall average conversation count per company from company_metrics.
conv_count = company_metrics_df[['company_id', 'total_conversations']].copy()

# Compute proportion of negative sentiment: need sentiment per conversation? Not present.
# Instead, we can use sentiment_trend from tags (uplift, stable, at-risk, positive, watch).
# Map to numeric: uplift=2, positive=1, stable=0, watch=-1, at-risk=-2.
sentiment_map = {
    'uplift': 2,
    'positive': 1,
    'stable': 0,
    'watch': -1,
    'at-risk': -2
}
company_parsed['sentiment_score'] = company_parsed['sentiment_trend'].map(sentiment_map)

# Support experience features: avg resolution time (p50_time_to_last_close_min from company_metrics)
# and proportion reopened conversations (p50_reopens? Actually count_reopens/total conversations)
# company_metrics has p50_reopens (median reopens per conversation?).
# Better compute from conversation_metrics: count_reopens per conversation, then aggregate by company.
# Let's compute aggregated support features
conv_agg = conv_df.groupby('company_id').agg(
    avg_resolution_time=('time_to_last_close_minutes', 'mean'),
    total_conversations=('conversation_id', 'count'),
    total_reopens=('count_reopens', 'sum')
).reset_index()
conv_agg['reopen_proportion'] = conv_agg['total_reopens'] / conv_agg['total_conversations']

# Product value features: 
# 1) key feature adoption coverage: we have feature_adoption_pct.
# 2) time since last value milestone: need to parse last_value_milestone date? It's description not date.
# Instead, maybe use renewal_date vs current date? Not provided.
# For visualization, we can use health_score as proxy.
print("Columns in company_parsed:", company_parsed.columns.tolist())

# Merge everything
company_features = company_parsed.merge(company_metrics_df[['company_id', 'p50_time_to_last_close_min', 'p50_reopens']], on='company_id', how='left')
company_features = company_features.merge(conv_agg, on='company_id', how='left')
company_features = company_features.merge(conv_count, on='company_id', suffixes=('', '_from_metrics'), how='left')

# Save to CSV for inspection
output_path = '/workspace/company_features.csv'
company_features.to_csv(output_path, index=False)
print("Data saved, rows:", company_features.shape[0])
print("Preview:")
print(company_features[['company_id', 'feature_adoption_pct', 'sentiment_score', 'avg_resolution_time', 'reopen_proportion', 'health_score']].head())
```
