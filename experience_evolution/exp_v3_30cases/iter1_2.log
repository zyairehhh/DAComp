Action: CreateFile(filepath="/workspace/create_plots.py"):
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import os

# Connect to the database
conn = sqlite3.connect('/workspace/dacomp-069.sqlite')

# Query geo market analysis for com.dev.photoeditor
df = pd.read_sql_query("""
SELECT * FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor'
""", conn)

print(f"Found {len(df)} rows for com.dev.photoeditor")

# Also get performance dashboard data for the app
perf_df = pd.read_sql_query("""
SELECT * FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor'
""", conn)

print(f"Performance dashboard rows: {len(perf_df)}")

conn.close()

# Ensure output directory
os.makedirs('/workspace/plots', exist_ok=True)

# 1. Bar chart: overall_market_score per country (top markets)
df_sorted = df.sort_values('overall_market_score', ascending=False)
plt.figure(figsize=(10,6))
bars = plt.bar(df_sorted['country'], df_sorted['overall_market_score'], color='skyblue')
plt.title('Overall Market Score by Country for com.dev.photoeditor')
plt.xlabel('Country')
plt.ylabel('Overall Market Score')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/plots/overall_market_score_by_country.png', dpi=300)
plt.close()

# 2. Scatter plot: revenue_last_30_days vs day_30_retention_rate, colored by region
plt.figure(figsize=(10,6))
scatter = plt.scatter(df['revenue_last_30_days'], df['day_30_retention_rate'], c=pd.factorize(df['region'])[0], cmap='tab20', s=100, alpha=0.7)
plt.title('Revenue vs 30‑Day Retention by Region')
plt.xlabel('Revenue Last 30 Days ($)')
plt.ylabel('30‑Day Retention Rate')
plt.colorbar(scatter, label='Region')
plt.tight_layout()
plt.savefig('/workspace/plots/revenue_vs_retention.png', dpi=300)
plt.close()

# 3. Horizontal bar chart: avg_daily_installs per country, grouped by revenue_tier
df['revenue_tier'] = df['revenue_tier'].fillna('Unknown')
df.groupby(['country', 'revenue_tier'])['avg_daily_installs'].sum().unstack().plot(kind='barh', stacked=True, figsize=(10,8))
plt.title('Average Daily Installs by Country and Revenue Tier')
plt.xlabel('Average Daily Installs')
plt.ylabel('Country')
plt.legend(title='Revenue Tier')
plt.tight_layout()
plt.savefig('/workspace/plots/installs_by_tier.png', dpi=300)
plt.close()

# 4. Line chart: weekly_growth_rate across countries (sorted)
df_sorted2 = df.sort_values('weekly_growth_rate')
plt.figure(figsize=(10,6))
plt.plot(df_sorted2['country'], df_sorted2['weekly_growth_rate'], marker='o', color='green')
plt.axhline(y=0, color='r', linestyle='--', alpha=0.5)
plt.title('Weekly Growth Rate by Country')
plt.xlabel('Country')
plt.ylabel('Weekly Growth Rate')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/plots/weekly_growth_rate.png', dpi=300)
plt.close()

# 5. Heatmap style: correlation matrix for numeric columns
numeric_cols = df.select_dtypes(include=['number']).columns
corr = df[numeric_cols].corr()
# Plot heatmap
fig, ax = plt.subplots(figsize=(12,10))
cax = ax.matshow(corr, cmap='coolwarm')
fig.colorbar(cax)
plt.xticks(range(len(corr.columns)), corr.columns, rotation=90)
plt.yticks(range(len(corr.columns)), corr.columns)
plt.title('Correlation Matrix of Metrics for com.dev.photoeditor')
plt.tight_layout()
plt.savefig('/workspace/plots/correlation_matrix.png', dpi=300)
plt.close()

print("Plots saved to /workspace/plots/")
