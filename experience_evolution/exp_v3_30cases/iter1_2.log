import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-070.sqlite')

# Load data
ts = pd.read_sql_query("SELECT * FROM google_play__time_series_trends", conn)
country = pd.read_sql_query("SELECT * FROM google_play__country_report", conn)
device = pd.read_sql_query("SELECT * FROM google_play__device_report", conn)

# Convert date columns
ts['date_day'] = pd.to_datetime(ts['date_day'])
country['date_day'] = pd.to_datetime(country['date_day'])
device['date_day'] = pd.to_datetime(device['date_day'])

print("Data loaded.")
print("Time series shape:", ts.shape)
print("Country shape:", country.shape)
print("Device shape:", device.shape)

# Helper function for linear regression using numpy
def linear_regression(X, y):
    # Add constant column
    X = np.column_stack([np.ones(X.shape[0]), X])
    try:
        coeffs = np.linalg.lstsq(X, y, rcond=None)[0]
        y_pred = X @ coeffs
        ss_res = np.sum((y - y_pred) ** 2)
        ss_tot = np.sum((y - np.mean(y)) ** 2)
        r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else np.nan
        return coeffs, r2
    except np.linalg.LinAlgError:
        return np.array([np.nan, np.nan]), np.nan

# ---------- 1. Decay patterns of user acquisition cost-efficiency ----------
# Compute revenue per install (RPI) at package-date level as proxy for cost-efficiency
ts['revenue_per_install'] = ts['daily_revenue'] / ts['daily_installs'].replace(0, np.nan)
# Compute days since start
ts['days_since_start'] = (ts['date_day'] - ts['date_day'].min()).dt.days

# For each package, compute linear trend of RPI over time (decay)
results_rpi = []
for pkg in ts['package_name'].unique():
    sub = ts[ts['package_name'] == pkg].sort_values('date_day')
    if len(sub) < 30:
        continue
    X = sub['days_since_start'].values.reshape(-1, 1)
    y = sub['revenue_per_install'].fillna(0).values
    coeffs, r2 = linear_regression(X, y)
    results_rpi.append({
        'package': pkg,
        'trend_slope': coeffs[1] if len(coeffs) > 1 else np.nan,
        'intercept': coeffs[0] if len(coeffs) > 0 else np.nan,
        'r2': r2,
        'start_rpi': sub['revenue_per_install'].iloc[0],
        'end_rpi': sub['revenue_per_install'].iloc[-1]
    })

rpi_trend = pd.DataFrame(results_rpi)
print("\n--- Revenue Per Install Decay Over Time (per package) ---")
print(rpi_trend)

# Now by region and device type combination? Need to merge region and device.
# We can compute conversion rate decay per region and device brand.
# For region: aggregate country_report by region, date, package (store_listing_conversion_rate)
region_conv = country.groupby(['date_day', 'region', 'package_name'])['store_listing_conversion_rate'].mean().reset_index()
region_conv['days_since_start'] = (region_conv['date_day'] - region_conv['date_day'].min()).dt.days

# For device: extract brand and aggregate conversion? Conversion not available at device level.
# Instead, we can compute installs per device brand as proxy for acquisition efficiency.
device['device_brand'] = device['device'].apply(lambda x: x.split()[0] if isinstance(x, str) else x)
device_installs = device.groupby(['date_day', 'device_brand', 'package_name'])['install_events'].sum().reset_index()
device_installs['days_since_start'] = (device_installs['date_day'] - device_installs['date_day'].min()).dt.days

# Compute decay of installs over time per brand-package (might indicate saturation)
decay_installs = []
for pkg in device_installs['package_name'].unique():
    for brand in device_installs['device_brand'].unique():
        sub = device_installs[(device_installs['package_name'] == pkg) & (device_installs['device_brand'] == brand)]
        if len(sub) < 10:
            continue
        X = sub['days_since_start'].values.reshape(-1, 1)
        y = sub['install_events'].values
        coeffs, r2 = linear_regression(X, y)
        decay_installs.append({
            'package': pkg,
            'device_brand': brand,
            'trend_slope': coeffs[1] if len(coeffs) > 1 else np.nan,
            'r2': r2,
            'start_installs': sub['install_events'].iloc[0],
            'end_installs': sub['install_events'].iloc[-1]
        })

decay_installs_df = pd.DataFrame(decay_installs)
print("\n--- Install Events Decay by Device Brand ---")
print(decay_installs_df.sort_values('trend_slope').head(10))

# Similarly for region conversion decay
decay_region = []
for pkg in region_conv['package_name'].unique():
    for region in region_conv['region'].unique():
        sub = region_conv[(region_conv['package_name'] == pkg) & (region_conv['region'] == region)]
        if len(sub) < 10:
            continue
        X = sub['days_since_start'].values.reshape(-1, 1)
        y = sub['store_listing_conversion_rate'].values
        coeffs, r2 = linear_regression(X, y)
        decay_region.append({
            'package': pkg,
            'region': region,
            'trend_slope': coeffs[1],
            'r2': r2,
            'start_conv': sub['store_listing_conversion_rate'].iloc[0],
            'end_conv': sub['store_listing_conversion_rate'].iloc[-1]
        })

decay_region_df = pd.DataFrame(decay_region)
print("\n--- Conversion Rate Decay by Region ---")
print(decay_region_df.sort_values('trend_slope').head(10))

# ---------- 2. Non-linear relationship between conversion_rate and quality_score / crash_rate ----------
# Merge region conversion with quality_score and crash_rate from time_series
merged = region_conv.merge(ts[['date_day', 'package_name', 'quality_score', 'crash_rate_per_1k']], on=['date_day', 'package_name'], how='left')

# Compute correlation matrix
corr = merged[['store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k']].corr()
print("\n--- Correlation between Conversion Rate, Quality Score, Crash Rate ---")
print(corr)

# Polynomial regression manually: Use quadratic terms
merged['quality_sq'] = merged['quality_score'] ** 2
merged['crash_sq'] = merged['crash_rate_per_1k'] ** 2
merged['interaction'] = merged['quality_score'] * merged['crash_rate_per_1k']

X = merged[['quality_score', 'crash_rate_per_1k', 'quality_sq', 'crash_sq', 'interaction']].dropna()
y = merged.loc[X.index, 'store_listing_conversion_rate']
X_np = np.column_stack([np.ones(X.shape[0]), X])
try:
    coeffs = np.linalg.lstsq(X_np, y, rcond=None)[0]
    y_pred = X_np @ coeffs
    ss_res = np.sum((y - y_pred) ** 2)
    ss_tot = np.sum((y - np.mean(y)) ** 2)
    r2 = 1 - (ss_res / ss_tot)
    print("\n--- Quadratic Model for Conversion Rate ---")
    print(f"Intercept: {coeffs[0]:.6f}")
    for i, col in enumerate(['quality_score', 'crash_rate_per_1k', 'quality_sq', 'crash_sq', 'interaction']):
        print(f"{col}: {coeffs[i+1]:.6f}")
    print(f"R-squared: {r2:.4f}")
except np.linalg.LinAlgError as e:
    print("Polynomial regression failed:", e)

# ---------- 3. Multi-dimensional user value decay model ----------
# Predict revenue_per_active_device using conversion, quality, crash, region, days
merged_val = region_conv.merge(ts[['date_day', 'package_name', 'quality_score', 'crash_rate_per_1k', 'revenue_per_active_device']], on=['date_day', 'package_name'], how='left')
merged_val['days_since_start'] = (merged_val['date_day'] - merged_val['date_day'].min()).dt.days
# Dummy encode region
region_dummies = pd.get_dummies(merged_val['region'], prefix='region', drop_first=True)
X_val = pd.concat([merged_val[['store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k', 'days_since_start']], region_dummies], axis=1).dropna()
y_val = merged_val.loc[X_val.index, 'revenue_per_active_device']
X_val_np = np.column_stack([np.ones(X_val.shape[0]), X_val])
try:
    coeffs_val = np.linalg.lstsq(X_val_np, y_val, rcond=None)[0]
    y_pred_val = X_val_np @ coeffs_val
    ss_res_val = np.sum((y_val - y_pred_val) ** 2)
    ss_tot_val = np.sum((y_val - np.mean(y_val)) ** 2)
    r2_val = 1 - (ss_res_val / ss_tot_val)
    print("\n--- User Value Decay Model (Revenue per Active Device) ---")
    print(f"Intercept: {coeffs_val[0]:.6f}")
    for i, col in enumerate(X_val.columns):
        print(f"{col}: {coeffs_val[i+1]:.6f}")
    print(f"R-squared: {r2_val:.4f}")
except np.linalg.LinAlgError as e:
    print("Regression failed:", e)

# ---------- 4. Interaction effect of app update frequency ----------
# Compute total update events per package per day across all devices
update_freq = device.groupby(['date_day', 'package_name'])['update_events'].sum().reset_index()
update_freq.rename(columns={'update_events': 'total_update_events'}, inplace=True)
# Aggregate country_report by date, package, region (sum active devices, average rating)
country_agg = country.groupby(['date_day', 'package_name', 'region']).agg({
    'active_devices_last_30_days': 'sum',
    'rolling_total_average_rating': 'mean'
}).reset_index()
merged_update = country_agg.merge(update_freq, on=['date_day', 'package_name'], how='left')

# Encode region as numeric
region_codes = {region: idx for idx, region in enumerate(merged_update['region'].unique())}
merged_update['region_code'] = merged_update['region'].map(region_codes)
merged_update['interaction'] = merged_update['total_update_events'] * merged_update['region_code']

# Model for active devices
X_active = merged_update[['total_update_events', 'region_code', 'interaction']].dropna()
y_active = merged_update.loc[X_active.index, 'active_devices_last_30_days']
X_active_np = np.column_stack([np.ones(X_active.shape[0]), X_active])
coeffs_active = np.linalg.lstsq(X_active_np, y_active, rcond=None)[0]
y_pred_active = X_active_np @ coeffs_active
ss_res_active = np.sum((y_active - y_pred_active) ** 2)
ss_tot_active = np.sum((y_active - np.mean(y_active)) ** 2)
r2_active = 1 - (ss_res_active / ss_tot_active)
print("\n--- Update Frequency Effect on Active Devices (with region interaction) ---")
print(f"Intercept: {coeffs_active[0]:.6f}")
print(f"total_update_events: {coeffs_active[1]:.6f}")
print(f"region_code: {coeffs_active[2]:.6f}")
print(f"interaction: {coeffs_active[3]:.6f}")
print(f"R-squared: {r2_active:.4f}")

# Model for rolling rating
y_rating = merged_update.loc[X_active.index, 'rolling_total_average_rating']
coeffs_rating = np.linalg.lstsq(X_active_np, y_rating, rcond=None)[0]
y_pred_rating = X_active_np @ coeffs_rating
ss_res_rating = np.sum((y_rating - y_pred_rating) ** 2)
ss_tot_rating = np.sum((y_rating - np.mean(y_rating)) ** 2)
r2_rating = 1 - (ss_res_rating / ss_tot_rating)
print("\n--- Update Frequency Effect on Rolling Rating (with region interaction) ---")
print(f"Intercept: {coeffs_rating[0]:.6f}")
print(f"total_update_events: {coeffs_rating[1]:.6f}")
print(f"region_code: {coeffs_active[2]:.6f}")
print(f"interaction: {coeffs_active[3]:.6f}")
print(f"R-squared: {r2_rating:.4f}")

# Save results to CSV for later reporting
rpi_trend.to_csv('rpi_decay.csv', index=False)
decay_installs_df.to_csv('install_decay_by_device.csv', index=False)
decay_region_df.to_csv('conversion_decay_by_region.csv', index=False)
merged[['store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k']].corr().to_csv('correlation.csv')

conn.close()
print("\nAnalysis complete. Results saved to CSV.")
