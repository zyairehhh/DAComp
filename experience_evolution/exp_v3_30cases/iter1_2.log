'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
df = pd.read_sql_query("SELECT account_id, sum_minutes, sum_events, avg_nps_rating, count_active_days, count_active_months, count_feature_clicking_visitors, count_page_viewing_visitors, count_associated_visitors, first_event_on, last_event_on FROM pendo__account", conn)
df['first_event_on'] = pd.to_datetime(df['first_event_on'])
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
cutoff = pd.to_datetime('2024-09-01')
df['still_active'] = df['last_event_on'] >= cutoff

# Compute recency: days between last event and cutoff
df['recency_days'] = (cutoff - df['last_event_on']).dt.days
# Compute tenure: days between first and last event
df['tenure_days'] = (df['last_event_on'] - df['first_event_on']).dt.days

# Prepare features
features = df[['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_active_months',
               'count_feature_clicking_visitors', 'count_page_viewing_visitors', 'count_associated_visitors',
               'recency_days', 'tenure_days']].fillna(0)

# Normalize
def normalize(x):
    min_val = x.min()
    max_val = x.max()
    if max_val == min_val:
        return x * 0
    return (x - min_val) / (max_val - min_val)
    
scaled = features.apply(normalize)

# Weighted sum with correlation-based weights (absolute Pearson correlation with still_active)
corrs = []
for col in features.columns:
    corr = df[col].corr(df['still_active'])
    corrs.append(abs(corr))
corrs = np.array(corrs)
if corrs.sum() > 0:
    weights_corr = corrs / corrs.sum()
else:
    weights_corr = np.ones(len(corrs)) / len(corrs)

print("Feature correlations with still_active:")
for col, corr in zip(features.columns, corrs):
    print(f"{col}: {corr:.4f}")
print("\nCorrelation-based weights:")
for col, w in zip(features.columns, weights_corr):
    print(f"{col}: {w:.4f}")

df['score_corr'] = np.dot(scaled, weights_corr)

# Accuracy function
def accuracy(y_true, y_pred):
    return np.mean(y_true == y_pred)

# Find best threshold
best_acc = 0
best_th = 0
for th in np.linspace(0, 1, 101):
    pred = df['score_corr'] > th
    acc = accuracy(df['still_active'], pred)
    if acc > best_acc:
        best_acc = acc
        best_th = th
print(f"\nCorrelation-weighted score accuracy for retention: {best_acc:.4f} at threshold {best_th:.4f}")

# Compare with existing model (duration+frequency)
med_minutes = df['sum_minutes'].median()
med_events = df['sum_events'].median()
df['existing_pred'] = (df['sum_minutes'] > med_minutes) & (df['sum_events'] > med_events)
existing_acc = accuracy(df['still_active'], df['existing_pred'])
print(f"Existing model accuracy: {existing_acc:.4f}")

# Let's see performance for high NPS definition
df['high_nps'] = df['avg_nps_rating'] >= 8
print("\n--- High NPS definition ---")
print(f"Number of high NPS accounts: {df['high_nps'].sum()}")
# Accuracy of correlation-weighted score for high NPS
best_acc_nps = 0
best_th_nps = 0
for th in np.linspace(0,1,101):
    pred = df['score_corr'] > th
    acc = accuracy(df['high_nps'], pred)
    if acc > best_acc_nps:
        best_acc_nps = acc
        best_th_nps = th
print(f"Correlation-weighted score accuracy for high NPS: {best_acc_nps:.4f} at threshold {best_th_nps:.4f}")

# Now propose a new scoring formula with explicit coefficients based on correlation weights
print("\n=== Proposed Multi-dimensional Value Score ===")
print("Score = ")
for col, w in zip(features.columns, weights_corr):
    print(f"  {w:.4f} * (normalized {col}) +")
print("  threshold = {:.4f}".format(best_th))

# Compute final classification report
pred = df['score_corr'] > best_th
tp = np.sum((df['still_active'] == True) & (pred == True))
tn = np.sum((df['still_active'] == False) & (pred == False))
fp = np.sum((df['still_active'] == False) & (pred == True))
fn = np.sum((df['still_active'] == True) & (pred == False))
precision = tp / (tp + fp) if tp+fp>0 else 0
recall = tp / (tp + fn) if tp+fn>0 else 0
print(f"\nClassification report for retention:")
print(f"Precision: {precision:.3f}, Recall: {recall:.3f}, F1: {2*precision*recall/(precision+recall) if precision+recall>0 else 0:.3f}")

# Check if we meet >85% accuracy goal for high NPS (if that's the high-value definition)
if best_acc_nps >= 0.85:
    print("\nSUCCESS: Accuracy for high NPS exceeds 85%!")
else:
    print(f"\nAccuracy for high NPS is {best_acc_nps:.2%}, not yet 85%. Need further refinements.")

conn.close()
''')
