import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
# Use default fonts (English only)
matplotlib.rcParams['font.sans-serif'] = []
matplotlib.rcParams['axes.unicode_minus'] = False

# Load data
df = pd.read_csv('stage_metrics.csv')
print(df)

# Compute attrition rate and pass rate
def compute_pass_rate(row):
    if row['stage'] == 'Hired':
        # All hired passed the final stage
        return 1.0
    else:
        return row['advanced_count'] / row['total_entries']

df['pass_rate'] = df.apply(compute_pass_rate, axis=1)
df['attrition_rate'] = 1 - df['pass_rate']

# Efficiency index = pass_rate / avg_days * 100
df['efficiency_index'] = df['pass_rate'] / df['avg_days'] * 100

# Filter stages with at least 100 samples (already true for most)
df_filtered = df[df['total_entries'] >= 100]

print("\nMetrics:")
print(df_filtered[['stage', 'total_entries', 'avg_days', 'attrition_rate', 'efficiency_index']])

# Identify bottleneck stages: avg_days > 25 and attrition_rate > 0.4
df_filtered['bottleneck'] = (df_filtered['avg_days'] > 25) & (df_filtered['attrition_rate'] > 0.4)
bottleneck_stages = df_filtered[df_filtered['bottleneck']]
print("\nBottleneck stages (avg_days>25 & attrition>40%):")
print(bottleneck_stages[['stage', 'avg_days', 'attrition_rate']])

# Identify low efficiency stages: efficiency_index < 1.5
df_filtered['low_efficiency'] = df_filtered['efficiency_index'] < 1.5
low_efficiency_stages = df_filtered[df_filtered['low_efficiency']]
print("\nLow efficiency stages (efficiency_index < 1.5):")
print(low_efficiency_stages[['stage', 'efficiency_index', 'avg_days', 'pass_rate']])

# Plot 1: Average Days per Stage
fig, axes = plt.subplots(3, 1, figsize=(10, 15))
ax1 = axes[0]
bars = ax1.bar(df_filtered['stage'], df_filtered['avg_days'], color='skyblue')
# Highlight bars where avg_days > 25
for i, (stage, avg) in enumerate(zip(df_filtered['stage'], df_filtered['avg_days'])):
    if avg > 25:
        bars[i].set_color('red')
ax1.axhline(y=25, color='r', linestyle='--', alpha=0.7, label='Threshold (25 days)')
ax1.set_ylabel('Average Days')
ax1.set_title('Average Time Spent per Stage (Red > 25 days)')
ax1.legend()
ax1.tick_params(axis='x', rotation=45)

# Plot 2: Attrition Rate per Stage
ax2 = axes[1]
bars2 = ax2.bar(df_filtered['stage'], df_filtered['attrition_rate']*100, color='lightcoral')
for i, (stage, att) in enumerate(zip(df_filtered['stage'], df_filtered['attrition_rate'])):
    if att > 0.4:
        bars2[i].set_color('darkred')
ax2.axhline(y=40, color='r', linestyle='--', alpha=0.7, label='Threshold (40%)')
ax2.set_ylabel('Attrition Rate (%)')
ax2.set_title('Attrition Rate per Stage (Dark Red > 40%)')
ax2.legend()
ax2.tick_params(axis='x', rotation=45)

# Plot 3: Efficiency Index per Stage
ax3 = axes[2]
bars3 = ax3.bar(df_filtered['stage'], df_filtered['efficiency_index'], color='lightgreen')
for i, (stage, eff) in enumerate(zip(df_filtered['stage'], df_filtered['efficiency_index'])):
    if eff < 1.5:
        bars3[i].set_color('darkgreen')
ax3.axhline(y=1.5, color='g', linestyle='--', alpha=0.7, label='Threshold (1.5)')
ax3.set_ylabel('Efficiency Index')
ax3.set_title('Efficiency Index per Stage (Dark Green < 1.5)')
ax3.legend()
ax3.tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('stage_metrics_plots.png', dpi=300)
print("Saved stage_metrics_plots.png")

# Write a summary to stage2.md
with open('stage2.md', 'w') as f:
    f.write("# Stage 2: Visualizing Hiring Funnel Bottlenecks\n\n")
    f.write("## Key Plots\n\n")
    f.write("![Stage Metrics Overview](stage_metrics_plots.png)\n\n")
    f.write("This composite chart shows three key metrics per stage: average days spent, attrition rate, and efficiency index (pass_rate / avg_days * 100). Stages are filtered to include only those with at least 100 samples.\n\n")
    f.write("### 1. Average Days per Stage\n")
    f.write("Red bars indicate stages where the average time exceeds 25 days. Notable bottlenecks:\n")
    for _, row in bottleneck_stages.iterrows():
        f.write(f"- **{row['stage']}**: {row['avg_days']:.1f} days (attrition {row['attrition_rate']*100:.1f}%)\n")
    f.write("\n### 2. Attrition Rate per Stage\n")
    f.write("Dark red bars highlight stages where attrition rate surpasses 40%. The most critical stages are:\n")
    for _, row in bottleneck_stages.iterrows():
        f.write(f"- **{row['stage']}**: {row['attrition_rate']*100:.1f}% attrition\n")
    f.write("\n### 3. Efficiency Index per Stage\n")
    f.write("Dark green bars indicate stages with efficiency index below 1.5. These stages have a low ratio of pass rate to average days, meaning they are both slow and have low pass‑through rates. They are:\n")
    for _, row in low_efficiency_stages.iterrows():
        f.write(f"- **{row['stage']}**: efficiency index = {row['efficiency_index']:.2f} (avg days = {row['avg_days']:.1f}, pass rate = {row['pass_rate']*100:.1f}%)\n")
    f.write("\n## Recommendations\n")
    f.write("1. **Technical Assessment**: Extreme attrition (99.8%) and long average duration (44.1 days) make this the biggest bottleneck. Consider streamlining the assessment process, setting clearer expectations, or adding pre‑screening steps.\n")
    f.write("2. **Final Interview**: Very low pass‑through (only one candidate advanced) and high average days (42.3 days). Review the interview structure and decision‑making timelines.\n")
    f.write("3. **Reference Check** and **Offer Discussion** also show high average days (>25 days) and low efficiency indices. Automating reference checks and accelerating offer negotiations could reduce time‑to‑hire.\n")
    f.write("4. For stages with attrition > 40% but lower average days (e.g., First Interview, Second Interview), focus on improving candidate screening before those interviews to reduce unnecessary interview load.\n")

print("Stage2.md generated.")
