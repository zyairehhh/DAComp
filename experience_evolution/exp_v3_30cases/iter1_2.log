```
import sqlite3
import pandas as pd
import numpy as np

def main():
    conn = sqlite3.connect('dacomp-035.sqlite')
    # 1. Compute high+severe rate per department
    query = """
    WITH dept_logins AS (
        SELECT u.Department, COUNT(l.`Login Record ID`) AS total_logins
        FROM login_records_table l
        JOIN user_information_table u ON l.`User ID` = u.`User ID`
        GROUP BY u.Department
    ),
    high_severe AS (
        SELECT u.Department, COUNT(a.`Anomaly ID`) AS hs_count
        FROM abnormal_logins_table a
        JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
        JOIN user_information_table u ON l.`User ID` = u.`User ID`
        WHERE a.`Risk Level` IN ('High', 'Severe')
        GROUP BY u.Department
    )
    SELECT d.Department, d.total_logins, h.hs_count, 
           ROUND(h.hs_count * 100.0 / d.total_logins, 2) AS hs_rate_pct
    FROM dept_logins d
    JOIN high_severe h ON d.Department = h.Department
    ORDER BY hs_rate_pct DESC;
    """
    high_severe_df = pd.read_sql_query(query, conn)
    print("High+Severe Abnormal Login Rate per Department:")
    print(high_severe_df.to_string(index=False))
    print()
    
    # 2. Users involved in high+severe anomalies
    query2 = """
    WITH dept_users AS (
        SELECT Department, COUNT(DISTINCT `User ID`) AS total_users
        FROM user_information_table
        GROUP BY Department
    ),
    hs_users AS (
        SELECT u.Department, COUNT(DISTINCT u.`User ID`) AS hs_users
        FROM abnormal_logins_table a
        JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
        JOIN user_information_table u ON l.`User ID` = u.`User ID`
        WHERE a.`Risk Level` IN ('High', 'Severe')
        GROUP BY u.Department
    )
    SELECT d.Department, d.total_users, h.hs_users,
           ROUND(h.hs_users * 100.0 / d.total_users, 2) AS hs_user_pct
    FROM dept_users d
    JOIN hs_users h ON d.Department = h.Department
    ORDER BY hs_user_pct DESC;
    """
    hs_user_df = pd.read_sql_query(query2, conn)
    print("Percentage of Users with High+Severe Abnormal Logins:")
    print(hs_user_df.to_string(index=False))
    print()
    
    # 3. Average anomaly score per department for high+severe
    query3 = """
    SELECT u.Department, AVG(a.`Anomaly Score`) AS avg_anomaly_score
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
    JOIN user_information_table u ON l.`User ID` = u.`User ID`
    WHERE a.`Risk Level` IN ('High', 'Severe')
    GROUP BY u.Department
    ORDER BY avg_anomaly_score DESC;
    """
    avg_score_df = pd.read_sql_query(query3, conn)
    print("Average Anomaly Score (High+Severe) per Department:")
    print(avg_score_df.to_string(index=False))
    print()
    
    # 4. Most common anomaly types per department for high+severe
    query4 = """
    SELECT u.Department, a.`Anomaly Type`, COUNT(*) AS count
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
    JOIN user_information_table u ON l.`User ID` = u.`User ID`
    WHERE a.`Risk Level` IN ('High', 'Severe')
    GROUP BY u.Department, a.`Anomaly Type`
    ORDER BY u.Department, count DESC;
    """
    anomaly_type_df = pd.read_sql_query(query4, conn)
    print("Most Common High+Severe Anomaly Types per Department:")
    # Pivot for readability
    pivot = anomaly_type_df.pivot(index='Department', columns='Anomaly Type', values='count').fillna(0)
    print(pivot)
    print()
    
    # 5. Confirmed vs Pending high+severe incidents
    query5 = """
    SELECT u.Department, a.`Confirmation Status`, COUNT(*) AS count
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a.`Login Record ID` = l.`Login Record ID`
    JOIN user_information_table u ON l.`User ID` = u.`User ID`
    WHERE a.`Risk Level` IN ('High', 'Severe')
    GROUP BY u.Department, a.`Confirmation Status`
    ORDER BY u.Department, a.`Confirmation Status`;
    """
    confirmed_df = pd.read_sql_query(query5, conn)
    print("Confirmed vs Pending High+Severe Incidents:")
    print(confirmed_df.to_string(index=False))
    
    conn.close()
    
    # Compute a composite risk index (simple weighted average ranking)
    high_severe_df['hs_rate_rank'] = high_severe_df['hs_rate_pct'].rank(ascending=False)
    hs_user_df['hs_user_rank'] = hs_user_df['hs_user_pct'].rank(ascending=False)
    avg_score_df['avg_score_rank'] = avg_score_df['avg_anomaly_score'].rank(ascending=False)
    
    # Merge
    df = high_severe_df[['Department', 'hs_rate_pct', 'hs_rate_rank']].copy()
    df = df.merge(hs_user_df[['Department', 'hs_user_pct', 'hs_user_rank']], on='Department')
    df = df.merge(avg_score_df[['Department', 'avg_anomaly_score', 'avg_score_rank']], on='Department')
    
    # Compute total rank (lower is worse)
    df['total_rank'] = df[['hs_rate_rank', 'hs_user_rank', 'avg_score_rank']].sum(axis=1)
    df = df.sort_values('total_rank')
    print("\nComposite Risk Ranking (Lower total rank indicates higher risk):")
    print(df.to_string(index=False))
    
if __name__ == '__main__':
    main()
