import sqlite3
import pandas as pd
import numpy as np
import re

conn = sqlite3.connect('dacomp-048.sqlite')
query = "SELECT * FROM sheet1 WHERE \"Education Requirement\" LIKE '%Vocational%'"
df = pd.read_sql_query(query, conn)

def extract_salary_range(s):
    if pd.isnull(s):
        return None, None
    s = str(s).replace(',', '')
    match = re.search(r'(\d+)\s*-\s*(\d+)', s)
    if match:
        lower = int(match.group(1))
        upper = int(match.group(2))
        return lower, upper
    else:
        match2 = re.search(r'(\d+)', s)
        if match2:
            val = int(match2.group(1))
            return val, val
    return None, None

df['Salary Lower'] = df['Salary Range'].apply(lambda x: extract_salary_range(x)[0] if pd.notnull(x) else None)
df['Salary Upper'] = df['Salary Range'].apply(lambda x: extract_salary_range(x)[1] if pd.notnull(x) else None)

valid = df[df['Salary Lower'].notna()]
print(f"Total vocational rows: {len(df)}")
print(f"Valid salary rows: {len(valid)}")
overall_mean = valid['Salary Lower'].mean()
print(f"Overall mean starting salary: {overall_mean:.2f}")

categorical_cols = ['Work Experience Requirement', 'Foreign Language Requirement',
                    'Age Requirement', 'Gender Requirement', 'Employment Type',
                    'Company Type', 'Industry']

for col in categorical_cols:
    if col not in valid.columns:
        continue
    # compute group stats
    grouped = valid.groupby(col)['Salary Lower'].agg(['count', 'mean', 'std'])
    grouped = grouped.sort_values('mean', ascending=False)
    # filter groups with count >= 10 and mean > overall_mean * 1.2 (20% higher)
    high_salary = grouped[(grouped['count'] >= 10) & (grouped['mean'] > overall_mean * 1.2)]
    if not high_salary.empty:
        print(f"\\n=== {col} ===")
        print("Categories with count >= 10 and mean salary > 20% above overall:")
        print(high_salary.head(20))
    # also show top 5 by mean regardless of count
    print(f"\\nTop 5 categories by mean salary (any count):")
    print(grouped.head(5))

# Benefits distribution
benefits_counts = {}
for b in df['Benefits'].dropna():
    items = [item.strip() for item in str(b).split(',')]
    for item in items:
        if item:
            benefits_counts[item] = benefits_counts.get(item, 0) + 1

print("\\n=== Benefits Distribution ===")
print("Total benefits mentions:", sum(benefits_counts.values()))
print("Unique benefits:", len(benefits_counts))
print("\\nTop 20 benefits by frequency:")
sorted_benefits = sorted(benefits_counts.items(), key=lambda x: x[1], reverse=True)
for benefit, count in sorted_benefits[:20]:
    print(f"{benefit}: {count}")

# Starting salary distribution in more detail
print("\\n=== Starting Salary Distribution (bins) ===")
bins = [0, 3000, 4000, 5000, 6000, 8000, 12000, 20000, 50000]
labels = ['<3k', '3k-4k', '4k-5k', '5k-6k', '6k-8k', '8k-12k', '12k-20k', '>20k']
valid['Salary Bin'] = pd.cut(valid['Salary Lower'], bins=bins, labels=labels, right=False)
dist = valid['Salary Bin'].value_counts().sort_index()
for bin_label, count in dist.items():
    percentage = 100 * count / len(valid)
    print(f"{bin_label}: {count} ({percentage:.1f}%)")
''')
