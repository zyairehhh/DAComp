import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import json
import numpy as np
from matplotlib import rcParams

# Connect to the database
conn = sqlite3.connect('dacomp-027.sqlite')

# Query disaster events with cascading hazard information
query = """
SELECT 
    "Disaster Event ID",
    "Disaster Level",
    "Disaster Type",
    "Affected Area",
    json_extract("Impact Indicator", '$.damage_level') as damage_level,
    json_extract("Impact Indicator", '$.population.injured') as injured,
    json_extract("Impact Indicator", '$.population.missing') as missing,
    json_extract("Impact Indicator", '$.population.affected') as affected,
    json_extract("Impact Indicator", '$.population.displaced') as displaced,
    json_extract("Impact Indicator", '$.population.casualties') as casualties,
    json_extract("Impact Indicator", '$.infrastructure.damage_percent') as infrastructure_damage,
    json_extract("Impact Indicator", '$.infrastructure.power_outage_percent') as power_outage,
    json_extract("Impact Indicator", '$.infrastructure.water_damage_percent') as water_damage,
    json_extract("Impact Indicator", '$.communication') as communication,
    json_extract("Impact Indicator", '$.transportation') as transportation
FROM disaster_events
WHERE "Disaster Level" IN ('Level 1', 'Level 2', 'Level 3', 'Level 4', 'Level 5')
ORDER BY "Disaster Level"
"""

df = pd.read_sql_query(query, conn)
conn.close()

print(f"Total disaster events: {len(df)}")
print("\nDisaster Level distribution:")
print(df['Disaster Level'].value_counts())
print("\nDisaster Type distribution:")
print(df['Disaster Type'].value_counts())

# Clean and convert numeric columns
numeric_cols = ['injured', 'missing', 'affected', 'displaced', 'casualties', 
                'infrastructure_damage', 'power_outage', 'water_damage']
for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Create visualizations

# 1. Box plot of infrastructure damage by disaster level
plt.figure(figsize=(10, 6))
damage_data = [df[df['Disaster Level'] == level]['infrastructure_damage'].dropna() 
               for level in sorted(df['Disaster Level'].unique())]
positions = range(1, len(damage_data) + 1)
box = plt.boxplot(damage_data, positions=positions, patch_artist=True, 
                  labels=sorted(df['Disaster Level'].unique()))
# Color boxes
colors = ['lightblue', 'lightgreen', 'lightcoral', 'lightsalmon', 'lightseagreen']
for patch, color in zip(box['boxes'], colors):
    patch.set_facecolor(color)
plt.title('Infrastructure Damage by Disaster Level', fontsize=16, fontweight='bold')
plt.xlabel('Disaster Level', fontsize=12)
plt.ylabel('Infrastructure Damage (%)', fontsize=12)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('infrastructure_damage_by_level.png', dpi=300)
plt.close()

# 2. Population impacts by disaster level (stacked bar chart)
plt.figure(figsize=(12, 8))
impact_metrics = ['injured', 'missing', 'displaced', 'casualties']
impact_labels = ['Injured', 'Missing', 'Displaced', 'Casualties']
level_order = sorted(df['Disaster Level'].unique())

# Calculate medians for each disaster level
impact_data = []
for level in level_order:
    level_data = []
    for metric in impact_metrics:
        level_data.append(df[df['Disaster Level'] == level][metric].median())
    impact_data.append(level_data)

impact_data = np.array(impact_data)
x = np.arange(len(level_order))
width = 0.8

bottom = np.zeros(len(level_order))
for i in range(len(impact_metrics)):
    plt.bar(x, impact_data[:, i], width, bottom=bottom, label=impact_labels[i])
    bottom += impact_data[:, i]

plt.xlabel('Disaster Level', fontsize=12)
plt.ylabel('Median Population Impact (log scale)', fontsize=12)
plt.title('Median Population Impacts by Disaster Level', fontsize=16, fontweight='bold')
plt.xticks(x, level_order)
plt.yscale('log')  # Use log scale due to large value differences
plt.legend()
plt.grid(True, alpha=0.3, axis='y')
plt.tight_layout()
plt.savefig('population_impacts_by_level.png', dpi=300)
plt.close()

# 3. Cascading effects: Correlation between infrastructure damage and population displacement
plt.figure(figsize=(10, 8))
scatter = plt.scatter(df['infrastructure_damage'], df['displaced'], 
                     c=pd.Categorical(df['Disaster Level']).codes, 
                     cmap='viridis', alpha=0.6, s=50)
plt.colorbar(scatter, label='Disaster Level', 
             ticks=range(len(level_order)), 
             format=plt.FixedFormatter(level_order))
plt.xlabel('Infrastructure Damage (%)', fontsize=12)
plt.ylabel('Displaced Population', fontsize=12)
plt.title('Cascading Effect: Infrastructure Damage vs. Population Displacement', 
          fontsize=16, fontweight='bold')
plt.xscale('log')
plt.yscale('log')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('cascading_effect_scatter.png', dpi=300)
plt.close()

# 4. Heatmap of infrastructure damage types by disaster type
plt.figure(figsize=(12, 8))
infrastructure_metrics = ['infrastructure_damage', 'power_outage', 'water_damage']
infrastructure_labels = ['General Damage', 'Power Outage', 'Water Damage']
disaster_types = df['Disaster Type'].unique()

heatmap_data = []
for disaster_type in disaster_types:
    type_data = []
    for metric in infrastructure_metrics:
        type_data.append(df[df['Disaster Type'] == disaster_type][metric].median())
    heatmap_data.append(type_data)

heatmap_data = np.array(heatmap_data)

plt.imshow(heatmap_data, cmap='YlOrRd', aspect='auto')
plt.colorbar(label='Median Damage Percentage (%)')
plt.xticks(range(len(infrastructure_labels)), infrastructure_labels, rotation=45)
plt.yticks(range(len(disaster_types)), disaster_types)
plt.title('Infrastructure Damage Patterns by Disaster Type', fontsize=16, fontweight='bold')
plt.xlabel('Infrastructure Metric', fontsize=12)
plt.ylabel('Disaster Type', fontsize=12)

# Add text annotations
for i in range(len(disaster_types)):
    for j in range(len(infrastructure_metrics)):
        plt.text(j, i, f'{heatmap_data[i, j]:.1f}', 
                ha='center', va='center', color='black' if heatmap_data[i, j] < 50 else 'white')

plt.tight_layout()
