import sqlite3
import pandas as pd

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-061/stage1_env/dacomp-061.sqlite')

# Load tables
project_df = pd.read_sql_query("SELECT * FROM jira__project_enhanced", conn)
team_df = pd.read_sql_query("SELECT * FROM jira__team_performance_dashboard", conn)
issue_df = pd.read_sql_query("SELECT * FROM jira__issue_intelligence_analytics", conn)

print("Project rows:", project_df.shape)
print("Team rows:", team_df.shape)
print("Issue rows:", issue_df.shape)

# Compute team stability per project_name
team_agg = team_df.groupby('project_name').agg(
    team_size=('user_id', 'count'),
    avg_consistency=('consistency_percentage', 'mean'),
    risk_users=('at_churn_risk', lambda x: (x == 1).sum()),
    inactive_users=('inactive_recently', lambda x: (x == 1).sum()),
    poor_est_users=('poor_estimation', lambda x: (x == 1).sum())
).reset_index()

team_agg['team_stability'] = 1 - (team_agg['risk_users'] + team_agg['inactive_users']) / team_agg['team_size']

# Identify fast projects
fast_projects = project_df[project_df['avg_close_time_days'] < 15].copy()
print(f"Number of fast project rows: {len(fast_projects)}")

# Merge with team stability on project_name
fast_with_team = fast_projects.merge(team_agg, on='project_name', how='left')
print("Fast projects with team stats:", fast_with_team.shape)

# Compute quality metrics per project from issue table
issue_agg = issue_df.groupby('project_name').agg(
    avg_lifecycle_quality=('lifecycle_quality_score', 'mean'),
    avg_regression_ratio=('regression_ratio', 'mean'),
    avg_deviation=('lifecycle_deviation_ratio', 'mean'),
    high_complexity_rate=('high_complexity_risk', 'mean'),
    total_issues=('issue_id', 'count')
).reset_index()

# Merge with fast projects
fast_full = fast_with_team.merge(issue_agg, on='project_name', how='left')

# Inspect some rows
print(fast_full[['project_name', 'avg_close_time_days', 'team_stability', 'avg_lifecycle_quality', 'avg_regression_ratio']].head())

# Compare with slow projects (avg_close_time_days >= 15)
slow_projects = project_df[project_df['avg_close_time_days'] >= 15].copy()
slow_with_team = slow_projects.merge(team_agg, on='project_name', how='left')
slow_full = slow_with_team.merge(issue_agg, on='project_name', how='left')

# Compute averages for fast vs slow
fast_summary = fast_full[['team_stability', 'avg_lifecycle_quality', 'avg_regression_ratio', 'high_complexity_rate']].mean()
slow_summary = slow_full[['team_stability', 'avg_lifecycle_quality', 'avg_regression_ratio', 'high_complexity_rate']].mean()

print("\nFast projects summary:")
print(fast_summary)
print("\nSlow projects summary:")
print(slow_summary)

# Output more details
print("\nFast projects count:", len(fast_full))
print("Slow projects count:", len(slow_full))

# Consider correlation between avg_close_time_days and team_stability across all projects
all_projects = project_df.merge(team_agg, on='project_name', how='left').merge(issue_agg, on='project_name', how='left')
correlation = all_projects[['avg_close_time_days', 'team_stability']].corr()
print("\nCorrelation matrix:")
print(correlation)

conn.close()
```
