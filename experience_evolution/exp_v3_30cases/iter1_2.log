import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

df_top = pd.read_csv('top_accounts_metrics.csv')

# Compute industry medians
industry_medians = df_top.groupby('industry_normalized').agg({
    'contact_density_ratio': 'median',
    'decision_maker_ratio': 'median',
    'dept_coverage': 'median'
}).reset_index()
industry_medians = industry_medians[industry_medians['industry_normalized'].notna()]

# Sort by CDR median
industry_medians = industry_medians.sort_values('contact_density_ratio', ascending=False)

# Limit to top N industries for readability
top_n = 12
industry_medians_top = industry_medians.head(top_n)

fig, axes = plt.subplots(3, 1, figsize=(12, 10), sharex=True)

# CDR
axes[0].barh(industry_medians_top['industry_normalized'], industry_medians_top['contact_density_ratio'], color='skyblue', edgecolor='black')
axes[0].axvline(x=5, color='red', linestyle='--', linewidth=1, label='Uniform Benchmark (5)')
axes[0].set_xlabel('Median Contact Density Ratio')
axes[0].set_title('Industry‑Specific Median Contact Density Ratio (Top 12 Industries)')
axes[0].legend()

# DMR
axes[1].barh(industry_medians_top['industry_normalized'], industry_medians_top['decision_maker_ratio'], color='lightcoral', edgecolor='black')
axes[1].axvline(x=15, color='red', linestyle='--', linewidth=1, label='Uniform Benchmark (15%)')
axes[1].set_xlabel('Median Decision‑Maker Ratio (%)')
axes[1].set_title('Industry‑Specific Median Decision‑Maker Ratio')
axes[1].legend()

# Coverage
axes[2].barh(industry_medians_top['industry_normalized'], industry_medians_top['dept_coverage'], color='lightgreen', edgecolor='black')
axes[2].axvline(x=100, color='red', linestyle='--', linewidth=1, label='Full Coverage (100%)')
axes[2].set_xlabel('Median Departmental Coverage (%)')
axes[2].set_title('Industry‑Specific Median Departmental Coverage')
axes[2].legend()

plt.tight_layout()
plt.savefig('plot_industry_medians.png', dpi=300)
plt.close()

print('Industry medians plot saved.')
```
