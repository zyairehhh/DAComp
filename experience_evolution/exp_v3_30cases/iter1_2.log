import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
df = pd.read_sql_query("SELECT account_id, sum_minutes, sum_events, avg_nps_rating, count_active_days, count_active_months, count_feature_clicking_visitors, count_page_viewing_visitors, count_associated_visitors, last_event_on FROM pendo__account", conn)
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
cutoff = pd.to_datetime('2024-09-01')
df['still_active'] = df['last_event_on'] >= cutoff

# Define multiple high-value labels
percentile_75_minutes = np.percentile(df['sum_minutes'].dropna(), 75)
median_minutes = df['sum_minutes'].median()
df['high_nps'] = df['avg_nps_rating'] >= 8
df['high_minutes_75'] = df['sum_minutes'] > percentile_75_minutes
df['high_minutes_median'] = df['sum_minutes'] > median_minutes

df['label1'] = df['still_active']
df['label2'] = df['high_nps']
df['label3'] = df['high_minutes_75'] & df['high_nps']
df['label4'] = df['high_minutes_median'] & df['high_nps']
df['label5'] = df['high_minutes_75'] | df['high_nps']

labels = ['label1', 'label2', 'label3', 'label4', 'label5']
label_names = ['Retained', 'High NPS', 'High minutes (75p) & High NPS', 'High minutes (median) & High NPS', 'High minutes (75p) OR High NPS']

# Existing model: high-value if sum_minutes > median and sum_events > median
median_events = df['sum_events'].median()
df['existing_pred'] = (df['sum_minutes'] > median_minutes) & (df['sum_events'] > median_events)

# Compute accuracy for each label
def accuracy(y_true, y_pred):
    return np.mean(y_true == y_pred)

print("Existing model accuracy (duration+frequency) vs different definitions of high-value:")
for n, l in zip(label_names, labels):
    acc = accuracy(df[l], df['existing_pred'])
    print(f"{n}: {acc:.3f} ({df[l].sum()} positive)")

print("\n" + "="*50)

# Build multi-dimensional scoring model (using all numeric features)
numeric_cols = ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_active_months', 
                'count_feature_clicking_visitors', 'count_page_viewing_visitors', 'count_associated_visitors']
features = df[numeric_cols].fillna(0)
# Normalize
min_val = features.min()
max_val = features.max()
range_val = max_val - min_val
range_val[range_val == 0] = 1
scaled = (features - min_val) / range_val

# Weighted sum with equal weights for now
weights = np.ones(len(numeric_cols)) / len(numeric_cols)
df['multidim_score'] = np.dot(scaled, weights)

# Find best threshold for each label and compute accuracy
print("Multi-dimensional scoring model (8 features) accuracy:")
for n, l in zip(label_names, labels):
    best_acc = 0
    best_th = 0
    for th in np.linspace(0, 1, 101):
        pred = df['multidim_score'] > th
        acc = accuracy(df[l], pred)
        if acc > best_acc:
            best_acc = acc
            best_th = th
    print(f"{n}: best accuracy {best_acc:.3f} at threshold {best_th:.3f}")

# Now we can also test a simple two-feature model (duration+frequency) but optimized threshold
print("\nTwo-feature model (sum_minutes, sum_events) optimized threshold:")
features2 = df[['sum_minutes', 'sum_events']]
scaled2 = (features2 - features2.min()) / (features2.max() - features2.min())
df['two_score'] = np.dot(scaled2, [0.5, 0.5])
for n, l in zip(label_names, labels):
    best_acc = 0
    best_th = 0
    for th in np.linspace(0, 1, 101):
        pred = df['two_score'] > th
        acc = accuracy(df[l], pred)
        if acc > best_acc:
            best_acc = acc
            best_th = th
    print(f"{n}: best accuracy {best_acc:.3f} at threshold {best_th:.3f}")

# Correlation between features and still_active (Pearson)
print("\nPearson correlation between features and still_active:")
for col in numeric_cols:
    corr = df[col].corr(df['still_active'])
    print(f"{col}: {corr:.3f}")

# Feature importance: use absolute correlation as weights
abs_corr = np.abs([df[col].corr(df['still_active']) for col in numeric_cols])
weights_corr = abs_corr / abs_corr.sum()
print("\nWeighting based on absolute correlation with retention:")
for col, w in zip(numeric_cols, weights_corr):
    print(f"{col}: weight {w:.3f}")

# Compute score with correlation weights
df['corr_score'] = np.dot(scaled, weights_corr)
best_acc_corr = 0
best_th_corr = 0
for th in np.linspace(0,1,101):
    pred = df['corr_score'] > th
    acc = accuracy(df['still_active'], pred)
    if acc > best_acc_corr:
        best_acc_corr = acc
        best_th_corr = th
print(f"\nCorrelation-weighted score accuracy for still_active: {best_acc_corr:.3f} at threshold {best_th_corr:.3f}")

# Try to maximize accuracy for retention using a simple linear combination with optimized weights
# We'll use a simple hill-climbing search for weights (since small feature set)
# Define objective: maximize accuracy for label1
# Random search
best_weights = None
best_acc_opt = 0
best_th_opt = 0
np.random.seed(42)
for _ in range(1000):
    w = np.random.rand(len(numeric_cols))
    w = w / w.sum()
    score = np.dot(scaled, w)
    # find optimal threshold for these weights
    acc_max = 0
    th_max = 0
    for th in np.linspace(0,1,21):
        pred = score > th
        acc = accuracy(df['still_active'], pred)
        if acc > acc_max:
            acc_max = acc
            th_max = th
    if acc_max > best_acc_opt:
        best_acc_opt = acc_max
        best_weights = w
        best_th_opt = th_max

print("\nRandom search optimal weights for retention:")
for col, w in zip(numeric_cols, best_weights):
    print(f"{col}: weight {w:.3f}")
print(f"Best accuracy: {best_acc_opt:.3f} at threshold {best_th_opt:.3f}")

# Predict value trend for next 3-6 months: we can treat retention as proxy.
# Now we propose a final scoring formula:
# Score = 0.15*sum_minutes_norm + 0.10*sum_events_norm + 0.05*avg_nps_norm + 0.25*count_active_days_norm + 0.25*count_active_months_norm + 0.10*count_feature_clicking_visitors_norm + 0.05*count_page_viewing_visitors_norm + 0.05*count_associated_visitors_norm
# Based on correlation weights and random search, we can propose a formula.
# Let's compute accuracy with this fixed proposed weighting.
proposed_weights = np.array([0.15, 0.10, 0.05, 0.25, 0.25, 0.10, 0.05, 0.05])
df['proposed_score'] = np.dot(scaled, proposed_weights)
acc_proposed = accuracy(df['still_active'], df['proposed_score'] > 0.5)
print(f"\nProposed scoring formula accuracy (threshold 0.5): {acc_proposed:.3f}")
# Find optimal threshold
best_acc_prop = 0
best_th_prop = 0
for th in np.linspace(0,1,101):
    pred = df['proposed_score'] > th
    acc = accuracy(df['still_active'], pred)
    if acc > best_acc_prop:
        best_acc_prop = acc
        best_th_prop = th
print(f"Proposed scoring formula best accuracy: {best_acc_prop:.3f} at threshold {best_th_prop:.3f}")

conn.close()
```


