import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-089.sqlite')

# 1. Top 20% threshold
query = """
WITH ranked AS (
    SELECT account_id, annual_revenue,
           ROW_NUMBER() OVER (ORDER BY annual_revenue DESC) as rn,
           COUNT(*) OVER() as total
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL
)
SELECT MIN(annual_revenue) as threshold_80th
FROM ranked
WHERE rn <= CEIL(total * 0.2)
"""
threshold_df = pd.read_sql_query(query, conn)
threshold = threshold_df['threshold_80th'].iloc[0]
print(f"Top 20% revenue threshold: {threshold}")

# 2. List of top accounts
top_accounts_query = f"""
SELECT account_id, account_name, annual_revenue, total_contacts, number_of_employees
FROM salesforce__customer_360_view
WHERE annual_revenue >= {threshold}
"""
top_accounts = pd.read_sql_query(top_accounts_query, conn)
print(f"Number of top accounts: {len(top_accounts)}")

# 3. Compute per account contact density ratio
top_accounts['contact_density_ratio'] = (top_accounts['total_contacts'] / top_accounts['number_of_employees']) * 1000
# If employees is NaN, ratio NaN
print("Contact density ratio sample:")
print(top_accounts[['account_id', 'total_contacts', 'number_of_employees', 'contact_density_ratio']].head())

# 4. Decision-maker ratio: proportion of C-level + VP-level contacts
# Let's define decision-makers as titles containing 'Chief' (case-insensitive) 
# Also maybe 'President' but absent; also 'CEO', 'CFO', etc. But 'Chief' covers.
# Let's get per account count of decision-maker contacts
# Use contact_enhanced table

decision_maker_query = """
SELECT account_id,
       COUNT(*) as total_contacts_per_account,
       SUM(CASE WHEN title LIKE '%Chief%' THEN 1 ELSE 0 END) as chief_count
FROM salesforce__contact_enhanced
WHERE account_id IN (
    SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue >= ?
)
GROUP BY account_id
"""
decision_maker_df = pd.read_sql_query(decision_maker_query, conn, params=(threshold,))
print("Decision maker sample:")
print(decision_maker_df.head())

# Merge with top_accounts
top_accounts = top_accounts.merge(decision_maker_df, on='account_id', how='left')
top_accounts['total_contacts_per_account'] = top_accounts['total_contacts_per_account'].fillna(0)
top_accounts['chief_count'] = top_accounts['chief_count'].fillna(0)
top_accounts['decision_maker_ratio'] = (top_accounts['chief_count'] / top_accounts['total_contacts_per_account'].replace(0, pd.NA)) * 100
print("Merged sample:")
print(top_accounts[['account_id', 'total_contacts_per_account', 'chief_count', 'decision_maker_ratio']].head())

# 5. Departmental coverage completeness: count distinct key departments among contacts per account
# key departments: Sales, Finance, Operations, HR, IT (mapped as Engineering)
dept_query = """
SELECT account_id, department
FROM salesforce__contact_enhanced
WHERE account_id IN (
    SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue >= ?
)
AND department IS NOT NULL
"""
dept_df = pd.read_sql_query(dept_query, conn, params=(threshold,))
print("Unique departments per account sample:")
print(dept_df.head())

# Map IT: if department = 'Engineering' treat as IT
def map_key_dept(dept):
    if dept == 'Sales':
        return 'Sales'
    elif dept == 'Finance':
        return 'Finance'
    elif dept == 'Operations':
        return 'Operations'
    elif dept == 'HR':
        return 'HR'
    elif dept == 'Engineering':
        return 'IT'
    else:
        return None

dept_df['key_dept'] = dept_df['department'].apply(map_key_dept)
# Count distinct key departments per account
coverage_df = dept_df.dropna(subset=['key_dept']).groupby('account_id')['key_dept'].nunique().reset_index()
coverage_df.rename(columns={'key_dept': 'key_dept_coverage'}, inplace=True)
print("Coverage sample:")
print(coverage_df.head())

top_accounts = top_accounts.merge(coverage_df, on='account_id', how='left')
top_accounts['key_dept_coverage'] = top_accounts['key_dept_coverage'].fillna(0)
print("Final sample with metrics:")
print(top_accounts[['account_id', 'contact_density_ratio', 'decision_maker_ratio', 'key_dept_coverage']].head())

# 6. Compute compliance with benchmarks:
# Contact Density Ratio benchmark >=5
# Decision-Maker Ratio benchmark >=15%
# Departmental Coverage Completeness benchmark = 5 (all five departments)
# but we only have 4 because IT not mapped; but we map Engineering as IT, so 5.
top_accounts['cdr_compliant'] = top_accounts['contact_density_ratio'] >= 5
# handle NaN -> False
top_accounts['cdr_compliant'] = top_accounts['cdr_compliant'].fillna(False)
top_accounts['dmr_compliant'] = top_accounts['decision_maker_ratio'] >= 15
top_accounts['dmr_compliant'] = top_accounts['dmr_compliant'].fillna(False)
top_accounts['coverage_compliant'] = top_accounts['key_dept_coverage'] == 5

# 7. Summarize compliance across top accounts
print("\nCompliance summary:")
print(f"Total top accounts: {len(top_accounts)}")
print(f"Contact Density Ratio >=5: {top_accounts['cdr_compliant'].sum()} ({top_accounts['cdr_compliant'].mean()*100:.1f}%)")
print(f"Decision-Maker Ratio >=15%: {top_accounts['dmr_compliant'].sum()} ({top_accounts['dmr_compliant'].mean()*100:.1f}%)")
print(f"Department Coverage ==5: {top_accounts['coverage_compliant'].sum()} ({top_accounts['coverage_compliant'].mean()*100:.1f}%)")

# 8. Identify high-risk accounts: Those not meeting at least one benchmark
top_accounts['high_risk'] = ~(top_accounts['cdr_compliant'] & top_accounts['dmr_compliant'] & top_accounts['coverage_compliant'])
print(f"High-risk accounts (fail at least one benchmark): {top_accounts['high_risk'].sum()} ({top_accounts['high_risk'].mean()*100:.1f}%)")

# 9. Output to CSV
top_accounts.to_csv('top_accounts_metrics.csv', index=False)
print("Metrics saved to top_accounts_metrics.csv")

conn.close()
```
