import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# Ensure output directory for images
os.makedirs('images', exist_ok=True)

# Connect to database
conn = sqlite3.connect('dacomp-079.sqlite')

# Load necessary tables
visitors = pd.read_sql_query("SELECT * FROM pendo__visitor;", conn)
visitor_features = pd.read_sql_query("SELECT * FROM pendo__visitor_feature;", conn)
features = pd.read_sql_query("SELECT * FROM pendo__feature;", conn)

# Compute distinct feature count per visitor (active days > 60)
distinct_features = visitor_features.groupby('visitor_id')['feature_id'].nunique().reset_index(name='distinct_features')
visitors = visitors.merge(distinct_features, on='visitor_id', how='left')
visitors['distinct_features'] = visitors['distinct_features'].fillna(0)

# Segment: single-feature-use (SFU) vs normal
visitors['segment'] = np.where((visitors['count_active_days'] > 60) & (visitors['distinct_features'] < 5), 'Single-Feature-Use', 'Normal')
# For those not meeting active days > 60, label as 'Other' (optional)
visitors.loc[visitors['count_active_days'] <= 60, 'segment'] = 'Other'

# Focus on SFU and Normal for comparison (excluding Other)
comparison = visitors[visitors['segment'].isin(['Single-Feature-Use', 'Normal'])]

# 1. NPS distribution bar chart
def nps_category(rating):
    if rating >= 9:
        return 'Promoter'
    elif rating >= 7:
        return 'Passive'
    else:
        return 'Detractor'

comparison['nps_category'] = comparison['latest_nps_rating'].apply(nps_category)
nps_counts = comparison.groupby(['segment', 'nps_category']).size().unstack(fill_value=0)
nps_pct = nps_counts.div(nps_counts.sum(axis=1), axis=0) * 100

fig, ax = plt.subplots(figsize=(8, 5))
nps_pct.T.plot(kind='bar', ax=ax, color=['#ff6b6b', '#4ecdc4'])
ax.set_ylabel('Percentage of Users (%)')
ax.set_xlabel('NPS Category')
ax.set_title('NPS Distribution: Single-Feature-Use vs Normal Users')
ax.legend(title='Segment')
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('images/nps_distribution.png', dpi=300)
plt.close()

# 2. Average daily minutes and minutes per event side-by-side bar
avg_metrics = comparison.groupby('segment').agg({
    'average_daily_minutes': 'mean',
    'sum_minutes': 'mean',
    'sum_events': 'mean'
}).reset_index()
avg_metrics['minutes_per_event'] = avg_metrics['sum_minutes'] / avg_metrics['sum_events']

fig, axes = plt.subplots(1, 2, figsize=(10, 5))
# Average daily minutes
axes[0].bar(avg_metrics['segment'], avg_metrics['average_daily_minutes'], color=['#ff6b6b', '#4ecdc4'])
axes[0].set_ylabel('Average Daily Minutes')
axes[0].set_title('Average Daily Minutes per User')
axes[0].grid(axis='y', linestyle='--', alpha=0.7)
# Minutes per event
axes[1].bar(avg_metrics['segment'], avg_metrics['minutes_per_event'], color=['#ff6b6b', '#4ecdc4'])
axes[1].set_ylabel('Minutes per Event')
axes[1].set_title('Engagement Depth (Minutes per Event)')
axes[1].grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('images/engagement_metrics.png', dpi=300)
plt.close()

# 3. Top features used by SFU segment
sfu_ids = comparison[comparison['segment'] == 'Single-Feature-Use']['visitor_id']
sfu_features = visitor_features[visitor_features['visitor_id'].isin(sfu_ids)]
feature_counts = sfu_features.groupby('feature_id')['visitor_id'].nunique().reset_index(name='user_count')
feature_counts = feature_counts.merge(features[['feature_id', 'feature_name', 'product_area_name']], on='feature_id', how='left')
top_features = feature_counts.sort_values('user_count', ascending=False).head(10)

fig, ax = plt.subplots(figsize=(10, 6))
ax.barh(range(len(top_features)), top_features['user_count'], color='#ff6b6b')
ax.set_yticks(range(len(top_features)))
ax.set_yticklabels(top_features['feature_name'])
ax.invert_yaxis()
ax.set_xlabel('Number of Users')
ax.set_title('Top Features Used by Single-Feature-Use Segment')
plt.tight_layout()
plt.savefig('images/top_features_sfu.png', dpi=300)
plt.close()

# 4. Product-area penetration
# Compute penetration: percentage of users in segment who used at least one feature in each product area
product_areas = features[['feature_id', 'product_area_name']].drop_duplicates()
sfu_feature_usage = sfu_features.merge(product_areas, on='feature_id', how='left')
sfu_area_penetration = sfu_feature_usage.groupby('product_area_name')['visitor_id'].nunique() / len(sfu_ids) * 100

# For normal users
normal_ids = comparison[comparison['segment'] == 'Normal']['visitor_id']
normal_features = visitor_features[visitor_features['visitor_id'].isin(normal_ids)]
normal_feature_usage = normal_features.merge(product_areas, on='feature_id', how='left')
normal_area_penetration = normal_feature_usage.groupby('product_area_name')['visitor_id'].nunique() / len(normal_ids) * 100

# Combine
penetration_df = pd.DataFrame({
    'Single-Feature-Use': sfu_area_penetration,
    'Normal': normal_area_penetration
}).fillna(0)
penetration_df = penetration_df.sort_values('Normal', ascending=False)

fig, ax = plt.subplots(figsize=(12, 6))
ind = np.arange(len(penetration_df))
width = 0.35
ax.bar(ind - width/2, penetration_df['Single-Feature-Use'], width, label='Single-Feature-Use', color='#ff6b6b')
ax.bar(ind + width/2, penetration_df['Normal'], width, label='Normal', color='#4ecdc4')
ax.set_xticks(ind)
ax.set_xticklabels(penetration_df.index, rotation=45, ha='right')
ax.set_ylabel('Penetration (% of Users)')
ax.set_title('Product‑Area Penetration Comparison')
ax.legend()
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('images/product_area_penetration.png', dpi=300)
plt.close()

# 5. Active months distribution
fig, ax = plt.subplots(figsize=(8, 5))
sns.boxplot(data=comparison, x='segment', y='count_active_months', palette=['#ff6b6b', '#4ecdc4'])
ax.set_ylabel('Active Months')
ax.set_xlabel('Segment')
ax.set_title('Active Months Distribution')
plt.tight_layout()
plt.savefig('images/active_months_boxplot.png', dpi=300)
plt.close()

# 6. Scatter: distinct features vs average daily minutes (colored by segment)
fig, ax = plt.subplots(figsize=(10, 6))
segments = comparison[comparison['segment'].isin(['Single-Feature-Use', 'Normal'])]
colors = {'Single-Feature-Use': '#ff6b6b', 'Normal': '#4ecdc4'}
for seg, color in colors.items():
    seg_data = segments[segments['segment'] == seg]
    ax.scatter(seg_data['distinct_features'], seg_data['average_daily_minutes'], alpha=0.6, label=seg, color=color, s=30)
ax.set_xlabel('Distinct Features Used')
ax.set_ylabel('Average Daily Minutes')
ax.set_title('Distinct Features vs Daily Engagement')
ax.legend()
ax.grid(linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('images/scatter_features_vs_minutes.png', dpi=300)
plt.close()

print("Plots saved in images/ directory.")
