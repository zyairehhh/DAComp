'''
import sqlite3
import pandas as pd
import numpy as np

# Connect to database
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-076/stage1_env/dacomp-076.sqlite')
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
print("Data shape:", df.shape)
print(df.head())

# 1. Segment averages and anomalies
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'seg_avg_retention']
df = df.merge(segment_avg, on='profitability_segment')
df['retention_diff'] = abs(df['retention_probability'] - df['seg_avg_retention'])
df['is_anomaly'] = df['retention_diff'] > 0.15
anomaly = df[df['is_anomaly']]
print(f"Number of anomaly customers: {len(anomaly)}")
print("Anomaly sample:")
print(anomaly[['customer_id', 'profitability_segment', 'retention_probability', 'seg_avg_retention', 'retention_diff']].head())

# 2. Analyze dimensions for anomaly customers
# Transactional behavior: consistency between transaction_count and avg_transactions_per_month
df['trans_consistency_ratio'] = df['transaction_count'] / df['avg_transactions_per_month'].replace(0, np.nan)
# Transaction value volatility
# Seasonal patterns: balance across Q1-Q4
seasonal_cols = ['q1_transactions', 'q2_transactions', 'q3_transactions', 'q4_transactions']
df['total_seasonal'] = df[seasonal_cols].sum(axis=1)
for col in seasonal_cols:
    df[f'{col}_pct'] = df[col] / df['total_seasonal'].replace(0, np.nan)
# Value realization: alignment between comprehensive_customer_score and total_revenue
# Compute correlation per segment? Let's compute per customer deviation from segment average of score and revenue.

# 3. Compare anomaly vs normal across dimensions
numeric_cols = ['transaction_count', 'avg_transactions_per_month', 'trans_consistency_ratio', 
                'transaction_value_volatility', 'total_revenue', 'comprehensive_customer_score',
                'q1_transactions_pct', 'q2_transactions_pct', 'q3_transactions_pct', 'q4_transactions_pct']
print("\n--- Comparison of means (anomaly vs normal) ---")
for col in numeric_cols:
    if col in df.columns:
        norm_mean = df.loc[~df['is_anomaly'], col].mean()
        anom_mean = df.loc[df['is_anomaly'], col].mean()
        print(f"{col}: normal {norm_mean:.3f}, anomaly {anom_mean:.3f}, diff {anom_mean - norm_mean:.3f}")

# 4. Segment-wise anomaly rates
segment_anomaly = df.groupby('profitability_segment').agg(
    total=('customer_id', 'size'),
    anomalies=('is_anomaly', 'sum'),
    anomaly_rate=('is_anomaly', 'mean'),
    avg_retention=('retention_probability', 'mean')
).reset_index()
print("\n--- Anomaly rates per segment ---")
print(segment_anomaly)

# 5. Further analysis: characteristics of anomaly customers per segment
# Let's compute average transaction_value_volatility, transaction_count, seasonal distribution etc.
print("\n--- Characteristics of anomaly customers per segment ---")
for seg in df['profitability_segment'].unique():
    seg_df = df[df['profitability_segment'] == seg]
    anom_seg = seg_df[seg_df['is_anomaly']]
    if len(anom_seg) == 0:
        continue
    print(f"\nSegment: {seg}")
    print(f"  Number of anomalies: {len(anom_seg)}")
    print(f"  Average retention diff: {anom_seg['retention_diff'].mean():.3f}")
    print(f"  Avg transaction_value_volatility: {anom_seg['transaction_value_volatility'].mean():.3f}")
    print(f"  Avg transaction_count: {anom_seg['transaction_count'].mean():.1f}")
    print(f"  Avg total_revenue: {anom_seg['total_revenue'].mean():.1f}")
    print(f"  Avg comprehensive_customer_score: {anom_seg['comprehensive_customer_score'].mean():.1f}")
    print(f"  Avg trans_consistency_ratio: {anom_seg['trans_consistency_ratio'].mean():.3f}")

# 6. Cluster analysis without sklearn: use simple grouping based on percentiles of key dimensions
# Define high/low for transaction_count, volatility, seasonal concentration
df['trans_count_tercile'] = pd.qcut(df['transaction_count'], q=3, labels=['low', 'medium', 'high'])
df['volatility_tercile'] = pd.qcut(df['transaction_value_volatility'], q=3, labels=['low', 'medium', 'high'])
# Seasonal concentration: Herfindahl index
df['seasonal_hhi'] = (df['q1_transactions_pct']**2 + df['q2_transactions_pct']**2 + df['q3_transactions_pct']**2 + df['q4_transactions_pct']**2)
df['seasonal_conc'] = pd.qcut(df['seasonal_hhi'], q=3, labels=['low', 'medium', 'high'])
# Value alignment: difference between score percentile and revenue percentile
df['score_percentile'] = df['comprehensive_customer_score'].rank(pct=True)
df['revenue_percentile'] = df['total_revenue'].rank(pct=True)
df['value_alignment_diff'] = df['score_percentile'] - df['revenue_percentile']

# Cross-tab anomaly rate across these groups
print("\n--- Anomaly rate by transaction count tercile ---")
print(pd.crosstab(df['trans_count_tercile'], df['is_anomaly'], normalize='index'))
print("\n--- Anomaly rate by volatility tercile ---")
print(pd.crosstab(df['volatility_tercile'], df['is_anomaly'], normalize='index'))
print("\n--- Anomaly rate by seasonal concentration ---")
print(pd.crosstab(df['seasonal_conc'], df['is_anomaly'], normalize='index'))

# 7. Decision tree alternative: identify simple rules using pivot
# For each categorical variable, compute anomaly rate
cat_vars = ['value_tier', 'lifecycle_stage', 'activity_status', 'retention_category', 'seasonal_preference', 'transaction_consistency', 'growth_potential', 'recommended_action', 'engagement_frequency']
for var in cat_vars:
    if var in df.columns:
        print(f"\n--- Anomaly rate by {var} ---")
        rates = df.groupby(var)['is_anomaly'].mean().sort_values(ascending=False)
        print(rates.head())

# 8. Save anomaly customers to CSV
anomaly.to_csv('anomaly_customers.csv', index=False)
print("\nAnomaly customers saved to anomaly_customers.csv")

conn.close()
''')
