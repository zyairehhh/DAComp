import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-089.sqlite')

# 1. Get key accounts (Enterprise, revenue >= 79621808)
query = """
SELECT 
    account_id,
    account_name,
    industry_normalized,
    annual_revenue,
    number_of_employees,
    total_contacts
FROM salesforce__customer_360_view 
WHERE account_size_segment = 'Enterprise' 
    AND annual_revenue >= 79621808
"""
df = pd.read_sql_query(query, conn)

# Compute CDR
df['cdr'] = df['total_contacts'] / df['number_of_employees'] * 1000
df['cdr'] = df['cdr'].replace([np.inf, -np.inf], np.nan)

# 2. Get decision-maker contacts
query_dm = """
SELECT 
    account_id,
    COUNT(*) as dm_contacts
FROM salesforce__contact_enhanced 
WHERE (title LIKE '%Chief%' OR title LIKE '%VP%' OR title LIKE '%Vice President%')
    AND account_id IN (SELECT account_id FROM salesforce__customer_360_view 
                       WHERE account_size_segment = 'Enterprise' 
                          AND annual_revenue >= 79621808)
GROUP BY account_id
"""
dm_df = pd.read_sql_query(query_dm, conn)
df = df.merge(dm_df, on='account_id', how='left')
df['dm_contacts'] = df['dm_contacts'].fillna(0)
df['dmr'] = df['dm_contacts'] / df['total_contacts'] * 100

# 3. Get department coverage (four key departments: Sales, Finance, Operations, HR)
# Note: dataset may have Engineering as proxy for IT; we ignore IT per report.
depts = ['Sales', 'Finance', 'Operations', 'HR']
# For each account, count distinct key departments present
dept_query = """
SELECT 
    account_id,
    department
FROM salesforce__contact_enhanced 
WHERE department IN ('Sales', 'Finance', 'Operations', 'HR')
    AND account_id IN (SELECT account_id FROM salesforce__customer_360_view 
                       WHERE account_size_segment = 'Enterprise' 
                          AND annual_revenue >= 79621808)
"""
dept_df = pd.read_sql_query(dept_query, conn)
# Pivot to count distinct departments per account
dept_counts = dept_df.groupby('account_id')['department'].nunique().reset_index()
dept_counts.columns = ['account_id', 'dept_coverage']
df = df.merge(dept_counts, on='account_id', how='left')
df['dept_coverage'] = df['dept_coverage'].fillna(0)

# Check basic stats
print(f"Number of key accounts: {len(df)}")
print(f"CDR median: {df['cdr'].median()}")
print(f"CDR compliance (>=5): {(df['cdr'] >= 5).sum() / len(df) * 100:.1f}%")
print(f"DMR median: {df['dmr'].median()}")
print(f"DMR compliance (>=15): {(df['dmr'] >= 15).sum() / len(df) * 100:.1f}%")
print(f"Department coverage distribution:")
print(df['dept_coverage'].value_counts().sort_index())

# Risk scoring (as per report: 0-6 points)
# We'll compute for visualization later

conn.close()
```
