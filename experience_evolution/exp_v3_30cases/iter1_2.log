'''
import pandas as pd
import numpy as np
import re

def extract_lower(salary_str):
    if pd.isna(salary_str):
        return np.nan
    match = re.search(r'([0-9,\.]+)\s*-\s*[0-9,\.]+', salary_str)
    if match:
        num_str = match.group(1).replace(',', '').strip()
        try:
            return float(num_str)
        except:
            return np.nan
    else:
        match2 = re.search(r'([0-9,\.]+)', salary_str)
        if match2:
            num_str = match2.group(1).replace(',', '').strip()
            try:
                return float(num_str)
            except:
                return np.nan
        else:
            return np.nan

# Load data again
df = pd.read_csv('vocational_data.csv')
df['starting_salary'] = df['Salary Range'].apply(extract_lower)
salary_df = df.dropna(subset=['starting_salary']).copy()
print("=== Starting Salary Distribution ===")
print("Number of vocational job postings with salary info:", len(salary_df))
print("Descriptive statistics:")
print(salary_df['starting_salary'].describe())
bins = [0, 2000, 3000, 4000, 5000, 6000, 8000, 10000, 15000, 20000, 50000]
labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-8k', '8k-10k', '10k-15k', '15k-20k', '>20k']
salary_df['salary_bin'] = pd.cut(salary_df['starting_salary'], bins=bins, labels=labels, right=False)
dist = salary_df['salary_bin'].value_counts().sort_index()
print("\nDistribution across bins:")
for bin_name, count in dist.items():
    print(f"{bin_name}: {count} ({count/len(salary_df)*100:.1f}%)")

# Benefits distribution
print("\n=== Benefits Distribution (Cleaned) ===")
benefits_series = salary_df['Benefits'].dropna()
def clean_benefits(benefit_str):
    # Split by common separators: comma, Chinese comma，、and 'and'
    parts = re.split(r'[,，、]', benefit_str)
    cleaned = []
    for part in parts:
        part = part.strip()
        if part.startswith('and '):
            part = part[4:]
        if part.endswith('.'):
            part = part[:-1]
        # normalize case and spaces
        part = part.lower().replace('  ', ' ')
        # synonyms mapping
        synonyms = {
            'five insurances': 'five social insurances',
            'high temperature allowance': 'high-temperature allowance',
            'double pay at the end of the year': 'double salary at the end of the year',
            'year-end bonus': 'double salary at the end of the year',
            'full attendance bonus.': 'full attendance bonus',
            'full attendance bonus': 'full attendance bonus',
            'work uniform.': 'work uniform',
            'meals provided.': 'meals provided',
            'accommodation provided.': 'accommodation provided',
        }
        if part in synonyms:
            part = synonyms[part]
        cleaned.append(part)
    return cleaned

benefit_counts = {}
for b in benefits_series:
    items = clean_benefits(b)
    for item in items:
        if item:
            benefit_counts[item] = benefit_counts.get(item, 0) + 1

print(f"Total unique benefits: {len(benefit_counts)}")
sorted_benefits = sorted(benefit_counts.items(), key=lambda x: x[1], reverse=True)
print("\nTop 20 benefits:")
for benefit, count in sorted_benefits[:20]:
    print(f"{benefit}: {count} ({count/len(salary_df)*100:.1f}%)")

# Qualities that increase salary
print("\n=== Qualities that Significantly Increase Starting Salaries ===")
# 1. Work Experience
salary_df['exp_group'] = salary_df['Work Experience Requirement'].fillna('Missing')
exp_map = {
    'No limit': 'No limit',
    'Fresh graduates': 'Fresh graduates',
    'More than one year of work experience': '1+ years',
    'Two years or more of work experience': '2+ years',
    'Three years or more of work experience': '3+ years',
    'Four years or more of work experience': '4+ years',
    'Five years or more of work experience': '5+ years',
    'Six years or more of work experience': '6+ years',
    'Seven years or more of work experience': '7+ years',
    'Eight years or more of work experience': '8+ years',
    'Nine years or more of work experience': '9+ years',
    'Ten years or more of work experience': '10+ years',
    'More than 15 years of work experience': '15+ years',
}
def map_exp_cat(val):
    for k, v in exp_map.items():
        if k in str(val):
            return v
    return 'Other'

salary_df['exp_cat'] = salary_df['Work Experience Requirement'].apply(map_exp_cat)
exp_summary = salary_df.groupby('exp_cat')['starting_salary'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nAverage salary by work experience category:")
print(exp_summary)

# 2. Foreign Language Requirement
salary_df['lang_cat'] = salary_df['Foreign Language Requirement'].fillna('Missing')
lang_summary = salary_df.groupby('lang_cat')['starting_salary'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print("\nAverage salary by language requirement:")
print(lang_summary.head(20))

# 3. Age Requirement
def extract_max_age(val):
    if pd.isna(val):
        return np.nan
    match = re.search(r'to\s*(\d+)\s*years old', str(val).lower())
    if match:
        return int(match.group(1))
    else:
        return np.nan
salary_df['max_age'] = salary_df['Age Requirement'].apply(extract_max_age)
age_salary_corr = salary_df['max_age'].corr(salary_df['starting_salary'])
print(f"\nCorrelation between maximum age requirement and salary: {age_salary_corr:.3f}")

# 4. Gender Requirement
gender_summary = salary_df.groupby('Gender Requirement')['starting_salary'].agg(['mean', 'count'])
print("\nAverage salary by gender requirement:")
print(gender_summary)

# 5. Employment Type (only one, skip)
# 6. Work Location: extract first city word for simple grouping
def extract_city(loc):
    if pd.isna(loc):
        return 'Unknown'
    # take first Chinese characters before space or punctuation
    city = str(loc).split()[0] if ' ' in str(loc) else str(loc)[:4]
    return city
salary_df['city'] = salary_df['Work Location'].apply(extract_city)
city_counts = salary_df['city'].value_counts()
# keep cities with at least 50 postings
top_cities = city_counts[city_counts >= 50].index.tolist()
salary_df['city_group'] = salary_df['city'].apply(lambda x: x if x in top_cities else 'Other')
city_summary = salary_df.groupby('city_group')['starting_salary'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print("\nAverage salary by city (top by count):")
print(city_summary.head(20))
'''
