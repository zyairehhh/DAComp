import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Load data
accounts = pd.read_csv('data/accounts.csv')
contacts = pd.read_csv('data/contacts.csv')
revenue = pd.read_csv('data/revenue.csv')
# employees.csv maybe redundant
employees = pd.read_csv('data/employees.csv')  # has account_id, employee_count

# Ensure unique employee count per account
if 'employee_count' in accounts.columns:
    # use accounts as primary
    pass
else:
    # merge employees
    accounts = accounts.merge(employees, on='account_id', how='left')

# Get revenue for 2023
revenue_2023 = revenue[revenue['year'] == 2023]
account_revenue = revenue_2023.groupby('account_id')['revenue'].sum().reset_index()

# Merge with accounts
account_data = accounts.merge(account_revenue, on='account_id', how='inner')

# Determine top 20% threshold by revenue
total_rev = account_data['revenue'].sum()
threshold = account_data['revenue'].quantile(0.8)
key_accounts = account_data[account_data['revenue'] >= threshold].copy()
print(f"Key accounts count: {len(key_accounts)}")

# Compute metrics for each key account
# Contact Density Ratio = (Number of Contacts / Number of Employees) * 1000
# Need contacts count per account
contact_counts = contacts.groupby('account_id').size().reset_index(name='contact_count')
key_accounts = key_accounts.merge(contact_counts, on='account_id', how='left')
key_accounts['contact_count'] = key_accounts['contact_count'].fillna(0)

# Employee count from accounts (or employees)
if 'employee_count' in key_accounts.columns:
    key_accounts['employee_count'] = key_accounts['employee_count'].fillna(1)
else:
    # fallback: assume 1 if missing
    key_accounts['employee_count'] = 1

key_accounts['CDR'] = (key_accounts['contact_count'] / key_accounts['employee_count']) * 1000

# Decision-Maker Ratio: proportion of C-level + VP-level contacts
# Identify decision-makers: title contains 'C', 'Chief', 'VP', 'Vice President', 'President', 'Director'?
# Based on Stage1: C-level + VP-level. Let's define pattern.
def is_decision_maker(title):
    if isinstance(title, str):
        title_lower = title.lower()
        # C-level: CEO, CFO, CTO, COO, etc.
        if any(c in title_lower for c in ['chief', 'c-level', 'ceo', 'cfo', 'cto', 'coo', 'cio']):
            return True
        # VP-level
        if 'vp' in title_lower or 'vice president' in title_lower:
            return True
        # Possibly include 'President'
        if 'president' in title_lower and 'vice' not in title_lower:
            return True
    return False

# For each account, compute decision-maker contacts
dm_contacts = contacts.copy()
dm_contacts['is_dm'] = dm_contacts['title'].apply(is_decision_maker)
dm_counts = dm_contacts.groupby('account_id')['is_dm'].sum().reset_index(name='dm_count')
key_accounts = key_accounts.merge(dm_counts, on='account_id', how='left')
key_accounts['dm_count'] = key_accounts['dm_count'].fillna(0)
key_accounts['DMR'] = key_accounts['dm_count'] / key_accounts['contact_count'].replace(0, np.nan) * 100
key_accounts['DMR'] = key_accounts['DMR'].fillna(0)

# Department Coverage Completeness: across 5 key depts: Sales, Finance, Operations, IT, HR
key_depts = ['Sales', 'Finance', 'Operations', 'IT', 'HR']
# For each account, get unique departments from contacts
dept_counts = contacts.groupby('account_id')['department'].apply(lambda x: set(x.dropna().unique())).reset_index(name='depts')
def coverage_score(dept_set):
    if not isinstance(dept_set, set):
        return 0
    covered = sum(1 for d in key_depts if d in dept_set)
    return covered / len(key_depts) * 100  # percentage

dept_counts['DCS'] = dept_counts['depts'].apply(coverage_score)
key_accounts = key_accounts.merge(dept_counts[['account_id', 'DCS']], on='account_id', how='left')
key_accounts['DCS'] = key_accounts['DCS'].fillna(0)

# Risk classification based on thresholds
benchmark_cdr = 5
benchmark_dmr = 15
benchmark_dcs = 100

def classify_risk(row):
    risk_score = 0
    if row['CDR'] < benchmark_cdr:
        risk_score += 1
    if row['DMR'] < benchmark_dmr:
        risk_score += 1
    if row['DCS'] < benchmark_dcs:
        risk_score += 1
    if risk_score == 0:
        return 'Low'
    elif risk_score == 1:
        return 'Medium'
    else:
        return 'High'

key_accounts['Risk'] = key_accounts.apply(classify_risk, axis=1)

print(key_accounts[['account_id', 'account_name', 'CDR', 'DMR', 'DCS', 'Risk']].head())
print("\nRisk distribution:")
print(key_accounts['Risk'].value_counts())

# Save key accounts metrics for reference
key_accounts.to_csv('key_accounts_metrics.csv', index=False)
```

