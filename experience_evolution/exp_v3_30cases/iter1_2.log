import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# Connect to database
db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-076/stage2_env/dacomp-076.sqlite"
conn = sqlite3.connect(db_path)

# Load data
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)

# Calculate segment average retention
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'segment_avg_retention']

# Merge with original dataframe
df = df.merge(segment_avg, on='profitability_segment')

# Calculate deviation from segment average
df['retention_deviation'] = df['retention_probability'] - df['segment_avg_retention']
df['abs_deviation'] = abs(df['retention_deviation'])

# Flag anomalies (deviation > 0.15)
df['is_anomaly'] = df['abs_deviation'] > 0.15

# Create visualizations
plt.style.use('default')

# 1. Boxplot of retention probability by segment
plt.figure(figsize=(10, 6))
sns.boxplot(data=df, x='profitability_segment', y='retention_probability')
plt.title('Retention Probability Distribution by Profitability Segment')
plt.xlabel('Profitability Segment')
plt.ylabel('Retention Probability')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('retention_by_segment_boxplot.png', dpi=100)
plt.close()

# 2. Scatter: customer score vs revenue, colored by anomaly status
plt.figure(figsize=(10, 6))
scatter = plt.scatter(df['comprehensive_customer_score'], df['total_revenue'], 
                      c=df['is_anomaly'], cmap='coolwarm', alpha=0.6, 
                      edgecolors='black', linewidth=0.5)
plt.colorbar(scatter, label='Is Anomaly (deviation > 0.15)')
plt.title('Customer Score vs Revenue (Anomalies Highlighted)')
plt.xlabel('Comprehensive Customer Score')
plt.ylabel('Total Revenue')
plt.tight_layout()
plt.savefig('score_vs_revenue_scatter.png', dpi=100)
plt.close()

# 3. Heatmap of quarterly transactions
quarter_cols = ['q1_transactions', 'q2_transactions', 'q3_transactions', 'q4_transactions']
heatmap_data = pd.DataFrame({
    'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'],
    'Anomaly': df[df['is_anomaly']][quarter_cols].mean().values,
    'Normal': df[~df['is_anomaly']][quarter_cols].mean().values
}).set_index('Quarter')

plt.figure(figsize=(8, 6))
sns.heatmap(heatmap_data, annot=True, fmt='.2f', cmap='YlOrRd', cbar_kws={'label': 'Average Transactions'})
plt.title('Average Quarterly Transactions: Anomaly vs Normal Customers')
plt.tight_layout()
plt.savefig('quarterly_transactions_heatmap.png', dpi=100)
plt.close()

# 4. Transaction consistency vs volatility
plt.figure(figsize=(10, 6))
plt.scatter(df['transaction_count'], df['avg_transactions_per_month'], 
            c=df['transaction_value_volatility'], s=50, alpha=0.6, cmap='viridis')
plt.colorbar(label='Transaction Value Volatility')
plt.xlabel('Transaction Count')
plt.ylabel('Average Transactions per Month')
plt.title('Transaction Behavior: Consistency vs Volatility')
plt.tight_layout()
plt.savefig('transaction_consistency_volatility.png', dpi=100)
plt.close()

# 5. Anomaly percentage by segment
anomaly_by_segment = df.groupby('profitability_segment')['is_anomaly'].mean().reset_index()
anomaly_by_segment.columns = ['profitability_segment', 'anomaly_percentage']

plt.figure(figsize=(10, 6))
bars = plt.bar(anomaly_by_segment['profitability_segment'], anomaly_by_segment['anomaly_percentage'] * 100)
plt.title('Percentage of Anomaly Customers by Profitability Segment')
plt.xlabel('Profitability Segment')
plt.ylabel('Anomaly Percentage (%)')
plt.xticks(rotation=45)
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.5,
             f'{height:.1f}%', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('anomaly_percentage_by_segment.png', dpi=100)
plt.close()

# 6. Create proposed dimensions manually (no sklearn)
# Transaction stability
df['transaction_stability'] = df['transaction_count'] / df['avg_transactions_per_month'].replace(0, 1)
# Seasonal balance (entropy)
def calculate_entropy(row):
    quarters = [row['q1_transactions'], row['q2_transactions'], row['q3_transactions'], row['q4_transactions']]
    total = sum(quarters)
    if total == 0:
        return 0
    probs = [q/total for q in quarters]
    entropy = -sum(p * np.log(p + 1e-10) for p in probs)
    return entropy / np.log(4)
df['seasonal_entropy'] = df.apply(calculate_entropy, axis=1)

# Scatter of new dimensions colored by anomaly
plt.figure(figsize=(12, 5))
plt.subplot(1, 2, 1)
plt.scatter(df['transaction_stability'], df['transaction_value_volatility'], 
            c=df['is_anomaly'], cmap='coolwarm', alpha=0.6)
plt.xlabel('Transaction Stability (count/month)')
plt.ylabel('Transaction Value Volatility')
plt.title('Stability vs Volatility (Anomalies colored)')

plt.subplot(1, 2, 2)
plt.scatter(df['seasonal_entropy'], df['transaction_value_volatility'], 
            c=df['is_anomaly'], cmap='coolwarm', alpha=0.6)
plt.xlabel('Seasonal Entropy (balance across quarters)')
plt.ylabel('Transaction Value Volatility')
plt.title('Seasonality vs Volatility (Anomalies colored)')
plt.tight_layout()
plt.savefig('new_dimensions_scatter.png', dpi=100)
plt.close()

# 7. Distribution of deviation from segment average
plt.figure(figsize=(10, 6))
for segment in df['profitability_segment'].unique():
    subset = df[df['profitability_segment'] == segment]
    plt.hist(subset['retention_deviation'], alpha=0.5, label=segment, bins=20)
plt.axvline(-0.15, color='red', linestyle='--', label='Deviation threshold')
plt.axvline(0.15, color='red', linestyle='--')
plt.xlabel('Retention Probability Deviation from Segment Average')
plt.ylabel('Frequency')
plt.title('Distribution of Retention Deviations by Segment')
plt.legend()
plt.tight_layout()
plt.savefig('deviation_distribution.png', dpi=100)
plt.close()

# Print key statistics
print("=== Stage1 Validation Statistics ===")
print(f"Total customers: {len(df)}")
print(f"Anomaly customers (|deviation| > 0.15): {df['is_anomaly'].sum()} ({df['is_anomaly'].mean()*100:.1f}%)")
print("\nAnomaly percentage by segment:")
for _, row in anomaly_by_segment.iterrows():
    print(f"  {row['profitability_segment']}: {row['anomaly_percentage']*100:.1f}%")

print("\nAverage characteristics:")
print(df.groupby('is_anomaly').agg({
    'transaction_count': 'mean',
    'avg_transactions_per_month': 'mean',
    'transaction_value_volatility': 'mean',
    'comprehensive_customer_score': 'mean',
    'total_revenue': 'mean'
}).round(2))

# Print quarterly distribution differences
print("\nAverage quarterly transactions:")
print("Anomaly customers:")
print(df[df['is_anomaly']][quarter_cols].mean().round(2))
print("Normal customers:")
print(df[~df['is_anomaly']][quarter_cols].mean().round(2))

conn.close()
print("\nVisualizations saved in current directory.")
''')
