import pandas as pd
import numpy as np
import sqlite3

# Connect to database
conn = sqlite3.connect('dacomp-058.sqlite')

# Load filtered campaigns (cost > 1000, roas < 0.8)
query = """
SELECT cr.year_month, cr.campaign_id, cr.campaign_name, cr.campaign_type, cr.bidding_strategy, cr.industry,
       cr.cost, cr.conversions, cr.roas, cr.quality_score, cr.impression_share, cr.ctr, cr.conversion_rate,
       cr.impressions, cr.clicks, cr.conversion_value
FROM google_ads__campaign_report cr
WHERE cr.cost > 1000 AND cr.roas < 0.8
"""
df = pd.read_sql_query(query, conn)

# Ensure numeric columns
numeric_cols = ['cost', 'conversions', 'roas', 'quality_score', 'impression_share', 'ctr', 'conversion_rate', 'impressions', 'clicks', 'conversion_value']
for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Compute additional metrics
df['cost_per_conversion'] = df.apply(lambda row: row['cost']/row['conversions'] if row['conversions']>0 else float('inf'), axis=1)

# Normalization function
def min_max_scale(series):
    if series.nunique() == 0 or series.max() == series.min():
        return pd.Series([0.5]*len(series), index=series.index)  # default neutral
    return (series - series.min()) / (series.max() - series.min())

# 1. Cost Efficiency (40%): ROAS (higher better) and cost per conversion (lower better)
df['roas_norm'] = min_max_scale(df['roas'])
df['cpc_norm'] = 1 - min_max_scale(df['cost_per_conversion'])  # invert
df['cost_efficiency'] = 0.5 * df['roas_norm'] + 0.5 * df['cpc_norm']

# 2. Conversion Quality (35%): conversion_rate, quality_score, ctr
df['conv_rate_norm'] = min_max_scale(df['conversion_rate'])
df['qual_score_norm'] = min_max_scale(df['quality_score'])
df['ctr_norm'] = min_max_scale(df['ctr'])
df['conversion_quality'] = (df['conv_rate_norm'] + df['qual_score_norm'] + df['ctr_norm']) / 3

# 3. Competitiveness (25%): impression_share only (higher better)
df['imp_share_norm'] = min_max_scale(df['impression_share'])
# If we have avg_position later we can incorporate; for now just impression_share
df['competitiveness'] = df['imp_share_norm']

# Weighted health score (0-100)
df['health_score'] = df['cost_efficiency'] * 40 + df['conversion_quality'] * 35 + df['competitiveness'] * 25
df['health_score'] = df['health_score'].round(2)

# Risk levels based on quartiles
q1 = df['health_score'].quantile(0.25)
q2 = df['health_score'].quantile(0.5)
q3 = df['health_score'].quantile(0.75)
def risk_level(score):
    if score <= q1:
        return 'Critical'
    elif score <= q2:
        return 'High'
    elif score <= q3:
        return 'Medium'
    else:
        return 'Low'
df['risk_level'] = df['health_score'].apply(risk_level)

# Add avg_position from keyword_report (quarterly) by mapping month to quarter
query_kw = """
SELECT year_quarter, campaign_id, AVG(avg_position) as avg_position
FROM google_ads__keyword_report
GROUP BY year_quarter, campaign_id
"""
avg_pos = pd.read_sql_query(query_kw, conn)
# Map month to quarter: year_month '2023-02' -> quarter '2023-Q1'
def month_to_quarter(ym):
    y, m = ym.split('-')
    m = int(m)
    q = (m - 1) // 3 + 1
    return f"{y}-Q{q}"
df['year_quarter'] = df['year_month'].apply(month_to_quarter)
df = df.merge(avg_pos, on=['campaign_id', 'year_quarter'], how='left')
# Normalize avg_position (lower better)
df['avg_pos_norm'] = 1 - min_max_scale(df['avg_position'].fillna(df['avg_position'].median()))
# Adjust competitiveness to include avg_position (weight: impression_share 60%, avg_position 40%)
df['competitiveness_adj'] = 0.6 * df['imp_share_norm'] + 0.4 * df['avg_pos_norm']
df['health_score_adj'] = df['cost_efficiency'] * 40 + df['conversion_quality'] * 35 + df['competitiveness_adj'] * 25
df['health_score_adj'] = df['health_score_adj'].round(2)
# Recompute risk levels with adjusted score
q1a = df['health_score_adj'].quantile(0.25)
q2a = df['health_score_adj'].quantile(0.5)
q3a = df['health_score_adj'].quantile(0.75)
df['risk_level_adj'] = df['health_score_adj'].apply(lambda s: 'Critical' if s <= q1a else ('High' if s <= q2a else ('Medium' if s <= q3a else 'Low')))

# Save health scores
df.to_csv('campaign_health_scores_full.csv', index=False)

print("Health scores computed, shape:", df.shape)
print("Risk level distribution (original):")
print(df['risk_level'].value_counts())
print("Risk level distribution (adjusted):")
print(df['risk_level_adj'].value_counts())

# Analysis across dimensions
print("\n--- Performance across campaign_type ---")
campaign_type_stats = df.groupby('campaign_type').agg(
    count=('campaign_id', 'size'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean'),
    avg_health=('health_score_adj', 'mean'),
    critical_rate=('risk_level_adj', lambda x: (x == 'Critical').sum() / len(x))
).round(2)
print(campaign_type_stats)

print("\n--- Performance across bidding_strategy ---")
bidding_stats = df.groupby('bidding_strategy').agg(
    count=('campaign_id', 'size'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean'),
    avg_health=('health_score_adj', 'mean'),
    critical_rate=('risk_level_adj', lambda x: (x == 'Critical').sum() / len(x))
).round(2)
print(bidding_stats)

print("\n--- Performance across industry ---")
industry_stats = df.groupby('industry').agg(
    count=('campaign_id', 'size'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean'),
    avg_health=('health_score_adj', 'mean'),
    critical_rate=('risk_level_adj', lambda x: (x == 'Critical').sum() / len(x))
).round(2)
print(industry_stats)

# Geo and device analysis: need to aggregate geo_report and device_report for the filtered campaigns
geo_query = """
SELECT gr.year_month, gr.campaign_id, gr.geo_target,
       gr.cost, gr.roas, gr.quality_score, gr.impression_share, gr.ctr, gr.conversion_rate
FROM google_ads__geo_report gr
WHERE gr.campaign_id IN ({})
""".format(','.join(map(str, df['campaign_id'].unique())))
geo_df = pd.read_sql_query(geo_query, conn)
print("\nGeo distribution rows:", geo_df.shape)
# Device
device_query = """
SELECT dr.year_month, dr.campaign_id, dr.device_type,
       dr.cost, dr.roas, dr.quality_score, dr.impression_share, dr.ctr, dr.conversion_rate
FROM google_ads__device_report dr
WHERE dr.campaign_id IN ({})
""".format(','.join(map(str, df['campaign_id'].unique())))
device_df = pd.read_sql_query(device_query, conn)
print("Device distribution rows:", device_df.shape)

# Year-over-year growth rates (need to compare same month across years)
# Since we have 2023-01 to 2024-06 (16 months), we can compute month-over-month changes
df['year_month_dt'] = pd.to_datetime(df['year_month'], format='%Y-%m')
# Compute average health score per month across campaigns
monthly_health = df.groupby('year_month_dt')['health_score_adj'].mean().reset_index()
monthly_health = monthly_health.sort_values('year_month_dt')
print("\nMonthly average health score:")
print(monthly_health)

# Seasonal decomposition simple: compute month-over-month change and year-over-year change where possible
# For YoY, need same month across years: 2023-02 vs 2024-02, etc.
# Let's compute year-over-year growth rate for each month available
def compute_yoy_growth(df, metric='health_score_adj'):
    df['year'] = df['year_month_dt'].dt.year
    df['month'] = df['year_month_dt'].dt.month
    pivot = df.pivot_table(index='month', columns='year', values=metric, aggfunc='mean')
    pivot['yoy_growth'] = (pivot[2024] - pivot[2023]) / pivot[2023] * 100
    return pivot
yoy_health = compute_yoy_growth(df)
print("\nYear-over-Year growth (health score %):")
print(yoy_health)

conn.close()
```

