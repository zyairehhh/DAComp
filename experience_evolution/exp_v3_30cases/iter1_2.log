# Load data and parse dates
df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)
df['date_day'] = pd.to_datetime(df['date_day'])
df['acquisition_cohort'] = pd.to_datetime(df['acquisition_cohort'], errors='coerce')

# Latest date in dataset
latest_date = df['date_day'].max()
print(f"Latest date: {latest_date}")
# last 30 days range
last_start = latest_date - timedelta(days=30)
print(f"Last 30 days start: {last_start}")

# Compute per campaign (account, channel, stage) metrics
campaign_cols = ['account_id', 'advertising_channel_type', 'campaign_lifecycle_stage']
# campaign start and end dates
campaign_dates = df.groupby(campaign_cols)['date_day'].agg(['min', 'max']).reset_index()
campaign_dates['min'] = pd.to_datetime(campaign_dates['min'])
campaign_dates['max'] = pd.to_datetime(campaign_dates['max'])
campaign_dates['days_running'] = (campaign_dates['max'] - campaign_dates['min']).dt.days
print(f"Total distinct campaigns: {len(campaign_dates)}")
print(campaign_dates.head())

# Filter campaigns running >120 days
long_campaigns = campaign_dates[campaign_dates['days_running'] > 120]
print(f"Campaigns running >120 days: {len(long_campaigns)}")
print(long_campaigns.head())

