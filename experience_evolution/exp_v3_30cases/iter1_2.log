```python
import pandas as pd
import sqlite3
import matplotlib.pyplot as plt
import matplotlib
# Use default English fonts, no SimHei unless needed

# Load data
conn = sqlite3.connect('dacomp-017.sqlite')
df = pd.read_sql_query("SELECT * FROM order_information", conn)
df['Sales'] = pd.to_numeric(df['Sales'], errors='coerce')
df['profit'] = pd.to_numeric(df['profit'], errors='coerce')
df['Discount'] = pd.to_numeric(df['Discount'].astype(str).str.rstrip('%'), errors='coerce')
df['Shipping Cost'] = pd.to_numeric(df['Shipping Cost'].astype(str).str.replace(',', ''), errors='coerce')
df['Order Date'] = pd.to_datetime(df['Order Date'])

# Compute category profit margin by year
df['year'] = df['Order Date'].dt.year
df['margin'] = df['profit'] / df['Sales'] * 100  # percentage

cat_year = df.groupby(['Product Category', 'year']).agg({'profit':'sum', 'Sales':'sum'}).reset_index()
cat_year['margin'] = cat_year['profit'] / cat_year['Sales'] * 100

# Plot 1: Line plot per category
plt.figure(figsize=(10,6))
categories = cat_year['Product Category'].unique()
for cat in categories:
    sub = cat_year[cat_year['Product Category']==cat]
    plt.plot(sub['year'], sub['margin'], marker='o', label=cat)
plt.xlabel('Year')
plt.ylabel('Profit Margin (%)')
plt.title('Profit Margin by Product Category (2022-2024)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('category_margin_line.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 2: Bar chart of swing (max-min)
swing = cat_year.groupby('Product Category')['margin'].apply(lambda x: x.max() - x.min()).reset_index()
swing = swing.sort_values('margin', ascending=False)
plt.figure(figsize=(8,5))
bars = plt.bar(swing['Product Category'], swing['margin'], color='coral')
plt.ylabel('Margin Swing (percentage points)')
plt.title('Profit Margin Swing (max-min) Across 2022-2024')
plt.xticks(rotation=45)
# Annotate values
for bar in bars:
    height = bar.get_height()
    plt.annotate(f'{height:.2f}', xy=(bar.get_x()+bar.get_width()/2, height),
                 xytext=(0,3), textcoords='offset points', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('category_swing_bar.png', dpi=300, bbox_inches='tight')
plt.close()

print('Generated category_margin_line.png and category_swing_bar.png')
```
