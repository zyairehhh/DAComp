df['health_score_num'] = df['health_score'].astype(float)

# Filter for customers due for renewal within next 90 days
df_renewal_window = df[df['renewal_window'] == 'inside_90_days'].copy()

print(f"Total companies: {df.shape[0]}")
print(f"Companies inside 90-day renewal window: {df_renewal_window.shape[0]}")

# Create plots
plt.rcParams.update({'font.size': 10})

# Plot 1: Feature adoption vs health score
fig, axs = plt.subplots(2, 2, figsize=(12, 10))
ax1 = axs[0,0]
sc1 = ax1.scatter(df_renewal_window['feature_adoption_pct'], df_renewal_window['health_score_num'], alpha=0.6)
ax1.set_xlabel('Feature Adoption (%)')
ax1.set_ylabel('Health Score')
ax1.set_title('Feature Adoption vs Health Score (Renewal Window <90d)')
ax1.grid(True, alpha=0.3)

# Plot 2: Sentiment score vs health score
ax2 = axs[0,1]
sc2 = ax2.scatter(df_renewal_window['sentiment_score'], df_renewal_window['health_score_num'], alpha=0.6)
ax2.set_xlabel('Sentiment Score (uplift=2, at-risk=-2)')
ax2.set_ylabel('Health Score')
ax2.set_title('Sentiment Score vs Health Score (Renewal Window <90d)')
ax2.grid(True, alpha=0.3)

# Plot 3: Avg resolution time vs health score
ax3 = axs[1,0]
sc3 = ax3.scatter(df_renewal_window['avg_resolution_time'], df_renewal_window['health_score_num'], alpha=0.6)
ax3.set_xlabel('Median Resolution Time (minutes)')
ax3.set_ylabel('Health Score')
ax3.set_title('Resolution Time vs Health Score (Renewal Window <90d)')
ax3.grid(True, alpha=0.3)

# Plot 4: Reopen proportion vs health score
ax4 = axs[1,1]
sc4 = ax4.scatter(df_renewal_window['reopen_proportion'], df_renewal_window['health_score_num'], alpha=0.6)
ax4.set_xlabel('Median Reopens per Conversation')
ax4.set_ylabel('Health Score')
ax4.set_title('Reopen Frequency vs Health Score (Renewal Window <90d)')
ax4.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('feature_vs_health_scatter.png', dpi=150)
print("Saved scatter plots to feature_vs_health_scatter.png")

# Also create boxplots comparing high vs low health score groups
df_renewal_window['health_group'] = pd.qcut(df_renewal_window['health_score_num'], q=3, labels=['Low', 'Medium', 'High'])

fig2, axs2 = plt.subplots(2, 2, figsize=(12, 10))
# Feature adoption by health group
df_renewal_window.boxplot(column='feature_adoption_pct', by='health_group', ax=axs2[0,0])
axs2[0,0].set_xlabel('Health Group')
axs2[0,0].set_ylabel('Feature Adoption (%)')
axs2[0,0].set_title('Feature Adoption by Health Group')
axs2[0,0].grid(True, alpha=0.3)

# Sentiment score by health group
df_renewal_window.boxplot(column='sentiment_score', by='health_group', ax=axs2[0,1])
axs2[0,1].set_xlabel('Health Group')
axs2[0,1].set_ylabel('Sentiment Score')
axs2[0,1].set_title('Sentiment Score by Health Group')
axs2[0,1].grid(True, alpha=0.3)

# Resolution time by health group
df_renewal_window.boxplot(column='avg_resolution_time', by='health_group', ax=axs2[1,0])
axs2[1,0].set_xlabel('Health Group')
axs2[1,0].set_ylabel('Resolution Time (minutes)')
axs2[1,0].set_title('Resolution Time by Health Group')
axs2[1,0].grid(True, alpha=0.3)

# Reopens by health group
df_renewal_window.boxplot(column='reopen_proportion', by='health_group', ax=axs2[1,1])
axs2[1,1].set_xlabel('Health Group')
axs2[1,1].set_ylabel('Median Reopens')
axs2[1,1].set_title('Reopen Frequency by Health Group')
axs2[1,1].grid(True, alpha=0.3)

plt.suptitle('')  # Remove default suptitle
plt.tight_layout()
plt.savefig('feature_by_health_boxplot.png', dpi=150)
print("Saved boxplots to feature_by_health_boxplot.png")

# Compute correlation coefficients
corr_features = pd.DataFrame({
    'feature_adoption': df_renewal_window['feature_adoption_pct'],
    'sentiment_score': df_renewal_window['sentiment_score'],
    'resolution_time': df_renewal_window['avg_resolution_time'],
    'reopen_freq': df_renewal_window['reopen_proportion'],
    'health_score': df_renewal_window['health_score_num']
})
corr_matrix = corr_features.corr()
print("\nCorrelation with health score:")
print(corr_matrix['health_score'].sort_values(ascending=False))

# Save correlation heatmap
import seaborn as sns
plt.figure(figsize=(8,6))
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', center=0, fmt='.2f')
plt.title('Feature Correlation Matrix (Renewal Window <90d)')
plt.tight_layout()
plt.savefig('correlation_heatmap.png', dpi=150)
print("Saved correlation heatmap to correlation_heatmap.png")
```
