import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-061/stage1_env/dacomp-061.sqlite')

# Load tables
project_df = pd.read_sql_query("SELECT * FROM jira__project_enhanced", conn)
team_df = pd.read_sql_query("SELECT * FROM jira__team_performance_dashboard", conn)
issue_df = pd.read_sql_query("SELECT * FROM jira__issue_intelligence_analytics", conn)

# Compute team stability per project_name
# Use at_churn_risk, inactive_recently, poor_estimation as risk flags
team_agg = team_df.groupby('project_name').agg(
    team_size=('user_id', 'count'),
    avg_consistency=('consistency_percentage', 'mean'),
    risk_users=('at_churn_risk', lambda x: (x == 1).sum()),
    inactive_users=('inactive_recently', lambda x: (x == 1).sum()),
    poor_est_users=('poor_estimation', lambda x: (x == 1).sum()),
    total_assigned_issues=('total_assigned_issues', 'sum'),
    total_bug_issues=('bug_issues', 'sum'),
    avg_estimate_accuracy=('estimate_accuracy_percentage', 'mean')
).reset_index()

team_agg['team_stability'] = 1 - (team_agg['risk_users'] + team_agg['inactive_users']) / team_agg['team_size']
team_agg['bug_rate'] = team_agg['total_bug_issues'] / team_agg['total_assigned_issues'].replace(0, np.nan)

# Issue quality metrics per project
issue_agg = issue_df.groupby('project_name').agg(
    avg_lifecycle_quality=('lifecycle_quality_score', 'mean'),
    avg_regression_ratio=('regression_ratio', 'mean'),
    avg_deviation=('lifecycle_deviation_ratio', 'mean'),
    high_complexity_rate=('high_complexity_risk', 'mean'),
    total_issues=('issue_id', 'count'),
    avg_total_risk=('total_risk_score', 'mean'),
    avg_completion_prob=('completion_probability', 'mean')
).reset_index()

# Merge all
all_data = project_df.merge(team_agg, on='project_name', how='left').merge(issue_agg, on='project_name', how='left')

# Define fast vs slow based on avg_close_time_days < 15
fast = all_data[all_data['avg_close_time_days'] < 15].copy()
slow = all_data[all_data['avg_close_time_days'] >= 15].copy()

print("=== FAST PROJECTS (avg close time < 15 days) ===")
print(f"Number of project rows: {len(fast)}")
print(f"Distinct project names: {fast['project_name'].nunique()}")
print("\nMetrics averages for fast projects:")
fast_metrics = fast[['avg_close_time_days', 'team_stability', 'avg_consistency', 'bug_rate', 'avg_estimate_accuracy', 
                     'avg_lifecycle_quality', 'avg_regression_ratio', 'avg_deviation', 'avg_total_risk', 'avg_completion_prob',
                     'count_closed_issues', 'count_open_issues', 'avg_age_currently_open_days']].mean()
print(fast_metrics)

print("\n=== SLOW PROJECTS (avg close time >= 15 days) ===")
print(f"Number of project rows: {len(slow)}")
print(f"Distinct project names: {slow['project_name'].nunique()}")
print("\nMetrics averages for slow projects:")
slow_metrics = slow[['avg_close_time_days', 'team_stability', 'avg_consistency', 'bug_rate', 'avg_estimate_accuracy',
                     'avg_lifecycle_quality', 'avg_regression_ratio', 'avg_deviation', 'avg_total_risk', 'avg_completion_prob',
                     'count_closed_issues', 'count_open_issues', 'avg_age_currently_open_days']].mean()
print(slow_metrics)

# Compute differences
print("\n=== COMPARISON (Fast - Slow) ===")
for metric in ['team_stability', 'avg_consistency', 'bug_rate', 'avg_estimate_accuracy', 'avg_lifecycle_quality', 
               'avg_regression_ratio', 'avg_deviation', 'avg_total_risk', 'avg_completion_prob']:
    fast_val = fast_metrics.get(metric, np.nan)
    slow_val = slow_metrics.get(metric, np.nan)
    if pd.notnull(fast_val) and pd.notnull(slow_val):
        diff = fast_val - slow_val
        print(f"{metric}: {fast_val:.3f} vs {slow_val:.3f} (diff {diff:.3f})")

# Assess long-term sustainability: use avg_age_currently_open_days as indicator of backlog staleness
print("\n=== BACKLOG STALENESS ===")
print(f"Fast projects avg age of open issues: {fast_metrics['avg_age_currently_open_days']:.1f} days")
print(f"Slow projects avg age of open issues: {slow_metrics['avg_age_currently_open_days']:.1f} days")

# Quality risk: regression_ratio higher indicates more rework
print("\n=== REWORK INDICATORS ===")
print(f"Fast projects regression ratio: {fast_metrics['avg_regression_ratio']:.3f}")
print(f"Slow projects regression ratio: {slow_metrics['avg_regression_ratio']:.3f}")

# Correlation matrix for key variables across all projects
corr_vars = ['avg_close_time_days', 'team_stability', 'avg_lifecycle_quality', 'avg_regression_ratio', 'bug_rate', 'avg_age_currently_open_days']
corr_data = all_data[corr_vars].corr()
print("\n=== CORRELATION MATRIX ===")
print(corr_data)

conn.close()
''')
