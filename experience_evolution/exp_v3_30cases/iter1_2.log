    print(outliers_low[['Title','Price_yuan','NewCarPrice_cleaned','ResidualRatio']].head(10).to_string())
else:
    print("None")

# Simple linear regression using numpy
X = df[['Age_years','Mileage_km']].dropna()
y = df.loc[X.index, 'ResidualRatio']
X_mat = np.column_stack([np.ones(len(X)), X['Age_years'], X['Mileage_km']])
coeff = np.linalg.lstsq(X_mat, y, rcond=None)[0]
print("\nRegression coefficients (intercept, age, mileage):")
print("Intercept:", coeff[0])
print("Age_years:", coeff[1])
print("Mileage_km:", coeff[2])
print("Interpretation: each additional year reduces residual ratio by", abs(coeff[1]), "holding mileage constant.")
print("Each additional 10,000 km reduces residual ratio by", abs(coeff[2]*10000))
```
