We'll keep the chart but note the difference. But for now, we'll proceed to the third plot: interaction between vehicle type and driver rating bins for fare per km. Let's create a heatmap or grouped bar chart showing fare per km for each vehicle type across rating bins.

We'll compute fare per km per vehicle type per rating bin, then create a heatmap.

Action: CreateFile(filepath='plot_vehicle_rating_heatmap.py':
'''
import sqlite3
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-022.sqlite')

# Define rating bins
bins = [3.0, 3.5, 4.0, 4.5, 5.0]
labels = ['3.0-3.5', '3.5-4.0', '4.0-4.5', '4.5-5.0']

# Query data with vehicle type and rating
query = '''
SELECT "Vehicle Type" as vehicle_type,
       "Driver Ratings" as rating,
       "Booking Value",
       "Ride Distance"
FROM sheet1
WHERE "Driver Ratings" IS NOT NULL
'''

df = pd.read_sql_query(query, conn)
conn.close()

# Bin ratings
df['rating_bin'] = pd.cut(df['rating'], bins=bins, labels=labels, right=False, include_lowest=True)

# Group by vehicle_type and rating_bin
grouped = df.groupby(['vehicle_type', 'rating_bin']).agg(
    total_revenue=('Booking Value', 'sum'),
    total_distance=('Ride Distance', 'sum')
).reset_index()
grouped['fare_per_km'] = grouped['total_revenue'] / grouped['total_distance']

# Pivot for heatmap
pivot = grouped.pivot(index='vehicle_type', columns='rating_bin', values='fare_per_km')
print(pivot)

# Sort by descending overall fare per km (optional)
# Compute average across bins for ordering
pivot['avg'] = pivot.mean(axis=1)
pivot = pivot.sort_values('avg', ascending=False)
pivot = pivot.drop('avg', axis=1)

# Plot heatmap
fig, ax = plt.subplots(figsize=(10, 6))
im = ax.imshow(pivot.values, cmap='YlOrRd', aspect='auto')
cbar = plt.colorbar(im, ax=ax, fraction=0.03, pad=0.04)
cbar.set_label('Fare per km (currency/km)', rotation=270, labelpad=15)

# Show all ticks and labels
ax.set_xticks(np.arange(len(pivot.columns)))
ax.set_yticks(np.arange(len(pivot.index)))
ax.set_xticklabels(pivot.columns)
ax.set_yticklabels(pivot.index)

# Rotate x labels if needed
plt.setp(ax.get_xticklabels(), rotation=45, ha="right", rotation_mode="anchor")

# Annotate each cell with value
for i in range(len(pivot.index)):
    for j in range(len(pivot.columns)):
        val = pivot.iloc[i, j]
        if not np.isnan(val):
            text = ax.text(j, i, f'{val:.2f}', ha="center", va="center", color="black", fontsize=9)
        else:
            text = ax.text(j, i, 'N/A', ha="center", va="center", color="gray", fontsize=8)

ax.set_title('Fare per Kilometer by Vehicle Type and Driver Rating Bin', fontsize=14, fontweight='bold')
ax.set_xlabel('Driver Rating Bin', fontsize=12)
ax.set_ylabel('Vehicle Type', fontsize=12)
plt.tight_layout()
plt.savefig('vehicle_rating_heatmap.png', dpi=300)
print('Heatmap saved as vehicle_rating_heatmap.png')
''')
