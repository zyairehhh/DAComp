import sqlite3
import pandas as pd
import numpy as np

# Load parsed conversations
df = pd.read_csv('conversations_parsed.csv')
print(df.columns)

# Ensure responder_type is defined
if 'responder_type' not in df.columns:
    df['responder_type'] = df['path']

# Analyze conversion by intent and responder_type
# For each conversation, we have stage. We'll compute proportion of conversations that reach certain stages per intent/topic.
# Since each conversation is a single stage, we can compute distribution.

# First, compute stage distribution by responder_type and intent
stage_by_intent = pd.crosstab([df['intent'], df['responder_type']], df['stage'], normalize='index') * 100
print(stage_by_intent.head(20))

# Save to CSV
stage_by_intent.to_csv('stage_by_intent_responder.csv')

# Similarly for topic
stage_by_topic = pd.crosstab([df['topic'], df['responder_type']], df['stage'], normalize='index') * 100
stage_by_topic.to_csv('stage_by_topic_responder.csv')

# Compute conversion rates for funnel stages per intent
# We need contact-level funnel data from previous script
funnel = pd.read_csv('contact_funnel.csv')
print(funnel.columns)

# Merge intent from first conversation? Let's take first conversation per contact's intent.
first_convo = df.sort_values(['contact_id', 'initiated_at']).groupby('contact_id').first().reset_index()[['contact_id', 'intent', 'topic', 'segment', 'region', 'lifecycle']]
funnel = funnel.merge(first_convo, on='contact_id', how='left')

# Compute conversion rates per intent and responder_type
intent_groups = funnel.groupby(['intent', 'responder_type']).agg(
    total_contacts=('contact_id', 'count'),
    demo_booked=('demo_booked', lambda x: x.notna().sum()),
    trial_activated=('trial_activated', lambda x: x.notna().sum()),
    closed_won=('closed_won', lambda x: x.notna().sum()),
).reset_index()
intent_groups['demo_rate'] = intent_groups['demo_booked'] / intent_groups['total_contacts']
intent_groups['trial_rate'] = intent_groups['trial_activated'] / intent_groups['total_contacts']
intent_groups['won_rate'] = intent_groups['closed_won'] / intent_groups['total_contacts']

print(intent_groups.sort_values('total_contacts', ascending=False))

# Compute stage durations per intent
# We'll need to compute average durations for each group
def avg_duration(df, col):
    return df[col].mean(skipna=True)

# Compute durations only for contacts with both stages
# Let's create separate dataframes for each transition
# 1. resp_to_demo: need first_response_time and demo_booked
# 2. demo_to_trial: demo_booked and trial_activated
# 3. trial_to_paid: trial_activated and closed_won
# We'll compute per intent/responder_type

# Add duration columns (already computed in funnel?)
if 'resp_to_demo_days' not in funnel.columns:
    # compute
    funnel['first_response_time'] = pd.to_datetime(funnel['first_response_time'])
    funnel['demo_booked'] = pd.to_datetime(funnel['demo_booked'])
    funnel['trial_activated'] = pd.to_datetime(funnel['trial_activated'])
    funnel['closed_won'] = pd.to_datetime(funnel['closed_won'])
    
    funnel['resp_to_demo_days'] = (funnel['demo_booked'] - funnel['first_response_time']).dt.total_seconds() / (3600 * 24)
    funnel['demo_to_trial_days'] = (funnel['trial_activated'] - funnel['demo_booked']).dt.total_seconds() / (3600 * 24)
    funnel['trial_to_paid_days'] = (funnel['closed_won'] - funnel['trial_activated']).dt.total_seconds() / (3600 * 24)

# Group by intent and responder_type for durations
duration_stats = funnel.groupby(['intent', 'responder_type']).agg(
    resp_to_demo_mean=('resp_to_demo_days', 'mean'),
    demo_to_trial_mean=('demo_to_trial_days', 'mean'),
    trial_to_paid_mean=('trial_to_paid_days', 'mean'),
    count=('contact_id', 'count')
).reset_index()
print(duration_stats.sort_values('count', ascending=False))

# Save to CSV
intent_groups.to_csv('conversion_by_intent.csv', index=False)
duration_stats.to_csv('durations_by_intent.csv', index=False)

# Perform similar analysis for topic, segment, region, lifecycle
# Let's compute for topic
topic_groups = funnel.groupby(['topic', 'responder_type']).agg(
    total_contacts=('contact_id', 'count'),
    demo_booked=('demo_booked', lambda x: x.notna().sum()),
    trial_activated=('trial_activated', lambda x: x.notna().sum()),
    closed_won=('closed_won', lambda x: x.notna().sum()),
).reset_index()
topic_groups['demo_rate'] = topic_groups['demo_booked'] / topic_groups['total_contacts']
topic_groups['trial_rate'] = topic_groups['trial_activated'] / topic_groups['total_contacts']
topic_groups['won_rate'] = topic_groups['closed_won'] / topic_groups['total_contacts']
topic_groups.to_csv('conversion_by_topic.csv', index=False)
print(topic_groups.sort_values('total_contacts', ascending=False))

# Segment
segment_groups = funnel.groupby(['segment', 'responder_type']).agg(
    total_contacts=('contact_id', 'count'),
    demo_booked=('demo_booked', lambda x: x.notna().sum()),
    trial_activated=('trial_activated', lambda x: x.notna().sum()),
    closed_won=('closed_won', lambda x: x.notna().sum()),
).reset_index()
segment_groups['demo_rate'] = segment_groups['demo_booked'] / segment_groups['total_contacts']
segment_groups['trial_rate'] = segment_groups['trial_activated'] / segment_groups['total_contacts']
segment_groups['won_rate'] = segment_groups['closed_won'] / segment_groups['total_contacts']
segment_groups.to_csv('conversion_by_segment.csv', index=False)

# Region
region_groups = funnel.groupby(['region', 'responder_type']).agg(
    total_contacts=('contact_id', 'count'),
    demo_booked=('demo_booked', lambda x: x.notna().sum()),
    trial_activated=('trial_activated', lambda x: x.notna().sum()),
    closed_won=('closed_won', lambda x: x.notna().sum()),
).reset_index()
region_groups['demo_rate'] = region_groups['demo_booked'] / region_groups['total_contacts']
region_groups['trial_rate'] = region_groups['trial_activated'] / region_groups['total_contacts']
region_groups['won_rate'] = region_groups['closed_won'] / region_groups['total_contacts']
region_groups.to_csv('conversion_by_region.csv', index=False)

# Lifecycle
lifecycle_groups = funnel.groupby(['lifecycle', 'responder_type']).agg(
    total_contacts=('contact_id', 'count'),
    demo_booked=('demo_booked', lambda x: x.notna().sum()),
    trial_activated=('trial_activated', lambda x: x.notna().sum()),
    closed_won=('closed_won', lambda x: x.notna().sum()),
).reset_index()
lifecycle_groups['demo_rate'] = lifecycle_groups['demo_booked'] / lifecycle_groups['total_contacts']
lifecycle_groups['trial_rate'] = lifecycle_groups['trial_activated'] / lifecycle_groups['total_contacts']
lifecycle_groups['won_rate'] = lifecycle_groups['closed_won'] / lifecycle_groups['total_contacts']
lifecycle_groups.to_csv('conversion_by_lifecycle.csv', index=False)

print("All analysis saved.")
''')
