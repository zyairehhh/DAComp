import pandas as pd
import sqlite3
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-069.sqlite')

# Load geo market data
df_geo = pd.read_sql_query("SELECT * FROM google_play__geo_market_analysis WHERE package_name = 'com.dev.photoeditor'", conn)
print("Geo market data shape:", df_geo.shape)
print(df_geo[['country', 'region', 'average_revenue_per_user', 'app_quality_score', 'overall_market_score', 'day_1_retention_rate', 'daily_churn_rate', 'store_conversion_rate']])

# Define high and low ARPU groups
high_arpu = df_geo[df_geo['average_revenue_per_user'] >= 7]
low_arpu = df_geo[df_geo['average_revenue_per_user'] < 7]
print("\nHigh ARPU (>=7) countries:", high_arpu['country'].tolist())
print("Low ARPU (<7) countries:", low_arpu['country'].tolist())

# Compute mean metrics for each group
metrics = ['app_quality_score', 'overall_market_score', 'day_1_retention_rate', 'day_7_retention_rate', 'day_30_retention_rate', 'daily_churn_rate', 'store_conversion_rate', 'avg_daily_revenue', 'avg_transaction_value', 'revenue_last_30_days']
summary = pd.DataFrame({
    'High ARPU mean': high_arpu[metrics].mean(),
    'Low ARPU mean': low_arpu[metrics].mean(),
    'Difference': high_arpu[metrics].mean() - low_arpu[metrics].mean()
})
print("\nComparison of means:")
print(summary)

# Load comprehensive performance dashboard for time trends
df_perf = pd.read_sql_query("SELECT date_day, overall_performance_score, research_budget_usd, daily_net_revenue, daily_transactions, avg_transaction_value, average_revenue_per_user, daily_churn_rate, quality_score FROM google_play__comprehensive_performance_dashboard WHERE package_name = 'com.dev.photoeditor' ORDER BY date_day", conn)
print("\nPerformance dashboard rows:", df_perf.shape)
print(df_perf.head())

# Compute correlation between overall_performance_score and other metrics (excluding date)
numeric_cols = df_perf.select_dtypes(include=[np.number]).columns
corr = df_perf[numeric_cols].corr()['overall_performance_score'].sort_values(ascending=False)
print("\nCorrelation with overall_performance_score:")
print(corr)

# Load finance report monthly net revenue per region
df_fin = pd.read_sql_query("""
SELECT region, strftime('%Y-%m', date_day) AS month, SUM(net_amount) as total_net, AVG(net_amount) as avg_net, COUNT(DISTINCT country_short) as countries
FROM google_play__finance_report
WHERE package_name = 'com.dev.photoeditor'
GROUP BY region, month
ORDER BY region, month
""", conn)
print("\nFinance report aggregated shape:", df_fin.shape)
print(df_fin.head())

# Compute month-over-month growth rates per region
df_fin['prev_net'] = df_fin.groupby('region')['total_net'].shift(1)
df_fin['mom_growth'] = (df_fin['total_net'] - df_fin['prev_net']) / df_fin['prev_net']
print("\nMonth-over-month growth rates:")
print(df_fin[['region', 'month', 'total_net', 'mom_growth']].dropna())

conn.close()
```
