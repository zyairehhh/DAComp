import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-066/stage1_env/dacomp-066.sqlite')

# Join tables
query = """
SELECT 
    j.application_to_interview_rate as conv_rate,
    j.count_total_interviews,
    j.avg_interviews_per_application,
    j.hiring_managers,
    r.avg_process_days,
    r.performance_tier,
    r.avg_interview_score,
    r.hire_rate,
    r.interview_rate
FROM greenhouse__job_enhanced j
LEFT JOIN greenhouse__recruitment_performance r ON j.job_id = r.job_id
WHERE j.departments='Engineering';
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Clean missing values
df = df.dropna(subset=['conv_rate', 'count_total_interviews', 'avg_process_days', 'performance_tier'])

# Encode performance tier
tier_map = {'Low':0, 'Medium':1, 'High':2}
df['performance_tier_numeric'] = df['performance_tier'].map(tier_map)

# Create dummies for hiring managers (reference category David Thompson, lowest average)
df = pd.get_dummies(df, columns=['hiring_managers'], drop_first=True)

# Prepare X and y
features = ['count_total_interviews', 'avg_process_days', 'performance_tier_numeric']
X = df[features + [col for col in df.columns if col.startswith('hiring_managers_')]]
y = df['conv_rate']

# Add intercept
X = np.column_stack([np.ones(len(X)), X])
coeff, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
print("Regression coefficients (including intercept):")
print("Intercept:", coeff[0])
for i, col in enumerate(features + [col for col in df.columns if col.startswith('hiring_managers_')], start=1):
    print(f"{col}: {coeff[i]:.4f}")

# Interpret: effect of one additional total interview on conversion rate, holding other variables constant.
print("\nInterpretation:")
print(f"Each additional total interview is associated with {coeff[1]:.3f} percentage point increase in conversion rate, ceteris paribus.")
print(f"Each additional day in average process length is associated with {coeff[2]:.3f} percentage point change.")
print("Performance tier (each level) increases conversion rate by", coeff[3], "percentage points.")

# Compute R-squared
y_pred = X @ coeff
ss_res = np.sum((y - y_pred) ** 2)
ss_tot = np.sum((y - np.mean(y)) ** 2)
r_squared = 1 - (ss_res / ss_tot)
print(f"\nR-squared: {r_squared:.3f}")

# Impact of hiring managers relative to baseline (David Thompson)
print("\nImpact of hiring managers relative to David Thompson:")
for i, col in enumerate([col for col in df.columns if col.startswith('hiring_managers_')], start=len(features)+1):
    print(f"{col}: {coeff[i]:.3f} percentage points difference")

# Also compute simple correlation between conversion rate and avg_interviews_per_application
corr = np.corrcoef(df['conv_rate'], df['avg_interviews_per_application'])[0,1]
print(f"\nCorrelation between conversion rate and avg interviews per application: {corr:.3f}")
''')
