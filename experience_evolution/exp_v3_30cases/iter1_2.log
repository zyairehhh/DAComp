Action: CreateFile(filepath="analyze.py"):
```
import sqlite3
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.formula.api import ols
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-070.sqlite')

# Load data
ts = pd.read_sql_query("SELECT * FROM google_play__time_series_trends", conn)
country = pd.read_sql_query("SELECT * FROM google_play__country_report", conn)
device = pd.read_sql_query("SELECT * FROM google_play__device_report", conn)

# Convert date columns
ts['date_day'] = pd.to_datetime(ts['date_day'])
country['date_day'] = pd.to_datetime(country['date_day'])
device['date_day'] = pd.to_datetime(device['date_day'])

# Check date range
print("Time range:", ts['date_day'].min(), ts['date_day'].max())

# Compute region-level conversion rate (average across countries per region per date per package)
region_conv = country.groupby(['date_day', 'region', 'package_name'])['store_listing_conversion_rate'].mean().reset_index()

# Compute device brand
device['device_brand'] = device['device'].apply(lambda x: x.split()[0] if isinstance(x, str) else x)
device_brand_conv = device.groupby(['date_day', 'device_brand', 'package_name']).agg(
    install_events_sum=('install_events', 'sum'),
    store_visitors_sum=('install_events', 'sum')  # Note: we don't have store visitors in device_report; need alternative?
).reset_index()
# Device report lacks store_listing_conversion_rate; we cannot compute conversion at device level.
# However we have active_devices_last_30_days and update_events.
# The conversion rate is only in country_report.
# Let's examine device_report columns: no conversion metric.
# So we cannot analyze device conversion rate directly.

# But we can analyze effect of device on active_devices and rating, and update frequency.
# Let's compute device-level update frequency (update_events per day per device)
# For now, focus on region conversion rate.

# Merge with quality_score and crash_rate from time_series
merged = region_conv.merge(ts[['date_day', 'package_name', 'quality_score', 'crash_rate_per_1k', 'revenue_per_active_device', 'daily_installs', 'daily_revenue']], 
                           on=['date_day', 'package_name'], how='left')

# Compute revenue per install (RPI) as efficiency metric
merged['revenue_per_install'] = merged['daily_revenue'] / merged['daily_installs'].replace(0, np.nan)

# Add month offset (days since start)
merged['days_since_start'] = (merged['date_day'] - merged['date_day'].min()).dt.days

print("Region conversion head:")
print(merged.head())
print("\nUnique regions:", merged['region'].unique())

# 1. Analyze decay patterns of conversion rate over time per region and package
# Fit linear trend for each region-package combination
decay_results = []
for region in merged['region'].unique():
    for pkg in merged['package_name'].unique():
        subset = merged[(merged['region'] == region) & (merged['package_name'] == pkg)]
        if len(subset) < 10:
            continue
        # Linear regression of conversion_rate vs days_since_start
        X = sm.add_constant(subset['days_since_start'])
        y = subset['store_listing_conversion_rate']
        model = sm.OLS(y, X).fit()
        decay_rate = model.params['days_since_start']
        decay_p = model.pvalues['days_since_start']
        decay_results.append({
            'region': region,
            'package': pkg,
            'decay_rate': decay_rate,
            'p_value': decay_p,
            'r_squared': model.rsquared,
            'start_conv': subset['store_listing_conversion_rate'].iloc[0],
            'end_conv': subset['store_listing_conversion_rate'].iloc[-1]
        })

decay_df = pd.DataFrame(decay_results)
print("\nDecay patterns (conversion rate over time):")
print(decay_df.sort_values('decay_rate').head(20))

# 2. Non-linear relationship between store_listing_conversion_rate and quality_score / crash_rate
# Use polynomial regression or log transformation
merged['quality_score_sq'] = merged['quality_score'] ** 2
merged['crash_rate_sq'] = merged['crash_rate_per_1k'] ** 2
merged['log_crash'] = np.log1p(merged['crash_rate_per_1k'])
merged['log_quality'] = np.log1p(merged['quality_score'])

# Fit model with interaction
formula = 'store_listing_conversion_rate ~ quality_score + crash_rate_per_1k + quality_score:crash_rate_per_1k'
model1 = ols(formula, data=merged).fit()
print("\nLinear interaction model for conversion rate:")
print(model1.summary())

# Non-linear model with squared terms
formula2 = 'store_listing_conversion_rate ~ quality_score + crash_rate_per_1k + quality_score_sq + crash_rate_sq'
model2 = ols(formula2, data=merged).fit()
print("\nNon-linear (quadratic) model for conversion rate:")
print(model2.summary())

# 3. Multi-dimensional user value decay model: predict revenue_per_active_device
# Use features: conversion_rate, quality_score, crash_rate, region, days_since_start
# We'll create a simple regression model
merged['region_code'] = pd.Categorical(merged['region']).codes
X_val = merged[['store_listing_conversion_rate', 'quality_score', 'crash_rate_per_1k', 'days_since_start', 'region_code']]
X_val = sm.add_constant(X_val)
y_val = merged['revenue_per_active_device']
model_val = sm.OLS(y_val.dropna(), X_val.loc[y_val.dropna().index]).fit()
print("\nUser value decay model (revenue per active device):")
print(model_val.summary())

# 4. Interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating
# Need update frequency: number of update_events per time period.
# We can compute at package-date level from device_report? Actually update_events per device per date.
# Compute daily total update events per package
update_freq = device.groupby(['date_day', 'package_name'])['update_events'].sum().reset_index()
update_freq.rename(columns={'update_events': 'total_update_events'}, inplace=True)
# Merge with country_report for active_devices_last_30_days and rolling_total_average_rating
# country_report has those per country; we need per region average?
# Let's aggregate country_report by date, package, region
country_agg = country.groupby(['date_day', 'package_name', 'region']).agg({
    'active_devices_last_30_days': 'sum',
    'rolling_total_average_rating': 'mean'
}).reset_index()
# Merge with update_freq
merged_update = country_agg.merge(update_freq, on=['date_day', 'package_name'], how='left')
# Compute update frequency per active device (intensity)
