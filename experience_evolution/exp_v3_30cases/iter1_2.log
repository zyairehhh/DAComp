Action: EditFile(filepath='profitability_tier_analysis.py':
'''
import sqlite3
import pandas as pd

conn = sqlite3.connect("dacomp-090.sqlite")

# Get high-risk customers with tier counts via subquery
query = """
WITH high_risk AS (
    SELECT customer_id
    FROM quickbooks__customer_analytics
    WHERE payment_rate_percentage < 75.0 AND outstanding_balance > 15000
)
SELECT 
    p.customer_id,
    p.profitability_tier,
    COUNT(*) as invoice_count
FROM quickbooks__profitability_analysis p
INNER JOIN high_risk h ON p.customer_id = h.customer_id
GROUP BY p.customer_id, p.profitability_tier
"""
profit_df = pd.read_sql_query(query, conn)

# For each customer, find the most frequent profitability tier
mode_tier = profit_df.loc[profit_df.groupby('customer_id')['invoice_count'].idxmax()]
tier_counts = mode_tier['profitability_tier'].value_counts()
print("High-risk customers modal profitability tier distribution:")
print(tier_counts)
print("\nProportions:")
print(tier_counts / tier_counts.sum())

# For normal customers
query2 = """
WITH normal AS (
    SELECT customer_id
    FROM quickbooks__customer_analytics
    WHERE NOT (payment_rate_percentage < 75.0 AND outstanding_balance > 15000)
)
SELECT 
    p.customer_id,
    p.profitability_tier,
    COUNT(*) as invoice_count
FROM quickbooks__profitability_analysis p
INNER JOIN normal n ON p.customer_id = n.customer_id
GROUP BY p.customer_id, p.profitability_tier
"""
profit_df2 = pd.read_sql_query(query2, conn)
mode_tier2 = profit_df2.loc[profit_df2.groupby('customer_id')['invoice_count'].idxmax()]
tier_counts2 = mode_tier2['profitability_tier'].value_counts()
print("\nNormal customers modal profitability tier distribution:")
print(tier_counts2)
print("\nProportions:")
print(tier_counts2 / tier_counts2.sum())
''')
