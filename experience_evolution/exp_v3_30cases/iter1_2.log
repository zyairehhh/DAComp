print("Monthly profit margins for Home & Furniture:")
print(df.head(20))
print(f"\nNumber of months: {len(df)}")
print(f"Mean margin: {df['profit_margin'].mean():.6f}")
print(f"Std margin: {df['profit_margin'].std():.6f}")
print(f"Min margin: {df['profit_margin'].min():.6f} in {df.loc[df['profit_margin'].idxmin(), 'month']}")
print(f"Max margin: {df['profit_margin'].max():.6f} in {df.loc[df['profit_margin'].idxmax(), 'month']}")

# Plot or compute month-over-month change
df['margin_change'] = df['profit_margin'].diff()
print("\nLargest month-over-month absolute changes:")
df['abs_change'] = df['margin_change'].abs()
print(df.sort_values('abs_change', ascending=False).head(10))

# Check if any missing months? Probably not.
```

