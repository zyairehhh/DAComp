```
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')

df = pd.read_sql_query("SELECT account_id, sum_minutes, sum_events, last_event_on, avg_nps_rating, count_active_days, count_active_months, count_feature_clicking_visitors, count_page_viewing_visitors FROM pendo__account", conn)
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
cutoff = pd.to_datetime('2024-09-01')
df['still_active'] = df['last_event_on'] >= cutoff  # true label: retained

# Existing model: high-value if sum_minutes > median and sum_events > median
med_minutes = df['sum_minutes'].median()
med_events = df['sum_events'].median()
df['existing_pred'] = (df['sum_minutes'] > med_minutes) & (df['sum_events'] > med_events)

# Compute accuracy
def accuracy(y_true, y_pred):
    return np.mean(y_true == y_pred)

acc = accuracy(df['still_active'], df['existing_pred'])
print("Accuracy of existing model (duration+frequency) vs retention as high-value:", acc)

# Confusion matrix
def confusion_matrix(y_true, y_pred):
    tp = np.sum((y_true == True) & (y_pred == True))
    tn = np.sum((y_true == False) & (y_pred == False))
    fp = np.sum((y_true == False) & (y_pred == True))
    fn = np.sum((y_true == True) & (y_pred == False))
    return tp, tn, fp, fn

tp, tn, fp, fn = confusion_matrix(df['still_active'], df['existing_pred'])
print("Confusion matrix: TP={}, TN={}, FP={}, FN={}".format(tp, tn, fp, fn))
if tp+fp > 0:
    precision = tp / (tp + fp)
else:
    precision = 0
if tp+fn > 0:
    recall = tp / (tp + fn)
else:
    recall = 0
print(f"Precision: {precision:.3f}, Recall: {recall:.3f}")

# Try multi-dimensional scoring: normalize features and assign weights
features = df[['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors']].fillna(0)
# Min-max scaling using numpy
min_vals = features.min()
max_vals = features.max()
range_vals = max_vals - min_vals
range_vals[range_vals == 0] = 1  # avoid division by zero
scaled = (features - min_vals) / range_vals

# Weighted sum
weights = np.array([0.25, 0.25, 0.2, 0.15, 0.15])
df['score'] = np.dot(scaled, weights)

# Find threshold that maximizes accuracy
thresholds = np.linspace(0, 1, 101)
best_acc = 0
best_th = 0
for th in thresholds:
    pred = df['score'] > th
    acc_t = accuracy(df['still_active'], pred)
    if acc_t > best_acc:
        best_acc = acc_t
        best_th = th

print(f"Multi-dimensional score (5 features) best threshold: {best_th:.3f}, Accuracy: {best_acc:.3f}")

# Compare with only duration and frequency (two features)
scaled2 = scaled[['sum_minutes', 'sum_events']]
weights2 = np.array([0.5, 0.5])
df['score2'] = np.dot(scaled2, weights2)
best_acc2 = 0
best_th2 = 0
for th in thresholds:
    pred = df['score2'] > th
    acc_t = accuracy(df['still_active'], pred)
    if acc_t > best_acc2:
        best_acc2 = acc_t
        best_th2 = th
print(f"Two-feature (duration+frequency) best threshold: {best_th2:.3f}, Accuracy: {best_acc2:.3f}")

# See if we can improve by adding NPS alone
scaled3 = scaled[['sum_minutes', 'sum_events', 'avg_nps_rating']]
weights3 = np.array([0.4, 0.4, 0.2])
df['score3'] = np.dot(scaled3, weights3)
best_acc3 = 0
best_th3 = 0
for th in thresholds:
    pred = df['score3'] > th
    acc_t = accuracy(df['still_active'], pred)
    if acc_t > best_acc3:
        best_acc3 = acc_t
        best_th3 = th
print(f"Three-feature (add NPS) best threshold: {best_th3:.3f}, Accuracy: {best_acc3:.3f}")

# Check which accounts are identified differently
optimal_pred = df['score'] > best_th
existing_pred = df['existing_pred']
diff = df[optimal_pred != existing_pred]
print(f"{len(diff)} accounts have different classification between existing and multi-dimensional model.")

conn.close()
```
