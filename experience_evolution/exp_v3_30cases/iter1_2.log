'''
import pandas as pd
import sqlite3
import matplotlib.pyplot as plt
import numpy as np

# Load data
conn = sqlite3.connect('dacomp-017.sqlite')
df = pd.read_sql_query("SELECT * FROM order_information", conn)
df['Sales'] = pd.to_numeric(df['Sales'], errors='coerce')
df['profit'] = pd.to_numeric(df['profit'], errors='coerce')
df['Discount'] = pd.to_numeric(df['Discount'].astype(str).str.rstrip('%'), errors='coerce')
df['Shipping Cost'] = pd.to_numeric(df['Shipping Cost'].astype(str).str.replace(',', ''), errors='coerce')
df['Order Date'] = pd.to_datetime(df['Order Date'])

# Filter Home & Furniture
home = df[df['Product Category'] == 'Home & Furniture'].copy()
home['month'] = home['Order Date'].dt.to_period('M')

# Monthly aggregates
monthly = home.groupby('month').agg(
    total_sales=('Sales', 'sum'),
    total_profit=('profit', 'sum'),
    avg_shipping=('Shipping Cost', 'mean'),
    avg_discount=('Discount', 'mean')
).reset_index()
monthly['margin'] = monthly['total_profit'] / monthly['total_sales'] * 100
monthly['month_date'] = monthly['month'].dt.to_timestamp()

# Compute correlations
corr_ship = np.corrcoef(monthly['margin'], monthly['avg_shipping'])[0,1]
corr_disc = np.corrcoef(monthly['margin'], monthly['avg_discount'])[0,1]
print(f'Correlation with shipping cost: {corr_ship:.3f}')
print(f'Correlation with discount: {corr_disc:.3f}')

# Plot margin vs shipping cost
plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
plt.scatter(monthly['avg_shipping'], monthly['margin'], alpha=0.7)
z = np.polyfit(monthly['avg_shipping'], monthly['margin'], 1)
p = np.poly1d(z)
plt.plot(monthly['avg_shipping'], p(monthly['avg_shipping']), 'r--')
plt.xlabel('Average Shipping Cost (per order)')
plt.ylabel('Profit Margin (%)')
plt.title(f'Home & Furniture: Margin vs Shipping Cost\n(correlation = {corr_ship:.3f})')
plt.grid(True, alpha=0.3)

# Plot margin vs discount
plt.subplot(1,2,2)
plt.scatter(monthly['avg_discount'], monthly['margin'], alpha=0.7)
z = np.polyfit(monthly['avg_discount'], monthly['margin'], 1)
p = np.poly1d(z)
plt.plot(monthly['avg_discount'], p(monthly['avg_discount']), 'r--')
plt.xlabel('Average Discount (%)')
plt.ylabel('Profit Margin (%)')
plt.title(f'Home & Furniture: Margin vs Discount\n(correlation = {corr_disc:.3f})')
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('drivers_scatter.png', dpi=300, bbox_inches='tight')
plt.close()

print('Generated drivers_scatter.png')
''')
