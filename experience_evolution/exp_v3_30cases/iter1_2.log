import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Connect to the database
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Get data for high-volatility customers (top 25%)
profitability_query = """
SELECT 
  pa.customer_id,
  pa.customer_margin_volatility,
  pa.gross_profit,
  pa.invoice_total,
  pa.customer_total_revenue,
  pa.customer_total_profit,
  pa.customer_gross_margin_pct,
  pa.customer_profit_growth_pct,
  ca.rfm_segment,
  ca.payment_behavior,
  ca.revenue_trend_correlation,
  ca.lifecycle_stage,
  ca.customer_value_segment,
  ca.overall_customer_score
FROM quickbooks__profitability_analysis pa
LEFT JOIN quickbooks__customer_analytics ca ON pa.customer_id = ca.customer_id
"""

df = pd.read_sql_query(profitability_query, conn)

# Calculate 75th percentile threshold
threshold = df['customer_margin_volatility'].quantile(0.75)
high_volatility_df = df[df['customer_margin_volatility'] >= threshold].copy()
low_volatility_df = df[df['customer_margin_volatility'] < threshold].copy()

print(f"Total customers: {len(df)}")
print(f"High-volatility customers (≥ {threshold:.4f}): {len(high_volatility_df)}")
print(f"Low-volatility customers (< {threshold:.4f}): {len(low_volatility_df)}")

# 2. Calculate coefficient of variation (CV) for gross_profit
# Avoid division by zero by using absolute mean
high_volatility_mean = high_volatility_df['gross_profit'].mean()
low_volatility_mean = low_volatility_df['gross_profit'].mean()

cv_high_vol = high_volatility_df['gross_profit'].std() / abs(high_volatility_mean) if high_volatility_mean != 0 else np.nan
cv_low_vol = low_volatility_df['gross_profit'].std() / abs(low_volatility_mean) if low_volatility_mean != 0 else np.nan

print(f"\nCoefficient of Variation (CV) for Gross Profit:")
print(f"  High-volatility customers: {cv_high_vol:.4f}")
print(f"  Low-volatility customers: {cv_low_vol:.4f}")

# For quarterly growth rate variance, we need to get time-series data
# First, let's get invoice data with timestamps
quarterly_query = """
SELECT 
  customer_id,
  customer_margin_volatility,
  invoice_total,
  revenue_quarter,
  revenue_year
FROM quickbooks__profitability_analysis
ORDER BY customer_id, revenue_year, revenue_quarter
"""

quarterly_df = pd.read_sql_query(quarterly_query, conn)

# Calculate quarterly growth rates per customer
customer_growth_rates = []
for customer_id, group in quarterly_df.groupby('customer_id'):
    group = group.sort_values(['revenue_year', 'revenue_quarter'])
    group['quarterly_growth'] = group['invoice_total'].pct_change()
    if len(group) > 1 and group['quarterly_growth'].var() > 0:  # Only include customers with variance
        growth_variance = group['quarterly_growth'].var()
        customer_growth_rates.append({
            'customer_id': customer_id,
            'growth_variance': growth_variance,
            'margin_volatility': group['customer_margin_volatility'].iloc[0]  # Same for all rows
        })

if customer_growth_rates:
    growth_df = pd.DataFrame(customer_growth_rates)
    growth_threshold = quarterly_df['customer_margin_volatility'].quantile(0.75)
    high_vol_growth = growth_df[growth_df['margin_volatility'] >= growth_threshold]
    low_vol_growth = growth_df[growth_df['margin_volatility'] < growth_threshold]
    
    print(f"\nQuarterly Invoice Growth Variance:")
    print(f"  High-volatility customers: {high_vol_growth['growth_variance'].mean():.6f}")
    print(f"  Low-volatility customers: {low_vol_growth['growth_variance'].mean():.6f}")
    
    # Store for visualization
    high_vol_growth_var = high_vol_growth['growth_variance'].mean()
    low_vol_growth_var = low_vol_growth['growth_variance'].mean()
else:
    print("\nNo valid growth variance data available")
    high_vol_growth_var = 0
    low_vol_growth_var = 0

# 3. Analyze relationship with customer lifecycle stages
print(f"\nLifecycle Stage Distribution for High-Volatility Customers:")
lifecycle_counts = high_volatility_df['lifecycle_stage'].value_counts()
print(lifecycle_counts)

# 4. Analyze relationship with payment behavior
print(f"\nPayment Behavior for High-Volatility Customers:")
payment_counts = high_volatility_df['payment_behavior'].value_counts()
print(payment_counts)

# 5. Analyze relationship with RFM segments
print(f"\nRFM Segment Distribution for High-Volatility Customers:")
rfm_counts = high_volatility_df['rfm_segment'].value_counts()
print(rfm_counts)

# Create visualizations
plt.style.use('default')
fig, axes = plt.subplots(2, 3, figsize=(18, 12))

# Plot 1: Distribution of coefficient of variation by volatility group
ax1 = axes[0, 0]
cv_data = pd.DataFrame({
    'Group': ['High Volatility', 'Low Volatility'],
    'CV_Gross_Profit': [cv_high_vol, cv_low_vol]
})
ax1.bar(cv_data['Group'], cv_data['CV_Gross_Profit'], color=['red', 'blue'], alpha=0.7)
ax1.set_title('Coefficient of Variation: Gross Profit')
ax1.set_ylabel('CV (Std/Mean)')
ax1.grid(True, alpha=0.3)

# Plot 2: Growth variance comparison
ax2 = axes[0, 1]
if high_vol_growth_var > 0 and low_vol_growth_var > 0:
    growth_data = pd.DataFrame({
        'Group': ['High Volatility', 'Low Volatility'],
        'Growth_Variance': [high_vol_growth_var, low_vol_growth_var]
    })
    ax2.bar(growth_data['Group'], growth_data['Growth_Variance'], color=['red', 'blue'], alpha=0.7)
    ax2.set_title('Average Quarterly Growth Variance')
    ax2.set_ylabel('Variance')
else:
    ax2.text(0.5, 0.5, 'Insufficient growth variance data', 
             ha='center', va='center', transform=ax2.transAxes)
    ax2.set_title('Average Quarterly Growth Variance')
ax2.grid(True, alpha=0.3)

# Plot 3: Lifecycle stage distribution
ax3 = axes[0, 2]
if len(lifecycle_counts) > 0:
    lifecycle_counts.plot(kind='bar', ax=ax3, color='coral', alpha=0.7)
    ax3.set_title('High-Volatility Customers by Lifecycle Stage')
    ax3.set_xlabel('Lifecycle Stage')
    ax3.set_ylabel('Count')
else:
    ax3.text(0.5, 0.5, 'No lifecycle stage data', 
             ha='center', va='center', transform=ax3.transAxes)
    ax3.set_title('High-Volatility Customers by Lifecycle Stage')
ax3.tick_params(axis='x', rotation=45)
ax3.grid(True, alpha=0.3)

# Plot 4: Payment behavior distribution
ax4 = axes[1, 0]
if len(payment_counts) > 0:
    payment_counts.plot(kind='bar', ax=ax4, color='lightgreen', alpha=0.7)
    ax4.set_title('High-Volatility Customers by Payment Behavior')
    ax4.set_xlabel('Payment Behavior')
    ax4.set_ylabel('Count')
else:
    ax4.text(0.5, 0.5, 'No payment behavior data', 
             ha='center', va='center', transform=ax4.transAxes)
    ax4.set_title('High-Volatility Customers by Payment Behavior')
ax4.tick_params(axis='x', rotation=45)
ax4.grid(True, alpha=0.3)

# Plot 5: RFM segment distribution (top 10)
ax5 = axes[1, 1]
if len(rfm_counts) > 0:
    top_rfm = rfm_counts.head(10)  # Top 10 segments
    top_rfm.plot(kind='bar', ax=ax5, color='skyblue', alpha=0.7)
    ax5.set_title('Top 10 RFM Segments (High-Volatility)')
    ax5.set_xlabel('RFM Segment')
    ax5.set_ylabel('Count')
else:
    ax5.text(0.5, 0.5, 'No RFM segment data', 
             ha='center', va='center', transform=ax5.transAxes)
    ax5.set_title('Top 10 RFM Segments (High-Volatility)')
ax5.tick_params(axis='x', rotation=45)
ax5.grid(True, alpha=0.3)

# Plot 6: Revenue trend correlation vs customer margin volatility
ax6 = axes[1, 2]
if 'revenue_trend_correlation' in high_volatility_df.columns and len(high_volatility_df) > 0:
    scatter = ax6.scatter(high_volatility_df['customer_margin_volatility'], 
                           high_volatility_df['revenue_trend_correlation'], 
                           alpha=0.6, s=30, c='red')
    ax6.set_xlabel('Customer Margin Volatility')
    ax6.set_ylabel('Revenue Trend Correlation')
    ax6.set_title('Volatility vs Revenue Trend Correlation')
    
    # Add correlation coefficient if we have enough data
    if len(high_volatility_df) > 1:
        corr = high_volatility_df['customer_margin_volatility'].corr(high_volatility_df['revenue_trend_correlation'])
        ax6.text(0.05, 0.95, f'Correlation: {corr:.3f}', transform=ax6.transAxes, 
                 fontsize=10, verticalalignment='top', 
