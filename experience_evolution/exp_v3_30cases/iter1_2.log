import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib

conn = sqlite3.connect('dacomp-090.sqlite')

# Get high-risk customer IDs
high_risk_ids_query = """
SELECT customer_id 
FROM quickbooks__customer_analytics 
WHERE payment_rate_percentage < 75 AND outstanding_balance > 15000;
"""
high_risk_ids = pd.read_sql_query(high_risk_ids_query, conn)
high_risk_ids = high_risk_ids['customer_id'].tolist()

# Get profitability tier distribution for high-risk customers
if len(high_risk_ids) == 0:
    # fallback
    profit_counts = pd.Series(dtype=int)
else:
    placeholders = ','.join(['?'] * len(high_risk_ids))
    profit_query = f"""
    SELECT p.customer_id, p.profitability_tier
    FROM quickbooks__profitability_analysis p
    WHERE p.customer_id IN ({placeholders})
    """
    profit_df = pd.read_sql_query(profit_query, conn, params=high_risk_ids)
    profit_counts = profit_df['profitability_tier'].value_counts().sort_index()

plt.figure(figsize=(7, 5))
profit_counts.plot(kind='bar', color='teal', edgecolor='black')
plt.xlabel('Profitability Tier')
plt.ylabel('Number of High-Risk Customers')
plt.title('High-Risk Customers by Profitability Tier')
plt.grid(axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('profitability_tier_distribution.png', dpi=300)
plt.close()

# Also get overall profitability tier distribution (all customers) for comparison
all_profit_query = "SELECT profitability_tier FROM quickbooks__profitability_analysis;"
all_profit_df = pd.read_sql_query(all_profit_query, conn)
all_counts = all_profit_df['profitability_tier'].value_counts().sort_index()

# Align both series
all_tiers = all_counts.index.tolist()
profit_counts_aligned = profit_counts.reindex(all_tiers, fill_value=0)

# Normalize
all_percent = all_counts / all_counts.sum() * 100
profit_percent = profit_counts_aligned / profit_counts_aligned.sum() * 100

fig, ax = plt.subplots(figsize=(9, 5))
x = range(len(all_tiers))
width = 0.35
ax.bar([i - width/2 for i in x], all_percent, width, label='All Customers', color='skyblue', edgecolor='black')
ax.bar([i + width/2 for i in x], profit_percent, width, label='High-Risk Customers', color='salmon', edgecolor='black')
ax.set_xlabel('Profitability Tier')
ax.set_ylabel('Percentage (%)')
ax.set_title('Profitability Tier Distribution: All vs High-Risk Customers')
ax.set_xticks(x)
ax.set_xticklabels(all_tiers, rotation=45)
ax.grid(axis='y', alpha=0.3)
ax.legend()
plt.tight_layout()
plt.savefig('profitability_tier_comparison.png', dpi=300)
plt.close()

conn.close()
print("Extra plots generated.")
```

