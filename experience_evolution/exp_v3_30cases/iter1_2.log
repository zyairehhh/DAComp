import sqlite3
import pandas as pd
import numpy as np
import json

conn = sqlite3.connect('dacomp-018.sqlite')

# Compute total profit per customer for Fashion
query = '''
SELECT 
    o."Customer ID",
    SUM(o.profit) AS total_profit,
    COUNT(*) AS order_count,
    AVG(o.profit) AS avg_profit_per_order,
    SUM(o.Quantity) AS total_quantity,
    SUM(o.Sales) AS total_sales
FROM order_information o
WHERE o."Product Category" = 'Fashion'
GROUP BY o."Customer ID"
'''
profit_df = pd.read_sql_query(query, conn)
print(f"Total customers in Fashion: {profit_df.shape[0]}")
print(profit_df.head())

# Join with customer_information
cust_query = '''
SELECT DISTINCT "Customer ID", "Customer Segment", "City", "State / Province", 
       "Country", "Region", "gender", "age", "Education Level", "Marital Status"
FROM customer_information
'''
cust_df = pd.read_sql_query(cust_query, conn)
full_df = profit_df.merge(cust_df, on='Customer ID', how='left')
print(full_df.head())

# Identify top 20% profitable customers (80th percentile of total_profit)
threshold = full_df['total_profit'].quantile(0.8)
high_profit = full_df[full_df['total_profit'] >= threshold]
print(f"High-profit customers (top 20%): {high_profit.shape[0]}")
print(high_profit.head())

# Analyze demographics of high-profit customers
print("\n=== High-profit customer profile ===")
print("Customer Segment distribution:")
print(high_profit['Customer Segment'].value_counts(normalize=True))
print("\nRegion distribution:")
print(high_profit['Region'].value_counts(normalize=True))
print("\nGender distribution:")
print(high_profit['gender'].value_counts(normalize=True))
print("\nEducation Level distribution:")
print(high_profit['Education Level'].value_counts(normalize=True))
print("\nMarital Status distribution:")
print(high_profit['Marital Status'].value_counts(normalize=True))
print("\nAge statistics:")
print(high_profit['age'].describe())

# Compare with overall Fashion customer demographics
print("\n=== Overall Fashion customer profile (all) ===")
print("Customer Segment distribution:")
print(full_df['Customer Segment'].value_counts(normalize=True))
print("\nRegion distribution:")
print(full_df['Region'].value_counts(normalize=True))
print("\nGender distribution:")
print(full_df['gender'].value_counts(normalize=True))
print("\nEducation Level distribution:")
print(full_df['Education Level'].value_counts(normalize=True))
print("\nMarital Status distribution:")
print(full_df['Marital Status'].value_counts(normalize=True))
print("\nAge statistics:")
print(full_df['age'].describe())

# Analyze browsing behavior for high-profit customers
browse_query = '''
SELECT pb."Customer ID", 
       SUM(pb."Browsing Time (minutes)") as total_browse_time,
       SUM(pb.like) as total_likes,
       SUM(pb.share) as total_shares,
       SUM(pb."Add to Cart") as total_add_to_cart
FROM product_browsing pb
WHERE pb."Product Category" = 'Fashion'
GROUP BY pb."Customer ID"
'''
browse_df = pd.read_sql_query(browse_query, conn)
full_df = full_df.merge(browse_df, on='Customer ID', how='left')
full_df['total_browse_time'] = full_df['total_browse_time'].fillna(0)
full_df['total_likes'] = full_df['total_likes'].fillna(0)
full_df['total_shares'] = full_df['total_shares'].fillna(0)
full_df['total_add_to_cart'] = full_df['total_add_to_cart'].fillna(0)

# Compare browsing metrics between high-profit and others
