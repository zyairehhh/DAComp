    if pd.isna(history):
        return None
    # pattern: FY22:+9%;FY23:+11%
    matches = re.findall(r'([+-]?\d+)%', history)
    if matches:
        changes = [int(m) for m in matches]
        return changes[-1]  # latest year change
    else:
        return None

df['latest_renewal_change'] = df['renewal_history'].apply(parse_renewal_history)
print(df['latest_renewal_change'].describe())
print(df['latest_renewal_change'].value_counts().head())
