level_order = sorted(df['Disaster Level'].unique())

# Calculate medians for each disaster level
impact_data = []
for level in level_order:
    level_data = []
    for metric in impact_metrics:
        level_data.append(df[df['Disaster Level'] == level][metric].median())
    impact_data.append(level_data)

impact_data = np.array(impact_data)
x = np.arange(len(level_order))
width = 0.8

bottom = np.zeros(len(level_order))
