import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Connect to the database
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Analyze accounts receivable structure from balance sheet
balance_sheet_query = """
SELECT 
  account_class,
  account_type,
  account_sub_type,
  account_name,
  amount
FROM quickbooks__balance_sheet 
WHERE account_class = 'Accounts Receivable' 
   OR account_sub_type LIKE '%Receivable%'
   OR account_name LIKE '%Receivable%'
ORDER BY account_class, account_type, account_sub_type
"""

ar_df = pd.read_sql_query(balance_sheet_query, conn)

print("Accounts Receivable Analysis:")
print(f"Total accounts receivable records: {len(ar_df)}")
if len(ar_df) > 0:
    print(f"Total AR amount: ${ar_df['amount'].sum():,.2f}")
    print(f"Average AR amount: ${ar_df['amount'].mean():,.2f}")
    
    # Group by account type
    ar_by_type = ar_df.groupby('account_type')['amount'].sum().reset_index()
    print("\nAR by Account Type:")
    print(ar_by_type)
    
    # Group by account sub-type
    ar_by_subtype = ar_df.groupby('account_sub_type')['amount'].sum().reset_index()
    print("\nAR by Account Sub-Type:")
    print(ar_by_subtype)

# 2. Analyze high-volatility customer contributions to collection rate
# Get high-volatility customers
threshold_query = """
SELECT DISTINCT customer_id, customer_margin_volatility 
FROM quickbooks__profitability_analysis
"""
threshold_df = pd.read_sql_query(threshold_query, conn)
threshold = threshold_df['customer_margin_volatility'].quantile(0.75)
high_vol_customers = threshold_df[threshold_df['customer_margin_volatility'] >= threshold]['customer_id'].tolist()

# Get collection data for high-volatility vs low-volatility customers
collection_query = """
SELECT 
  pa.customer_id,
  pa.customer_margin_volatility,
  pa.invoice_total,
  pa.collected_amount,
  (pa.collected_amount / NULLIF(pa.invoice_total, 0)) * 100 as collection_rate,
  fd.collection_rate_percentage as overall_collection_rate
FROM quickbooks__profitability_analysis pa
CROSS JOIN (
  SELECT AVG(collection_rate_percentage) as collection_rate_percentage
  FROM quickbooks__financial_dashboard
) fd
"""

collection_df = pd.read_sql_query(collection_query, conn)
collection_df['is_high_vol'] = collection_df['customer_margin_volatility'] >= threshold

# Calculate collection rates
high_vol_collection = collection_df[collection_df['is_high_vol'] == True]
low_vol_collection = collection_df[collection_df['is_high_vol'] == False]

if len(high_vol_collection) > 0 and len(low_vol_collection) > 0:
    high_vol_avg_rate = high_vol_collection['collection_rate'].mean()
    low_vol_avg_rate = low_vol_collection['collection_rate'].mean()
    overall_rate = collection_df['overall_collection_rate'].iloc[0]
    
    print(f"\nCollection Rate Analysis:")
    print(f"High-volatility customers avg collection rate: {high_vol_avg_rate:.2f}%")
    print(f"Low-volatility customers avg collection rate: {low_vol_avg_rate:.2f}%")
    print(f"Overall collection rate (dashboard): {overall_rate:.2f}%")
    print(f"Difference: {high_vol_avg_rate - low_vol_avg_rate:.2f}%")
    
    # Calculate contribution to overall collection issues
    high_vol_total_invoice = high_vol_collection['invoice_total'].sum()
    low_vol_total_invoice = low_vol_collection['invoice_total'].sum()
    total_invoice = collection_df['invoice_total'].sum()
    
    high_vol_uncollected = (high_vol_collection['invoice_total'] - high_vol_collection['collected_amount']).sum()
    low_vol_uncollected = (low_vol_collection['invoice_total'] - low_vol_collection['collected_amount']).sum()
    total_uncollected = high_vol_uncollected + low_vol_uncollected
    
    print(f"\nUncollected Amounts:")
    print(f"High-volatility customers: ${high_vol_uncollected:,.2f} ({high_vol_uncollected/total_uncollected*100:.1f}% of total)")
    print(f"Low-volatility customers: ${low_vol_uncollected:,.2f} ({low_vol_uncollected/total_uncollected*100:.1f}% of total)")

# Create visualizations
plt.style.use('default')
fig, axes = plt.subplots(2, 2, figsize=(14, 12))

# Plot 1: Accounts receivable distribution (if available)
ax1 = axes[0, 0]
if len(ar_df) > 0:
    ar_by_type = ar_df.groupby('account_type')['amount'].sum()
    if len(ar_by_type) > 0:
        ar_by_type.plot(kind='bar', ax=ax1, color='steelblue', alpha=0.7)
        ax1.set_title('Accounts Receivable by Account Type')
        ax1.set_xlabel('Account Type')
        ax1.set_ylabel('Amount ($)')
        ax1.tick_params(axis='x', rotation=45)
        # Format y-axis as currency
        ax1.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'${x:,.0f}'))
    else:
        ax1.text(0.5, 0.5, 'No account type data', 
                 ha='center', va='center', transform=ax1.transAxes)
        ax1.set_title('Accounts Receivable by Account Type')
else:
    ax1.text(0.5, 0.5, 'No accounts receivable data', 
             ha='center', va='center', transform=ax1.transAxes)
    ax1.set_title('Accounts Receivable by Account Type')
ax1.grid(True, alpha=0.3)

# Plot 2: Collection rate comparison
ax2 = axes[0, 1]
if 'high_vol_avg_rate' in locals() and 'low_vol_avg_rate' in locals():
    rates_data = pd.DataFrame({
        'Group': ['High Volatility', 'Low Volatility', 'Overall Dashboard'],
        'Collection Rate (%)': [high_vol_avg_rate, low_vol_avg_rate, overall_rate]
    })
    bars = ax2.bar(rates_data['Group'], rates_data['Collection Rate (%)'], 
                   color=['red', 'blue', 'green'], alpha=0.7)
    ax2.set_title('Collection Rate Comparison')
    ax2.set_ylabel('Collection Rate (%)')
    ax2.grid(True, alpha=0.3)
    
    # Add value labels on bars
    for bar in bars:
        height = bar.get_height()
        ax2.text(bar.get_x() + bar.get_width()/2., height + 0.5,
                f'{height:.1f}%', ha='center', va='bottom')
else:
    ax2.text(0.5, 0.5, 'Insufficient collection data', 
             ha='center', va='center', transform=ax2.transAxes)
    ax2.set_title('Collection Rate Comparison')
ax2.grid(True, alpha=0.3)

# Plot 3: Uncollected amounts distribution
ax3 = axes[1, 0]
if 'high_vol_uncollected' in locals() and 'low_vol_uncollected' in locals():
    uncollected_data = pd.DataFrame({
        'Group': ['High Volatility', 'Low Volatility'],
        'Uncollected Amount': [high_vol_uncollected, low_vol_uncollected]
    })
    bars = ax3.bar(uncollected_data['Group'], uncollected_data['Uncollected Amount'], 
                   color=['red', 'blue'], alpha=0.7)
    ax3.set_title('Uncollected Amounts by Customer Volatility')
    ax3.set_ylabel('Uncollected Amount ($)')
    ax3.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'${x:,.0f}'))
    ax3.grid(True, alpha=0.3)
    
    # Add percentage labels
    total_uncollected = high_vol_uncollected + low_vol_uncollected
    for i, bar in enumerate(bars):
        height = bar.get_height()
        percentage = (height / total_uncollected) * 100
        ax3.text(bar.get_x() + bar.get_width()/2., height + total_uncollected * 0.01,
                f'{percentage:.1f}%', ha='center', va='bottom')
else:
    ax3.text(0.5, 0.5, 'Insufficient uncollected data', 
             ha='center', va='center', transform=ax3.transAxes)
    ax3.set_title('Uncollected Amounts by Customer Volatility')
ax3.grid(True, alpha=0.3)

# Plot 4: High-volatility customer composition by lifecycle and payment behavior
ax4 = axes[1, 1]
# Get high-volatility customer characteristics
customer_query = """
SELECT 
  pa.customer_id,
  pa.customer_margin_volatility,
  ca.lifecycle_stage,
  ca.payment_behavior,
  ca.rfm_segment,
  ca.risk_assessment
FROM quickbooks__profitability_analysis pa
LEFT JOIN quickbooks__customer_analytics ca ON pa.customer_id = ca.customer_id
WHERE pa.customer_margin_volatility >= ?
"""
threshold = threshold_df['customer_margin_volatility'].quantile(0.75)
high_vol_details = pd.read_sql_query(customer_query, conn, params=(threshold,))

# Create risk classification based on multiple factors
conditions = [
    (high_vol_details['lifecycle_stage'].isin(['New Customer', 'At Risk'])) & 
    (high_vol_details['payment_behavior'] == 'Poor'),
    (high_vol_details['lifecycle_stage'].isin(['New Customer', 'At Risk'])) | 
    (high_vol_details['payment_behavior'] == 'Poor'),
    (high_vol_details['lifecycle_stage'].isin(['Loyal Customer', 'Mature'])) & 
    (high_vol_details['payment_behavior'] == 'Excellent')
]

choices = ['High Risk', 'Medium Risk', 'Low Risk']
high_vol_details['risk_class'] = np.select(conditions, choices, default='Medium Risk')

# Plot risk classification
if 'risk_class' in high_vol_details.columns:
    risk_counts = high_vol_details['risk_class'].value_counts()
    colors = {'High Risk': 'red', 'Medium Risk': 'orange', 'Low Risk': 'green'}
    bar_colors = [colors.get(x, 'gray') for x in risk_counts.index]
    
    risk_counts.plot(kind='bar', ax=ax4, color=bar_colors, alpha=0.7)
    ax4.set_title('High-Volatility Customer Risk Classification')
    ax4.set_xlabel('Risk Level')
    ax4.set_ylabel('Count')
    ax4.tick_params(axis='x', rotation=0)
    
    # Add percentage labels
    total = risk_counts.sum()
    for i, (label, count) in enumerate(risk_counts.items()):
        percentage = (count / total) * 100
        ax4.text(i, count + total * 0.01, f'{percentage:.1f}%', ha='center', va='bottom')
else:
    ax4.text(0.5, 0.5, 'Insufficient customer data', 
             ha='center', va='center', transform=ax4.transAxes)
    ax4.set_title('High-Volatility Customer Risk Classification')
ax4.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('risk_exposure_analysis.png', dpi=300, bbox_inches='tight')
plt.close()

conn.close()
print("\nRisk exposure analysis complete. Visualization saved as 'risk_exposure_analysis.png'")
```
