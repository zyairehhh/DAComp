import sqlite3
import pandas as pd
import numpy as np

def main():
    conn = sqlite3.connect('dacomp-066.sqlite')
    query = """
    SELECT p.*, e.departments, e.hiring_managers, e.avg_interviews_per_application,
           e.avg_job_rating, e.application_to_interview_rate, e.interview_to_hire_rate,
           e.overall_conversion_rate
    FROM greenhouse__recruitment_performance p
    JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
    WHERE e.departments = 'Engineering'
    """
    df = pd.read_sql_query(query, conn)
    conn.close()
    df['role_category'] = df['job_title'].str.split(' - ').str[0]
    # Compute weighted conversion rate per quarter per role using total_interviews/total_applications
    # Actually interview_rate is already total_interviews/total_applications
    # But we can compute weighted average across jobs.
    # Let's compute for each role and quarter: sum(total_interviews)/sum(total_applications)
    weighted = df.groupby(['role_category', 'application_quarter']).apply(
        lambda x: (x['total_interviews'].sum() / x['total_applications'].sum() * 100)
    ).reset_index(name='weighted_interview_rate')
    print("Weighted conversion rate (average interviews per application):")
    print(weighted)
    # Compute change
    w_q3 = weighted[weighted['application_quarter'] == 3]
    w_q4 = weighted[weighted['application_quarter'] == 4]
    w_merged = pd.merge(w_q3, w_q4, on='role_category', suffixes=('_q3', '_q4'))
    w_merged['change'] = w_merged['weighted_interview_rate_q4'] - w_merged['weighted_interview_rate_q3']
    w_merged['perc_change'] = w_merged['change'] / w_merged['weighted_interview_rate_q3'] * 100
    w_merged = w_merged.sort_values('change')
    print("\nWeighted change per role:")
    print(w_merged[['role_category', 'weighted_interview_rate_q3', 'weighted_interview_rate_q4', 'change', 'perc_change']])
    # Overall engineering weighted conversion rate
    overall_q3_weighted = df[df['application_quarter'] == 3].apply(lambda x: x['total_interviews'].sum() / x['total_applications'].sum() * 100, axis=0).iloc[0]
    overall_q4_weighted = df[df['application_quarter'] == 4].apply(lambda x: x['total_interviews'].sum() / x['total_applications'].sum() * 100, axis=0).iloc[0]
    print(f"\nOverall weighted Engineering conversion rate Q3: {overall_q3_weighted:.2f}%")
    print(f"Overall weighted Engineering conversion rate Q4: {overall_q4_weighted:.2f}%")
    # Analyze hiring managers
    hm_df = df[['hiring_managers', 'interview_rate', 'total_applications', 'application_quarter']].copy()
    # Compute weighted conversion per hiring manager per quarter
    hm_weighted = hm_df.groupby(['hiring_managers', 'application_quarter']).apply(
        lambda x: (x['interview_rate'].mean())
    ).reset_index(name='avg_rate')
    # Compute change per hiring manager
    hm_pivot = hm_weighted.pivot(index='hiring_managers', columns='application_quarter', values='avg_rate')
    hm_pivot.columns = ['q3', 'q4']
    hm_pivot['change'] = hm_pivot['q4'] - hm_pivot['q3']
    hm_pivot = hm_pivot.sort_values('change')
    print("\nHiring manager average conversion rate change:")
    print(hm_pivot.head(10))
    # Factor analysis: correlation between interview_rate and avg_interviews_per_application
    corr = df[['interview_rate', 'avg_interviews_per_application', 'avg_job_rating']].corr()
    print("\nCorrelation matrix:")
    print(corr)
    # Simple regression slope using numpy
    X = df['avg_interviews_per_application'].values
    y = df['interview_rate'].values
    X_mean = np.mean(X)
    y_mean = np.mean(y)
    numerator = np.sum((X - X_mean) * (y - y_mean))
    denominator = np.sum((X - X_mean) ** 2)
    slope = numerator / denominator if denominator != 0 else 0
    intercept = y_mean - slope * X_mean
    print(f"\nSimple regression: interview_rate = {intercept:.3f} + {slope:.3f} * avg_interviews_per_application")
    # Compute R-squared
    pred = intercept + slope * X
    ss_res = np.sum((y - pred) ** 2)
    ss_tot = np.sum((y - y_mean) ** 2)
    r2 = 1 - (ss_res / ss_tot)
    print(f"R-squared: {r2:.4f}")
    # Also look at hiring manager's years of experience not available.
    # Save results
    weighted.to_csv('weighted_conversion.csv', index=False)
    w_merged.to_csv('weighted_change.csv', index=False)
    hm_pivot.to_csv('hiring_manager_change.csv', index=False)

if __name__ == '__main__':
    main()
```



