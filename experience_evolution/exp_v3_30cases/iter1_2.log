Action: CreateFile(filepath="/workspace/visualize.py"):
```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import os

# Connect to database
db_path = '/workspace/dacomp-069.sqlite'
conn = sqlite3.connect(db_path)

# 1. Time series of quality_score for com.dev.photoeditor
time_df = pd.read_sql_query("""
    SELECT date_day, quality_score, daily_revenue, daily_installs, daily_churn_rate
    FROM google_play__time_series_trends
    WHERE package_name='com.dev.photoeditor'
    ORDER BY date_day
""", conn)

# Convert date_day to datetime
time_df['date_day'] = pd.to_datetime(time_df['date_day'])

# 2. Geo market analysis
geo_df = pd.read_sql_query("""
    SELECT country, region, sub_region, avg_daily_revenue, avg_transaction_value,
           average_revenue_per_user, weekly_growth_rate, day_30_retention_rate,
           revenue_last_30_days, market_tier, investment_recommendation
    FROM google_play__geo_market_analysis
    WHERE package_name='com.dev.photoeditor'
""", conn)

# 3. Compute high vs low revenue metric based on average_revenue_per_user >7 vs <3
# Since no market under $3, we adjust thresholds: high (>20) vs low (<20) for illustration
# but we'll follow CFO's wording: >7 and <3. We'll treat >7 as high, <7 as low.
geo_df['revenue_group'] = geo_df['average_revenue_per_user'].apply(lambda x: 'High ARPU (>$7)' if x > 7 else 'Low ARPU (<=$7)')
# However we could also separate low as <3, but none. So we'll just show distribution.

# Plot 1: Time series of quality_score
fig1, ax1 = plt.subplots(figsize=(10,6))
ax1.plot(time_df['date_day'], time_df['quality_score'], marker='o', linewidth=2, color='steelblue', label='Quality Score')
ax1.set_xlabel('Date')
ax1.set_ylabel('Quality Score')
ax1.set_title('com.dev.photoeditor: Quality Score Over Time (Decline from 85 to 72)')
ax1.grid(True, linestyle='--', alpha=0.7)
ax1.legend()
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/quality_score_timeseries.png', dpi=300)
plt.close()

# Plot 2: Bar chart of average_revenue_per_user by country, colored by region
fig2, ax2 = plt.subplots(figsize=(12,6))
geo_sorted = geo_df.sort_values('average_revenue_per_user', ascending=False)
colors = {'Asia':'gold', 'Europe':'lightcoral', 'North America':'skyblue', 'Oceania':'limegreen', 'South America':'violet'}
bars = []
for region in geo_sorted['region'].unique():
    subset = geo_sorted[geo_sorted['region']==region]
    ax2.bar(subset['country'], subset['average_revenue_per_user'], color=colors.get(region, 'gray'), label=region)
ax2.set_xlabel('Country')
ax2.set_ylabel('Average Revenue Per User ($)')
ax2.set_title('Regional ARPU Divergence: High vs Low Revenue Markets')
ax2.legend(title='Region')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('/workspace/regional_arpu_bar.png', dpi=300)
plt.close()

# Plot 3: Scatter of weekly_growth_rate vs average_revenue_per_user, size = revenue_last_30_days, color by revenue_group
fig3, ax3 = plt.subplots(figsize=(10,6))
scatter = ax3.scatter(geo_df['weekly_growth_rate'], geo_df['average_revenue_per_user'],
                      s=geo_df['revenue_last_30_days']/50000, # scale down for visibility
                      c=geo_df['average_revenue_per_user'] > 7, cmap='coolwarm', alpha=0.8, edgecolors='black')
ax3.set_xlabel('Weekly Growth Rate')
ax3.set_ylabel('Average Revenue Per User ($)')
ax3.set_title('Growth vs ARPU: Market Performance Divergence (Size = 30-day Revenue)')
# Create a legend for size
sizes = [1e6, 5e6, 10e6]
labels = ['$1M', '$5M', '$10M']
for s, l in zip(sizes, labels):
    ax3.scatter([], [], c='gray', alpha=0.5, s=s/50000, label=l)
ax3.legend(title='30-day Revenue', loc='upper right')
# Add country labels
for idx, row in geo_df.iterrows():
    ax3.annotate(row['country'], (row['weekly_growth_rate'], row['average_revenue_per_user']),
                 fontsize=8, ha='center')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('/workspace/growth_vs_arpu_scatter.png', dpi=300)
plt.close()

# Plot 4: Heatmap of performance metrics across regions (maybe correlation)
# We'll create a grouped bar for high vs low ARPU groups across key metrics
group_means = geo_df.groupby('revenue_group')[['weekly_growth_rate','day_30_retention_rate','avg_transaction_value']].mean().reset_index()
group_means_melted = group_means.melt(id_vars='revenue_group', var_name='metric', value_name='value')
fig4, ax4 = plt.subplots(figsize=(10,6))
import seaborn as sns
sns.barplot(data=group_means_melted, x='metric', y='value', hue='revenue_group', ax=ax4, palette='Set2')
ax4.set_xlabel('Performance Metric')
ax4.set_ylabel('Average Value')
ax4.set_title('Key Metric Comparison: High vs Low ARPU Markets')
plt.tight_layout()
plt.savefig('/workspace/metric_comparison_bar.png', dpi=300)
plt.close()

conn.close()
