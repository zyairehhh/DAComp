# Since we cannot join, we skip People Impact Score for now.

# Plot 3: Component-level insights: Environmental Impact Rate proportion High per level
env_high = df.groupby("Disaster Level").apply(lambda x: (x["Environmental Impact Rate"] == "High").sum() / len(x)).reindex(level_order)
waste_critical = df.groupby("Disaster Level").apply(lambda x: (x["Waste Management Status"] == "Critical").sum() / len(x)).reindex(level_order)
disease_high = df.groupby("Disaster Level").apply(lambda x: (x["Disease Risk"] == "High").sum() / len(x)).reindex(level_order)
medical_critical = df.groupby("Disaster Level").apply(lambda x: (x["Medical Emergency Response Capacity"] == "Critical").sum() / len(x)).reindex(level_order)
mental_limited = df.groupby("Disaster Level").apply(lambda x: (x["Mental Health Assistance"] == "Limited").sum() / len(x)).reindex(level_order)

print("\nProportion High Environmental Impact:", env_high)
print("Proportion Critical Waste Management:", waste_critical)
print("Proportion High Disease Risk:", disease_high)
print("Proportion Critical Medical Capacity:", medical_critical)
print("Proportion Limited Mental Health Assistance:", mental_limited)

# Plot for these categorical proportions
fig, ax = plt.subplots(2, 3, figsize=(15,10))
ax = ax.ravel()
# Plot proportions as bars
