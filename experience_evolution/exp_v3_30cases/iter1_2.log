Action: CreateFile(filepath='/workspace/compute_corr.py':
```
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-018.sqlite')
query = '''
SELECT 
    c."Customer ID",
    SUM(pb."Browsing Time (minutes)") as total_browse_time,
    SUM(pb.like) as total_likes,
    SUM(pb.share) as total_shares,
    SUM(pb."Add to Cart") as total_add_to_cart,
    SUM(o.profit) as total_profit
FROM product_browsing pb
JOIN order_information o ON pb."Customer ID" = o."Customer ID" AND pb."Product Category" = o."Product Category" AND pb.Product = o.Product
JOIN customer_information c ON pb."Customer ID" = c."Customer ID"
WHERE o."Product Category" = 'Fashion'
GROUP BY c."Customer ID"
'''
df = pd.read_sql(query, conn)
conn.close()
corr = df['total_browse_time'].corr(df['total_profit'])
print('Correlation between total browsing time and total profit:', corr)
print('Correlation between total likes and total profit:', df['total_likes'].corr(df['total_profit']))
print('Correlation between total shares and total profit:', df['total_shares'].corr(df['total_profit']))
print('Correlation between total add to cart and total profit:', df['total_add_to_cart'].corr(df['total_profit']))
```)

