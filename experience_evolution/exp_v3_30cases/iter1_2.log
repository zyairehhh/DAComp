import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

conn = sqlite3.connect('dacomp-001.sqlite')

# Plot 1: Credit rating distribution
df_company = pd.read_sql_query('SELECT `Credit Rating`, COUNT(*) as cnt FROM ch___company_info GROUP BY `Credit Rating` ORDER BY `Credit Rating`', conn)
plt.figure(figsize=(6,4))
sns.barplot(x='Credit Rating', y='cnt', data=df_company, palette='Blues')
plt.title('Distribution of Enterprises by Credit Rating')
plt.ylabel('Number of Enterprises')
plt.tight_layout()
plt.savefig('credit_rating_distribution.png', dpi=300)
plt.close()

# Plot 2: Churn rate vs interest rate by credit rating (using annual_rate_&_churn)
df_churn = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)
plt.figure(figsize=(8,5))
plt.plot(df_churn['Annual Loan Interest Rate'], df_churn['Credit Rating A Customer Churn Rate'], label='Rating A', marker='o')
plt.plot(df_churn['Annual Loan Interest Rate'], df_churn['Credit Rating B Customer Churn Rate'], label='Rating B', marker='s')
plt.plot(df_churn['Annual Loan Interest Rate'], df_churn['Credit Rating C Customer Churn Rate'], label='Rating C', marker='^')
plt.xlabel('Annual Loan Interest Rate')
plt.ylabel('Customer Churn Rate')
plt.title('Churn Rate vs Interest Rate by Credit Rating')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig('churn_vs_interest.png', dpi=300)
plt.close()

# Plot 3: Revenue capacity by credit rating (sum invoice amounts per enterprise, then average)
# Compute total revenue per enterprise
df_inv = pd.read_sql_query('SELECT `Enterprise Code`, SUM(`Amount Including Tax`) as total_revenue FROM ch___sales_invoices WHERE `Invoice Status` = "Valid" GROUP BY `Enterprise Code`', conn)
# Merge with credit rating
df_rating = pd.read_sql_query('SELECT `Enterprise Code`, `Credit Rating` FROM ch___company_info', conn)
df_rev = pd.merge(df_inv, df_rating, on='Enterprise Code')
# Boxplot
plt.figure(figsize=(8,5))
sns.boxplot(x='Credit Rating', y='total_revenue', data=df_rev, order=['A','B','C','D'])
plt.title('Revenue Capacity Distribution by Credit Rating')
plt.ylabel('Total Revenue (sum of invoice amounts)')
plt.tight_layout()
plt.savefig('revenue_by_rating.png', dpi=300)
plt.close()

# Plot 4: Profit stability (maybe variance of invoice amounts over time) - but we lack time series; maybe we can compute coefficient of variation per enterprise
# For simplicity, compute standard deviation of invoice amounts per enterprise, normalized by mean (CV)
df_stats = pd.read_sql_query('''
    SELECT `Enterprise Code`, AVG(`Amount Including Tax`) as mean_rev, STDEV(`Amount Including Tax`) as std_rev
    FROM ch___sales_invoices WHERE `Invoice Status` = "Valid"
    GROUP BY `Enterprise Code`
''', conn)
df_stats['cv_rev'] = df_stats['std_rev'] / df_stats['mean_rev']
df_stats = pd.merge(df_stats, df_rating, on='Enterprise Code')
plt.figure(figsize=(8,5))
sns.boxplot(x='Credit Rating', y='cv_rev', data=df_stats[df_stats['cv_rev'].notnull()], order=['A','B','C','D'])
plt.title('Profit Stability (Coefficient of Variation of Invoice Amounts) by Credit Rating')
plt.ylabel('Coefficient of Variation')
plt.tight_layout()
plt.savefig('profit_stability_by_rating.png', dpi=300)
plt.close()

conn.close()
```
