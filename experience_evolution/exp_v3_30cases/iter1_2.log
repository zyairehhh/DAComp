Action: CreateFile(filepath='compute4.py':
'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-071.sqlite')

stages = ['Application Review','Phone Screening','Technical Assessment','First Interview','Second Interview','Final Interview','Reference Check','Offer Discussion','Background Check','Hired']

query = """
SELECT stage,
       COUNT(*) as total_records,
       AVG(days_in_stage) as avg_days,
       SUM(CASE WHEN archive_reason IN ('Advanced to next stage','Proceeding','Hired','Qualified') THEN 1 ELSE 0 END) as pass_records
FROM lever__opportunity_stage_history
WHERE stage IN """ + str(tuple(stages)) + """
GROUP BY stage
ORDER BY CASE stage
    WHEN 'Application Review' THEN 1
    WHEN 'Phone Screening' THEN 2
    WHEN 'Technical Assessment' THEN 3
    WHEN 'First Interview' THEN 4
    WHEN 'Second Interview' THEN 5
    WHEN 'Final Interview' THEN 6
    WHEN 'Reference Check' THEN 7
    WHEN 'Offer Discussion' THEN 8
    WHEN 'Background Check' THEN 9
    WHEN 'Hired' THEN 10
END;
"""

df = pd.read_sql_query(query, conn)
df['pass_rate'] = df['pass_records'] / df['total_records']
df['attrition_rate'] = 1 - df['pass_rate']
df['conversion_from_previous'] = df['total_records'] / df['total_records'].shift(1)
df['cumulative_conversion'] = df['total_records'] / df.loc[0,'total_records']

print(df[['stage','total_records','avg_days','attrition_rate','pass_rate','conversion_from_previous','cumulative_conversion']].to_string(index=False))

conn.close()
''')
