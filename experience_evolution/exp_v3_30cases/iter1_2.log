import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-057.sqlite')

# Load decay campaigns list
decay = pd.read_csv('decay_campaigns.csv')
decay_ids = decay['campaign_id'].unique()

# Load merged data (already prepared from previous script)
campaign_df = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)
cac_df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)

campaign_df['date_day'] = pd.to_datetime(campaign_df['date_day'].str[:10])
cac_df['date_day'] = pd.to_datetime(cac_df['date_day'].str[:10])

campaign_account_map = campaign_df[['campaign_id', 'account_id', 'advertising_channel_type']].drop_duplicates()
campaign_daily = campaign_df.groupby(['campaign_id', 'date_day']).agg({
    'spend': 'sum',
    'conversions': 'sum'
}).reset_index()
campaign_daily = campaign_daily.merge(campaign_account_map, on='campaign_id', how='left')

merged = campaign_daily.merge(cac_df[['account_id', 'date_day', 'advertising_channel_type',
                                       'customer_acquisition_cost', 'ltv_cac_ratio',
                                       'campaign_lifecycle_stage', 'customer_maturity_stage',
                                       'account_maturity_stage', 'acquisition_sophistication_score',
                                       'cac_efficiency_percentile', 'channel_diversity_count',
                                       'strategic_customer_segment', 'retention_risk',
                                       'scale_opportunity']],
                              on=['account_id', 'date_day', 'advertising_channel_type'], how='inner')

merged['is_decay'] = merged['campaign_id'].isin(decay_ids)

# 1. Acquisition Sophistication Score vs CAC Efficiency Percentile
plt.figure(figsize=(10,6))
scatter = plt.scatter(merged['acquisition_sophistication_score'],
                      merged['cac_efficiency_percentile'],
                      c=merged['is_decay'], cmap='coolwarm', alpha=0.6)
plt.xlabel('Acquisition Sophistication Score')
plt.ylabel('CAC Efficiency Percentile')
plt.title('Acquisition Sophistication vs CAC Efficiency (Red = Decay)')
plt.colorbar(scatter, label='Decay Campaign')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('scatter_soph_vs_cac_efficiency.png', dpi=300)
plt.close()

# 2. Distribution of Channel Diversity Count for decay vs non-decay
plt.figure(figsize=(8,5))
sns.boxplot(x='is_decay', y='channel_diversity_count', data=merged)
plt.xlabel('Decay Campaign')
plt.ylabel('Channel Diversity Count')
plt.title('Channel Diversity Count by Decay Status')
plt.xticks([0,1], ['Non-decay', 'Decay'])
plt.tight_layout()
plt.savefig('boxplot_channel_diversity.png', dpi=300)
plt.close()

# 3. Decay proportion by strategic customer segment
if not merged['strategic_customer_segment'].empty:
    decay_segment = merged.groupby('strategic_customer_segment')['is_decay'].mean().sort_values(ascending=False)
    decay_segment.plot(kind='bar', figsize=(10,5), color='coral')
    plt.title('Decay Campaign Proportion by Strategic Customer Segment')
    plt.xlabel('Strategic Customer Segment')
    plt.ylabel('Proportion of Decay Campaigns')
    plt.xticks(rotation=45, ha='right')
    plt.tight_layout()
    plt.savefig('decay_by_customer_segment.png', dpi=300)
    plt.close()

# 4. Retention risk and scale opportunity distribution for decay campaigns
if not decay.empty:
    fig, axes = plt.subplots(1,2, figsize=(12,5))
    decay['retention_risk'].value_counts().plot(kind='bar', ax=axes[0], color='skyblue')
    axes[0].set_title('Retention Risk Distribution in Decay Campaigns')
    axes[0].set_xlabel('Retention Risk Flag')
    axes[0].set_ylabel('Count')
    decay['scale_opportunity'].value_counts().plot(kind='bar', ax=axes[1], color='lightgreen')
    axes[1].set_title('Scale Opportunity Distribution in Decay Campaigns')
    axes[1].set_xlabel('Scale Opportunity Flag')
    axes[1].set_ylabel('Count')
    plt.tight_layout()
    plt.savefig('retention_scale_dist.png', dpi=300)
    plt.close()

print("Additional plots saved.")
'''

