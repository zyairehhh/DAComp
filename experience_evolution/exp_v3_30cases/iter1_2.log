import pandas as pd
import numpy as np

df = pd.read_csv('data.csv')
df['Budget Amount'] = pd.to_numeric(df['Budget Amount'], errors='coerce')
df['Actual Cost'] = pd.to_numeric(df['Actual Cost'], errors='coerce')
df['Team Size'] = pd.to_numeric(df['Team Size'], errors='coerce')
df['Customer Satisfaction'] = pd.to_numeric(df['Customer Satisfaction'], errors='coerce')
df['Cost Deviation'] = df['Budget Amount'] - df['Actual Cost']

print("Overall average cost deviation:", df['Cost Deviation'].mean())
print("Overall median cost deviation:", df['Cost Deviation'].median())

# Correlation with team size
corr_team = df['Cost Deviation'].corr(df['Team Size'])
print("Correlation (Deviation vs Team Size):", corr_team)

# Correlation with customer satisfaction
corr_sat = df['Cost Deviation'].corr(df['Customer Satisfaction'])
print("Correlation (Deviation vs Customer Satisfaction):", corr_sat)

# Group by risk level
print("\nAverage deviation by Risk Level:")
print(df.groupby('Risk Level')['Cost Deviation'].mean())

# Compute percentage over-budget (negative deviation) projects
over_budget = (df['Cost Deviation'] < 0).sum()
print(f"\nNumber of projects over-budget (negative deviation): {over_budget} out of {len(df)} ({over_budget/len(df)*100:.1f}%)")
''')
