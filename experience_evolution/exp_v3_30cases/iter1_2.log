import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Load churn data
conn = sqlite3.connect('dacomp-001.sqlite')
churn_df = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)
conn.close()

# Default probabilities per rating
default_prob = {'A': 0.0, 'B': 1/38, 'C': 2/34, 'D': 1.0}
print("Default probabilities:", default_prob)

# For each rating A, B, C (D is hopeless)
rates = churn_df['Annual Loan Interest Rate'].values

def expected_profit_per_unit(rate, churn, default):
    # rate: interest rate (e.g., 0.05 for 5%)
    # churn: probability customer churns (does not take loan)
    # default: probability of default
    # Profit per unit credit: if loan taken (1 - churn) * (rate * (1 - default) - default)
    # Assuming LGD=1 (loss of entire principal)
    return (1 - churn) * (rate * (1 - default) - default)

# Compute expected profit for each rate and rating
results = []
for rating in ['A','B','C']:
    churn_col = f'Credit Rating {rating} Customer Churn Rate'
    churns = churn_df[churn_col].values
    default = default_prob[rating]
    profit = expected_profit_per_unit(rates, churns, default)
    results.append((rating, rates, churns, profit))
    # Find max profit
    idx = np.argmax(profit)
    print(f"Rating {rating}: optimal rate {rates[idx]:.4f}, churn {churns[idx]:.4f}, expected profit per unit {profit[idx]:.6f}")

# Plot
plt.figure(figsize=(10,6))
for rating, rates, churns, profit in results:
    plt.plot(rates, profit, label=f'Rating {rating}')
plt.xlabel('Interest Rate')
plt.ylabel('Expected Profit per Unit Credit')
plt.title('Expected Profit vs Interest Rate by Rating')
plt.legend()
plt.grid()
plt.savefig('optimal_rate.png', dpi=150)
print("Saved optimal_rate.png")

# For rating D, profit is always negative; don't lend.
```
