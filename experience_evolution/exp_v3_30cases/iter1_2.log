```
import sqlite3
import matplotlib.pyplot as plt
import pandas as pd

# Connect to database
conn = sqlite3.connect('dacomp-022.sqlite')

# Query fare per km by vehicle type for completed trips
query = '''
SELECT "Vehicle Type" as vehicle_type,
       COUNT(*) as trips,
       SUM("Booking Value") as total_revenue,
       SUM("Ride Distance") as total_distance,
       SUM("Booking Value") / SUM("Ride Distance") as fare_per_km
FROM sheet1
WHERE "Driver Ratings" IS NOT NULL
GROUP BY "Vehicle Type"
ORDER BY fare_per_km DESC
'''

df = pd.read_sql_query(query, conn)
conn.close()

# Plot
plt.figure(figsize=(10, 6))
bars = plt.bar(df['vehicle_type'], df['fare_per_km'], color='steelblue')
plt.axhline(y=df['fare_per_km'].max(), color='red', linestyle='--', alpha=0.5, label=f'Highest: {df["fare_per_km"].iloc[0]:.2f}')
plt.title('Fare per Kilometer by Vehicle Type (Completed Rides)', fontsize=14, fontweight='bold')
plt.xlabel('Vehicle Type', fontsize=12)
plt.ylabel('Fare per Kilometer (currency/km)', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.legend()

# Annotate values on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.2f}', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('vehicle_fare_per_km.png', dpi=300)
print('Plot saved as vehicle_fare_per_km.png')
```
