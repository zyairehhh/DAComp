import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-078/stage1_env/dacomp-078.sqlite')

# Load visitor table
visitor = pd.read_sql_query("SELECT * FROM pendo__visitor;", conn)
print("Visitors:", visitor.shape[0])

# Define high-value based on top 20% minutes and events
threshold_min = visitor['sum_minutes'].quantile(0.8)
threshold_ev = visitor['sum_events'].quantile(0.8)
visitor['high_value'] = (visitor['sum_minutes'] >= threshold_min) & (visitor['sum_events'] >= threshold_ev)
print("High-value count:", visitor['high_value'].sum())

# Load feature diversity
feat = pd.read_sql_query("SELECT visitor_id, COUNT(DISTINCT feature_id) as num_features, SUM(sum_clicks) as total_clicks FROM pendo__visitor_feature GROUP BY visitor_id;", conn)
visitor = visitor.merge(feat, on='visitor_id', how='left').fillna({'num_features':0, 'total_clicks':0})

# Load recency and tenure from daily metrics (max date per visitor)
daily = pd.read_sql_query("SELECT visitor_id, MAX(date_day) as last_day, MIN(date_day) as first_day FROM pendo__visitor_daily_metrics GROUP BY visitor_id;", conn)
daily['last_day'] = pd.to_datetime(daily['last_day'])
daily['first_day'] = pd.to_datetime(daily['first_day'])
ref_date = daily['last_day'].max()
daily['recency_days'] = (ref_date - daily['last_day']).dt.days
daily['tenure_days'] = (daily['last_day'] - daily['first_day']).dt.days
visitor = visitor.merge(daily[['visitor_id','recency_days','tenure_days']], on='visitor_id', how='left').fillna({'recency_days':999, 'tenure_days':0})

# Compute regularity: coefficient of variation of daily minutes
# Use SQL to compute per visitor avg and std (via Python groupby)
daily_minutes = pd.read_sql_query("SELECT visitor_id, sum_minutes FROM pendo__visitor_daily_metrics;", conn)
daily_cv = daily_minutes.groupby('visitor_id').apply(lambda g: g['sum_minutes'].std() / g['sum_minutes'].mean() if g['sum_minutes'].mean() > 0 else 0).rename('daily_cv')
visitor = visitor.merge(daily_cv, on='visitor_id', how='left').fillna({'daily_cv':0})

# Account-level metrics
account = pd.read_sql_query("SELECT account_id, COUNT(DISTINCT visitor_id) as num_visitors, AVG(sum_minutes) as avg_minutes_account, AVG(sum_events) as avg_events_account FROM pendo__visitor GROUP BY account_id;", conn)
visitor = visitor.merge(account, on='account_id', how='left')

# Compute correlation for each feature
features = ['sum_minutes','sum_events','latest_nps_rating','count_active_days','count_active_months',
            'average_daily_minutes','average_daily_events','num_features','total_clicks','recency_days','tenure_days','daily_cv','num_visitors','avg_minutes_account','avg_events_account']

corr_results = {}
for f in features:
    if f in visitor.columns:
        corr = visitor[['high_value', f]].corr().iloc[0,1]
        corr_results[f] = corr
        print(f"{f}: {corr:.4f}")

print("\nSorted by absolute correlation:")
sorted_corr = sorted(corr_results.items(), key=lambda x: abs(x[1]), reverse=True)
for f, c in sorted_corr:
    print(f"{f}: {c:.4f}")

conn.close()
''')
