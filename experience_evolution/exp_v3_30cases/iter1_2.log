import sqlite3
import pandas as pd
import numpy as np

def main():
    db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-061/stage1_env/dacomp-061.sqlite"
    conn = sqlite3.connect(db_path)
    
    # Get project data with avg_close_time_days
    projects = pd.read_sql_query("SELECT project_id, project_name, avg_close_time_days FROM jira__project_enhanced", conn)
    
    # Get issue intelligence aggregated per project
    query = """
    SELECT project_name,
           AVG(regression_ratio) AS avg_regression_ratio,
           AVG(lifecycle_quality_score) AS avg_lifecycle_quality,
           AVG(lifecycle_deviation_ratio) AS avg_lifecycle_deviation,
           AVG(total_risk_score) AS avg_total_risk,
           AVG(high_complexity_risk) AS avg_high_complexity_risk,
           AVG(process_risk_score) AS avg_process_risk,
           AVG(complexity_risk_score) AS avg_complexity_risk,
           AVG(engagement_risk_score) AS avg_engagement_risk,
           AVG(assignment_risk_score) AS avg_assignment_risk,
           AVG(deviation_risk_score) AS avg_deviation_risk,
           COUNT(*) AS issue_count
    FROM jira__issue_intelligence_analytics
    GROUP BY project_name
    """
    issue_agg = pd.read_sql_query(query, conn)
    
    # Merge
    df = pd.merge(projects, issue_agg, on='project_name', how='inner')
    
    # Classify fast vs slow projects
    df['is_fast'] = df['avg_close_time_days'] < 15
    
    # Compute summary statistics
    fast = df[df['is_fast']]
    slow = df[~df['is_fast']]
    
    print(f"Total projects: {len(df)}")
    print(f"Fast projects (<15 days): {len(fast)}")
    print(f"Slow projects (>=15 days): {len(slow)}")
    
    # Compare means
    metrics = ['avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation',
               'avg_total_risk', 'avg_high_complexity_risk', 'avg_process_risk',
               'avg_complexity_risk', 'avg_engagement_risk', 'avg_assignment_risk',
               'avg_deviation_risk']
    
    comparison = pd.DataFrame()
    for metric in metrics:
        comparison.loc[metric, 'fast_mean'] = fast[metric].mean()
        comparison.loc[metric, 'slow_mean'] = slow[metric].mean()
        comparison.loc[metric, 'fast_median'] = fast[metric].median()
        comparison.loc[metric, 'slow_median'] = slow[metric].median()
        comparison.loc[metric, 'diff'] = fast[metric].mean() - slow[metric].mean()
        
    print("\nQuality metrics comparison (fast vs slow):")
    print(comparison.round(4))
    
    # Save to CSV for further analysis
    df.to_csv('/workspace/project_metrics.csv', index=False)
    comparison.to_csv('/workspace/comparison.csv')
    
    # Additional analysis: correlation between avg_close_time_days and quality metrics
    corr = df[['avg_close_time_days'] + metrics].corr()['avg_close_time_days'].drop('avg_close_time_days')
    print("\nCorrelation of avg_close_time_days with quality metrics:")
    print(corr.sort_values(ascending=False).round(4))
    
    conn.close()

if __name__ == '__main__':
    main()
