intent_df = intent_df[intent_df['total_contacts'] >= 10]
topic_df = topic_df[topic_df['total_contacts'] >= 10]
segment_df = segment_df[segment_df['total_contacts'] >= 10]
region_df = region_df[region_df['total_contacts'] >= 10]
lifecycle_df = lifecycle_df[lifecycle_df['total_contacts'] >= 10]

