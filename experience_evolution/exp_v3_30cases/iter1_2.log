-- 1. Create parsed conversation tags view
DROP VIEW IF EXISTS parsed_conversation_tags;
CREATE VIEW parsed_conversation_tags AS
SELECT
    ce.conversation_id,
    ce.conversation_created_at,
    ce.all_conversation_tags,
    ce.all_conversation_contacts,
    cm.first_admin_response_at,
    cm.time_to_first_response_minutes,
    cm.first_assignment_at,
    cm.time_to_first_assignment_minutes,
    cm.conversation_rating,
    cm.count_total_parts,
    cm.count_reopens,
    -- extract path
    CASE
        WHEN ce.all_conversation_tags LIKE '%path:bot_first%' THEN 'bot'
        WHEN ce.all_conversation_tags LIKE '%path:human_first%' THEN 'human'
        ELSE 'unknown'
    END AS responder_type,
    -- extract stage
    CASE
        WHEN ce.all_conversation_tags LIKE '%stage:%' THEN
            substr(ce.all_conversation_tags,
                instr(ce.all_conversation_tags, 'stage:') + 6,
                CASE
                    WHEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'stage:') + 6), '|') > 0
                    THEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'stage:') + 6), '|') - 1
                    ELSE length(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'stage:') + 6))
                END
            )
        ELSE ''
    END AS stage,
    -- extract intent
    CASE
        WHEN ce.all_conversation_tags LIKE '%intent:%' THEN
            substr(ce.all_conversation_tags,
                instr(ce.all_conversation_tags, 'intent:') + 7,
                CASE
                    WHEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'intent:') + 7), '|') > 0
                    THEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'intent:') + 7), '|') - 1
                    ELSE length(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'intent:') + 7))
                END
            )
        ELSE ''
    END AS intent,
    -- extract topic
    CASE
        WHEN ce.all_conversation_tags LIKE '%topic:%' THEN
            substr(ce.all_conversation_tags,
                instr(ce.all_conversation_tags, 'topic:') + 6,
                CASE
                    WHEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'topic:') + 6), '|') > 0
                    THEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'topic:') + 6), '|') - 1
                    ELSE length(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'topic:') + 6))
                END
            )
        ELSE ''
    END AS topic,
    -- extract segment
    CASE
        WHEN ce.all_conversation_tags LIKE '%segment:%' THEN
            substr(ce.all_conversation_tags,
                instr(ce.all_conversation_tags, 'segment:') + 8,
                CASE
                    WHEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'segment:') + 8), '|') > 0
                    THEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'segment:') + 8), '|') - 1
                    ELSE length(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'segment:') + 8))
                END
            )
        ELSE ''
    END AS segment,
    -- extract region
    CASE
        WHEN ce.all_conversation_tags LIKE '%region:%' THEN
            substr(ce.all_conversation_tags,
                instr(ce.all_conversation_tags, 'region:') + 7,
                CASE
                    WHEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'region:') + 7), '|') > 0
                    THEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'region:') + 7), '|') - 1
                    ELSE length(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'region:') + 7))
                END
            )
        ELSE ''
    END AS region,
    -- extract lifecycle
    CASE
        WHEN ce.all_conversation_tags LIKE '%lifecycle:%' THEN
            substr(ce.all_conversation_tags,
                instr(ce.all_conversation_tags, 'lifecycle:') + 10,
                CASE
                    WHEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'lifecycle:') + 10), '|') > 0
                    THEN instr(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'lifecycle:') + 10), '|') - 1
                    ELSE length(substr(ce.all_conversation_tags, instr(ce.all_conversation_tags, 'lifecycle:') + 10))
                END
            )
        ELSE ''
    END AS lifecycle
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm USING (conversation_id)
WHERE ce.all_conversation_tags IS NOT NULL;

-- 2. Check responder_type distribution
SELECT responder_type, COUNT(*) AS conv_count
FROM parsed_conversation_tags
GROUP BY responder_type
ORDER BY conv_count DESC;
