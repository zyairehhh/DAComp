import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import os

# Ensure English labels
matplotlib.rcParams.update({'font.size': 10})

conn = sqlite3.connect('dacomp-090.sqlite')

# 1. High-risk customers with risk scores
query_customers = """
SELECT 
    customer_id,
    customer_name,
    payment_rate_percentage,
    outstanding_balance,
    credit_score,
    business_stability_score,
    customer_lifespan_days,
    total_invoices,
    avg_invoice_amount,
    credit_grade,
    rfm_segment,
    payment_behavior,
    customer_value_segment,
    risk_assessment,
    overall_customer_score
FROM quickbooks__customer_analytics
WHERE payment_rate_percentage < 75 AND outstanding_balance > 15000;
"""
high_risk_df = pd.read_sql_query(query_customers, conn)
high_risk_df['risk_score'] = (100 - high_risk_df['payment_rate_percentage']) * 0.4 + (850 - high_risk_df['credit_score']) / 850 * 100 * 0.4 + (100 - high_risk_df['business_stability_score']) * 0.2

# Plot 1: Distribution of risk scores
plt.figure(figsize=(8, 5))
plt.hist(high_risk_df['risk_score'], bins=20, edgecolor='black', alpha=0.7)
plt.xlabel('Risk Score')
plt.ylabel('Count of High-Risk Customers')
plt.title('Distribution of Composite Risk Scores for High-Risk Customers')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('risk_score_distribution.png', dpi=300)
plt.close()

# 2. Trend of collection_rate_percentage for last 12 months
trend_query = """
SELECT 
    dashboard_month,
    collection_rate_percentage
FROM quickbooks__financial_dashboard
ORDER BY dashboard_month DESC
LIMIT 12;
"""
trend_df = pd.read_sql_query(trend_query, conn)
trend_df['dashboard_month'] = pd.to_datetime(trend_df['dashboard_month'])
trend_df = trend_df.sort_values('dashboard_month')
trend_df['collection_change'] = trend_df['collection_rate_percentage'].diff()
trend_df['is_deterioration'] = trend_df['collection_change'] < 0

plt.figure(figsize=(10, 5))
plt.plot(trend_df['dashboard_month'], trend_df['collection_rate_percentage'], marker='o', linewidth=2)
plt.fill_between(trend_df['dashboard_month'], trend_df['collection_rate_percentage'], alpha=0.3)
# Mark deteriorating months
deteriorate = trend_df[trend_df['is_deterioration']]
if not deteriorate.empty:
    plt.scatter(deteriorate['dashboard_month'], deteriorate['collection_rate_percentage'], color='red', s=100, zorder=5, label='Deteriorating Month')
plt.xlabel('Month')
plt.ylabel('Collection Rate (%)')
plt.title('Monthly Collection Rate Trend (Last 12 Months)')
plt.xticks(rotation=45)
plt.grid(True, alpha=0.3)
plt.legend()
plt.tight_layout()
plt.savefig('collection_rate_trend.png', dpi=300)
plt.close()

# 3. Comparison of high-risk vs normal customers on key dimensions
normal_query = """
SELECT 
    customer_lifespan_days,
    total_invoices,
    avg_invoice_amount
FROM quickbooks__customer_analytics
WHERE NOT (payment_rate_percentage < 75 AND outstanding_balance > 15000);
"""
normal_df = pd.read_sql_query(normal_query, conn)

# Prepare data for box plots
fig, axes = plt.subplots(1, 3, figsize=(15, 5))
# Customer lifespan
data_lifespan = [normal_df['customer_lifespan_days'].dropna(), high_risk_df['customer_lifespan_days'].dropna()]
axes[0].boxplot(data_lifespan, labels=['Normal', 'High-Risk'])
axes[0].set_title('Customer Lifespan (Days)')
axes[0].set_ylabel('Days')
# Total invoices
data_invoices = [normal_df['total_invoices'].dropna(), high_risk_df['total_invoices'].dropna()]
axes[1].boxplot(data_invoices, labels=['Normal', 'High-Risk'])
axes[1].set_title('Total Invoices')
axes[1].set_ylabel('Count')
# Avg invoice amount
data_avg = [normal_df['avg_invoice_amount'].dropna(), high_risk_df['avg_invoice_amount'].dropna()]
axes[2].boxplot(data_avg, labels=['Normal', 'High-Risk'])
axes[2].set_title('Average Invoice Amount')
axes[2].set_ylabel('Amount')
plt.suptitle('Distribution Comparison: High-Risk vs Normal Customers', fontsize=14)
plt.tight_layout()
plt.savefig('comparison_boxplots.png', dpi=300)
plt.close()

# 4. Cash flow forecast (next 6 months)
forecast_query = """
SELECT 
    forecast_month,
    forecasted_inflows,
    forecasted_outflows,
    forecasted_net_cash_flow,
    risk_adjusted_inflows,
    blended_forecast,
    forecast_confidence,
    cash_flow_health_score,
    liquidity_risk_level
FROM quickbooks__cashflow_forecast
ORDER BY forecast_month
LIMIT 6;
"""
forecast_df = pd.read_sql_query(forecast_query, conn)
forecast_df['forecast_month'] = pd.to_datetime(forecast_df['forecast_month'])
forecast_df = forecast_df.sort_values('forecast_month')

plt.figure(figsize=(10, 5))
plt.plot(forecast_df['forecast_month'], forecast_df['forecasted_inflows'], label='Forecasted Inflows', marker='o')
plt.plot(forecast_df['forecast_month'], forecast_df['forecasted_outflows'], label='Forecasted Outflows', marker='s')
plt.plot(forecast_df['forecast_month'], forecast_df['forecasted_net_cash_flow'], label='Net Cash Flow', marker='^')
plt.fill_between(forecast_df['forecast_month'], forecast_df['forecasted_net_cash_flow'], alpha=0.3)
plt.xlabel('Month')
plt.ylabel('Amount ($)')
plt.title('Cash Flow Forecast for Next 6 Months')
plt.xticks(rotation=45)
plt.grid(True, alpha=0.3)
plt.legend()
plt.tight_layout()
plt.savefig('cashflow_forecast.png', dpi=300)
plt.close()

# 5. High-risk customer composition by credit grade
if 'credit_grade' in high_risk_df.columns:
    grade_counts = high_risk_df['credit_grade'].value_counts().sort_index()
    plt.figure(figsize=(7, 5))
    grade_counts.plot(kind='bar', color='coral', edgecolor='black')
    plt.xlabel('Credit Grade')
    plt.ylabel('Count of High-Risk Customers')
    plt.title('High-Risk Customers by Credit Grade')
    plt.grid(axis='y', alpha=0.3)
    plt.tight_layout()
    plt.savefig('credit_grade_distribution.png', dpi=300)
    plt.close()

# 6. Risk score vs outstanding balance scatter
plt.figure(figsize=(8, 6))
plt.scatter(high_risk_df['outstanding_balance'], high_risk_df['risk_score'], alpha=0.6)
plt.xlabel('Outstanding Balance ($)')
plt.ylabel('Risk Score')
plt.title('High-Risk Customers: Risk Score vs Outstanding Balance')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('risk_vs_balance.png', dpi=300)
plt.close()

conn.close()
print("Plots generated.")
