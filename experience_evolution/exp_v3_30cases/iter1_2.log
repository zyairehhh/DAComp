# 7.3 Heatmap: decay risk vs customer_maturity_stage and account_maturity_stage
# Define decay risk indicator: 1 if both thresholds exceeded, else 0
campaign_metrics['decay_risk'] = ((campaign_metrics['cac_growth_pct'] > 25) & (campaign_metrics['ltv_cac_decline_pct'] > 20)).astype(int)
