import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect("dacomp-090.sqlite")

# Compute risk scores for all customers
query = """
SELECT customer_id, customer_name, payment_rate_percentage, outstanding_balance,
       credit_score, business_stability_score,
       (100 - payment_rate_percentage) * 0.4 + 
       (850 - credit_score) / 850 * 100 * 0.4 + 
       (100 - business_stability_score) * 0.2 AS risk_score
FROM quickbooks__customer_analytics
WHERE credit_score IS NOT NULL AND business_stability_score IS NOT NULL
"""
df = pd.read_sql_query(query, conn)

# Add high-risk flag
df['high_risk'] = (df['payment_rate_percentage'] < 75.0) & (df['outstanding_balance'] > 15000)

print("Risk score distribution:")
print(df['risk_score'].describe())

print("\nHigh-risk customers risk score stats:")
print(df[df['high_risk']]['risk_score'].describe())

print("\nNormal customers risk score stats:")
print(df[~df['high_risk']]['risk_score'].describe())

# Categorize risk levels based on risk_score percentiles for high-risk customers
high_risk_df = df[df['high_risk']].copy()
bins = [0, 50, 60, 70, 100]
labels = ['Low', 'Moderate', 'High', 'Critical']
high_risk_df['risk_tier'] = pd.cut(high_risk_df['risk_score'], bins=bins, labels=labels, right=False)
risk_tier_counts = high_risk_df['risk_tier'].value_counts().sort_index()
print("\nHigh-risk customers by risk tier:")
print(risk_tier_counts)

# Compute expected loss per risk tier
high_risk_df['expected_loss'] = high_risk_df['outstanding_balance'] * (1 - high_risk_df['payment_rate_percentage']/100.0)
loss_by_tier = high_risk_df.groupby('risk_tier')['expected_loss'].sum()
print("\nExpected loss per risk tier:")
print(loss_by_tier)
```
