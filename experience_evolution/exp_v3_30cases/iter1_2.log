import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Compute deviation
df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Overall stats
mean_dev = df['Deviation'].mean()
median_dev = df['Deviation'].median()
over_budget = (df['Deviation'] < 0).sum()
total = len(df)
over_budget_pct = over_budget / total * 100

# Plot histogram
fig, ax = plt.subplots(figsize=(10, 6))
ax.hist(df['Deviation'], bins=50, edgecolor='black', alpha=0.7)
ax.axvline(mean_dev, color='red', linestyle='--', linewidth=2, label=f'Mean = {mean_dev:.2f}')
ax.axvline(median_dev, color='green', linestyle='--', linewidth=2, label=f'Median = {median_dev:.2f}')
ax.axvline(0, color='black', linewidth=1, label='Zero deviation')
ax.set_xlabel('Cost Deviation (Budget - Actual)', fontsize=12)
ax.set_ylabel('Frequency', fontsize=12)
ax.set_title('Distribution of Cost Deviation Across All Projects', fontsize=14, pad=15)
ax.legend()
ax.grid(True, alpha=0.3)

# Annotate over-budget proportion
ax.text(0.05, 0.95, f'Projects over budget: {over_budget} ({over_budget_pct:.1f}%)',
        transform=ax.transAxes, fontsize=11, verticalalignment='top',
        bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))

plt.tight_layout()
plt.savefig('deviation_distribution.png', dpi=150)
print("Saved deviation_distribution.png")
```
