Thought: The script ran and gave us metrics. Need to explore relationship between high volatility and customer lifecycle stages and payment patterns. We'll join with customer_analytics table.

First, let's see what columns are relevant: `rfm_segment`, `payment_behavior`, `revenue_trend_correlation`, `lifecycle_stage`. Also `customer_maturity_stage`.

Let's load high-volatility customer IDs and join.

Action: CreateFile(filepath="analysis2.py"):
```
import pandas as pd
import numpy as np
import sqlite3

conn = sqlite3.connect('dacomp-092.sqlite')

# Load high-volatility customers (already have threshold 0.2522)
vol_df = pd.read_sql_query("""
    SELECT DISTINCT customer_id, customer_margin_volatility
    FROM quickbooks__profitability_analysis
    WHERE customer_margin_volatility IS NOT NULL
""", conn)
threshold = vol_df['customer_margin_volatility'].quantile(0.75)
high_vol_customers = vol_df[vol_df['customer_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers count: {len(high_vol_customers)}")

# Get customer analytics columns
query = f"""
    SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
           lifecycle_stage, customer_maturity_stage, activity_status,
           customer_value_segment
    FROM quickbooks__customer_analytics
    WHERE customer_id IN ({','.join(['?']*len(high_vol_customers))})
"""
analytics = pd.read_sql_query(query, conn, params=high_vol_customers)
print(f"Customer analytics rows: {analytics.shape[0]}")

# Merge with volatility metrics from previous step (if available)
try:
    metrics = pd.read_csv('high_vol_metrics.csv')
    merged = pd.merge(analytics, metrics, on='customer_id', how='left')
except FileNotFoundError:
    merged = analytics
    print("Metrics file not found, skipping merge.")

# Summary statistics
print("\n=== RFM Segment distribution ===")
print(merged['rfm_segment'].value_counts(dropna=False))
print("\n=== Payment Behavior distribution ===")
print(merged['payment_behavior'].value_counts(dropna=False))
print("\n=== Lifecycle Stage distribution ===")
print(merged['lifecycle_stage'].value_counts(dropna=False))
print("\n=== Customer Maturity Stage distribution ===")
print(merged['customer_maturity_stage'].value_counts(dropna=False))

# Revenue trend correlation descriptive
print("\n=== Revenue Trend Correlation stats ===")
print(merged['revenue_trend_correlation'].describe())

# If we have CV and variance, we can correlate with revenue trend correlation
if 'gross_profit_cv' in merged.columns:
    corr_cv = merged[['revenue_trend_correlation', 'gross_profit_cv', 'invoice_total_growth_var']].corr()
    print("\nCorrelation matrix:")
    print(corr_cv)

# Group by lifecycle stage and compute average volatility and metrics
if 'gross_profit_cv' in merged.columns:
    grouped = merged.groupby('lifecycle_stage').agg(
        avg_cv=('gross_profit_cv', 'mean'),
        avg_growth_var=('invoice_total_growth_var', 'mean'),
        count=('customer_id', 'count')
    ).reset_index()
    print("\nMetrics by lifecycle stage:")
    print(grouped)

# Save merged data for further analysis
merged.to_csv('high_vol_analytics.csv', index=False)
print("\nMerged data saved to high_vol_analytics.csv")

conn.close()
```

