avg_risk = high_risk_df['risk_score'].mean()
loss_probability = avg_risk / 100  # assume linear
estimated_loss = total_outstanding * loss_probability
print(f"\nTotal outstanding balance for high-risk customers: {total_outstanding:.2f}")
print(f"Average risk score among high-risk: {avg_risk:.2f}")
print(f"Estimated loss probability factor: {loss_probability:.3f}")
print(f"Potential loss scale (outstanding * probability): {estimated_loss:.2f}")

