import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-071.sqlite')

# Load stage history
df_history = pd.read_sql_query("""
    SELECT opportunity_id, stage, days_in_stage, valid_from, valid_ending_at
    FROM lever__opportunity_stage_history
    WHERE days_in_stage IS NOT NULL
""", conn)

print(f"Stage history rows: {len(df_history)}")
print(df_history.head())

# For each stage, compute average days_in_stage (avg_days)
stage_avg_days = df_history.groupby('stage')['days_in_stage'].mean().reset_index()
stage_avg_days.columns = ['stage', 'avg_days']

# Determine stage transitions and attrition
df_history['valid_from'] = pd.to_datetime(df_history['valid_from'])
df_history = df_history.sort_values(['opportunity_id', 'valid_from'])

df_history['next_stage'] = df_history.groupby('opportunity_id')['stage'].shift(-1)
df_history['is_last'] = df_history['next_stage'].isna()

stage_stats = df_history.groupby('stage').agg(
    total_entries=('stage', 'size'),
    last_entries=('is_last', 'sum')
).reset_index()

stage_stats['pass_rate'] = (1 - stage_stats['last_entries'] / stage_stats['total_entries']) * 100  # percentage
stage_stats['attrition_rate'] = (stage_stats['last_entries'] / stage_stats['total_entries']) * 100

# Merge with avg days
stage_metrics = pd.merge(stage_stats, stage_avg_days, on='stage', how='left')
stage_metrics['efficiency_index'] = stage_metrics['pass_rate'] / stage_metrics['avg_days'] * 100

print("Stage metrics:")
print(stage_metrics)

# Filter stages with at least 100 samples
stage_metrics_filtered = stage_metrics[stage_metrics['total_entries'] >= 100].copy()
print("Stages with >= 100 samples:")
print(stage_metrics_filtered)

# Identify bottleneck stages: avg_days > 25 and attrition_rate > 40%
bottleneck = stage_metrics_filtered[
    (stage_metrics_filtered['avg_days'] > 25) &
    (stage_metrics_filtered['attrition_rate'] > 40)
]
print("Bottleneck stages (avg_days >25 & attrition >40%):")
print(bottleneck)

# Identify low efficiency stages: efficiency_index < 1.5
low_efficiency = stage_metrics_filtered[stage_metrics_filtered['efficiency_index'] < 1.5]
print("Low efficiency stages (efficiency_index < 1.5):")
print(low_efficiency)

# Save metrics CSV for reference
stage_metrics_filtered.to_csv('stage_metrics.csv', index=False)

# Visualizations
# 1. Bar chart: Average days per stage (top N stages)
plt.figure(figsize=(10,6))
stage_metrics_sorted = stage_metrics_filtered.sort_values('avg_days', ascending=False)
plt.bar(stage_metrics_sorted['stage'], stage_metrics_sorted['avg_days'])
plt.title('Average Days Spent per Stage (>=100 samples)')
plt.xlabel('Stage')
plt.ylabel('Average Days')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('avg_days_per_stage.png')
plt.close()

# 2. Bar chart: Attrition Rate per stage
plt.figure(figsize=(10,6))
stage_metrics_filtered = stage_metrics_filtered.sort_values('attrition_rate', ascending=False)
plt.bar(stage_metrics_filtered['stage'], stage_metrics_filtered['attrition_rate'])
plt.title('Attrition Rate per Stage (>=100 samples)')
plt.xlabel('Stage')
plt.ylabel('Attrition Rate (%)')
plt.axhline(y=40, color='r', linestyle='--', label='40% threshold')
plt.xticks(rotation=45, ha='right')
