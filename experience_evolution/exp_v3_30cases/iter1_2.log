    ax1.axvline(x=12, color='red', linestyle='--', alpha=0.5, label='Noon')
    ax1.legend()
    
    # Day of week distribution
    ax2 = axes[0, 1]
    day_names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
    day_counts = events_df['day_of_week'].value_counts().sort_index()
    if not day_counts.empty:
        ax2.bar(range(len(day_counts)), day_counts.values)
        ax2.set_title('Distribution of Email Events by Day of Week')
        ax2.set_xlabel('Day of Week')
        ax2.set_ylabel('Number of Events')
        ax2.set_xticks(range(len(day_counts)))
        ax2.set_xticklabels([day_names[i] for i in day_counts.index])
        ax2.axhline(y=day_counts.mean(), color='red', linestyle='--', alpha=0.5, label=f'Avg: {day_counts.mean():.1f}')
        ax2.legend()
    
    # Holiday analysis (simplified - check for events around major holidays)
    # For this small dataset, we'll just note the distribution
    ax3 = axes[1, 0]
    months_counts = events_df['occurred_at'].dt.month.value_counts().sort_index()
    month_names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
    if not months_counts.empty:
        ax3.bar([month_names[i-1] for i in months_counts.index], months_counts.values)
        ax3.set_title('Distribution of Email Events by Month')
        ax3.set_xlabel('Month')
        ax3.set_ylabel('Number of Events')
        ax3.tick_params(axis='x', rotation=45)
    
    # Campaign performance over time
    ax4 = axes[1, 1]
    campaign_dates = events_df.groupby('campaign_name')['occurred_at'].min().sort_values()
    for i, (campaign, date) in enumerate(campaign_dates.items()):
        ax4.scatter(date, i, s=100, label=campaign)
    
    ax4.set_title('Campaign Launch Timeline')
    ax4.set_xlabel('Date')
    ax4.set_ylabel('Campaign Index')
    ax4.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
    ax4.tick_params(axis='x', rotation=45)

plt.tight_layout()
time_analysis_path = os.path.join(plots_dir, 'time_analysis.png')
plt.savefig(time_analysis_path, dpi=300, bbox_inches='tight')
plt.close()

print(f"Plot 2 saved as {time_analysis_path}")

# Plot 3: Retention analysis
print("\nCreating Plot 3: Retention analysis...")

fig, axes = plt.subplots(1, 3, figsize=(15, 5))

# Email open rate vs active retention rate (week)
axes[0].scatter(persons_df['email_open_rate'], persons_df['active_retention_rate_week'])
axes[0].set_title('Email Open Rate vs Weekly Active Retention')
axes[0].set_xlabel('Email Open Rate')
axes[0].set_ylabel('Weekly Active Retention Rate')
axes[0].grid(True, alpha=0.3)

# Email click rate (proxy from campaign flow) vs active retention rate (month)
# Calculate average click rate from campaign flow
if 'email_click_to_open_rate_touch' in campaign_flow_df.columns:
    person_click_rate = campaign_flow_df.groupby('person_id')['email_click_to_open_rate_touch'].mean().reset_index()
    retention_analysis = pd.merge(persons_df[['person_id', 'active_retention_rate_month']], 
                                  person_click_rate, on='person_id', how='left')
    axes[1].scatter(retention_analysis['email_click_to_open_rate_touch'], 
                   retention_analysis['active_retention_rate_month'])
    axes[1].set_title('Email Click Rate vs Monthly Active Retention')
    axes[1].set_xlabel('Email Click-to-Open Rate')
    axes[1].set_ylabel('Monthly Active Retention Rate')
    axes[1].grid(True, alpha=0.3)

# Subject line length analysis
if 'campaign_subject_line' in events_df.columns:
    events_df['subject_length'] = events_df['campaign_subject_line'].str.len()
    subject_stats = events_df.groupby('campaign_subject_line').agg({
        'subject_length': 'first',
        'event_id': 'count'
    }).reset_index()
    
    axes[2].bar(range(len(subject_stats)), subject_stats['subject_length'])
    axes[2].set_title('Subject Line Length by Campaign')
    axes[2].set_xlabel('Campaign Subject Line')
    axes[2].set_ylabel('Character Count')
    axes[2].set_xticks(range(len(subject_stats)))
    axes[2].set_xticklabels([f"{row['campaign_subject_line'][:20]}..." 
                             for _, row in subject_stats.iterrows()], rotation=45, ha='right')
    
    # Add count labels
    for i, row in subject_stats.iterrows():
        axes[2].text(i, row['subject_length'] + 0.5, f"n={row['event_id']}", 
                    ha='center', va='bottom', fontsize=9)

plt.tight_layout()
retention_analysis_path = os.path.join(plots_dir, 'retention_analysis.png')
plt.savefig(retention_analysis_path, dpi=300, bbox_inches='tight')
