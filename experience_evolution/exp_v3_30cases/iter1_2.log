import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import seaborn as sns

# Set style for better visuals
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

# Connect to database
conn = sqlite3.connect('dacomp-090.sqlite')

# 1. High-risk customer identification and risk score distribution
print("Creating high-risk customer analysis visualizations...")

# Query high-risk customers (payment_rate_percentage < 75% and outstanding_balance > 15000)
high_risk_query = """
SELECT 
    customer_id,
    customer_name,
    payment_rate_percentage,
    outstanding_balance,
    credit_score,
    business_stability_score,
    customer_lifespan_days,
    total_invoices,
    avg_invoice_amount,
    (100 - payment_rate_percentage) * 0.4 + 
    (850 - credit_score) / 850 * 100 * 0.4 + 
    (100 - business_stability_score) * 0.2 as risk_score
FROM quickbooks__customer_analytics 
WHERE payment_rate_percentage < 75 AND outstanding_balance > 15000
"""

high_risk_df = pd.read_sql_query(high_risk_query, conn)

# Calculate total customers
total_customers_query = "SELECT COUNT(*) as total FROM quickbooks__customer_analytics"
total_customers = pd.read_sql_query(total_customers_query, conn)['total'][0]

print(f"Found {len(high_risk_df)} high-risk customers out of {total_customers} total customers")

# 1.1 Risk score distribution histogram
fig1, ax1 = plt.subplots(figsize=(10, 6))
ax1.hist(high_risk_df['risk_score'], bins=20, edgecolor='black', alpha=0.7)
ax1.axvline(x=high_risk_df['risk_score'].mean(), color='red', linestyle='--', 
           label=f'Mean: {high_risk_df["risk_score"].mean():.2f}')
ax1.set_xlabel('Risk Score (0-100)', fontsize=12)
ax1.set_ylabel('Number of Customers', fontsize=12)
ax1.set_title('Risk Score Distribution of High-Risk Customers', fontsize=14, fontweight='bold')
ax1.legend()
ax1.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('risk_score_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created risk_score_distribution.png")

# 1.2 Scatter plot: Risk score vs Outstanding Balance (to show exposure)
fig2, ax2 = plt.subplots(figsize=(10, 6))
scatter = ax2.scatter(high_risk_df['risk_score'], high_risk_df['outstanding_balance']/1000, 
                     c=high_risk_df['payment_rate_percentage'], cmap='RdYlGn_r',
                     alpha=0.6, s=50, edgecolors='black', linewidth=0.5)

ax2.set_xlabel('Risk Score (0-100)', fontsize=12)
ax2.set_ylabel('Outstanding Balance ($K)', fontsize=12)
ax2.set_title('Risk Score vs. Outstanding Balance (Color: Payment Rate %)', fontsize=14, fontweight='bold')

# Add colorbar
cbar = plt.colorbar(scatter)
cbar.set_label('Payment Rate Percentage (%)', fontsize=11)

# Highlight high-risk region
ax2.axvline(x=60, color='red', linestyle=':', alpha=0.5, label='High Risk Threshold (60)')

ax2.grid(True, alpha=0.3)
ax2.legend()
plt.tight_layout()
plt.savefig('risk_vs_balance.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created risk_vs_balance.png")

# 2. Collection rate trend over 12 months
print("Creating collection rate trend visualization...")
collection_query = """
SELECT 
    dashboard_month,
    collection_rate_percentage
FROM quickbooks__financial_dashboard
WHERE dashboard_month >= '2024-10-01' AND dashboard_month <= '2025-09-30'
ORDER BY dashboard_month
"""

collection_df = pd.read_sql_query(collection_query, conn)

# Ensure we have 12 months and sort
collection_df['month_str'] = pd.to_datetime(collection_df['dashboard_month']).dt.strftime('%Y-%m')
collection_df = collection_df.sort_values('dashboard_month').tail(12)

# Create line chart
fig3, ax3 = plt.subplots(figsize=(12, 6))
months = collection_df['month_str'].tolist()
rates = collection_df['collection_rate_percentage'].tolist()

# Create line plot
ax3.plot(months, rates, marker='o', linewidth=2, markersize=8, color='#2E86AB')

# Highlight deterioration streak (Dec 2024 - Feb 2025 based on Stage1 report)
deterioration_months = ['2024-12', '2025-01', '2025-02']
if all(m in months for m in deterioration_months):
    indices = [months.index(m) for m in deterioration_months]
    ax3.plot([months[i] for i in indices], [rates[i] for i in indices], 
             marker='s', linewidth=3, markersize=10, color='#D1495B', 
             label='3-Month Deterioration Streak')

# Add threshold line
ax3.axhline(y=50, color='red', linestyle='--', alpha=0.5, label='50% Threshold')

ax3.set_xlabel('Month', fontsize=12)
ax3.set_ylabel('Collection Rate Percentage (%)', fontsize=12)
ax3.set_title('Month-over-Month Collection Rate Trend (Last 12 Months)', fontsize=14, fontweight='bold')
ax3.legend()
ax3.grid(True, alpha=0.3)

# Rotate x-axis labels for better readability
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('collection_rate_trend.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created collection_rate_trend.png")

# 3. Comparative analysis: High-risk vs Normal customers
print("Creating comparative analysis visualizations...")

# Get normal customers (not high-risk) for comparison
normal_query = """
SELECT 
    customer_id,
    customer_lifespan_days,
    total_invoices,
    avg_invoice_amount,
    outstanding_balance
FROM quickbooks__customer_analytics 
WHERE NOT (payment_rate_percentage < 75 AND outstanding_balance > 15000)
"""

normal_df = pd.read_sql_query(normal_query, conn)

# Add category column
high_risk_df['category'] = 'High-Risk'
normal_df['category'] = 'Normal'

# Combine for comparison
comparison_df = pd.concat([high_risk_df[['category', 'customer_lifespan_days', 'total_invoices', 'avg_invoice_amount']],
                          normal_df[['category', 'customer_lifespan_days', 'total_invoices', 'avg_invoice_amount']]])

# 3.1 Comparative box plots
fig4, axes = plt.subplots(1, 3, figsize=(15, 5))
metrics = ['customer_lifespan_days', 'total_invoices', 'avg_invoice_amount']
metric_names = ['Customer Lifespan (Days)', 'Total Invoices', 'Average Invoice Amount ($)']
colors = ['#2E86AB', '#D1495B']

for idx, (metric, metric_name) in enumerate(zip(metrics, metric_names)):
    data = [comparison_df[comparison_df['category'] == 'High-Risk'][metric].dropna(), 
            comparison_df[comparison_df['category'] == 'Normal'][metric].dropna()]
    
    bp = axes[idx].boxplot(data, patch_artist=True, labels=['High-Risk', 'Normal'])
    
    # Color boxes
    for patch, color in zip(bp['boxes'], colors):
        patch.set_facecolor(color)
    
    axes[idx].set_title(f'{metric_name} Comparison', fontsize=12, fontweight='bold')
    axes[idx].set_ylabel(metric_name, fontsize=10)
    axes[idx].grid(True, alpha=0.3)

fig4.suptitle('Comparative Analysis: High-Risk vs. Normal Customers', fontsize=16, fontweight='bold')
plt.tight_layout()
plt.savefig('customer_comparison.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created customer_comparison.png")

# 4. Profitability tier analysis
print("Creating profitability tier visualization...")
profitability_query = """
SELECT 
    CASE 
        WHEN profitability_tier = 'Loss Making' THEN 'Loss Making'
        WHEN profitability_tier = 'Break Even' THEN 'Break Even'
        WHEN profitability_tier = 'Profitable' THEN 'Profitable'
        WHEN profitability_tier = 'Highly Profitable' THEN 'Highly Profitable'
        ELSE 'Other'
    END as tier,
    COUNT(*) as count
FROM quickbooks__profitability_analysis
GROUP BY tier
ORDER BY 
    CASE tier
        WHEN 'Loss Making' THEN 1
        WHEN 'Break Even' THEN 2
        WHEN 'Profitable' THEN 3
        WHEN 'Highly Profitable' THEN 4
        ELSE 5
    END
"""

profitability_df = pd.read_sql_query(profitability_query, conn)

# Create bar chart
fig5, ax5 = plt.subplots(figsize=(10, 6))
bars = ax5.bar(profitability_df['tier'], profitability_df['count'], 
               color=['#D1495B', '#EDAE49', '#2E86AB', '#59CD90'])

ax5.set_xlabel('Profitability Tier', fontsize=12)
ax5.set_ylabel('Number of Customers', fontsize=12)
ax5.set_title('Customer Distribution by Profitability Tier', fontsize=14, fontweight='bold')

# Add count labels on bars
for bar in bars:
    height = bar.get_height()
    ax5.text(bar.get_x() + bar.get_width()/2., height + 5,
            f'{height:,}', ha='center', va='bottom', fontsize=10)

ax5.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('profitability_tiers.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created profitability_tiers.png")

# 5. Cash flow forecast for next 6 months
print("Creating cash flow forecast visualization...")
cashflow_query = """
SELECT 
    forecast_month,
    forecasted_net_cash_flow
FROM quickbooks__cashflow_forecast
WHERE forecast_month >= '2025-10-01'
ORDER BY forecast_month
LIMIT 6
"""

cashflow_df = pd.read_sql_query(cashflow_query, conn)

if not cashflow_df.empty:
    fig6, ax6 = plt.subplots(figsize=(10, 6))
    
    # Convert dates to month names
    cashflow_df['month'] = pd.to_datetime(cashflow_df['forecast_month']).dt.strftime('%b %Y')
    
    ax6.plot(cashflow_df['month'], cashflow_df['forecasted_net_cash_flow'], 
             marker='o', linewidth=2, markersize=8, color='#2E86AB')
    
    # Fill area under line
    ax6.fill_between(cashflow_df['month'], cashflow_df['forecasted_net_cash_flow'], 
                     alpha=0.2, color='#2E86AB')
    
    ax6.set_xlabel('Month', fontsize=12)
    ax6.set_ylabel('Net Cash Flow ($)', fontsize=12)
    ax6.set_title('6-Month Cash Flow Forecast', fontsize=14, fontweight='bold')
    
    # Add value labels
    for x, y in zip(cashflow_df['month'], cashflow_df['forecasted_net_cash_flow']):
        ax6.text(x, y + 500, f'${y:,.0f}', ha='center', va='bottom', fontsize=10)
    
    ax6.grid(True, alpha=0.3)
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig('cashflow_forecast.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created cashflow_forecast.png")
else:
    print("No cash flow forecast data found for next 6 months")

# Create tiered risk segmentation visualization based on Stage1 report
print("Creating tiered risk segmentation visualization...")

# Create risk tiers based on Stage1 report
high_risk_df['risk_tier'] = pd.cut(high_risk_df['risk_score'], 
                                   bins=[0, 45, 60, 100], 
                                   labels=['Green Zone (< 45)', 'Yellow Zone (45-60)', 'Red Zone (> 60)'])

tier_counts = high_risk_df['risk_tier'].value_counts().sort_index()

fig7, ax7 = plt.subplots(figsize=(10, 6))
colors = ['#59CD90', '#EDAE49', '#D1495B']
bars = ax7.bar([str(x) for x in tier_counts.index], tier_counts.values, color=colors)

ax7.set_xlabel('Risk Tier', fontsize=12)
ax7.set_ylabel('Number of Customers', fontsize=12)
ax7.set_title('High-Risk Customer Segmentation by Risk Score', fontsize=14, fontweight='bold')

# Add percentage labels
total_high_risk = len(high_risk_df)
for bar in bars:
    height = bar.get_height()
    percentage = (height / total_high_risk) * 100
    ax7.text(bar.get_x() + bar.get_width()/2., height + 2,
            f'{height} ({percentage:.1f}%)', ha='center', va='bottom', fontsize=10)

ax7.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('risk_tier_segmentation.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created risk_tier_segmentation.png")

# 6. Outstanding balance by risk tier
print("Creating outstanding balance by risk tier visualization...")

if 'risk_tier' in high_risk_df.columns:
    tier_balance = high_risk_df.groupby('risk_tier')['outstanding_balance'].sum().sort_index()
    
    fig8, ax8 = plt.subplots(figsize=(10, 6))
    colors = ['#59CD90', '#EDAE49', '#D1495B']
    bars = ax8.bar([str(x) for x in tier_balance.index], tier_balance.values / 1000000, color=colors)
    
    ax8.set_xlabel('Risk Tier', fontsize=12)
    ax8.set_ylabel('Total Outstanding Balance ($M)', fontsize=12)
    ax8.set_title('Total Outstanding Balance by Risk Tier ($M)', fontsize=14, fontweight='bold')
    
    # Add value labels
    for bar in bars:
        height = bar.get_height()
        ax8.text(bar.get_x() + bar.get_width()/2., height + 0.2,
                f'${height:.2f}M', ha='center', va='bottom', fontsize=10)
    
    ax8.grid(True, axis='y', alpha=0.3)
    plt.tight_layout()
    plt.savefig('balance_by_risk_tier.png', dpi=300, bbox_inches='tight')
    plt.close()
    
    print("Created balance_by_risk_tier.png")

conn.close()

print("All visualizations created successfully!")
