import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-060.sqlite')
query = 'SELECT ad_group_id, ad_group_name, campaign_name, SUM(clicks) as clicks, SUM(impressions) as impressions, SUM(conversions) as conversions FROM google_ads__ad_group_report GROUP BY ad_group_id, ad_group_name, campaign_name'
df = pd.read_sql_query(query, conn)
conn.close()
df['ctr'] = df['clicks'] / df['impressions']
df['cvr'] = df['conversions'] / df['clicks']
df = df.dropna(subset=['ctr', 'cvr'])
ctr_75 = df['ctr'].quantile(0.75)
cvr_25 = df['cvr'].quantile(0.25)
print('CTR 75th percentile:', ctr_75)
print('CVR 25th percentile:', cvr_25)
problematic = df[(df['ctr'] > ctr_75) & (df['cvr'] < cvr_25)]
print('Number of problematic ad groups:', len(problematic))
print('Problematic ad groups:')
print(problematic[['ad_group_id', 'campaign_name', 'ctr', 'cvr']].head(20))
")
