import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('buyback_analysis.db')
df = pd.read_sql_query("SELECT * FROM autohome_cleaned WHERE Depreciation_Ratio IS NOT NULL", conn)
conn.close()

print(f"Rows with depreciation ratio: {len(df)}")

# Normalize metrics: higher is better for buyback
# Depreciation ratio: higher is better (0-1)
# Age: lower is better, invert (max_age - age)
# Mileage: lower is better, invert (max_mileage - mileage)
# Price: medium range? Actually we want moderate price for turnover, not too high.
# Let's assign weight: 40% depreciation ratio, 30% age, 20% mileage, 10% price (lower price better for turnover)
# Compute normalized scores 0-1

max_age = df['Age_years'].max()
max_mileage = df['Mileage_clean'].max()
max_price = df['Price_clean'].max()

df['score_dep'] = df['Depreciation_Ratio']  # already 0-1
df['score_age'] = 1 - (df['Age_years'] / max_age)  # newer cars get higher score
df['score_mileage'] = 1 - (df['Mileage_clean'] / max_mileage)
df['score_price'] = 1 - (df['Price_clean'] / max_price)  # lower price better for turnover

weights = {'dep': 0.4, 'age': 0.3, 'mileage': 0.2, 'price': 0.1}
df['buyback_score'] = (df['score_dep'] * weights['dep'] + 
                       df['score_age'] * weights['age'] + 
                       df['score_mileage'] * weights['mileage'] + 
                       df['score_price'] * weights['price'])

# Rank individual listings
df_sorted = df.sort_values('buyback_score', ascending=False)
print("\nTop 20 individual listings by buyback score:")
print(df_sorted[['Title', 'Brand', 'Model_Group', 'Depreciation_Ratio', 'Age_years', 'Mileage_clean', 'Price_clean', 'buyback_score']].head(20).to_string())

# Group by model to recommend models overall
model_stats = df.groupby('Model_Group').agg(
    count=('Depreciation_Ratio', 'size'),
    avg_dep=('Depreciation_Ratio', 'mean'),
    avg_age=('Age_years', 'mean'),
    avg_mileage=('Mileage_clean', 'mean'),
    avg_price=('Price_clean', 'mean'),
    avg_score=('buyback_score', 'mean')
).round(4)

model_stats = model_stats[model_stats['count'] >= 3].sort_values('avg_score', ascending=False)
print("\nTop 20 models (count >=3) by average buyback score:")
print(model_stats.head(20).to_string())

# Also compute by brand
brand_stats = df.groupby('Brand').agg(
    count=('Depreciation_Ratio', 'size'),
    avg_dep=('Depreciation_Ratio', 'mean'),
    avg_age=('Age_years', 'mean'),
    avg_mileage=('Mileage_clean', 'mean'),
    avg_price=('Price_clean', 'mean'),
    avg_score=('buyback_score', 'mean')
).round(4)

brand_stats = brand_stats[brand_stats['count'] >= 5].sort_values('avg_score', ascending=False)
print("\nTop brands (count >=5) by average buyback score:")
print(brand_stats.head(15).to_string())

# Save for reporting
df_sorted.to_csv('ranked_listings.csv', index=False)
model_stats.to_csv('model_scores.csv')
brand_stats.to_csv('brand_scores.csv')
''')
