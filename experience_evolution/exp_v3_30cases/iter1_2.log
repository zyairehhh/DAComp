plt.figure(figsize=(10, 6))
plt.bar(x - width/2, low_margin_means.values, width, label='Low-Margin Orders', color='red')
plt.bar(x + width/2, normal_means.values, width, label='Normal Orders', color='blue')
plt.xlabel('Cost Component')
plt.ylabel('Cost per Unit (currency)')
plt.title('Per-Unit Cost Comparison: Low-Margin vs Normal Orders')
plt.xticks(x, categories, rotation=15)
plt.legend()
plt.grid(True, alpha=0.3, axis='y')
plt.tight_layout()
plt.savefig('plots/per_unit_cost_comparison.png', dpi=300)
plt.close()

# 3. Discount Behavior
plt.figure(figsize=(10, 6))
# Calculate discount ratio
df['Discount_ratio'] = df['Discount Amount'] / df['List Price Revenue'] * 100  # in percentage

# Boxplot of discount ratio
box_data = [df[df['low_margin_flag'] == 1]['Discount_ratio'].dropna(), 
            df[df['low_margin_flag'] == 0]['Discount_ratio'].dropna()]
plt.boxplot(box_data, labels=['Low-Margin Orders', 'Normal Orders'])
plt.ylabel('Discount Ratio (%)')
plt.title('Discount Behavior: Low-Margin vs Normal Orders')
plt.grid(True, alpha=0.3, axis='y')
plt.tight_layout()
plt.savefig('plots/discount_behavior.png', dpi=300)
plt.close()

# 4. Top destinations with high low-margin rates
# Calculate low-margin rate by destination (only for destinations with sufficient orders)
destination_stats = df.groupby('Destination').agg(
    total_orders=('low_margin_flag', 'size'),
    low_margin_orders=('low_margin_flag', 'sum')
).reset_index()
destination_stats['low_margin_rate'] = destination_stats['low_margin_orders'] / destination_stats['total_orders'] * 100

# Filter for destinations with at least 100 orders
top_destinations = destination_stats[destination_stats['total_orders'] >= 100].sort_values('low_margin_rate', ascending=False)

plt.figure(figsize=(12, 6))
bars = plt.bar(top_destinations['Destination'].head(10), top_destinations['low_margin_rate'].head(10), color='coral')
plt.xlabel('Destination')
plt.ylabel('Low-Margin Rate (%)')
plt.title('Top 10 Destinations with Highest Low-Margin Rates (≥100 orders)')
plt.xticks(rotation=45, ha='right')
plt.grid(True, alpha=0.3, axis='y')

# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.1,
            f'{height:.1f}%', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('plots/destination_low_margin_rates.png', dpi=300)
plt.close()

print("Visualization script created successfully")
''')
