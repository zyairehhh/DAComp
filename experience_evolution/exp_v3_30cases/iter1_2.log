```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from scipy import stats

# Connect to database
conn = sqlite3.connect('dacomp-076.sqlite')

# Load customer data
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)

# Calculate anomaly flag based on retention_probability deviation from segment average
segment_avg_retention = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg_retention.columns = ['profitability_segment', 'segment_avg_retention']
df = df.merge(segment_avg_retention, on='profitability_segment')
df['retention_deviation'] = df['retention_probability'] - df['segment_avg_retention']
df['is_anomaly'] = abs(df['retention_deviation']) > 0.15

# Calculate seasonal concentration (HHI)
df['total_transactions'] = df['q1_transactions'] + df['q2_transactions'] + df['q3_transactions'] + df['q4_transactions']
df['q1_share'] = df['q1_transactions'] / df['total_transactions']
df['q2_share'] = df['q2_transactions'] / df['total_transactions']
df['q3_share'] = df['q3_transactions'] / df['total_transactions']
df['q4_share'] = df['q4_transactions'] / df['total_transactions']
df['seasonal_hhi'] = df['q1_share']**2 + df['q2_share']**2 + df['q3_share']**2 + df['q4_share']**2

# Close connection
conn.close()

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

print(f"Total customers: {len(df)}")
print(f"Anomaly customers: {df['is_anomaly'].sum()} ({df['is_anomaly'].mean():.1%})")
print(f"Segment distribution:")
print(df['profitability_segment'].value_counts())
```
