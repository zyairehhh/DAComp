import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-093.sqlite')

# Helper functions for categorizations
def categorize_subject(subject):
    if subject is None:
        return None
    subject_lower = subject.lower()
    if 'discount' in subject_lower or 'sale' in subject_lower or '% off' in subject_lower:
        return 'discount'
    elif 'new' in subject_lower or 'launch' in subject_lower or 'announcing' in subject_lower:
        return 'new'
    else:
        return 'storytelling'

def categorize_day_type(sent_at):
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        weekday = date_obj.weekday()  # Monday=0, Sunday=6
        return 'weekday' if weekday < 5 else 'weekend'
    except:
        return None

def categorize_time_period(sent_at):
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        hour = date_obj.hour
        if hour < 12:
            return 'morning'
        elif hour < 18:
            return 'afternoon'
        else:
            return 'evening'
    except:
        return None

def categorize_holiday(sent_at):
    # Simplified: treat as non_holiday for now; actual holiday logic would need a calendar
    # Since Stage1 only used non_holiday vs pre_holiday, we need to approximate
    # For demonstration, we'll use a mock: pre_holiday if day of month <= 5 else non_holiday
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        if date_obj.day <= 5:
            return 'pre_holiday'
        else:
            return 'non_holiday'
    except:
        return None

# Load campaigns data
query = "SELECT campaign_id, SUBJECT, is_archived, variation_id, total_count_unique_people, count_received_email, count_opened_email, count_clicked_email, count_placed_order, gmv_gross, gmv_net, email_open_rate, email_click_to_open_rate, SENT_AT FROM klaviyo__campaigns"
df = pd.read_sql_query(query, conn)
print(f"Loaded {len(df)} campaigns")

# Apply categorizations
df['subject_category'] = df['SUBJECT'].apply(categorize_subject)
df['day_type'] = df['SENT_AT'].apply(categorize_day_type)
df['time_period'] = df['SENT_AT'].apply(categorize_time_period)
df['holiday_period'] = df['SENT_AT'].apply(categorize_holiday)

# Remove any rows where key categorization is missing
df = df.dropna(subset=['subject_category', 'day_type', 'time_period', 'holiday_period'])

print("Categorization complete.")
print(df.head())

# Close connection
conn.close()
```
