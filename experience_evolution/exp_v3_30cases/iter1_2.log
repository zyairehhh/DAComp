import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('./dacomp-060.sqlite')

# Load aggregated ad groups
query = """
SELECT
    ad_group_id,
    ad_group_name,
    ad_group_type,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions,
    SUM(spend) AS total_spend
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name, ad_group_type
HAVING total_impressions > 0 AND total_clicks > 0
"""
df = pd.read_sql(query, conn)
df['CTR'] = df['total_clicks'] / df['total_impressions']
df['CVR'] = df['total_conversions'] / df['total_clicks']
df['CVR'] = df['CVR'].fillna(0)

ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
overall_cvr = df['total_conversions'].sum() / df['total_clicks'].sum()
problematic['Intent_Match_Ratio'] = problematic['CVR'] / overall_cvr

print("=== Problematic Ad Groups Summary ===")
print(f"Count: {len(problematic)}")
print(f"Percentage of all ad groups: {len(problematic)/len(df)*100:.2f}%")
print(f"CTR threshold (75th): {ctr_75:.4f}")
print(f"CVR threshold (25th): {cvr_25:.4f}")
print(f"Overall avg CVR: {overall_cvr:.4f}")
print()

# Distribution of CVR
print("CVR distribution in problematic groups:")
print(problematic['CVR'].describe())
print()
zero_cvr = problematic[problematic['CVR'] == 0]
print(f"Number of problematic groups with zero conversions: {len(zero_cvr)}")
print(f"Number with CVR > 0 but < 25th percentile: {len(problematic) - len(zero_cvr)}")
print()

# Intent Match Ratio distribution
print("Intent Match Ratio distribution:")
print(problematic['Intent_Match_Ratio'].describe())
print()

# Spend and ROI? Not enough columns for value. But we can compute cost per conversion?
if 'total_spend' in problematic.columns:
    problematic['CPA'] = problematic['total_spend'] / problematic['total_conversions']
    problematic['CPA'] = problematic['CPA'].replace([np.inf, -np.inf], np.nan)
    print("Average CPA for problematic groups (excluding zero conversions):")
    print(problematic[problematic['total_conversions']>0]['CPA'].describe())
    print()

# Compare with non-problematic high CTR groups (CTR > 75th but CVR >= 25th)
high_ctr_good = df[(df['CTR'] > ctr_75) & (df['CVR'] >= cvr_25)]
print(f"Number of high CTR but good CVR groups: {len(high_ctr_good)}")
print(f"Average CVR of high-CTR good groups: {high_ctr_good['CVR'].mean():.4f}")
print(f"Average CTR of high-CTR good groups: {high_ctr_good['CTR'].mean():.4f}")
print()

# Keyword match type analysis
search_query = """
SELECT ad_group_id, keyword_match_type,
       SUM(clicks) as clicks, SUM(conversions) as conversions
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
keyword_df = pd.read_sql(search_query, conn)
keyword_df['cvr'] = keyword_df['conversions'] / keyword_df['clicks']
keyword_df['cvr'] = keyword_df['cvr'].fillna(0)

# Merge with problematic
keyword_problematic = keyword_df[keyword_df['ad_group_id'].isin(problematic['ad_group_id'])]
if not keyword_problematic.empty:
    print("Keyword match type distribution for problematic groups:")
    match_summary = keyword_problematic.groupby('keyword_match_type').agg({'clicks': 'sum', 'conversions': 'sum'}).reset_index()
    match_summary['cvr'] = match_summary['conversions'] / match_summary['clicks']
    print(match_summary)
    print()

# Compare with high-CTR good groups
keyword_good = keyword_df[keyword_df['ad_group_id'].isin(high_ctr_good['ad_group_id'])]
if not keyword_good.empty:
    print("Keyword match type distribution for high-CTR good groups:")
    match_summary_good = keyword_good.groupby('keyword_match_type').agg({'clicks': 'sum', 'conversions': 'sum'}).reset_index()
    match_summary_good['cvr'] = match_summary_good['conversions'] / match_summary_good['clicks']
    print(match_summary_good)
    print()

# Search term relevance: compute variance of CVR per search term within each ad group
search_query2 = """
SELECT ad_group_id, search_term,
       SUM(clicks) as clicks, SUM(conversions) as conversions
FROM google_ads__search_term_report
GROUP BY ad_group_id, search_term
HAVING clicks > 0
"""
search_df = pd.read_sql(search_query2, conn)
search_df['cvr'] = search_df['conversions'] / search_df['clicks']
search_df['cvr'] = search_df['cvr'].fillna(0)

# Compute standard deviation of CVR per ad group (measure of traffic quality consistency)
cvr_std = search_df.groupby('ad_group_id')['cvr'].std().reset_index(name='cvr_std')
# Merge with problematic
problematic_with_std = problematic.merge(cvr_std, on='ad_group_id', how='left')
print("Search term CVR standard deviation for problematic groups:")
print(problematic_with_std['cvr_std'].describe())
print()

# Compare with high-CTR good groups
good_with_std = high_ctr_good.merge(cvr_std, on='ad_group_id', how='left')
print("Search term CVR standard deviation for high-CTR good groups:")
print(good_with_std['cvr_std'].describe())
print()

conn.close()
```
