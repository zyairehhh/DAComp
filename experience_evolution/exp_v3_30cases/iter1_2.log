# Load visitor with high-value label as before
query = '''
SELECT 
    v.*,
    COALESCE(f.num_features, 0) AS num_features,
    COALESCE(f.total_clicks, 0) AS total_clicks,
    COALESCE(d.recency_days, 0) AS recency_days,
    COALESCE(d.tenure_days, 0) AS tenure_days
FROM pendo__visitor v
LEFT JOIN (
    SELECT visitor_id, 
           COUNT(DISTINCT feature_id) AS num_features,
           SUM(sum_clicks) AS total_clicks
    FROM pendo__visitor_feature
    GROUP BY visitor_id
) f ON v.visitor_id = f.visitor_id
LEFT JOIN (
    SELECT visitor_id,
           CAST((JULIANDAY('now') - JULIANDAY(MAX(date_day))) AS INTEGER) AS recency_days,
           CAST((JULIANDAY(MAX(date_day)) - JULIANDAY(MIN(date_day))) AS INTEGER) AS tenure_days
    FROM pendo__visitor_daily_metrics
    GROUP BY visitor_id
) d ON v.visitor_id = d.visitor_id
'''
visitor_df = pd.read_sql_query(query, conn)
threshold_minutes = visitor_df['sum_minutes'].quantile(0.8)
threshold_events = visitor_df['sum_events'].quantile(0.8)
visitor_df['high_value'] = (visitor_df['sum_minutes'] >= threshold_minutes) & (visitor_df['sum_events'] >= threshold_events)

# Group comparison
high = visitor_df[visitor_df['high_value']]
low = visitor_df[~visitor_df['high_value']]

print("Mean values for high-value vs non-high-value visitors:")
features = ['sum_minutes', 'sum_events', 'latest_nps_rating', 'count_active_days', 
            'count_active_months', 'average_daily_minutes', 'average_daily_events',
            'num_features', 'total_clicks', 'recency_days', 'tenure_days']
for f in features:
    mean_high = high[f].mean()
    mean_low = low[f].mean()
    diff = mean_high - mean_low
    pct = diff / mean_low * 100 if mean_low != 0 else np.nan
    print(f'{f:25s} High: {mean_high:8.2f}, Low: {mean_low:8.2f}, Diff: {diff:8.2f} ({pct:.1f}%)')

# Compute effect size (Cohen's d)
def cohen_d(group1, group2):
    n1, n2 = len(group1), len(group2)
    s1, s2 = group1.std(ddof=1), group2.std(ddof=1)
    pooled_std = np.sqrt(((n1-1)*s1**2 + (n2-1)*s2**2) / (n1 + n2 - 2))
    d = (group1.mean() - group2.mean()) / pooled_std
    return d

print("\nEffect size (Cohen's d) for each feature:")
for f in features:
    d = cohen_d(high[f], low[f])
    print(f'{f:25s} d = {d:.3f}')

# Compute approximate t-test using manual calculation (for p-value we need scipy, skip)
# Instead compute overlap (common language effect size)
print("\nCommon language effect size (probability that high-value > non-high-value):")
for f in features:
    sample_high = high[f].sample(min(1000, len(high)), random_state=42)
    sample_low = low[f].sample(min(1000, len(low)), random_state=42)
    prob = (sample_high.values > sample_low.values[:, None]).mean()
    print(f'{f:25s} P(High > Low) = {prob:.3f}')

# Examine num_features and total_clicks: why zero? Let's see distribution
print("\nDistribution of num_features:")
print(visitor_df['num_features'].value_counts().head())
print("\nDistribution of total_clicks:")
print(visitor_df['total_clicks'].value_counts().head())

conn.close()
