import pandas as pd
import numpy as np

target = pd.read_csv('target_features_full.csv')
print("Dataset shape:", target.shape)

features = ['total_conv', 'neg_proportion', 'p50_time_to_last_close_min', 'p50_reopens', 'feature_adoption_coverage']
