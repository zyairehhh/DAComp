Action: CreateFile(filepath='segment_analysis.py':
'''
import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-017.sqlite')

# Load RFM segments
rfm = pd.read_csv('rfm_home_furniture.csv')
core_customers = set(rfm[rfm['Segment'] == 'Core']['CustomerID'])

# Query orders with shipping cost, discount, profit, sales, customer, month
query = '''
SELECT 
    "Customer ID",
    strftime('%Y-%m', "Order Date") as month,
    profit,
    Sales,
    "Shipping Cost",
    "Discount"
FROM order_information
WHERE "Product Category" = 'Home & Furniture'
'''
df = pd.read_sql_query(query, conn)
conn.close()

# Convert numeric
def to_float(x):
    if isinstance(x, str):
        x = x.replace(',', '').strip()
        if x == '':
            return 0.0
        try:
            return float(x)
        except:
            return 0.0
    elif x is None:
        return 0.0
    else:
        return float(x)

df['Shipping Cost_num'] = df['Shipping Cost'].apply(to_float)
df['Discount_num'] = df['Discount'].apply(to_float)

# Add segment column
df['Segment'] = df['Customer ID'].apply(lambda x: 'Core' if x in core_customers else 'Regular')

# Aggregate by month and segment
agg = df.groupby(['month', 'Segment']).agg({
    'profit': 'sum',
    'Sales': 'sum',
    'Shipping Cost_num': 'mean',
    'Discount_num': 'mean',
    'Customer ID': 'count'  # order count
}).reset_index()
agg['profit_margin'] = agg['profit'] / agg['Sales']
agg.rename(columns={'Customer ID': 'order_count'}, inplace=True)

print("Monthly aggregated metrics by segment:")
print(agg.head(20))

# For each segment, compute correlation between profit_margin and shipping cost, discount
segments = agg['Segment'].unique()
for seg in segments:
    sub = agg[agg['Segment'] == seg]
    corr_shipping = sub['profit_margin'].corr(sub['Shipping Cost_num'])
    corr_discount = sub['profit_margin'].corr(sub['Discount_num'])
    print(f"Segment {seg}: Correlation profit_margin vs shipping cost: {corr_shipping:.4f}")
    print(f"Segment {seg}: Correlation profit_margin vs discount: {corr_discount:.4f}")

# Also compute overall correlation for comparison
overall_corr_shipping = agg['profit_margin'].corr(agg['Shipping Cost_num'])
overall_corr_discount = agg['profit_margin'].corr(agg['Discount_num'])
print(f"\nOverall (both segments combined) correlation profit_margin vs shipping cost: {overall_corr_shipping:.4f}")
print(f"Overall correlation profit_margin vs discount: {overall_corr_discount:.4f}")

# Compute average profit margin per segment
avg_margin = agg.groupby('Segment')['profit_margin'].mean()
print(f"\nAverage profit margin per segment:")
print(avg_margin)

# Check whether core consumers have higher or lower sensitivity (higher absolute correlation?)
# Also examine month-to-month margin changes per segment
''')
