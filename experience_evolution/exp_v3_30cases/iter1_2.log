import pandas as pd
import numpy as np
import sqlite3
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-057.sqlite')
df = pd.read_sql_query("SELECT * FROM google_ads__customer_acquisition_analysis", conn)
df['date_day'] = pd.to_datetime(df['date_day'])

campaign_cols = ['account_id', 'advertising_channel_type', 'campaign_lifecycle_stage']
grouped = df.groupby(campaign_cols)

campaign_data = []
for name, group in grouped:
    group = group.sort_values('date_day')
    if len(group) < 10:
        continue
    # trend slopes as before
    x = np.arange(len(group))
    y_cac = group['customer_acquisition_cost'].values
    y_ratio = group['ltv_cac_ratio'].values
    slope_cac, _ = np.polyfit(x, y_cac, 1)
    slope_ratio, _ = np.polyfit(x, y_ratio, 1)
    avg_cac = np.mean(y_cac)
    avg_ratio = np.mean(y_ratio)
    slope_cac_pct = slope_cac / avg_cac if avg_cac != 0 else np.nan
    slope_ratio_pct = slope_ratio / avg_ratio if avg_ratio != 0 else np.nan
    
    # recent 30-day comparison
    latest_date = df['date_day'].max()
    last_start = latest_date - timedelta(days=30)
    prev_start = last_start - timedelta(days=30)
    last_sub = group[group['date_day'] >= last_start]
    prev_sub = group[(group['date_day'] >= prev_start) & (group['date_day'] < last_start)]
    if len(last_sub) >= 1 and len(prev_sub) >= 1:
        cac_growth = (last_sub['customer_acquisition_cost'].mean() - prev_sub['customer_acquisition_cost'].mean()) / prev_sub['customer_acquisition_cost'].mean() if prev_sub['customer_acquisition_cost'].mean() != 0 else np.nan
        ratio_decline = (last_sub['ltv_cac_ratio'].mean() - prev_sub['ltv_cac_ratio'].mean()) / prev_sub['ltv_cac_ratio'].mean() if prev_sub['ltv_cac_ratio'].mean() != 0 else np.nan
    else:
        cac_growth = np.nan
        ratio_decline = np.nan
    
    # other metrics
    account_maturity = group['account_maturity_stage'].mode().iloc[0] if group['account_maturity_stage'].notna().any() else None
    customer_maturity = group['customer_maturity_stage'].mode().iloc[0] if group['customer_maturity_stage'].notna().any() else None
    avg_soph = group['acquisition_sophistication_score'].mean()
    avg_cac_eff = group['cac_efficiency_percentile'].mean()
    avg_channel_div = group['channel_diversity_count'].mean()
    avg_retention_risk = group['retention_risk'].mean()
    avg_scale_opp = group['scale_opportunity'].mean()
    strategic_seg = group['strategic_customer_segment'].mode().iloc[0] if group['strategic_customer_segment'].notna().any() else None
    duration = (group['date_day'].max() - group['date_day'].min()).days
    active_last_30 = group['date_day'].max() >= (df['date_day'].max() - timedelta(days=30))
    
    # Define decay risk flag: 1 if recent CAC growth > 10% AND recent ratio decline < -10%
    recent_risk = 1 if (not np.isnan(cac_growth) and not np.isnan(ratio_decline) and cac_growth > 0.10 and ratio_decline < -0.10) else 0
    # Alternative: trend risk
    trend_risk = 1 if (not np.isnan(slope_cac_pct) and not np.isnan(slope_ratio_pct) and slope_cac_pct > 0.10 and slope_ratio_pct < -0.10) else 0
    # Combined risk
    combined_risk = 1 if recent_risk == 1 or trend_risk == 1 else 0
    
    campaign_data.append({
        'account_id': name[0],
        'advertising_channel_type': name[1],
        'campaign_lifecycle_stage': name[2],
        'account_maturity_stage': account_maturity,
        'customer_maturity_stage': customer_maturity,
        'duration_days': duration,
        'active_last_30': active_last_30,
        'cac_growth_recent': cac_growth,
        'ratio_decline_recent': ratio_decline,
        'slope_cac_pct': slope_cac_pct,
        'slope_ratio_pct': slope_ratio_pct,
        'avg_cac': avg_cac,
        'avg_ltv_cac_ratio': avg_ratio,
        'acquisition_sophistication_score': avg_soph,
        'cac_efficiency_percentile': avg_cac_eff,
        'channel_diversity_count': avg_channel_div,
        'retention_risk': avg_retention_risk,
        'scale_opportunity': avg_scale_opp,
        'strategic_customer_segment': strategic_seg,
        'recent_decay_risk': recent_risk,
        'trend_decay_risk': trend_risk,
        'combined_decay_risk': combined_risk
    })

campaign_df = pd.DataFrame(campaign_data)
print(f"Total campaigns analyzed: {len(campaign_df)}")
print(f"Campaigns with recent decay risk (CAC growth>10% and ratio decline<-10%): {campaign_df['recent_decay_risk'].sum()}")
print(f"Campaigns with trend decay risk (slope CAC>10% and ratio slope<-10%): {campaign_df['trend_decay_risk'].sum()}")
print(f"Campaigns with combined decay risk: {campaign_df['combined_decay_risk'].sum()}")

# Save for further analysis
campaign_df.to_csv('campaign_decay_risk.csv', index=False)

# Analyze which factors are associated with decay risk
print("\nBreakdown by advertising channel type:")
