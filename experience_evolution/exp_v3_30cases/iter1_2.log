'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-098/stage1_env/dacomp-098.sqlite')

# Load conversations with tags
query = '''
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.all_conversation_tags,
    ce.all_conversation_contacts AS contact_id,
    cm.first_admin_response_at,
    cm.time_to_first_response_minutes
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm USING (conversation_id)
WHERE ce.all_conversation_tags IS NOT NULL
'''
df = pd.read_sql_query(query, conn)

# Parse tags
def extract_tag(tags, key):
    if pd.isna(tags):
        return ''
    parts = tags.split('|')
    for p in parts:
        if p.startswith(key + ':'):
            return p.split(':', 1)[1]
    return ''

df['path'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'path'))
df['stage'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'topic'))
df['responder_type'] = df['path'].apply(lambda x: 'bot' if x == 'bot_first' else 'human' if x == 'human_first' else 'unknown')

# Determine first responder type per contact
df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
df = df.sort_values(['contact_id', 'conversation_created_at'])
contact_first = df.groupby('contact_id').first().reset_index()
contact_first = contact_first[['contact_id', 'responder_type']]
contact_first.rename(columns={'responder_type': 'first_responder_type'}, inplace=True)

# For each contact, get earliest timestamp of each stage
stages = ['demo_booked', 'trial_activated', 'closed_won']
contact_stages = {}
for s in stages:
    stage_df = df[df['stage'] == s].sort_values(['contact_id', 'conversation_created_at'])
    if len(stage_df) == 0:
        continue
    first_occurrence = stage_df.groupby('contact_id').first().reset_index()[['contact_id', 'conversation_created_at']]
    first_occurrence.rename(columns={'conversation_created_at': f'{s}_at'}, inplace=True)
    contact_stages[s] = first_occurrence

# Merge all stage timestamps
contact_timeline = contact_first.copy()
for s in stages:
    if s in contact_stages:
        contact_timeline = contact_timeline.merge(contact_stages[s], on='contact_id', how='left')
    else:
        contact_timeline[f'{s}_at'] = pd.NaT

# Convert to datetime
for s in stages:
    contact_timeline[f'{s}_at'] = pd.to_datetime(contact_timeline[f'{s}_at'])

# Compute durations (in days)
# 1. first response to demo booked: need first_admin_response_at per contact? Use earliest conversation's first_admin_response_at.
# For simplicity, we can use first_admin_response_at from first conversation.
first_response_df = df.groupby('contact_id').first().reset_index()[['contact_id', 'first_admin_response_at']]
first_response_df['first_admin_response_at'] = pd.to_datetime(first_response_df['first_admin_response_at'])
contact_timeline = contact_timeline.merge(first_response_df, on='contact_id', how='left')

# Compute durations if both timestamps exist
contact_timeline['first_response_to_demo_days'] = (
    contact_timeline['demo_booked_at'] - contact_timeline['first_admin_response_at']
).dt.total_seconds() / (24*3600)
contact_timeline['demo_to_trial_days'] = (
    contact_timeline['trial_activated_at'] - contact_timeline['demo_booked_at']
).dt.total_seconds() / (24*3600)
contact_timeline['trial_to_paid_days'] = (
    contact_timeline['closed_won_at'] - contact_timeline['trial_activated_at']
).dt.total_seconds() / (24*3600)

# Compute average durations per first_responder_type
print("Average stage durations (days) by first responder type:")
duration_metrics = ['first_response_to_demo_days', 'demo_to_trial_days', 'trial_to_paid_days']
for rt in contact_timeline['first_responder_type'].unique():
    subset = contact_timeline[contact_timeline['first_responder_type'] == rt]
    print(f"Responder type: {rt}")
    for metric in duration_metrics:
        values = subset[metric].dropna()
        if len(values) > 0:
            avg = values.mean()
            count = len(values)
            print(f"  {metric}: {avg:.2f} days (n={count})")
        else:
            print(f"  {metric}: No data")

# Also compute median and IQR
print("\nMedian and IQR:")
for rt in contact_timeline['first_responder_type'].unique():
    subset = contact_timeline[contact_timeline['first_responder_type'] == rt]
    print(f"Responder type: {rt}")
    for metric in duration_metrics:
        values = subset[metric].dropna()
        if len(values) > 0:
            median = values.median()
            q25 = values.quantile(0.25)
            q75 = values.quantile(0.75)
            print(f"  {metric}: median={median:.2f}, Q1={q25:.2f}, Q3={q75:.2f}")

# Save durations for further analysis
contact_timeline.to_csv('/tmp/durations.csv', index=False)
print("Durations analysis complete.")
''')
