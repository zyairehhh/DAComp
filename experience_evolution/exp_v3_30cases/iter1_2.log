import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-098.sqlite')

# Get conversations with parsed tags
conversations_query = '''
SELECT 
    ce.conversation_id,
    ce.conversation_created_at AS initiated_at,
    ce.first_contact_author_id AS contact_id,
    ce.all_conversation_tags,
    cm.first_admin_response_at AS first_response_at,
    cm.time_to_first_response_minutes,
    ce.conversation_author_type,
    ce.conversation_subject,
    ce.conversation_rating,
    ce.conversation_remark
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
    ON ce.conversation_id = cm.conversation_id
WHERE ce.all_conversation_tags IS NOT NULL 
    AND ce.all_conversation_tags != ''
'''
df = pd.read_sql_query(conversations_query, conn)
print(f"Total conversations with tags: {len(df)}")

# Parse tags
def parse_tag(tag_string, key):
    if pd.isna(tag_string):
        return None
    parts = tag_string.split('|')
    for part in parts:
        if ':' in part:
            k, v = part.split(':', 1)
            if k == key:
                return v
    return None

df['path'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'path'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))
df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))

df['responder_type'] = df['path'].fillna(df['conversation_author_type'])
# Because conversation_author_type is 'user' or 'admin'? Actually we need bot vs human first response.
# The path column already indicates bot_first vs human_first. Use path.
# If path missing, we can infer from conversation_initiated_type? Not in selected columns, re-query.
