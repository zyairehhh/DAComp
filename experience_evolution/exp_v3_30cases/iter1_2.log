import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

plt.rcParams.update({'font.size': 12})

conn = sqlite3.connect('dacomp-057.sqlite')

# 1. Get all campaign_report data
cr_df = pd.read_sql_query("SELECT campaign_id, account_id, date_day, advertising_channel_type, spend, conversions, conversions_value FROM google_ads__campaign_report", conn)
cr_df['date_day'] = pd.to_datetime(cr_df['date_day']).dt.tz_convert(None)  # make naive

# Compute campaign age (days since first record) relative to max date
max_date = cr_df['date_day'].max()
cr_df['date_day_naive'] = cr_df['date_day']
campaign_age = cr_df.groupby('campaign_id')['date_day'].agg(['min', 'max']).reset_index()
campaign_age['age_days'] = (max_date - campaign_age['min']).dt.days
old_campaigns = campaign_age[campaign_age['age_days'] > 120]
print(f"Campaigns >120 days: {len(old_campaigns)}")

# 2. Get customer acquisition data
ca_df = pd.read_sql_query("SELECT account_id, date_day, advertising_channel_type, customer_acquisition_cost, ltv_cac_ratio, acquisition_sophistication_score, cac_efficiency_percentile, channel_diversity_count, campaign_lifecycle_stage, customer_maturity_stage, account_maturity_stage, strategic_customer_segment, retention_risk, scale_opportunity FROM google_ads__customer_acquisition_analysis", conn)
ca_df['date_day'] = pd.to_datetime(ca_df['date_day']).dt.tz_convert(None)

# 3. Merge cr_df with ca_df on account_id, date_day, advertising_channel_type
merged = pd.merge(cr_df, ca_df, on=['account_id', 'date_day', 'advertising_channel_type'], how='inner', suffixes=('_cr', '_ca'))

# 4. Filter to old campaigns
merged_old = merged[merged['campaign_id'].isin(old_campaigns['campaign_id'])]

# 5. Determine recent 30 days and previous 30 days
recent_start = max_date - pd.Timedelta(days=30)
prev_start = max_date - pd.Timedelta(days=60)
df_recent = merged_old[(merged_old['date_day'] > recent_start) & (merged_old['date_day'] <= max_date)]
df_prev = merged_old[(merged_old['date_day'] > prev_start) & (merged_old['date_day'] <= recent_start)]

print(f"Recent rows: {len(df_recent)}, Previous rows: {len(df_prev)}")

# 6. Compute per-campaign averages
def compute_metrics(df):
    agg = df.groupby('campaign_id').agg(
        avg_cac=('customer_acquisition_cost', 'mean'),
        avg_ltv_cac=('ltv_cac_ratio', 'mean'),
        # also collect other dimensions for later use (take first)
        campaign_lifecycle_stage=('campaign_lifecycle_stage', 'first'),
        advertising_channel_type=('advertising_channel_type', 'first'),
        customer_maturity_stage=('customer_maturity_stage', 'first'),
        account_maturity_stage=('account_maturity_stage', 'first'),
        acquisition_sophistication_score=('acquisition_sophistication_score', 'mean'),
        cac_efficiency_percentile=('cac_efficiency_percentile', 'mean'),
        channel_diversity_count=('channel_diversity_count', 'mean'),
        retention_risk=('retention_risk', 'mean'),
        scale_opportunity=('scale_opportunity', 'mean')
    ).reset_index()
    return agg

recent_agg = compute_metrics(df_recent)
prev_agg = compute_metrics(df_prev)

# Merge
campaign_metrics = pd.merge(recent_agg, prev_agg, on='campaign_id', suffixes=('_recent', '_prev'))
campaign_metrics['cac_growth_pct'] = (campaign_metrics['avg_cac_recent'] - campaign_metrics['avg_cac_prev']) / campaign_metrics['avg_cac_prev'] * 100
campaign_metrics['ltv_cac_decline_pct'] = (campaign_metrics['avg_ltv_cac_prev'] - campaign_metrics['avg_ltv_cac_recent']) / campaign_metrics['avg_ltv_cac_prev'] * 100

# Identify campaigns with CAC growth >25% AND LTV/CAC decline >20%
decay_campaigns = campaign_metrics[(campaign_metrics['cac_growth_pct'] > 25) & (campaign_metrics['ltv_cac_decline_pct'] > 20)]
print(f"Decay campaigns count: {len(decay_campaigns)}")

# 7. Visualizations
# 7.1 CAC growth and LTV/CAC decline scatter, colored by campaign_lifecycle_stage
fig1, ax1 = plt.subplots(figsize=(10,6))
for stage in campaign_metrics['campaign_lifecycle_stage_recent'].unique():
    subset = campaign_metrics[campaign_metrics['campaign_lifecycle_stage_recent'] == stage]
    ax1.scatter(subset['cac_growth_pct'], subset['ltv_cac_decline_pct'], label=stage, alpha=0.7, s=80)
ax1.axvline(x=25, color='r', linestyle='--', alpha=0.5)
ax1.axhline(y=20, color='r', linestyle='--', alpha=0.5)
ax1.set_xlabel('CAC Growth (%)')
ax1.set_ylabel('LTV/CAC Decline (%)')
ax1.set_title('Campaign Decay Indicators by Lifecycle Stage')
ax1.legend(title='Lifecycle Stage')
ax1.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('campaign_decay_scatter.png', dpi=300)
plt.close()

# 7.2 Bar chart: average CAC growth and LTV/CAC decline per advertising_channel_type
channel_agg = campaign_metrics.groupby('advertising_channel_type_recent').agg(
    avg_cac_growth=('cac_growth_pct', 'mean'),
    avg_ltv_cac_decline=('ltv_cac_decline_pct', 'mean'),
    count=('campaign_id', 'count')
).reset_index()
fig2, ax2 = plt.subplots(figsize=(10,6))
