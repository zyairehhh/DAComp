FROM salesforce__contact_enhanced
WHERE account_id IN (SELECT account_id FROM salesforce__customer_360_view WHERE annual_revenue IS NOT NULL AND number_of_employees IS NOT NULL)
GROUP BY account_id
"""
df_contacts = pd.read_sql_query(query_contacts, conn)

# Merge
df = pd.merge(df_accounts, df_contacts, on='account_id', how='left')
df['contact_count'] = df['contact_count'].fillna(0)
df['decision_maker_count'] = df['decision_maker_count'].fillna(0)

# Compute metrics
df['contact_density_ratio'] = df['contact_count'] / df['number_of_employees'] * 1000
df['decision_maker_ratio'] = df['decision_maker_count'] / df['contact_count'] * 100
df['decision_maker_ratio'] = df['decision_maker_ratio'].fillna(0)

# Departmental coverage
dept_cols = ['sales_flag', 'finance_flag', 'ops_flag', 'eng_flag', 'hr_flag']
for col in dept_cols:
