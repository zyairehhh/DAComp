```
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Connect to the database
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Get high-volatility customers (top 25% by customer_margin_volatility)
query = """
SELECT 
  DISTINCT customer_id,
  customer_margin_volatility,
  customer_total_revenue,
  customer_total_profit,
  customer_gross_margin_pct,
  customer_profit_growth_pct
FROM quickbooks__profitability_analysis
"""

df_profitability = pd.read_sql_query(query, conn)
conn.close()

# Calculate the 75th percentile threshold (top 25% highest volatility)
threshold = df_profitability['customer_margin_volatility'].quantile(0.75)
print(f"75th percentile (top 25%) threshold for customer_margin_volatility: {threshold}")

# Identify high-volatility customers
high_volatility_df = df_profitability[df_profitability['customer_margin_volatility'] >= threshold].copy()
low_volatility_df = df_profitability[df_profitability['customer_margin_volatility'] < threshold].copy()

print(f"High-volatility customers: {len(high_volatility_df)}")
print(f"Low-volatility customers: {len(low_volatility_df)}")

# Create visualizations
plt.style.use('default')

# Plot 1: Distribution of customer margin volatility
plt.figure(figsize=(10, 6))
plt.hist(df_profitability['customer_margin_volatility'], bins=50, alpha=0.7, label='All Customers')
plt.axvline(x=threshold, color='r', linestyle='--', linewidth=2, label=f'Top 25% Threshold ({threshold:.3f})')
plt.xlabel('Customer Margin Volatility')
plt.ylabel('Count')
plt.title('Distribution of Customer Margin Volatility')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('volatility_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 2: Volatility vs Customer Gross Margin %
plt.figure(figsize=(10, 6))
plt.scatter(low_volatility_df['customer_margin_volatility'], 
            low_volatility_df['customer_gross_margin_pct'], 
            alpha=0.5, label='Low Volatility (< 75th percentile)', s=30)
plt.scatter(high_volatility_df['customer_margin_volatility'], 
            high_volatility_df['customer_gross_margin_pct'], 
            alpha=0.7, label='High Volatility (≥ 75th percentile)', s=40, color='red')
plt.axvline(x=threshold, color='k', linestyle='--', linewidth=1, alpha=0.5)
plt.xlabel('Customer Margin Volatility')
plt.ylabel('Customer Gross Margin %')
plt.title('Margin Volatility vs Gross Margin Percentage')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('volatility_vs_margin.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 3: Compare average metrics between high and low volatility groups
metrics_comparison = pd.DataFrame({
    'Metric': ['Gross Margin %', 'Total Revenue', 'Total Profit', 'Profit Growth %'],
    'High Volatility': [
        high_volatility_df['customer_gross_margin_pct'].mean(),
        high_volatility_df['customer_total_revenue'].mean(),
        high_volatility_df['customer_total_profit'].mean(),
        high_volatility_df['customer_profit_growth_pct'].mean()
    ],
    'Low Volatility': [
        low_volatility_df['customer_gross_margin_pct'].mean(),
        low_volatility_df['customer_total_revenue'].mean(),
        low_volatility_df['customer_total_profit'].mean(),
        low_volatility_df['customer_profit_growth_pct'].mean()
    ]
})

print("\nMetrics Comparison:")
print(metrics_comparison)
```
