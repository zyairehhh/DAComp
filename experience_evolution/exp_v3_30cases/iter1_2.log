'''
import sqlite3
import pandas as pd
import numpy as np

# Connect to database
conn = sqlite3.connect('./dacomp-060.sqlite')

# Aggregate ad group performance
query = """
SELECT
    ad_group_id,
    ad_group_name,
    ad_group_type,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions,
    SUM(spend) AS total_spend
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name, ad_group_type
HAVING total_impressions > 0 AND total_clicks > 0
"""
df = pd.read_sql(query, conn)
df['CTR'] = df['total_clicks'] / df['total_impressions']
df['CVR'] = df['total_conversions'] / df['total_clicks']
# Replace infinite or NaN CVR with 0 (when clicks = 0, but we filtered clicks>0)
df['CVR'] = df['CVR'].fillna(0)

# Compute percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# Identify problematic ad groups: CTR > 75th percentile AND CVR < 25th percentile
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
print(f"Number of problematic ad groups: {len(problematic)}")
print(problematic[['ad_group_id', 'ad_group_name', 'CTR', 'CVR', 'total_clicks', 'total_impressions', 'total_conversions']].head())

# Save to CSV for further analysis
problematic.to_csv('problematic_ad_groups.csv', index=False)
df.to_csv('all_ad_groups_agg.csv', index=False)

# Compute overall average CVR as expected CVR baseline
overall_cvr = df['total_conversions'].sum() / df['total_clicks'].sum()
print(f"Overall average CVR: {overall_cvr:.4f}")

# Intent Match Ratio = Actual CVR / Expected CVR (using overall average as expected)
problematic['Intent_Match_Ratio'] = problematic['CVR'] / overall_cvr
print("Problematic ad groups with Intent Match Ratio:")
print(problematic[['ad_group_id', 'ad_group_name', 'CVR', 'Intent_Match_Ratio']].sort_values('Intent_Match_Ratio'))

# Analyze traffic quality: we can join with search term report to see match types and conversion rates per search term.
# For each problematic ad group, compute average search term conversion rate? Let's get search term data.
search_query = """
SELECT ad_group_id, search_term, keyword_match_type, search_term_match_type,
       SUM(clicks) as clicks, SUM(conversions) as conversions
FROM google_ads__search_term_report
GROUP BY ad_group_id, search_term, keyword_match_type, search_term_match_type
"""
search_df = pd.read_sql(search_query, conn)
search_df['search_cvr'] = search_df['conversions'] / search_df['clicks']
search_df['search_cvr'] = search_df['search_cvr'].fillna(0)

# Merge with problematic ad groups
search_problematic = search_df[search_df['ad_group_id'].isin(problematic['ad_group_id'])]
print(f"Search term records for problematic groups: {len(search_problematic)}")

# Aggregate match type distribution
match_type_dist = search_problematic.groupby('keyword_match_type').agg({'clicks': 'sum', 'conversions': 'sum'}).reset_index()
if not match_type_dist.empty:
    match_type_dist['cvr'] = match_type_dist['conversions'] / match_type_dist['clicks']
    print("Match type distribution for problematic ad groups:")
    print(match_type_dist)

# Landing page analysis: join with URL report
url_query = """
SELECT ad_group_id, base_url, url_path,
       SUM(clicks) as clicks, SUM(conversions) as conversions
FROM google_ads__url_report
GROUP BY ad_group_id, base_url, url_path
"""
url_df = pd.read_sql(url_query, conn)
url_df['url_cvr'] = url_df['conversions'] / url_df['clicks']
url_df['url_cvr'] = url_df['url_cvr'].fillna(0)

url_problematic = url_df[url_df['ad_group_id'].isin(problematic['ad_group_id'])]
print(f"URL records for problematic groups: {len(url_problematic)}")
# Top landing pages by clicks
top_pages = url_problematic.sort_values('clicks', ascending=False).head(10)
print("Top landing pages (by clicks) in problematic ad groups:")
print(top_pages[['base_url', 'url_path', 'clicks', 'conversions', 'url_cvr']])

conn.close()
''')
