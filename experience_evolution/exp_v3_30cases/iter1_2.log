Action: LOCAL_DB_SQL(file_path="dacomp-094.sqlite", command="
WITH campaign_data AS (
  SELECT 
    f.last_touch_campaign_id AS campaign_id,
    f.person_id,
    f.first_event_at AS send_time,
    f.count_received_email,
    f.count_opened_email,
    f.count_clicked_email,
    CAST(f.count_opened_email AS FLOAT) / NULLIF(f.count_received_email, 0) AS open_rate,
    CAST(f.count_clicked_email AS FLOAT) / NULLIF(f.count_received_email, 0) AS click_rate,
    e.campaign_subject_line AS subject_line
  FROM klaviyo__person_campaign_flow f
  LEFT JOIN (
    SELECT last_touch_campaign_id, MAX(campaign_subject_line) AS campaign_subject_line
    FROM klaviyo__events
    GROUP BY last_touch_campaign_id
  ) e ON f.last_touch_campaign_id = e.last_touch_campaign_id
),
person_data AS (
  SELECT 
    person_id,
    active_retention_rate_week,
    active_retention_rate_month
  FROM klaviyo__persons
)
SELECT 
  cd.*,
  pd.active_retention_rate_week,
  pd.active_retention_rate_month,
  CASE 
    WHEN cd.subject_line LIKE '%Product Launch%' THEN 'new product launch'
    WHEN cd.subject_line LIKE '%Seasonal%' THEN 'discount-related'
    ELSE 'other'
  END AS theme,
  CAST(strftime('%w', cd.send_time) AS INTEGER) AS day_of_week,
  CASE 
    WHEN CAST(strftime('%w', cd.send_time) AS INTEGER) IN (0, 6) THEN 'weekend'
    ELSE 'weekday'
  END AS weekday_weekend,
  CAST(strftime('%H', cd.send_time) AS INTEGER) AS hour_of_day,
  CASE 
    WHEN CAST(strftime('%H', cd.send_time) AS INTEGER) < 12 THEN 'morning'
    ELSE 'afternoon'
  END AS morning_afternoon
FROM campaign_data cd
LEFT JOIN person_data pd ON cd.person_id = pd.person_id
", output="combined_data.csv")
