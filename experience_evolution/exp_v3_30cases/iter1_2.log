import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
# Use default fonts (English only)

# Connect to database
conn = sqlite3.connect('/workspace/dacomp-069.sqlite')

# 1. Overall performance score trend over time
query = """
SELECT date_day, overall_performance_score 
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name='com.dev.photoeditor' 
ORDER BY date_day
"""
df_score = pd.read_sql_query(query, conn)
df_score['date_day'] = pd.to_datetime(df_score['date_day'])

plt.figure(figsize=(10,5))
plt.plot(df_score['date_day'], df_score['overall_performance_score'], marker='o')
plt.title('Overall Performance Score Trend for com.dev.photoeditor')
plt.xlabel('Date')
plt.ylabel('Overall Performance Score')
plt.grid(True)
plt.tight_layout()
plt.savefig('/workspace/overall_performance_trend.png')
plt.close()

# 2. Regional revenue metrics: average_revenue_per_user by country and revenue_tier
query = """
SELECT country, region, revenue_tier, avg_transaction_value, average_revenue_per_user, store_conversion_rate, day_1_retention_rate 
FROM google_play__geo_market_analysis 
WHERE package_name='com.dev.photoeditor'
ORDER BY avg_transaction_value DESC
"""
df_regional = pd.read_sql_query(query, conn)

# Bar chart: average_revenue_per_user by country
plt.figure(figsize=(12,6))
bars = plt.bar(df_regional['country'], df_regional['average_revenue_per_user'], color=['green' if x=='Tier 1' else 'orange' if x=='Tier 2' else 'red' for x in df_regional['revenue_tier']])
plt.title('Average Revenue per User by Country (Colored by Revenue Tier)')
plt.xlabel('Country')
plt.ylabel('Average Revenue per User ($)')
plt.xticks(rotation=45)
plt.grid(axis='y')
plt.legend(handles=[plt.Rectangle((0,0),1,1, color='green', label='Tier 1'),
                    plt.Rectangle((0,0),1,1, color='orange', label='Tier 2'),
                    plt.Rectangle((0,0),1,1, color='red', label='Tier 3')])
plt.tight_layout()
plt.savefig('/workspace/avg_revenue_per_user_by_country.png')
plt.close()

# 3. Scatter: avg_transaction_value vs store_conversion_rate colored by revenue_tier
plt.figure(figsize=(10,6))
colors = {'Tier 1':'green','Tier 2':'orange','Tier 3':'red'}
plt.scatter(df_regional['avg_transaction_value'], df_regional['store_conversion_rate'], 
            c=df_regional['revenue_tier'].map(colors), s=100, alpha=0.7)
for i, row in df_regional.iterrows():
    plt.annotate(row['country'], (row['avg_transaction_value'], row['store_conversion_rate']), fontsize=9)
plt.title('Avg Transaction Value vs Store Conversion Rate (by Revenue Tier)')
plt.xlabel('Avg Transaction Value ($)')
plt.ylabel('Store Conversion Rate')
plt.grid(True)
plt.tight_layout()
plt.savefig('/workspace/scatter_transaction_vs_conversion.png')
plt.close()

# 4. Performance divergence: day_1_retention_rate grouped by revenue_tier
tier_stats = df_regional.groupby('revenue_tier').agg({'day_1_retention_rate':'mean', 'store_conversion_rate':'mean', 'avg_transaction_value':'mean'}).reset_index()
plt.figure(figsize=(8,5))
plt.bar(tier_stats['revenue_tier'], tier_stats['day_1_retention_rate'], color=['green','orange','red'])
plt.title('Day 1 Retention Rate by Revenue Tier')
plt.xlabel('Revenue Tier')
plt.ylabel('Average Day 1 Retention Rate')
plt.grid(axis='y')
plt.tight_layout()
plt.savefig('/workspace/retention_by_tier.png')
plt.close()

conn.close()
print('Plots generated')
```
