import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import seaborn as sns
import numpy as np
import os

plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

# Connect to database
conn = sqlite3.connect('dacomp-079.sqlite')

# Helper to run SQL
def run_query(query):
    return pd.read_sql_query(query, conn)

# 1. Segment definition
segment_query = """
WITH visitor_features AS (
    SELECT 
        v.visitor_id,
        v.count_active_days,
        v.latest_nps_rating,
        v.average_daily_minutes,
        v.average_daily_events,
        v.sum_minutes,
        v.sum_events,
        v.count_active_months,
        COUNT(DISTINCT vf.feature_id) AS distinct_features
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id
    WHERE v.count_active_days > 60
    GROUP BY v.visitor_id
)
SELECT 
    visitor_id,
    count_active_days,
    latest_nps_rating,
    average_daily_minutes,
    average_daily_events,
    sum_minutes,
    sum_events,
    count_active_months,
    distinct_features,
    CASE 
        WHEN distinct_features < 5 THEN 'single_feature_use'
        ELSE 'normal'
    END AS segment
FROM visitor_features
"""
segments = run_query(segment_query)

# Verify counts
single = segments[segments['segment'] == 'single_feature_use']
normal = segments[segments['segment'] == 'normal']
print(f"Single-feature-use: {len(single)}")
print(f"Normal: {len(normal)}")

# 2. NPS distribution plot
def nps_category(rating):
    if rating <= 6:
        return 'detractor'
    elif rating <= 8:
        return 'passive'
    else:
        return 'promoter'

segments['nps_category'] = segments['latest_nps_rating'].apply(nps_category)

nps_counts = segments.groupby(['segment', 'nps_category']).size().unstack(fill_value=0)
nps_props = nps_counts.div(nps_counts.sum(axis=1), axis=0)

fig, ax = plt.subplots(figsize=(8,5))
nps_props.plot(kind='bar', ax=ax, color=['#d62728', '#ff7f0e', '#2ca02c'])
ax.set_title('NPS Distribution: Single‑Feature‑Use vs Normal Users', fontsize=14)
ax.set_xlabel('User Segment')
ax.set_ylabel('Proportion')
ax.set_xticklabels(['Single‑Feature‑Use', 'Normal'], rotation=0)
ax.legend(title='NPS Category')
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('nps_distribution.png', dpi=300)
plt.close()

# 3. Engagement comparison: Average Daily Minutes & Minutes per Event
segments['minutes_per_event'] = segments['sum_minutes'] / segments['sum_events']

fig, axes = plt.subplots(1, 2, figsize=(12,5))
metrics = ['average_daily_minutes', 'minutes_per_event']
titles = ['Average Daily Minutes', 'Minutes per Event']
for idx, (metric, title) in enumerate(zip(metrics, titles)):
    data = [single[metric].dropna(), normal[metric].dropna()]
    axes[idx].boxplot(data, labels=['Single‑Feature‑Use', 'Normal'])
    axes[idx].set_title(title, fontsize=13)
    axes[idx].set_ylabel('Minutes')
    axes[idx].grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('engagement_comparison.png', dpi=300)
plt.close()

# 4. Top features used by single‑feature‑use segment
top_features_query = """
SELECT 
    f.feature_name,
    COUNT(DISTINCT vf.visitor_id) AS user_count
FROM pendo__visitor_feature vf
JOIN pendo__feature f ON vf.feature_id = f.feature_id
WHERE vf.visitor_id IN (
    SELECT visitor_id FROM ({segment_sub}) WHERE segment = 'single_feature_use'
)
GROUP BY f.feature_name
ORDER BY user_count DESC
LIMIT 5
""".format(segment_sub=segment_query.replace('\n', ' '))

top_features = run_query(top_features_query)
top_features = top_features.sort_values('user_count', ascending=True)

fig, ax = plt.subplots(figsize=(9,5))
bars = ax.barh(top_features['feature_name'], top_features['user_count'], color='steelblue')
ax.set_title('Top Features by User Count in Single‑Feature‑Use Segment', fontsize=14)
ax.set_xlabel('Number of Users')
ax.bar_label(bars, fmt='%d', padding=3)
plt.tight_layout()
plt.savefig('top_features.png', dpi=300)
plt.close()

# 5. Product‑area penetration gap
product_area_query = """
SELECT 
    f.product_area_name,
    COUNT(DISTINCT CASE WHEN seg.segment = 'single_feature_use' THEN vf.visitor_id END) AS single_count,
    COUNT(DISTINCT CASE WHEN seg.segment = 'normal' THEN vf.visitor_id END) AS normal_count,
    COUNT(DISTINCT seg.visitor_id) AS total_users
FROM pendo__visitor_feature vf
JOIN pendo__feature f ON vf.feature_id = f.feature_id
JOIN ({segment_sub}) seg ON vf.visitor_id = seg.visitor_id
WHERE f.product_area_name IS NOT NULL
GROUP BY f.product_area_name
HAVING total_users >= 10
ORDER BY normal_count DESC
""".format(segment_sub=segment_query.replace('\n', ' '))

product_area = run_query(product_area_query)
product_area['single_penetration'] = product_area['single_count'] / len(single)
product_area['normal_penetration'] = product_area['normal_count'] / len(normal)

product_area = product_area.sort_values('normal_penetration', ascending=False).head(8)  # top areas

fig, ax = plt.subplots(figsize=(10,6))
x = np.arange(len(product_area))
width = 0.35
ax.bar(x - width/2, product_area['single_penetration'], width, label='Single‑Feature‑Use', color='#d62728')
ax.bar(x + width/2, product_area['normal_penetration'], width, label='Normal', color='#2ca02c')
ax.set_title('Product‑Area Penetration: Single‑Feature‑Use vs Normal Users', fontsize=14)
ax.set_xlabel('Product Area')
ax.set_ylabel('Proportion of Users in Segment')
ax.set_xticks(x)
ax.set_xticklabels(product_area['product_area_name'], rotation=45, ha='right')
ax.legend()
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('product_area_penetration.png', dpi=300)
plt.close()

# 6. Active months distribution
fig, ax = plt.subplots(figsize=(8,5))
data = [single['count_active_months'].dropna(), normal['count_active_months'].dropna()]
ax.boxplot(data, labels=['Single‑Feature‑Use', 'Normal'])
ax.set_title('Active Months Distribution', fontsize=14)
ax.set_ylabel('Active Months')
ax.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('active_months.png', dpi=300)
plt.close()

# 7. Scatter: Distinct Features vs Average Daily Minutes
fig, ax = plt.subplots(figsize=(9,6))
colors = {'single_feature_use': '#d62728', 'normal': '#2ca02c'}
for seg, color in colors.items():
    sub = segments[segments['segment'] == seg]
    ax.scatter(sub['distinct_features'], sub['average_daily_minutes'], 
               alpha=0.6, s=20, color=color, label=seg)
ax.set_title('Distinct Features vs Average Daily Minutes', fontsize=14)
ax.set_xlabel('Distinct Features')
ax.set_ylabel('Average Daily Minutes')
ax.axvline(x=4.5, color='gray', linestyle='--', linewidth=1, label='Threshold (5 features)')
ax.legend()
ax.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('features_vs_minutes.png', dpi=300)
plt.close()

conn.close()
print("Plots generated.")
```


