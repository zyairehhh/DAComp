import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Set style
plt.style.use('seaborn-v0_8-whitegrid')

# Connect to database
conn = sqlite3.connect('dacomp-013.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Data cleaning as per Stage1
# Convert numeric columns, replacing "-" with NaN
num_cols = ['Planned Work Hours', 'Actual Work Hours', 'Completion Quality Score', 'Task Difficulty Coefficient', 'Rework Count']
for col in num_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Parse dates
date_cols = ['Planned Start Date', 'Planned Deadline', 'Actual Start Date', 'Actual Completion Time']
for col in date_cols:
    df[col] = pd.to_datetime(df[col], errors='coerce')

# Add binary completion flag
df['is_completed'] = df['Task Status'] == 'Completed'

# Priority weight mapping
priority_weight = {'Urgent': 4, 'High': 3, 'Medium': 2, 'Low': 1}
df['priority_weight'] = df['Priority'].map(priority_weight)

# Filter owners with at least 3 tasks total
owner_total_counts = df['Task Owner'].value_counts()
eligible_owners = owner_total_counts[owner_total_counts >= 3].index
df_eligible = df[df['Task Owner'].isin(eligible_owners)].copy()
print(f"Eligible owners: {len(eligible_owners)}")

# Separate completed tasks for metric calculations
completed = df_eligible[df_eligible['is_completed']].copy()

# Lateness days
completed['lateness_days'] = (completed['Actual Completion Time'] - completed['Planned Deadline']).dt.days
completed['on_time'] = completed['lateness_days'] <= 0

# Efficiency = planned/actual, capped at 2
completed['efficiency'] = completed['Planned Work Hours'] / completed['Actual Work Hours']
completed['efficiency'] = completed['efficiency'].clip(upper=2)
# Only keep where actual work hours > 0
completed.loc[completed['Actual Work Hours'] <= 0, 'efficiency'] = np.nan

# Normalization per task type per owner
task_types = completed['Task Type'].unique()
normalized_metrics = {}

# For each metric to normalize: quality, efficiency, rework
# Compute mean and std per task type
for metric in ['Completion Quality Score', 'efficiency', 'Rework Count']:
    type_stats = {}
    for t in task_types:
        vals = completed.loc[completed['Task Type'] == t, metric]
        type_stats[t] = {'mean': vals.mean(), 'std': vals.std()}
    # Z-score
    z_col = f'{metric}_z'
    completed[z_col] = np.nan
    for t in task_types:
        mask = completed['Task Type'] == t
        mean = type_stats[t]['mean']
        std = type_stats[t]['std'] if type_stats[t]['std'] > 0 else 1
        completed.loc[mask, z_col] = (completed.loc[mask, metric] - mean) / std
    # For rework, invert so lower rework = higher score
    if metric == 'Rework Count':
        completed[z_col] = -completed[z_col]  # invert
    # Fill missing with 0 (neutral)
    completed[z_col] = completed[z_col].fillna(0)
    normalized_metrics[metric] = z_col

# Group by owner
owner_stats = df_eligible.groupby('Task Owner').agg(
    total_tasks=('Task ID', 'count'),
    completed_tasks=('is_completed', 'sum')
).reset_index()

# Weighted completion rate = sum(priority weight of completed tasks) / sum(priority weight of all tasks)
def weighted_completion_rate(group):
    total_weight = group['priority_weight'].sum()
    completed_weight = group.loc[group['is_completed'], 'priority_weight'].sum()
    return completed_weight / total_weight if total_weight > 0 else 0

comp_rates = df_eligible.groupby('Task Owner').apply(weighted_completion_rate).rename('weighted_completion_rate')
owner_stats = owner_stats.merge(comp_rates, on='Task Owner')

# Average normalized quality Z-score
quality_z_avg = completed.groupby('Task Owner')['Completion Quality Score_z'].mean().rename('avg_quality_z')
owner_stats = owner_stats.merge(quality_z_avg, on='Task Owner', how='left')
# On-time rate (proportion of completed tasks delivered on or before deadline)
on_time_rate = completed.groupby('Task Owner')['on_time'].mean().rename('on_time_rate')
owner_stats = owner_stats.merge(on_time_rate, on='Task Owner', how='left')
# Average normalized efficiency Z-score
eff_z_avg = completed.groupby('Task Owner')['efficiency_z'].mean().rename('avg_efficiency_z')
owner_stats = owner_stats.merge(eff_z_avg, on='Task Owner', how='left')
# Average normalized (inverted) rework Z-score
rework_z_avg = completed.groupby('Task Owner')['Rework Count_z'].mean().rename('avg_rework_z')
owner_stats = owner_stats.merge(rework_z_avg, on='Task Owner', how='left')
# Average difficulty
avg_diff = completed.groupby('Task Owner')['Task Difficulty Coefficient'].mean().rename('avg_difficulty')
owner_stats = owner_stats.merge(avg_diff, on='Task Owner', how='left')
# Primary task type (mode of Task Type for that owner)
def primary_type_func(x):
    if x.empty:
        return None
    return x.mode()[0] if not x.mode().empty else x.iloc[0]
primary_type = df_eligible.groupby('Task Owner')['Task Type'].agg(primary_type_func).rename('primary_type')
owner_stats = owner_stats.merge(primary_type, on='Task Owner', how='left')

# Fill missing values with 0 (neutral) for normalized metrics
norm_cols = ['avg_quality_z', 'avg_efficiency_z', 'avg_rework_z']
owner_stats[norm_cols] = owner_stats[norm_cols].fillna(0)
# Fill missing on_time_rate with 0? If no completed tasks, on_time_rate is NaN; set to 0 (no on-time completion)
owner_stats['on_time_rate'] = owner_stats['on_time_rate'].fillna(0)

# Composite score (average of five dimensions)
owner_stats['composite_score'] = owner_stats[['weighted_completion_rate', 'avg_quality_z', 'on_time_rate', 'avg_efficiency_z', 'avg_rework_z']].mean(axis=1)

# Performance level assignment
n_owners = len(owner_stats)
rank = owner_stats['composite_score'].rank(method='first', ascending=False)
owner_stats['rank'] = rank
owner_stats['pct_rank'] = rank / n_owners

# Determine performance level
def assign_level(pct):
    if pct <= 0.2:
        return 'Excellent'
    elif pct <= 0.9:
        return 'Good'
    else:
        return 'Needs Improvement'

owner_stats['performance_level'] = owner_stats['pct_rank'].apply(assign_level)

print("Performance level distribution:")
print(owner_stats['performance_level'].value_counts())
print("Proportions:")
print(owner_stats['performance_level'].value_counts(normalize=True).round(3))

# Save for visualization
owner_stats.to_csv('owner_performance.csv', index=False)
completed.to_csv('completed_tasks_processed.csv', index=False)
