```
import sqlite3
import pandas as pd

conn = sqlite3.connect("dacomp-090.sqlite")
df = pd.read_sql_query("SELECT dashboard_month, collection_rate_percentage FROM quickbooks__financial_dashboard WHERE dashboard_month >= '2024-10-01' ORDER BY dashboard_month", conn)
df['change'] = df['collection_rate_percentage'].diff()
print("Month-over-month changes:")
print(df)

# Identify consecutive declines
df['decline'] = df['change'] < 0
df['streak'] = (df['decline'] != df['decline'].shift()).cumsum()
streaks = df.groupby(['decline', 'streak']).size().reset_index(name='len')
decline_streaks = streaks[streaks['decline'] == True]
print("\nDecline streaks:")
print(decline_streaks)
if not decline_streaks.empty:
    max_decline_streak = decline_streaks['len'].max()
    print(f"Longest consecutive months of deterioration: {max_decline_streak}")
    # magnitude of decline over that streak
    # For each streak, compute total decline
    for _, row in decline_streaks.iterrows():
        streak_len = row['len']
        streak_start = df[df['streak'] == row['streak']].index[0]
        start_rate = df.loc[streak_start, 'collection_rate_percentage']
        end_rate = df.loc[streak_start + streak_len - 1, 'collection_rate_percentage']
        total_decline = start_rate - end_rate
        print(f"Streak length {streak_len}: from {start_rate:.2f} to {end_rate:.2f}, total decline {total_decline:.2f} percentage points.")
else:
    print("No decline streaks.")
```

