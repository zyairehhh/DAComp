import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-078/stage1_env/dacomp-078.sqlite')

# Load visitor data with engineered features using SQL
query = '''
SELECT 
    v.*,
    COALESCE(f.num_features, 0) AS num_features,
    COALESCE(f.total_clicks, 0) AS total_clicks,
    COALESCE(d.daily_minutes_mean, 0) AS daily_minutes_mean,
    COALESCE(d.daily_minutes_std, 0) AS daily_minutes_std,
    COALESCE(d.daily_minutes_cv, 0) AS daily_minutes_cv,
    COALESCE(d.recency_days, 0) AS recency_days,
    COALESCE(d.tenure_days, 0) AS tenure_days
FROM pendo__visitor v
LEFT JOIN (
    SELECT visitor_id, 
           COUNT(DISTINCT feature_id) AS num_features,
           SUM(sum_clicks) AS total_clicks
    FROM pendo__visitor_feature
    GROUP BY visitor_id
) f ON v.visitor_id = f.visitor_id
LEFT JOIN (
    SELECT visitor_id,
           AVG(sum_minutes) AS daily_minutes_mean,
           STDEV(sum_minutes) AS daily_minutes_std,
           CASE WHEN AVG(sum_minutes) > 0 THEN STDEV(sum_minutes) / AVG(sum_minutes) ELSE 0 END AS daily_minutes_cv,
           CAST((JULIANDAY('now') - JULIANDAY(MAX(date_day))) AS INTEGER) AS recency_days,
           CAST((JULIANDAY(MAX(date_day)) - JULIANDAY(MIN(date_day))) AS INTEGER) AS tenure_days
    FROM pendo__visitor_daily_metrics
    GROUP BY visitor_id
) d ON v.visitor_id = d.visitor_id
'''
visitor_df = pd.read_sql_query(query, conn)
print("Loaded visitor shape:", visitor_df.shape)

# Define high-value label based on top 20% sum_minutes and sum_events
threshold_minutes = visitor_df['sum_minutes'].quantile(0.8)
threshold_events = visitor_df['sum_events'].quantile(0.8)
visitor_df['high_value'] = (visitor_df['sum_minutes'] >= threshold_minutes) & (visitor_df['sum_events'] >= threshold_events)
print(f"High-value threshold minutes: {threshold_minutes}, events: {threshold_events}")
print(f"High-value visitors: {visitor_df['high_value'].sum()} ({visitor_df['high_value'].mean()*100:.2f}%)")

# Compute correlations with high_value (binary) - point biserial correlation
numeric_cols = ['sum_minutes', 'sum_events', 'latest_nps_rating', 'count_active_days', 
                'count_active_months', 'average_daily_minutes', 'average_daily_events',
                'num_features', 'total_clicks', 'recency_days', 'tenure_days', 
                'daily_minutes_mean', 'daily_minutes_std', 'daily_minutes_cv']

correlations = {}
for col in numeric_cols:
    if col in visitor_df.columns:
        corr = visitor_df[['high_value', col]].corr().iloc[0,1]
        correlations[col] = corr
        print(f'{col}: {corr:.4f}')

# Sort by absolute correlation
sorted_corrs = sorted(correlations.items(), key=lambda x: abs(x[1]), reverse=True)
print("\nTop features by absolute correlation with high_value:")
for feat, corr in sorted_corrs[:10]:
    print(f'{feat}: {corr:.4f}')

# Check distribution of NPS rating vs high_value
print("\nNPS rating distribution for high-value vs non-high-value:")
print(visitor_df.groupby('high_value')['latest_nps_rating'].describe())

# Feature importance using logistic regression? Could compute but we'll just note.

conn.close()
```
