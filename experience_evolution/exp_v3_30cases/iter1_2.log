Action: LOCAL_DB_SQL(file_path="dacomp-092.sqlite", command="WITH date_range AS (
    SELECT MAX(transaction_date) as max_date FROM quickbooks__profitability_analysis
),
past_12_months AS (
    SELECT customer_id, gross_profit, transaction_date
    FROM quickbooks__profitability_analysis, date_range
    WHERE transaction_date >= DATE(max_date, '-12 months')
),
high_vol_customers AS (
    SELECT 
        pa.customer_id,
        ROW_NUMBER() OVER (PARTITION BY pa.customer_id ORDER BY pa.transaction_date DESC) as rn
    FROM quickbooks__profitability_analysis pa
    INNER JOIN (
        SELECT 
            customer_id,
            customer_margin_volatility,
            ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY transaction_date DESC) as rn2
        FROM quickbooks__profitability_analysis
    ) sub ON pa.customer_id = sub.customer_id AND sub.rn2 = 1
    WHERE sub.customer_margin_volatility >= 0.256729
)
SELECT p.customer_id,
       COUNT(*) as obs_count,
       AVG(p.gross_profit) as avg_gross_profit,
       STDDEV(p.gross_profit) as std_gross_profit,
       CASE WHEN AVG(p.gross_profit) = 0 THEN NULL ELSE (STDDEV(p.gross_profit) / AVG(p.gross_profit)) END as coeff_variation
FROM past_12_months p
INNER JOIN high_vol_customers h ON p.customer_id = h.customer_id
WHERE h.rn = 1
GROUP BY p.customer_id
ORDER BY coeff_variation DESC
LIMIT 10;", output="direct")
