import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

conn = sqlite3.connect('dacomp-098.sqlite')

# Get conversations with parsed tags
conversations_query = '''
SELECT 
    ce.conversation_id,
    ce.conversation_created_at AS initiated_at,
    ce.conversation_initiated_type,
    ce.first_contact_author_id AS contact_id,
    ce.all_conversation_tags,
    cm.first_admin_response_at AS first_response_at,
    cm.time_to_first_response_minutes,
    ce.conversation_author_type,
    ce.conversation_subject,
    ce.conversation_rating,
    ce.conversation_remark
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
    ON ce.conversation_id = cm.conversation_id
WHERE ce.all_conversation_tags IS NOT NULL 
    AND ce.all_conversation_tags != ''
'''
df = pd.read_sql_query(conversations_query, conn)
print(f"Total conversations with tags: {len(df)}")

# Parse tags
def parse_tag(tag_string, key):
    if pd.isna(tag_string):
        return None
    parts = tag_string.split('|')
    for part in parts:
        if ':' in part:
            k, v = part.split(':', 1)
            if k == key:
                return v
    return None

df['path'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'path'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))
df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))

# Determine responder_type: path indicates bot_first or human_first
df['responder_type'] = df['path']
print("Responder type distribution:")
print(df['responder_type'].value_counts(dropna=False))

# Convert timestamps
df['initiated_at'] = pd.to_datetime(df['initiated_at'])
df['first_response_at'] = pd.to_datetime(df['first_response_at'])

# Compute time to first response in days
df['time_to_first_response_days'] = df['time_to_first_response_minutes'] / (60 * 24)
# For missing minutes, compute from timestamps
mask = df['time_to_first_response_minutes'].isna() & df['first_response_at'].notna()
df.loc[mask, 'time_to_first_response_days'] = (df.loc[mask, 'first_response_at'] - df.loc[mask, 'initiated_at']).dt.total_seconds() / (3600 * 24)

# For each contact, sort conversations by initiated_at to see stage progression
df = df.sort_values(['contact_id', 'initiated_at']).reset_index(drop=True)

# Define funnel stages mapping
stage_order = {
    'contacted': 1,
    'marketing_qualified': 2,
    'demo_booked': 3,
    'proposal_sent': 4,
    'trial_started': 5,
    'trial_activated': 6,
    'expansion_in_flight': 7,
    'closed_won': 8,
    'closed_lost': 0  # lost
}
df['stage_order'] = df['stage'].map(stage_order)

# Identify first responder type per contact (first conversation's responder_type)
first_responder = df.groupby('contact_id')['responder_type'].first().reset_index()
first_responder.columns = ['contact_id', 'first_responder_type']
df = pd.merge(df, first_responder, on='contact_id', how='left')

# For each contact, find earliest timestamp for each stage
# We'll pivot to get first occurrence of each stage per contact
stage_events = df[~df['stage_order'].isna()].copy()
# For each contact, find the first initiated_at for each stage
stage_timestamps = stage_events.groupby(['contact_id', 'stage']).agg(
    stage_first_at=('initiated_at', 'min'),
    responder_type=('responder_type', 'first')
).reset_index()

# Pivot to wide format: each stage as column with timestamp
wide = stage_timestamps.pivot(index='contact_id', columns='stage', values='stage_first_at')
# Merge responder_type (take first)
contact_responder = stage_timestamps.groupby('contact_id')['responder_type'].first().reset_index()
wide = wide.merge(contact_responder, on='contact_id', how='left')

print("Stage columns after pivot:", wide.columns.tolist())
print("Number of contacts:", len(wide))

# Compute conversion rates
# 1. From conversation start to demo_booked: count contacts with demo_booked timestamp / all contacts that had any conversation
# But we need to consider only contacts that started a conversation (they are all in df)
# We'll compute per responder_type.

# Count contacts by first responder type
contact_counts = wide['responder_type'].value_counts().reset_index()
contact_counts.columns = ['responder_type', 'total_contacts']
print("Contact count by first responder type:")
print(contact_counts)

# Function to compute conversion rate from stage A to stage B
def conversion_rate(df, stage_a, stage_b):
    # df is wide dataframe with stage timestamps
    # Count contacts where stage_a exists and stage_b exists and stage_b timestamp > stage_a timestamp (or just exists)
    # We'll assume if both exist, progression occurred.
    cond = df[stage_a].notna() & df[stage_b].notna()
    total = df[stage_a].notna().sum()
    converted = cond.sum()
    rate = converted / total if total > 0 else np.nan
    return total, converted, rate

# Stages: demo_booked, trial_activated, closed_won
# Also trial_started maybe intermediate.
print("\nOverall conversion rates (all contacts):")
if 'demo_booked' in wide.columns:
    total_conv = wide['demo_booked'].notna().sum()
    print(f"Contacts with demo_booked: {total_conv} out of {len(wide)} = {total_conv/len(wide):.2%}")
if 'trial_activated' in wide.columns:
    total_trial = wide['trial_activated'].notna().sum()
    print(f"Contacts with trial_activated: {total_trial} out of {len(wide)} = {total_trial/len(wide):.2%}")
if 'closed_won' in wide.columns:
    total_won = wide['closed_won'].notna().sum()
    print(f"Contacts with closed_won: {total_won} out of {len(wide)} = {total_won/len(wide):.2%}")

# Now compute per responder_type
if 'responder_type' in wide.columns:
    for rt in wide['responder_type'].dropna().unique():
        subset = wide[wide['responder_type'] == rt]
        print(f"\n--- Responder type: {rt} ---")
        print(f"Contacts: {len(subset)}")
        if 'demo_booked' in subset.columns:
            demo = subset['demo_booked'].notna().sum()
            print(f"Demo booked: {demo} ({demo/len(subset):.2%})")
        if 'trial_activated' in subset.columns:
            trial = subset['trial_activated'].notna().sum()
            print(f"Trial activated: {trial} ({trial/len(subset):.2%})")
        if 'closed_won' in subset.columns:
            won = subset['closed_won'].notna().sum()
            print(f"Closed won: {won} ({won/len(subset):.2%})")
        # Compute conversion rates between stages
        if 'demo_booked' in subset.columns and 'trial_activated' in subset.columns:
            cond = subset['demo_booked'].notna() & subset['trial_activated'].notna()
            total_demo = subset['demo_booked'].notna().sum()
            trial_from_demo = cond.sum()
            print(f"Trial activation rate (given demo booked): {trial_from_demo}/{total_demo} = {trial_from_demo/total_demo if total_demo>0 else 0:.2%}")
        if 'trial_activated' in subset.columns and 'closed_won' in subset.columns:
            cond = subset['trial_activated'].notna() & subset['closed_won'].notna()
            total_trial = subset['trial_activated'].notna().sum()
            won_from_trial = cond.sum()
            print(f"Close won rate (given trial activated): {won_from_trial}/{total_trial} = {won_from_trial/total_trial if total_trial>0 else 0:.2%}")

# Compute average stage durations per responder_type
# Need timestamps for each stage for each contact. We'll compute differences.
# For each contact, compute days between first_response_at and demo_booked, demo_booked to trial_activated, trial_activated to closed_won.
# We'll need to join back with first_response_at per conversation (maybe earliest first response per contact).
# Let's create a contact-level dataset with earliest first response timestamp per contact.
first_response_per_contact = df.groupby('contact_id').agg(
    first_response_time=('first_response_at', 'min'),
    first_responder_type=('responder_type', 'first')
).reset_index()

wide = wide.merge(first_response_per_contact[['contact_id', 'first_response_time']], on='contact_id', how='left')

# Compute durations in days
def compute_duration(start_col, end_col):
    # both are datetime columns
    mask = wide[start_col].notna() & wide[end_col].notna()
    durations = (wide.loc[mask, end_col] - wide.loc[mask, start_col]).dt.total_seconds() / (3600 * 24)
    return durations

if 'first_response_time' in wide.columns and 'demo_booked' in wide.columns:
    wide['resp_to_demo_days'] = compute_duration('first_response_time', 'demo_booked')
if 'demo_booked' in wide.columns and 'trial_activated' in wide.columns:
    wide['demo_to_trial_days'] = compute_duration('demo_booked', 'trial_activated')
if 'trial_activated' in wide.columns and 'closed_won' in wide.columns:
    wide['trial_to_paid_days'] = compute_duration('trial_activated', 'closed_won')

print("\nAverage stage durations (days) by responder type:")
for rt in wide['responder_type'].dropna().unique():
    subset = wide[wide['responder_type'] == rt]
    print(f"\n--- {rt} ---")
    if 'resp_to_demo_days' in subset.columns:
        avg = subset['resp_to_demo_days'].mean(skipna=True)
        print(f"First response to demo booked: {avg:.2f} days")
    if 'demo_to_trial_days' in subset.columns:
        avg = subset['demo_to_trial_days'].mean(skipna=True)
        print(f"Demo booked to trial activated: {avg:.2f} days")
    if 'trial_to_paid_days' in subset.columns:
        avg = subset['trial_to_paid_days'].mean(skipna=True)
        print(f"Trial activated to closed won: {avg:.2f} days")

# Save wide dataset for further analysis
wide.to_csv('contact_funnel.csv', index=False)
print("\nContact funnel data saved to contact_funnel.csv")

conn.close()
