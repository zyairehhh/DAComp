print(f"Days to renewal range: {companies['days_to_renewal'].min()} to {companies['days_to_renewal'].max()}")

target_companies = companies[(companies['days_to_renewal'] >= 0) & (companies['days_to_renewal'] <= 90)]
print(f"Number of companies due within next 90 days: {len(target_companies)}")

# Compute features for target companies
conv_tags = conv['all_conversation_tags'].apply(parse_tags)
conv['sentiment'] = conv_tags.apply(lambda x: x.get('sentiment', None))

print("\nUnique sentiment values and counts:")
print(conv['sentiment'].value_counts())

# Define negative sentiment categories (subjective)
negative_keywords = ['executive_focus', 'data_required', 'risk_mitigation', 'cautious_watch', 'escalation']

def sentiment_negative(s):
    if s is None:
        return False
    return s in negative_keywords

# Filter conversations within last 30 days
conv_last30 = conv[conv['conv_created'] >= (ref_date - pd.Timedelta(days=30))]
print(f"Conversations in last 30 days: {len(conv_last30)}")

conv_target = conv_last30[conv_last30['company_id'].isin(target_companies['company_id'])]
print(f"Conversations for target companies in last 30 days: {len(conv_target)}")

# Communication features
conv_counts = conv_target.groupby('company_id').size().reset_index(name='avg_conversations_last30')
conv_target['is_negative'] = conv_target['sentiment'].apply(sentiment_negative)
neg_counts = conv_target.groupby('company_id')['is_negative'].sum().reset_index(name='negative_count')
total_counts = conv_target.groupby('company_id').size().reset_index(name='total_convs')
sentiment_props = pd.merge(total_counts, neg_counts, on='company_id', how='left')
sentiment_props['neg_proportion'] = sentiment_props['negative_count'] / sentiment_props['total_convs']

# Support experience features
conv_metrics = pd.read_sql_query("SELECT conversation_id, conversation_created_at, time_to_last_close_minutes, count_reopens FROM intercom__conversation_metrics", conn)
conv_metrics['conv_created'] = pd.to_datetime(conv_metrics['conversation_created_at'])
conv_metrics_last30 = conv_metrics[conv_metrics['conv_created'] >= (ref_date - pd.Timedelta(days=30))]
conv_map = conv[['conversation_id', 'company_id']]
conv_metrics_mapped = conv_metrics_last30.merge(conv_map, on='conversation_id', how='inner')
conv_metrics_target = conv_metrics_mapped[conv_metrics_mapped['company_id'].isin(target_companies['company_id'])]
print(f"Mapped conversation metrics for target: {len(conv_metrics_target)}")

resolution_avg = conv_metrics_target.groupby('company_id')['time_to_last_close_minutes'].mean().reset_index(name='avg_resolution_time_min')
conv_metrics_target['reopened'] = conv_metrics_target['count_reopens'] > 0
reopen_counts = conv_metrics_target.groupby('company_id')['reopened'].sum().reset_index(name='reopened_count')
total_counts_metrics = conv_metrics_target.groupby('company_id').size().reset_index(name='total_metrics')
reopen_props = pd.merge(total_counts_metrics, reopen_counts, on='company_id', how='left')
reopen_props['reopen_proportion'] = reopen_props['reopened_count'] / reopen_props['total_metrics']

# Product value features: feature adoption percentage
def extract_percentage(s):
    if not isinstance(s, str):
        return np.nan
    match = re.search(r'(\d+)%', s)
    if match:
        return float(match.group(1))
    return np.nan

target_companies['feature_adoption_pct'] = target_companies['feature_adoption'].apply(extract_percentage)

# Time since last value milestone - not available, we'll skip

# Merge features
features = target_companies[['company_id', 'company_name', 'industry', 'contract_size', 'feature_adoption_pct', 'sentiment_trend', 'health_score', 'days_to_renewal']].copy()
features = features.merge(conv_counts, on='company_id', how='left')
features = features.merge(sentiment_props[['company_id', 'neg_proportion']], on='company_id', how='left')
features = features.merge(resolution_avg, on='company_id', how='left')
features = features.merge(reopen_props[['company_id', 'reopen_proportion']], on='company_id', how='left')

# Fill missing values
features['avg_conversations_last30'] = features['avg_conversations_last30'].fillna(0)
features['neg_proportion'] = features['neg_proportion'].fillna(0)
features['avg_resolution_time_min'] = features['avg_resolution_time_min'].fillna(features['avg_resolution_time_min'].median())
features['reopen_proportion'] = features['reopen_proportion'].fillna(0)

print("\nFeatures sample:")
print(features.head())
print(f"\nFeatures shape: {features.shape}")
print(f"\nMissing values:\n{features.isnull().sum()}")

# Save features to CSV for further analysis
features.to_csv('target_companies_features.csv', index=False)
print("Features saved to target_companies_features.csv")
''')
