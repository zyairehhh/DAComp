```python
import pandas as pd
import numpy as np

# Load data
df = pd.read_csv('visitor_segment_raw.csv')
print(f"Total users with >60 active days: {len(df)}")

# Define segments
df['single_feature_use'] = df['distinct_features'] < 5
segment_single = df[df['single_feature_use']]
segment_normal = df[~df['single_feature_use']]

print(f"Single-feature-use users: {len(segment_single)}")
print(f"Normal users: {len(segment_normal)}")
print(f"Proportion of single-feature-use: {len(segment_single)/len(df):.2%}")

# NPS rating comparison
avg_nps_single = segment_single['latest_nps_rating'].mean()
avg_nps_normal = segment_normal['latest_nps_rating'].mean()
print(f"Average NPS single-feature-use: {avg_nps_single:.2f}")
print(f"Average NPS normal: {avg_nps_normal:.2f}")
print(f"Difference (single - normal): {avg_nps_single - avg_nps_normal:.2f}")

# Average daily minutes comparison
avg_min_single = segment_single['average_daily_minutes'].mean()
avg_min_normal = segment_normal['average_daily_minutes'].mean()
print(f"Average daily minutes single-feature-use: {avg_min_single:.2f}")
print(f"Average daily minutes normal: {avg_min_normal:.2f}")
print(f"Difference: {avg_min_single - avg_min_normal:.2f}")

# Retention: count_active_months
avg_months_single = segment_single['count_active_months'].mean()
avg_months_normal = segment_normal['count_active_months'].mean()
print(f"Average active months single-feature-use: {avg_months_single:.2f}")
print(f"Average active months normal: {avg_months_normal:.2f}")
print(f"Difference: {avg_months_single - avg_months_normal:.2f}")

# Also look at sum_minutes and sum_events
print(f"Total minutes sum single: {segment_single['sum_minutes'].sum():.0f}")
print(f"Total minutes sum normal: {segment_normal['sum_minutes'].sum():.0f}")
print(f"Total events sum single: {segment_single['sum_events'].sum():.0f}")
print(f"Total events sum normal: {segment_normal['sum_events'].sum():.0f}")

# Distribution of distinct features
print("\nDistinct features distribution in single-feature-use segment:")
print(segment_single['distinct_features'].value_counts().sort_index())
```
