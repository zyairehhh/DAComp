'''
import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv('filtered_campaigns.csv')
# Convert year_month to datetime
df['date'] = pd.to_datetime(df['year_month'])
df = df.sort_values('date')
monthly = df.groupby('date').agg(
    avg_health=('health_score', 'mean'),
    count=('health_score', 'size')
).reset_index()

plt.figure(figsize=(10,5))
plt.plot(monthly['date'], monthly['avg_health'], marker='o', linestyle='-', color='steelblue')
plt.fill_between(monthly['date'], monthly['avg_health'], alpha=0.3, color='steelblue')
plt.xlabel('Month')
plt.ylabel('Average Health Score')
plt.title('Monthly Trend of Campaign Health (High‑Cost, Low‑ROAS)')
plt.ylim(0, 100)
plt.grid(True, linestyle='--', alpha=0.7)
# Annotate peaks/troughs
for i, row in monthly.iterrows():
    plt.text(row['date'], row['avg_health']+2, f"{row['avg_health']:.1f}", ha='center', va='bottom', fontsize=9)
# Add count labels
for i, row in monthly.iterrows():
    plt.text(row['date'], row['avg_health']-5, f"n={row['count']}", ha='center', va='top', fontsize=8, color='gray')
plt.tight_layout()
plt.savefig('monthly_health_trend.png', dpi=300)
plt.close()
''')
