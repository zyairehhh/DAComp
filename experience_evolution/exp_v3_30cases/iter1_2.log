import pandas as pd
import sqlite3
import matplotlib.pyplot as plt
import numpy as np
from datetime import datetime

conn = sqlite3.connect('dacomp-017.sqlite')
df = pd.read_sql_query("SELECT * FROM order_information", conn)
df['Sales'] = pd.to_numeric(df['Sales'], errors='coerce')
df['profit'] = pd.to_numeric(df['profit'], errors='coerce')
df['Order Date'] = pd.to_datetime(df['Order Date'])
df['Shipping Cost'] = pd.to_numeric(df['Shipping Cost'].astype(str).str.replace(',', ''), errors='coerce')
df['Discount'] = pd.to_numeric(df['Discount'].astype(str).str.rstrip('%'), errors='coerce')

# Focus on Home & Furniture
home = df[df['Product Category']=='Home & Furniture'].copy()
# Recency: days since last order (max date = 2024-12-31)
max_date = home['Order Date'].max()  # let's assume this is 2024-12-31
# Compute RFM per customer
rfm = home.groupby('Customer ID').agg(
    last_order=('Order Date', 'max'),
    frequency=('Order ID', 'nunique'),
    monetary=('profit', 'sum')          # Use profit as monetary (as per stage1)
).reset_index()
rfm['recency'] = (max_date - rfm['last_order']).dt.days
# Normalize RFM scales (0-1) and composite score = (R_normalized + F_normalized + M_normalized)/3
rfm['R_norm'] = (rfm['recency'].max() - rfm['recency']) / (rfm['recency'].max() - rfm['recency'].min())
rfm['F_norm'] = (rfm['frequency'] - rfm['frequency'].min()) / (rfm['frequency'].max() - rfm['frequency'].min())
rfm['M_norm'] = (rfm['monetary'] - rfm['monetary'].min()) / (rfm['monetary'].max() - rfm['monetary'].min())
rfm['composite'] = (rfm['R_norm'] + rfm['F_norm'] + rfm['M_norm']) / 3
# Segment top 20% as core
threshold = rfm['composite'].quantile(0.80)
rfm['segment'] = np.where(rfm['composite'] >= threshold, 'Core', 'Regular')
print(f'Segmentation counts: Core {sum(rfm.segment=="Core")}, Regular {sum(rfm.segment=="Regular")}')

# Merge segment back to transaction data
home = home.merge(rfm[['Customer ID', 'segment']], on='Customer ID', how='left')

# Compute monthly aggregate margin, avg shipping, avg discount per segment
home['month'] = home['Order Date'].dt.to_period('M')
monthly_seg = home.groupby(['month', 'segment']).agg(
    total_sales=('Sales', 'sum'),
    total_profit=('profit', 'sum'),
    avg_shipping=('Shipping Cost', 'mean'),
    avg_discount=('Discount', 'mean')
).reset_index()
monthly_seg['margin'] = monthly_seg['total_profit'] / monthly_seg['total_sales'] * 100
monthly_seg['month_date'] = monthly_seg['month'].dt.to_timestamp()

# Plot 1: Bar chart of segment averages (margin, recency, frequency, monetary)
seg_avg = rfm.groupby('segment').agg(
    avg_margin=('monetary', lambda x: 0),  # placeholder, we need margin from transaction data
    avg_recency=('recency', 'mean'),
    avg_frequency=('frequency', 'mean'),
    avg_monetary=('monetary', 'mean')
).reset_index()
# Compute margin per segment via transaction data
seg_margin = home.groupby('segment').agg(
    total_sales=('Sales', 'sum'),
    total_profit=('profit', 'sum')
).reset_index()
seg_margin['avg_margin'] = seg_margin['total_profit'] / seg_margin['total_sales'] * 100
seg_avg = seg_avg.merge(seg_margin[['segment', 'avg_margin']], on='segment')
seg_avg = seg_avg[['segment', 'avg_margin', 'avg_recency', 'avg_frequency', 'avg_monetary']]

# Plot grouped bar
labels = ['Avg Margin (%)', 'Avg Recency (days)', 'Avg Frequency', 'Avg Monetary ($)']
x = np.arange(len(labels))
width = 0.35
fig, ax = plt.subplots(figsize=(10,6))
core_vals = [seg_avg.loc[seg_avg.segment=='Core', 'avg_margin'].values[0],
             seg_avg.loc[seg_avg.segment=='Core', 'avg_recency'].values[0],
             seg_avg.loc[seg_avg.segment=='Core', 'avg_frequency'].values[0],
             seg_avg.loc[seg_avg.segment=='Core', 'avg_monetary'].values[0]]
reg_vals = [seg_avg.loc[seg_avg.segment=='Regular', 'avg_margin'].values[0],
            seg_avg.loc[seg_avg.segment=='Regular', 'avg_recency'].values[0],
            seg_avg.loc[seg_avg.segment=='Regular', 'avg_frequency'].values[0],
            seg_avg.loc[seg_avg.segment=='Regular', 'avg_monetary'].values[0]]
ax.bar(x - width/2, core_vals, width, label='Core', color='darkorange')
ax.bar(x + width/2, reg_vals, width, label='Regular', color='skyblue')
ax.set_ylabel('Value')
ax.set_title('Core vs Regular Consumers: RFM & Profit Margin Comparison')
ax.set_xticks(x)
ax.set_xticklabels(labels)
ax.legend()
ax.grid(True, alpha=0.3)
# Annotate values
for i, v in enumerate(core_vals):
    ax.text(i - width/2, v + (0.02*max(core_vals)), f'{v:.1f}', ha='center', va='bottom', fontsize=9)
for i, v in enumerate(reg_vals):
    ax.text(i + width/2, v + (0.02*max(reg_vals)), f'{v:.1f}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('rfm_segment_bar.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 2: Scatter of margin vs shipping cost per segment (monthly)
fig, (ax1, ax2) = plt.subplots(1,2, figsize=(14,6))
core_data = monthly_seg[monthly_seg.segment=='Core']
reg_data = monthly_seg[monthly_seg.segment=='Regular']
corr_core = np.corrcoef(core_data['margin'], core_data['avg_shipping'])[0,1]
corr_reg = np.corrcoef(reg_data['margin'], reg_data['avg_shipping'])[0,1]
ax1.scatter(core_data['avg_shipping'], core_data['margin'], alpha=0.7, color='darkorange', label=f'Core (r={corr_core:.3f})')
z = np.polyfit(core_data['avg_shipping'], core_data['margin'], 1)
p = np.poly1d(z)
ax1.plot(core_data['avg_shipping'], p(core_data['avg_shipping']), '--', color='darkorange')
ax1.set_xlabel('Average Shipping Cost')
ax1.set_ylabel('Profit Margin (%)')
ax1.set_title('Core Consumers: Margin vs Shipping Cost')
ax1.legend()
ax1.grid(True, alpha=0.3)

ax2.scatter(reg_data['avg_shipping'], reg_data['margin'], alpha=0.7, color='skyblue', label=f'Regular (r={corr_reg:.3f})')
z = np.polyfit(reg_data['avg_shipping'], reg_data['margin'], 1)
p = np.poly1d(z)
ax2.plot(reg_data['avg_shipping'], p(reg_data['avg_shipping']), '--', color='skyblue')
ax2.set_xlabel('Average Shipping Cost')
ax2.set_ylabel('Profit Margin (%)')
ax2.set_title('Regular Consumers: Margin vs Shipping Cost')
ax2.legend()
ax2.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('segment_sensitivity_scatter.png', dpi=300, bbox_inches='tight')
plt.close()

print('Generated rfm_segment_bar.png and segment_sensitivity_scatter.png')
''')
