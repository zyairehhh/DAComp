import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-066.sqlite')
df = pd.read_sql_query("""
SELECT p.*, e.departments, e.hiring_managers, e.recruiters, e.sourcers,
       e.avg_interviews_per_application, e.avg_job_rating, e.overall_conversion_rate,
       e.created_at
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
""", conn)
conn.close()
print(f"Total rows: {len(df)}")
# Extract role
df['role_category'] = df['job_title'].str.split(' - ').str[0]
# Filter only Engineering
eng_df = df[df['departments'] == 'Engineering'].copy()
print(f"Engineering rows: {len(eng_df)}")
# Weighted conversion rate by department and quarter using total_applications as weight
def weighted_avg(group):
    if group['total_applications'].sum() == 0:
        return np.nan
    return (group['total_interviews'] / group['total_applications']).sum() * 100
overall_eng_q3 = weighted_avg(eng_df[eng_df['application_quarter'] == 3])
overall_eng_q4 = weighted_avg(eng_df[eng_df['application_quarter'] == 4])
print(f"Weighted overall Engineering conversion Q3: {overall_eng_q3:.2f}%")
print(f"Weighted overall Engineering conversion Q4: {overall_eng_q4:.2f}%")
# Compute weighted conversion by role
role_weighted = pd.DataFrame()
for role in eng_df['role_category'].unique():
    sub = eng_df[eng_df['role_category'] == role]
    q3 = sub[sub['application_quarter'] == 3]
    q4 = sub[sub['application_quarter'] == 4]
    w_q3 = weighted_avg(q3) if len(q3) > 0 else np.nan
    w_q4 = weighted_avg(q4) if len(q4) > 0 else np.nan
    role_weighted = role_weighted.append({
        'role': role,
        'weighted_conv_q3': w_q3,
        'weighted_conv_q4': w_q4,
        'change': w_q4 - w_q3,
        'job_count_q3': len(q3),
        'job_count_q4': len(q4)
    }, ignore_index=True)
role_weighted = role_weighted.sort_values('change')
print("\nRole weighted conversion change (most decline):")
print(role_weighted.head(10))
# Hiring manager analysis
hm_df = eng_df.groupby('hiring_managers').agg(
    avg_interview_rate=('interview_rate', 'mean'),
    weighted_conv=('interview_rate', lambda x: np.average(x, weights=eng_df.loc[x.index, 'total_applications'])),
    job_count=('job_id', 'count'),
    total_applications=('total_applications', 'sum'),
    avg_interviews_per_app=('avg_interviews_per_application', 'mean'),
    avg_job_rating=('avg_job_rating', 'mean')
).reset_index()
hm_df = hm_df.sort_values('weighted_conv')
print("\nHiring managers by weighted conversion rate (lowest):")
print(hm_df.head(10))
# Compute correlation between avg_interviews_per_application and interview_rate
corr = eng_df['interview_rate'].corr(eng_df['avg_interviews_per_application'])
print(f"\nCorrelation between interview_rate and avg_interviews_per_application: {corr:.3f}")
# Compare high vs low conversion groups
high_conv = eng_df[eng_df['interview_rate'] >= eng_df['interview_rate'].median()]
low_conv = eng_df[eng_df['interview_rate'] < eng_df['interview_rate'].median()]
print(f"High conversion avg_interviews_per_application: {high_conv['avg_interviews_per_application'].mean():.3f}")
print(f"Low conversion avg_interviews_per_application: {low_conv['avg_interviews_per_application'].mean():.3f}")
# Write to CSV
role_weighted.to_csv('role_weighted_change.csv', index=False)
hm_df.to_csv('hiring_manager_summary.csv', index=False)
