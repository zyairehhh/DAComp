import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.ticker as mtick
import numpy as np
import os

# Connect to database
db_path = 'dacomp-017.sqlite'
conn = sqlite3.connect(db_path)

# 1. Profit margin by category per year (2022-2024)
query = """
SELECT 
    "Product Category",
    strftime('%Y', "Order Date") as year,
    SUM(profit) as total_profit,
    SUM(CAST(Sales AS REAL)) as total_sales
FROM order_information
WHERE year IN ('2022','2023','2024')
GROUP BY "Product Category", year
ORDER BY "Product Category", year
"""
df = pd.read_sql_query(query, conn)
df['margin'] = df['total_profit'] / df['total_sales'] * 100

# Pivot for line chart
pivot = df.pivot(index='Product Category', columns='year', values='margin')
print("Profit margin by category (%):")
print(pivot.round(2))

# Plot
plt.figure(figsize=(8,5))
for category in pivot.index:
    plt.plot(pivot.columns, pivot.loc[category], marker='o', label=category)
plt.title('Profit Margin by Product Category (2022-2024)')
plt.xlabel('Year')
plt.ylabel('Profit Margin (%)')
plt.gca().yaxis.set_major_formatter(mtick.PercentFormatter(decimals=1))
plt.legend(title='Category')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('margin_by_category.png', dpi=300)
plt.close()

# 2. Home & Furniture product-mix shift: high-margin vs low-margin products
# Identify high-margin products as per Stage1: Towels, Sofa Covers, Bed Sheets
high_margin_products = ['Towels', 'Sofa Covers', 'Bed Sheets']
# Others as low-margin (though we could also separate medium)
# We'll compute sales share of high-margin vs low-margin per year for Home & Furniture
query_mix = """
SELECT 
    strftime('%Y', "Order Date") as year,
    Product,
    SUM(CAST(Sales AS REAL)) as total_sales
FROM order_information
WHERE "Product Category" = 'Home & Furniture'
    AND year IN ('2022','2023','2024')
GROUP BY year, Product
"""
df_mix = pd.read_sql_query(query_mix, conn)
df_mix['is_high'] = df_mix['Product'].isin(high_margin_products)
# Aggregate
df_mix_agg = df_mix.groupby(['year', 'is_high']).agg({'total_sales':'sum'}).reset_index()
# Compute total sales per year
year_total = df_mix_agg.groupby('year')['total_sales'].sum().reset_index(name='year_total')
df_mix_agg = df_mix_agg.merge(year_total, on='year')
df_mix_agg['share'] = df_mix_agg['total_sales'] / df_mix_agg['year_total'] * 100
# Separate dataframes for plotting
high_share = df_mix_agg[df_mix_agg['is_high']].set_index('year')['share']
low_share = df_mix_agg[~df_mix_agg['is_high']].set_index('year')['share']

print("\nHigh-margin product sales share (%):")
print(high_share.round(2))

# Stacked bar chart
years = ['2022','2023','2024']
high_vals = [high_share.get(y, 0) for y in years]
low_vals = [low_share.get(y, 0) for y in years]

plt.figure(figsize=(7,5))
plt.bar(years, high_vals, label='High-margin products', color='#2ca02c')
plt.bar(years, low_vals, bottom=high_vals, label='Low-margin products', color='#d62728')
plt.title('Home & Furniture: Sales Share by Margin Tier')
plt.xlabel('Year')
plt.ylabel('Sales Share (%)')
plt.legend()
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('product_mix_shift.png', dpi=300)
plt.close()

# 3. Discount and shipping cost trends for Home & Furniture
query_disc = """
SELECT 
    strftime('%Y', "Order Date") as year,
    AVG(CAST(Discount AS REAL)) as avg_discount,
    AVG(CAST("Shipping Cost" AS REAL)) as avg_shipping_cost
FROM order_information
WHERE "Product Category" = 'Home & Furniture'
    AND year IN ('2022','2023','2024')
GROUP BY year
ORDER BY year
"""
df_disc = pd.read_sql_query(query_disc, conn)
print("\nAverage discount and shipping cost for Home & Furniture:")
print(df_disc)

# Line chart with dual y-axes
fig, ax1 = plt.subplots(figsize=(7,5))
color1 = 'tab:blue'
ax1.set_xlabel('Year')
ax1.set_ylabel('Average Discount (%)', color=color1)
ax1.plot(df_disc['year'], df_disc['avg_discount'], marker='s', color=color1, linewidth=2, label='Discount')
ax1.tick_params(axis='y', labelcolor=color1)
ax1.yaxis.set_major_formatter(mtick.PercentFormatter(decimals=1))

ax2 = ax1.twinx()
color2 = 'tab:red'
ax2.set_ylabel('Average Shipping Cost ($)', color=color2)
ax2.plot(df_disc['year'], df_disc['avg_shipping_cost'], marker='^', color=color2, linewidth=2, label='Shipping Cost')
ax2.tick_params(axis='y', labelcolor=color2)

plt.title('Home & Furniture: Discount and Shipping Cost Trends')
fig.tight_layout()
plt.savefig('discount_shipping_trends.png', dpi=300)
plt.close()

# 4. RFM segmentation for Home & Furniture customers
# Compute RFM scores as of 2024-12-31.
query_rfm = """
WITH customer_data AS (
    SELECT 
        "Customer ID",
        MAX("Order Date") as last_purchase,
        COUNT(DISTINCT "Order ID") as frequency,
        SUM(profit) as monetary
    FROM order_information
    WHERE "Product Category" = 'Home & Furniture'
    GROUP BY "Customer ID"
),
rfm AS (
    SELECT 
        *,
        JULIANDAY('2024-12-31') - JULIANDAY(last_purchase) as recency_days
    FROM customer_data
),
quartiles AS (
    SELECT 
        *,
        NTILE(4) OVER (ORDER BY recency_days DESC) as R_quartile,
        NTILE(4) OVER (ORDER BY frequency) as F_quartile,
        NTILE(4) OVER (ORDER BY monetary) as M_quartile
    FROM rfm
),
scores AS (
    SELECT 
        *,
        (R_quartile + F_quartile + M_quartile) as RFM_score
    FROM quartiles
),
segments AS (
    SELECT 
        *,
        CASE 
            WHEN RFM_score >= 10 THEN 'High'
            WHEN RFM_score <= 5 THEN 'Low'
            ELSE 'Mid'
        END as segment
    FROM scores
)
SELECT * FROM segments
"""
df_rfm = pd.read_sql_query(query_rfm, conn)
print("\nRFM segmentation counts:")
print(df_rfm['segment'].value_counts())

# Merge with order data
query_orders = """
SELECT 
    "Customer ID",
    strftime('%Y', "Order Date") as year,
    profit,
    CAST(Sales AS REAL) as sales
FROM order_information
WHERE "Product Category" = 'Home & Furniture'
    AND year IN ('2022','2023','2024')
"""
df_orders = pd.read_sql_query(query_orders, conn)
df_orders_seg = df_orders.merge(df_rfm[['Customer ID', 'segment']], on='Customer ID', how='inner')
# Compute margin per segment per year
df_seg_margin = df_orders_seg.groupby(['segment', 'year']).agg({'profit':'sum', 'sales':'sum'}).reset_index()
df_seg_margin['margin'] = df_seg_margin['profit'] / df_seg_margin['sales'] * 100
print("\nRFM segment margins (%):")
print(df_seg_margin.pivot(index='segment', columns='year', values='margin').round(2))

# Plot
plt.figure(figsize=(7,5))
segments_order = ['High', 'Mid', 'Low']
for seg in segments_order:
    sub = df_seg_margin[df_seg_margin['segment']==seg].sort_values('year')
