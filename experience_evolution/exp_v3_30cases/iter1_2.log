'''
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# Load cleaned data
df = pd.read_csv('cleaned_data.csv')

# Convert Price to yuan
df['Price_in_yuan'] = df['Price'] * 10000
df['Depreciation_Rate'] = (1 - df['Price_in_yuan'] / df['New_Car_Price_Cleaned']) * 100
df_clean = df[(df['Depreciation_Rate'] >= 0) & (df['Depreciation_Rate'] <= 100)].copy()

# Create figure for additional insights
fig = plt.figure(figsize=(16, 10))

# 1. Depreciation rate distribution by fuel type
ax1 = plt.subplot(2, 3, 1)
fuel_order = df_clean.groupby('Fuel Type')['Depreciation_Rate'].median().sort_values().index
sns.boxplot(data=df_clean, x='Fuel Type', y='Depreciation_Rate', order=fuel_order, ax=ax1)
ax1.set_title('Depreciation Rate by Fuel Type', fontsize=14, fontweight='bold')
ax1.set_xlabel('Fuel Type', fontsize=12)
ax1.set_ylabel('Depreciation Rate (%)', fontsize=12)
ax1.tick_params(axis='x', rotation=45)

# 2. Depreciation vs Car Age with regression line
ax2 = plt.subplot(2, 3, 2)
# Sample for clarity
sample_df = df_clean.sample(min(200, len(df_clean)), random_state=42)
sns.regplot(data=sample_df, x='Car_Age', y='Depreciation_Rate', 
           scatter_kws={'alpha': 0.5, 's': 30}, 
           line_kws={'color': 'red', 'linewidth': 2}, ax=ax2)
ax2.set_title('Depreciation Rate vs Car Age', fontsize=14, fontweight='bold')
ax2.set_xlabel('Car Age (years)', fontsize=12)
ax2.set_ylabel('Depreciation Rate (%)', fontsize=12)
ax2.grid(True, alpha=0.3)

# 3. Price distribution by transmission type
ax3 = plt.subplot(2, 3, 3)
trans_order = df_clean.groupby('Transmission')['Price_in_yuan'].median().sort_values(ascending=False).index
sns.boxplot(data=df_clean, x='Transmission', y='Price_in_yuan', order=trans_order, ax=ax3)
ax3.set_title('Price Distribution by Transmission Type', fontsize=14, fontweight='bold')
ax3.set_xlabel('Transmission', fontsize=12)
ax3.set_ylabel('Price (yuan)', fontsize=12)
ax3.tick_params(axis='x', rotation=45)

# 4. Depreciation rate heatmap for top brands and vehicle classes
ax4 = plt.subplot(2, 3, 4)
# Select top 5 brands and top 5 vehicle classes
top_5_brands = df_clean['Brand'].value_counts().head(5).index.tolist()
top_5_classes = df_clean['Vehicle Class'].value_counts().head(5).index.tolist()
heatmap_data = df_clean[df_clean['Brand'].isin(top_5_brands) & 
                        df_clean['Vehicle Class'].isin(top_5_classes)]

# Pivot table for heatmap
if len(heatmap_data) > 0:
    pivot_table = heatmap_data.pivot_table(
        values='Depreciation_Rate', 
        index='Brand', 
        columns='Vehicle Class', 
        aggfunc='mean'
    )
    # Reorder for better visualization
    pivot_table = pivot_table.reindex(index=top_5_brands, columns=top_5_classes)
    
    sns.heatmap(pivot_table, annot=True, fmt='.1f', cmap='RdYlGn_r', 
                center=pivot_table.mean().mean(), ax=ax4)
    ax4.set_title('Depreciation Rate Heatmap:\nBrand vs Vehicle Class', 
                 fontsize=14, fontweight='bold')
    ax4.set_xlabel('Vehicle Class', fontsize=12)
    ax4.set_ylabel('Brand', fontsize=12)
else:
    ax4.text(0.5, 0.5, 'Insufficient data\nfor heatmap', 
            ha='center', va='center', fontsize=14)
    ax4.set_title('Depreciation Rate Heatmap:\nBrand vs Vehicle Class', 
                 fontsize=14, fontweight='bold')

# 5. Cumulative distribution of depreciation rate
ax5 = plt.subplot(2, 3, 5)
sorted_depreciation = np.sort(df_clean['Depreciation_Rate'])
cumulative = np.arange(1, len(sorted_depreciation) + 1) / len(sorted_depreciation)
ax5.plot(sorted_depreciation, cumulative, linewidth=3)
ax5.set_title('CDF of Depreciation Rate', fontsize=14, fontweight='bold')
ax5.set_xlabel('Depreciation Rate (%)', fontsize=12)
ax5.set_ylabel('Cumulative Probability', fontsize=12)
ax5.grid(True, alpha=0.3)
# Add reference lines
ax5.axvline(x=20, color='green', linestyle='--', alpha=0.7, label='20% depreciation')
ax5.axvline(x=50, color='red', linestyle='--', alpha=0.7, label='50% depreciation')
ax5.legend()

# 6. Top 10 models with highest price (potential premium models)
ax6 = plt.subplot(2, 3, 6)
# Get models with at least 3 samples
model_counts = df_clean['Title'].value_counts()
valid_models = model_counts[model_counts >= 3].index.tolist()
df_models = df_clean[df_clean['Title'].isin(valid_models)]

# Top 10 models by average price
top_price_models = df_models.groupby('Title')['Price_in_yuan'].mean().nlargest(10).sort_values()
# Shorten model names for display
short_names = [name[:30] + '...' if len(name) > 30 else name for name in top_price_models.index]
sns.barplot(x=top_price_models.values, y=short_names, ax=ax6, palette='magma')
ax6.set_title('Top 10 Models by Average Price\n(Min 3 samples)', fontsize=14, fontweight='bold')
ax6.set_xlabel('Average Price (yuan)', fontsize=12)
ax6.set_ylabel('Model', fontsize=12)

plt.tight_layout()
plt.savefig('additional_insights.png', dpi=300, bbox_inches='tight')
print("Saved additional_insights.png")

# Print key insights for report
print("\\n=== ADDITIONAL INSIGHTS ===")

# Fuel type depreciation comparison
fuel_stats = df_clean.groupby('Fuel Type').agg(
    avg_depreciation=('Depreciation_Rate', 'mean'),
    count=('Depreciation_Rate', 'count'),
    avg_age=('Car_Age', 'mean')
).round(1).sort_values('avg_depreciation')

print("\\nDepreciation by Fuel Type:")
print(fuel_stats)

# Correlation between car age and depreciation
correlation = df_clean[['Car_Age', 'Depreciation_Rate']].corr().iloc[0,1]
print(f"\\nCorrelation between Car Age and Depreciation Rate: {correlation:.3f}")

# Premium segment analysis (top 20% by price)
price_threshold = df_clean['Price_in_yuan'].quantile(0.8)
premium_cars = df_clean[df_clean['Price_in_yuan'] >= price_threshold]
print(f"\\nPremium Segment (Top 20% by price):")
print(f"  Number of cars: {len(premium_cars)}")
print(f"  Average depreciation: {premium_cars['Depreciation_Rate'].mean():.1f}%")
print(f"  Average price: {premium_cars['Price_in_yuan'].mean():,.0f} yuan")
print(f"  Top 3 brands: {premium_cars['Brand'].value_counts().head(3).to_dict()}")

# Economy segment analysis (bottom 20% by price)
economy_threshold = df_clean['Price_in_yuan'].quantile(0.2)
economy_cars = df_clean[df_clean['Price_in_yuan'] <= economy_threshold]
print(f"\\nEconomy Segment (Bottom 20% by price):")
print(f"  Number of cars: {len(economy_cars)}")
print(f"  Average depreciation: {economy_cars['Depreciation_Rate'].mean():.1f}%")
print(f"  Average price: {economy_cars['Price_in_yuan'].mean():,.0f} yuan")
print(f"  Top 3 brands: {economy_cars['Brand'].value_counts().head(3).to_dict()}")
''')
