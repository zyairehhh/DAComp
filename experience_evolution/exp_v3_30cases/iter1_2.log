print("Correlation matrix of profit vs browsing metrics:")
print(corr['total_profit'].sort_values(ascending=False))
print()
# Save to CSV for reference
df.to_csv('fashion_segmented.csv', index=False)
print("Saved segmented data to fashion_segmented.csv")
conn.close()
