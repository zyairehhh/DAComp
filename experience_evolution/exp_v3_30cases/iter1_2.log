Action: EditFile(filepath='/workspace/analysis.py'):
```
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-001.sqlite')
# Load data
company = pd.read_sql_query('SELECT "Enterprise Code", "Credit Rating", "Defaulted" FROM ch___company_info', conn)
sales = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax", "Buyer organization code" FROM ch___sales_invoices', conn)
inputs = pd.read_sql_query('SELECT "Enterprise Code", "Invoice Date", "Amount Including Tax", "Seller Organization Code" FROM ch___input_invoices', conn)
churn = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)

sales['Invoice Date'] = pd.to_datetime(sales['Invoice Date'])
inputs['Invoice Date'] = pd.to_datetime(inputs['Invoice Date'])

# Compute total sales and profit per company
total_sales = sales.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_sales')
total_input = inputs.groupby('Enterprise Code')['Amount Including Tax'].sum().rename('total_input')
profit = total_sales - total_input

# Revenue capacity: total_sales
# Profit stability: compute coefficient of variation of annual profit
sales['year'] = sales['Invoice Date'].dt.year
inputs['year'] = inputs['Invoice Date'].dt.year
annual_sales = sales.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().rename('annual_sales')
annual_input = inputs.groupby(['Enterprise Code', 'year'])['Amount Including Tax'].sum().rename('annual_input')
annual = pd.concat([annual_sales, annual_input], axis=1).fillna(0)
annual['annual_profit'] = annual['annual_sales'] - annual['annual_input']

def cv(x):
    if len(x) > 1 and x.mean() != 0:
        return x.std() / x.mean()
    else:
        return np.nan

profit_cv = annual.groupby('Enterprise Code')['annual_profit'].apply(cv).rename('profit_cv')
profit_mean = annual.groupby('Enterprise Code')['annual_profit'].mean().rename('profit_mean')
profit_std = annual.groupby('Enterprise Code')['annual_profit'].std().rename('profit_std')

# Dependency: HHI for buyers and sellers
def hhi(group):
    total = group.sum()
    if total == 0:
        return np.nan
    share = group / total
    return (share ** 2).sum() * 10000

buyer_hhi = sales.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('buyer_hhi')
seller_hhi = inputs.groupby('Enterprise Code')['Amount Including Tax'].apply(hhi).rename('seller_hhi')
num_buyers = sales.groupby('Enterprise Code')['Buyer organization code'].nunique().rename('num_buyers')
num_sellers = inputs.groupby('Enterprise Code')['Seller Organization Code'].nunique().rename('num_sellers')

# Combine all features
features = pd.concat([total_sales, total_input, profit, profit_cv, profit_mean, profit_std, buyer_hhi, seller_hhi, num_buyers, num_sellers], axis=1)
features = features.fillna(0)

# Merge with company
df = company.set_index('Enterprise Code').join(features, how='inner')
df = df.reset_index()

print("Features shape:", df.shape)
print(df.head())

# Compute risk score
rating_map = {'A':1, 'B':2, 'C':3, 'D':4}
df['rating_score'] = df['Credit Rating'].map(rating_map)
df['default_score'] = df['Defaulted'].apply(lambda x: 1 if x=='Yes' else 0)
df['sales_percentile'] = df['total_sales'].rank(pct=True, ascending=False)  # higher sales -> lower risk
# Profit CV: lower is better, invert
df['profit_cv_inv'] = 1 / (1 + df['profit_cv'].abs())  # map to 0-1, higher better
# Combine HHI
df['avg_hhi'] = (df['buyer_hhi'] + df['seller_hhi']) / 2
df['hhi_percentile'] = df['avg_hhi'].rank(pct=True, ascending=True)  # lower HHI -> lower risk, percentile 0-1

# Weighted risk score (higher = higher risk)
weights = {'rating': 0.3, 'default': 0.2, 'sales': 0.2, 'cv': 0.15, 'hhi': 0.15}
df['risk_score'] = (
    df['rating_score'] * weights['rating'] +
    df['default_score'] * weights['default'] +
    (1 - df['sales_percentile']) * weights['sales'] +
    (1 - df['profit_cv_inv']) * weights['cv'] +   # because profit_cv_inv higher better, so risk = 1 - inv
    df['hhi_percentile'] * weights['hhi']
)

# Normalize risk score to 0-1
df['risk_score_norm'] = (df['risk_score'] - df['risk_score'].min()) / (df['risk_score'].max() - df['risk_score'].min())

print(df[['Enterprise Code', 'Credit Rating', 'Defaulted', 'total_sales', 'profit_cv', 'avg_hhi', 'risk_score_norm']].head(10))

# Allocate credit limits (total 100,000,000 RMB)
total_credit = 100_000_000
# Base limit proportional to sales and inverse risk
df['capacity_factor'] = df['total_sales'] / df['total_sales'].sum()
df['risk_adjustment'] = 1 - df['risk_score_norm']  # lower risk -> higher adjustment
df['raw_limit'] = df['capacity_factor'] * df['risk_adjustment']
df['credit_limit'] = df['raw_limit'] / df['raw_limit'].sum() * total_credit

# Assign interest rates based on credit rating using churn table
def assign_interest_rate(rating, churn_df, threshold=0.2):
    if rating == 'D':
        # No churn data, assign maximum interest rate from table as punitive
        return churn_df['Annual Loan Interest Rate'].max()
    col = f'Credit Rating {rating} Customer Churn Rate'
    # find subset where churn <= threshold
    subset = churn_df[churn_df[col] <= threshold]
    if not subset.empty:
        # choose the highest interest rate while keeping churn below threshold (maximize profit)
        return subset['Annual Loan Interest Rate'].max()
    else:
        # fallback to minimal churn rate
        min_churn_idx = churn_df[col].idxmin()
        return churn_df.loc[min_churn_idx, 'Annual Loan Interest Rate']

rating_to_rate = {}
for rating in ['A','B','C','D']:
    rating_to_rate[rating] = assign_interest_rate(rating, churn, threshold=0.2)

print("Interest rates by rating:", rating_to_rate)

df['interest_rate'] = df['Credit Rating'].map(rating_to_rate)

# Print summary
print("\nCredit Allocation Summary (top 20):")
print(df[['Enterprise Code', 'Credit Rating', 'total_sales', 'profit_cv', 'avg_hhi', 'risk_score_norm', 'credit_limit', 'interest_rate']].head(20))
print(f"\nTotal allocated credit: {df['credit_limit'].sum():,.2f} RMB")
print(f"Average interest rate: {df['interest_rate'].mean():.4f}")
print(f"Number of companies: {len(df)}")

# Save results
df.to_csv('/workspace/credit_allocation_results.csv', index=False)
print("Results saved to credit_allocation_results.csv")

# Additional analysis: risk distribution
print("\nRisk score distribution by credit rating:")
print(df.groupby('Credit Rating')['risk_score_norm'].describe())

# Credit limit allocation by rating
print("\nCredit limit allocation by rating:")
allocation_by_rating = df.groupby('Credit Rating').agg({'credit_limit':'sum', 'interest_rate':'mean'}).reset_index()
print(allocation_by_rating)

# Incorporate churn into credit limit adjustment: maybe reduce limit for high churn.
# We can adjust credit limit by (1 - churn_rate) where churn rate corresponds to assigned interest rate.
# For each rating, we have churn rate at assigned interest rate.
def get_churn_at_rate(rating, rate, churn_df):
    if rating == 'D':
        return 1.0  # assume 100% churn (default)
    col = f'Credit Rating {rating} Customer Churn Rate'
    # find row where rate matches exactly
    match = churn_df[churn_df['Annual Loan Interest Rate'] == rate]
    if not match.empty:
        return match.iloc[0][col]
    else:
        # interpolate
        # find nearest rate
        idx = (churn_df['Annual Loan Interest Rate'] - rate).abs().idxmin()
        return churn_df.loc[idx, col]

df['churn_rate'] = df.apply(lambda row: get_churn_at_rate(row['Credit Rating'], row['interest_rate'], churn), axis=1)
# Adjust credit limit by (1 - churn_rate) to reflect expected loss
print("\nAdjusting credit limits by churn probability...")
df['credit_limit_adjusted'] = df['credit_limit'] * (1 - df['churn_rate'])
# Renormalize to keep total credit same? We can either keep total constant or allow reduction.
# To keep total credit allocation at 100m, renormalize.
df['credit_limit_adjusted'] = df['credit_limit_adjusted'] / df['credit_limit_adjusted'].sum() * total_credit

print("\nAdjusted Credit Allocation Summary (top 20):")
print(df[['Enterprise Code', 'Credit Rating', 'churn_rate', 'credit_limit', 'credit_limit_adjusted', 'interest_rate']].head(20))
print(f"\nTotal adjusted credit: {df['credit_limit_adjusted'].sum():,.2f} RMB")

print("\nFinal allocation by rating:")
final_allocation = df.groupby('Credit Rating').agg({'credit_limit_adjusted':'sum', 'interest_rate':'mean'}).reset_index()
print(final_allocation)
