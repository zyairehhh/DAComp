'''
import pandas as pd
import numpy as np

# Load full data with anomaly flag (generated earlier)
df = pd.read_csv('full_data_with_anomaly_flag.csv')
print("Dataset shape:", df.shape)
print("\n--- Anomaly Rate by Profitability Segment ---")
seg_anomaly = df.groupby('profitability_segment')['is_anomaly'].agg(['sum','count']).reset_index()
seg_anomaly['anomaly_rate'] = seg_anomaly['sum'] / seg_anomaly['count']
print(seg_anomaly.sort_values('anomaly_rate', ascending=False))

print("\n--- Characteristics of Anomalies vs Normal within each segment ---")
for segment in df['profitability_segment'].unique():
    sub = df[df['profitability_segment']==segment]
    anomaly_sub = sub[sub['is_anomaly']]
    normal_sub = sub[~sub['is_anomaly']]
    if len(anomaly_sub) == 0:
        continue
    print(f"\nSegment: {segment} (anomalies: {len(anomaly_sub)}, normal: {len(normal_sub)})")
    # Compare transaction_value_volatility
    if len(normal_sub) > 0:
        print(f"  Transaction value volatility: anomaly {anomaly_sub['transaction_value_volatility'].mean():.3f} vs normal {normal_sub['transaction_value_volatility'].mean():.3f}")
    # Compare seasonal_preference distribution
    pref_counts = anomaly_sub['seasonal_preference'].value_counts(normalize=True)
    if len(pref_counts) > 0:
        top_pref = pref_counts.index[0]
        print(f"  Top seasonal preference in anomalies: {top_pref} ({pref_counts.iloc[0]:.1%})")
    # Compare transaction_consistency
    cons_counts = anomaly_sub['transaction_consistency'].value_counts(normalize=True)
    if len(cons_counts) > 0:
        top_cons = cons_counts.index[0]
        print(f"  Top transaction consistency in anomalies: {top_cons} ({cons_counts.iloc[0]:.1%})")
    # Compare retention_category
    ret_counts = anomaly_sub['retention_category'].value_counts(normalize=True)
    if len(ret_counts) > 0:
        top_ret = ret_counts.index[0]
        print(f"  Top retention category in anomalies: {top_ret} ({ret_counts.iloc[0]:.1%})")
    # Compare value_tier
    val_counts = anomaly_sub['value_tier'].value_counts(normalize=True)
    if len(val_counts) > 0:
        top_val = val_counts.index[0]
        print(f"  Top value tier in anomalies: {top_val} ({val_counts.iloc[0]:.1%})")

print("\n--- Transaction Consistency vs Volatility ---")
# Create a cross-tab of transaction_consistency and transaction_value_volatility categories (bin volatility)
df['volatility_bin'] = pd.qcut(df['transaction_value_volatility'], q=3, labels=['Low','Medium','High'])
contingency = pd.crosstab(df['transaction_consistency'], df['volatility_bin'], normalize='all')
print("Joint distribution (all customers):")
print(contingency.round(3))
contingency_anomaly = pd.crosstab(df[df['is_anomaly']]['transaction_consistency'], df[df['is_anomaly']]['volatility_bin'], normalize='all')
print("\nJoint distribution (anomalies only):")
print(contingency_anomaly.round(3))

print("\n--- Seasonal Pattern Distribution ---")
seasonal_by_anomaly = pd.crosstab(df['seasonal_preference'], df['is_anomaly'], normalize='columns')
print("Seasonal preference by anomaly status:")
print(seasonal_by_anomaly.round(3))

print("\n--- Correlation between Comprehensive Score and Total Revenue ---")
corr_all = df['comprehensive_customer_score'].corr(df['total_revenue'])
corr_anomaly = df[df['is_anomaly']]['comprehensive_customer_score'].corr(df[df['is_anomaly']]['total_revenue'])
corr_normal = df[~df['is_anomaly']]['comprehensive_customer_score'].corr(df[~df['is_anomaly']]['total_revenue'])
print(f"All customers: {corr_all:.3f}")
print(f"Anomalies: {corr_anomaly:.3f}")
print(f"Normal: {corr_normal:.3f}")

print("\n--- Transaction Count vs Avg Transactions per Month Consistency ---")
# Compute discrepancy as earlier
df['estimated_trans'] = df['avg_transactions_per_month'] * (df['customer_age_days'] / 30.0)
df['trans_discrepancy'] = df['transaction_count'] - df['estimated_trans']
print(f"Mean discrepancy all: {df['trans_discrepancy'].mean():.2f}")
print(f"Mean discrepancy anomalies: {df[df['is_anomaly']]['trans_discrepancy'].mean():.2f}")
print(f"Mean discrepancy normal: {df[~df['is_anomaly']]['trans_discrepancy'].mean():.2f}")

print("\n--- Suggestions for New Segmentation Dimensions ---")
print("Based on analysis, anomalies are characterized by:")
print("1. Retention category 'Very New (<1 Month)' (100% of anomalies).")
print("2. Seasonal preference 'Q4 Peak' (70% of anomalies).")
print("3. Higher transaction discrepancy (actual transactions lower than expected).")
print("4. Moderate volatility and consistency patterns.")
print("\nRecommendations:")
print("- Introduce 'Customer Tenure' dimension (new vs established).")
print("- Include 'Seasonal Concentration' metric (Herfindahl index of quarterly transaction shares).")
print("- Add 'Transaction Consistency Index' combining volatility and consistency categorical.")
print("- Consider 'Value‑Score Alignment' (difference between comprehensive score and revenue).")
''')
