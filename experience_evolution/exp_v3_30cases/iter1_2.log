import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-089.sqlite')
accounts = pd.read_sql_query("""
    SELECT account_id, account_name, annual_revenue, number_of_employees, total_contacts
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL AND number_of_employees > 0
""", conn)
threshold = accounts['annual_revenue'].quantile(0.8)
top = accounts[accounts['annual_revenue'] >= threshold].copy()
top_ids = top['account_id'].tolist()
placeholders = ','.join(['?'] * len(top_ids))
contacts = pd.read_sql_query(f"""
    SELECT account_id, department FROM salesforce__contact_enhanced
    WHERE account_id IN ({placeholders}) AND department IS NOT NULL
""", conn, params=top_ids)

# Group by account
grouped = contacts.groupby('account_id')['department'].apply(list).reset_index()
print(grouped.head())
print("Number of accounts with at least one department:", len(grouped))

# Check for key departments
key = ['Sales', 'Finance', 'Operations', 'Engineering', 'HR']
for dept in key:
    has = grouped['department'].apply(lambda lst: dept in lst).sum()
    print(f"{dept}: {has} accounts")
''')
