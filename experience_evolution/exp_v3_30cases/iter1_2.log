import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-018.sqlite')

# 1. Overall fashion stats
overall = pd.read_sql_query('''SELECT 
                                 COUNT(DISTINCT "Customer ID") as unique_customers,
                                 COUNT(*) as total_orders,
                                 SUM(profit) as total_profit,
                                 AVG(profit) as avg_profit_per_order,
                                 SUM(profit)/COUNT(DISTINCT "Customer ID") as avg_profit_per_customer
                               FROM order_information
                               WHERE "Product Category"='Fashion' ''', conn)
print("Overall Fashion Performance:")
print(overall.T)

# 2. Profit contribution by segment
segment_profit = pd.read_sql_query('''SELECT ci."Customer Segment",
                                       COUNT(DISTINCT ci."Customer ID") as customer_count,
                                       SUM(o.profit) as total_profit,
                                       AVG(o.profit) as avg_profit_per_customer,
                                       COUNT(*) as order_count,
                                       AVG(o.profit) as avg_profit_per_order
                               FROM order_information o
                               JOIN (SELECT DISTINCT "Customer ID", "Customer Segment" FROM customer_information) ci
                               ON o."Customer ID" = ci."Customer ID"
                               WHERE o."Product Category"='Fashion'
                               GROUP BY ci."Customer Segment"
                               ORDER BY total_profit DESC''', conn)
print("\nProfit Contribution by Customer Segment:")
print(segment_profit)

# 3. Profit by gender
gender_profit = pd.read_sql_query('''SELECT ci.gender,
                                       COUNT(DISTINCT ci."Customer ID") as customer_count,
                                       SUM(o.profit) as total_profit,
                                       AVG(o.profit) as avg_profit_per_customer
                               FROM order_information o
                               JOIN (SELECT DISTINCT "Customer ID", gender FROM customer_information) ci
                               ON o."Customer ID" = ci."Customer ID"
                               WHERE o."Product Category"='Fashion'
                               GROUP BY ci.gender
                               ORDER BY total_profit DESC''', conn)
print("\nProfit Contribution by Gender:")
print(gender_profit)

# 4. Profit by age group
age_profit = pd.read_sql_query('''SELECT 
                                     CASE 
                                         WHEN age < 20 THEN "<20"
                                         WHEN age BETWEEN 20 AND 29 THEN "20-29"
                                         WHEN age BETWEEN 30 AND 39 THEN "30-39"
                                         WHEN age BETWEEN 40 AND 49 THEN "40-49"
                                         WHEN age BETWEEN 50 AND 59 THEN "50-59"
                                         ELSE "60+"
                                     END as age_group,
                                     COUNT(DISTINCT ci."Customer ID") as customer_count,
                                     SUM(o.profit) as total_profit,
                                     AVG(o.profit) as avg_profit_per_customer
                               FROM order_information o
                               JOIN (SELECT DISTINCT "Customer ID", age FROM customer_information) ci
                               ON o."Customer ID" = ci."Customer ID"
                               WHERE o."Product Category"='Fashion'
                               GROUP BY age_group
                               ORDER BY total_profit DESC''', conn)
print("\nProfit Contribution by Age Group:")
print(age_profit)

# 5. Profit by education
edu_profit = pd.read_sql_query('''SELECT ci."Education Level",
                                       COUNT(DISTINCT ci."Customer ID") as customer_count,
                                       SUM(o.profit) as total_profit,
                                       AVG(o.profit) as avg_profit_per_customer
                               FROM order_information o
                               JOIN (SELECT DISTINCT "Customer ID", "Education Level" FROM customer_information) ci
                               ON o."Customer ID" = ci."Customer ID"
                               WHERE o."Product Category"='Fashion'
                               GROUP BY ci."Education Level"
                               ORDER BY total_profit DESC''', conn)
print("\nProfit Contribution by Education Level:")
print(edu_profit)

# 6. Profit by region
region_profit = pd.read_sql_query('''SELECT ci.Region,
                                       COUNT(DISTINCT ci."Customer ID") as customer_count,
                                       SUM(o.profit) as total_profit,
                                       AVG(o.profit) as avg_profit_per_customer
                               FROM order_information o
                               JOIN (SELECT DISTINCT "Customer ID", Region FROM customer_information) ci
                               ON o."Customer ID" = ci."Customer ID"
                               WHERE o."Product Category"='Fashion'
                               GROUP BY ci.Region
                               ORDER BY total_profit DESC''', conn)
print("\nProfit Contribution by Region:")
print(region_profit)

# 7. Browsing engagement correlation (already computed earlier)
# Let's compute average browsing metrics for high vs low profit customers
browsing = pd.read_sql_query('''SELECT "Customer ID",
                                 SUM("Browsing Time (minutes)") as total_browse_time,
                                 SUM(like) as total_likes,
                                 SUM(share) as total_shares,
                                 SUM("Add to Cart") as total_add_to_cart
                               FROM product_browsing
                               WHERE "Product Category"='Fashion'
                               GROUP BY "Customer ID"''', conn)
profit_per_customer = pd.read_sql_query('''SELECT "Customer ID", SUM(profit) as total_profit
                                            FROM order_information
                                            WHERE "Product Category"='Fashion'
                                            GROUP BY "Customer ID"''', conn)
merged = pd.merge(profit_per_customer, browsing, on="Customer ID", how="left")
merged.fillna(0, inplace=True)
# Split into high (top 25%) and low (bottom 75%)
threshold = merged['total_profit'].quantile(0.75)
high = merged[merged['total_profit'] >= threshold]
low = merged[merged['total_profit'] < threshold]
print("\nBrowsing Metrics Comparison:")
print("High-value customers (top 25%) average browsing time:", high['total_browse_time'].mean())
print("Low-value customers average browsing time:", low['total_browse_time'].mean())
print("High-value customers average likes:", high['total_likes'].mean())
print("Low-value customers average likes:", low['total_likes'].mean())
print("High-value customers average shares:", high['total_shares'].mean())
print("Low-value customers average shares:", low['total_shares'].mean())
print("High-value customers average add to cart:", high['total_add_to_cart'].mean())
print("Low-value customers average add to cart:", low['total_add_to_cart'].mean())

conn.close()
''')
