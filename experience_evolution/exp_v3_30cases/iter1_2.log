[1;33m[2026-03-03 17:00:59,917 [31mINFO [32magents/554-MainProcess[1;33m] [0mStep 31: CreateFile(filepath='final_ranking.sql':
'''
WITH dept_base AS (
    SELECT 
        u.Department,
        COUNT(*) as abnormal_count,
        COUNT(DISTINCT u."User ID") as affected_users,
        d.user_count,
        AVG(a."Anomaly Score") as avg_score,
        SUM(a."Anomaly Score") as total_score,
        SUM(CASE WHEN a."Risk Level" IN ('Severe','High') THEN 1 ELSE 0 END) as high_severe_count,
        SUM(CASE WHEN a."Confirmation Status" = 'Confirmed' THEN 1 ELSE 0 END) as confirmed_count
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    JOIN user_information_table u ON l."User ID" = u."User ID"
    LEFT JOIN (SELECT Department, COUNT(*) as user_count FROM user_information_table GROUP BY Department) d ON u.Department = d.Department
    GROUP BY u.Department
)
SELECT 
    Department,
    abnormal_count,
    affected_users,
    user_count,
    ROUND(abnormal_count * 1.0 / user_count, 3) as abnormal_per_user,
    ROUND(total_score * 1.0 / affected_users, 2) as score_per_affected_user,
    ROUND(high_severe_count * 1.0 / abnormal_count, 3) as high_severe_rate,
    ROUND(confirmed_count * 1.0 / abnormal_count, 3) as confirmation_rate,
    -- Composite index: weighted sum of normalized metrics (higher is worse)
    ROUND(
        (abnormal_count * 1.0 / user_count) * 0.4 +
        (total_score * 1.0 / affected_users) * 0.3 +
        (high_severe_count * 1.0 / abnormal_count) * 0.2 +
        (confirmed_count * 1.0 / abnormal_count) * 0.1,
        4
    ) as security_risk_index
FROM dept_base
ORDER BY security_risk_index DESC;
''')
