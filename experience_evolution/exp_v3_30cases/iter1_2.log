'''
import sqlite3
import pandas as pd
import numpy as np
import re
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-100.sqlite')
companies = pd.read_sql_query("SELECT * FROM intercom__company_enhanced", conn)
def parse_tags(tag_str):
    if not isinstance(tag_str, str):
        return {}
    parts = tag_str.split('|')
    tags = {}
    for part in parts:
        if '=' in part:
            key, value = part.split('=', 1)
            tags[key] = value
    return tags
company_tags = companies['all_company_tags'].apply(parse_tags)
companies['renewal_date'] = pd.to_datetime(company_tags.apply(lambda x: x.get('renewal_date')), errors='coerce')
companies['renewal_window'] = company_tags.apply(lambda x: x.get('renewal_window'))
target = companies[companies['renewal_window'] == 'inside_90_days']

conv = pd.read_sql_query("SELECT conversation_created_at, all_contact_company_names FROM intercom__conversation_enhanced", conn)
conv['conv_created'] = pd.to_datetime(conv['conversation_created_at'])
conv['company_name'] = conv['all_contact_company_names']
company_name_to_id = dict(zip(companies['company_name'], companies['company_id']))
conv['company_id'] = conv['company_name'].map(company_name_to_id)

# Count total conversations per target company (any time)
counts = conv.groupby('company_id').size()
print("Conversation counts per company (any time):")
print(counts.describe())
print("Companies with zero conversations:", (counts == 0).sum())
# Merge with target
target_counts = counts.reindex(target['company_id']).fillna(0)
print("Target companies conversation counts:")
print(target_counts.describe())
print("Target companies with zero conversations:", (target_counts == 0).sum())
''')
