import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv('filtered_campaigns.csv')
# Compute average health per industry
industry_health = df.groupby('industry')['health_score'].mean().sort_values(ascending=False).reset_index()
# Compute count of each risk per industry
risk_counts = df.groupby(['industry', 'risk']).size().unstack(fill_value=0)
risk_counts = risk_counts.reindex(industry_health['industry'])
# Normalize to percentages
risk_percent = risk_counts.div(risk_counts.sum(axis=1), axis=0) * 100

# Plot
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8), gridspec_kw={'height_ratios': [1, 2]})
# Bar for average health
bars = ax1.bar(industry_health['industry'], industry_health['health_score'], color='skyblue')
ax1.set_ylabel('Average Health Score')
ax1.set_ylim(0, 100)
ax1.set_title('Industry Performance (Health Score)')
# Add value labels
for bar, val in zip(bars, industry_health['health_score']):
    ax1.text(bar.get_x() + bar.get_width()/2, val + 1, f'{val:.1f}', ha='center', va='bottom', fontsize=9)

# Stacked bar for risk distribution
colors = {'Critical': 'firebrick', 'High': 'orange', 'Medium': 'gold', 'Low': 'forestgreen'}
bottom = None
for risk in ['Critical', 'High', 'Medium', 'Low']:
    if risk not in risk_percent.columns:
        continue
    ax2.bar(risk_percent.index, risk_percent[risk], bottom=bottom, label=risk, color=colors[risk])
    if bottom is None:
        bottom = risk_percent[risk].values
    else:
        bottom += risk_percent[risk].values
ax2.set_ylabel('Risk Distribution (%)')
ax2.set_xlabel('Industry')
ax2.legend(title='Risk Level', bbox_to_anchor=(1.05, 1), loc='upper left')
ax2.set_ylim(0, 100)
plt.xticks(rotation=45)
plt.suptitle('Industry Health Score and Risk Profile')
plt.tight_layout()
plt.savefig('industry_health_risk.png', dpi=300, bbox_inches='tight')
plt.close()
''')
