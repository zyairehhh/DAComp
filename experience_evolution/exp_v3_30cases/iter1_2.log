# 1. Campaign performance metrics
ax1 = fig.add_subplot(gs[0, 0])
metrics = ['email_open_rate_touch', 'email_click_to_open_rate_touch', 'net_revenue_touch']
metric_names = ['Open Rate', 'Click-to-Open', 'Net Revenue']
campaign_performance_agg = campaign_flow_df.groupby('last_touch_campaign_id')[metrics].mean()

x = np.arange(len(campaign_performance_agg))
width = 0.25
for i, (metric, name) in enumerate(zip(metrics, metric_names)):
    values = campaign_performance_agg[metric].values
    ax1.bar(x + i*width - width, values, width, label=name)

ax1.set_title('Campaign Performance Metrics')
ax1.set_xlabel('Campaign')
ax1.set_ylabel('Metric Value')
ax1.set_xticks(x)
ax1.set_xticklabels(campaign_performance_agg.index, rotation=45, ha='right')
ax1.legend()
ax1.grid(True, alpha=0.3, axis='y')

# 2. Subject line themes impact
ax2 = fig.add_subplot(gs[0, 1])
if 'campaign_subject_line' in events_df.columns:
    subject_themes = []
    for subject in events_df['campaign_subject_line'].unique():
        if 'Launch' in str(subject):
            subject_themes.append('Product Launch')
        elif 'Seasonal' in str(subject):
            subject_themes.append('Seasonal Offer')
        else:
            subject_themes.append('Other')
    
    events_df['theme'] = subject_themes
    theme_performance = events_df.merge(campaign_flow_df, left_on='campaign_name', 
                                       right_on='last_touch_campaign_id', how='left')
    
    if not theme_performance.empty:
        theme_agg = theme_performance.groupby('theme').agg({
            'email_open_rate_touch': 'mean',
            'email_click_to_open_rate_touch': 'mean'
        }).reset_index()
        
        x_theme = np.arange(len(theme_agg))
        ax2.bar(x_theme - 0.2, theme_agg['email_open_rate_touch'], 0.4, label='Open Rate', alpha=0.8)
        ax2.bar(x_theme + 0.2, theme_agg['email_click_to_open_rate_touch'], 0.4, label='Click-to-Open', alpha=0.8)
        
        ax2.set_title('Performance by Subject Line Theme')
        ax2.set_xlabel('Theme')
        ax2.set_ylabel('Rate')
        ax2.set_xticks(x_theme)
        ax2.set_xticklabels(theme_agg['theme'])
        ax2.legend()
        ax2.grid(True, alpha=0.3, axis='y')

# 3. Time window performance
ax3 = fig.add_subplot(gs[0, 2])
if 'occurred_at' in events_df.columns:
    events_df['time_window'] = 'Afternoon'
    events_df.loc[events_df['hour_of_day'] < 12, 'time_window'] = 'Morning'
    events_df.loc[events_df['is_weekend'], 'time_window'] = events_df.loc[events_df['is_weekend'], 'time_window'] + ' (Weekend)'
    events_df.loc[~events_df['is_weekend'], 'time_window'] = events_df.loc[~events_df['is_weekend'], 'time_window'] + ' (Weekday)'
    
    window_performance = events_df.merge(campaign_flow_df, left_on='campaign_name', 
                                        right_on='last_touch_campaign_id', how='left')
    
    if not window_performance.empty:
        window_agg = window_performance.groupby('time_window').agg({
            'email_open_rate_touch': 'mean',
            'net_revenue_touch': 'sum'
        }).reset_index()
        
        if not window_agg.empty:
            x_window = np.arange(len(window_agg))
            ax3_secondary = ax3.twinx()
            
            bars1 = ax3.bar(x_window - 0.2, window_agg['email_open_rate_touch'], 0.4, 
                           color='skyblue', label='Open Rate')
            bars2 = ax3_secondary.bar(x_window + 0.2, window_agg['net_revenue_touch'], 0.4, 
                                    color='salmon', label='Net Revenue')
            
            ax3.set_title('Performance by Time Window')
            ax3.set_xlabel('Time Window')
            ax3.set_ylabel('Open Rate', color='skyblue')
            ax3_secondary.set_ylabel('Net Revenue ($)', color='salmon')
            ax3.set_xticks(x_window)
            ax3.set_xticklabels(window_agg['time_window'], rotation=45, ha='right')
            
            # Add value labels
            for i, v in enumerate(window_agg['email_open_rate_touch']):
                ax3.text(i - 0.2, v + 0.01, f'{v:.3f}', ha='center', va='bottom', fontsize=8)
            
            for i, v in enumerate(window_agg['net_revenue_touch']):
                ax3_secondary.text(i + 0.2, v + 10, f'${v:.0f}', ha='center', va='bottom', fontsize=8)
            
            ax3.tick_params(axis='y', labelcolor='skyblue')
            ax3_secondary.tick_params(axis='y', labelcolor='salmon')

# 4. Retention vs engagement scatter (bottom row spanning 3 columns)
ax4 = fig.add_subplot(gs[1, :])
if not persons_df.empty and not campaign_flow_df.empty:
    # Merge person metrics with campaign engagement
    person_engagement = persons_df.merge(
        campaign_flow_df.groupby('person_id').agg({
            'email_open_rate_touch': 'mean',
            'email_click_to_open_rate_touch': 'mean',
            'count_opened_email': 'sum',
            'count_clicked_email': 'sum'
        }).reset_index(),
        on='person_id',
        how='left'
    )
    
    # Create engagement score
    person_engagement['engagement_score'] = (
        person_engagement['email_open_rate_touch'].fillna(0) * 0.4 +
        person_engagement['email_click_to_open_rate_touch'].fillna(0) * 0.6
    )
    
    # Plot
    scatter = ax4.scatter(person_engagement['engagement_score'], 
                         person_engagement['active_retention_rate_month'],
                         c=person_engagement['email_open_rate'],
                         s=100, alpha=0.6, cmap='viridis')
    
    ax4.set_title('Monthly Active Retention vs Engagement Score (colored by Email Open Rate)')
    ax4.set_xlabel('Engagement Score (40% Open Rate + 60% Click-to-Open Rate)')
    ax4.set_ylabel('Monthly Active Retention Rate')
    ax4.grid(True, alpha=0.3)
    
    # Add colorbar
    cbar = plt.colorbar(scatter, ax=ax4)
    cbar.set_label('Individual Email Open Rate')

