import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-001.sqlite')
company_df = pd.read_sql_query('SELECT "Enterprise Code", "Credit Rating", "Defaulted" FROM ch___company_info', conn)

# Load sales and input totals directly via SQL for efficiency
query = '''
SELECT s."Enterprise Code",
       SUM(s."Amount Including Tax") as total_sales,
       SUM(s."Amount Including Tax") - COALESCE(SUM(i."Amount Including Tax"),0) as profit,
       COUNT(DISTINCT s."Buyer organization code") as num_buyers,
       COUNT(DISTINCT i."Seller Organization Code") as num_sellers
FROM ch___sales_invoices s
LEFT JOIN ch___input_invoices i ON s."Enterprise Code" = i."Enterprise Code"
GROUP BY s."Enterprise Code"
'''
financial = pd.read_sql_query(query, conn)

# Compute dependency concentration HHI using subqueries
# For each company compute HHI for buyers
buyer_hhi_query = '''
WITH buyer_totals AS (
    SELECT "Enterprise Code", "Buyer organization code", SUM("Amount Including Tax") as sales_amount
    FROM ch___sales_invoices
    GROUP BY "Enterprise Code", "Buyer organization code"
),
company_total AS (
    SELECT "Enterprise Code", SUM(sales_amount) as total_sales
    FROM buyer_totals
    GROUP BY "Enterprise Code"
)
SELECT b."Enterprise Code",
       SUM(POWER(b.sales_amount / c.total_sales, 2)) * 10000 as buyer_hhi
FROM buyer_totals b
JOIN company_total c ON b."Enterprise Code" = c."Enterprise Code"
GROUP BY b."Enterprise Code"
'''
buyer_hhi = pd.read_sql_query(buyer_hhi_query, conn)

seller_hhi_query = '''
WITH seller_totals AS (
    SELECT "Enterprise Code", "Seller Organization Code", SUM("Amount Including Tax") as input_amount
    FROM ch___input_invoices
    GROUP BY "Enterprise Code", "Seller Organization Code"
),
company_total AS (
    SELECT "Enterprise Code", SUM(input_amount) as total_input
    FROM seller_totals
    GROUP BY "Enterprise Code"
)
SELECT s."Enterprise Code",
       SUM(POWER(s.input_amount / c.total_input, 2)) * 10000 as seller_hhi
FROM seller_totals s
JOIN company_total c ON s."Enterprise Code" = c."Enterprise Code"
GROUP BY s."Enterprise Code"
'''
seller_hhi = pd.read_sql_query(seller_hhi_query, conn)

# Compute profit stability (coefficient of variation) using yearly profit
yearly_profit_query = '''
WITH sales_year AS (
    SELECT "Enterprise Code", strftime('%Y', "Invoice Date") as year, SUM("Amount Including Tax") as sales
    FROM ch___sales_invoices
    GROUP BY "Enterprise Code", year
),
input_year AS (
    SELECT "Enterprise Code", strftime('%Y', "Invoice Date") as year, SUM("Amount Including Tax") as inputs
    FROM ch___input_invoices
    GROUP BY "Enterprise Code", year
),
profit_year AS (
    SELECT s."Enterprise Code", s.year, s.sales - COALESCE(i.inputs,0) as profit
    FROM sales_year s
    LEFT JOIN input_year i ON s."Enterprise Code" = i."Enterprise Code" AND s.year = i.year
)
SELECT "Enterprise Code", 
       AVG(profit) as avg_profit,
       CASE WHEN AVG(profit) != 0 THEN STDEV(profit) / AVG(profit) ELSE NULL END as profit_cv
FROM profit_year
GROUP BY "Enterprise Code"
'''
profit_stability = pd.read_sql_query(yearly_profit_query, conn)

# Merge all features
features = financial.copy()
features = features.merge(buyer_hhi, on='Enterprise Code', how='left')
features = features.merge(seller_hhi, on='Enterprise Code', how='left')
features = features.merge(profit_stability, on='Enterprise Code', how='left')
features.fillna(0, inplace=True)

# Merge with credit rating
df = company_df.merge(features, on='Enterprise Code', how='inner')
print(df.head())
print(df.shape)

# Now compute risk score
# Assign numeric weights to risk factors:
# 1. Credit rating: A=1, B=2, C=3, D=4 (higher worse)
rating_map = {'A':1, 'B':2, 'C':3, 'D':4}
df['rating_score'] = df['Credit Rating'].map(rating_map)
# 2. Defaulted: Yes=1, No=0
df['default_score'] = df['Defaulted'].apply(lambda x: 1 if x=='Yes' else 0)
# 3. Revenue capacity: higher revenue lower risk. We'll use total_sales, convert to percentile (higher percentile = lower risk)
df['sales_percentile'] = df['total_sales'].rank(pct=True, ascending=False)  # higher sales -> lower risk
# 4. Profit stability: lower CV (less volatile) lower risk. Use profit_cv; lower is better. We'll invert.
df['profit_cv'] = df['profit_cv'].abs()  # ensure positive
# If profit_cv is null or infinite, set high risk
# 5. Dependency concentration: higher HHI means higher dependency (risk). We'll combine buyer_hhi and seller_hhi.
df['avg_hhi'] = (df['buyer_hhi'] + df['seller_hhi']) / 2
df['hhi_percentile'] = df['avg_hhi'].rank(pct=True, ascending=True)  # lower HHI -> lower risk

# Compute composite risk score: weighted average
weights = {'rating': 0.3, 'default': 0.2, 'sales': 0.2, 'cv': 0.15, 'hhi': 0.15}
df['risk_score'] = (
    df['rating_score'] * weights['rating'] +
    df['default_score'] * weights['default'] +
    (1 - df['sales_percentile']) * weights['sales'] +  # because lower sales percentile means higher risk
    df['profit_cv'] * weights['cv'] +
    df['hhi_percentile'] * weights['hhi']
)

# Normalize risk score to 0-1 (or 0-100) for easier interpretation
df['risk_score_norm'] = (df['risk_score'] - df['risk_score'].min()) / (df['risk_score'].max() - df['risk_score'].min())

print(df[['Enterprise Code', 'Credit Rating', 'Defaulted', 'total_sales', 'profit', 'profit_cv', 'avg_hhi', 'risk_score_norm']].head())

# Now allocate total credit of 100 million RMB
total_credit = 100_000_000  # RMB
# We'll decide credit limit per company based on risk and revenue capacity.
# A company with higher sales and lower risk should get higher limit.
# Use a formula: base_limit = total_sales * multiplier * (1 - risk_score_norm)
# Adjust such that sum of base_limit equals total_credit.
df['capacity_factor'] = df['total_sales'] / df['total_sales'].sum()  # proportion of total sales
df['risk_adjustment'] = 1 - df['risk_score_norm']  # lower risk => higher adjustment
df['limit_raw'] = df['capacity_factor'] * df['risk_adjustment']
# Normalize raw limits to sum to total_credit
df['credit_limit'] = df['limit_raw'] / df['limit_raw'].sum() * total_credit

# For interest rate, we need to choose from the churn table. We'll assign interest rate based on risk quintiles.
# Load churn table
churn_df = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)
# For each credit rating, we can decide interest rate that minimizes churn given some target.
# Let's assume we want to keep churn below a threshold, say 20%.
# For each rating, find the interest rate where churn is <= 0.2.
def get_rate_for_rating(rating, churn_df, threshold=0.2):
    col = f'Credit Rating {rating} Customer Churn Rate'
    # find the highest interest rate where churn rate <= threshold
    subset = churn_df[churn_df[col] <= threshold]
    if not subset.empty:
        # choose the lowest interest rate that meets threshold? Or highest?
        # To maximize profit, choose highest interest rate (but still below threshold).
        # Let's pick the max interest rate that meets threshold.
        return subset['Annual Loan Interest Rate'].max()
    else:
        # fallback to lowest churn rate
        min_churn_idx = churn_df[col].idxmin()
        return churn_df.loc[min_churn_idx, 'Annual Loan Interest Rate']

# However we have per-company risk, we could assign interest rate based on risk score.
# Map risk_score_norm to interest rate using churn table.
# Since churn table is per rating, we can interpolate.

# For simplicity, assign interest rate based on rating only (as per bank policy)
rating_to_rate = {}
for rating in ['A','B','C','D']:
    rating_to_rate[rating] = get_rate_for_rating(rating, churn_df, threshold=0.2)

print("Interest rates by rating:", rating_to_rate)

df['interest_rate'] = df['Credit Rating'].map(rating_to_rate)

# Summarize allocation
print("\nAllocation Summary:")
print(df[['Enterprise Code', 'Credit Rating', 'total_sales', 'risk_score_norm', 'credit_limit', 'interest_rate']].head(20))
print(f"Total credit allocated: {df['credit_limit'].sum():,.2f} RMB")
print(f"Average interest rate: {df['interest_rate'].mean():.4f}")

# Write results to CSV
df.to_csv('/workspace/credit_allocation.csv', index=False)
print("Results saved to credit_allocation.csv")
```
