import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect("dacomp-066.sqlite")

# Get recruitment performance with role categorization
query = """
SELECT p.*, e.departments, e.hiring_managers, e.recruiters, e.application_to_interview_rate
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
"""
df = pd.read_sql_query(query, conn)

# Extract role from job_title
def extract_role(title):
    title_lower = title.lower()
    if 'frontend' in title_lower:
        return 'Frontend'
    elif 'backend' in title_lower:
        return 'Backend'
    elif 'data engineer' in title_lower:
        return 'Data Engineer'
    elif 'full stack' in title_lower:
        return 'Full Stack'
    elif 'devops' in title_lower:
        return 'DevOps'
    elif 'machine learning' in title_lower:
        return 'Machine Learning'
    elif 'qa' in title_lower or 'quality assurance' in title_lower:
        return 'QA'
    elif 'mobile' in title_lower:
        return 'Mobile'
    else:
        return 'Other'

df['role'] = df['job_title'].apply(extract_role)

# Filter Engineering department
eng_df = df[df['departments'] == 'Engineering']

# Compute conversion rate (interview_rate) per role per quarter
role_quarter = eng_df.groupby(['role', 'application_year', 'application_quarter'])['interview_rate'].mean().reset_index()
role_quarter['quarter_label'] = role_quarter['application_year'].astype(str) + 'Q' + role_quarter['application_quarter'].astype(str)
print("Conversion rate by role and quarter:")
print(role_quarter)

# Compute overall engineering conversion rate per quarter
overall_quarter = eng_df.groupby(['application_year', 'application_quarter'])['interview_rate'].mean().reset_index()
print("\nOverall Engineering conversion rate:")
print(overall_quarter)

# Hiring manager analysis
# Count number of jobs per hiring manager
manager_stats = eng_df.groupby('hiring_managers').agg(
    job_count=('job_id', 'count'),
    avg_conversion_rate=('interview_rate', 'mean'),
    avg_interviewers=('total_interviews', 'mean')  # not exactly number of interviewers, but total interviews count
).reset_index()
print("\nHiring manager performance:")
print(manager_stats.sort_values('avg_conversion_rate'))

conn.close()
''')
