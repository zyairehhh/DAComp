                                    np.nan)
    df['on_time'] = df['lateness_days'] <= 0
    # Compute efficiency (planned/actual) for completed tasks with actual work hours > 0
    df['efficiency'] = np.where(df['is_completed'] & (df['Actual Work Hours'] > 0),
                                df['Planned Work Hours'] / df['Actual Work Hours'],
                                np.nan)
    # Cap efficiency to 2 (i.e., if actual is half of planned, max efficiency 2)
    df['efficiency'] = df['efficiency'].clip(upper=2)
    return df

def compute_metrics(df):
    # Compute per Task Type statistics for normalization
    type_stats = {}
    for task_type in df['Task Type'].unique():
        subset = df[df['Task Type'] == task_type]
        # Quality mean and std (only completed tasks with quality)
        quality_mean = subset['Completion Quality Score'].mean(skipna=True)
        quality_std = subset['Completion Quality Score'].std(skipna=True)
        # Efficiency mean and std
        eff_mean = subset['efficiency'].mean(skipna=True)
        eff_std = subset['efficiency'].std(skipna=True)
        # Rework mean and std
        rework_mean = subset['Rework Count'].mean(skipna=True)
        rework_std = subset['Rework Count'].std(skipna=True)
        type_stats[task_type] = {
            'quality_mean': quality_mean,
            'quality_std': quality_std if quality_std > 0 else 1,
            'eff_mean': eff_mean,
            'eff_std': eff_std if eff_std > 0 else 1,
            'rework_mean': rework_mean,
            'rework_std': rework_std if rework_std > 0 else 1,
        }
    # Function to compute normalized metric
    def normalize(x, t, stat_key):
        mean = type_stats[t][stat_key + '_mean']
        std = type_stats[t][stat_key + '_std']
        return (x - mean) / std

    # For each row, compute normalized metrics
    df['quality_norm'] = df.apply(lambda row: normalize(row['Completion Quality Score'],
                                                         row['Task Type'], 'quality')
                                   if pd.notnull(row['Completion Quality Score']) else np.nan, axis=1)
    df['efficiency_norm'] = df.apply(lambda row: normalize(row['efficiency'],
                                                            row['Task Type'], 'eff')
                                      if pd.notnull(row['efficiency']) else np.nan, axis=1)
    df['rework_norm'] = df.apply(lambda row: normalize(row['Rework Count'],
                                                        row['Task Type'], 'rework')
                                  if pd.notnull(row['Rework Count']) else np.nan, axis=1)
    # Invert rework (lower is better) so that higher score is better
    df['rework_norm'] = -df['rework_norm']

    # Now aggregate per Task Owner
    owners = []
    for owner, group in df.groupby('Task Owner'):
        if len(group) < 3:  # may skip owners with too few tasks
            continue
        total_tasks = len(group)
        completed_mask = group['is_completed']
        total_weight = group['priority_weight'].sum()
        completed_weight = group.loc[completed_mask, 'priority_weight'].sum()
        weighted_completion_rate = completed_weight / total_weight if total_weight > 0 else 0
        
        # Quality average (normalized)
        quality_avg = group.loc[completed_mask, 'quality_norm'].mean()
        # On-time rate
        on_time_rate = group.loc[completed_mask, 'on_time'].mean()
        # Efficiency average (normalized)
        efficiency_avg = group.loc[completed_mask, 'efficiency_norm'].mean()
        # Rework average (normalized, already inverted)
        rework_avg = group.loc[completed_mask, 'rework_norm'].mean()
        
        # Combine scores (simple average)
        scores = [weighted_completion_rate, quality_avg, on_time_rate, efficiency_avg, rework_avg]
        # Handle missing scores: replace NaN with 0 (neutral)
        scores = [0 if pd.isnull(s) else s for s in scores]
        # Composite score (simple sum)
        composite = np.mean(scores)
        
        owners.append({
            'Task Owner': owner,
            'total_tasks': total_tasks,
            'weighted_completion_rate': weighted_completion_rate,
            'quality_avg': quality_avg,
            'on_time_rate': on_time_rate,
            'efficiency_avg': efficiency_avg,
            'rework_avg': rework_avg,
            'composite_score': composite
        })
    return pd.DataFrame(owners), type_stats

def assign_performance_levels(owner_df):
    # Sort by composite_score descending (higher is better)
    owner_df = owner_df.sort_values('composite_score', ascending=False).reset_index(drop=True)
    n = len(owner_df)
    # Determine cutoffs
    excellent_cutoff = int(n * 0.2)
    good_cutoff = int(n * 0.9)  # top 20% excellent, next 70% good, bottom 10% needs improvement
    owner_df['performance_level'] = 'Needs Improvement'
    owner_df.loc[:excellent_cutoff-1, 'performance_level'] = 'Excellent'
    owner_df.loc[excellent_cutoff:good_cutoff-1, 'performance_level'] = 'Good'
    # Verify distribution
    print('Performance level distribution:')
    print(owner_df['performance_level'].value_counts())
    return owner_df

def main():
    df = load_and_clean()
    print(f"Total tasks: {len(df)}")
    print(f"Unique owners: {df['Task Owner'].nunique()}")
    owner_df, type_stats = compute_metrics(df)
    print(f"Owners with at least 3 tasks: {len(owner_df)}")
    print("\nTask Type statistics for normalization:")
    for t, stats in type_stats.items():
        print(f"{t}: {stats}")
    print("\nFirst few owner metrics:")
    print(owner_df.head())
    owner_df = assign_performance_levels(owner_df)
    # Save results
    owner_df.to_csv('/workspace/owner_performance.csv', index=False)
    print("\nOwner performance saved to owner_performance.csv")
    # Optional: summary by performance level
    summary = owner_df.groupby('performance_level').agg({
        'total_tasks': 'sum',
        'weighted_completion_rate': 'mean',
        'quality_avg': 'mean',
        'on_time_rate': 'mean',
        'efficiency_avg': 'mean',
        'rework_avg': 'mean',
        'composite_score': ['mean', 'std']
    })
    print("\nSummary by performance level:")
    print(summary)

if __name__ == '__main__':
    main()
''')
