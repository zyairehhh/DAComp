query = f"""
    SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation,
           lifecycle_stage, customer_maturity_stage, customer_value_segment,
           activity_status, credit_grade, risk_assessment
    FROM quickbooks__customer_analytics
    WHERE customer_id IN ({','.join(['?']*len(high_vol_ids))})
"""
behaviors = pd.read_sql_query(query, conn, params=high_vol_ids)
print(f"Behavioral data rows: {behaviors.shape[0]}")

# Merge with metrics
merged = pd.merge(metrics, behaviors, on='customer_id', how='left')
print(f"Merged rows: {merged.shape[0]}")

