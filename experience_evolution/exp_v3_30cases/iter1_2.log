'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from matplotlib import font_manager
import os

# Load data
db_path = "dacomp-070.sqlite"
conn = sqlite3.connect(db_path)

# 1. Decay patterns of user acquisition cost-efficiency per region
# Use country_report aggregated by region and month
query = """
SELECT 
    region,
    strftime('%Y-%m', date_day) as month,
    AVG(store_listing_conversion_rate) as avg_conversion_rate,
    COUNT(*) as cnt
FROM google_play__country_report
GROUP BY region, strftime('%Y-%m', date_day)
ORDER BY region, month;
"""
df_region = pd.read_sql_query(query, conn)

# 2. Non-linear relationship between store_listing_conversion_rate and quality_score/crash_rate_per_1k
# Join country_report with time_series_trends on date_day and package_name.
query2 = """
SELECT 
    c.country_short,
    c.region,
    c.store_listing_conversion_rate,
    t.quality_score,
    t.crash_rate_per_1k
FROM google_play__country_report c
JOIN google_play__time_series_trends t
    ON c.date_day = t.date_day AND c.package_name = t.package_name
LIMIT 50000;
"""
df_relation = pd.read_sql_query(query2, conn)

# 3. Revenue per active device across device types
query3 = """
SELECT 
    d.device,
    AVG(d.active_devices_last_30_days) as avg_active_devices,
    AVG(t.revenue_per_active_device) as avg_revenue_per_device
FROM google_play__device_report d
JOIN google_play__time_series_trends t
    ON d.date_day = t.date_day AND d.package_name = t.package_name
GROUP BY d.device
ORDER BY avg_revenue_per_device DESC;
"""
df_device = pd.read_sql_query(query3, conn)

conn.close()

# Ensure output directory exists
output_dir = "."
# Set style
sns.set_style("whitegrid")

# Plot 1: Line chart of conversion rate per region over time
plt.figure(figsize=(10,6))
for region in df_region['region'].unique():
    subset = df_region[df_region['region'] == region]
    plt.plot(subset['month'], subset['avg_conversion_rate'], marker='o', label=region)
plt.xlabel('Month')
plt.ylabel('Average Store Listing Conversion Rate')
plt.title('User Acquisition Cost-Efficiency Decay by Region (6 Months)')
plt.xticks(rotation=45)
plt.legend(title='Region')
plt.tight_layout()
plt.savefig(os.path.join(output_dir, 'conversion_rate_decay_by_region.png'))
plt.close()

# Plot 2: Scatter of conversion rate vs quality_score with regression
plt.figure(figsize=(10,6))
sns.scatterplot(data=df_relation, x='quality_score', y='store_listing_conversion_rate', hue='region', alpha=0.6)
# Add regression line per region
for region in df_relation['region'].unique():
    sub = df_relation[df_relation['region'] == region]
    if len(sub) > 1:
        z = np.polyfit(sub['quality_score'], sub['store_listing_conversion_rate'], 1)
        p = np.poly1d(z)
        plt.plot(sub['quality_score'], p(sub['quality_score']), linewidth=2, label=f'{region} fit')
plt.xlabel('Quality Score')
plt.ylabel('Store Listing Conversion Rate')
plt.title('Non-linear Relationship: Conversion Rate vs Quality Score')
plt.legend(title='Region')
plt.tight_layout()
plt.savefig(os.path.join(output_dir, 'conversion_vs_quality.png'))
plt.close()

# Plot 3: Bar chart of revenue per active device across device types (top 10)
df_device_top = df_device.head(10)
plt.figure(figsize=(12,6))
bars = plt.bar(df_device_top['device'], df_device_top['avg_revenue_per_device'])
plt.xlabel('Device')
plt.ylabel('Average Revenue per Active Device')
plt.title('Revenue per Active Device by Device Type (Top 10)')
plt.xticks(rotation=45, ha='right')
# Add value labels
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.4f}', ha='center', va='bottom', fontsize=8)
plt.tight_layout()
plt.savefig(os.path.join(output_dir, 'revenue_per_device_by_device.png'))
plt.close()

# Plot 4: Interaction effect of app update frequency on active devices and rating
# Use device_report and aggregate update_events per device (or per package)
conn = sqlite3.connect(db_path)
query4 = """
SELECT 
    d.device,
    SUM(d.update_events) as total_updates,
    AVG(d.active_devices_last_30_days) as avg_active_devices,
    AVG(d.rolling_total_average_rating) as avg_rating
FROM google_play__device_report d
GROUP BY d.device
HAVING SUM(d.update_events) > 0
ORDER BY total_updates DESC
LIMIT 15;
"""
df_update = pd.read_sql_query(query4, conn)
conn.close()

fig, ax1 = plt.subplots(figsize=(12,6))
color = 'tab:blue'
ax1.set_xlabel('Device (by update frequency)')
ax1.set_ylabel('Average Active Devices (last 30 days)', color=color)
bars = ax1.bar(df_update['device'], df_update['avg_active_devices'], color=color, alpha=0.6, label='Active Devices')
ax1.tick_params(axis='y', labelcolor=color)
ax1.set_xticklabels(df_update['device'], rotation=45, ha='right')

ax2 = ax1.twinx()
color2 = 'tab:red'
ax2.set_ylabel('Average Rating', color=color2)
ax2.plot(df_update['device'], df_update['avg_rating'], color=color2, marker='o', linewidth=2, label='Rating')
ax2.tick_params(axis='y', labelcolor=color2)

fig.suptitle('Interaction Effect of App Update Frequency on Active Devices and Rating')
fig.legend(loc='upper left')
plt.tight_layout()
plt.savefig(os.path.join(output_dir, 'update_frequency_interaction.png'))
plt.close()

print("Plots saved.")
'''
