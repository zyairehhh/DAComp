import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
import os

# Connect to database
conn = sqlite3.connect('dacomp-093.sqlite')

# Helper functions for categorizations
def categorize_subject(subject):
    if subject is None:
        return None
    if '折扣' in subject:
        return 'discount'
    elif '新品' in subject or '上新' in subject:
        return 'new'
    else:
        # Assuming remaining are storytelling (brand story)
        return 'storytelling'

def categorize_day_type(sent_at):
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        weekday = date_obj.weekday()  # Monday=0, Sunday=6
        return 'weekday' if weekday < 5 else 'weekend'
    except:
        return None

def categorize_time_period(sent_at):
    if sent_at is None:
        return None
    try:
        date_obj = pd.to_datetime(sent_at)
        hour = date_obj.hour
        if hour < 12:
            return 'morning'
        elif hour < 18:
            return 'afternoon'
        else:
            return 'evening'
    except:
        return None

def categorize_holiday(subject):
    # Use subject to detect holiday periods: "节前" indicates pre-holiday
    if subject is None:
        return 'non_holiday'
    if '节前' in subject:
        return 'pre_holiday'
    else:
        return 'non_holiday'

# Load campaigns data
query = "SELECT campaign_id, SUBJECT, is_archived, variation_id, total_count_unique_people, count_received_email, count_opened_email, count_clicked_email, count_placed_order, gmv_gross, gmv_net, email_open_rate, email_click_to_open_rate, SENT_AT FROM klaviyo__campaigns"
df = pd.read_sql_query(query, conn)
print(f"Loaded {len(df)} campaigns")

# Apply categorizations
df['subject_category'] = df['SUBJECT'].apply(categorize_subject)
print("Subject categories:", df['subject_category'].unique())
df['day_type'] = df['SENT_AT'].apply(categorize_day_type)
df['time_period'] = df['SENT_AT'].apply(categorize_time_period)
df['holiday_period'] = df['SUBJECT'].apply(categorize_holiday)  # using subject for holiday

# Remove any rows where key categorization is missing
df = df.dropna(subset=['subject_category', 'day_type', 'time_period', 'holiday_period'])
print(f"After categorization, {len(df)} campaigns remain")

# Compute derived rates
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['order_rate'] = df['count_placed_order'] / df['count_received_email']
df['gmv_per_opened'] = df['gmv_gross'] / df['count_opened_email'].replace(0, np.nan)

# Weighted aggregation function
def weighted_avg(df, value_col, weight_col='count_received_email'):
    return np.average(df[value_col], weights=df[weight_col])

# 1. Subject Category Performance (Weighted by Received Emails)
subject_weighted = df.groupby('subject_category').apply(lambda x: pd.Series({
    'open_rate_weighted': weighted_avg(x, 'open_rate'),
    'click_rate_weighted': weighted_avg(x, 'click_rate'),
    'order_rate_weighted': weighted_avg(x, 'order_rate'),
    'gmv_per_opened_weighted': weighted_avg(x, 'gmv_per_opened')
}), include_groups=False).reset_index()
print("Subject category weighted performance:")
print(subject_weighted)

# 2. Send Time Window Performance
# Weekday vs Weekend
