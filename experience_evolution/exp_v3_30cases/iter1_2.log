'''
import pandas as pd

segment = pd.read_csv('product_area_segment.csv')
normal = pd.read_csv('product_area_normal.csv')
segment_total_visitors = 1184
normal_total_visitors = 1987

segment['visitor_pct'] = segment['visitor_count'] / segment_total_visitors * 100
normal['visitor_pct'] = normal['visitor_count'] / normal_total_visitors * 100

print("Product area penetration (% of segment users):")
print("\\nSingle-feature-use segment:")
for _, row in segment.iterrows():
    print(f"{row['product_area_name']}: {row['visitor_pct']:.1f}%")
print("\\nNormal segment:")
for _, row in normal.iterrows():
    print(f"{row['product_area_name']}: {row['visitor_pct']:.1f}%")

# Compute ratio of penetration
merged = pd.merge(segment[['product_area_name', 'visitor_pct']], normal[['product_area_name', 'visitor_pct']], on='product_area_name', suffixes=('_single', '_normal'))
merged['ratio'] = merged['visitor_pct_single'] / merged['visitor_pct_normal']
print("\\nRatio (single / normal) of penetration:")
print(merged.sort_values('ratio', ascending=False))
''')
