    'coef_interaction': [model_active.coef_[2], model_rating.coef_[2]],
    'r2': [model_active.score(X_active, y_active), model_rating.score(X_rating, y_rating)]
})
update_effect.to_csv('update_effects.csv', index=False)

conn.close()
```
