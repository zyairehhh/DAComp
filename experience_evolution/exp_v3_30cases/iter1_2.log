        diagnosis = f"Low {row['weakest_dimension']} (score {row[row['weakest_dimension'].lower().replace(' ', '_') + '_score']:.1f})"
        if row['avg_roas'] < 1.0:
            diagnosis += "; ROAS < 1"
        if row['avg_impression_share'] < 0.5:
            diagnosis += f"; Low impression share ({row['avg_impression_share']:.0%})"
        if row['avg_conversion_rate'] < df['avg_conversion_rate'].median():
            diagnosis += "; Below median conversion rate"
        f.write(f"| {row['campaign_id']} | {row['campaign_name']} | {row['campaign_type']} | {row['industry']} | {row['health_score']:.1f} | {row['risk_level']} | {row['weakest_dimension']} | {diagnosis} | {row['recommendations']} |\n")
    
    f.write('\n## Key Insights and Strategic Recommendations\n')
    f.write('1. **Display and Video campaigns** exhibit the lowest average health scores (34.8, 40.9). Focus on improving conversion quality and cost efficiency for these types.\n')
    f.write('2. **Target CPA** bidding strategy shows highest high‑risk count (4 out of 10). Consider shifting to Target ROAS for better ROAS alignment.\n')
    f.write('3. **Travel and Finance** industries have high proportion of high‑risk campaigns (3/6, 2/4). Investigate market competitiveness and audience targeting.\n')
    f.write('4. **Geographic concentration** is moderate; opportunities exist to expand into underrepresented regions (e.g., Australia, Canada).\n')
    f.write('5. **Device performance** is relatively balanced; minor adjustments to mobile bids may improve reach.\n')
    f.write('6. **Seasonal peaks** in July suggest aligning budget increases with high‑ROAS months.\n')
    f.write('\n## Action Plan\n')
    f.write('- **Immediate action**: Pause or reduce budget for the 11 high‑cost low‑ROI campaigns.\n')
    f.write('- **Short‑term (1‑3 months)**: Implement keyword optimization, ad copy testing, and geo/device bid adjustments for high‑risk campaigns.\n')
    f.write('- **Long‑term (3‑6 months)**: Revise bidding strategies, allocate budget towards Shopping and Search campaigns, which show highest health scores.\n')
    f.write('- **Monitoring**: Establish monthly health‑score dashboards and automated alerts for campaigns falling below thresholds.\n')
    
    f.write('\n---\n')
    f.write('*Report generated by Campaign Health Assessment System.*\n')

print("Report written to stage1.md")
''')
