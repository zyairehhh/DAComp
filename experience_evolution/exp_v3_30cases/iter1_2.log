import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-079.sqlite')

# 1. Get segment data for active users (>60 days)
query = """
WITH visitor_features AS (
    SELECT 
        v.visitor_id,
        v.count_active_days,
        v.latest_nps_rating,
        v.average_daily_minutes,
        v.count_active_months,
        COUNT(DISTINCT vf.feature_id) as distinct_features
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id
    GROUP BY v.visitor_id, v.count_active_days, v.latest_nps_rating, 
             v.average_daily_minutes, v.count_active_months
)
SELECT 
    *,
    CASE 
        WHEN count_active_days > 60 AND distinct_features < 5 THEN 'Single-Feature Users'
        WHEN count_active_days > 60 AND distinct_features >= 5 THEN 'Normal Active Users'
    END as user_segment
FROM visitor_features
WHERE count_active_days > 60
"""

df = pd.read_sql_query(query, conn)

# 2. Get top features for single-feature users
feature_query = """
SELECT 
    f.feature_name,
    f.product_area_name,
    COUNT(DISTINCT vf.visitor_id) as user_count,
    AVG(vf.sum_clicks) as avg_clicks,
    AVG(vf.sum_minutes) as avg_minutes
FROM pendo__visitor_feature vf
JOIN pendo__feature f ON vf.feature_id = f.feature_id
WHERE vf.visitor_id IN (
    SELECT v.visitor_id
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf2 ON v.visitor_id = vf2.visitor_id
    GROUP BY v.visitor_id
    HAVING v.count_active_days > 60 AND COUNT(DISTINCT vf2.feature_id) < 5
)
GROUP BY f.feature_id, f.feature_name, f.product_area_name
ORDER BY user_count DESC
LIMIT 15
"""

features_df = pd.read_sql_query(feature_query, conn)

# 3. Get distribution of distinct features - FIXED QUERY
distinct_features_query = """
WITH feature_counts AS (
    SELECT 
        v.visitor_id,
        COUNT(DISTINCT vf.feature_id) as distinct_features
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id
    WHERE v.count_active_days > 60
    GROUP BY v.visitor_id
)
SELECT 
    distinct_features,
    COUNT(visitor_id) as user_count
FROM feature_counts
GROUP BY distinct_features
ORDER BY distinct_features
"""

distinct_df = pd.read_sql_query(distinct_features_query, conn)
conn.close()

