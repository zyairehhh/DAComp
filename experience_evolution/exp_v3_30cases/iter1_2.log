import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-094.sqlite')

# Load data
persons_df = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
campaign_flow_df = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)
events_df = pd.read_sql_query("SELECT * FROM klaviyo__events", conn)

conn.close()

# Create output directory for plots
import os
if not os.path.exists('/workspace/plots'):
    os.makedirs('/workspace/plots')

# Set style
plt.style.use('default')
sns.set_palette("husl")

# Plot 1: Email open rates by campaign type
print("Creating Plot 1: Email open rates by campaign type...")

# Extract campaign info from events
events_df['occurred_at'] = pd.to_datetime(events_df['occurred_at'])
events_df['day_of_week'] = events_df['occurred_at'].dt.dayofweek
events_df['is_weekend'] = events_df['day_of_week'] >= 5
events_df['hour_of_day'] = events_df['occurred_at'].dt.hour
events_df['is_morning'] = events_df['hour_of_day'] < 12

# Group by campaign type
campaign_stats = events_df.groupby(['campaign_name', 'campaign_subject_line']).agg({
    'event_id': 'count',
    'day_of_week': 'first',
    'hour_of_day': 'first'
}).reset_index()

# Join with campaign flow metrics
campaign_performance = pd.merge(
    campaign_flow_df.groupby('last_touch_campaign_id').agg({
        'email_open_rate_touch': 'mean',
        'email_click_to_open_rate_touch': 'mean',
        'net_revenue_touch': 'sum'
    }).reset_index(),
    campaign_stats,
    left_on='last_touch_campaign_id',
    right_on='campaign_name',
    how='inner'
)

# Plot 1: Email metrics by campaign
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

# Open rate
axes[0].bar(range(len(campaign_performance)), campaign_performance['email_open_rate_touch'])
axes[0].set_title('Email Open Rate by Campaign')
axes[0].set_xlabel('Campaign')
axes[0].set_ylabel('Open Rate')
axes[0].set_xticks(range(len(campaign_performance)))
axes[0].set_xticklabels([f"{row['campaign_name']}\n({row['campaign_subject_line'][:15]}...)" 
                          for _, row in campaign_performance.iterrows()], rotation=45, ha='right')

# Click-to-open rate
axes[1].bar(range(len(campaign_performance)), campaign_performance['email_click_to_open_rate_touch'])
axes[1].set_title('Click-to-Open Rate by Campaign')
axes[1].set_xlabel('Campaign')
axes[1].set_ylabel('Click-to-Open Rate')
axes[1].set_xticks(range(len(campaign_performance)))
axes[1].set_xticklabels([f"{row['campaign_name']}\n({row['campaign_subject_line'][:15]}...)" 
                          for _, row in campaign_performance.iterrows()], rotation=45, ha='right')

# Net revenue
axes[2].bar(range(len(campaign_performance)), campaign_performance['net_revenue_touch'])
axes[2].set_title('Net Revenue by Campaign')
axes[2].set_xlabel('Campaign')
axes[2].set_ylabel('Net Revenue ($)')
axes[2].set_xticks(range(len(campaign_performance)))
axes[2].set_xticklabels([f"{row['campaign_name']}\n({row['campaign_subject_line'][:15]}...)" 
                          for _, row in campaign_performance.iterrows()], rotation=45, ha='right')

plt.tight_layout()
plt.savefig('/workspace/plots/campaign_performance.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 1 saved as /workspace/plots/campaign_performance.png")

# Plot 2: Time-based analysis
print("\nCreating Plot 2: Time-based analysis...")

fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Weekday vs Weekend performance
weekday_mask = ~events_df['is_weekend']
weekend_mask = events_df['is_weekend']

if len(events_df) > 0:
    # Email events by time of day
    morning_mask = events_df['is_morning']
    afternoon_mask = ~events_df['is_morning']
    
    # Time distribution
    ax1 = axes[0, 0]
    time_counts = events_df['hour_of_day'].value_counts().sort_index()
    ax1.bar(time_counts.index, time_counts.values)
    ax1.set_title('Distribution of Email Events by Hour')
    ax1.set_xlabel('Hour of Day')
    ax1.set_ylabel('Number of Events')
    ax1.axvline(x=12, color='red', linestyle='--', alpha=0.5, label='Noon')
    ax1.legend()
    
    # Day of week distribution
    ax2 = axes[0, 1]
    day_names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
    day_counts = events_df['day_of_week'].value_counts().sort_index()
    if not day_counts.empty:
        ax2.bar(range(len(day_counts)), day_counts.values)
        ax2.set_title('Distribution of Email Events by Day of Week')
        ax2.set_xlabel('Day of Week')
        ax2.set_ylabel('Number of Events')
        ax2.set_xticks(range(len(day_counts)))
        ax2.set_xticklabels([day_names[i] for i in day_counts.index])
        ax2.axhline(y=day_counts.mean(), color='red', linestyle='--', alpha=0.5, label=f'Avg: {day_counts.mean():.1f}')
        ax2.legend()
    
    # Holiday analysis (simplified - check for events around major holidays)
    # For this small dataset, we'll just note the distribution
    ax3 = axes[1, 0]
    months_counts = events_df['occurred_at'].dt.month.value_counts().sort_index()
    month_names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
    if not months_counts.empty:
        ax3.bar([month_names[i-1] for i in months_counts.index], months_counts.values)
        ax3.set_title('Distribution of Email Events by Month')
        ax3.set_xlabel('Month')
        ax3.set_ylabel('Number of Events')
        ax3.tick_params(axis='x', rotation=45)
    
    # Campaign performance over time
    ax4 = axes[1, 1]
    campaign_dates = events_df.groupby('campaign_name')['occurred_at'].min().sort_values()
    for i, (campaign, date) in enumerate(campaign_dates.items()):
        ax4.scatter(date, i, s=100, label=campaign)
    
    ax4.set_title('Campaign Launch Timeline')
    ax4.set_xlabel('Date')
    ax4.set_ylabel('Campaign Index')
    ax4.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
    ax4.tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('/workspace/plots/time_analysis.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 2 saved as /workspace/plots/time_analysis.png")

# Plot 3: Retention analysis
print("\nCreating Plot 3: Retention analysis...")

fig, axes = plt.subplots(1, 3, figsize=(15, 5))

# Email open rate vs active retention rate (week)
axes[0].scatter(persons_df['email_open_rate'], persons_df['active_retention_rate_week'])
axes[0].set_title('Email Open Rate vs Weekly Active Retention')
axes[0].set_xlabel('Email Open Rate')
axes[0].set_ylabel('Weekly Active Retention Rate')
axes[0].grid(True, alpha=0.3)

# Email click rate (proxy from campaign flow) vs active retention rate (month)
# Calculate average click rate from campaign flow
if 'email_click_to_open_rate_touch' in campaign_flow_df.columns:
    person_click_rate = campaign_flow_df.groupby('person_id')['email_click_to_open_rate_touch'].mean().reset_index()
    retention_analysis = pd.merge(persons_df[['person_id', 'active_retention_rate_month']], 
                                  person_click_rate, on='person_id', how='left')
    axes[1].scatter(retention_analysis['email_click_to_open_rate_touch'], 
                   retention_analysis['active_retention_rate_month'])
    axes[1].set_title('Email Click Rate vs Monthly Active Retention')
    axes[1].set_xlabel('Email Click-to-Open Rate')
    axes[1].set_ylabel('Monthly Active Retention Rate')
    axes[1].grid(True, alpha=0.3)

# Subject line length analysis
if 'campaign_subject_line' in events_df.columns:
    events_df['subject_length'] = events_df['campaign_subject_line'].str.len()
    subject_stats = events_df.groupby('campaign_subject_line').agg({
        'subject_length': 'first',
        'event_id': 'count'
    }).reset_index()
    
    axes[2].bar(range(len(subject_stats)), subject_stats['subject_length'])
    axes[2].set_title('Subject Line Length by Campaign')
    axes[2].set_xlabel('Campaign Subject Line')
    axes[2].set_ylabel('Character Count')
    axes[2].set_xticks(range(len(subject_stats)))
    axes[2].set_xticklabels([f"{row['campaign_subject_line'][:20]}..." 
                             for _, row in subject_stats.iterrows()], rotation=45, ha='right')
    
    # Add count labels
    for i, row in subject_stats.iterrows():
        axes[2].text(i, row['subject_length'] + 0.5, f"n={row['event_id']}", 
                    ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('/workspace/plots/retention_analysis.png', dpi=300, bbox_inches='tight')
plt.close()

print("Plot 3 saved as /workspace/plots/retention_analysis.png")

# Plot 4: Comprehensive performance dashboard
print("\nCreating Plot 4: Comprehensive performance dashboard...")

fig = plt.figure(figsize=(16, 10))

# Grid specification
gs = fig.add_gridspec(3, 3)

# 1. Campaign performance metrics
ax1 = fig.add_subplot(gs[0, 0])
metrics = ['email_open_rate_touch', 'email_click_to_open_rate_touch', 'net_revenue_touch']
metric_names = ['Open Rate', 'Click-to-Open', 'Net Revenue']
campaign_performance_agg = campaign_flow_df.groupby('last_touch_campaign_id')[metrics].mean()

x = np.arange(len(campaign_performance_agg))
width = 0.25
for i, (metric, name) in enumerate(zip(metrics, metric_names)):
    values = campaign_performance_agg[metric].values
    ax1.bar(x + i*width - width, values, width, label=name)

ax1.set_title('Campaign Performance Metrics')
ax1.set_xlabel('Campaign')
ax1.set_ylabel('Metric Value')
ax1.set_xticks(x)
ax1.set_xticklabels(campaign_performance_agg.index, rotation=45, ha='right')
ax1.legend()
ax1.grid(True, alpha=0.3, axis='y')

# 2. Subject line themes impact
ax2 = fig.add_subplot(gs[0, 1])
if 'campaign_subject_line' in events_df.columns:
    subject_themes = []
    for subject in events_df['campaign_subject_line'].unique():
        if 'Launch' in str(subject):
            subject_themes.append('Product Launch')
        elif 'Seasonal' in str(subject):
            subject_themes.append('Seasonal Offer')
        else:
            subject_themes.append('Other')
    
    events_df['theme'] = subject_themes
    theme_performance = events_df.merge(campaign_flow_df, left_on='campaign_name', 
                                       right_on='last_touch_campaign_id', how='left')
    
    if not theme_performance.empty:
        theme_agg = theme_performance.groupby('theme').agg({
            'email_open_rate_touch': 'mean',
            'email_click_to_open_rate_touch': 'mean'
        }).reset_index()
        
        x_theme = np.arange(len(theme_agg))
        ax2.bar(x_theme - 0.2, theme_agg['email_open_rate_touch'], 0.4, label='Open Rate', alpha=0.8)
        ax2.bar(x_theme + 0.2, theme_agg['email_click_to_open_rate_touch'], 0.4, label='Click-to-Open', alpha=0.8)
        
        ax2.set_title('Performance by Subject Line Theme')
        ax2.set_xlabel('Theme')
        ax2.set_ylabel('Rate')
        ax2.set_xticks(x_theme)
        ax2.set_xticklabels(theme_agg['theme'])
        ax2.legend()
        ax2.grid(True, alpha=0.3, axis='y')

# 3. Time window performance
ax3 = fig.add_subplot(gs[0, 2])
if 'occurred_at' in events_df.columns:
    events_df['time_window'] = 'Afternoon'
    events_df.loc[events_df['hour_of_day'] < 12, 'time_window'] = 'Morning'
    events_df.loc[events_df['is_weekend'], 'time_window'] = events_df.loc[events_df['is_weekend'], 'time_window'] + ' (Weekend)'
    events_df.loc[~events_df['is_weekend'], 'time_window'] = events_df.loc[~events_df['is_weekend'], 'time_window'] + ' (Weekday)'
    
    window_performance = events_df.merge(campaign_flow_df, left_on='campaign_name', 
                                        right_on='last_touch_campaign_id', how='left')
    
    if not window_performance.empty:
        window_agg = window_performance.groupby('time_window').agg({
            'email_open_rate_touch': 'mean',
            'net_revenue_touch': 'sum'
        }).reset_index()
        
        if not window_agg.empty:
            x_window = np.arange(len(window_agg))
            ax3_secondary = ax3.twinx()
            
            bars1 = ax3.bar(x_window - 0.2, window_agg['email_open_rate_touch'], 0.4, 
                           color='skyblue', label='Open Rate')
            bars2 = ax3_secondary.bar(x_window + 0.2, window_agg['net_revenue_touch'], 0.4, 
                                    color='salmon', label='Net Revenue')
            
            ax3.set_title('Performance by Time Window')
            ax3.set_xlabel('Time Window')
            ax3.set_ylabel('Open Rate', color='skyblue')
            ax3_secondary.set_ylabel('Net Revenue ($)', color='salmon')
            ax3.set_xticks(x_window)
