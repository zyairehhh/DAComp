'''
import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import re
from sklearn.metrics import roc_auc_score

conn = sqlite3.connect('dacomp-100.sqlite')

# Load company enhanced and parse tags
df_companies = pd.read_sql_query("SELECT company_id, company_name, industry, plan_name, all_company_tags FROM intercom__company_enhanced", conn)

def parse_tags(tag_string):
    if not tag_string:
        return {}
    tags = tag_string.split('|')
    parsed = {}
    for tag in tags:
        if '=' in tag:
            key, val = tag.split('=', 1)
            parsed[key] = val
    return parsed

tag_data = df_companies['all_company_tags'].apply(parse_tags)
tag_df = pd.json_normalize(tag_data)
df_companies = pd.concat([df_companies, tag_df], axis=1)

# Extract feature adoption percentage
def extract_percentage(s):
    if pd.isna(s):
        return None
    match = re.search(r'\((\d+)%\)', s)
    if match:
        return int(match.group(1))
    else:
        num = re.search(r'(\d+)%', s)
        if num:
            return int(num.group(1))
    return None

df_companies['feature_adoption_pct'] = df_companies['feature_adoption'].apply(extract_percentage)
df_companies['renewal_date'] = pd.to_datetime(df_companies['renewal_date'], errors='coerce')
df_companies['renewal_window'] = df_companies['renewal_window']
df_companies['due_for_renewal'] = df_companies['renewal_window'] == 'inside_90_days'
df_companies['past_due'] = df_companies['renewal_window'] == 'within_30_days_past'
df_companies['future_safe'] = df_companies['renewal_window'] == 'future_90_plus'

# Extract contract size and ACV
df_companies['acv_usd'] = pd.to_numeric(df_companies['acv_usd'], errors='coerce')
df_companies['contract_size'] = df_companies['contract_size']

# Load conversation data
df_conv = pd.read_sql_query("SELECT conversation_id, conversation_created_at, conversation_last_updated_at, conversation_state, all_conversation_tags, all_contact_company_names FROM intercom__conversation_enhanced", conn)
df_conv['conversation_created_at'] = pd.to_datetime(df_conv['conversation_created_at'])
df_conv['conversation_last_updated_at'] = pd.to_datetime(df_conv['conversation_last_updated_at'])

# Load conversation metrics
df_metrics = pd.read_sql_query("SELECT conversation_id, conversation_rating, count_reopens, time_to_first_close_minutes, time_to_last_close_minutes FROM intercom__conversation_metrics", conn)
df_conv = df_conv.merge(df_metrics, on='conversation_id', how='left')

# Join with companies on company name
df_conv['company_name'] = df_conv['all_contact_company_names']
df_merged = df_conv.merge(df_companies[['company_id', 'company_name', 'renewal_date', 'renewal_window']], on='company_name', how='inner')

print(f"Total conversations matched: {len(df_merged)}")

# For each company, filter conversations within 30 days before renewal_date
def filter_recent_conversations(df):
    # Remove rows where renewal_date is NaT
    df_valid = df.dropna(subset=['renewal_date'])
    # Filter conversations created within 30 days before renewal_date
    mask = (df_valid['conversation_created_at'] <= df_valid['renewal_date']) & \
           (df_valid['conversation_created_at'] >= df_valid['renewal_date'] - pd.Timedelta(days=30))
    return df_valid[mask]

df_recent = filter_recent_conversations(df_merged)
print(f"Conversations within 30 days before renewal: {len(df_recent)}")

# Compute per company features
def compute_features_per_company(group):
    total_convs = group.shape[0]
    # Average number of conversations per day (over 30 days)
    avg_convs_per_day = total_convs / 30.0
    # Proportion of negative sentiment (rating < 3)
    negative_count = (group['conversation_rating'] < 3).sum()
    prop_negative = negative_count / total_convs if total_convs > 0 else 0
    
    # Average resolution time (time_to_last_close_minutes)
    avg_resolution = group['time_to_last_close_minutes'].mean() if total_convs > 0 else None
    # Proportion of reopened conversations (count_reopens > 0)
    reopened_count = (group['count_reopens'] > 0).sum()
    prop_reopened = reopened_count / total_convs if total_convs > 0 else 0
    
    return pd.Series({
        'total_convs_last30': total_convs,
        'avg_convs_per_day': avg_convs_per_day,
        'prop_negative_sentiment': prop_negative,
        'avg_resolution_minutes': avg_resolution,
        'prop_reopened': prop_reopened
    })

features = df_recent.groupby('company_id').apply(compute_features_per_company).reset_index()

# Merge with company tags
df_features = df_companies.merge(features, on='company_id', how='left')
df_features['total_convs_last30'] = df_features['total_convs_last30'].fillna(0)
df_features['avg_convs_per_day'] = df_features['avg_convs_per_day'].fillna(0)
df_features['prop_negative_sentiment'] = df_features['prop_negative_sentiment'].fillna(0)
df_features['prop_reopened'] = df_features['prop_reopened'].fillna(0)
df_features['avg_resolution_minutes'] = df_features['avg_resolution_minutes'].fillna(df_features['avg_resolution_minutes'].median())

# Add product value features: feature_adoption_pct already present
# time since last value milestone not available

print(df_features.head())
print(df_features.shape)

# Now compare features across renewal_window categories
print("\\n=== Renewal Window Counts ===")
print(df_features['renewal_window'].value_counts())

# Filter only inside_90_days vs future_90_plus for binary classification
df_binary = df_features[df_features['renewal_window'].isin(['inside_90_days', 'future_90_plus'])].copy()
df_binary['target'] = (df_binary['renewal_window'] == 'inside_90_days').astype(int)

print("\\n=== Binary classification dataset size ===")
print(df_binary.shape)

# Compute discriminative power using AUC for each feature
features_list = ['total_convs_last30', 'avg_convs_per_day', 'prop_negative_sentiment', 'avg_resolution_minutes', 'prop_reopened', 'feature_adoption_pct']
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import cross_val_score
import warnings
warnings.filterwarnings('ignore')

# Compute AUC for each individual feature
for feat in features_list:
    # Remove rows with NaN
    mask = df_binary[feat].notna()
    y = df_binary.loc[mask, 'target']
    X = df_binary.loc[mask, feat].values.reshape(-1,1)
    # Standardize
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    # Simple logistic regression with cross-validation
    model = LogisticRegression(random_state=42)
    try:
        scores = cross_val_score(model, X_scaled, y, cv=5, scoring='roc_auc')
        print(f"{feat}: Mean AUC = {scores.mean():.4f} (+/- {scores.std():.4f})")
    except Exception as e:
        print(f"{feat}: Error {e}")

# Compare quantile differences between groups
print("\\n=== Mean feature values by renewal_window ===")
for group in ['inside_90_days', 'within_30_days_past', 'future_90_plus']:
    sub = df_features[df_features['renewal_window'] == group]
    print(f"\\nGroup: {group} (N={len(sub)})")
    for feat in features_list:
        mean_val = sub[feat].mean()
        median_val = sub[feat].median()
        print(f"  {feat}: mean={mean_val:.4f}, median={median_val:.4f}")

# Segment by industry and contract size
print("\\n=== Segmentation by Industry and Contract Size ===")
# Let's pick key industries
top_industries = df_features['industry'].value_counts().head(5).index
for ind in top_industries:
    for size in df_features['contract_size'].dropna().unique():
        subset = df_features[(df_features['industry'] == ind) & (df_features['contract_size'] == size)]
        if len(subset) > 0:
            inside = subset[subset['renewal_window'] == 'inside_90_days']
            future = subset[subset['renewal_window'] == 'future_90_plus']
            if len(inside) > 5 and len(future) > 5:
                print(f"\\nIndustry: {ind}, Contract Size: {size}")
                for feat in features_list:
                    mean_inside = inside[feat].mean()
                    mean_future = future[feat].mean()
                    diff = mean_inside - mean_future
                    print(f"  {feat}: inside={mean_inside:.2f}, future={mean_future:.2f}, diff={diff:.2f}")

conn.close()
''')
