import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-093.sqlite')
df = pd.read_sql_query("SELECT * FROM klaviyo__campaigns", conn)
conn.close()

# Parse scheduled_to_send_at to datetime
df['scheduled_to_send_at'] = pd.to_datetime(df['scheduled_to_send_at'])
df['hour'] = df['scheduled_to_send_at'].dt.hour
df['day_of_week'] = df['scheduled_to_send_at'].dt.dayofweek  # Monday=0
df['is_weekend'] = df['day_of_week'].isin([5,6]).astype(int)
# Time of day categories: morning (6-12), afternoon (12-18), evening (18-24), night (0-6)
df['time_of_day'] = pd.cut(df['hour'], bins=[0,6,12,18,24], labels=['night','morning','afternoon','evening'], include_lowest=True)
# Subject keyword extraction (simplify)
def subject_keyword(subject):
    subject = str(subject).lower()
    if '折扣' in subject or '折券' in subject:
        return 'discount'
    elif '上新' in subject or '新品' in subject:
        return 'new'
    elif '故事' in subject or '品牌' in subject:
        return 'storytelling'
    else:
        return 'other'
df['subject_keyword'] = df['SUBJECT'].apply(subject_keyword)

# Compute open rate (if not already)
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_to_open_rate'] = df['count_clicked_email'] / df['count_opened_email'].replace(0, np.nan)

print(f"Total campaigns: {len(df)}")
print(df[['campaign_id','scheduled_to_send_at','hour','day_of_week','subject_keyword','open_rate','email_open_rate','email_click_to_open_rate']].head())

# Plot 1: Open rate by time of day and subject keyword
plt.figure(figsize=(10,6))
sns.boxplot(x='time_of_day', y='open_rate', hue='subject_keyword', data=df)
plt.title('Open Rate by Time of Day and Subject Keyword')
plt.ylabel('Open Rate')
plt.xlabel('Time of Day')
plt.legend(title='Keyword')
plt.tight_layout()
plt.savefig('open_rate_time_subject.png')
plt.close()

# Plot 2: Click-to-open rate by is_archived and variation_id
plt.figure(figsize=(8,6))
sns.barplot(x='is_archived', y='email_click_to_open_rate', hue='variation_id', data=df, ci=None)
plt.title('Click-to-Open Rate by Archived Status and Variation')
plt.ylabel('Click-to-Open Rate')
plt.xlabel('Is Archived')
plt.legend(title='Variation')
plt.tight_layout()
plt.savefig('cto_rate_archived_variation.png')
plt.close()

# Plot 3: Active days vs audience size (total_count_unique_people) colored by open_rate quantile
df['open_rate_quantile'] = pd.qcut(df['open_rate'], q=4, labels=['Q1','Q2','Q3','Q4'])
plt.figure(figsize=(8,6))
scatter = plt.scatter(df['total_count_unique_people'], df['active_days'], c=df['open_rate'], cmap='viridis', alpha=0.6)
plt.colorbar(scatter, label='Open Rate')
plt.xlabel('Audience Size')
plt.ylabel('Active Days')
plt.title('Active Days vs Audience Size (colored by Open Rate)')
plt.tight_layout()
plt.savefig('active_days_vs_audience.png')
plt.close()

# Plot 4: Open rate distribution for weekday vs weekend
plt.figure(figsize=(8,6))
sns.violinplot(x='is_weekend', y='open_rate', data=df)
plt.title('Open Rate Distribution: Weekday vs Weekend')
plt.xlabel('Is Weekend (1=Yes, 0=No)')
plt.ylabel('Open Rate')
plt.xticks([0,1],['Weekday','Weekend'])
plt.tight_layout()
plt.savefig('open_rate_weekday_weekend.png')
plt.close()

# Plot 5: Interaction between send hour and subject keyword on open rate (heatmap)
pivot = df.pivot_table(values='open_rate', index='hour', columns='subject_keyword', aggfunc='mean')
plt.figure(figsize=(10,6))
sns.heatmap(pivot, annot=True, fmt='.3f', cmap='YlOrRd')
plt.title('Average Open Rate by Hour and Subject Keyword')
plt.xlabel('Subject Keyword')
plt.ylabel('Hour of Day')
plt.tight_layout()
plt.savefig('heatmap_hour_keyword_openrate.png')
plt.close()

print("Plots saved.")
