'''
import pandas as pd
import numpy as np
import re

def extract_lower(salary_str):
    if pd.isna(salary_str):
        return np.nan
    # Find first number before dash
    match = re.search(r'([0-9,\.]+)\s*-\s*[0-9,\.]+', salary_str)
    if match:
        num_str = match.group(1).replace(',', '').strip()
        try:
            return float(num_str)
        except:
            return np.nan
    else:
        # try to find any number in the string
        match2 = re.search(r'([0-9,\.]+)', salary_str)
        if match2:
            num_str = match2.group(1).replace(',', '').strip()
            try:
                return float(num_str)
            except:
                return np.nan
        else:
            return np.nan

df = pd.read_csv('vocational_data.csv')
df['starting_salary'] = df['Salary Range'].apply(extract_lower)
print("Starting salary summary:")
print(df['starting_salary'].describe())
print("Missing count:", df['starting_salary'].isna().sum())

# Distribution bins
bins = [0, 2000, 3000, 4000, 5000, 6000, 8000, 10000, 15000, 20000, 50000]
labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-8k', '8k-10k', '10k-15k', '15k-20k', '>20k']
df['salary_bin'] = pd.cut(df['starting_salary'], bins=bins, labels=labels, right=False)
print("\nSalary bin counts:")
print(df['salary_bin'].value_counts(dropna=False).sort_index())

# Benefits distribution
benefits_series = df['Benefits'].dropna()
# Split by commas and count individual benefits
benefit_counts = {}
for b in benefits_series:
    # Split by various separators: comma, '，', '、', etc.
    items = re.split(r'[,，、]', b)
    for item in items:
        item_clean = item.strip()
        if item_clean:
            benefit_counts[item_clean] = benefit_counts.get(item_clean, 0) + 1

print("\nTop 30 benefits:")
sorted_benefits = sorted(benefit_counts.items(), key=lambda x: x[1], reverse=True)
for benefit, count in sorted_benefits[:30]:
    print(f"{benefit}: {count}")
''')
