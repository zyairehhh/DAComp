import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import matplotlib

# Use default English fonts
matplotlib.rcParams.update({'font.size': 10})

# Connect to database
conn = sqlite3.connect('/workspace/dacomp-060.sqlite')

# 1. Get ad group data and compute metrics
print("Loading ad group data...")
ad_group_query = """
SELECT 
    campaign_name,
    ad_group_name,
    SUM(clicks) as clicks,
    SUM(impressions) as impressions,
    SUM(conversions) as conversions
FROM google_ads__ad_group_report
GROUP BY campaign_name, ad_group_name
HAVING impressions > 0 AND clicks > 0
"""
df = pd.read_sql_query(ad_group_query, conn)

# Calculate metrics
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
df['Conversions_per_Impression'] = df['conversions'] / df['impressions']

# Replace infinite values with NaN
df.replace([np.inf, -np.inf], np.nan, inplace=True)
df.dropna(subset=['CTR', 'CVR'], inplace=True)

print(f"Total ad groups with valid CTR/CVR: {len(df)}")

# 2. Calculate percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# 3. Identify problematic groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
non_problematic = df[~((df['CTR'] > ctr_75) & (df['CVR'] < cvr_25))].copy()

print(f"Problematic ad groups: {len(problematic)}")
print(f"Non-problematic ad groups: {len(non_problematic)}")

# 4. Calculate campaign-level expected CVR for Intent-Match Ratio
campaign_avg_cvr = df.groupby('campaign_name')['CVR'].mean().reset_index()
campaign_avg_cvr.rename(columns={'CVR': 'expected_cvr'}, inplace=True)

problematic = problematic.merge(campaign_avg_cvr, on='campaign_name', how='left')
problematic['Intent_Match_Ratio'] = problematic['CVR'] / problematic['expected_cvr']

# Cap Intent_Match_Ratio for visualization
problematic['Intent_Match_Ratio_capped'] = problematic['Intent_Match_Ratio'].clip(upper=2.0)

# 5. Get keyword match type data for problematic groups
print("Loading keyword data for problematic groups...")
keyword_query = """
SELECT 
    k.ad_group_name,
    k.keyword_match_type,
    COUNT(*) as keyword_count
FROM google_ads__keyword_report k
WHERE k.ad_group_name IN ({})
GROUP BY k.ad_group_name, k.keyword_match_type
""".format(','.join(['?' for _ in range(len(problematic))]))

problematic_ad_groups = problematic['ad_group_name'].tolist()
keyword_df = pd.read_sql_query(keyword_query, conn, params=problematic_ad_groups)

# 6. Generate visualizations
print("Generating visualizations...")

# Plot 1: CTR vs CVR Scatter Plot with Problematic Groups Highlighted
plt.figure(figsize=(10, 6))
plt.scatter(non_problematic['CTR'], non_problematic['CVR'], 
           alpha=0.5, s=20, label='Normal Groups', color='blue')
plt.scatter(problematic['CTR'], problematic['CVR'], 
           alpha=0.7, s=30, label='Problematic Groups', color='red')

# Add percentile lines
plt.axvline(x=ctr_75, color='gray', linestyle='--', alpha=0.5, label='75th Percentile CTR')
plt.axhline(y=cvr_25, color='gray', linestyle='-.', alpha=0.5, label='25th Percentile CVR')

plt.xlabel('Click-Through Rate (CTR)')
plt.ylabel('Conversion Rate (CVR)')
plt.title('Ad Groups: CTR vs CVR (Problematic Groups Highlighted)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.xlim(0, df['CTR'].quantile(0.99))  # Limit to 99th percentile for better visualization
plt.ylim(0, df['CVR'].quantile(0.99))
plt.tight_layout()
plt.savefig('ctr_cvr_scatter.png', dpi=150)
plt.close()

# Plot 2: Intent-Match Ratio Distribution for Problematic Groups
plt.figure(figsize=(10, 6))
plt.hist(problematic['Intent_Match_Ratio_capped'], bins=30, 
         edgecolor='black', alpha=0.7, color='coral')
plt.axvline(x=problematic['Intent_Match_Ratio'].mean(), 
           color='red', linestyle='--', linewidth=2, 
           label=f'Mean: {problematic["Intent_Match_Ratio"].mean():.2f}')
plt.xlabel('Intent-Match Ratio (Actual CVR / Expected CVR)')
plt.ylabel('Number of Ad Groups')
plt.title('Intent-Match Ratio Distribution for Problematic Ad Groups')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('intent_match_ratio_histogram.png', dpi=150)
plt.close()

# Plot 3: Keyword Match Type Distribution
if len(keyword_df) > 0:
    match_type_counts = keyword_df.groupby('keyword_match_type')['keyword_count'].sum().reset_index()
    match_type_counts = match_type_counts.sort_values('keyword_count', ascending=False)
    
    plt.figure(figsize=(10, 6))
    bars = plt.bar(match_type_counts['keyword_match_type'], 
                   match_type_counts['keyword_count'],
                   color='steelblue', edgecolor='black')
    
    plt.xlabel('Keyword Match Type')
    plt.ylabel('Number of Keywords')
    plt.title('Keyword Match Type Distribution in Problematic Ad Groups')
    plt.xticks(rotation=45)
    
    # Add value labels on bars
    for bar in bars:
        height = bar.get_height()
        plt.text(bar.get_x() + bar.get_width()/2., height + 5,
                f'{int(height)}', ha='center', va='bottom')
    
    plt.grid(True, alpha=0.3, axis='y')
    plt.tight_layout()
    plt.savefig('keyword_match_type_distribution.png', dpi=150)
    plt.close()

# Plot 4: Campaign Types with Most Problematic Groups
campaign_counts = problematic['campaign_name'].value_counts().head(10).reset_index()
campaign_counts.columns = ['campaign_name', 'problematic_count']

plt.figure(figsize=(12, 6))
bars = plt.barh(campaign_counts['campaign_name'], 
               campaign_counts['problematic_count'],
               color='indianred', edgecolor='black')

plt.xlabel('Number of Problematic Ad Groups')
plt.ylabel('Campaign Name')
plt.title('Top 10 Campaigns with Most Problematic Ad Groups')
plt.gca().invert_yaxis()  # Highest count at top

# Add value labels on bars
for bar in bars:
    width = bar.get_width()
    plt.text(width + 0.2, bar.get_y() + bar.get_height()/2.,
            f'{int(width)}', ha='left', va='center')

plt.grid(True, alpha=0.3, axis='x')
plt.tight_layout()
plt.savefig('campaign_problematic_counts.png', dpi=150)
plt.close()

# Plot 5: Conversions per Impression Comparison
conversions_comparison = pd.DataFrame({
    'Group': ['Problematic Groups', 'All Groups'],
    'Conversions_per_Impression': [
        problematic['Conversions_per_Impression'].mean(),
        df['Conversions_per_Impression'].mean()
    ]
})

plt.figure(figsize=(8, 6))
bars = plt.bar(conversions_comparison['Group'], 
               conversions_comparison['Conversions_per_Impression'],
               color=['coral', 'steelblue'], edgecolor='black')

plt.ylabel('Conversions per Impression')
plt.title('Traffic Quality Comparison: Conversions per Impression')
plt.ylim(0, conversions_comparison['Conversions_per_Impression'].max() * 1.2)

# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.0001,
            f'{height:.6f}', ha='center', va='bottom')

plt.grid(True, alpha=0.3, axis='y')
plt.tight_layout()
plt.savefig('conversions_per_impression_comparison.png', dpi=150)
plt.close()

# 7. Create summary statistics file
print("Creating summary statistics...")
summary_stats = {
    'Total ad groups analyzed': len(df),
    'Problematic ad groups identified': len(problematic),
    'Percentage problematic': f"{len(problematic)/len(df)*100:.1f}%",
    'Average CTR (problematic)': f"{problematic['CTR'].mean():.4f}",
    'Average CTR (all)': f"{df['CTR'].mean():.4f}",
    'Average CVR (problematic)': f"{problematic['CVR'].mean():.4f}",
    'Average CVR (all)': f"{df['CVR'].mean():.4f}",
    'Mean Intent-Match Ratio': f"{problematic['Intent_Match_Ratio'].mean():.3f}",
    'Conversions per impression (problematic)': f"{problematic['Conversions_per_Impression'].mean():.6f}",
    'Conversions per impression (all)': f"{df['Conversions_per_Impression'].mean():.6f}",
    'Relative performance difference': f"{(problematic['Conversions_per_Impression'].mean()/df['Conversions_per_Impression'].mean() - 1)*100:.1f}% lower"
}

with open('visualization_summary.txt', 'w') as f:
    f.write("SUMMARY STATISTICS FOR VISUALIZATIONS\n")
    f.write("="*50 + "\n")
    for key, value in summary_stats.items():
        f.write(f"{key}: {value}\n")

conn.close()
print("Visualizations generated successfully!")
```
