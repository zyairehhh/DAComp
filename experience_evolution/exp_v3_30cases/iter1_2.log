        ax6.text(x, y + 500, f'${y:,.0f}', ha='center', va='bottom', fontsize=10)
    
    ax6.grid(True, alpha=0.3)
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig('cashflow_forecast.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("Created cashflow_forecast.png")
else:
    print("No cash flow forecast data found for next 6 months")

# Create tiered risk segmentation visualization based on Stage1 report
print("Creating tiered risk segmentation visualization...")

# Create risk tiers based on Stage1 report
high_risk_df['risk_tier'] = pd.cut(high_risk_df['risk_score'], 
                                   bins=[0, 45, 60, 100], 
                                   labels=['Green Zone (< 45)', 'Yellow Zone (45-60)', 'Red Zone (> 60)'])

tier_counts = high_risk_df['risk_tier'].value_counts().sort_index()

fig7, ax7 = plt.subplots(figsize=(10, 6))
colors = ['#59CD90', '#EDAE49', '#D1495B']
bars = ax7.bar([str(x) for x in tier_counts.index], tier_counts.values, color=colors)

ax7.set_xlabel('Risk Tier', fontsize=12)
ax7.set_ylabel('Number of Customers', fontsize=12)
ax7.set_title('High-Risk Customer Segmentation by Risk Score', fontsize=14, fontweight='bold')

# Add percentage labels
total_high_risk = len(high_risk_df)
for bar in bars:
    height = bar.get_height()
    percentage = (height / total_high_risk) * 100
    ax7.text(bar.get_x() + bar.get_width()/2., height + 2,
            f'{height} ({percentage:.1f}%)', ha='center', va='bottom', fontsize=10)

ax7.grid(True, axis='y', alpha=0.3)
plt.tight_layout()
plt.savefig('risk_tier_segmentation.png', dpi=300, bbox_inches='tight')
plt.close()

print("Created risk_tier_segmentation.png")

# 6. Outstanding balance by risk tier
print("Creating outstanding balance by risk tier visualization...")

if 'risk_tier' in high_risk_df.columns:
    tier_balance = high_risk_df.groupby('risk_tier')['outstanding_balance'].sum().sort_index()
    
    fig8, ax8 = plt.subplots(figsize=(10, 6))
    colors = ['#59CD90', '#EDAE49', '#D1495B']
    bars = ax8.bar([str(x) for x in tier_balance.index], tier_balance.values / 1000000, color=colors)
    
    ax8.set_xlabel('Risk Tier', fontsize=12)
    ax8.set_ylabel('Total Outstanding Balance ($M)', fontsize=12)
    ax8.set_title('Total Outstanding Balance by Risk Tier ($M)', fontsize=14, fontweight='bold')
    
    # Add value labels
    for bar in bars:
        height = bar.get_height()
        ax8.text(bar.get_x() + bar.get_width()/2., height + 0.2,
                f'${height:.2f}M', ha='center', va='bottom', fontsize=10)
    
    ax8.grid(True, axis='y', alpha=0.3)
    plt.tight_layout()
    plt.savefig('balance_by_risk_tier.png', dpi=300, bbox_inches='tight')
    plt.close()
    
    print("Created balance_by_risk_tier.png")

conn.close()

print("All visualizations created successfully!")
