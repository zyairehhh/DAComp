Action: CreateFile(filepath='plot_satisfaction_vs_deviation.py':
'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

df['Deviation'] = df['Budget Amount'] - df['Actual Cost']

# Calculate correlation per risk level
correlations = {}
fig, ax = plt.subplots(figsize=(10, 7))
markers = {'Low': 'o', 'Medium': 's', 'High': '^'}
colors = {'Low': 'green', 'Medium': 'orange', 'High': 'red'}

for risk in ['Low', 'Medium', 'High']:
    subset = df[df['Risk Level'] == risk]
    correlations[risk] = subset['Customer Satisfaction'].corr(subset['Deviation'])
    ax.scatter(subset['Customer Satisfaction'], subset['Deviation'],
               marker=markers[risk], color=colors[risk], alpha=0.7,
               s=60, label=f'{risk} Risk (r={correlations[risk]:.3f})')
    # Add linear fit
    if len(subset) > 1:
        x = subset['Customer Satisfaction'].values
        y = subset['Deviation'].values
        coef = np.polyfit(x, y, 1)
        poly = np.poly1d(coef)
        x_sorted = np.sort(x)
        ax.plot(x_sorted, poly(x_sorted), color=colors[risk], linewidth=2, alpha=0.8)

ax.set_xlabel('Customer Satisfaction', fontsize=12)
ax.set_ylabel('Cost Deviation', fontsize=12)
ax.set_title('Customer Satisfaction vs Cost Deviation by Risk Level', fontsize=14, pad=15)
ax.legend()
ax.grid(True, alpha=0.3)

# Highlight low-risk strong negative correlation
ax.text(0.05, 0.95, 'Low‑Risk: strong negative correlation (r ≈ -0.64)',
        transform=ax.transAxes, fontsize=11, verticalalignment='top',
        bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.8))

plt.tight_layout()
plt.savefig('satisfaction_vs_deviation.png', dpi=150)
print("Saved satisfaction_vs_deviation.png")
''')
