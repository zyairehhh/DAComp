import pandas as pd
import numpy as np
from datetime import datetime, timedelta

conn = sqlite3.connect("dacomp-057.sqlite")

# Load necessary columns
query = """
SELECT 
    account_id,
    advertising_channel_type,
    date_day,
    customer_acquisition_cost as cac,
    ltv_cac_ratio,
    campaign_lifecycle_stage,
    customer_maturity_stage,
    account_maturity_stage,
    acquisition_sophistication_score,
    cac_efficiency_percentile,
    channel_diversity_count,
    strategic_customer_segment,
    retention_risk,
    scale_opportunity,
    acquisition_cohort,
    advertising_channel_subtype,
    account_name
FROM google_ads__customer_acquisition_analysis
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Clean date
df['date_day'] = pd.to_datetime(df['date_day'].str.replace(' +0800', '', regex=False))
df['acquisition_cohort'] = pd.to_datetime(df['acquisition_cohort'].str.replace(' +0800', '', regex=False))

# For each campaign, compute its last date
campaign_last_date = df.groupby(['account_id', 'advertising_channel_type'])['date_day'].max().reset_index()
campaign_last_date.columns = ['account_id', 'advertising_channel_type', 'last_date']

# Merge back to get per row relative days
df = df.merge(campaign_last_date, on=['account_id', 'advertising_channel_type'])
df['days_to_last'] = (df['last_date'] - df['date_day']).dt.days

# Define windows: last 30 days where days_to_last <= 30, previous 30 days where 30 < days_to_last <= 60
df_last = df[df['days_to_last'] <= 30]
df_prev = df[(df['days_to_last'] > 30) & (df['days_to_last'] <= 60)]

# Compute average CAC and LTV/CAC ratio per campaign in each window
last_avg = df_last.groupby(['account_id', 'advertising_channel_type']).agg({
    'cac': 'mean',
    'ltv_cac_ratio': 'mean'
}).reset_index().rename(columns={'cac': 'cac_last', 'ltv_cac_ratio': 'ltv_cac_last'})

prev_avg = df_prev.groupby(['account_id', 'advertising_channel_type']).agg({
    'cac': 'mean',
    'ltv_cac_ratio': 'mean'
}).reset_index().rename(columns={'cac': 'cac_prev', 'ltv_cac_ratio': 'ltv_cac_prev'})

# Merge
merged = pd.merge(last_avg, prev_avg, on=['account_id', 'advertising_channel_type'], how='inner')
print("Campaigns with data in both windows:", len(merged))
if len(merged) > 0:
    print(merged)

# Compute growth and decline
merged['cac_growth_rate'] = (merged['cac_last'] - merged['cac_prev']) / merged['cac_prev']
merged['ltv_cac_decline'] = (merged['ltv_cac_prev'] - merged['ltv_cac_last']) / merged['ltv_cac_prev']  # positive means decline

# Filter criteria
filtered = merged[(merged['cac_growth_rate'] > 0.25) & (merged['ltv_cac_decline'] > 0.20)]
print("\nCampaigns with CAC growth >25% and LTV/CAC decline >20%:", len(filtered))
if len(filtered) > 0:
    print(filtered[['account_id', 'advertising_channel_type', 'cac_growth_rate', 'ltv_cac_decline']])

# Calculate campaign age (days between acquisition_cohort and last_date)
campaign_age = df.groupby(['account_id', 'advertising_channel_type'])['acquisition_cohort'].min().reset_index()
campaign_age = campaign_age.merge(campaign_last_date, on=['account_id', 'advertising_channel_type'])
campaign_age['campaign_age_days'] = (campaign_age['last_date'] - campaign_age['acquisition_cohort']).dt.days
print("\nCampaign age distribution:")
print(campaign_age['campaign_age_days'].describe())

# Keep age > 120
campaign_age = campaign_age[campaign_age['campaign_age_days'] > 120]
print("Campaigns age >120 days:", len(campaign_age))

# Merge with filtered campaigns (if any)
if len(filtered) > 0:
    final = pd.merge(filtered, campaign_age, on=['account_id', 'advertising_channel_type'], how='inner')
    print("\nFinal campaigns meeting all criteria:", len(final))
    print(final[['account_id', 'advertising_channel_type', 'cac_growth_rate', 'ltv_cac_decline', 'campaign_age_days']])
else:
    print("No campaigns meet the CAC growth and LTV/CAC decline criteria.")
    # We will still analyze campaigns that are >120 days and have some decay? Let's at least list campaigns with data in last 30 days.
    # Let's compute all campaigns with data in last 30 days and see their metrics.
    campaigns_last = df_last.groupby(['account_id', 'advertising_channel_type']).size().reset_index(name='count')
    print("\nCampaigns with data in last 30 days:", len(campaigns_last))
