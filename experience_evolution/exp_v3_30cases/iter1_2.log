import pandas as pd
import sqlite3
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# Connect to database
conn = sqlite3.connect("dacomp-078.sqlite")

# Load pendo__account data
df = pd.read_sql_query("""
    SELECT 
        avg_nps_rating,
        sum_minutes,
        sum_events,
        count_active_days,
        count_active_months,
        count_feature_clicking_visitors,
        count_page_viewing_visitors,
        count_active_visitors,
        count_associated_visitors,
        latest_account_index
    FROM pendo__account
    WHERE avg_nps_rating IS NOT NULL
        AND sum_minutes IS NOT NULL
        AND sum_events IS NOT NULL
""", conn)

print("Rows loaded:", df.shape[0])
print(df.head())

# Define high-value label using a combination of NPS and activity
# Use median of count_active_days as threshold
median_days = df['count_active_days'].median()
df['high_value'] = ((df['avg_nps_rating'] >= 7) & (df['count_active_days'] > median_days)).astype(int)
print("\nHigh value proportion (NPS>=7 & active days > median):", df['high_value'].mean())

# Plot 1: Scatter of duration vs frequency, colored by high_value
plt.figure(figsize=(10,6))
scatter = plt.scatter(df['sum_minutes'], df['sum_events'], 
                     c=df['high_value'], alpha=0.6, cmap='coolwarm', s=30)
plt.colorbar(scatter, label='High Value (1) / Low Value (0)')
plt.xlabel('Total Usage Minutes (Duration)')
plt.ylabel('Total Events (Frequency)')
plt.title('Current Model: Duration vs Frequency colored by High‑Value Label \n(NPS≥7 & Active Days > Median)')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('duration_vs_frequency_scatter.png')
plt.close()

# Plot 2: Correlation heatmap of features (including high_value)
numeric_cols = ['avg_nps_rating', 'sum_minutes', 'sum_events', 'count_active_days', 
                'count_active_months', 'count_feature_clicking_visitors', 
                'count_page_viewing_visitors', 'count_active_visitors', 'high_value']
corr = df[numeric_cols].corr()
plt.figure(figsize=(10,8))
sns.heatmap(corr, annot=True, fmt='.2f', cmap='RdBu_r', center=0)
plt.title('Correlation Matrix of Potential Features for Multi‑Dimensional Model')
plt.tight_layout()
plt.savefig('correlation_heatmap.png')
plt.close()

# Plot 3: Comparing high vs low value groups across multiple dimensions
high = df[df['high_value'] == 1]
low = df[df['high_value'] == 0]

fig, axes = plt.subplots(2, 3, figsize=(14, 10))
metrics = ['sum_minutes', 'sum_events', 'count_active_days', 
           'count_active_months', 'count_feature_clicking_visitors', 'count_page_viewing_visitors']
titles = ['Total Minutes', 'Total Events', 'Active Days', 
          'Active Months', 'Feature Clicking Visitors', 'Page Viewing Visitors']

for i, (ax, metric, title) in enumerate(zip(axes.flat, metrics, titles)):
    ax.hist(low[metric], bins=30, alpha=0.5, label='Low Value', color='blue', density=True)
    ax.hist(high[metric], bins=30, alpha=0.5, label='High Value', color='red', density=True)
    ax.set_xlabel(title)
    ax.set_ylabel('Density')
    ax.legend()
    ax.grid(True, alpha=0.3)

fig.suptitle('Distribution Comparison: High‑Value vs Low‑Value Customers Across Dimensions', fontsize=14)
plt.tight_layout()
plt.savefig('multidim_distributions.png')
plt.close()

# Plot 4: NPS rating distribution with threshold line
plt.figure(figsize=(10,6))
plt.hist(df['avg_nps_rating'], bins=20, edgecolor='black', alpha=0.7)
plt.axvline(x=7, color='red', linestyle='--', label='NPS ≥ 7 threshold')
plt.xlabel('Average NPS Rating')
plt.ylabel('Frequency')
plt.title('Distribution of Average NPS Rating')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('nps_distribution.png')
plt.close()

# Plot 5: Feature importance using simple logistic regression coefficients (manual)
# Compute standardized features
from scipy.special import expit  # logistic sigmoid

# Simple logistic regression using gradient descent (for demonstration)
# We'll just compute correlation with target as proxy importance
features = ['sum_minutes', 'sum_events']
X = df[features].values
y = df['high_value'].values
# Standardize
X_mean = X.mean(axis=0)
X_std = X.std(axis=0)
X_std = np.where(X_std == 0, 1, X_std)
X_norm = (X - X_mean) / X_std

# Closed-form logistic regression via maximum likelihood (simplified)
beta = np.linalg.inv(X_norm.T @ X_norm) @ X_norm.T @ (y - 0.5)  # rough approximation
print("\nApproximate standardized coefficients (duration, frequency):", beta)

plt.figure(figsize=(8,5))
plt.barh(features, beta)
plt.xlabel('Approximate Coefficient (Standardized)')
plt.title('Relative Influence of Duration & Frequency on High‑Value Label')
plt.grid(True, alpha=0.3, axis='x')
plt.tight_layout()
plt.savefig('feature_importance_simple.png')
plt.close()

# Plot 6: 3D scatter for three dimensions? Maybe use count_active_days as third dimension
# We'll create a 2D scatter with size representing third dimension
plt.figure(figsize=(10,6))
sc = plt.scatter(df['sum_minutes'], df['sum_events'], 
                 c=df['count_active_days'], cmap='viridis', alpha=0.6, s=30)
plt.colorbar(sc, label='Active Days')
plt.xlabel('Total Usage Minutes (Duration)')
plt.ylabel('Total Events (Frequency)')
plt.title('Duration vs Frequency with Active Days as Third Dimension (Color)')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('three_dim_scatter.png')
plt.close()

# Calculate hypothetical accuracy of a threshold-based classifier using only duration+frequency
# Use logistic regression probability threshold 0.5
probs = expit(X_norm @ beta)
pred = (probs > 0.5).astype(int)
accuracy = (pred == y).mean()
print(f"\nHypothetical accuracy of logistic regression (duration+frequency only): {accuracy:.3f}")

# Compare with random guess
random_acc = max(y.mean(), 1 - y.mean())
print(f"Baseline (majority class) accuracy: {random_acc:.3f}")
print(f"Improvement over baseline: {accuracy - random_acc:.3f}")

conn.close()
