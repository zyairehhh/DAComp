import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-089.sqlite')

# Load accounts with revenue and employees
accounts = pd.read_sql_query("""
    SELECT account_id, account_name, annual_revenue, number_of_employees,
           total_contacts, industry_normalized, account_size_segment,
           company_size_category, geographic_region
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL AND number_of_employees > 0
""", conn)

# Compute top 20% revenue threshold
threshold = accounts['annual_revenue'].quantile(0.8)
top_accounts = accounts[accounts['annual_revenue'] >= threshold].copy()

# Load contacts for top accounts
account_ids = top_accounts['account_id'].tolist()
placeholders = ','.join(['?'] * len(account_ids))
contacts = pd.read_sql_query(f"""
    SELECT account_id, contact_id, title, department
    FROM salesforce__contact_enhanced
    WHERE account_id IN ({placeholders})
""", conn, params=account_ids)

# Decision-maker flag includes "Chief" and "VP"
contacts['is_decision_maker'] = contacts['title'].fillna('').str.contains('Chief|VP|Vice President', case=False, na=False)

# Aggregate per account
agg = contacts.groupby('account_id').agg(
    decision_makers=('is_decision_maker', 'sum'),
    total_contacts_agg=('contact_id', 'count'),
    departments=('department', lambda x: x.dropna().unique())
).reset_index()

top_accounts = top_accounts.merge(agg, on='account_id', how='left')
top_accounts['decision_makers'] = top_accounts['decision_makers'].fillna(0)
top_accounts['total_contacts_agg'] = top_accounts['total_contacts_agg'].fillna(0)

# Metrics
top_accounts['contact_density_ratio'] = top_accounts['total_contacts'] / top_accounts['number_of_employees'] * 1000
top_accounts['decision_maker_ratio'] = top_accounts['decision_makers'] / top_accounts['total_contacts_agg'].replace(0, np.nan) * 100

# Department mapping: IT -> Engineering
key_departments = ['Sales', 'Finance', 'Operations', 'Engineering', 'HR']
def count_coverage(dept_array):
    if isinstance(dept_array, list):
        return sum(1 for dept in dept_array if dept in key_departments)
    return 0

top_accounts['covered'] = top_accounts['departments'].apply(count_coverage)
top_accounts['coverage_completeness'] = top_accounts['covered'] / len(key_departments) * 100

# Risk flags using generic benchmarks (to be adjusted)
top_accounts['density_risk'] = top_accounts['contact_density_ratio'] < 5
top_accounts['decision_maker_risk'] = top_accounts['decision_maker_ratio'] < 15
top_accounts['coverage_risk'] = top_accounts['coverage_completeness'] < 100
top_accounts['total_risks'] = top_accounts[['density_risk', 'decision_maker_risk', 'coverage_risk']].sum(axis=1)

# Compute industry-specific benchmarks
industry_stats = top_accounts.groupby('industry_normalized').agg(
    median_density=('contact_density_ratio', 'median'),
    median_decision_maker=('decision_maker_ratio', 'median'),
    median_coverage=('coverage_completeness', 'median'),
    accounts=('account_id', 'count')
).round(2)

print("=== Industry-Specific Medians (for benchmark adjustment) ===")
print(industry_stats.sort_values('median_density', ascending=False))

# Compute size-specific benchmarks
size_stats = top_accounts.groupby('company_size_category').agg(
    median_density=('contact_density_ratio', 'median'),
    median_decision_maker=('decision_maker_ratio', 'median'),
    median_coverage=('coverage_completeness', 'median'),
    accounts=('account_id', 'count')
).round(2)
print("\n=== Size-Category Medians ===")
print(size_stats)

# Differentiated risk assessment: define flexible thresholds
# For each industry, benchmark = median of that industry (or 25th percentile?)
# For simplicity, we can set benchmarks as median of industry.
# Let's create adjusted risk flags per industry with benchmark = median.
# For density: if below industry median, flag.
# For decision-maker: if below industry median, flag.
# For coverage: if below industry median, flag.
# We'll compute for each account.

adjusted_risk = top_accounts.copy()
for industry in adjusted_risk['industry_normalized'].unique():
    ind_mask = adjusted_risk['industry_normalized'] == industry
    if ind_mask.sum() < 10:  # skip small groups
        continue
    sub = adjusted_risk[ind_mask]
    density_bench = sub['contact_density_ratio'].median()
    dm_bench = sub['decision_maker_ratio'].median()
    cov_bench = sub['coverage_completeness'].median()
    adjusted_risk.loc[ind_mask, 'density_bench'] = density_bench
    adjusted_risk.loc[ind_mask, 'dm_bench'] = dm_bench
    adjusted_risk.loc[ind_mask, 'cov_bench'] = cov_bench
    adjusted_risk.loc[ind_mask, 'density_risk_adj'] = adjusted_risk.loc[ind_mask, 'contact_density_ratio'] < density_bench
    adjusted_risk.loc[ind_mask, 'decision_maker_risk_adj'] = adjusted_risk.loc[ind_mask, 'decision_maker_ratio'] < dm_bench
    adjusted_risk.loc[ind_mask, 'coverage_risk_adj'] = adjusted_risk.loc[ind_mask, 'coverage_completeness'] < cov_bench

# Fill missing benchmarks with global median
for col in ['density_bench', 'dm_bench', 'cov_bench']:
    adjusted_risk[col] = adjusted_risk[col].fillna(adjusted_risk[col].median())
adjusted_risk['density_risk_adj'] = adjusted_risk['density_risk_adj'].fillna(adjusted_risk['contact_density_ratio'] < adjusted_risk['density_bench'])
adjusted_risk['decision_maker_risk_adj'] = adjusted_risk['decision_maker_risk_adj'].fillna(adjusted_risk['decision_maker_ratio'] < adjusted_risk['dm_bench'])
adjusted_risk['coverage_risk_adj'] = adjusted_risk['coverage_risk_adj'].fillna(adjusted_risk['coverage_completeness'] < adjusted_risk['cov_bench'])

adjusted_risk['total_risks_adj'] = adjusted_risk[['density_risk_adj', 'decision_maker_risk_adj', 'coverage_risk_adj']].sum(axis=1)

print("\n=== Adjusted Risk Distribution (Industry-specific benchmarks) ===")
print(adjusted_risk['total_risks_adj'].value_counts().sort_index())

# Identify high-risk accounts using adjusted thresholds (>=2 risks)
high_risk_adj = adjusted_risk[adjusted_risk['total_risks_adj'] >= 2]
print(f"\nHigh-risk accounts (adjusted): {len(high_risk_adj)}")

# Prioritization: compute composite score for each account based on revenue, number of risks, etc.
adjusted_risk['revenue_score'] = adjusted_risk['annual_revenue'] / adjusted_risk['annual_revenue'].max()
adjusted_risk['risk_score'] = adjusted_risk['total_risks_adj'] / 3
adjusted_risk['priority_score'] = adjusted_risk['revenue_score'] * 0.7 + adjusted_risk['risk_score'] * 0.3

# Sort by priority
top_priority = adjusted_risk.sort_values('priority_score', ascending=False).head(30)
print("\n=== Top 30 Priority Accounts ===")
print(top_priority[['account_name', 'annual_revenue', 'total_risks_adj', 'priority_score', 'contact_density_ratio', 'decision_maker_ratio', 'coverage_completeness']].to_string(index=False))

# Save results
adjusted_risk.to_csv('adjusted_risk_analysis.csv', index=False)
print("\nSaved adjusted_risk_analysis.csv")

# Department gaps analysis: which departments are missing most?
dept_gaps = {}
for dept in key_departments:
    dept_gaps[dept] = top_accounts['departments'].apply(lambda arr: dept in arr if isinstance(arr, list) else False).sum()
print("\n=== Department Coverage (count of accounts with at least one contact in that department) ===")
for dept, cnt in dept_gaps.items():
    print(f"{dept}: {cnt} accounts ({cnt/len(top_accounts):.1%})")

conn.close()
```
