import pandas as pd

df = pd.read_csv('visitor_segment_raw.csv')
df['single_feature_use'] = df['distinct_features'] < 5
df['minutes_per_event'] = df['sum_minutes'] / df['sum_events']
segment_single = df[df['single_feature_use']]
segment_normal = df[~df['single_feature_use']]

print("Average minutes per event:")
print(f"Single-feature-use: {segment_single['minutes_per_event'].mean():.3f}")
print(f"Normal: {segment_normal['minutes_per_event'].mean():.3f}")
print(f"Difference: {segment_single['minutes_per_event'].mean() - segment_normal['minutes_per_event'].mean():.3f}")

# Distribution
print("\nDescriptive stats minutes per event:")
print("Single-feature-use:")
print(segment_single['minutes_per_event'].describe())
print("\nNormal:")
print(segment_normal['minutes_per_event'].describe())
