```
import sqlite3
import pandas as pd
import numpy as np
import statsmodels.api as sm

def weighted_conversion(df):
    # Compute weighted average conversion rate (interview_rate weighted by total_applications)
    weighted = np.sum(df['interview_rate'] * df['total_applications']) / np.sum(df['total_applications'])
    return weighted

def main():
    conn = sqlite3.connect('dacomp-066.sqlite')
    # Get combined data
    query = """
    SELECT p.job_id, p.job_title, p.application_year, p.application_quarter,
           p.interview_rate, p.total_applications, p.completed_interviews,
           e.departments, e.hiring_managers, e.avg_interviews_per_application,
           e.count_total_interviews, e.application_to_interview_rate,
           e.overall_conversion_rate, e.days_since_created
    FROM greenhouse__recruitment_performance p
    JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
    """
    df = pd.read_sql_query(query, conn)
    conn.close()
    # Extract role
    df['role_category'] = df['job_title'].str.split(' - ').str[0]
    # Engineering
    eng_df = df[df['departments'] == 'Engineering'].copy()
    # Marketing
    mkt_df = df[df['departments'] == 'Marketing'].copy()
    # Weighted conversion rates overall
    eng_q3 = eng_df[eng_df['application_quarter'] == 3]
    eng_q4 = eng_df[eng_df['application_quarter'] == 4]
    eng_weighted_q3 = weighted_conversion(eng_q3)
    eng_weighted_q4 = weighted_conversion(eng_q4)
    print(f"Engineering weighted conversion Q3: {eng_weighted_q3:.2f}%")
    print(f"Engineering weighted conversion Q4: {eng_weighted_q4:.2f}%")
    mkt_q3 = mkt_df[mkt_df['application_quarter'] == 3]
    mkt_q4 = mkt_df[mkt_df['application_quarter'] == 4]
    mkt_weighted_q3 = weighted_conversion(mkt_q3)
    mkt_weighted_q4 = weighted_conversion(mkt_q4)
    print(f"Marketing weighted conversion Q3: {mkt_weighted_q3:.2f}%")
    print(f"Marketing weighted conversion Q4: {mkt_weighted_q4:.2f}%")
    # Role-level weighted change
    role_summary = pd.DataFrame()
    for role in eng_df['role_category'].unique():
        role_df = eng_df[eng_df['role_category'] == role]
        # Q3
        role_q3 = role_df[role_df['application_quarter'] == 3]
        role_q4 = role_df[role_df['application_quarter'] == 4]
        if len(role_q3) == 0 or len(role_q4) == 0:
            continue
        w_q3 = weighted_conversion(role_q3)
        w_q4 = weighted_conversion(role_q4)
        change = w_q4 - w_q3
        role_summary = pd.concat([role_summary, pd.DataFrame({
            'role': [role],
            'weighted_q3': [w_q3],
            'weighted_q4': [w_q4],
            'change': [change],
            'perc_change': [change / w_q3 * 100]
        })])
    role_summary = role_summary.sort_values('change')
    print("\nRole-weighted conversion decline (worst to best):")
    print(role_summary.to_string(index=False))
    # Hiring manager analysis
    hm_summary = pd.DataFrame()
    for hm in eng_df['hiring_managers'].unique():
        hm_df = eng_df[eng_df['hiring_managers'] == hm]
        hm_q3 = hm_df[hm_df['application_quarter'] == 3]
        hm_q4 = hm_df[hm_df['application_quarter'] == 4]
        if len(hm_q3) == 0 or len(hm_q4) == 0:
            continue
        w_q3 = weighted_conversion(hm_q3)
        w_q4 = weighted_conversion(hm_q4)
        hm_summary = pd.concat([hm_summary, pd.DataFrame({
            'hiring_manager': [hm],
            'weighted_q3': [w_q3],
            'weighted_q4': [w_q4],
            'change': [w_q4 - w_q3],
            'q3_jobs': [len(hm_q3)],
            'q4_jobs': [len(hm_q4)]
        })])
    hm_summary = hm_summary.sort_values('change')
    print("\nHiring manager conversion change (worst to best):")
    print(hm_summary.to_string(index=False))
    # Impact of avg_interviews_per_application on interview_rate (conversion)
    # Use all engineering jobs (pool Q3 and Q4)
    X = eng_df[['avg_interviews_per_application']].copy()
    X['const'] = 1
    y = eng_df['interview_rate']
    model = sm.OLS(y, X).fit()
    print(f"\nImpact of avg_interviews_per_application on conversion:")
    print(model.summary().tables[1].as_text())
    # Effect of days_since_created (proxy for hiring manager experience? not really)
    X2 = eng_df[['days_since_created']].copy()
    X2['const'] = 1
    model2 = sm.OLS(y, X2).fit()
    print("\nImpact of days_since_created on conversion:")
    print(model2.summary().tables[1].as_text())
    # Save results
    role_summary.to_csv('role_weighted_change.csv', index=False)
    hm_summary.to_csv('hm_weighted_change.csv', index=False)
if __name__ == '__main__':
    main()
```



