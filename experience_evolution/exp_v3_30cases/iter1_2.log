'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-017/stage1_env/dacomp-017.sqlite')

# Recompute RFM segments
query_rfm = """
SELECT 
    "Customer ID",
    MAX("Order Date") as last_purchase,
    COUNT(DISTINCT "Order ID") as frequency,
    SUM(profit) as monetary
FROM order_information 
WHERE "Product Category" = 'Home & Furniture'
GROUP BY "Customer ID"
"""
rfm = pd.read_sql(query_rfm, conn)
rfm['last_purchase'] = pd.to_datetime(rfm['last_purchase'])
max_date = pd.to_datetime('2024-12-31 00:00:00')
rfm['recency_days'] = (max_date - rfm['last_purchase']).dt.days

rfm['R_score'] = pd.qcut(rfm['recency_days'], q=4, labels=[4,3,2,1])
rfm['F_score'] = pd.qcut(rfm['frequency'], q=4, labels=[1,2,3,4])
rfm['M_score'] = pd.qcut(rfm['monetary'], q=4, labels=[1,2,3,4])
rfm['RFM_total'] = rfm['R_score'].astype(int) + rfm['F_score'].astype(int) + rfm['M_score'].astype(int)
rfm['segment'] = 'Mid'
rfm.loc[rfm['RFM_total'] >= 10, 'segment'] = 'High'
rfm.loc[rfm['RFM_total'] <= 5, 'segment'] = 'Low'

high_ids = rfm[rfm['segment'] == 'High']['Customer ID'].tolist()
low_ids = rfm[rfm['segment'] == 'Low']['Customer ID'].tolist()

# Helper function to get segment metrics
def segment_metrics(customer_ids, segment_name):
    if not customer_ids:
        return pd.DataFrame()
    placeholders = ','.join('?' for _ in customer_ids)
    query = f"""
    SELECT 
        strftime('%Y', "Order Date") as year,
        AVG(CAST("Discount" AS REAL)) as avg_discount,
        AVG(CAST("Shipping Cost" AS REAL)) as avg_shipping_cost,
        AVG(CAST("Quantity" AS INTEGER)) as avg_quantity,
        AVG(Sales) as avg_sales,
        AVG(profit) as avg_profit,
        SUM(Sales) as total_sales,
        SUM(profit) as total_profit,
        COUNT(*) as order_lines
    FROM order_information 
    WHERE "Product Category" = 'Home & Furniture'
        AND "Customer ID" IN ({placeholders})
    GROUP BY year
    ORDER BY year
    """
    df = pd.read_sql(query, conn, params=customer_ids)
    df['segment'] = segment_name
    return df

high_metrics = segment_metrics(high_ids, 'High')
low_metrics = segment_metrics(low_ids, 'Low')
metrics = pd.concat([high_metrics, low_metrics])
print("Segment metrics per year:")
print(metrics)

# Compute margin
metrics['margin'] = metrics['total_profit'] / metrics['total_sales']
print("\nSegment margins:")
print(metrics[['segment','year','margin','avg_discount','avg_shipping_cost','avg_quantity']])

# Order priority distribution
def priority_dist(customer_ids, segment_name):
    if not customer_ids:
        return pd.DataFrame()
    placeholders = ','.join('?' for _ in customer_ids)
    query = f"""
    SELECT 
        strftime('%Y', "Order Date") as year,
        "Order Priority",
        COUNT(*) as orders,
        SUM(Sales) as sales,
        SUM(profit) as profit
    FROM order_information 
    WHERE "Product Category" = 'Home & Furniture'
        AND "Customer ID" IN ({placeholders})
    GROUP BY year, "Order Priority"
    ORDER BY year, "Order Priority"
    """
    df = pd.read_sql(query, conn, params=customer_ids)
    df['segment'] = segment_name
    return df

high_priority = priority_dist(high_ids, 'High')
low_priority = priority_dist(low_ids, 'Low')
priority = pd.concat([high_priority, low_priority])
print("\nPriority distribution:")
print(priority)

conn.close()
''')
