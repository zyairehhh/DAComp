import sqlite3
import pandas as pd
import numpy as np

# Connect to database
db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-008/stage1_env/dacomp-008.sqlite"
conn = sqlite3.connect(db_path)
df = pd.read_sql("SELECT * FROM sheet1", conn)
conn.close()

# Compute deviation
df["deviation"] = df["Budget Amount"] - df["Actual Cost"]

# Basic stats
total_projects = len(df)
avg_deviation = df["deviation"].mean()
median_deviation = df["deviation"].median()
std_deviation = df["deviation"].std()
min_dev = df["deviation"].min()
max_dev = df["deviation"].max()
print("Overall deviation statistics:")
print(f"Total projects: {total_projects}")
print(f"Average deviation: {avg_deviation:.2f}")
print(f"Median deviation: {median_deviation:.2f}")
print(f"Std deviation: {std_deviation:.2f}")
print(f"Min deviation: {min_dev:.2f}")
print(f"Max deviation: {max_dev:.2f}")

# By Project Type
print("\n--- By Project Type ---")
type_group = df.groupby("Project Type")["deviation"].agg(["count", "mean", "median", "std", "min", "max"])
print(type_group)

# By Risk Level
print("\n--- By Risk Level ---")
risk_group = df.groupby("Risk Level")["deviation"].agg(["count", "mean", "median", "std", "min", "max"])
print(risk_group)

# Correlation with Team Size, Customer Satisfaction
print("\nCorrelation of deviation with Team Size:", df["deviation"].corr(df["Team Size"]))
print("Correlation of deviation with Customer Satisfaction:", df["deviation"].corr(df["Customer Satisfaction"]))

# Scatter analysis: maybe deviation vs budget
print("Correlation of deviation with Budget Amount:", df["deviation"].corr(df["Budget Amount"]))

# Consider only completed projects? Let's see project status distribution
print("\nProject Status counts:")
print(df["Project Status"].value_counts())

# Completed projects deviation
completed = df[df["Project Status"] == "Completed"]
print(f"\nCompleted projects deviation mean: {completed['deviation'].mean():.2f}")
print(f"In Progress projects deviation mean: {df[df['Project Status']=='In Progress']['deviation'].mean():.2f}")
print(f"Delayed projects deviation mean: {df[df['Project Status']=='Delayed']['deviation'].mean():.2f}")
