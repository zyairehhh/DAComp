import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-100.sqlite')

# Load company metrics
df = pd.read_sql_query("SELECT * FROM intercom__company_metrics", conn)
conn.close()

# Ensure output directory
os.makedirs('plots', exist_ok=True)

# 1. Average conversation rating by plan (contract size)
plt.figure(figsize=(8,6))
sns.boxplot(data=df, x='plan_name', y='avg_conversation_rating', order=['Starter','Growth','Scale','Enterprise'])
plt.title('Distribution of Conversation Rating by Plan Tier')
plt.xlabel('Plan (Contract Size)')
plt.ylabel('Average Conversation Rating')
plt.tight_layout()
plt.savefig('plots/rating_by_plan.png', dpi=300)
plt.close()

# 2. Median resolution time (p50_time_to_last_close_min) by industry
plt.figure(figsize=(10,6))
sns.boxplot(data=df, x='industry', y='p50_time_to_last_close_min')
plt.title('Resolution Time (Median) by Industry')
plt.xlabel('Industry')
plt.ylabel('Median Time to Last Close (minutes)')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('plots/resolution_time_by_industry.png', dpi=300)
plt.close()

# 3. Scatter: total conversations vs rating, colored by industry (sample to avoid overplotting)
sample = df.sample(min(1000, len(df)), random_state=42)
plt.figure(figsize=(10,6))
for industry in sample['industry'].unique():
    subset = sample[sample['industry']==industry]
    plt.scatter(subset['total_conversations'], subset['avg_conversation_rating'], label=industry, alpha=0.6)
plt.title('Conversation Volume vs Rating (Sample)')
plt.xlabel('Total Conversations')
plt.ylabel('Average Conversation Rating')
plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left', fontsize=8)
plt.tight_layout()
plt.savefig('plots/volume_vs_rating_scatter.png', dpi=300)
plt.close()

# 4. Average proportion of reopened conversations (p50_reopens) by industry and plan
# p50_reopens is likely a median proportion; we can compute mean per group
reopen_agg = df.groupby(['industry','plan_name'])['p50_reopens'].mean().reset_index()
reopen_agg = reopen_agg.pivot(index='industry', columns='plan_name', values='p50_reopens')
plt.figure(figsize=(10,8))
sns.heatmap(reopen_agg, annot=True, fmt='.2f', cmap='YlOrRd', linewidths=0.5)
plt.title('Average Reopen Rate (Median) by Industry and Plan')
plt.xlabel('Plan')
plt.ylabel('Industry')
plt.tight_layout()
plt.savefig('plots/reopen_heatmap.png', dpi=300)
plt.close()

# 5. Correlation heatmap of key metrics
metrics = ['total_conversations','avg_conversation_rating','p50_time_to_last_close_min','p50_reopens','contacts_active_30d','registration_retention_30d']
corr = df[metrics].corr()
plt.figure(figsize=(8,6))
sns.heatmap(corr, annot=True, cmap='coolwarm', vmin=-1, vmax=1, center=0, square=True)
plt.title('Correlation Between Key Performance Metrics')
plt.tight_layout()
plt.savefig('plots/correlation_heatmap.png', dpi=300)
plt.close()

print("Plots saved to plots/ directory")
```

