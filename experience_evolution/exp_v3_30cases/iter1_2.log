import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-089.sqlite')

# 1. Identify top 20% accounts by annual revenue
query = """
WITH revenue_stats AS (
    SELECT account_id, annual_revenue,
           total_contacts,
           number_of_employees,
           COUNT(*) OVER() as total_count,
           ROW_NUMBER() OVER (ORDER BY annual_revenue DESC) as rev_rank
    FROM salesforce__customer_360_view
    WHERE annual_revenue IS NOT NULL
)
SELECT account_id, annual_revenue,
       total_contacts,
       number_of_employees,
       rev_rank,
       total_count
FROM revenue_stats
WHERE rev_rank <= CEIL(total_count * 0.2)
ORDER BY annual_revenue DESC;
"""
top_accounts = pd.read_sql_query(query, conn)
print(f"Top 20% accounts count: {len(top_accounts)}")

# 2. Compute Contact Density Ratio (Contacts per 1000 employees) - handle null employees
top_accounts['contact_density_ratio'] = top_accounts.apply(
    lambda row: (row['total_contacts'] / row['number_of_employees'] * 1000) if row['number_of_employees'] not in (None, 0, float('nan')) else None,
    axis=1
)

# 3. Compute Decision‑Maker Ratio (C‑level + VP‑level contacts)
# define decision‑maker patterns
dm_patterns = ['Chief%', '%CEO%', '%CFO%', '%COO%', '%CTO%', '%CMO%', '%CSO%', '%CRO%']

# Build a single LIKE clause covering all patterns for SQL
dm_like_clause = " OR ".join([f"UPPER(title) LIKE '{p.upper().replace('%', '%')}'" for p in dm_patterns])
# but simpler: use Python to filter after fetching contacts

# Get contacts for top accounts
accounts_list = tuple(top_accounts['account_id'].tolist())
if len(accounts_list) == 1:
    accounts_list = f"('{accounts_list[0]}')"

contacts_query = f"""
SELECT account_id, contact_id, title, department
FROM salesforce__contact_enhanced
WHERE account_id IN {accounts_list}
"""
contacts_df = pd.read_sql_query(contacts_query, conn)

# classify decision‑maker
def is_decision_maker(title):
    if pd.isna(title):
        return False
    title_upper = title.upper()
    return any(keyword in title_upper for keyword in ['CHIEF', 'CEO', 'CFO', 'COO', 'CTO', 'CMO', 'CSO', 'CRO', 'PRESIDENT'])

contacts_df['is_decision_maker'] = contacts_df['title'].apply(is_decision_maker)

# compute DM ratio per account
dm_counts = contacts_df.groupby('account_id')['is_decision_maker'].agg(['sum', 'count']).reset_index()
dm_counts.columns = ['account_id', 'decision_maker_count', 'total_contacts_in_contact_table']

# merge with top_accounts
top_accounts = top_accounts.merge(dm_counts, on='account_id', how='left')
top_accounts['decision_maker_ratio_pct'] = 100 * top_accounts['decision_maker_count'] / top_accounts['total_contacts_in_contact_table']
top_accounts['decision_maker_ratio_pct'] = top_accounts['decision_maker_ratio_pct'].fillna(0)

# 4. Compute Departmental Coverage Completeness
# define key departments mapping
dept_mapping = {
    'Sales': 'Sales',
    'Finance': 'Finance',
    'Operations': 'Operations',
    'HR': 'HR',
    'IT': 'Engineering'  # assume Engineering = IT
}
key_depts = list(dept_mapping.values())

# compute distinct departments per account (from contacts)
dept_counts = contacts_df[contacts_df['department'].isin(key_depts)].groupby('account_id')['department'].nunique().reset_index()
dept_counts.columns = ['account_id', 'covered_key_depts']

top_accounts = top_accounts.merge(dept_counts, on='account_id', how='left')
top_accounts['covered_key_depts'] = top_accounts['covered_key_depts'].fillna(0)
top_accounts['coverage_completeness_pct'] = top_accounts['covered_key_depts'] / len(key_depts) * 100

# 5. Evaluate risk based on benchmarks
# benchmarks:
benchmark_contact_density = 5  # >=5
benchmark_decision_maker_ratio = 15  # >=15%
# coverage benchmark? maybe 100% (all five) but we can set threshold as >=80%? Let's assume benchmark is 100% (all five). We'll compute risk flags.

top_accounts['contact_density_risk'] = top_accounts['contact_density_ratio'].apply(lambda x: x is None or x < benchmark_contact_density)
top_accounts['decision_maker_risk'] = top_accounts['decision_maker_ratio_pct'] < benchmark_decision_maker_ratio
top_accounts['coverage_risk'] = top_accounts['covered_key_depts'] < len(key_depts)  # missing at least one department

# overall risk flag (any risk)
top_accounts['any_risk'] = top_accounts['contact_density_risk'] | top_accounts['decision_maker_risk'] | top_accounts['coverage_risk']

print("\nSummary:")
print(f"Total top accounts: {len(top_accounts)}")
print(f"Accounts with any risk: {top_accounts['any_risk'].sum()}")
print(f"Contact Density Risk: {top_accounts['contact_density_risk'].sum()}")
print(f"Decision‑Maker Ratio Risk: {top_accounts['decision_maker_risk'].sum()}")
print(f"Department Coverage Risk: {top_accounts['coverage_risk'].sum()}")

# Add some distribution statistics
print("\nContact Density Ratio stats:")
print(top_accounts['contact_density_ratio'].describe())
print("\nDecision‑Maker Ratio (%):")
print(top_accounts['decision_maker_ratio_pct'].describe())
print("\nCovered key departments count:")
print(top_accounts['covered_key_depts'].value_counts().sort_index())

# Save to CSV for further analysis
top_accounts.to_csv('top_accounts_metrics.csv', index=False)
print("\nData saved to top_accounts_metrics.csv")

conn.close()
```

