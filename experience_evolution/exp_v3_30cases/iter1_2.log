import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import re

conn = sqlite3.connect('dacomp-100.sqlite')

# Load company enhanced with parsed tags
df_companies = pd.read_sql_query("SELECT company_id, company_name, industry, plan_name, all_company_tags FROM intercom__company_enhanced", conn)

def parse_tags(tag_string):
    if not tag_string:
        return {}
    tags = tag_string.split('|')
    parsed = {}
    for tag in tags:
        if '=' in tag:
            key, val = tag.split('=', 1)
            parsed[key] = val
    return parsed

tag_data = df_companies['all_company_tags'].apply(parse_tags)
tag_df = pd.json_normalize(tag_data)
df_companies = pd.concat([df_companies, tag_df], axis=1)

# Extract feature adoption percentage
def extract_percentage(s):
    if pd.isna(s):
        return None
    match = re.search(r'\((\d+)%\)', s)
    if match:
        return int(match.group(1))
    else:
        num = re.search(r'(\d+)%', s)
        if num:
            return int(num.group(1))
    return None

df_companies['feature_adoption_pct'] = df_companies['feature_adoption'].apply(extract_percentage)

# Convert renewal_date to datetime
df_companies['renewal_date'] = pd.to_datetime(df_companies['renewal_date'], errors='coerce')
df_companies['renewal_window'] = df_companies['renewal_window']
df_companies['due_for_renewal'] = df_companies['renewal_window'] == 'inside_90_days'

# Extract health_score numeric
df_companies['health_score_num'] = pd.to_numeric(df_companies['health_score'], errors='coerce')

# Contract size, ACV
df_companies['acv_usd'] = pd.to_numeric(df_companies['acv_usd'], errors='coerce')
df_companies['contract_size'] = df_companies['contract_size']
df_companies['contract_tier'] = df_companies['contract_tier']

# Sentiment trend mapping to score maybe
sentiment_map = {'uplift': 2, 'positive': 1, 'stable': 0, 'watch': -1, 'at-risk': -2}
df_companies['sentiment_trend_score'] = df_companies['sentiment_trend'].map(sentiment_map)

# Load conversation_enhanced
df_conv = pd.read_sql_query("SELECT conversation_id, conversation_created_at, conversation_last_updated_at, conversation_state, all_conversation_tags, all_contact_company_names FROM intercom__conversation_enhanced", conn)
df_conv['conversation_created_at'] = pd.to_datetime(df_conv['conversation_created_at'])
df_conv['conversation_last_updated_at'] = pd.to_datetime(df_conv['conversation_last_updated_at'])

# Load conversation_metrics for rating and reopens
df_metrics = pd.read_sql_query("SELECT conversation_id, conversation_rating, count_reopens, time_to_first_close_minutes, time_to_last_close_minutes FROM intercom__conversation_metrics", conn)

# Merge conversation data
df_conv = df_conv.merge(df_metrics, on='conversation_id', how='left')

# Join with companies on company name
df_conv['company_name'] = df_conv['all_contact_company_names']  # note: could be multiple? but seems single
df = df_conv.merge(df_companies[['company_id', 'company_name', 'renewal_date', 'due_for_renewal']], on='company_name', how='inner')

print(f"Total conversations matched: {len(df)}")

# Define reference date for each company: renewal_date (or max conversation date if missing)
# We'll filter conversations within 30 days before renewal_date
df['days_to_renewal'] = (df['renewal_date'] - df['conversation_created_at']).dt.days
# Keep conversations where days_to_renewal between 0 and 30 (i.e., within last 30 days before renewal)
df_recent = df[(df['days_to_renewal'] >= 0) & (df['days_to_renewal'] <= 30)]

print(f"Conversations within 30 days before renewal: {len(df_recent)}")

# Compute per company features
def compute_features(group):
    # Communication & Interaction Features
    avg_conversations = group.shape[0] / 30.0  # average per day? Actually average number of conversations over last 30 days (total count)
    # Actually requirement: average number of conversations over the last 30 days.
    # We have total conversations in period of 30 days, average per day = total/30. But they might want average per month? We'll compute total conversations in 30 days.
    # Let's compute total conversations in last 30 days (already filtered). So avg_conversations = total conversations (count) over 30 days? Actually average number of conversations (per day?) Let's define as total conversations per 30 days.
    # For simplicity, we'll use total count of conversations in last 30 days.
    total_conversations = group.shape[0]
    
    # Proportion of negative sentiment: rating < 3 (assuming 1-5 scale). Use conversation_rating
    negative_count = (group['conversation_rating'] < 3).sum()
    prop_negative = negative_count / group.shape[0] if group.shape[0] > 0 else 0
    
    # Support Experience Features
    # Average resolution time: time_to_last_close_minutes (close time - creation time)
    avg_resolution_time = group['time_to_last_close_minutes'].mean() if group['time_to_last_close_minutes'].notna().any() else None
    
    # Proportion of reopened conversations: count_reopens > 0
    reopened_count = (group['count_reopens'] > 0).sum()
    prop_reopened = reopened_count / group.shape[0] if group.shape[0] > 0 else 0
    
    return pd.Series({
        'total_conversations_last30': total_conversations,
        'prop_negative_sentiment': prop_negative,
        'avg_resolution_time_minutes': avg_resolution_time,
        'prop_reopened': prop_reopened
    })

features = df_recent.groupby('company_id').apply(compute_features).reset_index()

# Merge with company tags
companies_features = df_companies.merge(features, on='company_id', how='left')
# Fill missing with zeros
companies_features['total_conversations_last30'] = companies_features['total_conversations_last30'].fillna(0)
companies_features['prop_negative_sentiment'] = companies_features['prop_negative_sentiment'].fillna(0)
companies_features['prop_reopened'] = companies_features['prop_reopened'].fillna(0)

# Also need product value features: key feature adoption coverage (from tags) and time since last value milestone.
# Time since last value milestone: not available, maybe we can ignore.
# We'll add feature adoption from tags.
companies_features['feature_adoption_pct'] = companies_features['feature_adoption_pct']

# Save to CSV
companies_features.to_csv('companies_with_features.csv', index=False)
print(companies_features.head())
print(companies_features.shape)

conn.close()
```
