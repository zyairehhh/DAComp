import pandas as pd
import sqlite3

conn = sqlite3.connect('data.sqlite')

# Load regions with average revenue metric
regions_df = pd.read_sql_query("""
    SELECT region, AVG(revenue_metric) AS avg_revenue_metric 
    FROM revenue_metrics 
    WHERE app_id = 'com.dev.photoeditor' 
        AND date >= '2024-01-01' 
        AND date <= '2024-12-01' 
    GROUP BY region
""", conn)

# Categorize regions
regions_df['revenue_category'] = pd.cut(regions_df['avg_revenue_metric'], 
                                         bins=[-float('inf'), 3, 7, float('inf')], 
                                         labels=['Low (<$3)', 'Medium ($3-$7)', 'High (>$7)'])

# Load performance data for the same period
performance_df = pd.read_sql_query("""
    SELECT region, date, overall_performance_score 
    FROM app_performance 
    WHERE app_id = 'com.dev.photoeditor' 
        AND date >= '2024-01-01' 
        AND date <= '2024-12-01'
""", conn)

# Merge with categories
merged_df = performance_df.merge(regions_df, on='region', how='left')

# Compute monthly average performance per category
monthly_avg = merged_df.groupby(['date', 'revenue_category'])['overall_performance_score'].mean().reset_index()

# Pivot for easier viewing
pivot_df = monthly_avg.pivot(index='date', columns='revenue_category', values='overall_performance_score')

# Compute overall performance change from start to end
start_end = merged_df[merged_df['date'].isin(['2024-01-01', '2024-12-01'])]
start_end_avg = start_end.groupby(['date', 'revenue_category'])['overall_performance_score'].mean().reset_index()
pivot_start_end = start_end_avg.pivot(index='date', columns='revenue_category', values='overall_performance_score')

# Also compute total research budget per region category
budget_df = pd.read_sql_query("""
    SELECT region, SUM(research_budget_usd) AS total_research_budget 
    FROM research_investments 
    WHERE app_id = 'com.dev.photoeditor' 
        AND date >= '2024-01-01' 
        AND date <= '2024-12-01' 
    GROUP BY region
""", conn)

# Merge with categories
budget_cat = budget_df.merge(regions_df[['region', 'revenue_category']], on='region', how='left')
budget_by_category = budget_cat.groupby('revenue_category')['total_research_budget'].sum()

# Output results
print("Regions with average revenue metric:")
print(regions_df)
print("\nMonthly average performance per category:")
print(pivot_df)
print("\nPerformance at start and end of year:")
print(pivot_start_end)
print("\nTotal research budget by revenue category:")
print(budget_by_category)

# Compute performance drop overall
overall_start = merged_df[merged_df['date'] == '2024-01-01']['overall_performance_score'].mean()
overall_end = merged_df[merged_df['date'] == '2024-12-01']['overall_performance_score'].mean()
print(f"\nOverall performance drop: from {overall_start:.2f} to {overall_end:.2f} (delta: {overall_end - overall_start:.2f})")

conn.close()
```

