'''
import sqlite3
import pandas as pd
import numpy as np
import re

# Load vocational data
conn = sqlite3.connect('dacomp-048.sqlite')
query = "SELECT * FROM sheet1 WHERE \"Education Requirement\" LIKE '%Vocational%'"
df = pd.read_sql_query(query, conn)

# Parse Salary Range
def extract_salary_range(s):
    if pd.isnull(s):
        return None, None
    # Remove spaces and commas
    s = str(s).replace(',', '')
    # Find first pattern like digits- digits
    match = re.search(r'(\d+)\s*-\s*(\d+)', s)
    if match:
        lower = int(match.group(1))
        upper = int(match.group(2))
        return lower, upper
    else:
        # Maybe single number
        match2 = re.search(r'(\d+)', s)
        if match2:
            val = int(match2.group(1))
            return val, val
    return None, None

lower_list = []
upper_list = []
for sr in df['Salary Range']:
    lower, upper = extract_salary_range(sr)
    lower_list.append(lower)
    upper_list.append(lower if upper is None else upper) # we'll store lower for starting salary

df['Salary Lower'] = lower_list
df['Salary Upper'] = upper_list

# Distribution of starting salary (lower)
valid_lower = df['Salary Lower'].dropna()
print(f"Valid salary lower count: {len(valid_lower)}")
print("Summary statistics:")
print(valid_lower.describe())

# Histogram bins
bins = [0, 3000, 5000, 8000, 12000, 20000, 50000]
labels = ['<3k', '3k-5k', '5k-8k', '8k-12k', '12k-20k', '>20k']
hist = pd.cut(valid_lower, bins=bins, labels=labels, right=False).value_counts().sort_index()
print("\\nStarting Salary Distribution:")
for k, v in hist.items():
    print(f"{k}: {v}")

# Benefits distribution
benefits_counts = {}
for b in df['Benefits'].dropna():
    # split by commas, strip spaces
    items = [item.strip() for item in str(b).split(',')]
    for item in items:
        if item:
            benefits_counts[item] = benefits_counts.get(item, 0) + 1

print("\\nTop 20 Benefits (frequency):")
sorted_benefits = sorted(benefits_counts.items(), key=lambda x: x[1], reverse=True)
for benefit, count in sorted_benefits[:20]:
    print(f"{benefit}: {count}")

# Now examine other categorical columns for salary influence
categorical_cols = ['Work Experience Requirement', 'Foreign Language Requirement', 
                    'Age Requirement', 'Gender Requirement', 'Employment Type',
                    'Company Type', 'Industry']

for col in categorical_cols:
    if col not in df.columns:
        continue
    # Group by category, compute mean Salary Lower
    grouped = df.groupby(col)['Salary Lower'].mean().dropna().sort_values(ascending=False)
    if len(grouped) > 0:
        print(f"\\nAverage Starting Salary by {col} (top 10):")
        print(grouped.head(10))
''')
