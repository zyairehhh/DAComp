import sqlite3
import pandas as pd
import re

conn = sqlite3.connect('dacomp-100.sqlite')

# Load company enhanced
df = pd.read_sql_query("SELECT company_id, company_name, industry, plan_name, all_company_tags FROM intercom__company_enhanced", conn)

def parse_tags(tag_string):
    if not tag_string:
        return {}
    tags = tag_string.split('|')
    parsed = {}
    for tag in tags:
        if '=' in tag:
            key, val = tag.split('=', 1)
            parsed[key] = val
    return parsed

# Parse tags
tag_data = df['all_company_tags'].apply(parse_tags)
# Convert to columns
tag_df = pd.json_normalize(tag_data)
df = pd.concat([df, tag_df], axis=1)

# Extract numeric from feature_adoption (e.g., "High (94%)" -> 94)
def extract_percentage(s):
    if pd.isna(s):
        return None
    match = re.search(r'\((\d+)%\)', s)
    if match:
        return int(match.group(1))
    else:
        # try to parse number before %
        num = re.search(r'(\d+)%', s)
        if num:
            return int(num.group(1))
    return None

df['feature_adoption_pct'] = df['feature_adoption'].apply(extract_percentage)

# Convert renewal_date to datetime
df['renewal_date'] = pd.to_datetime(df['renewal_date'], errors='coerce')
# Extract renewal_window categories: inside_90_days, within_30_days_past, future_90_plus, etc.
df['renewal_window'] = df['renewal_window']

# Extract health_score numeric
df['health_score_num'] = pd.to_numeric(df['health_score'], errors='coerce')

# Extract contract_size, acv_usd, contract_tier
df['contract_size'] = df['contract_size']
df['acv_usd'] = pd.to_numeric(df['acv_usd'], errors='coerce')
df['contract_tier'] = df['contract_tier']

# Sentiment trend
df['sentiment_trend'] = df['sentiment_trend']

# Compute renewal status: if renewal_window is inside_90_days, due for renewal.
df['due_for_renewal'] = df['renewal_window'] == 'inside_90_days'

# Save to CSV for analysis
df.to_csv('company_tags_parsed.csv', index=False)
print(df.head())
print(df.shape)

conn.close()
