import sqlite3
import pandas as pd
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-001.sqlite')

# Load company info
company = pd.read_sql_query('SELECT * FROM ch___company_info', conn)
company.rename(columns=lambda x: x.strip(), inplace=True)
print("Company info shape:", company.shape)

# Load sales invoices
sales = pd.read_sql_query('SELECT * FROM ch___sales_invoices', conn)
sales.rename(columns=lambda x: x.strip(), inplace=True)
# Load input invoices
purchases = pd.read_sql_query('SELECT * FROM ch___input_invoices', conn)
purchases.rename(columns=lambda x: x.strip(), inplace=True)

# Convert dates
sales['Invoice Date'] = pd.to_datetime(sales['Invoice Date'])
purchases['Invoice Date'] = pd.to_datetime(purchases['Invoice Date'])

# Aggregate total sales and purchases per enterprise
sales_agg = sales.groupby('Enterprise Code').agg(
    total_sales=('Amount Including Tax', 'sum'),
    sales_count=('Invoice Number', 'count'),
    unique_buyers=('Buyer organization code', 'nunique')
).reset_index()

purchases_agg = purchases.groupby('Enterprise Code').agg(
    total_purchases=('Amount Including Tax', 'sum'),
    purchases_count=('Invoice Number', 'count'),
    unique_suppliers=('Seller Organization Code', 'nunique')
).reset_index()

# Merge
metrics = pd.merge(sales_agg, purchases_agg, on='Enterprise Code', how='outer').fillna(0)
metrics = pd.merge(company[['Enterprise Code', 'Credit Rating', 'Defaulted']], metrics, on='Enterprise Code', how='left')

# Compute profit
metrics['profit'] = metrics['total_sales'] - metrics['total_purchases']
metrics['profit_margin'] = metrics['profit'] / metrics['total_sales'].replace(0, np.nan)

# Compute stability: coefficient of variation of monthly profit
# Create monthly profit per enterprise
sales['month'] = sales['Invoice Date'].dt.to_period('M')
purchases['month'] = purchases['Invoice Date'].dt.to_period('M')

monthly_sales = sales.groupby(['Enterprise Code', 'month'])['Amount Including Tax'].sum().reset_index()
monthly_purchases = purchases.groupby(['Enterprise Code', 'month'])['Amount Including Tax'].sum().reset_index()
monthly = pd.merge(monthly_sales, monthly_purchases, on=['Enterprise Code', 'month'], how='outer').fillna(0)
monthly['monthly_profit'] = monthly['Amount Including Tax_x'] - monthly['Amount Including Tax_y']

# Compute coefficient of variation (std/mean) per enterprise
cv = monthly.groupby('Enterprise Code')['monthly_profit'].apply(lambda x: x.std() / x.mean() if x.mean() != 0 else np.nan).reset_index()
cv.rename(columns={'monthly_profit': 'profit_cv'}, inplace=True)

metrics = pd.merge(metrics, cv, on='Enterprise Code', how='left')
metrics['profit_stability'] = 1 / (1 + metrics['profit_cv'].fillna(0))  # invert CV, higher stability when CV low

# Upstream/downstream dependency: concentration of suppliers/buyers
# Using Herfindahl–Hirschman Index (HHI) maybe too complex; we can use proportion of top supplier/buyer
# For simplicity, use inverse of unique counts: dependency = 1 / unique_count (higher dependency when fewer partners)
metrics['supplier_dependency'] = 1 / metrics['unique_suppliers'].replace(0, np.nan)
metrics['buyer_dependency'] = 1 / metrics['unique_buyers'].replace(0, np.nan)
# Normalize dependency metrics later

print(metrics.head())
print("Metrics shape:", metrics.shape)

# Save to CSV for further analysis
metrics.to_csv('enterprise_metrics.csv', index=False)
print("Saved enterprise_metrics.csv")

conn.close()
