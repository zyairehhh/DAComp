Action: CreateFile(filepath='data_cleaning.py':
'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

# Connect to the database
conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome", conn)
conn.close()

# Clean New Car Price column (remove "yuan" and commas, convert to float)
def clean_price(price_str):
    if pd.isna(price_str):
        return np.nan
    # Remove "yuan" and commas
    price_str = str(price_str).replace('yuan', '').replace(',', '').strip()
    try:
        return float(price_str)
    except:
        return np.nan

# Clean Mileage column (extract number from "X.XX ten thousand km")
def clean_mileage(mileage_str):
    if pd.isna(mileage_str):
        return np.nan
    # Extract numeric part
    match = re.search(r'(\d+\.?\d*)', str(mileage_str))
    if match:
        # Convert "ten thousand km" to actual km (multiply by 10,000)
        return float(match.group(1)) * 10000
    return np.nan

# Extract car brand from Title
def extract_brand(title):
    if pd.isna(title):
        return "Unknown"
    title_str = str(title)
    # Common brands to check
    brands = ['Audi', 'BMW', 'Mercedes', 'Porsche', 'Tesla', 'Volkswagen', 
              'Toyota', 'Honda', 'Ford', 'Chevrolet', 'BYD', 'NIO', 'XPeng',
              'ORA', 'Li Auto', 'Geely', 'Volvo', 'Lexus', 'Hyundai', 'Kia']
    for brand in brands:
        if brand.lower() in title_str.lower():
            return brand
    # If no match, take first word
    return title_str.split()[0] if title_str.split() else "Unknown"

# Apply cleaning
df['New_Car_Price_Cleaned'] = df['New Car Price (incl. tax)'].apply(clean_price)
df['Mileage_Cleaned'] = df['Mileage'].apply(clean_mileage)
df['Brand'] = df['Title'].apply(extract_brand)

# Calculate depreciation (percentage)
df['Depreciation_Rate'] = (1 - df['Price'] / df['New_Car_Price_Cleaned']) * 100

# Clean Registration Date
df['Registration_Date'] = pd.to_datetime(df['Registration Date'], errors='coerce')

# Calculate car age in years (as of 2024)
df['Car_Age'] = (pd.Timestamp('2024-01-01') - df['Registration_Date']).dt.days / 365.25

# Create a summary
print(f"Total records: {len(df)}")
print(f"Average Price: {df['Price'].mean():.2f}")
print(f"Average New Car Price: {df['New_Car_Price_Cleaned'].mean():.2f}")
print(f"Average Depreciation Rate: {df['Depreciation_Rate'].mean():.2f}%")
print(f"Average Mileage (km): {df['Mileage_Cleaned'].mean():.2f}")
print(f"Average Car Age: {df['Car_Age'].mean():.2f} years")

# Top brands by count
brand_counts = df['Brand'].value_counts()
print(f"\nTop 10 brands by count:")
print(brand_counts.head(10))

# Save cleaned data for visualization
df.to_csv('cleaned_data.csv', index=False)
print("\nCleaned data saved to cleaned_data.csv")
''')
