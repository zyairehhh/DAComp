import pandas as pd
import numpy as np
from datetime import datetime

# Load data
df = pd.read_csv('visitor_segment_raw.csv')
df['first_event_on'] = pd.to_datetime(df['first_event_on'])
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
max_date = df['last_event_on'].max()
print(f"Max last_event_on: {max_date}")

# Define segment
df['single_feature_use'] = df['distinct_features'] < 5
segment_single = df[df['single_feature_use']]
segment_normal = df[~df['single_feature_use']]

# Compute days between first and last event (active duration)
df['active_duration_days'] = (df['last_event_on'] - df['first_event_on']).dt.days

# Compute recency: days since last event relative to max_date
df['days_since_last_event'] = (max_date - df['last_event_on']).dt.days

# Retention: proportion of users with last_event within last 30 days
cutoff_30 = 30
retention_30_single = (segment_single['days_since_last_event'] <= cutoff_30).mean()
retention_30_normal = (segment_normal['days_since_last_event'] <= cutoff_30).mean()
print(f"30-day retention (last event within 30 days of max date):")
print(f"Single-feature-use: {retention_30_single:.2%}")
print(f"Normal: {retention_30_normal:.2%}")
print(f"Difference (single - normal): {retention_30_single - retention_30_normal:.2%}")

# Active duration comparison
print(f"\\nActive duration (days):")
print(f"Single-feature-use mean: {segment_single['active_duration_days'].mean():.1f}")
print(f"Normal mean: {segment_normal['active_duration_days'].mean():.1f}")

# Check if single-feature-use users have higher proportion of low active_duration_days
print("\\nDistribution of active duration (days) groups:")
segment_single['duration_group'] = pd.cut(segment_single['active_duration_days'], bins=[0,30,60,90,120,150,180,1000], right=False)
segment_normal['duration_group'] = pd.cut(segment_normal['active_duration_days'], bins=[0,30,60,90,120,150,180,1000], right=False)
print("Single-feature-use:")
print(segment_single['duration_group'].value_counts().sort_index())
print("\\nNormal:")
print(segment_normal['duration_group'].value_counts().sort_index())

# Also compute median distinct features per segment
print(f"\\nMedian distinct features single: {segment_single['distinct_features'].median()}")
print(f"Median distinct features normal: {segment_normal['distinct_features'].median()}")
''')
