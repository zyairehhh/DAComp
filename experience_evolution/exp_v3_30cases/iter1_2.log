```
import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

conn = sqlite3.connect('dacomp-098.sqlite')

# Get conversations with parsed tags and responder_type
conversations_query = '''
SELECT 
    ce.conversation_id,
    ce.conversation_created_at AS initiated_at,
    ce.first_contact_author_id AS contact_id,
    ce.conversation_initiated_type,
    ce.all_conversation_tags,
    cm.first_admin_response_at AS first_response_at,
    cm.time_to_first_response_minutes,
    ce.conversation_author_type,
    ce.conversation_subject,
    ce.conversation_rating,
    ce.conversation_remark
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
    ON ce.conversation_id = cm.conversation_id
WHERE ce.all_conversation_tags IS NOT NULL 
    AND ce.all_conversation_tags != ''
'''
df = pd.read_sql_query(conversations_query, conn)
print(f"Total conversations with tags: {len(df)}")

# Parse tags
def parse_tag(tag_string, key):
    if pd.isna(tag_string):
        return None
    parts = tag_string.split('|')
    for part in parts:
        if ':' in part:
            k, v = part.split(':', 1)
            if k == key:
                return v
    return None

df['path'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'path'))
df['intent'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'intent'))
df['topic'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'topic'))
df['stage'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'stage'))
df['segment'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'segment'))
df['region'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'region'))
df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: parse_tag(x, 'lifecycle'))

# Determine responder_type (bot_first vs human_first)
df['responder_type'] = df['path']  # path already has bot_first/human_first
# But some may be missing path? check
print(df['path'].value_counts(dropna=False))

# Convert timestamps
df['initiated_at'] = pd.to_datetime(df['initiated_at'])
df['first_response_at'] = pd.to_datetime(df['first_response_at'])

# Compute time to first response in days
df['time_to_first_response_days'] = df['time_to_first_response_minutes'] / (60 * 24)
mask = df['time_to_first_response_minutes'].isna() & df['first_response_at'].notna()
df.loc[mask, 'time_to_first_response_days'] = (df.loc[mask, 'first_response_at'] - df.loc[mask, 'initiated_at']).dt.total_seconds() / (3600 * 24)

print(df[['conversation_id', 'contact_id', 'responder_type', 'stage', 'initiated_at', 'time_to_first_response_days']].head())

# Now, for each contact, sort conversations by initiated_at to infer funnel stage timeline
# We'll assume each contact can have multiple conversations; we need to map stage to timestamps.
# But each conversation has a single stage tag indicating the stage of that conversation.
# The funnel stages: demo_booked, trial_started, trial_activated, closed_won (payment).
# Also there are other stages like contacted, marketing_qualified, proposal_sent, expansion_in_flight, closed_lost.
# We'll treat each contact's progression as the earliest timestamp for each stage.
# Let's pivot per contact.
df_contact = df[['contact_id', 'stage', 'initiated_at', 'responder_type', 'intent', 'topic', 'segment', 'region', 'lifecycle']].copy()
df_contact = df_contact.sort_values(['contact_id', 'initiated_at'])

# Identify first responder type for each contact (first conversation)
first_convo = df_contact.groupby('contact_id').first().reset_index()
first_convo = first_convo[['contact_id', 'responder_type', 'initiated_at']].rename(columns={'initiated_at': 'first_convo_at'})
print("First conversation per contact sample:", first_convo.head())

# For each stage, get earliest timestamp per contact
# Use pivot
pivot = df_contact.pivot_table(index='contact_id', columns='stage', values='initiated_at', aggfunc='min')
print("Stage columns:", pivot.columns.tolist())

# Let's compute conversion rates based on existence of timestamps.
# For each contact, we can determine if they have demo_booked, trial_activated, closed_won.
# We'll also need to ensure sequence: demo_booked before trial_activated before closed_won.
# Let's create a function to compute funnel for each contact.
def compute_funnel(row):
    demo = row.get('demo_booked')
    trial_start = row.get('trial_started')
    trial_activate = row.get('trial_activated')
    closed_won = row.get('closed_won')
    # Determine if funnel progress valid
    has_demo = pd.notna(demo)
    has_trial = pd.notna(trial_activate) or pd.notna(trial_start)
    has_paid = pd.notna(closed_won)
    # We'll also compute times between stages if both exist
    return pd.Series({
        'has_demo': has_demo,
        'has_trial_activated': pd.notna(trial_activate),
        'has_trial_started': pd.notna(trial_start),
        'has_paid': has_paid,
        'demo_at': demo,
        'trial_activated_at': trial_activate,
        'trial_started_at': trial_start,
        'paid_at': closed_won
    })

pivot_reset = pivot.reset_index()
funnel = pivot_reset.apply(compute_funnel, axis=1)
funnel['contact_id'] = pivot_reset['contact_id']
print(funnel.head())

# Merge with first responder type
funnel = funnel.merge(first_convo, on='contact_id', how='left')

print(funnel[['contact_id', 'responder_type', 'has_demo', 'has_trial_activated', 'has_paid']].head())

# Count contacts per responder_type
print("\nContacts by responder_type:")
print(funnel['responder_type'].value_counts())

# Compute conversion rates
bot = funnel[funnel['responder_type'] == 'bot_first']
human = funnel[funnel['responder_type'] == 'human_first']

print("\n--- Conversion Rates ---")
print("Bot-first contacts:", len(bot))
print("Human-first contacts:", len(human))

def rate(series):
    return series.sum() / len(series) * 100 if len(series) > 0 else 0

print("\nDemo booked rate (conversation -> demo):")
print(f"Bot: {rate(bot['has_demo']):.2f}% ({bot['has_demo'].sum()} / {len(bot)})")
print(f"Human: {rate(human['has_demo']):.2f}% ({human['has_demo'].sum()} / {len(human)})")

print("\nTrial activation rate (demo -> trial_activated):")
# Only consider contacts with demo_booked
bot_with_demo = bot[bot['has_demo']]
human_with_demo = human[human['has_demo']]
print(f"Bot: {rate(bot_with_demo['has_trial_activated']):.2f}% ({bot_with_demo['has_trial_activated'].sum()} / {len(bot_with_demo)})")
print(f"Human: {rate(human_with_demo['has_trial_activated']):.2f}% ({human_with_demo['has_trial_activated'].sum()} / {len(human_with_demo)})")

print("\nPaid conversion rate (trial_activated -> paid):")
bot_with_trial = bot[bot['has_trial_activated']]
human_with_trial = human[human['has_trial_activated']]
print(f"Bot: {rate(bot_with_trial['has_paid']):.2f}% ({bot_with_trial['has_paid'].sum()} / {len(bot_with_trial)})")
print(f"Human: {rate(human_with_trial['has_paid']):.2f}% ({human_with_trial['has_paid'].sum()} / {len(human_with_trial)})")

# Compute stage durations
# For each contact with both timestamps, compute days difference.
def compute_duration(start, end):
    if pd.isna(start) or pd.isna(end):
        return None
    return (end - start).days

# Need timestamps from pivot
# We'll add to funnel
funnel['demo_to_trial_days'] = funnel.apply(lambda r: compute_duration(r['demo_at'], r['trial_activated_at']), axis=1)
funnel['trial_to_paid_days'] = funnel.apply(lambda r: compute_duration(r['trial_activated_at'], r['paid_at']), axis=1)
# Also need first response to demo? Actually stage duration definition: average time interval between first response and booking (demo).
# We have first_response_at per conversation, but need per contact first response (maybe first conversation's first response). We'll approximate.
# Let's compute for each contact the first response timestamp from the earliest conversation.
# We'll need first_response_at per conversation, then aggregate.
# Let's compute per contact earliest first_response_at.
df_first_response = df[['contact_id', 'first_response_at']].dropna().sort_values('first_response_at')
first_response = df_first_response.groupby('contact_id')['first_response_at'].min().reset_index()
first_response.rename(columns={'first_response_at': 'first_response_at_contact'}, inplace=True)
funnel = funnel.merge(first_response, on='contact_id', how='left')

# Compute first response to demo duration
funnel['first_response_to_demo_days'] = funnel.apply(lambda r: compute_duration(r['first_response_at_contact'], r['demo_at']), axis=1)

print("\n--- Stage Durations (days) ---")
print("First response to demo (mean):")
print(f"Bot: {funnel[funnel['responder_type']=='bot_first']['first_response_to_demo_days'].mean():.2f}")
print(f"Human: {funnel[funnel['responder_type']=='human_first']['first_response_to_demo_days'].mean():.2f}")

print("\nDemo to trial activation (mean):")
print(f"Bot: {funnel[funnel['responder_type']=='bot_first']['demo_to_trial_days'].mean():.2f}")
print(f"Human: {funnel[funnel['responder_type']=='human_first']['demo_to_trial_days'].mean():.2f}")

print("\nTrial activation to paid (mean):")
print(f"Bot: {funnel[funnel['responder_type']=='bot_first']['trial_to_paid_days'].mean():.2f}")
print(f"Human: {funnel[funnel['responder_type']=='human_first']['trial_to_paid_days'].mean():.2f}")

# Now incorporate conversation content features (intent, topic, segment, region, lifecycle) to explain differences.
# Let's compute conversion rates by intent for bot vs human.
intent_df = df_contact.merge(funnel[['contact_id', 'responder_type', 'has_demo', 'has_trial_activated', 'has_paid']], on='contact_id', how='left')
print("\n--- Intent Analysis ---")
for intent_val in intent_df['intent'].dropna().unique():
    subset = intent_df[intent_df['intent'] == intent_val]
    if len(subset) == 0:
        continue
    bot_sub = subset[subset['responder_type'] == 'bot_first']
    human_sub = subset[subset['responder_type'] == 'human_first']
    if len(bot_sub) == 0 or len(human_sub) == 0:
        continue
    demo_rate_bot = rate(bot_sub['has_demo'])
    demo_rate_human = rate(human_sub['has_demo'])
    print(f"Intent: {intent_val}")
    print(f"  Bot-first: demo rate {demo_rate_bot:.1f}% (n={len(bot_sub)})")
    print(f"  Human-first: demo rate {demo_rate_human:.1f}% (n={len(human_sub)})")

# Save funnel data for further analysis
funnel.to_csv('funnel_data.csv', index=False)
print("\nFunnel data saved.")

conn.close()
```
