'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-079.sqlite')

# 1. Get segment data
query = """
WITH visitor_features AS (
    SELECT 
        v.visitor_id,
        v.count_active_days,
        v.latest_nps_rating,
        v.average_daily_minutes,
        v.count_active_months,
        COUNT(DISTINCT vf.feature_id) as distinct_features
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf ON v.visitor_id = vf.visitor_id
    GROUP BY v.visitor_id, v.count_active_days, v.latest_nps_rating, 
             v.average_daily_minutes, v.count_active_months
)
SELECT 
    *,
    CASE 
        WHEN count_active_days > 60 AND distinct_features < 5 THEN 'Single-Feature Users'
        WHEN count_active_days > 60 AND distinct_features >= 5 THEN 'Normal Active Users'
        ELSE 'Other Users'
    END as user_segment
FROM visitor_features
WHERE count_active_days > 60  # Focus on active users only
"""

df = pd.read_sql_query(query, conn)

# 2. Get top features for single-feature users
feature_query = """
SELECT 
    f.feature_name,
    f.product_area_name,
    COUNT(DISTINCT vf.visitor_id) as user_count,
    AVG(vf.sum_clicks) as avg_clicks,
    AVG(vf.sum_minutes) as avg_minutes
FROM pendo__visitor_feature vf
JOIN pendo__feature f ON vf.feature_id = f.feature_id
WHERE vf.visitor_id IN (
    SELECT v.visitor_id
    FROM pendo__visitor v
    LEFT JOIN pendo__visitor_feature vf2 ON v.visitor_id = vf2.visitor_id
    GROUP BY v.visitor_id
    HAVING v.count_active_days > 60 AND COUNT(DISTINCT vf2.feature_id) < 5
)
GROUP BY f.feature_id, f.feature_name, f.product_area_name
ORDER BY user_count DESC
LIMIT 15
"""

features_df = pd.read_sql_query(feature_query, conn)

conn.close()

# Set style
plt.style.use('default')

# Plot 1: NPS Comparison
fig, axes = plt.subplots(2, 2, figsize=(14, 10))

# Filter for relevant segments
segments_to_plot = df[df['user_segment'].isin(['Single-Feature Users', 'Normal Active Users'])]

# NPS box plot
segment_data = [segments_to_plot[segments_to_plot['user_segment'] == 'Single-Feature Users']['latest_nps_rating'],
                segments_to_plot[segments_to_plot['user_segment'] == 'Normal Active Users']['latest_nps_rating']]

bp = axes[0, 0].boxplot(segment_data, labels=['Single-Feature Users', 'Normal Active Users'], patch_artist=True)
bp['boxes'][0].set_facecolor('lightcoral')
bp['boxes'][1].set_facecolor('lightblue')
axes[0, 0].set_title('NPS Rating Comparison', fontsize=14, fontweight='bold')
axes[0, 0].set_ylabel('NPS Rating', fontsize=12)
axes[0, 0].grid(True, alpha=0.3)

# Add mean values
means = [segments_to_plot[segments_to_plot['user_segment'] == 'Single-Feature Users']['latest_nps_rating'].mean(),
         segments_to_plot[segments_to_plot['user_segment'] == 'Normal Active Users']['latest_nps_rating'].mean()]

for i, mean in enumerate(means):
    axes[0, 0].text(i+1, mean+0.1, f'{mean:.1f}', ha='center', va='bottom', fontweight='bold')

# Plot 2: Average Daily Minutes Comparison
segment_data_mins = [segments_to_plot[segments_to_plot['user_segment'] == 'Single-Feature Users']['average_daily_minutes'],
                     segments_to_plot[segments_to_plot['user_segment'] == 'Normal Active Users']['average_daily_minutes']]

bp2 = axes[0, 1].boxplot(segment_data_mins, labels=['Single-Feature Users', 'Normal Active Users'], patch_artist=True)
bp2['boxes'][0].set_facecolor('lightcoral')
bp2['boxes'][1].set_facecolor('lightblue')
axes[0, 1].set_title('Average Daily Minutes', fontsize=14, fontweight='bold')
axes[0, 1].set_ylabel('Minutes per Day', fontsize=12)
axes[0, 1].set_yscale('log')  # Use log scale due to large difference
axes[0, 1].grid(True, alpha=0.3)

# Add mean values
means_mins = [segments_to_plot[segments_to_plot['user_segment'] == 'Single-Feature Users']['average_daily_minutes'].mean(),
              segments_to_plot[segments_to_plot['user_segment'] == 'Normal Active Users']['average_daily_minutes'].mean()]

for i, mean in enumerate(means_mins):
