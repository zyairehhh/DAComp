import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import matplotlib

# Use default English fonts
matplotlib.rcParams.update({'font.size': 10})

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# 1. Get ad group data and compute metrics
print("Loading ad group data...")
ad_group_query = """
SELECT 
    campaign_name,
    ad_group_name,
    SUM(clicks) as clicks,
    SUM(impressions) as impressions,
    SUM(conversions) as conversions
FROM google_ads__ad_group_report
GROUP BY campaign_name, ad_group_name
HAVING impressions > 0 AND clicks > 0
"""
df = pd.read_sql_query(ad_group_query, conn)

# Calculate metrics
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
df['Conversions_per_Impression'] = df['conversions'] / df['impressions']

# Replace infinite values with NaN
df.replace([np.inf, -np.inf], np.nan, inplace=True)
df.dropna(subset=['CTR', 'CVR'], inplace=True)

print(f"Total ad groups with valid CTR/CVR: {len(df)}")

# 2. Calculate percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)

print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# 3. Identify problematic groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
non_problematic = df[~((df['CTR'] > ctr_75) & (df['CVR'] < cvr_25))].copy()

print(f"Problematic ad groups: {len(problematic)}")
print(f"Non-problematic ad groups: {len(non_problematic)}")

# 4. Calculate campaign-level expected CVR for Intent-Match Ratio
campaign_avg_cvr = df.groupby('campaign_name')['CVR'].mean().reset_index()
campaign_avg_cvr.rename(columns={'CVR': 'expected_cvr'}, inplace=True)

problematic = problematic.merge(campaign_avg_cvr, on='campaign_name', how='left')
problematic['Intent_Match_Ratio'] = problematic['CVR'] / problematic['expected_cvr']

# Cap Intent_Match_Ratio for visualization
problematic['Intent_Match_Ratio_capped'] = problematic['Intent_Match_Ratio'].clip(upper=2.0)

# 5. Get keyword match type data for problematic groups
print("Loading keyword data for problematic groups...")
keyword_query = """
SELECT 
    k.ad_group_name,
    k.keyword_match_type,
    COUNT(*) as keyword_count
FROM google_ads__keyword_report k
WHERE k.ad_group_name IN ({})
GROUP BY k.ad_group_name, k.keyword_match_type
""".format(','.join(['?' for _ in range(len(problematic))]))

problematic_ad_groups = problematic['ad_group_name'].tolist()
keyword_df = pd.read_sql_query(keyword_query, conn, params=problematic_ad_groups)

# 6. Generate visualizations
print("Generating visualizations...")
```
