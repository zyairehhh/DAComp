import sqlite3
import pandas as pd
import numpy as np

db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-061/stage1_env/dacomp-061.sqlite"
conn = sqlite3.connect(db_path)

# Get project metrics
df_proj = pd.read_sql_query("""
SELECT project_name, avg_close_time_days
FROM jira__project_enhanced
""", conn)

# Get issue metrics per project
df_issues = pd.read_sql_query("""
SELECT project_name,
       AVG(regression_ratio) AS avg_regression_ratio,
       AVG(lifecycle_quality_score) AS avg_lifecycle_quality,
       AVG(lifecycle_deviation_ratio) AS avg_lifecycle_deviation,
       AVG(total_risk_score) AS avg_total_risk,
       AVG(completion_probability) AS avg_completion_probability,
       COUNT(*) AS issue_count
FROM jira__issue_intelligence_analytics
GROUP BY project_name
""", conn)

# Merge
df = pd.merge(df_proj, df_issues, on='project_name', how='inner')

# Compute correlations
correlations = df[['avg_close_time_days', 'avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation', 'avg_total_risk', 'avg_completion_probability']].corr()
print("Correlation matrix (Pearson):")
print(correlations)

# Focus on correlation with avg_close_time_days
close_corr = correlations.loc['avg_close_time_days']
print("\nCorrelation with avg_close_time_days:")
for col, val in close_corr.items():
    print(f"{col}: {val:.4f}")

# Also compute Spearman correlation (rank)
spearman = df[['avg_close_time_days', 'avg_regression_ratio', 'avg_lifecycle_quality', 'avg_lifecycle_deviation', 'avg_total_risk']].corr(method='spearman')
print("\nSpearman correlation with avg_close_time_days:")
for col in spearman.columns:
    if col != 'avg_close_time_days':
        print(f"{col}: {spearman.loc['avg_close_time_days', col]:.4f}")

conn.close()
```
