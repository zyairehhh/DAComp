import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

# Connect to database
conn = sqlite3.connect('dacomp-100.sqlite')

# Load company data
companies = pd.read_sql_query("SELECT * FROM intercom__company_enhanced", conn)

# Parse tags
def parse_tags(tag_str):
    if not isinstance(tag_str, str):
        return {}
    parts = tag_str.split('|')
    tags = {}
    for part in parts:
        if '=' in part:
            key, value = part.split('=', 1)
            tags[key] = value
    return tags

# Apply parsing
company_tags = companies['all_company_tags'].apply(parse_tags)
# Extract key fields
def get_tag(tags, key):
    return tags.get(key, None)

companies['segment'] = company_tags.apply(lambda x: get_tag(x, 'segment'))
companies['industry'] = company_tags.apply(lambda x: get_tag(x, 'industry'))
companies['contract_tier'] = company_tags.apply(lambda x: get_tag(x, 'contract_tier'))
companies['contract_size'] = company_tags.apply(lambda x: get_tag(x, 'contract_size'))
companies['acv_usd'] = company_tags.apply(lambda x: get_tag(x, 'acv_usd'))
companies['renewal_date'] = pd.to_datetime(company_tags.apply(lambda x: get_tag(x, 'renewal_date')))
companies['renewal_window'] = company_tags.apply(lambda x: get_tag(x, 'renewal_window'))
companies['feature_adoption'] = company_tags.apply(lambda x: get_tag(x, 'feature_adoption'))
companies['sentiment_trend'] = company_tags.apply(lambda x: get_tag(x, 'sentiment_trend'))
companies['communication_cadence'] = company_tags.apply(lambda x: get_tag(x, 'communication_cadence'))
companies['success_manager'] = company_tags.apply(lambda x: get_tag(x, 'success_manager'))
companies['playbook'] = company_tags.apply(lambda x: get_tag(x, 'playbook'))
companies['education_focus'] = company_tags.apply(lambda x: get_tag(x, 'education_focus'))
companies['last_value_milestone'] = company_tags.apply(lambda x: get_tag(x, 'last_value_milestone'))
companies['health_score'] = company_tags.apply(lambda x: pd.to_numeric(get_tag(x, 'health_score'), errors='coerce'))
companies['expansion_signal'] = company_tags.apply(lambda x: get_tag(x, 'expansion_signal'))
companies['pricing_pressure'] = company_tags.apply(lambda x: get_tag(x, 'pricing_pressure'))
companies['renewal_history'] = company_tags.apply(lambda x: get_tag(x, 'renewal_history'))

print("Renewal history sample:")
print(companies['renewal_history'].head(20))
print("\nUnique renewal_history values:")
print(companies['renewal_history'].dropna().unique()[:30])

# Determine churn label: we need to define based on some rule.
# Since we lack explicit churn flag, we can use renewal_window 'within_30_days_past' as possibly churned.
# However some of those could have renewed but still within past 30 days? Might be ambiguous.
# Let's examine health_score distribution by renewal_window.
print("\nHealth score stats by renewal_window:")
print(companies.groupby('renewal_window')['health_score'].describe())

# We can also compute feature adoption numeric.
# feature_adoption string like "High (94%)" - extract percentage.
import re
def extract_percentage(s):
    if not isinstance(s, str):
        return np.nan
    match = re.search(r'(\d+)%', s)
    if match:
        return float(match.group(1))
    return np.nan

companies['feature_adoption_pct'] = companies['feature_adoption'].apply(extract_percentage)
print("\nFeature adoption percentage stats:")
print(companies['feature_adoption_pct'].describe())

# Also last_value_milestone date? It's a string. We'll compute time since last value milestone.
# Need to parse date from milestone string? The column is like "Data Warehouse Sync Completed".
# No date provided. So we cannot compute time since last value milestone.
# However we have conversation data that may contain milestone events? Not in this dataset.
# The task says: "time since last value milestone (current date - date of most recent milestone achievement)."
# But we don't have milestone dates. Might be missing. We'll need to assume we have that data? Maybe it's in conversation tags.
# Let's examine conversation tags for milestone.
conv_enhanced = pd.read_sql_query("SELECT * FROM intercom__conversation_enhanced", conn)
conv_tags = conv_enhanced['all_conversation_tags'].apply(parse_tags)
conv_enhanced['topic'] = conv_tags.apply(lambda x: x.get('topic', None))
print("\nUnique conversation topics:", conv_enhanced['topic'].dropna().unique()[:20])

# Maybe there is milestone data in company_metrics? Check company_metrics table.
company_metrics = pd.read_sql_query("SELECT * FROM intercom__company_metrics", conn)
print("\nCompany metrics columns:", company_metrics.columns.tolist())

# Let's join with conversations to compute features per company.
