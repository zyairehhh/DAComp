companies['last_value_milestone'] = company_tags.apply(lambda x: get_tag(x, 'last_value_milestone'))
companies['health_score'] = company_tags.apply(lambda x: get_tag(x, 'health_score'))
companies['expansion_signal'] = company_tags.apply(lambda x: get_tag(x, 'expansion_signal'))
companies['pricing_pressure'] = company_tags.apply(lambda x: get_tag(x, 'pricing_pressure'))
companies['renewal_history'] = company_tags.apply(lambda x: get_tag(x, 'renewal_history'))

