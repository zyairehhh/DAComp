import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib import font_manager

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
# We'll use default English fonts

# Connect to database
conn = sqlite3.connect('dacomp-013.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Data cleaning as per Stage1
# Convert numeric columns, replacing "-" with NaN
num_cols = ['Planned Work Hours', 'Actual Work Hours', 'Completion Quality Score', 'Task Difficulty Coefficient', 'Rework Count']
for col in num_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Parse dates
date_cols = ['Planned Start Date', 'Planned Deadline', 'Actual Start Date', 'Actual Completion Time']
for col in date_cols:
    df[col] = pd.to_datetime(df[col], errors='coerce')

# Add binary completion flag
df['is_completed'] = df['Task Status'] == 'Completed'

# Priority weight mapping
priority_weight = {'Urgent': 4, 'High': 3, 'Medium': 2, 'Low': 1}
df['priority_weight'] = df['Priority'].map(priority_weight)

# Derived metrics for completed tasks only
completed = df[df['is_completed']].copy()

# Lateness days
completed['lateness_days'] = (completed['Actual Completion Time'] - completed['Planned Deadline']).dt.days
completed['on_time'] = completed['lateness_days'] <= 0

# Efficiency = planned/actual, capped at 2
completed['efficiency'] = completed['Planned Work Hours'] / completed['Actual Work Hours']
completed['efficiency'] = completed['efficiency'].clip(upper=2)
# Only keep where actual work hours > 0
completed.loc[completed['Actual Work Hours'] <= 0, 'efficiency'] = np.nan

# Normalization per task type per owner
task_types = completed['Task Type'].unique()
normalized_metrics = {}

# For each metric to normalize: quality, efficiency, rework
# Compute mean and std per task type
for metric in ['Completion Quality Score', 'efficiency', 'Rework Count']:
    type_stats = {}
    for t in task_types:
        vals = completed.loc[completed['Task Type'] == t, metric]
        type_stats[t] = {'mean': vals.mean(), 'std': vals.std()}
    # Z-score
    z_col = f'{metric}_z'
    completed[z_col] = np.nan
    for t in task_types:
        mask = completed['Task Type'] == t
        mean = type_stats[t]['mean']
        std = type_stats[t]['std'] if type_stats[t]['std'] > 0 else 1
        completed.loc[mask, z_col] = (completed.loc[mask, metric] - mean) / std
    # For rework, invert so lower rework = higher score
    if metric == 'Rework Count':
        completed[z_col] = -completed[z_col]  # invert
    # Fill missing with 0 (neutral)
    completed[z_col] = completed[z_col].fillna(0)
    normalized_metrics[metric] = z_col

# Aggregation per owner (filter owners with at least 3 tasks)
owner_task_counts = completed['Task Owner'].value_counts()
eligible_owners = owner_task_counts[owner_task_counts >= 3].index
completed_eligible = completed[completed['Task Owner'].isin(eligible_owners)]

# Group by owner
owner_stats = completed_eligible.groupby('Task Owner').agg({
    'priority_weight': lambda x: (x[completed_eligible.loc[x.index, 'is_completed']].sum() / x.sum()) if x.sum() > 0 else 0,
    'Completion Quality Score_z': 'mean',
    'on_time': 'mean',
    'efficiency_z': 'mean',
    'Rework Count_z': 'mean',
    'Task Difficulty Coefficient': 'mean',
    'Task Type': lambda x: x.mode()[0] if not x.empty else None
}).reset_index()
owner_stats.columns = ['Task Owner', 'weighted_completion_rate', 'avg_quality_z', 'on_time_rate', 'avg_efficiency_z', 'avg_rework_z', 'avg_difficulty', 'primary_type']

# Composite score (average of five dimensions)
owner_stats['composite_score'] = owner_stats[['weighted_completion_rate', 'avg_quality_z', 'on_time_rate', 'avg_efficiency_z', 'avg_rework_z']].mean(axis=1)

# Performance level assignment
n_owners = len(owner_stats)
rank = owner_stats['composite_score'].rank(method='first', ascending=False)
owner_stats['rank'] = rank
owner_stats['pct_rank'] = rank / n_owners

# Determine performance level
def assign_level(pct):
    if pct <= 0.2:
        return 'Excellent'
    elif pct <= 0.9:
        return 'Good'
    else:
        return 'Needs Improvement'

owner_stats['performance_level'] = owner_stats['pct_rank'].apply(assign_level)

# Save aggregated data for later use
owner_stats.to_csv('owner_performance.csv', index=False)
completed.to_csv('completed_tasks_processed.csv', index=False)

print(f"Evaluated {n_owners} owners with at least 3 tasks.")
print(owner_stats['performance_level'].value_counts(normalize=True).round(3))
```
