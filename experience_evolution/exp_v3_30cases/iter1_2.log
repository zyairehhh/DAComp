import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import re
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query('SELECT * FROM sheet1 WHERE "Education Requirement" LIKE "%Vocational%";', conn)
conn.close()

# Function to extract numeric salary values from string
def parse_salary(salary_str):
    if pd.isna(salary_str):
        return None, None
    # Remove commas
    s = str(salary_str).replace(',', '')
    # Find all numbers
    numbers = re.findall(r'\d+\.?\d*', s)
    # Convert to int
    nums = [float(num) for num in numbers]
    if len(nums) >= 2:
        # Assume first two numbers are min and max
        return nums[0], nums[1]
    elif len(nums) == 1:
        return nums[0], nums[0]
    else:
        return None, None

# Apply parsing
salary_parsed = df['Salary Range'].apply(parse_salary)
df['salary_min'] = salary_parsed.apply(lambda x: x[0] if x else np.nan)
df['salary_max'] = salary_parsed.apply(lambda x: x[1] if x else np.nan)
# Compute midpoint as proxy for starting salary
df['salary_mid'] = (df['salary_min'] + df['salary_max']) / 2

# Drop rows with missing salary
df_salary = df.dropna(subset=['salary_min', 'salary_max']).copy()

# Define experience category
def has_experience_requirement(exp):
    if pd.isna(exp):
        return 'unknown'
    exp_str = str(exp).lower()
    if 'no limit' in exp_str or '不限' in exp_str:
        return 'no limit'
    elif 'year' in exp_str or '经验' in exp_str:
        return 'required'
    else:
        return 'other'

df_salary['exp_category'] = df_salary['Work Experience Requirement'].apply(has_experience_requirement)

# 1. Starting salary distribution histogram
plt.figure(figsize=(10, 6))
plt.hist(df_salary['salary_mid'], bins=30, edgecolor='black', alpha=0.7)
plt.title('Distribution of Starting Salaries (Midpoint) for Vocational School Graduates')
plt.xlabel('Salary (yuan/month)')
plt.ylabel('Frequency')
plt.grid(axis='y', alpha=0.75)
plt.tight_layout()
plt.savefig('salary_distribution.png', dpi=300)
plt.close()

# 2. Benefits distribution: count occurrences of each benefit type
benefits_col = 'Benefits'
def split_benefits(benefit_str):
    if pd.isna(benefit_str):
        return []
    # Split by commas, semicolons, Chinese punctuation
    separators = r'[,;、，；]'
    parts = re.split(separators, str(benefit_str))
    # Strip whitespace and filter empty
    parts = [p.strip() for p in parts if p.strip()]
    return parts

all_benefits = []
for b in df[benefits_col]:
    all_benefits.extend(split_benefits(b))

# Count frequencies
from collections import Counter
benefit_counts = Counter(all_benefits)
# Get top 20 benefits
top_benefits = benefit_counts.most_common(20)
top_names = [b[0] for b in top_benefits]
top_counts = [b[1] for b in top_benefits]

plt.figure(figsize=(12, 8))
bars = plt.barh(range(len(top_names)), top_counts, align='center')
plt.yticks(range(len(top_names)), top_names, fontsize=10)
plt.title('Top 20 Benefits for Vocational School Graduates')
plt.xlabel('Count')
plt.gca().invert_yaxis()  # highest count on top
plt.grid(axis='x', alpha=0.75)
plt.tight_layout()
plt.savefig('benefits_distribution.png', dpi=300)
plt.close()

# 3. Qualities that increase starting salaries: analyze correlations
# Group by experience category and compute average salary midpoint
exp_avg = df_salary.groupby('exp_category')['salary_mid'].mean().sort_values(ascending=False)
# Plot
plt.figure(figsize=(8, 6))
exp_avg.plot(kind='bar', color='skyblue', edgecolor='black')
plt.title('Average Starting Salary by Work Experience Requirement')
plt.xlabel('Work Experience Category')
plt.ylabel('Average Salary (yuan/month)')
plt.xticks(rotation=45)
plt.grid(axis='y', alpha=0.75)
plt.tight_layout()
plt.savefig('salary_by_experience.png', dpi=300)
plt.close()

# Also consider industry or company type for another plot
# Let's see counts of industries
industry_counts = df_salary['Industry'].value_counts().head(10)
plt.figure(figsize=(10, 6))
industry_counts.plot(kind='bar', color='lightgreen', edgecolor='black')
plt.title('Top 10 Industries Hiring Vocational School Graduates')
plt.xlabel('Industry')
plt.ylabel('Number of Job Listings')
plt.xticks(rotation=45, ha='right')
plt.grid(axis='y', alpha=0.75)
plt.tight_layout()
plt.savefig('industry_counts.png', dpi=300)
plt.close()

# Write a simple summary
with open('summary.txt', 'w') as f:
    f.write(f'Total vocational school jobs: {len(df)}\n')
    f.write(f'Jobs with salary info: {len(df_salary)}\n')
    f.write(f'Average salary midpoint: {df_salary["salary_mid"].mean():.2f} yuan/month\n')
    f.write(f'Top benefit: {top_names[0]} (count: {top_counts[0]})\n')
    f.write(f'Average salary by experience:\n')
    for cat, avg in exp_avg.items():
        f.write(f'  {cat}: {avg:.2f}\n')
    f.write(f'\nTop industries:\n')
    for idx, (ind, cnt) in enumerate(industry_counts.items()):
        f.write(f'  {ind}: {cnt}\n')

print("Plots saved: salary_distribution.png, benefits_distribution.png, salary_by_experience.png, industry_counts.png")
```
