'''
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('campaign_decay_risk.csv')
df['decay_risk'] = df['combined_decay_risk']
# create dummy variables for categorical
df = pd.get_dummies(df, columns=['advertising_channel_type','campaign_lifecycle_stage','account_maturity_stage','customer_maturity_stage'], drop_first=True)
# select predictors
exclude = ['account_id','strategic_customer_segment','cac_growth_recent','ratio_decline_recent','slope_cac_pct','slope_ratio_pct','avg_cac','avg_ltv_cac_ratio','recent_decay_risk','trend_decay_risk','combined_decay_risk','decay_risk']
if 'active_last_30' in df.columns:
    exclude.append('active_last_30')
predictors = [col for col in df.columns if col not in exclude]
X = df[predictors]
X = X.select_dtypes(include=[np.number])  # keep only numeric
# drop columns with missing values
X = X.dropna(axis=1)
# add constant
X = sm.add_constant(X)
y = df['decay_risk']
# logistic regression
model = sm.Logit(y, X).fit(disp=False)
print(model.summary())
# Compute odds ratios
odds = pd.DataFrame(np.exp(model.params), columns=['OR'])
odds['p'] = model.pvalues
print("\nOdds ratios (OR >1 indicates increased risk):")
print(odds.sort_values('OR', ascending=False).head(10))
''')
