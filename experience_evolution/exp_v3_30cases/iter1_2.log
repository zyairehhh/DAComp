import pandas as pd
import sqlite3
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('dacomp-060.sqlite')
df = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)
conn.close()

# Compute CTR and CVR (conversions per click)
df['CTR'] = df['clicks'] / df['impressions']
df['CVR'] = df['conversions'] / df['clicks']
# Handle divisions by zero or NaN
df['CTR'] = df['CTR'].replace([np.inf, -np.inf], np.nan)
df['CVR'] = df['CVR'].replace([np.inf, -np.inf], np.nan)

# Compute percentiles across all ad groups
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)
print(f"CTR 75th percentile: {ctr_75:.4f}")
print(f"CVR 25th percentile: {cvr_25:.4f}")

# Filter problematic ad groups: CTR > 75th percentile AND CVR < 25th percentile
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
print(f"Number of problematic ad groups: {len(problematic)}")

# Compute Intent Match Ratio: Actual CVR / Expected CVR (expected CVR maybe overall average CVR)
overall_avg_cvr = df['CVR'].mean()
problematic['Intent_Match_Ratio'] = problematic['CVR'] / overall_avg_cvr

# Save problematic ad groups to CSV for reference
problematic.to_csv('/workspace/problematic_ad_groups.csv', index=False)

# Visualizations
plt.style.use('default')

# 1. Scatter plot of CTR vs CVR with thresholds
fig, ax = plt.subplots(figsize=(10, 6))
ax.scatter(df['CTR'], df['CVR'], alpha=0.6, s=20, label='All ad groups')
ax.scatter(problematic['CTR'], problematic['CVR'], color='red', s=30, label='Problematic (high CTR, low CVR)')
# Draw threshold lines
ax.axvline(x=ctr_75, color='orange', linestyle='--', label=f'CTR 75th percentile ({ctr_75:.3f})')
ax.axhline(y=cvr_25, color='green', linestyle='--', label=f'CVR 25th percentile ({cvr_25:.3f})')
ax.set_xlabel('CTR')
ax.set_ylabel('CVR')
ax.set_title('Ad Group Performance: CTR vs CVR')
ax.legend()
ax.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('/workspace/scatter_ctr_cvr.png', dpi=300)
plt.close()

# 2. Distribution of CTR and CVR (histograms)
fig, axes = plt.subplots(1, 2, figsize=(12, 5))
axes[0].hist(df['CTR'].dropna(), bins=50, edgecolor='black', alpha=0.7)
axes[0].axvline(ctr_75, color='orange', linestyle='--', label='75th percentile')
axes[0].set_xlabel('CTR')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Distribution of CTR')
axes[0].legend()
axes[0].grid(True, linestyle='--', alpha=0.5)

axes[1].hist(df['CVR'].dropna(), bins=50, edgecolor='black', alpha=0.7)
axes[1].axvline(cvr_25, color='green', linestyle='--', label='25th percentile')
axes[1].set_xlabel('CVR')
axes[1].set_ylabel('Frequency')
axes[1].set_title('Distribution of CVR')
axes[1].legend()
axes[1].grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('/workspace/histograms_ctr_cvr.png', dpi=300)
plt.close()

# 3. Bar chart: Top 10 problematic ad groups by spend
if len(problematic) > 0:
    top10 = problematic.nlargest(10, 'spend')[['ad_group_name', 'spend', 'CTR', 'CVR', 'Intent_Match_Ratio']]
    fig, ax = plt.subplots(figsize=(12, 6))
    x = np.arange(len(top10))
    width = 0.35
    bars1 = ax.bar(x - width/2, top10['spend'], width, label='Spend', color='skyblue')
    ax2 = ax.twinx()
    bars2 = ax2.bar(x + width/2, top10['Intent_Match_Ratio'], width, label='Intent Match Ratio', color='coral')
    ax.set_xlabel('Ad Group')
    ax.set_ylabel('Spend')
    ax2.set_ylabel('Intent Match Ratio')
    ax.set_title('Top 10 Problematic Ad Groups by Spend and Intent Match Ratio')
    ax.set_xticks(x)
    ax.set_xticklabels(top10['ad_group_name'], rotation=45, ha='right')
    # Add legend
    lines1, labels1 = ax.get_legend_handles_labels()
    lines2, labels2 = ax2.get_legend_handles_labels()
    ax.legend(lines1 + lines2, labels1 + labels2, loc='upper left')
    plt.tight_layout()
    plt.savefig('/workspace/top10_problematic_spend.png', dpi=300)
    plt.close()
else:
    print("No problematic ad groups found.")

# 4. Boxplot of traffic quality metrics for problematic vs non-problematic
df['category'] = 'Non-problematic'
df.loc[problematic.index, 'category'] = 'Problematic'
# Use clicks per impression (CTR) and conversions per click (CVR) for boxplot
fig, axes = plt.subplots(1, 2, figsize=(12, 5))
for idx, metric in enumerate(['CTR', 'CVR']):
    axes[idx].boxplot([df[df['category']=='Non-problematic'][metric].dropna(),
                       df[df['category']=='Problematic'][metric].dropna()],
                      labels=['Non-problematic', 'Problematic'])
    axes[idx].set_title(f'Distribution of {metric}')
    axes[idx].set_ylabel(metric)
    axes[idx].grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('/workspace/boxplot_ctr_cvr_by_category.png', dpi=300)
plt.close()

print("Visualizations saved.")
```
