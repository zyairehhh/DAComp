Let's compute per department risk distribution with all four levels.

Action: CreateFile(filepath='risk_distribution.sql':
'''
SELECT 
    u.Department,
    a."Risk Level",
    COUNT(*) as count,
    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY u.Department), 2) as pct
FROM abnormal_logins_table a
JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
JOIN user_information_table u ON l."User ID" = u."User ID"
GROUP BY u.Department, a."Risk Level"
ORDER BY 
    CASE a."Risk Level" 
        WHEN 'Severe' THEN 1 
        WHEN 'High' THEN 2 
        WHEN 'Medium' THEN 3 
        WHEN 'Low' THEN 4 
    END,
    u.Department;
''')
