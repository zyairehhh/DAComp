Action: CreateFile(filepath='health_score_expansion.py':
'''
import sqlite3
import pandas as pd
import re

conn = sqlite3.connect('dacomp-100.sqlite')
companies = pd.read_sql_query("SELECT all_company_tags FROM intercom__company_enhanced", conn)

def extract(tag_str, key):
    match = re.search(rf'{key}=([^|]+)', tag_str)
    return match.group(1) if match else None

companies['expansion_signal'] = companies['all_company_tags'].apply(lambda x: extract(x, 'expansion_signal'))
companies['health_score'] = companies['all_company_tags'].apply(lambda x: extract(x, 'health_score')).astype(float)
