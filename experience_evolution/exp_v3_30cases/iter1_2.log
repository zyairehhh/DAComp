import sqlite3
import pandas as pd

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-066/stage1_env/dacomp-066.sqlite')

# Extract role category from name (everything before " - ")
query = """
SELECT substr(name, 1, instr(name, ' - ') - 1) as role_category,
       created_year,
       created_month,
       AVG(application_to_interview_rate) as avg_conversion_rate,
       COUNT(*) as job_count
FROM greenhouse__job_enhanced
WHERE departments='Engineering'
GROUP BY role_category, created_year, created_month
ORDER BY role_category, created_year, created_month;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Compute overall average per role
global_avg = df.groupby('role_category')['avg_conversion_rate'].agg(['mean', 'count']).sort_values('mean')
print("Overall average conversion rate by role:")
print(global_avg.to_string())

# Compute change over time: first 3 months vs last 3 months
df['time_period'] = df.apply(lambda row: 'first' if row['created_month'] in [7,8,9] else 'last', axis=1)
period_avg = df.groupby(['role_category', 'time_period'])['avg_conversion_rate'].mean().unstack()
period_avg['change'] = period_avg['last'] - period_avg['first']
period_avg['pct_change'] = (period_avg['change'] / period_avg['first']) * 100
period_avg = period_avg.sort_values('change')
print("\nConversion rate change (first 3 months vs last 3 months) by role:")
print(period_avg[['first', 'last', 'change', 'pct_change']].round(2).to_string())
''')
