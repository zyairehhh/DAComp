import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect("dacomp-066.sqlite")

# Join tables
query = """
SELECT 
    p.job_id,
    p.job_title,
    p.application_year,
    p.application_quarter,
    p.interview_rate,
    e.departments,
    e.hiring_managers
FROM greenhouse__recruitment_performance p
JOIN greenhouse__job_enhanced e ON p.job_id = e.job_id
WHERE e.departments = 'Engineering'
"""
df = pd.read_sql_query(query, conn)

# Define role categories based on job_title keywords
def categorize_role(title):
    title_low = title.lower()
    if 'frontend' in title_low:
        return 'Frontend'
    elif 'backend' in title_low:
        return 'Backend'
    elif 'data engineer' in title_low:
        return 'Data Engineer'
    elif 'full stack' in title_low:
        return 'Full Stack'
    elif 'devops' in title_low:
        return 'DevOps'
    elif 'machine learning' in title_low or 'ml' in title_low:
        return 'Machine Learning'
    elif 'qa' in title_low or 'quality assurance' in title_low:
        return 'QA'
    elif 'mobile' in title_low:
