                  segments_to_plot[segments_to_plot['user_segment'] == 'Normal Active Users']['count_active_months']]

bp3 = axes[1, 1].boxplot(retention_data, labels=['Single-Feature Users', 'Normal Active Users'], patch_artist=True)
bp3['boxes'][0].set_facecolor('lightcoral')
bp3['boxes'][1].set_facecolor('lightblue')
