import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-071.sqlite')

# Load stage history
df_history = pd.read_sql_query("""
    SELECT opportunity_id, stage, days_in_stage, valid_from, valid_ending_at
    FROM lever__opportunity_stage_history
    WHERE days_in_stage IS NOT NULL
""", conn)

print(f"Stage history rows: {len(df_history)}")
print(df_history.head())

# For each stage, compute average days_in_stage (avg_days)
stage_avg_days = df_history.groupby('stage')['days_in_stage'].mean().reset_index()
stage_avg_days.columns = ['stage', 'avg_days']

# Compute attrition rate and pass rate:
# Approach: Determine flow between stages per candidate.
# For each opportunity, order stages by valid_from.
# Determine if candidate moved to next stage or exited (maybe if final stage is archived?)
# However simpler: attrition rate per stage = proportion of entries that are last stage for that candidate?
# We need to know which stage is the final stage before candidate is archived/rejected/hired.
# Use the enhanced table to get current_stage or archive_reason? Might be complex.

# Let's first get unique opportunities and their stage sequences.
# We'll compute transitions: for each opportunity, sort by valid_from, then determine next stage.
# If next stage is NULL (i.e., no further stage), then candidate exited at that stage.
# However there may be multiple stages per opportunity, but we only have stage history entries per stage change.

# We'll create a DataFrame with ordered stages per opportunity
df_history['valid_from'] = pd.to_datetime(df_history['valid_from'])
df_history = df_history.sort_values(['opportunity_id', 'valid_from'])

# Determine next stage within each opportunity
df_history['next_stage'] = df_history.groupby('opportunity_id')['stage'].shift(-1)
df_history['is_last'] = df_history['next_stage'].isna()

# For each stage, count total entries and last entries.
stage_stats = df_history.groupby('stage').agg(
    total_entries=('stage', 'size'),
    last_entries=('is_last', 'sum')
).reset_index()

stage_stats['pass_rate'] = (1 - stage_stats['last_entries'] / stage_stats['total_entries']) * 100  # percentage
stage_stats['attrition_rate'] = (stage_stats['last_entries'] / stage_stats['total_entries']) * 100

# Merge with avg days
stage_metrics = pd.merge(stage_stats, stage_avg_days, on='stage', how='left')
stage_metrics['efficiency_index'] = stage_metrics['pass_rate'] / stage_metrics['avg_days'] * 100  # because pass_rate is percentage

print("Stage metrics:")
print(stage_metrics)

# Filter stages with at least 100 samples
stage_metrics_filtered = stage_metrics[stage_metrics['total_entries'] >= 100].copy()
print("Stages with >= 100 samples:")
print(stage_metrics_filtered)

# Identify bottleneck stages: avg_days > 25 and attrition_rate > 40%
bottleneck = stage_metrics_filtered[
    (stage_metrics_filtered['avg_days'] > 25) &
    (stage_metrics_filtered['attrition_rate'] > 40)
]
print("Bottleneck stages (avg_days >25 & attrition >40%):")
print(bottleneck)

# Identify low efficiency stages: efficiency_index < 1.5
low_efficiency = stage_metrics_filtered[stage_metrics_filtered['efficiency_index'] < 1.5]
print("Low efficiency stages (efficiency_index < 1.5):")
print(low_efficiency)

# Save metrics CSV for reference
stage_metrics_filtered.to_csv('stage_metrics.csv', index=False)

# Visualizations
# 1. Bar chart: Average days per stage (top N stages)
plt.figure(figsize=(10,6))
stage_metrics_sorted = stage_metrics_filtered.sort_values('avg_days', ascending=False)
plt.bar(stage_metrics_sorted['stage'], stage_metrics_sorted['avg_days'])
plt.title('Average Days Spent per Stage (>=100 samples)')
plt.xlabel('Stage')
plt.ylabel('Average Days')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('avg_days_per_stage.png')
plt.close()

# 2. Bar chart: Attrition Rate per stage
plt.figure(figsize=(10,6))
stage_metrics_filtered = stage_metrics_filtered.sort_values('attrition_rate', ascending=False)
plt.bar(stage_metrics_filtered['stage'], stage_metrics_filtered['attrition_rate'])
plt.title('Attrition Rate per Stage (>=100 samples)')
plt.xlabel('Stage')
plt.ylabel('Attrition Rate (%)')
plt.axhline(y=40, color='r', linestyle='--', label='40% threshold')
plt.xticks(rotation=45, ha='right')
plt.legend()
plt.tight_layout()
plt.savefig('attrition_rate_per_stage.png')
plt.close()

# 3. Scatter plot: Avg Days vs Attrition Rate, color by efficiency index
plt.figure(figsize=(10,6))
scatter = plt.scatter(stage_metrics_filtered['avg_days'],
                      stage_metrics_filtered['attrition_rate'],
                      c=stage_metrics_filtered['efficiency_index'],
                      s=100, alpha=0.7, cmap='viridis')
plt.colorbar(scatter, label='Efficiency Index')
plt.xlabel('Average Days in Stage')
plt.ylabel('Attrition Rate (%)')
plt.title('Stage Efficiency: Avg Days vs Attrition Rate (size >=100)')
# Add threshold lines
plt.axvline(x=25, color='gray', linestyle='--', alpha=0.5)
plt.axhline(y=40, color='gray', linestyle='--', alpha=0.5)
# Annotate points
for idx, row in stage_metrics_filtered.iterrows():
    plt.annotate(row['stage'], (row['avg_days'], row['attrition_rate']), fontsize=8, alpha=0.8)
plt.tight_layout()
plt.savefig('scatter_avgdays_vs_attrition.png')
plt.close()

# 4. Bar chart: Efficiency Index per stage
plt.figure(figsize=(10,6))
stage_metrics_filtered = stage_metrics_filtered.sort_values('efficiency_index', ascending=True)
plt.bar(stage_metrics_filtered['stage'], stage_metrics_filtered['efficiency_index'])
plt.title('Efficiency Index per Stage (>=100 samples)')
plt.xlabel('Stage')
plt.ylabel('Efficiency Index (pass_rate/avg_days*100)')
plt.axhline(y=1.5, color='r', linestyle='--', label='Threshold 1.5')
plt.xticks(rotation=45, ha='right')
plt.legend()
plt.tight_layout()
plt.savefig('efficiency_index_per_stage.png')
plt.close()

print("Visualizations saved.")

conn.close()
```
