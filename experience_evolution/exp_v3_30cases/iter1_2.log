import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

conn = sqlite3.connect('./dacomp-058.sqlite')

# Load geo report
df_geo = pd.read_sql_query("SELECT * FROM google_ads__geo_report", conn)

# Compute ROI (conversion_value / cost)
df_geo['roi'] = df_geo['conversion_value'] / df_geo['cost']

# Compute health score components (same weights as before)
roi_min = df_geo['roi'].min()
roi_max = df_geo['roi'].max()
df_geo['cost_efficiency_score'] = ((df_geo['roi'] - roi_min) / (roi_max - roi_min)) * 100

conv_min = df_geo['conversion_rate'].min()
conv_max = df_geo['conversion_rate'].max()
df_geo['conv_quality_score'] = ((df_geo['conversion_rate'] - conv_min) / (conv_max - conv_min)) * 100

imp_min = df_geo['impression_share'].min()
imp_max = df_geo['impression_share'].max()
qual_min = df_geo['quality_score'].min()
qual_max = df_geo['quality_score'].max()
ctr_min = df_geo['ctr'].min()
ctr_max = df_geo['ctr'].max()

df_geo['imp_norm'] = ((df_geo['impression_share'] - imp_min) / (imp_max - imp_min)) * 100
df_geo['qual_norm'] = ((df_geo['quality_score'] - qual_min) / (qual_max - qual_min)) * 100
df_geo['ctr_norm'] = ((df_geo['ctr'] - ctr_min) / (ctr_max - ctr_min)) * 100
df_geo['competitiveness_score'] = df_geo['imp_norm']*0.4 + df_geo['qual_norm']*0.4 + df_geo['ctr_norm']*0.2

df_geo['health_score'] = df_geo['cost_efficiency_score']*0.4 + df_geo['conv_quality_score']*0.35 + df_geo['competitiveness_score']*0.25

# Aggregate by geo_target (top 10 by cost)
geo_summary = df_geo.groupby('geo_target').agg({'health_score':'mean', 'cost':'sum', 'roi':'mean'}).reset_index()
geo_summary = geo_summary.sort_values('cost', ascending=False).head(10)

plt.figure(figsize=(12,6))
plt.bar(geo_summary['geo_target'], geo_summary['health_score'], color='teal')
plt.xlabel('Geo Target (Top 10 by Cost)')
plt.ylabel('Average Health Score')
plt.title('Average Health Score by Geo Target (Top 10 Cost)')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('./health_by_geo_top10.png', dpi=300)
plt.close()

# Scatter plot cost vs ROI for top 20 geo targets
geo_summary_all = df_geo.groupby('geo_target').agg({'health_score':'mean', 'cost':'sum', 'roi':'mean'}).reset_index()
geo_summary_all = geo_summary_all.sort_values('cost', ascending=False).head(20)

plt.figure(figsize=(10,6))
plt.scatter(geo_summary_all['cost'], geo_summary_all['roi'], c=geo_summary_all['health_score'], cmap='RdYlGn', s=100, alpha=0.7)
plt.xlabel('Total Cost')
plt.ylabel('Average ROI')
plt.title('Cost vs ROI for Top 20 Geo Targets (Color = Health Score)')
plt.colorbar(label='Health Score')
plt.grid(True)
plt.tight_layout()
plt.savefig('./cost_vs_roi_geo.png', dpi=300)
plt.close()

print("Geo plots saved.")
conn.close()
```
