import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
matplotlib.use('Agg')
import numpy as np

conn = sqlite3.connect('dacomp-093.sqlite')
df = pd.read_sql_query("SELECT * FROM klaviyo__campaigns", conn)
conn.close()

# Parse scheduled_to_send_at to datetime
df['scheduled_to_send_at'] = pd.to_datetime(df['scheduled_to_send_at'])
# Extract day of week (0 Monday, 6 Sunday)
df['weekday'] = df['scheduled_to_send_at'].dt.dayofweek
df['is_weekend'] = df['weekday'].isin([5,6])
# Extract hour
df['hour'] = df['scheduled_to_send_at'].dt.hour
def time_window(h):
    if 5 <= h < 12:
        return 'morning'
    elif 12 <= h < 17:
        return 'afternoon'
    elif 17 <= h < 22:
        return 'evening'
    else:
        return 'night'
df['time_of_day'] = df['hour'].apply(time_window)

# Simple keyword extraction from SUBJECT (assuming Chinese subjects)
def keyword_group(subject):
    subject_lower = subject.lower()
    if '折扣' in subject_lower or '折券' in subject_lower:
        return 'discount'
    elif '新品' in subject_lower or '上新' in subject_lower or '首发' in subject_lower:
        return 'new'
    elif '品牌' in subject_lower or '故事' in subject_lower or '灵感' in subject_lower:
        return 'storytelling'
    else:
        return 'other'
df['subject_group'] = df['SUBJECT'].apply(keyword_group)

print(df[['campaign_id','scheduled_to_send_at','weekday','hour','time_of_day','SUBJECT','subject_group']].head())

# Visualization 1: Open rate by time_of_day and is_weekend
plt.figure(figsize=(10,6))
df.boxplot(column='email_open_rate', by=['time_of_day','is_weekend'], grid=False)
plt.title('Open Rate by Time of Day and Weekend/Weekday')
plt.suptitle('')
plt.xlabel('Time of Day (Weekend=False/True)')
plt.ylabel('Open Rate')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('open_rate_by_time.png')
plt.close()

# Visualization 2: Click-to-open rate by subject_group and variation_id
grouped = df.groupby(['subject_group','variation_id'])['email_click_to_open_rate'].mean().unstack()
grouped.plot(kind='bar', figsize=(8,5))
plt.title('Average Click-to-Open Rate by Subject Group and Variation')
plt.xlabel('Subject Group')
plt.ylabel('Mean Click-to-Open Rate')
plt.legend(title='Variation')
plt.tight_layout()
plt.savefig('click_to_open_by_subject.png')
plt.close()

# Visualization 3: Active retention by is_archived and variation_id
# Need to join with persons table? Actually active_retention_rate_week/month are in persons table.
# Let's compute average active_retention_rate_week per campaign? Might need aggregation.
# Since persons table has per person retention rates, we could compute campaign-level average.
# But we can use active_days as proxy? Not exactly.
# Let's load persons and compute average retention per campaign.
conn = sqlite3.connect('dacomp-093.sqlite')
persons = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
conn.close()
# persons have count_received_email? Not directly. Probably need to join via campaign-person mapping? Not in schema.
# However we have campaign aggregates: active_days, active_retention_rate_week/month are in persons table per person.
# Could average across persons for each campaign? No direct link.
# Instead, we can use active_days from campaigns as approximate.
plt.figure(figsize=(8,5))
df.boxplot(column='active_days', by=['is_archived','variation_id'], grid=False)
plt.title('Active Days by Archived Status and Variation')
plt.suptitle('')
plt.xlabel('Archived (False/True) and Variation')
plt.ylabel('Active Days')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('active_days_by_archived_variation.png')
plt.close()

# Visualization 4: Scatter open rate vs audience size
plt.figure(figsize=(8,6))
colors = df['is_archived'].map({False:'blue',True:'orange'})
plt.scatter(df['total_count_unique_people'], df['email_open_rate'], c=colors, alpha=0.5)
plt.xlabel('Audience Size (total_count_unique_people)')
plt.ylabel('Open Rate')
plt.title('Open Rate vs Audience Size (Blue=Not Archived, Orange=Archived)')
plt.grid(True)
plt.tight_layout()
plt.savefig('open_rate_vs_audience.png')
plt.close()

print("Visualizations saved.")
