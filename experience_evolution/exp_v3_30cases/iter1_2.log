import sqlite3
import pandas as pd
import numpy as np

db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter1/dacomp-008/stage1_env/dacomp-008.sqlite"
conn = sqlite3.connect(db_path)
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Compute cost deviation
df['Cost_Deviation'] = df['Budget Amount'] - df['Actual Cost']
df['Cost_Overrun'] = df['Actual Cost'] - df['Budget Amount']  # positive means over budget

# 1. Overall distribution
print("=== OVERALL COST DEVIATION ===")
print(df['Cost_Deviation'].describe())
print()
print(f"Projects under budget (positive deviation): {sum(df['Cost_Deviation'] > 0)}")
print(f"Projects over budget (negative deviation): {sum(df['Cost_Deviation'] < 0)}")
print(f"Projects exactly on budget: {sum(df['Cost_Deviation'] == 0)}")
print()

# 2. By Project Type
print("=== BY PROJECT TYPE ===")
type_group = df.groupby('Project Type')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max', 'median'])
print(type_group)
print()

# 3. By Risk Level
print("=== BY RISK LEVEL ===")
risk_group = df.groupby('Risk Level')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max', 'median'])
print(risk_group)
print()

# 4. By Priority
print("=== BY PRIORITY ===")
priority_group = df.groupby('Priority')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max', 'median'])
print(priority_group)
print()

# 5. By Project Status
print("=== BY PROJECT STATUS ===")
status_group = df.groupby('Project Status')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max', 'median'])
print(status_group)
print()

# 6. Correlation with Team Size and Customer Satisfaction
print("=== CORRELATION WITH NUMERIC FACTORS ===")
corr_matrix = df[['Cost_Deviation', 'Team Size', 'Customer Satisfaction']].corr()
print(corr_matrix)
print()

# 7. Interaction between Project Type and Risk Level
print("=== INTERACTION: PROJECT TYPE & RISK LEVEL ===")
interaction = df.groupby(['Project Type', 'Risk Level'])['Cost_Deviation'].agg(['count', 'mean', 'std']).reset_index()
print(interaction)
print()

# 8. Impact of Team Size: bin team size into categories
df['Team Size Category'] = pd.cut(df['Team Size'], bins=[0, 10, 20, 30, 40, 100], labels=['<=10', '11-20', '21-30', '31-40', '>40'])
print("=== BY TEAM SIZE CATEGORY ===")
team_group = df.groupby('Team Size Category')['Cost_Deviation'].agg(['count', 'mean', 'std', 'min', 'max'])
print(team_group)
print()

# 9. Examine Completion Percentage (string? convert to numeric)
df['Completion_Percent'] = df['Completion Percentage'].str.rstrip('%').astype(float) / 100
print("=== CORRELATION WITH COMPLETION PERCENTAGE ===")
corr_completion = df[['Cost_Deviation', 'Completion_Percent']].corr()
print(corr_completion)
print()

# 10. Top 10 cost overrun projects
overrun = df[df['Cost_Deviation'] < 0].sort_values('Cost_Overrun', ascending=False).head(10)
print("=== TOP 10 COST OVERRUN PROJECTS (MOST OVER BUDGET) ===")
print(overrun[['Project Name', 'Project Type', 'Risk Level', 'Team Size', 'Budget Amount', 'Actual Cost', 'Cost_Overrun']])
print()

# 11. Top 10 under budget projects (largest positive deviation)
under = df[df['Cost_Deviation'] > 0].sort_values('Cost_Deviation', ascending=False).head(10)
print("=== TOP 10 UNDER BUDGET PROJECTS (MOST UNDER BUDGET) ===")
print(under[['Project Name', 'Project Type', 'Risk Level', 'Team Size', 'Budget Amount', 'Actual Cost', 'Cost_Deviation']])
```
