import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v3_30cases_iter2/dacomp-008/stage1_env/dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Compute deviation
df['Deviation'] = df['Budget Amount'] - df['Actual Cost']
# Convert Completion Percentage to numeric, strip %
df['Completion Percentage'] = df['Completion Percentage'].str.rstrip('%').astype(float)

# 1. Deviation distribution by Project Type and Risk Level
print("=== Deviation by Project Type & Risk Level ===")
cross = df.groupby(['Project Type', 'Risk Level'])['Deviation'].agg(['count', 'mean', 'median', 'std'])
print(cross)
print()

# 2. Team Size vs Deviation across types
print("=== Team Size vs Deviation Correlation by Project Type ===")
for ptype in df['Project Type'].unique():
    sub = df[df['Project Type'] == ptype]
    corr = sub['Team Size'].corr(sub['Deviation'])
    print(f"{ptype}: correlation = {corr:.4f}")
print()

# 3. Customer Satisfaction vs Deviation across risk levels
print("=== Customer Satisfaction vs Deviation by Risk Level ===")
for risk in df['Risk Level'].unique():
    sub = df[df['Risk Level'] == risk]
    corr = sub['Customer Satisfaction'].corr(sub['Deviation'])
    print(f"{risk}: correlation = {corr:.4f} (mean satisfaction {sub['Customer Satisfaction'].mean():.2f})")
print()

# 4. Impact of Project Status on Deviation
print("=== Project Status vs Deviation (with Priority) ===")
status_priority = df.groupby(['Project Status', 'Priority'])['Deviation'].agg(['count', 'mean', 'median'])
print(status_priority)
print()

# 5. Over-budget projects analysis
over = df[df['Deviation'] < 0]
print(f"Over-budget projects: {len(over)}")
print("Over-budget by Project Type:")
print(over['Project Type'].value_counts())
print("Over-budget by Risk Level:")
print(over['Risk Level'].value_counts())
print("Average Customer Satisfaction for over-budget vs under-budget:")
over_sat = over['Customer Satisfaction'].mean()
under_sat = df[df['Deviation'] >= 0]['Customer Satisfaction'].mean()
print(f"Over-budget avg satisfaction: {over_sat:.2f}")
print(f"Under-budget avg satisfaction: {under_sat:.2f}")
print()

# 6. Relationship between Budget Amount and Deviation
print("=== Budget Amount vs Deviation ===")
budget_bins = pd.qcut(df['Budget Amount'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
df['Budget Quartile'] = budget_bins
budget_group = df.groupby('Budget Quartile')['Deviation'].agg(['count', 'mean', 'median', 'std'])
print(budget_group)
print()

# 7. Completion Percentage analysis
print("=== Completion Percentage vs Deviation ===")
try:
    df['Completion Quartile'] = pd.qcut(df['Completion Percentage'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'], duplicates='drop')
    completion_group = df.groupby('Completion Quartile')['Deviation'].agg(['count', 'mean', 'median', 'std'])
    print(completion_group)
except Exception as e:
    print(f"Cannot quartile due to unique bin edge issue: {e}")
    # Use custom bins
    df['Completion Group'] = pd.cut(df['Completion Percentage'], bins=[0, 50, 80, 100], labels=['Low', 'Medium', 'High'])
    completion_group = df.groupby('Completion Group')['Deviation'].agg(['count', 'mean', 'median', 'std'])
    print(completion_group)
print()

# 8. Top 10 projects with largest positive deviation (most under budget)
top_positive = df.nlargest(10, 'Deviation')[['Project ID', 'Project Name', 'Project Type', 'Budget Amount', 'Actual Cost', 'Deviation', 'Risk Level']]
print("Top 10 projects with largest positive deviation (most under budget):")
print(top_positive.to_string(index=False))
print()

# 9. Top 10 projects with largest negative deviation (most over budget)
top_negative = df.nsmallest(10, 'Deviation')[['Project ID', 'Project Name', 'Project Type', 'Budget Amount', 'Actual Cost', 'Deviation', 'Risk Level']]
print("Top 10 projects with largest negative deviation (most over budget):")
print(top_negative.to_string(index=False))
```
