import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('./dacomp-060.sqlite')

# Aggregate ad group performance with conversions_value
query = """
SELECT
    ad_group_id,
    ad_group_name,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions,
    SUM(conversions_value) AS total_conversions_value,
    SUM(spend) AS total_spend
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name
HAVING total_impressions > 0 AND total_clicks > 0
"""
df = pd.read_sql(query, conn)
df['CTR'] = df['total_clicks'] / df['total_impressions']
df['CVR'] = df['total_conversions'] / df['total_clicks']
df['CVR'] = df['CVR'].fillna(0)
df['CPC'] = df['total_spend'] / df['total_clicks']
df['CPA'] = df['total_spend'] / df['total_conversions']
df['CPA'] = df['CPA'].replace([np.inf, -np.inf], np.nan)
df['ROAS'] = df['total_conversions_value'] / df['total_spend']
df['ROAS'] = df['ROAS'].replace([np.inf, -np.inf], np.nan)

ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
high_ctr_good = df[(df['CTR'] > ctr_75) & (df['CVR'] >= cvr_25)].copy()
rest = df[~(df['CTR'] > ctr_75) & (df['CVR'] >= cvr_25)]  # other groups

print("=== Financial Metrics Comparison ===")
print("\nProblematic ad groups (high CTR, low CVR):")
print(f"Count: {len(problematic)}")
print(f"Average CTR: {problematic['CTR'].mean():.4f}")
print(f"Average CVR: {problematic['CVR'].mean():.4f}")
print(f"Average CPC: ${problematic['CPC'].mean():.2f}")
print(f"Average CPA: ${problematic['CPA'].mean():.2f} (excluding zero conversions)")
print(f"Average ROAS: {problematic['ROAS'].mean():.2f}")
print(f"Total Spend: ${problematic['total_spend'].sum():.2f}")
print(f"Total Conversions Value: ${problematic['total_conversions_value'].sum():.2f}")
print(f"Total Conversions: {problematic['total_conversions'].sum():.0f}")

print("\nHigh-CTR good CVR ad groups:")
print(f"Count: {len(high_ctr_good)}")
print(f"Average CTR: {high_ctr_good['CTR'].mean():.4f}")
print(f"Average CVR: {high_ctr_good['CVR'].mean():.4f}")
print(f"Average CPC: ${high_ctr_good['CPC'].mean():.2f}")
print(f"Average CPA: ${high_ctr_good['CPA'].mean():.2f}")
print(f"Average ROAS: {high_ctr_good['ROAS'].mean():.2f}")
print(f"Total Spend: ${high_ctr_good['total_spend'].sum():.2f}")
print(f"Total Conversions Value: ${high_ctr_good['total_conversions_value'].sum():.2f}")
print(f"Total Conversions: {high_ctr_good['total_conversions'].sum():.0f}")

# Ad type analysis
ad_query = """
SELECT ad_group_id, ad_type,
       SUM(clicks) as clicks,
       SUM(conversions) as conversions,
       SUM(spend) as spend
FROM google_ads__ad_report
GROUP BY ad_group_id, ad_type
"""
ad_df = pd.read_sql(ad_query, conn)
ad_df['cvr'] = ad_df['conversions'] / ad_df['clicks']
ad_df['cvr'] = ad_df['cvr'].fillna(0)
ad_df['cpc'] = ad_df['spend'] / ad_df['clicks']

# Merge with problematic/high-CTR good groups
problematic_ad = ad_df[ad_df['ad_group_id'].isin(problematic['ad_group_id'])]
high_ctr_good_ad = ad_df[ad_df['ad_group_id'].isin(high_ctr_good['ad_group_id'])]

print("\n=== Ad Type Distribution for Problematic Groups ===")
if not problematic_ad.empty:
    prob_ad_type_summary = problematic_ad.groupby('ad_type').agg({'clicks': 'sum', 'conversions': 'sum', 'spend': 'sum'}).reset_index()
    prob_ad_type_summary['cvr'] = prob_ad_type_summary['conversions'] / prob_ad_type_summary['clicks']
    prob_ad_type_summary['cpc'] = prob_ad_type_summary['spend'] / prob_ad_type_summary['clicks']
    print(prob_ad_type_summary)
else:
    print("No ad data for problematic groups.")

print("\n=== Ad Type Distribution for High-CTR Good Groups ===")
if not high_ctr_good_ad.empty:
    good_ad_type_summary = high_ctr_good_ad.groupby('ad_type').agg({'clicks': 'sum', 'conversions': 'sum', 'spend': 'sum'}).reset_index()
    good_ad_type_summary['cvr'] = good_ad_type_summary['conversions'] / good_ad_type_summary['clicks']
    good_ad_type_summary['cpc'] = good_ad_type_summary['spend'] / good_ad_type_summary['clicks']
    print(good_ad_type_summary)
else:
    print("No ad data for high-CTR good groups.")

# Search term relevance: compute proportion of irrelevant search terms (maybe low CVR per term)
# Define irrelevant as CVR below a threshold (e.g., 0.01)
search_query2 = """
SELECT ad_group_id, search_term,
       SUM(clicks) as clicks, SUM(conversions) as conversions
FROM google_ads__search_term_report
GROUP BY ad_group_id, search_term
HAVING clicks > 0
"""
search_df = pd.read_sql(search_query2, conn)
search_df['cvr'] = search_df['conversions'] / search_df['clicks']
search_df['cvr'] = search_df['cvr'].fillna(0)
search_df['irrelevant'] = search_df['cvr'] < 0.01  # arbitrary threshold

# Compute irrelevant click proportion per ad group
irrelevant_prop = search_df.groupby('ad_group_id').apply(
    lambda x: (x['clicks'] * x['irrelevant']).sum() / x['clicks'].sum()
).reset_index(name='irrelevant_click_prop')

problematic_irr = problematic.merge(irrelevant_prop, on='ad_group_id', how='left')
high_ctr_good_irr = high_ctr_good.merge(irrelevant_prop, on='ad_group_id', how='left')

print("\n=== Irrelevant Click Proportion (search term CVR < 0.01) ===")
print("Problematic groups:")
print(problematic_irr['irrelevant_click_prop'].describe())
print("\nHigh-CTR good groups:")
print(high_ctr_good_irr['irrelevant_click_prop'].describe())

conn.close()
```
