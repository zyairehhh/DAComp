import pandas as pd
import numpy as np

# Load the computed margins
df = pd.read_csv('category_year_margin.csv')
print(df.head())

# Compute swing: range (max - min) of profit margin per category
swing = df.groupby('Product Category')['profit_margin'].agg(['min','max','std'])
swing['range'] = swing['max'] - swing['min']
swing = swing.sort_values('range', ascending=False)
print("\nProfit margin volatility across 2022-2024 (ordered by range):")
print(swing)

# Show the category with largest swing
largest_swing_category = swing.index[0]
print(f"\nCategory with largest swing: {largest_swing_category}")
print(df[df['Product Category'] == largest_swing_category])
```
