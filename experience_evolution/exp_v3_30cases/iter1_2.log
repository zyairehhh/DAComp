Action: CreateFile(filepath='churn_analysis.py':
'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-001.sqlite')
churn_df = pd.read_sql_query('SELECT * FROM "annual_rate_&_churn"', conn)
conn.close()
print(churn_df.head())
print(churn_df.shape)

# Melt to long format
churn_long = pd.melt(churn_df, id_vars=['Annual Loan Interest Rate'],
                    value_vars=['Credit Rating A Customer Churn Rate',
                                'Credit Rating B Customer Churn Rate',
                                'Credit Rating C Customer Churn Rate'],
                    var_name='Rating', value_name='Churn Rate')
# Clean rating column
churn_long['Rating'] = churn_long['Rating'].str.extract(r'Credit Rating (\w)')[0]
print(churn_long.head())

import matplotlib.pyplot as plt
plt.figure(figsize=(10,6))
for rating in ['A','B','C']:
    subset = churn_long[churn_long['Rating']==rating]
    plt.plot(subset['Annual Loan Interest Rate'], subset['Churn Rate'], label=f'Rating {rating}')
plt.xlabel('Annual Loan Interest Rate')
plt.ylabel('Churn Rate')
plt.title('Churn Rate vs Interest Rate by Credit Rating')
plt.legend()
plt.grid()
plt.savefig('churn_curves.png', dpi=150)
print("Saved churn_curves.png")
''')
