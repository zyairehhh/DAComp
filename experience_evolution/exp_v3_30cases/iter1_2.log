'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-008.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

df['Deviation'] = df['Budget Amount'] - df['Actual Cost']
df['Is Overbudget'] = df['Deviation'] < 0

# Count over-budget per risk level
over_by_risk = df[df['Is Overbudget']].groupby('Risk Level').size()
total_by_risk = df.groupby('Risk Level').size()
percent_over = (over_by_risk / total_by_risk * 100).fillna(0).reindex(['Low', 'Medium', 'High'])

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 6))

# Subplot 1: Counts
bars1 = ax1.bar(over_by_risk.index, over_by_risk.values, color=['green', 'orange', 'red'], edgecolor='black')
ax1.set_xlabel('Risk Level', fontsize=12)
ax1.set_ylabel('Number of Over‑Budget Projects', fontsize=12)
ax1.set_title('Over‑Budget Count by Risk Level', fontsize=14, pad=15)
ax1.grid(True, alpha=0.3, axis='y')
for bar, count in zip(bars1, over_by_risk.values):
    height = bar.get_height()
    ax1.text(bar.get_x() + bar.get_width()/2., height + 0.5,
             str(int(count)), ha='center', va='bottom', fontsize=11)

# Subplot 2: Percentage
bars2 = ax2.bar(percent_over.index, percent_over.values, color=['green', 'orange', 'red'], edgecolor='black')
ax2.set_xlabel('Risk Level', fontsize=12)
ax2.set_ylabel('% of Projects Over Budget', fontsize=12)
ax2.set_title('Over‑Budget Rate by Risk Level', fontsize=14, pad=15)
ax2.grid(True, alpha=0.3, axis='y')
for bar, pct in zip(bars2, percent_over.values):
    height = bar.get_height()
    ax2.text(bar.get_x() + bar.get_width()/2., height + 0.5,
             f'{pct:.1f}%', ha='center', va='bottom', fontsize=11)

# Add overall annotation
total_over = df['Is Overbudget'].sum()
total = len(df)
overall_pct = total_over / total * 100
fig.suptitle(f'Total Over‑Budget Projects: {total_over} / {total} ({overall_pct:.1f}%)', fontsize=16, y=1.02)

plt.tight_layout()
plt.savefig('overbudget_by_risk.png', dpi=150)
print("Saved overbudget_by_risk.png")
''')
