import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import warnings
warnings.filterwarnings('ignore')

conn = sqlite3.connect('dacomp-027.sqlite')

# Load tables
disaster_events = pd.read_sql_query("SELECT \"Disaster Event ID\", \"Disaster Type\", \"Disaster Level\" FROM disaster_events", conn)
environment_and_health = pd.read_sql_query("SELECT * FROM environment_and_health", conn)
beneficiaries = pd.read_sql_query("SELECT * FROM beneficiaries_and_assessments", conn)
distribution_hubs = pd.read_sql_query("SELECT \"Distribution Center ID\", \"Disaster Event Reference ID\", \"Distribution reference ID\" FROM distribution_hubs", conn)

# Merge environment with disaster events
df = pd.merge(disaster_events, environment_and_health, left_on="Disaster Event ID", right_on="Disaster Reference ID", how="inner")
print("Merged environment shape:", df.shape)

level_order = ["Level 1", "Level 2", "Level 3", "Level 4", "Level 5"]

# Compute composite secondary hazard score as before
cat_mapping = {
    "Environmental Impact Rate": {"Low": 1, "Medium": 2, "High": 3},
    "Waste Management Status": {"Adequate": 1, "Limited": 2, "Critical": 3},
    "Disease Risk": {"Low": 1, "Medium": 2, "High": 3},
    "Medical Emergency Response Capacity": {"Adequate": 1, "Limited": 2, "Critical": 3},
    "Mental Health Assistance": {"Available": 1, "Limited": 2}
}
df["env_impact_score"] = df["Environmental Impact Rate"].map(cat_mapping["Environmental Impact Rate"])
df["waste_score"] = df["Waste Management Status"].map(cat_mapping["Waste Management Status"])
df["disease_score"] = df["Disease Risk"].map(cat_mapping["Disease Risk"])
df["medical_score"] = df["Medical Emergency Response Capacity"].map(cat_mapping["Medical Emergency Response Capacity"])
df["mental_score"] = df["Mental Health Assistance"].map(cat_mapping["Mental Health Assistance"])

numeric_cols = ["Carbon Emissions (tons)", "Water Quality Index", "Sanitation Coverage Rate", "Vaccination Coverage Rate"]
all_scores = pd.concat([df[["env_impact_score","waste_score","disease_score","medical_score","mental_score"]], df[numeric_cols]], axis=1)
for col in numeric_cols:
    min_val = all_scores[col].min()
    max_val = all_scores[col].max()
    all_scores[col + "_norm"] = (all_scores[col] - min_val) / (max_val - min_val)
# Invert Water Quality Index
all_scores["Water Quality Index_norm"] = (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"]) / (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"].min())
# Replace the normalized column (since we already added Water Quality Index_norm)
all_scores["Water Quality Index_norm"] = (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"]) / (all_scores["Water Quality Index"].max() - all_scores["Water Quality Index"].min())

categorical_component_cols = ["env_impact_score","waste_score","disease_score","medical_score","mental_score"]
numeric_norm_cols = [col + "_norm" for col in numeric_cols if col != "Water Quality Index"] + ["Water Quality Index_norm"]
all_scores["composite"] = all_scores[categorical_component_cols + numeric_norm_cols].mean(axis=1)
all_scores["Disaster Level"] = df["Disaster Level"].values
all_scores["Disaster Type"] = df["Disaster Type"].values

# Plot 1: Secondary Hazard Score by Level
composite_by_level = all_scores.groupby("Disaster Level")["composite"].mean().reindex(level_order)
print("Secondary Hazard Score by Level:")
print(composite_by_level)
plt.figure(figsize=(8,5))
bars = plt.bar(composite_by_level.index, composite_by_level.values, color='skyblue')
plt.title('Secondary Hazard Score by Disaster Level', fontweight='bold')
plt.xlabel('Disaster Level')
plt.ylabel('Mean Composite Score (higher = worse)')
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.01, f'{height:.2f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('secondary_hazard_by_level.png', dpi=300)
plt.close()

# Plot 2: Component proportions per level
env_high = df.groupby("Disaster Level")["Environmental Impact Rate"].apply(lambda x: (x == "High").mean()).reindex(level_order) * 100
waste_critical = df.groupby("Disaster Level")["Waste Management Status"].apply(lambda x: (x == "Critical").mean()).reindex(level_order) * 100
disease_high = df.groupby("Disaster Level")["Disease Risk"].apply(lambda x: (x == "High").mean()).reindex(level_order) * 100
medical_critical = df.groupby("Disaster Level")["Medical Emergency Response Capacity"].apply(lambda x: (x == "Critical").mean()).reindex(level_order) * 100
mental_limited = df.groupby("Disaster Level")["Mental Health Assistance"].apply(lambda x: (x == "Limited").mean()).reindex(level_order) * 100

fig, ax = plt.subplots(2, 3, figsize=(15,10))
ax = ax.ravel()
data = [env_high, waste_critical, disease_high, medical_critical, mental_limited]
titles = ["High Environmental Impact", "Critical Waste Management", "High Disease Risk", "Critical Medical Capacity", "Limited Mental Health Assistance"]
colors = ['coral', 'gold', 'lightgreen', 'lightcoral', 'plum']
for i in range(5):
    ax[i].bar(data[i].index, data[i].values, color=colors[i])
    ax[i].set_title(titles[i])
    ax[i].set_xlabel('Disaster Level')
    ax[i].set_ylabel('Percentage (%)')
    ax[i].set_ylim(0, 50)
    for j, v in enumerate(data[i].values):
        ax[i].text(j, v + 0.5, f'{v:.1f}', ha='center')
ax[5].axis('off')
plt.suptitle('Key Secondary Hazard Indicators by Disaster Level', fontweight='bold')
plt.tight_layout()
plt.savefig('component_indicators_by_level.png', dpi=300)
plt.close()

# Plot 3: Numeric indicators per level
numeric_means = df.groupby("Disaster Level")[numeric_cols].mean().reindex(level_order)
fig, ax = plt.subplots(2, 2, figsize=(12,10))
ax = ax.ravel()
ax[0].bar(numeric_means.index, numeric_means['Carbon Emissions (tons)'], color='orange')
ax[0].set_title('Average Carbon Emissions (tons)')
ax[0].set_xlabel('Disaster Level')
ax[0].set_ylabel('Mean Carbon Emissions')
for i, v in enumerate(numeric_means['Carbon Emissions (tons)']):
    ax[0].text(i, v + 5, f'{v:.1f}', ha='center')
ax[1].bar(numeric_means.index, numeric_means['Water Quality Index'], color='steelblue')
ax[1].set_title('Average Water Quality Index (lower = worse)')
ax[1].set_xlabel('Disaster Level')
ax[1].set_ylabel('Mean Water Quality Index')
for i, v in enumerate(numeric_means['Water Quality Index']):
    ax[1].text(i, v + 0.5, f'{v:.1f}', ha='center')
ax[2].bar(numeric_means.index, numeric_means['Sanitation Coverage Rate'], color='green')
ax[2].set_title('Average Sanitation Coverage Rate (%)')
ax[2].set_xlabel('Disaster Level')
ax[2].set_ylabel('Mean Sanitation Coverage')
for i, v in enumerate(numeric_means['Sanitation Coverage Rate']):
    ax[2].text(i, v + 0.5, f'{v:.1f}', ha='center')
ax[3].bar(numeric_means.index, numeric_means['Vaccination Coverage Rate'], color='purple')
ax[3].set_title('Average Vaccination Coverage Rate (%)')
ax[3].set_xlabel('Disaster Level')
ax[3].set_ylabel('Mean Vaccination Coverage')
for i, v in enumerate(numeric_means['Vaccination Coverage Rate']):
    ax[3].text(i, v + 0.5, f'{v:.1f}', ha='center')
plt.suptitle('Numeric Environmental and Health Indicators by Disaster Level', fontweight='bold')
plt.tight_layout()
plt.savefig('numeric_indicators_by_level.png', dpi=300)
plt.close()

# Plot 4: Secondary Hazard Score by Disaster Type
type_order = df["Disaster Type"].unique()
composite_by_type = all_scores.groupby("Disaster Type")["composite"].mean().sort_values(ascending=False)
print("\nSecondary Hazard Score by Disaster Type:")
print(composite_by_type)
plt.figure(figsize=(8,5))
bars = plt.bar(composite_by_type.index, composite_by_type.values, color='lightseagreen')
plt.title('Secondary Hazard Score by Disaster Type', fontweight='bold')
plt.xlabel('Disaster Type')
plt.ylabel('Mean Composite Score')
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.01, f'{height:.2f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('secondary_hazard_by_type.png', dpi=300)
plt.close()

# People Impact Score computation
# Join disaster_events with beneficiaries via distribution_hubs
# distribution_hubs has columns: "Disaster Event Reference ID", "Distribution reference ID"
# beneficiaries has "Distribution reference ID"
# Let's merge
merged_dist = pd.merge(disaster_events, distribution_hubs, left_on="Disaster Event ID", right_on="Disaster Event Reference ID", how="inner")
merged_people = pd.merge(merged_dist, beneficiaries, left_on="Distribution reference ID", right_on="Distribution reference ID", how="inner")
print("\nMerged people impact data shape:", merged_people.shape)
if merged_people.shape[0] > 100:  # enough data
    # Mapping
    vuln_map = {"Complete": 3, "In Progress": 2, "Pending": 1}  # assuming Complete is best? but impact score should invert: higher = worse. So we map "Complete" as low impact (score 1), "Pending" as high impact (3).
    # Actually we need to map according to Stage1: they aggregated assessment statuses, fairness, feedback, engagement and capacity. Higher score = worse outcomes.
    # Vulnerability assessment: Complete likely means good -> low impact -> low score.
    # Let's reverse: Pending=3, In Progress=2, Complete=1 (high to low)
    vuln_map = {"Pending": 3, "In Progress": 2, "Complete": 1}
    needs_map = {"Overdue": 3, "Due": 2, "Updated": 1}
    engagement_map = {"Low": 3, "Medium": 2, "High": 1}
    capacity_map = {"Limited": 3, "Active": 1}
    merged_people["vuln_score"] = merged_people["Vulnerability assessment"].map(vuln_map)
    merged_people["needs_score"] = merged_people["Needs assessment status"].map(needs_map)
    merged_people["engagement_score"] = merged_people["Community engagement level"].map(engagement_map)
