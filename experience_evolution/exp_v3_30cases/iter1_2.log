earliest = events_df.groupby(['person_id', 'campaign_name'])['occurred_at'].min().reset_index()
earliest.rename(columns={'occurred_at': 'first_event_at'}, inplace=True)
print("earliest shape:", earliest.shape)
print(earliest)

# merge
flow_with_time = flow_with_name.merge(earliest, on=['person_id', 'campaign_name'], how='left')
print("flow_with_time columns:", flow_with_time.columns.tolist())
print("flow_with_time:")
print(flow_with_time[['person_id', 'campaign_name', 'first_event_at']])
```

