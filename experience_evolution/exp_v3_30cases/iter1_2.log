```
import pandas as pd
import numpy as np

df = pd.read_csv('renewal_features.csv')
# rename industry_y to industry
df.rename(columns={'industry_y': 'industry'}, inplace=True)

# Features list
features = ['comm_avg_convs_last30', 'avg_conversation_rating', 'prop_negative_sentiment', 'avg_resolution_time', 'prop_reopened', 'feature_adoption_pct']

# Compute differences between inside_90_days and future_90_plus
inside = df[df['renewal_window'] == 'inside_90_days']
future = df[df['renewal_window'] == 'future_90_plus']
past = df[df['renewal_window'] == 'within_30_days_past']

print("### Feature Comparison: Inside 90 Days vs Future 90+ Days ###")
for feat in features:
    diff = inside[feat].mean() - future[feat].mean()
    pooled_std = np.sqrt((inside[feat].std()**2 + future[feat].std()**2)/2)
    n1, n2 = len(inside), len(future)
    se = pooled_std * np.sqrt(1/n1 + 1/n2)
    t_stat = diff / se if se != 0 else 0
    # approximate p-value using normal
    from math import erf
    p_val = 2 * (1 - 0.5 * (1 + erf(abs(t_stat) / np.sqrt(2))))
    print(f"{feat}: Diff = {diff:.4f}, t-stat={t_stat:.3f}, p-value={p_val:.4f}")

# Compute AUC manually
def compute_auc(feat, target):
    pos = feat[target == 1].values
    neg = feat[target == 0].values
    n_pos = len(pos)
    n_neg = len(neg)
    count = 0
    for p in pos:
        count += (p > neg).sum() + (p == neg).sum() * 0.5
    auc = count / (n_pos * n_neg)
    return auc

target = (df['renewal_window'] == 'inside_90_days').astype(int)
print("\\n### AUC (binary classification) ###")
for feat in features:
    auc = compute_auc(df[feat], target)
    print(f"{feat}: AUC = {auc:.4f}")

# Segmentation by industry and contract size
print("\\n### Segmentation by Industry and Contract Size (Inside vs Future) ###")
top_industries = df['industry'].value_counts().head(5).index
for ind in top_industries:
    for size in ['small', 'mid', 'large']:
        sub = df[(df['industry'] == ind) & (df['contract_size'] == size)]
        if len(sub) > 0:
            inside_sub = sub[sub['renewal_window'] == 'inside_90_days']
            future_sub = sub[sub['renewal_window'] == 'future_90_plus']
            if len(inside_sub) > 2 and len(future_sub) > 2:
                print(f"\\nIndustry: {ind}, Contract Size: {size}")
                for feat in features:
                    diff = inside_sub[feat].mean() - future_sub[feat].mean()
                    auc = compute_auc(sub[feat], (sub['renewal_window'] == 'inside_90_days').astype(int))
                    print(f"  {feat}: Diff={diff:.3f}, AUC={auc:.3f}")
```
