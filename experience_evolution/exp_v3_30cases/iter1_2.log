'''
import pandas as pd
import numpy as np
import sqlite3

conn = sqlite3.connect('dacomp-058.sqlite')

# Load health scores from previous analysis (or recompute)
df = pd.read_csv('campaign_health_scores_full.csv')
print("Total filtered campaigns:", len(df))
print("Critical risk count:", (df['risk_level_adj'] == 'Critical').sum())

# Critical campaigns details
critical = df[df['risk_level_adj'] == 'Critical'].copy()
critical = critical.sort_values('health_score_adj')
print("\nCritical campaigns (worst health):")
print(critical[['year_month', 'campaign_id', 'campaign_name', 'campaign_type', 'bidding_strategy', 'industry', 'cost', 'roas', 'health_score_adj']].head(10))

# Diagnosis: Identify low-performing dimensions for each critical campaign
# For each campaign compute which dimension scores are low (bottom quartile)
def diagnose(row):
    issues = []
    if row['roas_norm'] < 0.25:
        issues.append('ROAS extremely low')
    if row['cpc_norm'] < 0.25:
        issues.append('Cost per conversion very high')
    if row['conv_rate_norm'] < 0.25:
        issues.append('Conversion rate very low')
    if row['qual_score_norm'] < 0.25:
        issues.append('Quality score poor')
    if row['ctr_norm'] < 0.25:
        issues.append('CTR low')
    if row['imp_share_norm'] < 0.25:
        issues.append('Impression share low')
    if pd.notna(row['avg_position']) and row['avg_pos_norm'] < 0.25:
        issues.append('Average position poor (high number)')
    return ', '.join(issues) if issues else 'Multiple moderate issues'

critical['diagnosis'] = critical.apply(diagnose, axis=1)
print("\nSample diagnoses:")
print(critical[['campaign_id', 'diagnosis']].head())

# High-cost, low-conversion risk campaigns (cost top quartile, health bottom quartile)
high_cost_thresh = df['cost'].quantile(0.75)
low_health_thresh = df['health_score_adj'].quantile(0.25)
high_cost_low_health = df[(df['cost'] > high_cost_thresh) & (df['health_score_adj'] <= low_health_thresh)]
print("\nHigh-cost, low-health campaigns (cost > {:.0f}, health <= {:.2f}): {} campaigns".format(high_cost_thresh, low_health_thresh, len(high_cost_low_health)))
print(high_cost_low_health[['campaign_id', 'campaign_name', 'cost', 'health_score_adj', 'risk_level_adj']])

# Performance across campaign_type, bidding_strategy, industry
print("\n=== Performance by Campaign Type ===")
campaign_type_stats = df.groupby('campaign_type').agg(
    campaigns=('campaign_id', 'size'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean'),
    avg_health=('health_score_adj', 'mean'),
    critical_rate=('risk_level_adj', lambda x: (x == 'Critical').sum() / len(x))
).round(2)
print(campaign_type_stats)

print("\n=== Performance by Bidding Strategy ===")
bidding_stats = df.groupby('bidding_strategy').agg(
    campaigns=('campaign_id', 'size'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean'),
    avg_health=('health_score_adj', 'mean'),
    critical_rate=('risk_level_adj', lambda x: (x == 'Critical').sum() / len(x))
).round(2)
print(bidding_stats)

print("\n=== Performance by Industry ===")
industry_stats = df.groupby('industry').agg(
    campaigns=('campaign_id', 'size'),
    avg_cost=('cost', 'mean'),
    avg_roas=('roas', 'mean'),
    avg_health=('health_score_adj', 'mean'),
    critical_rate=('risk_level_adj', lambda x: ((x == 'Critical').sum() / len(x)) if len(x)>0 else 0)
).round(2)
print(industry_stats)

# Geographic distribution
geo_query = """
SELECT gr.year_month, gr.campaign_id, gr.geo_target,
       gr.cost, gr.roas, gr.impression_share, gr.conversion_rate
FROM google_ads__geo_report gr
WHERE gr.campaign_id IN ({})
""".format(','.join(map(str, df['campaign_id'].unique())))
geo_df = pd.read_sql_query(geo_query, conn)
# Aggregate per geo
geo_agg = geo_df.groupby('geo_target').agg(
    total_cost=('cost', 'sum'),
    avg_roas=('roas', 'mean'),
    avg_imp_share=('impression_share', 'mean'),
    avg_cvr=('conversion_rate', 'mean')
).round(2).sort_values('total_cost', ascending=False)
print("\n=== Geographic Distribution (Top 10 by cost) ===")
print(geo_agg.head(10))

# Device distribution
device_query = """
SELECT dr.year_month, dr.campaign_id, dr.device_type,
       dr.cost, dr.roas, dr.impression_share, dr.conversion_rate
FROM google_ads__device_report dr
WHERE dr.campaign_id IN ({})
""".format(','.join(map(str, df['campaign_id'].unique())))
device_df = pd.read_sql_query(device_query, conn)
device_agg = device_df.groupby('device_type').agg(
    total_cost=('cost', 'sum'),
    avg_roas=('roas', 'mean'),
    avg_imp_share=('impression_share', 'mean'),
    avg_cvr=('conversion_rate', 'mean')
).round(2).sort_values('total_cost', ascending=False)
print("\n=== Device Distribution ===")
print(device_agg)

# Trends: compute month-over-month changes for average health score across all filtered campaigns
df['year_month_dt'] = pd.to_datetime(df['year_month'], format='%Y-%m')
monthly_health = df.groupby('year_month_dt').agg(
    avg_health=('health_score_adj', 'mean'),
    num_campaigns=('campaign_id', 'size')
).reset_index().sort_values('year_month_dt')
monthly_health['pct_change'] = monthly_health['avg_health'].pct_change() * 100
print("\n=== Monthly Health Score Trend ===")
print(monthly_health.round(2))

# Seasonal: compare month-over-month average across years
df['year'] = df['year_month_dt'].dt.year
df['month'] = df['year_month_dt'].dt.month
yearly_monthly = df.pivot_table(index='month', columns='year', values='health_score_adj', aggfunc='mean')
yearly_monthly['yoy_growth'] = (yearly_monthly[2024] - yearly_monthly[2023]) / yearly_monthly[2023] * 100
print("\n=== Year-over-Year Growth per Month ===")
print(yearly_monthly.round(2))

# Recommendations generation for each critical campaign
def generate_recommendations(row):
    rec = []
    if row['roas_norm'] < 0.25:
        rec.append('Audit ad copy and landing pages to improve conversion value; consider adjusting target ROAS or CPA.')
    if row['cpc_norm'] < 0.25:
        rec.append('Optimize keywords and bidding to reduce cost per conversion; pause underperforming keywords.')
    if row['conv_rate_norm'] < 0.25:
        rec.append('Improve landing page experience and targeting; consider A/B testing different creatives.')
    if row['qual_score_norm'] < 0.25:
        rec.append('Increase ad relevance and landing page quality; refine keyword match types.')
    if row['ctr_norm'] < 0.25:
        rec.append('Refresh ad copy with stronger CTAs; test different headlines and descriptions.')
    if row['imp_share_norm'] < 0.25:
        rec.append('Increase budget or adjust bids to capture more impression share; consider expanding targeting.')
    if pd.notna(row['avg_position']) and row['avg_pos_norm'] < 0.25:
        rec.append('Improve ad rank by raising bids and enhancing quality score.')
    # General recommendations based on campaign type and bidding strategy
    if row['campaign_type'] == 'Display':
        rec.append('Review audience targeting and placement exclusions for Display campaigns.')
    if row['bidding_strategy'] == 'Enhanced CPC':
        rec.append('Evaluate whether Enhanced CPC is driving up costs without conversions; consider switching to Target CPA.')
    if row['industry'] == 'Education' or row['industry'] == 'Real Estate':
        rec.append('Industry exhibits low ROAS; consider revising targeting parameters or seasonality adjustments.')
    return '; '.join(rec)

critical['recommendations'] = critical.apply(generate_recommendations, axis=1)

# Save critical campaigns with recommendations
critical[['year_month', 'campaign_id', 'campaign_name', 'campaign_type', 'bidding_strategy', 'industry', 'cost', 'roas', 'health_score_adj', 'risk_level_adj', 'diagnosis', 'recommendations']].to_csv('critical_campaigns_recommendations.csv', index=False)

conn.close()

print("\nAnalysis complete. Check critical_campaigns_recommendations.csv for detailed recommendations.")
''')
