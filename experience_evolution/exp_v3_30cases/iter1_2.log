# Plot 5: Risk-rating model visualization
# Create a simple risk score based on volatility, payment behavior, and lifecycle
def encode_payment(payment):
    mapping = {'Excellent': 1, 'Good': 2, 'Average': 3, 'Poor': 4, 'Very Poor': 5}
    return mapping.get(payment, 3)  # default to average

def encode_lifecycle(lifecycle):
    mapping = {'New Customer': 3, 'Growing': 2, 'Mature': 1, 'Declining': 4, 'Lost': 5}
    return mapping.get(lifecycle, 3)

merged_df['payment_score'] = merged_df['payment_behavior'].apply(encode_payment)
merged_df['lifecycle_score'] = merged_df['lifecycle_stage'].apply(encode_lifecycle)

# Normalize volatility (0-1 scale)
vol_min = merged_df['customer_margin_volatility'].min()
vol_max = merged_df['customer_margin_volatility'].max()
if vol_max > vol_min:
    merged_df['volatility_norm'] = (merged_df['customer_margin_volatility'] - vol_min) / (vol_max - vol_min)
else:
    merged_df['volatility_norm'] = 0

# Create composite risk score (higher = more risky)
merged_df['risk_score'] = 0.5 * merged_df['volatility_norm'] + 0.3 * (merged_df['payment_score']/5) + 0.2 * (merged_df['lifecycle_score']/5)

# Categorize risk levels
def risk_category(score):
    if score < 0.3:
        return 'Low Risk'
    elif score < 0.6:
        return 'Medium Risk'
    else:
        return 'High Risk'

merged_df['risk_category'] = merged_df['risk_score'].apply(risk_category)

fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Distribution of risk scores
axes[0].hist(merged_df['risk_score'], bins=20, alpha=0.7, color='orange', edgecolor='black')
