Action: CreateFile(filepath='volatility_segment.py':
'''
import pandas as pd
import numpy as np

agg = pd.read_csv('rfm_home_furniture.csv')
# Actually need monthly segment data from previous script, we can reload
conn = sqlite3.connect('dacomp-017.sqlite')
rfm = pd.read_csv('rfm_home_furniture.csv')
# we already have agg from previous script, but recompute quickly
import sqlite3
conn = sqlite3.connect('dacomp-017.sqlite')
core_customers = set(rfm[rfm['Segment'] == 'Core']['CustomerID'])
query = '''
SELECT 
    "Customer ID",
    strftime('%Y-%m', "Order Date") as month,
    profit,
    Sales,
    "Shipping Cost"
FROM order_information
WHERE "Product Category" = 'Home & Furniture'
'''
df = pd.read_sql_query(query, conn)
conn.close()
def to_float(x):
    if isinstance(x, str):
        x = x.replace(',', '').strip()
        if x == '':
            return 0.0
        try:
            return float(x)
        except:
            return 0.0
    elif x is None:
        return 0.0
    else:
        return float(x)
df['Shipping Cost_num'] = df['Shipping Cost'].apply(to_float)
df['Segment'] = df['Customer ID'].apply(lambda x: 'Core' if x in core_customers else 'Regular')
df['profit_margin'] = df['profit'] / df['Sales']

# Compute monthly volatility (std) per segment across months
monthly_margin = df.groupby(['month','Segment'])['profit_margin'].mean().unstack()
print("Monthly profit margin per segment:")
print(monthly_margin.head())

# Compute standard deviation across months
std_core = monthly_margin['Core'].std()
std_regular = monthly_margin['Regular'].std()
print(f"\nStd of monthly profit margin - Core: {std_core:.6f}, Regular: {std_regular:.6f}")

# Compute range
range_core = monthly_margin['Core'].max() - monthly_margin['Core'].min()
range_regular = monthly_margin['Regular'].max() - monthly_margin['Regular'].min()
print(f"Range - Core: {range_core:.6f}, Regular: {range_regular:.6f}")

# Compute correlation between shipping cost and margin per segment
monthly_agg = df.groupby(['month','Segment']).agg({
    'profit_margin': 'mean',
    'Shipping Cost_num': 'mean'
}).reset_index()
corr_core = monthly_agg[monthly_agg['Segment']=='Core'][['profit_margin','Shipping Cost_num']].corr().iloc[0,1]
corr_regular = monthly_agg[monthly_agg['Segment']=='Regular'][['profit_margin','Shipping Cost_num']].corr().iloc[0,1]
print(f"\nCorrelation between shipping cost and profit margin per segment:")
print(f"Core: {corr_core:.4f}, Regular: {corr_regular:.4f}")

# Let's examine the month with lowest margin overall (2024-08) for both segments
low_month = monthly_agg[monthly_agg['profit_margin'] == monthly_agg['profit_margin'].min()]
print(f"\nMonth with lowest profit margin overall: {low_month['month'].values[0]} (margin={low_month['profit_margin'].values[0]:.6f})")
print("Details for that month:")
print(monthly_agg[monthly_agg['month'] == low_month['month'].values[0]])
''')
