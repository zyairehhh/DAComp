Action: CreateFile(filepath="region_performance_change.py"):
```
import pandas as pd
import sqlite3

conn = sqlite3.connect('data.sqlite')

# Get distinct months for this app
performance_df = pd.read_sql_query("""
    SELECT region, date, overall_performance_score 
    FROM app_performance 
    WHERE app_id = 'com.dev.photoeditor' 
        AND date >= '2024-01-01' 
        AND date <= '2024-12-01'
    ORDER BY region, date
""", conn)

# Find first and last date per region (assuming each region has data for all months)
first_last = performance_df.groupby('region').agg(
    first_date=('date', 'min'),
    last_date=('date', 'max')
).reset_index()

# Merge to get scores at first and last
first_scores = performance_df.merge(first_last[['region', 'first_date']], left_on=['region', 'date'], right_on=['region', 'first_date'])
last_scores = performance_df.merge(first_last[['region', 'last_date']], left_on=['region', 'date'], right_on=['region', 'last_date'])

# Compute change
change_df = first_scores[['region', 'overall_performance_score']].rename(columns={'overall_performance_score': 'start_score'})
