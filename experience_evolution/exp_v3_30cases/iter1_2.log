import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# Load cleaned data
df = pd.read_csv('cleaned_data.csv')

# Ensure numeric columns are properly typed
df['ResidualRatio'] = pd.to_numeric(df['ResidualRatio'], errors='coerce')
df['Age_years'] = pd.to_numeric(df['Age_years'], errors='coerce')
df['Mileage_km'] = pd.to_numeric(df['Mileage_km'], errors='coerce')
df['Price_yuan'] = pd.to_numeric(df['Price_yuan'], errors='coerce')
df['NewCarPrice_cleaned'] = pd.to_numeric(df['NewCarPrice_cleaned'], errors='coerce')

# Drop rows where residual ratio is missing
df = df.dropna(subset=['ResidualRatio', 'Age_years', 'Mileage_km'])

# 1. Depreciation by Age and Mileage
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
sns.regplot(x='Age_years', y='ResidualRatio', data=df, scatter_kws={'alpha':0.3, 's':10}, line_kws={'color':'red'})
plt.xlabel('Age (years)')
plt.ylabel('Residual Ratio')
plt.title('Residual Ratio vs Vehicle Age')
plt.grid(True, linestyle='--', alpha=0.5)

plt.subplot(1, 2, 2)
sns.regplot(x='Mileage_km', y='ResidualRatio', data=df, scatter_kws={'alpha':0.3, 's':10}, line_kws={'color':'red'})
plt.xlabel('Mileage (km)')
plt.ylabel('Residual Ratio')
plt.title('Residual Ratio vs Mileage')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('depreciation_age_mileage.png', dpi=300)
plt.close()

# 2. Top models by residual ratio (min 5 listings)
model_stats = df.groupby('Model').agg(
    count=('ResidualRatio', 'size'),
    avg_residual=('ResidualRatio', 'mean'),
    avg_age=('Age_years', 'mean'),
    avg_mileage=('Mileage_km', 'mean')
).reset_index()
model_stats = model_stats[model_stats['count'] >= 5].sort_values('avg_residual', ascending=False).head(10)

plt.figure(figsize=(10, 6))
bars = plt.barh(model_stats['Model'], model_stats['avg_residual'], color='steelblue')
plt.xlabel('Average Residual Ratio')
plt.title('Top 10 Models by Residual Ratio (≥5 listings)')
plt.gca().invert_yaxis()
# Add value labels
for bar in bars:
    width = bar.get_width()
    plt.text(width + 0.005, bar.get_y() + bar.get_height()/2, f'{width:.1%}', va='center')
plt.grid(axis='x', linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('top_models_residual.png', dpi=300)
plt.close()

# 3. Residual ratio by vehicle class and fuel type
# Filter combinations with at least 5 listings
class_fuel_group = df.groupby(['Vehicle Class', 'Fuel Type']).agg(
    count=('ResidualRatio', 'size'),
    avg_residual=('ResidualRatio', 'mean'),
    avg_age=('Age_years', 'mean'),
    avg_mileage=('Mileage_km', 'mean')
).reset_index()

# Keep only those with count >=5
class_fuel_group = class_fuel_group[class_fuel_group['count'] >= 5].sort_values('avg_residual', ascending=False).head(15)

# Bar plot
plt.figure(figsize=(12, 6))
x_labels = [f'{row["Vehicle Class"]}\n{row["Fuel Type"]}' for _, row in class_fuel_group.iterrows()]
bars = plt.barh(range(len(x_labels)), class_fuel_group['avg_residual'], color='seagreen')
plt.yticks(range(len(x_labels)), x_labels, fontsize=9)
plt.xlabel('Average Residual Ratio')
plt.title('Top Vehicle Class & Fuel Type Combinations by Residual Ratio (≥5 listings)')
# Add value labels
for i, bar in enumerate(bars):
    width = bar.get_width()
    plt.text(width + 0.005, bar.get_y() + bar.get_height()/2, f'{width:.1%}', va='center')
plt.grid(axis='x', linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('class_fuel_residual.png', dpi=300)
plt.close()

# 4. Bargain opportunities: Residual Ratio vs Age scatter with highlight
plt.figure(figsize=(10, 6))
plt.scatter(df['Age_years'], df['ResidualRatio'], alpha=0.4, s=20, label='All Listings')
# Highlight bargains: residual ratio < 0.5 and age < 2
bargains = df[(df['ResidualRatio'] < 0.5) & (df['Age_years'] < 2)]
plt.scatter(bargains['Age_years'], bargains['ResidualRatio'], color='red', s=50, label='Potential Bargains (Residual < 50%, Age < 2 yrs)', zorder=5)
# Annotate some top bargains with model name
for idx, row in bargains.nsmallest(5, 'ResidualRatio').iterrows():
    plt.annotate(row['Model'], (row['Age_years'], row['ResidualRatio']), 
                 xytext=(5, -5), textcoords='offset points', fontsize=8, color='darkred')
plt.xlabel('Age (years)')
plt.ylabel('Residual Ratio')
plt.title('Residual Ratio vs Age: Identifying Bargain Opportunities')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('bargain_opportunities.png', dpi=300)
plt.close()

print("Visualizations generated: depreciation_age_mileage.png, top_models_residual.png, class_fuel_residual.png, bargain_opportunities.png")
```
