import pandas as pd
import numpy as np
import re

def extract_lower(salary_str):
    if pd.isna(salary_str):
        return np.nan
    match = re.search(r'([0-9,\.]+)\s*-\s*[0-9,\.]+', salary_str)
    if match:
        num_str = match.group(1).replace(',', '').strip()
        try:
            return float(num_str)
        except:
            return np.nan
    else:
        match2 = re.search(r'([0-9,\.]+)', salary_str)
        if match2:
            num_str = match2.group(1).replace(',', '').strip()
            try:
                return float(num_str)
            except:
                return np.nan
        else:
            return np.nan

df = pd.read_csv('vocational_data.csv')
df['starting_salary'] = df['Salary Range'].apply(extract_lower)
salary_df = df.dropna(subset=['starting_salary']).copy()
print("Total rows with salary:", len(salary_df))

# Analyze Work Experience Requirement
print("\n=== Work Experience Requirement ===")
exp_map = {
    'No limit': 0,
    'Fresh graduates': 1,
    'More than one year of work experience': 2,
    'Two years or more of work experience': 3,
    'Three years or more of work experience': 4,
    'Four years or more of work experience': 5,
    'Five years or more of work experience': 6,
    'Six years or more of work experience': 7,
    'Seven years or more of work experience': 8,
    'Eight years or more of work experience': 9,
    'Nine years or more of work experience': 10,
    'Ten years or more of work experience': 11,
    'More than 15 years of work experience': 12,
}
def map_exp(val):
    if pd.isna(val):
        return -1
    for k, v in exp_map.items():
        if k in val:
            return v
    return -1

salary_df['exp_level'] = salary_df['Work Experience Requirement'].apply(map_exp)
print(salary_df['exp_level'].value_counts().sort_index())
# Compute average salary per level
print("\nAverage salary by experience level:")
for level in sorted(salary_df['exp_level'].unique()):
    if level == -1:
        continue
    subset = salary_df[salary_df['exp_level'] == level]
    # map back to original category
    cat = [k for k, v in exp_map.items() if v == level][0]
    print(f"{cat}: {subset['starting_salary'].mean():.2f} (count={len(subset)})")

# Foreign Language Requirement
print("\n=== Foreign Language Requirement ===")
lang_counts = salary_df['Foreign Language Requirement'].value_counts(dropna=False)
print(lang_counts.head(10))
# Group by English vs None
def has_english(val):
    if pd.isna(val):
        return 'Missing'
    val_lower = val.lower()
    if 'english' in val_lower:
        return 'English'
    elif 'chinese' in val_lower or 'hokkien' in val_lower or 'cantonese' in val_lower or 'spanish' in val_lower or 'japanese' in val_lower:
        return 'Other language'
    else:
        return 'None'
salary_df['lang_cat'] = salary_df['Foreign Language Requirement'].apply(has_english)
print("\nSalary by language requirement:")
for cat in ['Missing', 'None', 'Other language', 'English']:
    subset = salary_df[salary_df['lang_cat'] == cat]
    print(f"{cat}: {subset['starting_salary'].mean():.2f} (count={len(subset)})")

# Age Requirement: maybe categorize by age range
print("\n=== Age Requirement ===")
def parse_age_range(val):
    if pd.isna(val):
        return None
    # pattern like "20 to 35 years old"
    match = re.search(r'(\d+)\s*to\s*(\d+)\s*years old', val.lower())
    if match:
        low = int(match.group(1))
        high = int(match.group(2))
        return (low, high)
    else:
        return None

salary_df['age_range'] = salary_df['Age Requirement'].apply(parse_age_range)
# filter those with age range
age_df = salary_df[salary_df['age_range'].notna()].copy()
print(f"Rows with age range: {len(age_df)}")
# Compute average lower age and upper age
age_df['age_low'] = age_df['age_range'].apply(lambda x: x[0])
age_df['age_high'] = age_df['age_range'].apply(lambda x: x[1])
age_df['age_mid'] = (age_df['age_low'] + age_df['age_high']) / 2
# correlation with salary
corr = age_df['age_mid'].corr(age_df['starting_salary'])
print(f"Correlation between age midpoint and salary: {corr:.3f}")
print("Average salary by age range (top 10):")
age_summary = age_df.groupby('Age Requirement')['starting_salary'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print(age_summary.head(10))

# Gender Requirement
print("\n=== Gender Requirement ===")
gender_summary = salary_df.groupby('Gender Requirement')['starting_salary'].agg(['mean', 'count'])
print(gender_summary)

# Employment Type
print("\n=== Employment Type ===")
emp_summary = salary_df.groupby('Employment Type')['starting_salary'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print(emp_summary.head(20))
''')
