        mode = group['Task Type'].mode()
        if len(mode) > 0:
            owner_types[owner] = mode.iloc[0]
        else:
            owner_types[owner] = 'Unknown'
perf['Primary Task Type'] = perf['Task Owner'].map(owner_types)

# Crosstab
