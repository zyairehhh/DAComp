import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import os

# Connect to database
conn = sqlite3.connect('dacomp-035.sqlite')

# Query abnormal logins per department
query = """
SELECT 
    u.Department,
    COUNT(a.[Anomaly ID]) as abnormal_count,
    AVG(a.[Anomaly Score]) as avg_score,
    SUM(CASE WHEN a.[Risk Level] = 'Severe' THEN 1 ELSE 0 END) as severe_count,
    SUM(CASE WHEN a.[Risk Level] = 'Medium' THEN 1 ELSE 0 END) as medium_count,
    SUM(CASE WHEN a.[Risk Level] = 'Low' THEN 1 ELSE 0 END) as low_count
FROM abnormal_logins_table a
LEFT JOIN login_records_table l ON a.[Login Record ID] = l.[Login Record ID]
LEFT JOIN user_information_table u ON l.[User ID] = u.[User ID]
WHERE u.Department IS NOT NULL
GROUP BY u.Department
ORDER BY abnormal_count DESC
"""
df = pd.read_sql_query(query, conn)
conn.close()

print(df.head())

# Plot 1: Bar chart of abnormal login counts per department (top 10)
top10 = df.sort_values('abnormal_count', ascending=False).head(10)
plt.figure(figsize=(10,6))
bars = plt.barh(top10['Department'], top10['abnormal_count'], color='coral')
plt.xlabel('Number of Abnormal Logins')
plt.title('Top 10 Departments by Abnormal Login Count', fontsize=14)
plt.gca().invert_yaxis()
for bar in bars:
    width = bar.get_width()
    plt.text(width + 0.5, bar.get_y() + bar.get_height()/2, f'{int(width)}', ha='left', va='center')
plt.tight_layout()
plt.savefig('abnormal_counts.png', dpi=300)
plt.close()

# Plot 2: Stacked bar chart of risk level distribution per department (top 5)
top5 = df.sort_values('abnormal_count', ascending=False).head(5).set_index('Department')
plt.figure(figsize=(9,5))
bottom = None
colors = ['#ff9999', '#ffcc99', '#99ff99']
risk_cols = ['severe_count', 'medium_count', 'low_count']
labels = ['Severe', 'Medium', 'Low']
for i, col in enumerate(risk_cols):
    plt.bar(top5.index, top5[col], bottom=bottom, label=labels[i], color=colors[i])
    if bottom is None:
        bottom = top5[col].values
    else:
        bottom += top5[col].values
plt.ylabel('Count')
plt.title('Risk Level Distribution for Top 5 Departments by Abnormal Logins', fontsize=12)
plt.legend(title='Risk Level')
plt.xticks(rotation=30)
plt.tight_layout()
plt.savefig('risk_distribution.png', dpi=300)
plt.close()

# Plot 3: Scatter of average anomaly score vs count (bubble size = severe count)
plt.figure(figsize=(10,7))
scatter = plt.scatter(df['abnormal_count'], df['avg_score'], s=df['severe_count']*10, alpha=0.6, c=df['severe_count'], cmap='Reds')
plt.xlabel('Abnormal Login Count')
plt.ylabel('Average Anomaly Score')
plt.title('Department Security Profile: Count vs Score (Bubble size = Severe Count)')
plt.colorbar(scatter, label='Severe Count')
# Annotate outliers
for i, row in df.nlargest(5, 'abnormal_count').iterrows():
    plt.annotate(row['Department'], (row['abnormal_count'], row['avg_score']), fontsize=9, alpha=0.8)
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('score_vs_count.png', dpi=300)
plt.close()

print("Plots saved.")
```
