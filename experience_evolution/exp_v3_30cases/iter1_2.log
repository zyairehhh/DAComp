import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

# Connect to database
conn = sqlite3.connect('dacomp-100.sqlite')

# Load company data
companies = pd.read_sql_query("SELECT * FROM intercom__company_enhanced", conn)

# Parse tags
def parse_tags(tag_str):
    if not isinstance(tag_str, str):
        return {}
    parts = tag_str.split('|')
    tags = {}
    for part in parts:
        if '=' in part:
            key, value = part.split('=', 1)
            tags[key] = value
    return tags

# Apply parsing
company_tags = companies['all_company_tags'].apply(parse_tags)
# Extract key fields
def get_tag(tags, key):
    return tags.get(key, None)

companies['segment'] = company_tags.apply(lambda x: get_tag(x, 'segment'))
companies['industry'] = company_tags.apply(lambda x: get_tag(x, 'industry'))
companies['contract_tier'] = company_tags.apply(lambda x: get_tag(x, 'contract_tier'))
companies['contract_size'] = company_tags.apply(lambda x: get_tag(x, 'contract_size'))
