import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-027.sqlite')

# Read tables
disaster_df = pd.read_sql_query('SELECT * FROM disaster_events', conn)
env_df = pd.read_sql_query('SELECT * FROM environment_and_health', conn)
ben_df = pd.read_sql_query('SELECT * FROM beneficiaries_and_assessments', conn)

# Clean column names for easier handling
disaster_df.columns = [c.strip() for c in disaster_df.columns]
env_df.columns = [c.strip() for c in env_df.columns]
ben_df.columns = [c.strip() for c in ben_df.columns]

# Merge environment data with disaster level
env_df = env_df.rename(columns={'Disaster Reference ID': 'Disaster Event ID'})
merged_env = pd.merge(env_df, disaster_df[['Disaster Event ID', 'Disaster Level', 'Disaster Type']], on='Disaster Event ID', how='left')

# Merge beneficiary data with disaster level
ben_df = ben_df.rename(columns={'Distribution reference ID': 'Disaster Event ID'})
merged_ben = pd.merge(ben_df, disaster_df[['Disaster Event ID', 'Disaster Level', 'Disaster Type']], on='Disaster Event ID', how='left')

# Define mapping for categorical variables to numeric scores for secondary hazard
def map_env_impact(val):
    if val == 'Low':
        return 1
    elif val == 'Medium':
        return 2
    else:  # 'High'
        return 3

def map_waste_status(val):
    # Assuming values: Adequate, Critical, Limited? Let's see unique
    # We'll map to numeric: Adequate=1, Limited=2, Critical=3 (higher worse)
    mapping = {'Adequate': 1, 'Limited': 2, 'Critical': 3}
    return mapping.get(val, 2)

def map_disease_risk(val):
    mapping = {'Low': 1, 'Medium': 2, 'High': 3}
    return mapping.get(val, 2)

def map_medical_capacity(val):
    mapping = {'Adequate': 1, 'Limited': 2, 'Critical': 3}
    return mapping.get(val, 2)

def map_mental_health(val):
    mapping = {'Available': 1, 'Limited': 2, 'Critical': 3}
    return mapping.get(val, 2)

# Apply mappings to create numeric scores
merged_env['EnvImpactScore'] = merged_env['Environmental Impact Rate'].apply(map_env_impact)
merged_env['WasteScore'] = merged_env['Waste Management Status'].apply(map_waste_status)
merged_env['DiseaseScore'] = merged_env['Disease Risk'].apply(map_disease_risk)
merged_env['MedicalScore'] = merged_env['Medical Emergency Response Capacity'].apply(map_medical_capacity)
merged_env['MentalScore'] = merged_env['Mental Health Assistance'].apply(map_mental_health)

# Normalize numeric indicators to 0-3 scale (to be comparable with categorical scores)
# Higher values indicate worse outcomes.
# For Carbon Emissions: higher worse; we'll min-max normalize across dataset
carbon_min = merged_env['Carbon Emissions (tons)'].min()
carbon_max = merged_env['Carbon Emissions (tons)'].max()
merged_env['CarbonScore'] = 3 * (merged_env['Carbon Emissions (tons)'] - carbon_min) / (carbon_max - carbon_min + 1e-9)

# Water Quality Index: lower worse; invert scale.
water_min = merged_env['Water Quality Index'].min()
water_max = merged_env['Water Quality Index'].max()
merged_env['WaterScore'] = 3 * (water_max - merged_env['Water Quality Index']) / (water_max - water_min + 1e-9)

# Sanitation Coverage Rate: lower worse; invert.
san_min = merged_env['Sanitation Coverage Rate'].min()
san_max = merged_env['Sanitation Coverage Rate'].max()
merged_env['SanitationScore'] = 3 * (san_max - merged_env['Sanitation Coverage Rate']) / (san_max - san_min + 1e-9)

# Vaccination Coverage Rate: lower worse; invert.
vac_min = merged_env['Vaccination Coverage Rate'].min()
vac_max = merged_env['Vaccination Coverage Rate'].max()
merged_env['VaccinationScore'] = 3 * (vac_max - merged_env['Vaccination Coverage Rate']) / (vac_max - vac_min + 1e-9)

# Compute Secondary Hazard Score per record (sum of all component scores)
merged_env['SecondaryHazardScore'] = (merged_env['EnvImpactScore'] + merged_env['WasteScore'] +
                                      merged_env['DiseaseScore'] + merged_env['MedicalScore'] +
                                      merged_env['MentalScore'] + merged_env['CarbonScore'] +
                                      merged_env['WaterScore'] + merged_env['SanitationScore'] +
                                      merged_env['VaccinationScore'])

# For People Impact Score: use beneficiary data mapping
def map_vulnerability(val):
    mapping = {'Low': 1, 'Medium': 2, 'High': 3}
    return mapping.get(val, 2)

def map_needs_assess(val):
    mapping = {'Pending': 3, 'Partial': 2, 'Complete': 1}
    return mapping.get(val, 2)

def map_community_engage(val):
    mapping = {'Low': 3, 'Medium': 2, 'High': 1}
    return mapping.get(val, 2)

def map_local_capacity(val):
    mapping = {'Low': 3, 'Medium': 2, 'High': 1}
    return mapping.get(val, 2)

merged_ben['VulnerabilityScore'] = merged_ben['Vulnerability assessment'].apply(map_vulnerability)
merged_ben['NeedsScore'] = merged_ben['Needs assessment status'].apply(map_needs_assess)
# Allocation fairness index: higher better? Stage1 says "aggregates fairness, feedback, engagement and capacity".
# We'll treat higher allocation fairness as better (lower impact). So invert.
fair_min = merged_ben['Allocation fairness index'].min()
fair_max = merged_ben['Allocation fairness index'].max()
merged_ben['FairnessScore'] = 3 * (fair_max - merged_ben['Allocation fairness index']) / (fair_max - fair_min + 1e-9)

# Feedback score: higher better, so invert.
feedback_min = merged_ben['Affected population feedback score'].min()
feedback_max = merged_ben['Affected population feedback score'].max()
merged_ben['FeedbackScore'] = 3 * (feedback_max - merged_ben['Affected population feedback score']) / (feedback_max - feedback_min + 1e-9)

merged_ben['EngagementScore'] = merged_ben['Community engagement level'].apply(map_community_engage)
merged_ben['CapacityScore'] = merged_ben['Local capacity building'].apply(map_local_capacity)

merged_ben['PeopleImpactScore'] = (merged_ben['VulnerabilityScore'] + merged_ben['NeedsScore'] +
                                   merged_ben['FairnessScore'] + merged_ben['FeedbackScore'] +
                                   merged_ben['EngagementScore'] + merged_ben['CapacityScore'])

# Group by Disaster Level
level_groups_env = merged_env.groupby('Disaster Level')
level_groups_ben = merged_ben.groupby('Disaster Level')

# Compute mean Secondary Hazard Score and People Impact Score per level
secondary_by_level = level_groups_env['SecondaryHazardScore'].mean()
people_by_level = level_groups_ben['PeopleImpactScore'].mean()

# Ensure order Level 1..5
levels = ['Level 1', 'Level 2', 'Level 3', 'Level 4', 'Level 5']
secondary_by_level = secondary_by_level.reindex(levels)
people_by_level = people_by_level.reindex(levels)

# Plot 1: Secondary Hazard Score by Disaster Level
plt.figure(figsize=(10, 6))
bars1 = plt.bar(secondary_by_level.index, secondary_by_level.values, color='skyblue')
plt.title('Secondary Hazard Score by Disaster Level', fontsize=16)
plt.xlabel('Disaster Level', fontsize=14)
plt.ylabel('Mean Secondary Hazard Score (higher = worse)', fontsize=14)
# Add values on bars
for bar in bars1:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.2f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('secondary_hazard_by_level.png', dpi=300)
plt.close()

# Plot 2: People Impact Score by Disaster Level
plt.figure(figsize=(10, 6))
bars2 = plt.bar(people_by_level.index, people_by_level.values, color='salmon')
plt.title('People Impact Score by Disaster Level', fontsize=16)
plt.xlabel('Disaster Level', fontsize=14)
plt.ylabel('Mean People Impact Score (higher = worse)', fontsize=14)
for bar in bars2:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.2f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('people_impact_by_level.png', dpi=300)
plt.close()

# Plot 3: Component breakdown of Secondary Hazard Score per level (stacked?)
# We'll compute mean of each component per level
components = ['EnvImpactScore', 'WasteScore', 'DiseaseScore', 'MedicalScore', 'MentalScore',
              'CarbonScore', 'WaterScore', 'SanitationScore', 'VaccinationScore']
comp_means = {}
for comp in components:
    comp_means[comp] = level_groups_env[comp].mean().reindex(levels)

# Plot as grouped bar chart for top components (maybe 4-5 most relevant)
# Let's pick Environmental Impact, Disease Risk, Medical Capacity, Mental Health, Water Quality
selected = ['EnvImpactScore', 'DiseaseScore', 'MedicalScore', 'MentalScore', 'WaterScore']
labels = ['Environmental Impact', 'Disease Risk', 'Medical Capacity', 'Mental Health', 'Water Quality']
x = np.arange(len(levels))
width = 0.15
plt.figure(figsize=(12, 7))
for i, (comp, label) in enumerate(zip(selected, labels)):
    values = comp_means[comp].values
    plt.bar(x + i*width - width*2, values, width, label=label)
plt.xlabel('Disaster Level')
plt.ylabel('Component Score (higher = worse)')
plt.title('Key Secondary Hazard Components by Disaster Level')
plt.xticks(x, levels)
plt.legend()
plt.tight_layout()
plt.savefig('components_by_level.png', dpi=300)
plt.close()

# Plot 4: Secondary Hazard Score by Disaster Type
type_groups_env = merged_env.groupby('Disaster Type')
secondary_by_type = type_groups_env['SecondaryHazardScore'].mean()
# Reorder by descending score
secondary_by_type = secondary_by_type.sort_values(ascending=False)
plt.figure(figsize=(10, 6))
bars3 = plt.bar(secondary_by_type.index, secondary_by_type.values, color='lightgreen')
plt.title('Secondary Hazard Score by Disaster Type', fontsize=16)
plt.xlabel('Disaster Type', fontsize=14)
plt.ylabel('Mean Secondary Hazard Score', fontsize=14)
for bar in bars3:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.2f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('secondary_hazard_by_type.png', dpi=300)
plt.close()

# Plot 5: People Impact Score by Disaster Type
people_by_type = merged_ben.groupby('Disaster Type')['PeopleImpactScore'].mean().sort_values(ascending=False)
plt.figure(figsize=(10, 6))
bars4 = plt.bar(people_by_type.index, people_by_type.values, color='gold')
plt.title('People Impact Score by Disaster Type', fontsize=16)
plt.xlabel('Disaster Type', fontsize=14)
plt.ylabel('Mean People Impact Score', fontsize=14)
for bar in bars4:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.2f}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('people_impact_by_type.png', dpi=300)
plt.close()

# Plot 6: Disease Risk proportion "High" by Level (categorical)
# Compute proportion of 'High' disease risk per level
disease_counts = merged_env.groupby('Disaster Level')['Disease Risk'].value_counts().unstack(fill_value=0)
disease_counts = disease_counts.reindex(levels)
if 'High' in disease_counts.columns:
    disease_high_pct = disease_counts['High'] / disease_counts.sum(axis=1) * 100
else:
    disease_high_pct = pd.Series(0, index=levels)
plt.figure(figsize=(8,5))
plt.bar(disease_high_pct.index, disease_high_pct.values, color='coral')
plt.title('Proportion of High Disease Risk by Disaster Level', fontsize=14)
plt.xlabel('Disaster Level')
plt.ylabel('Percentage (%)')
for i, v in enumerate(disease_high_pct.values):
    plt.text(i, v + 0.5, f'{v:.1f}%', ha='center')
plt.tight_layout()
plt.savefig('disease_risk_by_level.png', dpi=300)
plt.close()

# Plot 7: Carbon Emissions mean by Level
carbon_by_level = level_groups_env['Carbon Emissions (tons)'].mean().reindex(levels)
plt.figure(figsize=(8,5))
plt.bar(carbon_by_level.index, carbon_by_level.values, color='gray')
plt.title('Average Carbon Emissions by Disaster Level', fontsize=14)
plt.xlabel('Disaster Level')
plt.ylabel('Average Carbon Emissions (tons)')
for i, v in enumerate(carbon_by_level.values):
    plt.text(i, v + 5, f'{v:.1f}', ha='center')
plt.tight_layout()
plt.savefig('carbon_by_level.png', dpi=300)
plt.close()

# Plot 8: Water Quality Index mean by Level
water_by_level = level_groups_env['Water Quality Index'].mean().reindex(levels)
plt.figure(figsize=(8,5))
plt.bar(water_by_level.index, water_by_level.values, color='lightblue')
plt.title('Average Water Quality Index by Disaster Level', fontsize=14)
plt.xlabel('Disaster Level')
plt.ylabel('Average Water Quality Index (higher better)')
for i, v in enumerate(water_by_level.values):
    plt.text(i, v + 0.5, f'{v:.1f}', ha='center')
plt.tight_layout()
plt.savefig('water_quality_by_level.png', dpi=300)
plt.close()

print("Plots generated: secondary_hazard_by_level.png, people_impact_by_level.png, components_by_level.png, secondary_hazard_by_type.png, people_impact_by_type.png, disease_risk_by_level.png, carbon_by_level.png, water_quality_by_level.png")
