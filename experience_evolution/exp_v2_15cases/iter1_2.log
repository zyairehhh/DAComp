'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from datetime import datetime
import seaborn as sns

conn = sqlite3.connect('dacomp-070.sqlite')

# 3. Non-linear relationship between conversion rate and quality/crash metrics
# Get conversion rate data aggregated by app and date
query_conv = """
SELECT date_day, package_name, 
       AVG(store_listing_conversion_rate) as conv_rate
FROM google_play__country_report 
GROUP BY date_day, package_name
"""
df_conv = pd.read_sql_query(query_conv, conn)
df_conv['date_day'] = pd.to_datetime(df_conv['date_day'])

# Get quality and crash data
query_quality = """
SELECT date_day, package_name, quality_score, crash_rate_per_1k 
FROM google_play__time_series_trends
"""
df_quality = pd.read_sql_query(query_quality, conn)
df_quality['date_day'] = pd.to_datetime(df_quality['date_day'])

# Merge
df_merged = pd.merge(df_conv, df_quality, on=['date_day', 'package_name'], how='inner')

# Scatter plots
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Quality score vs conversion rate
colors = plt.cm.tab10(np.linspace(0, 1, len(df_merged['package_name'].unique())))
for i, app in enumerate(df_merged['package_name'].unique()):
    app_data = df_merged[df_merged['package_name'] == app]
    axes[0].scatter(app_data['quality_score'], app_data['conv_rate'], 
                    alpha=0.6, label=app, color=colors[i], s=20)

axes[0].set_xlabel('Quality Score')
axes[0].set_ylabel('Conversion Rate')
axes[0].set_title('Conversion Rate vs Quality Score (All Apps)')
axes[0].legend(fontsize=8, ncol=2)
axes[0].grid(True, alpha=0.3)

# Crash rate vs conversion rate
for i, app in enumerate(df_merged['package_name'].unique()):
    app_data = df_merged[df_merged['package_name'] == app]
    axes[1].scatter(app_data['crash_rate_per_1k'], app_data['conv_rate'], 
                    alpha=0.6, label=app, color=colors[i], s=20)

axes[1].set_xlabel('Crash Rate per 1k Sessions')
axes[1].set_ylabel('Conversion Rate')
axes[1].set_title('Conversion Rate vs Crash Rate (All Apps)')
axes[1].legend(fontsize=8, ncol=2)
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('conversion_vs_quality_crash.png', dpi=300)
plt.close()

# 4. Correlation between revenue per active device and active devices by market maturity
# Compute cumulative installs per app
query_cumulative = """
SELECT package_name, date_day,
       SUM(daily_installs) OVER (PARTITION BY package_name ORDER BY date_day) as cumulative_installs,
       revenue_per_active_device,
       active_devices
FROM google_play__time_series_trends
ORDER BY package_name, date_day
"""
df_cum = pd.read_sql_query(query_cumulative, conn)
df_cum['date_day'] = pd.to_datetime(df_cum['date_day'])

# Determine median cumulative installs per app
df_median = df_cum.groupby('package_name')['cumulative_installs'].median().reset_index()
df_median.columns = ['package_name', 'median_cumulative']

# Classify each row as low or high maturity
df_cum = pd.merge(df_cum, df_median, on='package_name', how='left')
df_cum['maturity'] = np.where(df_cum['cumulative_installs'] <= df_cum['median_cumulative'], 
                               'Low Maturity', 'High Maturity')

# Remove rows with NaN values
df_cum = df_cum.dropna(subset=['revenue_per_active_device', 'active_devices'])

# Calculate correlation per maturity group
corr_low = df_cum[df_cum['maturity'] == 'Low Maturity'][['revenue_per_active_device', 'active_devices']].corr().iloc[0,1]
corr_high = df_cum[df_cum['maturity'] == 'High Maturity'][['revenue_per_active_device', 'active_devices']].corr().iloc[0,1]

# Create scatter plot
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

maturity_colors = {'Low Maturity': 'red', 'High Maturity': 'blue'}

for maturity_group in ['Low Maturity', 'High Maturity']:
    subset = df_cum[df_cum['maturity'] == maturity_group]
    axes[0].scatter(subset['active_devices'], subset['revenue_per_active_device'], 
                   alpha=0.5, label=f'{maturity_group} (r={corr_low if maturity_group=="Low Maturity" else corr_high:.3f})',
                   color=maturity_colors[maturity_group], s=15)

axes[0].set_xlabel('Active Devices')
axes[0].set_ylabel('Revenue per Active Device')
axes[0].set_title('Revenue per Active Device vs Active Devices')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# Boxplot of revenue per active device by maturity
axes[1].boxplot([df_cum[df_cum['maturity'] == 'Low Maturity']['revenue_per_active_device'],
                 df_cum[df_cum['maturity'] == 'High Maturity']['revenue_per_active_device']],
                labels=['Low Maturity', 'High Maturity'])
axes[1].set_ylabel('Revenue per Active Device')
axes[1].set_title('Distribution of Revenue per Active Device')
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('revenue_vs_maturity.png', dpi=300)
plt.close()

# 5. Update frequency impact
# Calculate update events 7-day moving average per app per day
query_updates = """
SELECT t.date_day, t.package_name, 
       COALESCE(d.update_events, 0) as update_events,
       t.active_devices,
       t.rolling_total_average_rating as rating
FROM google_play__time_series_trends t
LEFT JOIN (
    SELECT date_day, package_name, SUM(update_events) as update_events
    FROM google_play__device_report 
    GROUP BY date_day, package_name
) d ON t.date_day = d.date_day AND t.package_name = d.package_name
WHERE t.rolling_total_average_rating IS NOT NULL 
  AND t.active_devices IS NOT NULL
"""
df_updates = pd.read_sql_query(query_updates, conn)

# Clean data
df_updates['date_day'] = pd.to_datetime(df_updates['date_day'])
df_updates = df_updates.dropna()
df_updates['update_ma7'] = df_updates.groupby('package_name')['update_events'].transform(
    lambda x: x.rolling(7, min_periods=1).mean()
)

# Correlation across all data
corr_active = df_updates['update_ma7'].corr(df_updates['active_devices'])
corr_rating = df_updates['update_ma7'].corr(df_updates['rating'])

print(f"Correlation update frequency vs active devices: {corr_active}")
print(f"Correlation update frequency vs rating: {corr_rating}")

# Scatter plot
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Update frequency vs active devices
axes[0].scatter(df_updates['update_ma7'], df_updates['active_devices'], alpha=0.4, s=10)
axes[0].set_xlabel('Update Frequency (7-day MA)')
axes[0].set_ylabel('Active Devices')
axes[0].set_title(f'Update Frequency vs Active Devices\nCorrelation: {corr_active:.4f}')
axes[0].grid(True, alpha=0.3)

# Update frequency vs rating
axes[1].scatter(df_updates['update_ma7'], df_updates['rating'], alpha=0.4, s=10)
axes[1].set_xlabel('Update Frequency (7-day MA)')
axes[1].set_ylabel('Rolling Average Rating')
axes[1].set_title(f'Update Frequency vs Rating\nCorrelation: {corr_rating:.4f}')
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('update_frequency_impact.png', dpi=300)
plt.close()

conn.close()

print("Visualizations generated successfully!")
''')
