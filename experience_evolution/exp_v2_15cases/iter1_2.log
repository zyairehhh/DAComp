'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome;", conn)
conn.close()

# Clean functions (same as before)
import re
def clean_price(price_str):
    if pd.isna(price_str):
        return np.nan
    s = str(price_str).replace(',', '').replace('yuan', '').strip()
    match = re.search(r'[\d]+(?:\.\d+)?', s)
    if match:
        try:
            return float(match.group())
        except:
            return np.nan
    return np.nan

def clean_mileage(mileage_str):
    if pd.isna(mileage_str):
        return np.nan
    s = str(mileage_str).strip()
    if 'ten thousand km' in s:
        match = re.search(r'[\d,]+(?:\.\d+)?', s)
        if match:
            try:
                val = float(match.group().replace(',', ''))
                return val * 10000
            except:
                return np.nan
    elif 'km' in s:
        match = re.search(r'[\d,]+(?:\.\d+)?', s)
        if match:
            try:
                return float(match.group().replace(',', ''))
            except:
                return np.nan
    return np.nan

def compute_age(reg_date_str, ref_date='2025-01-01'):
    if pd.isna(reg_date_str):
        return np.nan
    try:
        reg = pd.to_datetime(reg_date_str)
        ref = pd.to_datetime(ref_date)
        age = (ref - reg).days / 365.25
        return age
    except:
        return np.nan

df['Price_yuan'] = df['Price'] * 10000
df['NewPrice_yuan'] = df['New Car Price (incl. tax)'].apply(clean_price)
df['Mileage_km'] = df['Mileage'].apply(clean_mileage)
df['Age_years'] = df['Registration Date'].apply(lambda x: compute_age(x))
df['Depreciation_Ratio'] = df['Price_yuan'] / df['NewPrice_yuan']

# Keep only rows with valid ratio and reasonable values
df = df.dropna(subset=['Depreciation_Ratio', 'Age_years', 'Mileage_km'])
df = df[(df['Depreciation_Ratio'] >= 0.1) & (df['Depreciation_Ratio'] <= 1.2)]

# Extract Brand and Model
df['Brand'] = df['Title'].apply(lambda x: str(x).split()[0] if pd.notna(x) else '')
def extract_model(title):
    words = str(title).split()
    if len(words) >= 3:
        return ' '.join(words[:3])
    else:
        return ' '.join(words)
df['Model'] = df['Title'].apply(extract_model)

# Compute a composite score for buyback recommendations
# Score = Depreciation_Ratio * log10(Price_yuan) * (1 - Age_years/20)  # age penalty up to 20 years?
# Let's keep it simple: Score = Depreciation_Ratio * log10(Price_yuan)
df['Buyback_Score'] = df['Depreciation_Ratio'] * np.log10(df['Price_yuan'])

# Filter for recent cars (<=5 years) and moderate mileage (<=100,000 km)
df_recent = df[(df['Age_years'] <= 5) & (df['Mileage_km'] <= 100000)]

# Group by Model with at least 5 listings
model_stats = df_recent.groupby('Model').agg(
    Avg_Depreciation_Ratio=('Depreciation_Ratio', 'mean'),
    Avg_Used_Price_yuan=('Price_yuan', 'mean'),
    Avg_Age=('Age_years', 'mean'),
    Avg_Mileage=('Mileage_km', 'mean'),
    Count=('Title', 'count')
).sort_values('Avg_Depreciation_Ratio', ascending=False)

# Filter models with Count >= 5
model_stats = model_stats[model_stats['Count'] >= 5]

# Also compute score per model (average of individual scores)
model_stats['Avg_Score'] = df_recent.groupby('Model')['Buyback_Score'].mean()
model_stats = model_stats.sort_values('Avg_Score', ascending=False)

print("=== Top 20 Models by Buyback Score (Higher is Better) ===")
print(model_stats.head(20).to_string())

# For high-end models (luxury), we can also look at those with high absolute used price
high_price_models = df_recent.groupby('Model').agg(
    Avg_Used_Price_yuan=('Price_yuan', 'mean')
).sort_values('Avg_Used_Price_yuan', ascending=False)
high_price_models = high_price_models.head(20)
print("\n=== Top 20 Models by Average Used Price (High-End Market) ===")
print(high_price_models.to_string())

# Recommendations:
# 1. Focus on micro EVs with high depreciation ratio (e.g., Chery QQ Ice, Wuling Hongguang MINIEV).
# 2. Consider luxury EVs with high absolute price but moderate ratio (e.g., Human Horizons HiPhi, Cadillac LYRIQ).
# 3. Look at vehicle classes: Mid-size Car, Large MPV, Mid‑to‑Large Car.
# 4. Favor Front‑engine Rear‑wheel Drive and Front‑engine front‑wheel drive (with space).

# Let's generate a CSV with sorted recommendations
model_stats.to_csv('model_recommendations.csv')
print("\nModel recommendations saved to model_recommendations.csv")
''')
