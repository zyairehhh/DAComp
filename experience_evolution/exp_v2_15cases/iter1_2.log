import sqlite3
import pandas as pd
import re
import numpy as np
from collections import Counter

db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter1/dacomp-048/stage1_env/dacomp-048.sqlite"
conn = sqlite3.connect(db_path)
query = """
SELECT "Job Title", "Number of Openings", "Company Name", "Employment Type",
       "Work Experience Requirement", "Foreign Language Requirement",
       "Age Requirement", "Gender Requirement", "Education Requirement",
       "Work Location", "Working Hours", "Salary Range", "Benefits",
       "Company Type", "Industry"
FROM sheet1
WHERE "Education Requirement" LIKE '%vocational%'
"""
df = pd.read_sql_query(query, conn)
conn.close()

print(f"Total rows with vocational requirement: {len(df)}")

# Salary parsing improved
def parse_salary_lower(salary_str):
    if not isinstance(salary_str, str):
        return None
    s = salary_str.lower()
    # Remove commas, RMB/month, yuan/month, etc.
    s = s.replace(',', '')
    # Extract base salary if present
    base_match = re.search(r'base salary:\s*(\d+)\s*(?:RMB|yuan)?', s)
    if base_match:
        try:
            return int(base_match.group(1))
        except:
            pass
    # Find first number before dash in main range
    range_match = re.search(r'(\d+)\s*-\s*(\d+)', s)
    if range_match:
        try:
            return int(range_match.group(1))
        except:
            pass
    # If single number like "5000 yuan/month"
    single_match = re.search(r'(\d+)\s*(?:RMB|yuan)', s)
    if single_match:
        try:
            return int(single_match.group(1))
        except:
            pass
    # If just a number
    num_match = re.search(r'(\d+)', s)
    if num_match:
        try:
            val = int(num_match.group(1))
            if val < 1000: # maybe it's in thousands? but keep as is
                pass
            return val
        except:
            pass
    return None

df['salary_lower'] = df['Salary Range'].apply(parse_salary_lower)
print(f"Rows with parsed salary: {df['salary_lower'].notna().sum()}")
# Check outliers
print("\nRows with salary_lower < 1000:")
outliers = df[df['salary_lower'] < 1000][['Salary Range', 'salary_lower']]
print(outliers.head(20))
print(f"Count: {len(outliers)}")
# Drop outliers for distribution?
df_clean = df[df['salary_lower'] >= 1000].copy()
print(f"Rows after removing salary < 1000: {len(df_clean)}")

# Starting Salary Distribution
print("\n=== Starting Salary Distribution (cleaned) ===")
salary_lower = df_clean['salary_lower']
print(f"Count: {len(salary_lower)}")
print(f"Mean: {salary_lower.mean():.2f}")
print(f"Median: {salary_lower.median():.2f}")
print(f"Std: {salary_lower.std():.2f}")
print(f"Min: {salary_lower.min()}")
print(f"Max: {salary_lower.max()}")
# Percentiles
for p in [10, 25, 50, 75, 90]:
    print(f"{p}th percentile: {np.percentile(salary_lower, p):.2f}")
# Histogram
bins = [0, 2000, 3000, 4000, 5000, 6000, 8000, 10000, 15000, 20000, 50000]
hist, edges = np.histogram(salary_lower, bins=bins)
for i in range(len(hist)):
    if hist[i] > 0:
        print(f"{edges[i]}-{edges[i+1]}: {hist[i]} ({hist[i]/len(salary_lower)*100:.1f}%)")

# Benefits distribution: group by common categories
print("\n=== Benefits Distribution (grouped) ===")
benefits_list = df_clean['Benefits'].dropna().tolist()
# Common benefit categories mapping
categories = {
    'Five social insurances': 'social insurance',
    'Five social insurances and one housing fund': 'social insurance + housing fund',
    'social insurance': 'social insurance',
    'housing provident fund': 'housing fund',
    'housing fund': 'housing fund',
    'paid annual leave': 'paid leave',
    'holiday benefits': 'holiday benefits',
    'performance bonus': 'bonus',
    'year-end bonus': 'bonus',
    'double pay at the end of the year': 'bonus',
    'overtime pay': 'overtime pay',
    'professional training': 'training',
    'employee travel': 'travel',
    'meal allowance': 'allowance',
    'communication allowance': 'allowance',
    'transportation allowance': 'allowance',
    'business trip allowance': 'allowance',
    'full attendance bonus': 'bonus',
    'commercial insurance': 'insurance',
    'high-temperature allowance': 'allowance',
    'meals provided': 'meals',
}
category_counts = Counter()
for b in benefits_list:
    if isinstance(b, str):
        # Lowercase
        b_lower = b.lower()
        for key, cat in categories.items():
            if key.lower() in b_lower:
                category_counts[cat] += 1
        # Also count 'five social insurances' as separate
        if 'five social insurances' in b_lower:
            category_counts['social insurance'] += 1
        if 'housing provident fund' in b_lower or 'housing fund' in b_lower:
            category_counts['housing fund'] += 1
        if 'paid annual leave' in b_lower:
            category_counts['paid leave'] += 1

print("Benefit category frequencies:")
for cat, count in category_counts.most_common(20):
    print(f"{cat}: {count} ({count/len(df_clean)*100:.1f}%)")

# Factors influencing salary
print("\n=== Factors Influencing Starting Salary (cleaned data) ===")
# Work Experience
print("\n--- Work Experience Requirement (top 10 by avg salary) ---")
exp_groups = df_clean.groupby('Work Experience Requirement')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)
exp_groups = exp_groups[exp_groups['count'] >= 5]  # filter small samples
print(exp_groups.head(10))
# Foreign Language
print("\n--- Foreign Language Requirement (top 10 by avg salary) ---")
lang_groups = df_clean.groupby('Foreign Language Requirement')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)
lang_groups = lang_groups[lang_groups['count'] >= 5]
print(lang_groups.head(10))
# Gender
print("\n--- Gender Requirement ---")
gender_groups = df_clean.groupby('Gender Requirement')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print(gender_groups)
# Age Requirement (simplify)
print("\n--- Age Requirement (common categories) ---")
def age_category(age_str):
    if not isinstance(age_str, str):
        return None
    if '18' in age_str or '20' in age_str:
        return 'young'
    elif '30' in age_str or '35' in age_str or '40' in age_str:
        return 'middle'
    elif '45' in age_str or '50' in age_str:
        return 'older'
    elif 'no limit' in age_str.lower():
        return 'no limit'
    else:
        return 'other'
df_clean['age_cat'] = df_clean['Age Requirement'].apply(age_category)
age_groups = df_clean.groupby('age_cat')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print(age_groups)
# Company Type
print("\n--- Company Type (top 10 by avg salary) ---")
comp_groups = df_clean.groupby('Company Type')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)
comp_groups = comp_groups[comp_groups['count'] >= 5]
print(comp_groups.head(10))
# Industry (first industry)
def first_industry(ind):
    if not isinstance(ind, str):
        return None
    parts = re.split(r'[,，]', ind)
    first = parts[0].strip() if parts else None
    if first and len(first) > 50:
        # too long, truncate
        return first[:50]
    return first
df_clean['industry_first'] = df_clean['Industry'].apply(first_industry)
ind_groups = df_clean.groupby('industry_first')['salary_lower'].agg(['mean', 'count']).sort_values('mean', ascending=False)
ind_groups = ind_groups[ind_groups['count'] >= 5]
print(ind_groups.head(15))

# Correlation with number of openings? Possibly openings indicate demand
print("\n--- Number of Openings vs Salary (aggregated) ---")
# Convert openings to numeric
def parse_openings(open_str):
    if not isinstance(open_str, str):
        return None
    # Extract digits
    match = re.search(r'\d+', open_str)
    if match:
        return int(match.group())
    return None
df_clean['openings_num'] = df_clean['Number of Openings'].apply(parse_openings)
# Bin openings
df_clean['openings_cat'] = pd.cut(df_clean['openings_num'].dropna(), bins=[0,1,5,10,50,1000], labels=['1','2-5','6-10','11-50','>50'])
open_groups = df_clean.groupby('openings_cat')['salary_lower'].agg(['mean', 'count']).dropna()
print(open_groups)

print("\n--- Summary of Qualities that Increase Starting Salaries ---")
print("1. Work Experience: Higher years required → higher salary.")
print("2. Foreign Language: Certain language proficiency (e.g., Cantonese, Spanish, English) associated with higher salaries.")
print("3. Industry: Certain industries like Automotive parts, Intermediary services, Telecommunications pay higher.")
print("4. Age: No clear trend.")
print("5. Gender: Not significant.")
''')
