'''
import pandas as pd
import numpy as np
from sklearn.cluster import KMeans
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.preprocessing import StandardScaler, LabelEncoder
import matplotlib.pyplot as plt
import sqlite3

# Connect to database
db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-076/stage1_env/dacomp-076.sqlite'
conn = sqlite3.connect(db_path)
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
conn.close()

# Compute segment average retention
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'seg_avg_retention']
df = pd.merge(df, segment_avg, on='profitability_segment')
df['deviation'] = abs(df['retention_probability'] - df['seg_avg_retention'])
df['is_anomaly'] = df['deviation'] > 0.15

# Create features for clustering
# 1. transaction stability: transaction_value_volatility (already), also consistency between transaction_count and avg_transactions_per_month
df['trans_consistency_ratio'] = df['transaction_count'] / (df['avg_transactions_per_month'] * 12 + 1e-9)
# 2. seasonal balance: compute entropy of Q1-Q4 distribution
trans_cols = ['q1_transactions', 'q2_transactions', 'q3_transactions', 'q4_transactions']
df['total_seasonal'] = df[trans_cols].sum(axis=1)
# avoid division by zero
df_season = df[trans_cols].div(df['total_seasonal'] + 1e-9, axis=0)
# entropy
from scipy.stats import entropy
df['seasonal_entropy'] = df_season.apply(lambda x: entropy(x.fillna(0)), axis=1)
# 3. value realization alignment: ratio between score and revenue (normalized)
df['score_revenue_ratio'] = df['comprehensive_customer_score'] / (df['total_revenue'] + 1e-9)

# Prepare X for clustering (numeric features)
features = ['transaction_value_volatility', 'trans_consistency_ratio', 'seasonal_entropy', 'score_revenue_ratio', 'retention_probability']
X = df[features].copy()
# Normalize
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# K-means clustering with k=3-5
inertias = []
for k in range(2, 7):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(X_scaled)
    inertias.append(kmeans.inertia_)
    df[f'cluster_k{k}'] = kmeans.labels_

# Decide optimal k via elbow method (just for reference)
plt.figure()
plt.plot(range(2, 7), inertias, marker='o')
plt.xlabel('k')
plt.ylabel('Inertia')
plt.title('Elbow Method for KMeans')
plt.savefig('elbow.png')
plt.close()

# Use k=4 for further analysis
k = 4
kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
df['cluster'] = kmeans.fit_predict(X_scaled)

# Analyze cluster characteristics
cluster_summary = df.groupby('cluster')[features + ['is_anomaly', 'profitability_segment']].agg({
    'transaction_value_volatility': 'mean',
    'trans_consistency_ratio': 'mean',
    'seasonal_entropy': 'mean',
    'score_revenue_ratio': 'mean',
    'retention_probability': 'mean',
    'is_anomaly': 'mean',
}).round(4)
# Count segments per cluster
segment_counts = pd.crosstab(df['cluster'], df['profitability_segment'])
print('Cluster Summary:')
print(cluster_summary)
print('\nSegment Distribution per Cluster:')
print(segment_counts)

# Decision tree to predict anomaly (is_anomaly) using features
le = LabelEncoder()
df['segment_encoded'] = le.fit_transform(df['profitability_segment'])
df['lifecycle_encoded'] = le.fit_transform(df['lifecycle_stage'])
df['seasonal_pref_encoded'] = le.fit_transform(df['seasonal_preference'])
df['consistency_encoded'] = le.fit_transform(df['transaction_consistency'])
df['growth_encoded'] = le.fit_transform(df['growth_potential'])

tree_features = ['transaction_count', 'avg_transactions_per_month', 'transaction_value_volatility',
                 'comprehensive_customer_score', 'total_revenue', 'segment_encoded', 'lifecycle_encoded',
                 'seasonal_pref_encoded', 'consistency_encoded', 'growth_encoded', 'trans_consistency_ratio',
                 'seasonal_entropy', 'score_revenue_ratio']
X_tree = df[tree_features]
y_tree = df['is_anomaly']

tree = DecisionTreeClassifier(max_depth=4, random_state=42)
tree.fit(X_tree, y_tree)

# Feature importances
importances = pd.DataFrame({'feature': tree_features, 'importance': tree.feature_importances_})
importances = importances.sort_values('importance', ascending=False)
print('\nDecision Tree Feature Importances for predicting anomaly:')
print(importances)

# Save results to CSV for inspection
df.to_csv('customer_with_clusters.csv', index=False)
cluster_summary.to_csv('cluster_summary.csv')
segment_counts.to_csv('segment_counts.csv')
importances.to_csv('feature_importance.csv')

print('Analysis saved.')
''')
