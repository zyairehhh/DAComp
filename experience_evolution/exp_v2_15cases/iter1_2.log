import pandas as pd
import matplotlib.pyplot as plt
import sqlite3
import os

# Connect to database
conn = sqlite3.connect('dacomp-069.sqlite')

# Plot 1: Overall performance score over time
query = """
SELECT date_day, overall_performance_score 
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor' 
ORDER BY date_day;
"""
df = pd.read_sql_query(query, conn)
df['date_day'] = pd.to_datetime(df['date_day'])
df.set_index('date_day', inplace=True)

plt.figure(figsize=(10,6))
plt.plot(df.index, df['overall_performance_score'], marker='o', linewidth=2)
plt.title('Overall Performance Score Trend for com.dev.photoeditor', fontsize=16)
plt.xlabel('Date', fontsize=14)
plt.ylabel('Overall Performance Score', fontsize=14)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('overall_performance_trend.png', dpi=300)
plt.close()
print('Plot 1 saved as overall_performance_trend.png')

# Plot 2: Regional revenue contribution (Jan vs Dec) – use finance_report?
# Let's get revenue by region for Jan and Dec 2024
query2 = """
SELECT region, 
       SUM(CASE WHEN strftime('%Y-%m', date_day) = '2024-01' THEN daily_net_revenue ELSE 0 END) as jan_revenue,
       SUM(CASE WHEN strftime('%Y-%m', date_day) = '2024-12' THEN daily_net_revenue ELSE 0 END) as dec_revenue
FROM google_play__finance_report 
WHERE package_name = 'com.dev.photoeditor' 
GROUP BY region;
"""
df2 = pd.read_sql_query(query2, conn)
df2 = df2[df2['region'].notna()]
df2['change_pct'] = (df2['dec_revenue'] - df2['jan_revenue']) / df2['jan_revenue'] * 100

# Bar chart
fig, ax = plt.subplots(figsize=(10,6))
x = range(len(df2))
width = 0.35
bars1 = ax.bar([i - width/2 for i in x], df2['jan_revenue'], width, label='Jan 2024', color='skyblue')
bars2 = ax.bar([i + width/2 for i in x], df2['dec_revenue'], width, label='Dec 2024', color='salmon')
ax.set_xlabel('Region', fontsize=14)
ax.set_ylabel('Revenue (USD)', fontsize=14)
ax.set_title('Revenue by Region: Jan vs Dec 2024', fontsize=16)
ax.set_xticks(x)
ax.set_xticklabels(df2['region'], rotation=45, ha='right')
ax.legend()
ax.grid(axis='y', alpha=0.3)

# Add change percentage on top
for i, row in df2.iterrows():
    ax.text(i, max(row['jan_revenue'], row['dec_revenue']) + 5000, f"{row['change_pct']:.1f}%", ha='center', fontsize=10)

plt.tight_layout()
plt.savefig('revenue_by_region.png', dpi=300)
plt.close()
print('Plot 2 saved as revenue_by_region.png')

# Plot 3: High-revenue vs Low-revenue markets metrics comparison
# Use geo_market_analysis, segment by avg_transaction_value >7 and <3
query3 = """
SELECT 
    CASE 
        WHEN avg_transaction_value > 7 THEN 'High-Revenue Market'
        WHEN avg_transaction_value < 3 THEN 'Low-Revenue Market'
        ELSE 'Mid' 
    END as segment,
    COUNT(DISTINCT country) as country_count,
    AVG(app_quality_score) as avg_quality_score,
    AVG(app_crash_rate_per_1k) as avg_crash_rate,
    AVG(day_1_retention_rate) as avg_day1_retention,
    AVG(daily_churn_rate) as avg_daily_churn,
    AVG(store_conversion_rate) as avg_conversion_rate,
    AVG(weekly_growth_rate) as avg_weekly_growth
FROM google_play__geo_market_analysis
WHERE package_name = 'com.dev.photoeditor' 
    AND (avg_transaction_value > 7 OR avg_transaction_value < 3)
GROUP BY segment;
"""
df3 = pd.read_sql_query(query3, conn)
df3 = df3[df3['segment'] != 'Mid']

# Prepare data for grouped bar chart
metrics = ['avg_quality_score', 'avg_crash_rate', 'avg_day1_retention', 'avg_daily_churn', 'avg_conversion_rate', 'avg_weekly_growth']
labels = ['Quality Score', 'Crash Rate (per 1k)', 'Day-1 Retention (%)', 'Daily Churn (%)', 'Store Conversion (%)', 'Weekly Growth (%)']
high_vals = df3.loc[df3['segment'] == 'High-Revenue Market', metrics].values.flatten()
low_vals = df3.loc[df3['segment'] == 'Low-Revenue Market', metrics].values.flatten()

x = range(len(metrics))
width = 0.35
fig, ax = plt.subplots(figsize=(12,7))
bars1 = ax.bar([i - width/2 for i in x], high_vals, width, label='High-Revenue (>$7)', color='coral')
bars2 = ax.bar([i + width/2 for i in x], low_vals, width, label='Low-Revenue (<$3)', color='lightgreen')
