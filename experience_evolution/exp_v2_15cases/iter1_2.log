for seg in df['profitability_segment'].unique():
    seg_data = df[df['profitability_segment']==seg]
    seg_anom = seg_data[seg_data['is_anomaly']]
    if len(seg_anom) > 0:
        avg_ret = seg_data['retention_probability'].mean()
        avg_anom_ret = seg_anom['retention_probability'].mean()
        direction = "higher" if avg_anom_ret > avg_ret else "lower"
