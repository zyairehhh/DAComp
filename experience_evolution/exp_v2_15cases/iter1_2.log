import sqlite3
import pandas as pd
import re
import numpy as np
from collections import Counter

# Connect to database
db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter1/dacomp-048/stage1_env/dacomp-048.sqlite"
conn = sqlite3.connect(db_path)
query = """
SELECT "Job Title", "Number of Openings", "Company Name", "Employment Type",
       "Work Experience Requirement", "Foreign Language Requirement",
       "Age Requirement", "Gender Requirement", "Education Requirement",
       "Work Location", "Working Hours", "Salary Range", "Benefits",
       "Company Type", "Industry"
FROM sheet1
WHERE "Education Requirement" LIKE '%vocational%'
"""
df = pd.read_sql_query(query, conn)
conn.close()

print(f"Total rows with vocational requirement: {len(df)}")

# Helper to parse salary range lower bound
def parse_salary_lower(salary_str):
    if not isinstance(salary_str, str):
        return None
    # Remove commas, RMB/month, yuan/month, etc.
    s = salary_str.lower()
    # Extract numbers: pattern like 5,000-10,000 or 3000-5000
    # Sometimes includes base salary: "8000-12000 RMB/month (Base salary: 4500-6000 RMB/month + commission)"
    # We'll take the first number before dash (or before dash in base salary if present)
    # If contains base salary, maybe we consider base salary lower? Let's prioritize base salary.
    base_match = re.search(r'base salary:\s*(\d+,?\d*)', s)
    if base_match:
        first_num = base_match.group(1).replace(',', '')
        try:
            return int(first_num)
        except:
            pass
    # Find first number before dash in main range
    # Remove parentheses and extra text
    clean = re.sub(r'\(.*?\)', '', s)
    # Find pattern like 5000-8000
    range_match = re.search(r'(\d+,?\d*)\s*-\s*(\d+,?\d*)', clean)
    if range_match:
        first_num = range_match.group(1).replace(',', '')
        try:
            return int(first_num)
        except:
            pass
    # If only single number (maybe like "5000 yuan/month")
    single_match = re.search(r'(\d+,?\d*)\s*(?:RMB|yuan)', s)
    if single_match:
        first_num = single_match.group(1).replace(',', '')
        try:
            return int(first_num)
        except:
            pass
    return None

df['salary_lower'] = df['Salary Range'].apply(parse_salary_lower)
print(f"Rows with parsed salary: {df['salary_lower'].notna().sum()}")

# Distribution of starting salary
print("\n=== Starting Salary Distribution (approx lower bound) ===")
if df['salary_lower'].notna().any():
    salary_lower = df['salary_lower'].dropna()
    print(f"Count: {len(salary_lower)}")
    print(f"Mean: {salary_lower.mean():.2f}")
    print(f"Median: {salary_lower.median():.2f}")
    print(f"Std: {salary_lower.std():.2f}")
    print(f"Min: {salary_lower.min()}")
    print(f"Max: {salary_lower.max()}")
    # Histogram bins
    bins = [0, 2000, 3000, 4000, 5000, 6000, 8000, 10000, 15000, 20000, 50000]
    hist, edges = np.histogram(salary_lower, bins=bins)
    for i in range(len(hist)):
        if hist[i] > 0:
            print(f"{edges[i]}-{edges[i+1]}: {hist[i]} ({hist[i]/len(salary_lower)*100:.1f}%)")
else:
    print("No salary parsed.")

# Benefits distribution
print("\n=== Benefits Distribution (most common benefits) ===")
benefits_list = df['Benefits'].dropna().tolist()
all_benefits = []
for b in benefits_list:
    # Split by commas, semicolons, etc.
    if isinstance(b, str):
        # Normalize separators
        parts = re.split(r'[,;、，；]', b)
        for part in parts:
            part = part.strip()
            if part:
                all_benefits.append(part)
benefit_counts = Counter(all_benefits)
top_benefits = benefit_counts.most_common(20)
for benefit, count in top_benefits:
    print(f"{benefit}: {count}")

# Analyze factors that can increase salary: work experience, foreign language, age, gender, industry, etc.
# We'll compute average salary for each category
print("\n=== Factors Influencing Starting Salary ===")

# Work Experience Requirement
print("\n--- Work Experience Requirement ---")
exp_groups = df.groupby('Work Experience Requirement')['salary_lower'].mean().dropna().sort_values(ascending=False)
for exp, avg in exp_groups.items():
    print(f"{exp}: {avg:.2f} (count: {df[df['Work Experience Requirement']==exp]['salary_lower'].notna().sum()})")

# Foreign Language Requirement
print("\n--- Foreign Language Requirement ---")
lang_groups = df.groupby('Foreign Language Requirement')['salary_lower'].mean().dropna().sort_values(ascending=False)
for lang, avg in lang_groups.items():
    print(f"{lang}: {avg:.2f} (count: {df[df['Foreign Language Requirement']==lang]['salary_lower'].notna().sum()})")

# Gender Requirement
print("\n--- Gender Requirement ---")
gender_groups = df.groupby('Gender Requirement')['salary_lower'].mean().dropna().sort_values(ascending=False)
for gender, avg in gender_groups.items():
    print(f"{gender}: {avg:.2f} (count: {df[df['Gender Requirement']==gender]['salary_lower'].notna().sum()})")

# Employment Type
print("\n--- Employment Type ---")
emp_groups = df.groupby('Employment Type')['salary_lower'].mean().dropna().sort_values(ascending=False)
for emp, avg in emp_groups.items():
    print(f"{emp}: {avg:.2f} (count: {df[df['Employment Type']==emp]['salary_lower'].notna().sum()})")

# Industry (simplified)
print("\n--- Industry (top 10 by avg salary) ---")
# Flatten industries separated by commas?
# For simplicity, we take first industry if multiple
def first_industry(ind):
    if not isinstance(ind, str):
        return None
    # Split by commas and take first
    parts = re.split(r',', ind)
    return parts[0].strip() if parts else None
df['industry_first'] = df['Industry'].apply(first_industry)
ind_groups = df.groupby('industry_first')['salary_lower'].mean().dropna().sort_values(ascending=False)
for i, (ind, avg) in enumerate(ind_groups.items()):
    if i >= 10:
        break
    count = df[df['industry_first']==ind]['salary_lower'].notna().sum()
    print(f"{ind}: {avg:.2f} (count: {count})")

print("\nAnalysis complete.")
```
