import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-078.sqlite')
df_account = pd.read_sql_query('SELECT * FROM pendo__account', conn)
numeric_cols = df_account.select_dtypes(include=[np.number]).columns
corr_matrix = df_account[numeric_cols].corr()
print("Correlation matrix (top 10x10):")
print(corr_matrix.iloc[:10, :10])
print("\nCorrelation with avg_nps_rating:")
print(corr_matrix['avg_nps_rating'].sort_values(ascending=False))
```
