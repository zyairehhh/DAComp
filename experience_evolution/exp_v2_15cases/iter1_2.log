import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

conn = sqlite3.connect('dacomp-093.sqlite')
query = "SELECT * FROM klaviyo__campaigns"
df = pd.read_sql_query(query, conn)
conn.close()

# Remove rows with missing open rate or click rate
df = df.dropna(subset=['email_open_rate', 'email_click_to_open_rate'])

# Compute derived metrics
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open'] = df['count_clicked_email'] / df['count_opened_email']

# Extract timing info from campaign_name
def extract_timing(campaign_name):
    weekday_weekend = None
    time_of_day = None
    holiday = None
    if isinstance(campaign_name, str):
        # pattern like [工作日-上午], [周末-下午], [节前-下午]
        m = re.search(r'\[([^\]]+)\]', campaign_name)
        if m:
            inside = m.group(1)
            if '工作日' in inside:
                weekday_weekend = 'weekday'
            elif '周末' in inside:
                weekday_weekend = 'weekend'
            elif '节前' in inside:
                weekday_weekend = 'pre-holiday'
                holiday = 'pre-holiday'
            elif '节后' in inside:
                weekday_weekend = 'post-holiday'
                holiday = 'post-holiday'
            else:
                pass
            if '上午' in inside:
                time_of_day = 'morning'
            elif '下午' in inside:
                time_of_day = 'afternoon'
            elif '晚间' in inside:
                time_of_day = 'evening'
        # If holiday not set, set default
        if holiday is None:
            holiday = 'non-holiday'
    return weekday_weekend, time_of_day, holiday

df[['weekday_weekend', 'time_of_day', 'holiday']] = df['campaign_name'].apply(
    lambda x: pd.Series(extract_timing(x))
)

# Extract subject category from SUBJECT
def extract_subject_category(subject):
    if isinstance(subject, str):
        if '限时折扣' in subject:
            return 'discount'
        elif '新品上新' in subject:
            return 'new'
        elif '品牌故事' in subject:
            return 'storytelling'
    return None

df['subject_category'] = df['SUBJECT'].apply(extract_subject_category)

# Filter out rows where category is missing
df = df.dropna(subset=['subject_category', 'weekday_weekend', 'time_of_day'])

# De-noising: remove outliers in count_received_email (using IQR)
Q1 = df['count_received_email'].quantile(0.25)
Q3 = df['count_received_email'].quantile(0.75)
IQR = Q3 - Q1
lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR
df = df[(df['count_received_email'] >= lower) & (df['count_received_email'] <= upper)]

print(f"Filtered dataset size: {len(df)}")
print(df['subject_category'].value_counts())

# Plot 1: Open Rate by Subject Category and is_archived
fig, ax = plt.subplots(figsize=(10, 6))
for archived in df['is_archived'].unique():
    subset = df[df['is_archived'] == archived]
    cat_means = subset.groupby('subject_category')['open_rate'].mean()
    cat_means.plot(kind='bar', ax=ax, label=f"archived={archived}", alpha=0.7, position=0 if archived else 1)
ax.set_xlabel('Subject Category')
ax.set_ylabel('Mean Open Rate')
ax.set_title('Open Rate by Subject Category and Archived Status')
ax.legend()
plt.tight_layout()
plt.savefig('open_rate_by_subject_archived_v2.png')
plt.close()

# Plot 2: Click-to-Open Rate by Time of Day and Weekday/Weekend
df_time = df.dropna(subset=['time_of_day', 'weekday_weekend'])
pivot = df_time.pivot_table(values='click_to_open', index='time_of_day', columns='weekday_weekend', aggfunc='mean')
fig, ax = plt.subplots(figsize=(8,6))
pivot.plot(kind='bar', ax=ax)
ax.set_xlabel('Time of Day')
ax.set_ylabel('Mean Click-to-Open Rate')
ax.set_title('Click-to-Open Rate by Time of Day and Weekday/Weekend')
plt.tight_layout()
plt.savefig('click_to_open_by_time_weekday_v2.png')
plt.close()

# Plot 3: Heatmap of Open Rate across Weekday/Weekend and Subject Category
heat_data = df.pivot_table(values='open_rate', index='subject_category', columns='weekday_weekend', aggfunc='mean')
fig, ax = plt.subplots(figsize=(8,6))
im = ax.imshow(heat_data, cmap='RdYlGn', aspect='auto')
ax.set_xticks(np.arange(len(heat_data.columns)))
ax.set_yticks(np.arange(len(heat_data.index)))
ax.set_xticklabels(heat_data.columns)
ax.set_yticklabels(heat_data.index)
plt.setp(ax.get_xticklabels(), ha="right", rotation_mode="anchor")
for i in range(len(heat_data.index)):
    for j in range(len(heat_data.columns)):
        text = ax.text(j, i, f"{heat_data.iloc[i, j]:.3f}", ha="center", va="center", color="black")
ax.set_title('Open Rate Heatmap: Subject Category vs Weekday/Weekend')
fig.colorbar(im, ax=ax)
plt.tight_layout()
plt.savefig('open_rate_heatmap_v2.png')
plt.close()

# Plot 4: Scatter Open Rate vs Audience Size (controlled) colored by Subject Category
fig, ax = plt.subplots(figsize=(10,6))
for cat in df['subject_category'].unique():
    subset = df[df['subject_category'] == cat]
    ax.scatter(subset['total_count_unique_people'], subset['open_rate'], label=cat, alpha=0.6)
ax.set_xlabel('Audience Size (total_count_unique_people)')
ax.set_ylabel('Open Rate')
ax.set_title('Open Rate vs Audience Size by Subject Category')
ax.legend()
plt.tight_layout()
plt.savefig('open_rate_vs_audience_v2.png')
plt.close()

# Plot 5: Interaction of Variation ID and Holiday timing on Click Rate
df_var = df.dropna(subset=['variation_id', 'holiday'])
var_holiday_means = df_var.groupby(['variation_id', 'holiday'])['click_rate'].mean().unstack()
fig, ax = plt.subplots(figsize=(10,6))
var_holiday_means.plot(kind='bar', ax=ax)
ax.set_xlabel('Variation ID')
ax.set_ylabel('Mean Click Rate')
ax.set_title('Click Rate by Variation ID and Holiday Timing')
plt.tight_layout()
plt.savefig('click_rate_variation_holiday_v2.png')
plt.close()

# Additional plot: Open Rate by Holiday timing and Subject Category
df_hol = df.dropna(subset=['holiday', 'subject_category'])
hol_cat_means = df_hol.groupby(['holiday', 'subject_category'])['open_rate'].mean().unstack()
fig, ax = plt.subplots(figsize=(10,6))
hol_cat_means.plot(kind='bar', ax=ax)
ax.set_xlabel('Holiday Timing')
ax.set_ylabel('Mean Open Rate')
ax.set_title('Open Rate by Holiday Timing and Subject Category')
plt.tight_layout()
plt.savefig('open_rate_holiday_subject.png')
plt.close()

# Save processed data
df.to_csv('processed_campaigns_v2.csv', index=False)

print("Plots generated.")
```
