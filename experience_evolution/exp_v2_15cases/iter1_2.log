import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('/workspace/mart.db')

# Query to join conversations, leads, conversions on lead_id
query = """
SELECT 
    c.conversation_id,
    c.lead_id,
    c.initiated_at,
    c.first_response_at,
    c.responder_type,
    c.conversation_template_id,
    c.intent_label,
    l.lead_source,
    l.industry,
    l.region,
    cv.demo_booked_at,
    cv.trial_activated_at,
    cv.paid_at
FROM conversations c
LEFT JOIN leads l ON c.lead_id = l.lead_id
LEFT JOIN conversions cv ON c.lead_id = cv.lead_id
"""
df = pd.read_sql_query(query, conn)
conn.close()

print("Total rows:", len(df))
print(df.head())
print("\nResponder type counts:")
print(df['responder_type'].value_counts(dropna=False))
print("\nMissing values per column:")
print(df.isnull().sum())

# Convert date columns to datetime
date_cols = ['initiated_at', 'first_response_at', 'demo_booked_at', 'trial_activated_at', 'paid_at']
for col in date_cols:
    df[col] = pd.to_datetime(df[col], errors='coerce')

# Calculate time differences in days
df['first_response_to_demo_days'] = (df['demo_booked_at'] - df['first_response_at']).dt.total_seconds() / (24*3600)
df['demo_to_trial_days'] = (df['trial_activated_at'] - df['demo_booked_at']).dt.total_seconds() / (24*3600)
df['trial_to_paid_days'] = (df['paid_at'] - df['trial_activated_at']).dt.total_seconds() / (24*3600)

# Define conversion flags
df['demo_booked'] = df['demo_booked_at'].notnull()
df['trial_activated'] = df['trial_activated_at'].notnull()
df['paid'] = df['paid_at'].notnull()

print("\nConversion flags summary:")
print("Demo booked:", df['demo_booked'].sum())
print("Trial activated:", df['trial_activated'].sum())
print("Paid:", df['paid'].sum())

# Save to CSV for further analysis
df.to_csv('/workspace/joined_data.csv', index=False)
print("Saved to /workspace/joined_data.csv")
```



