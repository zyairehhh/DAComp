import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.font_manager import FontProperties

# Suppress warnings about font
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-078.sqlite')

# Load account data
df = pd.read_sql_query("SELECT * FROM pendo__account", conn)

# Parse date columns
df['first_event_on'] = pd.to_datetime(df['first_event_on'])
df['last_event_on'] = pd.to_datetime(df['last_event_on'])

# Derived features as per report
# Reference date for recency calculation (2024-12-01 as mentioned in report)
reference_date = pd.Timestamp('2024-12-01')
df['recency'] = (reference_date - df['last_event_on']).dt.days
# Activity density: count_active_days / total_span_days
df['total_span_days'] = (df['last_event_on'] - df['first_event_on']).dt.days + 1
df['activity_density'] = df['count_active_days'] / df['total_span_days']
df['minutes_per_active_day'] = df['sum_minutes'] / df['count_active_days'].replace(0, np.nan)

# Close connection
conn.close()

# Create visualizations

# 1. Dimension Weights Bar Chart
plt.figure(figsize=(10, 6))
dimensions = ['sum_minutes', 'sum_events', 'avg_nps_rating', 
              'count_feature_clicking_visitors', 'count_active_days', 'count_active_months']
weights = [0.263, 0.263, 0.167, 0.134, 0.088, 0.085]

bars = plt.bar(dimensions, weights, color='steelblue')
plt.title('Dimension Weights in Customer Value Score', fontsize=14)
plt.xlabel('Dimension', fontsize=12)
plt.ylabel('Weight', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.ylim(0, 0.3)
plt.grid(axis='y', alpha=0.3)

# Add value labels on bars
for bar, weight in zip(bars, weights):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.005,
             f'{weight:.3f}', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('dimension_weights.png', dpi=300)
plt.close()

# 2. Correlation of Dimensions with Composite Target
plt.figure(figsize=(10, 6))
correlations = [0.908, 0.909, 0.575, 0.463, 0.302, 0.294]

