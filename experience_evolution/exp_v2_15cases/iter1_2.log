# Connect to database
conn = sqlite3.connect('dacomp-058.sqlite')

# Load campaign report data
query = """
SELECT * FROM google_ads__campaign_report
"""
df = pd.read_sql_query(query, conn)

print("Dataset shape:", df.shape)
print("\nFirst few rows:")
print(df.head())

print("\nDate range:", df['year_month'].min(), "to", df['year_month'].max())

# Calculate ROI (assuming roas is ROAS, ROI = ROAS - 1? Actually task uses ROI < 0.8, maybe ROI = conversion_value / cost?)
# In Google Ads, ROAS = conversion_value / cost, so ROI = ROAS - 1? 
# For ROI < 0.8, maybe they mean ROAS < 0.8? Let's assume ROI = roas
print("\nDescriptive statistics for cost:")
print(df['cost'].describe())

print("\nDescriptive statistics for roas:")
print(df['roas'].describe())

# Identify high-cost, low-ROI months
df['monthly_cost'] = df['cost']
high_cost_low_roi = df[(df['monthly_cost'] > 1000) & (df['roas'] < 0.8)]
print(f"\nNumber of campaign-months with cost > $1000 and ROI < 0.8: {len(high_cost_low_roi)}")
print(f"Unique campaigns in this set: {high_cost_low_roi['campaign_id'].nunique()}")

# Group by campaign to see overall campaign performance
campaign_stats = df.groupby(['campaign_id', 'campaign_name', 'campaign_type', 'bidding_strategy', 'industry']).agg(
    total_cost=('cost', 'sum'),
    avg_roas=('roas', 'mean'),
    avg_quality_score=('quality_score', 'mean'),
    avg_impression_share=('impression_share', 'mean'),
    avg_ctr=('ctr', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean'),
    total_conversions=('conversions', 'sum')
).reset_index()

print("\nCampaign-level statistics (first 10):")
print(campaign_stats.head(10))

conn.close()
```
