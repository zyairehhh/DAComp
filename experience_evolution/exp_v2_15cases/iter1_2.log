'''
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-092.sqlite')

# Load high-volatility customers
high_vol = pd.read_csv('high_vol_customers.csv')
high_vol_ids = high_vol['customer_id'].tolist()
print(f"Number of high-volatility customers: {len(high_vol_ids)}")

# Get monthly revenue per customer (using revenue_month_start? use transaction_date aggregated by month)
# We'll use invoice_total as revenue measure.
query = """
    SELECT customer_id, 
           strftime('%Y-%m', transaction_date) as month,
           SUM(invoice_total) as revenue
    FROM quickbooks__profitability_analysis
    GROUP BY customer_id, month
"""
df_month = pd.read_sql_query(query, conn)
print(f"Monthly revenue rows: {df_month.shape[0]}")

# Determine high-volatility flag
df_month['is_high_vol'] = df_month['customer_id'].isin(high_vol_ids)

# Compute total revenue per month
total_month = df_month.groupby('month')['revenue'].sum().reset_index()
total_month.columns = ['month', 'total_revenue']
# Compute high-volatility revenue per month
high_vol_month = df_month[df_month['is_high_vol']].groupby('month')['revenue'].sum().reset_index()
high_vol_month.columns = ['month', 'high_vol_revenue']

# Merge
monthly_summary = pd.merge(total_month, high_vol_month, on='month', how='left')
monthly_summary['high_vol_revenue'] = monthly_summary['high_vol_revenue'].fillna(0)
monthly_summary['high_vol_share'] = monthly_summary['high_vol_revenue'] / monthly_summary['total_revenue']

print("Monthly share of high-volatility customers:")
print(monthly_summary.head())

# Load financial_dashboard
dash = pd.read_sql_query("SELECT dashboard_month, business_health_score, collection_rate_percentage FROM quickbooks__financial_dashboard", conn)
dash['dashboard_month'] = pd.to_datetime(dash['dashboard_month'])
dash['month'] = dash['dashboard_month'].dt.strftime('%Y-%m')
# Merge with monthly_summary
merged_dash = pd.merge(dash, monthly_summary, on='month', how='inner')
print(f"Merged dashboard rows: {merged_dash.shape[0]}")

# Compute correlation between high_vol_share and business_health_score, collection_rate_percentage
corr_health = merged_dash['high_vol_share'].corr(merged_dash['business_health_score'])
corr_collect = merged_dash['high_vol_share'].corr(merged_dash['collection_rate_percentage'])
print(f"Correlation between high-volatility share and business_health_score: {corr_health:.4f}")
print(f"Correlation between high-volatility share and collection_rate_percentage: {corr_collect:.4f}")

# Additional: average business_health_score for top quartile vs bottom quartile of high_vol_share
merged_dash['share_quartile'] = pd.qcut(merged_dash['high_vol_share'], q=4, labels=['Q1','Q2','Q3','Q4'])
avg_health_by_q = merged_dash.groupby('share_quartile')['business_health_score'].mean()
avg_collect_by_q = merged_dash.groupby('share_quartile')['collection_rate_percentage'].mean()
print("\\nAverage business_health_score by high-volatility share quartile:")
print(avg_health_by_q)
print("\\nAverage collection_rate_percentage by high-volatility share quartile:")
print(avg_collect_by_q)

# Save merged data
merged_dash.to_csv('dashboard_high_vol_merged.csv', index=False)
print("Saved merged dashboard data.")

conn.close()
''')
