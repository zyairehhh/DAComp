'''
import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
# Get visitor to account mapping
visitor_account = pd.read_sql('SELECT visitor_id, account_id FROM pendo__visitor', conn)
daily = pd.read_sql('SELECT * FROM pendo__visitor_daily_metrics', conn)
daily['date_day'] = pd.to_datetime(daily['date_day'])
daily = daily.merge(visitor_account, on='visitor_id', how='left')
# Split into first half (Jan-Jun) and second half (Jul-Sep)
first_half = daily[(daily['date_day'] >= '2024-01-04') & (daily['date_day'] < '2024-07-01')]
second_half = daily[(daily['date_day'] >= '2024-07-01') & (daily['date_day'] <= '2024-09-28')]
first_agg = first_half.groupby('account_id').agg({'sum_minutes': 'sum', 'sum_events': 'sum'}).reset_index()
second_agg = second_half.groupby('account_id').agg({'sum_minutes': 'sum', 'sum_events': 'sum'}).reset_index()
first_agg.columns = ['account_id', 'first_minutes', 'first_events']
second_agg.columns = ['account_id', 'second_minutes', 'second_events']
trend = pd.merge(first_agg, second_agg, on='account_id', how='inner')
trend['minutes_growth'] = (trend['second_minutes'] - trend['first_minutes']) / (trend['first_minutes'] + 1e-6)
trend['events_growth'] = (trend['second_events'] - trend['first_events']) / (trend['first_events'] + 1e-6)
print('Number of accounts with daily data:', len(trend))
print(trend.head())
# Merge with account features
accounts = pd.read_sql('SELECT account_id, sum_minutes, sum_events, avg_nps_rating, count_active_days, count_feature_clicking_visitors, count_active_months FROM pendo__account', conn)
trend = trend.merge(accounts, on='account_id', how='left')
# Compute correlations
print('Correlation with minutes_growth:')
for col in ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors', 'count_active_months']:
    corr = trend[col].corr(trend['minutes_growth'])
    print(f'{col}: {corr:.3f}')
# Also compute correlation with events_growth
print('Correlation with events_growth:')
for col in ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors', 'count_active_months']:
    corr = trend[col].corr(trend['events_growth'])
    print(f'{col}: {corr:.3f}')
