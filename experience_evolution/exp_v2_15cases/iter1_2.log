  END as rating_bucket,
  COUNT(*) as num_rides,
  AVG("Driver Ratings") as avg_rating,
  AVG("Booking Value" / "Ride Distance") as avg_per_km_fare,
  AVG("Booking Value") as avg_booking_value,
  AVG("Ride Distance") as avg_ride_distance
