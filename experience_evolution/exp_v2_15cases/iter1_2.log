import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import sqlite3
from matplotlib import font_manager
import os

# Connect to database
conn = sqlite3.connect('dacomp-035.sqlite')

# Query 1: Department abnormal login counts
df1 = pd.read_csv('department_counts.csv')
# Sort by count descending
df1 = df1.sort_values('Abnormal_Login_Count', ascending=False)

# Plot 1: Bar chart of abnormal logins by department
plt.figure(figsize=(10, 6))
bars = plt.bar(df1['Department'], df1['Abnormal_Login_Count'], color='skyblue')
plt.title('Abnormal Login Counts by Department', fontsize=16, fontweight='bold')
plt.xlabel('Department', fontsize=12)
plt.ylabel('Number of Abnormal Logins', fontsize=12)
plt.xticks(rotation=45, ha='right')
# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{int(height)}', ha='center', va='bottom')
plt.tight_layout()
plt.savefig('plots/department_abnormal_counts.png', dpi=300)
plt.close()

# Query 2: Risk level distribution by department
df2 = pd.read_csv('risk_by_department.csv')
# Pivot for stacked bar
pivot_df = df2.pivot(index='Department', columns='Risk Level', values='count').fillna(0)

# Sort departments by total abnormal logins
dept_order = df1.set_index('Department').loc[pivot_df.index, 'Abnormal_Login_Count'].sort_values(ascending=False).index
pivot_df = pivot_df.reindex(dept_order)

# Plot 2: Stacked bar chart of risk levels by department
plt.figure(figsize=(12, 7))
bottom_vals = np.zeros(len(pivot_df))
risk_levels = ['Low', 'Medium', 'High', 'Severe']  # Assuming these are the categories
colors = ['#90EE90', '#FFD700', '#FFA07A', '#FF6347']  # Light green, gold, light salmon, tomato red

for risk, color in zip(risk_levels, colors):
    if risk in pivot_df.columns:
        plt.bar(pivot_df.index, pivot_df[risk], bottom=bottom_vals, label=risk, color=color)
        bottom_vals += pivot_df[risk].values

plt.title('Risk Level Distribution by Department', fontsize=16, fontweight='bold')
plt.xlabel('Department', fontsize=12)
plt.ylabel('Number of Abnormal Logins', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('plots/risk_distribution_by_department.png', dpi=300)
plt.close()

# Query 3: Abnormal logins over time
df3 = pd.read_sql_query("""
    SELECT a."Detection Time", u.Department, 
           COUNT(*) as count
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    JOIN user_information_table u ON l."User ID" = u."User ID"
    GROUP BY DATE(a."Detection Time"), u.Department
    ORDER BY DATE(a."Detection Time")
""", conn)

# Convert to datetime
df3['Detection Time'] = pd.to_datetime(df3['Detection Time'])
df3['Date'] = df3['Detection Time'].dt.date

# Get top 3 departments by total count for clearer visualization
top_depts = df1.head(3)['Department'].tolist()
df3_top = df3[df3['Department'].isin(top_depts)]

# Pivot for line chart
pivot_time = df3_top.pivot_table(index='Date', columns='Department', values='count', aggfunc='sum').fillna(0)

# Plot 3: Line chart of abnormal logins over time for top departments
plt.figure(figsize=(12, 7))
for dept in top_depts:
    if dept in pivot_time.columns:
        plt.plot(pivot_time.index, pivot_time[dept], marker='o', label=dept, linewidth=2)

plt.title('Trend of Abnormal Logins Over Time (Top 3 Departments)', fontsize=16, fontweight='bold')
plt.xlabel('Date', fontsize=12)
plt.ylabel('Number of Abnormal Logins', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('plots/abnormal_logins_trend.png', dpi=300)
plt.close()

# Query 4: Anomaly score comparison by department
df4 = pd.read_sql_query("""
    SELECT u.Department, 
           AVG(a."Anomaly Score") as avg_anomaly_score,
           AVG(a."Device Anomaly Indicators") as avg_device_score,
           AVG(a."Network Anomaly Indicators") as avg_network_score,
           AVG(a."Behavior Anomaly Indicators") as avg_behavior_score
    FROM abnormal_logins_table a
    JOIN login_records_table l ON a."Login Record ID" = l."Login Record ID"
    JOIN user_information_table u ON l."User ID" = u."User ID"
    GROUP BY u.Department
    ORDER BY avg_anomaly_score DESC
""", conn)

# Plot 4: Radar/spider chart for anomaly scores (simplified to grouped bar)
departments = df4['Department']
