        print(f"Weekend events: {(~events_df['is_weekday']).sum()}")
        
        # 2. Morning (0-12h) vs Afternoon (12-24h)
        events_df['hour'] = events_df['occurred_at'].dt.hour
        events_df['time_window'] = events_df['hour'].apply(
