import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-078.sqlite')
df = pd.read_sql('SELECT * FROM pendo__account', conn)
# Define composite target (normalized sum)
def norm(x):
    return (x - x.mean()) / x.std()
target = norm(df['sum_minutes']) + norm(df['sum_events']) + norm(df['avg_nps_rating'])
features = ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days',
            'count_feature_clicking_visitors', 'count_active_months']
# Compute correlation with target
corrs = {}
for f in features:
    corrs[f] = df[f].corr(target)
print('Correlation with composite target:')
for f, c in corrs.items():
    print(f'{f}: {c:.3f}')
# Use absolute correlation as weight (scaled to sum 1)
abs_corr = np.abs([corrs[f] for f in features])
weights = abs_corr / abs_corr.sum()
print('Suggested weights (proportional to absolute correlation):')
for f, w in zip(features, weights):
    print(f'{f}: {w:.3f}')
# Compute weighted score
scaled = df[features].apply(norm, axis=0)
score = np.dot(scaled.values, weights)
df['score'] = score
# Evaluate classification accuracy (top 20% of target vs top 20% of score)
top_target = target >= target.quantile(0.8)
top_score = df['score'] >= df['score'].quantile(0.8)
acc = (top_target == top_score).mean()
print('Accuracy of weighted score vs composite target:', acc)
# Confusion
print('Confusion matrix:')
print(pd.crosstab(top_target, top_score, rownames=['True'], colnames=['Predicted']))
# Compare with old model (minutes only)
old_top = df['sum_minutes'] >= df['sum_minutes'].quantile(0.8)
old_acc = (top_target == old_top).mean()
print('Old model (minutes only) accuracy:', old_acc)
print('Improvement:', acc - old_acc)
''')
