import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from datetime import datetime

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Regional conversion rate trends plot
query = """
SELECT date_day, region, store_listing_conversion_rate 
FROM google_play__country_report 
WHERE region IN ('Asia', 'Europe', 'North America', 'South America')
ORDER BY date_day
"""
df = pd.read_sql_query(query, conn)
df['date_day'] = pd.to_datetime(df['date_day'])

# Calculate daily average per region
daily_avg = df.groupby(['date_day', 'region'])['store_listing_conversion_rate'].mean().reset_index()

plt.figure(figsize=(10, 6))
for region in daily_avg['region'].unique():
    region_data = daily_avg[daily_avg['region'] == region]
    plt.plot(region_data['date_day'], region_data['store_listing_conversion_rate'], 
             label=region, marker='o', markersize=2, linewidth=1)

plt.xlabel('Date')
plt.ylabel('Store Listing Conversion Rate')
plt.title('Conversion Rate Trends by Region (Apr-Oct 2024)')
plt.legend()
plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%b-%Y'))
plt.gca().xaxis.set_major_locator(mdates.MonthLocator())
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('regional_conversion_trends.png', dpi=300)
plt.close()

# 2. Device install intensity trends (proxy for device acquisition efficiency)
query_device = """
SELECT date_day, device, install_events, active_devices_last_30_days 
FROM google_play__device_report 
WHERE device IN (
    'Samsung Galaxy A54',
    'OnePlus 11',
    'Motorola Moto G Stylus',
    'Pixel 7a',
    'iPhone 15 Pro Max',
    'iPhone X',
    'Google Pixel 6 Pro',
    'OnePlus Nord CE 3',
    'Samsung Galaxy S23 Ultra',
    'Samsung Galaxy A23',
    'LG V60 ThinQ',
    'iPhone Pro 14'
) AND active_devices_last_30_days > 0
ORDER BY date_day
"""
df_device = pd.read_sql_query(query_device, conn)
df_device['date_day'] = pd.to_datetime(df_device['date_day'])
df_device['install_intensity'] = df_device['install_events'] / df_device['active_devices_last_30_days']

# Calculate 7-day moving average for each device
df_device['install_intensity_ma7'] = df_device.groupby('device')['install_intensity'].transform(
    lambda x: x.rolling(7, min_periods=1).mean()
)

plt.figure(figsize=(12, 6))
for device in df_device['device'].unique():
    device_data = df_device[df_device['device'] == device]
    plt.plot(device_data['date_day'], device_data['install_intensity_ma7'], 
             label=device, linewidth=1)

plt.xlabel('Date')
plt.ylabel('Install Intensity (7-day MA)')
plt.title('Device-Level Install Intensity Trends (Apr-Oct 2024)')
plt.legend(fontsize=8, ncol=2)
plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%b-%Y'))
plt.gca().xaxis.set_major_locator(mdates.MonthLocator())
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('device_install_intensity_trends.png', dpi=300)
plt.close()

conn.close()
