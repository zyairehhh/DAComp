import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversations
conv_query = """
    SELECT company_id,
           all_conversation_tags,
           conversation_created_at,
           conversation_last_updated_at
    FROM intercom__conversation_enhanced
    WHERE company_id IS NOT NULL AND company_id != ''
"""
conv_df = pd.read_sql_query(conv_query, conn)

# Parse tags
def extract_tag(tags, key):
    if not isinstance(tags, str):
        return None
    start = tags.find(key + ':')
    if start == -1:
        return None
    start += len(key) + 1
    end = tags.find('|', start)
    if end == -1:
        return tags[start:]
    else:
        return tags[start:end]

conv_df['path'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'path'))
conv_df['intent'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent'))
conv_df['stage'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage'))

# Identify responder group per company: bot-led if any conversation path='bot_first'
company_first_response = conv_df.groupby('company_id')['path'].apply(lambda x: 'bot' if (x == 'bot_first').any() else ('human' if (x == 'human_first').any() else None)).reset_index()
company_first_response = company_first_response.dropna()
company_response_counts = conv_df.groupby('company_id')['path'].apply(lambda x: ((x == 'bot_first').any(), (x == 'human_first').any())).reset_index()
company_response_counts.columns = ['company_id', 'has_bot', 'has_human']
print("Companies with bot/human:", company_response_counts.head())

# Actually we need to classify as per Stage1: bot-led if any bot_first, else human-led.
conv_df['responder_group'] = conv_df['path'].apply(lambda x: 'bot' if x == 'bot_first' else ('human' if x == 'human_first' else None))
company_first_response = conv_df.dropna(subset=['responder_group']).groupby('company_id')['responder_group'].apply(lambda x: 'bot' if (x == 'bot').any() else ('human' if (x == 'human').any() else None)).reset_index()
company_first_response = company_first_response.dropna()
company_first_response.columns = ['company_id', 'responder_group']

# Get stage timestamps per company
# We'll assume the latest conversation with each stage tag as the timestamp for that stage
# Actually we need timestamps for demo_booked, trial_activated, closed_won
# For simplicity, we'll take the max conversation_last_updated_at where stage contains the keyword.
def get_stage_timestamp(df, stage_keyword):
    stage_rows = df[df['stage'].notna() & df['stage'].str.contains(stage_keyword)]
    if stage_rows.empty:
        return None
    # take earliest timestamp? stage1 used first_response_at etc. We'll use conversation_created_at as proxy.
    # Use min conversation_created_at for that stage.
    return stage_rows['conversation_created_at'].min()

company_stages = conv_df.groupby('company_id').apply(lambda grp: pd.Series({
    'demo_booked_at': get_stage_timestamp(grp, 'demo_booked'),
    'trial_activated_at': get_stage_timestamp(grp, 'trial_activated'),
    'closed_won_at': get_stage_timestamp(grp, 'closed_won')
})).reset_index()

# Merge responder group
company_data = pd.merge(company_first_response, company_stages, on='company_id', how='left')

# Determine conversion flags
company_data['has_demo'] = company_data['demo_booked_at'].notna()
company_data['has_trial'] = company_data['trial_activated_at'].notna()
company_data['has_paid'] = company_data['closed_won_at'].notna()

# Compute conversion rates per responder group
group_stats = company_data.groupby('responder_group').agg(
    total_companies=('company_id', 'count'),
    demo_count=('has_demo', 'sum'),
    trial_count=('has_trial', 'sum'),
    paid_count=('has_paid', 'sum')
).reset_index()

group_stats['demo_rate'] = group_stats['demo_count'] / group_stats['total_companies']
group_stats['trial_rate_given_demo'] = group_stats['trial_count'] / group_stats['demo_count']
group_stats['paid_rate_given_trial'] = group_stats['paid_count'] / group_stats['trial_count']

print("Conversion rates:")
print(group_stats.to_string())

# Plot conversion rates
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Bar chart: demo_rate, trial_rate_given_demo, paid_rate_given_trial
x = np.arange(len(group_stats))
width = 0.25
axes[0,0].bar(x - width, group_stats['demo_rate'], width, label='Demo Rate', color='skyblue')
axes[0,0].bar(x, group_stats['trial_rate_given_demo'], width, label='Trial Rate (given demo)', color='lightgreen')
axes[0,0].bar(x + width, group_stats['paid_rate_given_trial'], width, label='Paid Rate (given trial)', color='salmon')
axes[0,0].set_xticks(x)
axes[0,0].set_xticklabels(group_stats['responder_group'])
axes[0,0].set_ylabel('Rate')
axes[0,0].set_title('Conversion Rates by Responder Group')
axes[0,0].legend()
axes[0,0].grid(axis='y', linestyle='--', alpha=0.7)

# Count of companies
axes[0,1].bar(group_stats['responder_group'], group_stats['total_companies'], color='teal')
axes[0,1].set_ylabel('Number of Companies')
axes[0,1].set_title('Company Count by Responder Group')
axes[0,1].grid(axis='y', linestyle='--', alpha=0.7)

# Intent distribution
# Use conversation-level data with responder_group per conversation (path)
conv_df['responder_group_conv'] = conv_df['path'].map({'bot_first':'bot', 'human_first':'human'})
intent_counts = conv_df[conv_df['intent'].notna()].groupby(['responder_group_conv', 'intent']).size().unstack(fill_value=0)
# Sum across paths
intent_totals = intent_counts.sum(axis=0).sort_values(ascending=False)
top_intents = intent_totals.head(8).index.tolist()
