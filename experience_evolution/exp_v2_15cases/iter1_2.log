import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime
import matplotlib.pyplot as plt

# Connect to the database
conn = sqlite3.connect('dacomp-094.sqlite')

# First, let's examine all the data we have
print("=== DATABASE OVERVIEW ===")
tables = pd.read_sql_query("SELECT name FROM sqlite_master WHERE type='table'", conn)
print("Tables in database:")
print(tables)

# Show table schemas and record counts
for table_name in tables['name'].tolist():
    print(f"\n--- {table_name} ---")
    counts = pd.read_sql_query(f"SELECT COUNT(*) as cnt FROM {table_name}", conn)
    print(f"Record count: {counts['cnt'][0]}")
    if counts['cnt'][0] > 0:
        sample = pd.read_sql_query(f"SELECT * FROM {table_name} LIMIT 3", conn)
        print("Sample data (first 3 rows):")
        print(sample.to_string())

# Let's merge insights from persons and campaign flow
print("\n=== JOINED ANALYSIS ===")

# Get person retention metrics with campaign interactions
query = """
SELECT 
    p.person_id,
    p.active_retention_rate_week,
    p.active_retention_rate_month,
    p.email_open_rate as person_open_rate,
    p.count_opened_email,
    p.count_clicked_email,
    p.count_received_email,
    f.last_touch_campaign_id,
    f.email_open_rate_touch,
    f.email_click_to_open_rate_touch,
    f.has_converted
FROM klaviyo__persons p
LEFT JOIN klaviyo__person_campaign_flow f ON p.person_id = f.person_id
WHERE f.last_touch_campaign_id IS NOT NULL
"""
joined_data = pd.read_sql_query(query, conn)
print("Joined person-campaign data:")
print(joined_data)

# Now let's analyze events data for timing and subject line insights
print("\n=== EVENTS TIMING AND SUBJECT ANALYSIS ===")
events_query = """
SELECT 
    e.campaign_name,
    e.campaign_subject_line,
    e.occurred_at,
    e.person_id,
    e.type as event_type,
    e.last_touch_campaign_id,
    e.CAMPAIGN_TYPE
FROM klaviyo__events e
WHERE e.CAMPAIGN_TYPE = 'email'
ORDER BY e.occurred_at
"""
events_data = pd.read_sql_query(events_query, conn)
print("Events data:")
print(events_data)

# Parse timestamps for time window analysis
if not events_data.empty:
    events_data['occurred_at'] = pd.to_datetime(events_data['occurred_at'])
    events_data['hour_of_day'] = events_data['occurred_at'].dt.hour
    events_data['day_of_week'] = events_data['occurred_at'].dt.dayofweek  # Monday=0, Sunday=6
    events_data['is_weekend'] = events_data['day_of_week'].isin([5, 6])
    events_data['time_window'] = events_data['hour_of_day'].apply(
        lambda x: 'Morning (0-12h)' if x < 12 else 'Afternoon (12-24h)'
    )
    
    # Holiday analysis placeholder (would need holiday data)
    print("\n=== TIME WINDOW ANALYSIS ===")
    print("\nEmail events by time window:")
    time_window_counts = events_data.groupby(['campaign_name', 'time_window']).size().reset_index(name='count')
    print(time_window_counts)
    
    print("\nEmail events by weekday/weekend:")
    weekend_counts = events_data.groupby(['campaign_name', 'is_weekend']).size().reset_index(name='count')
    print(weekend_counts)
    
    # Subject line keyword analysis
    print("\n=== SUBJECT LINE KEYWORD ANALYSIS ===")
    
    # Define keyword categories
    subject_keywords = {
        'discount': ['discount', 'sale', 'offer', 'save', 'deal', 'promo'],
        'new_product': ['new', 'launch', 'release', 'announcing', 'introducing'],
        'storytelling': ['story', 'behind', 'journey', 'learn', 'discover', 'experience']
    }
    
    def categorize_subject(subject):
        if not isinstance(subject, str):
            return 'other'
        subject_lower = subject.lower()
        for category, keywords in subject_keywords.items():
            if any(keyword in subject_lower for keyword in keywords):
                return category
        return 'other'
    
    events_data['subject_category'] = events_data['campaign_subject_line'].apply(categorize_subject)
    
    print("\nSubject line categorization:")
    subject_counts = events_data.groupby(['campaign_name', 'subject_category']).size().reset_index(name='count')
    print(subject_counts)

# Calculate overall metrics
print("\n=== OVERALL METRICS ===")

# Calculate open and click rates from events
open_events = len(events_data[events_data['event_type'] == 'email_open'])
click_events = len(events_data[events_data['event_type'].str.contains('click', na=False)])
order_events = len(events_data[events_data['event_type'] == 'placed_order'])

print(f"Total email open events: {open_events}")
print(f"Total click events: {click_events}")
print(f"Total order events: {order_events}")

# Analyze retention by campaign
print("\n=== RETENTION ANALYSIS BY CAMPAIGN ===")
retention_query = """
SELECT 
    f.last_touch_campaign_id,
    AVG(p.active_retention_rate_week) as avg_weekly_retention,
    AVG(p.active_retention_rate_month) as avg_monthly_retention,
    AVG(f.email_open_rate_touch) as avg_open_rate,
    AVG(f.email_click_to_open_rate_touch) as avg_click_to_open_rate,
    COUNT(DISTINCT p.person_id) as unique_persons,
    SUM(f.has_converted) as conversions,
    GROUP_CONCAT(DISTINCT e.campaign_subject_line) as subject_lines
FROM klaviyo__person_campaign_flow f
JOIN klaviyo__persons p ON f.person_id = p.person_id
LEFT JOIN klaviyo__events e ON f.last_touch_campaign_id = e.last_touch_campaign_id
GROUP BY f.last_touch_campaign_id
"""
campaign_retention = pd.read_sql_query(retention_query, conn)
print(campaign_retention.to_string())

conn.close()

print("\n=== ANALYSIS COMPLETE ===")
```

