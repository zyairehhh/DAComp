industry_salary = df_voc.groupby('Industry')['Salary_mid'].agg(['mean', 'count']).reset_index()
industry_salary = industry_salary[industry_salary['count'] >= 10].sort_values('mean', ascending=False).head(15)

plt.figure(figsize=(12, 6))
y_pos = np.arange(len(industry_salary))
bars = plt.barh(y_pos, industry_salary['mean'], color='coral', edgecolor='black')
plt.gca().invert_yaxis()
plt.xlabel('Average Monthly Salary (Yuan)', fontsize=12)
plt.title('Top 15 Industries by Average Salary for Vocational School Graduates (min 10 jobs)', fontsize=14)
plt.yticks(y_pos, industry_salary['Industry'], fontsize=9)
# Add labels
for i, v in enumerate(industry_salary['mean']):
    plt.text(v + 20, i, f'{v:.0f}', va='center', fontsize=8)
plt.tight_layout()
plt.savefig('plots/industry_salary.png', dpi=300)
plt.close()

# 4. Job Title word cloud? Not needed; instead, look at Work Experience Requirement
exp_salary = df_voc.groupby('Work Experience Requirement')['Salary_mid'].agg(['mean', 'count']).reset_index()
exp_salary = exp_salary[exp_salary['count'] >= 5].sort_values('mean', ascending=False)

plt.figure(figsize=(10, 6))
y_pos = np.arange(len(exp_salary))
bars = plt.barh(y_pos, exp_salary['mean'], color='lightgreen', edgecolor='black')
plt.gca().invert_yaxis()
plt.xlabel('Average Monthly Salary (Yuan)', fontsize=12)
plt.title('Average Salary by Work Experience Requirement (min 5 jobs)', fontsize=14)
plt.yticks(y_pos, exp_salary['Work Experience Requirement'], fontsize=9)
for i, v in enumerate(exp_salary['mean']):
    plt.text(v + 20, i, f'{v:.0f}', va='center', fontsize=8)
plt.tight_layout()
plt.savefig('plots/experience_salary.png', dpi=300)
plt.close()

print("Visualizations created in plots/ directory.")

# Summary statistics for report
print(f"\nVocational school jobs: {len(df_voc)}")
print(f"Jobs with salary info: {df_voc['Salary_mid'].count()}")
print(f"Mean salary: {df_voc['Salary_mid'].mean():.0f} yuan")
print(f"Median salary: {df_voc['Salary_mid'].median():.0f} yuan")
print(f"Top benefit: {benefit_counts.most_common(1)[0][0]} ({benefit_counts.most_common(1)[0][1]} mentions)")
''')
