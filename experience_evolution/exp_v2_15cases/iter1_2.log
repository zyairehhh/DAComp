        subset = subject_window_perf[subject_window_perf['subject_type']==st]
        brand = subject_perf[subject_perf['subject_type']==st]['brand'].iloc[0]
        f.write(f"\n**{st} ({brand})**\n")
        f.write(subset[['time_window','campaign_count','weighted_open_rate','weighted_click_to_open_rate']].to_markdown(index=False))
        f.write("\n")
    
    f.write("\n### 3. Overall Time‑Window Performance (All Campaigns)\n")
    f.write("Ranked by weighted open rate:\n")
    f.write(window_perf.to_markdown(index=False))
    f.write("\n\n")
    
