import pandas as pd
import sqlite3
import numpy as np
import statsmodels.api as sm

conn = sqlite3.connect('dacomp-078.sqlite')
df = pd.read_sql('SELECT * FROM pendo__account', conn)
# Define target as normalized sum of sum_minutes, sum_events, avg_nps_rating
def zscore(x):
    return (x - x.mean()) / x.std()
target = zscore(df['sum_minutes']) + zscore(df['sum_events']) + zscore(df['avg_nps_rating'])
df['target'] = target
# Prepare features
df['first_event_on'] = pd.to_datetime(df['first_event_on'])
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
df['active_span_days'] = (df['last_event_on'] - df['first_event_on']).dt.days
df['activity_density'] = df['count_active_days'] / df['active_span_days']
df['minutes_per_active_day'] = df['sum_minutes'] / df['count_active_days'].replace(0, np.nan)
df.fillna(0, inplace=True)
features = ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days',
            'count_feature_clicking_visitors', 'activity_density', 'minutes_per_active_day',
            'count_active_months']
# Standardize
X = df[features].apply(zscore)
# Fit linear regression
model = sm.OLS(target, sm.add_constant(X)).fit()
print(model.summary())
print('Coefficients:')
for feat, coef in zip(features, model.params[1:]):
    print(f'{feat}: {coef:.4f}')
# Compute predicted score
df['pred_score'] = model.predict(sm.add_constant(X))
# Compute accuracy for top 20% classification
top20 = df['target'] >= df['target'].quantile(0.8)
pred_top20 = df['pred_score'] >= df['pred_score'].quantile(0.8)
acc = (top20 == pred_top20).mean()
print('Accuracy (top 20% classification):', acc)
# Confusion matrix
print('Confusion matrix (true top20 vs predicted top20):')
print(pd.crosstab(top20, pred_top20, rownames=['True'], colnames=['Predicted']))
''')
