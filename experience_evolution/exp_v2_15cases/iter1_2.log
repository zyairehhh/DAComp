'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# connect to database
conn = sqlite3.connect('/workspace/dacomp-066.sqlite')

# Query joined data for Engineering and Marketing departments
query = """
SELECT j.departments, r.job_title, j.application_to_interview_rate as conv_rate, 
       j.created_year, j.created_month, j.hiring_managers
FROM greenhouse__job_enhanced j
JOIN greenhouse__recruitment_performance r ON j.job_id = r.job_id
WHERE j.departments IN ('Engineering', 'Marketing')
"""
df = pd.read_sql_query(query, conn)
conn.close()

print(f"Total records: {len(df)}")
print(df.head())

# Extract role category from job_title
def categorize_role(title):
    title_lower = title.lower()
    if 'frontend' in title_lower:
        return 'Frontend'
    elif 'backend' in title_lower:
        return 'Backend'
    elif 'data engineer' in title_lower:
        return 'Data Engineer'
    elif 'devops' in title_lower:
        return 'DevOps'
    elif 'machine learning' in title_lower:
        return 'Machine Learning'
    elif 'qa' in title_lower:
        return 'QA'
    elif 'full stack' in title_lower:
        return 'Full Stack'
    else:
        return 'Other'

df['role'] = df['job_title'].apply(categorize_role)

# Plot 1: Overall Engineering vs Marketing conversion rate trend over months
df['month'] = df['created_year'].astype(str) + '-' + df['created_month'].astype(str).str.zfill(2)
monthly_dept = df.groupby(['departments', 'month']).agg(avg_conv=('conv_rate', 'mean')).reset_index()
# pivot for plotting
pivot = monthly_dept.pivot(index='month', columns='departments', values='avg_conv')
print(pivot)

# Plot
plt.figure(figsize=(10,6))
markers = ['o', 's']
for idx, dept in enumerate(pivot.columns):
    plt.plot(pivot.index, pivot[dept], marker=markers[idx], label=dept, linewidth=2)
plt.title('Application to Interview Conversion Rate Trend - Engineering vs Marketing', fontsize=14)
plt.xlabel('Month (Year-Month)', fontsize=12)
plt.ylabel('Average Conversion Rate (%)', fontsize=12)
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('/workspace/dept_trend.png', dpi=300)
plt.close()

# Plot 2: Engineering roles conversion rate trend
eng_df = df[df['departments'] == 'Engineering']
monthly_role = eng_df.groupby(['role', 'month']).agg(avg_conv=('conv_rate', 'mean')).reset_index()
# pivot
role_pivot = monthly_role.pivot(index='month', columns='role', values='avg_conv')
print(role_pivot)

plt.figure(figsize=(12,7))
colors = plt.cm.Set3(range(len(role_pivot.columns)))
for idx, role in enumerate(role_pivot.columns):
    plt.plot(role_pivot.index, role_pivot[role], marker='o', label=role, color=colors[idx], linewidth=2)
plt.title('Engineering Roles: Application to Interview Conversion Rate Trend', fontsize=14)
plt.xlabel('Month (Year-Month)', fontsize=12)
plt.ylabel('Average Conversion Rate (%)', fontsize=12)
plt.legend(title='Role', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('/workspace/engineering_roles_trend.png', dpi=300)
plt.close()

# Plot 3: Hiring manager impact on conversion rate (Engineering)
# Count hiring_managers frequency
eng_df['hiring_manager'] = eng_df['hiring_managers'].fillna('Unknown')
manager_avg = eng_df.groupby('hiring_manager').agg(
    avg_conv=('conv_rate', 'mean'),
    job_count=('job_id', 'count')
).reset_index().sort_values('avg_conv', ascending=False)
print(manager_avg.head(20))

# Filter managers with at least 3 jobs for stability
qualified_managers = manager_avg[manager_avg['job_count'] >= 3]
if len(qualified_managers) > 10:
    qualified_managers = qualified_managers.head(10)  # top 10 by avg_conv for clarity

plt.figure(figsize=(10,6))
plt.bar(qualified_managers['hiring_manager'], qualified_managers['avg_conv'], color='skyblue')
plt.title('Engineering: Hiring Managers by Avg Conversion Rate (Min 3 Jobs)', fontsize=14)
plt.xlabel('Hiring Manager', fontsize=12)
plt.ylabel('Average Conversion Rate (%)', fontsize=12)
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('/workspace/hiring_manager_impact.png', dpi=300)
plt.close()

# Plot 4: Number of interviewers? Wait we don't have that column.
# Instead we can look at total_interviews or avg_interviews_per_application? Let's check columns.
# We'll need another join with recruitment_performance for total_interviews maybe.
# Let's derive from job_enhanced: avg_interviews_per_application.
# Impact of avg_interviews_per_application on conversion rate (scatter)

# Get additional columns
conn = sqlite3.connect('/workspace/dacomp-066.sqlite')
eng_full = pd.read_sql_query("""
SELECT j.departments, r.job_title, j.application_to_interview_rate as conv_rate,
       j.avg_interviews_per_application, j.count_total_interviews, j.count_completed_interviews,
       j.created_month, r.avg_process_days, r.total_interviews, r.completed_interviews
FROM greenhouse__job_enhanced j
JOIN greenhouse__recruitment_performance r ON j.job_id = r.job_id
WHERE j.departments = 'Engineering'
""", conn)
conn.close()

print(eng_full.head())
# Scatter plot: conversion rate vs avg_interviews_per_application
plt.figure(figsize=(10,6))
plt.scatter(eng_full['avg_interviews_per_application'], eng_full['conv_rate'], alpha=0.6, s=80)
plt.title('Engineering: Conversion Rate vs Avg Interviews per Application', fontsize=14)
plt.xlabel('Avg Interviews per Application', fontsize=12)
plt.ylabel('Conversion Rate (%)', fontsize=12)
plt.grid(True, linestyle='--', alpha=0.7)

# Add trend line
z = np.polyfit(eng_full['avg_interviews_per_application'], eng_full['conv_rate'], 1)
p = np.poly1d(z)
plt.plot(eng_full['avg_interviews_per_application'], p(eng_full['avg_interviews_per_application']), "r--", linewidth=2)
plt.tight_layout()
plt.savefig('/workspace/scatter_interviews_conv.png', dpi=300)
plt.close()

print("Plots generated in /workspace/")
'''
