import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-093.sqlite')
df = pd.read_sql_query("""
    SELECT * FROM klaviyo__campaigns
""", conn)

# Parse subject keywords
def get_keyword_group(subject):
    if pd.isna(subject):
        return 'unknown'
    if '限时折扣' in subject:
        return 'discount'
    elif '新品上新' in subject:
        return 'new'
    elif '品牌故事' in subject:
        return 'storytelling'
    else:
        return 'other'

df['keyword_group'] = df['SUBJECT'].apply(get_keyword_group)

# Parse time label
def get_time_label(subject):
    if pd.isna(subject):
        return None
    parts = subject.split('，')
    if len(parts) > 1:
        label = parts[-1].strip()
        label = label.replace('开启', '').replace('加持', '').replace('优先', '')
        return label
    return None

df['time_label'] = df['SUBJECT'].apply(get_time_label)

# Scheduled time features
df['scheduled_dt'] = pd.to_datetime(df['scheduled_to_send_at'])
df['weekday'] = df['scheduled_dt'].dt.weekday
df['is_weekend'] = df['weekday'].isin([5,6])
df['hour'] = df['scheduled_dt'].dt.hour
def time_of_day(hour):
    if 5 <= hour < 12:
        return 'morning'
    elif 12 <= hour < 17:
        return 'afternoon'
    elif 17 <= hour < 22:
        return 'evening'
    else:
        return 'night'
df['time_of_day'] = df['hour'].apply(time_of_day)
df['is_before_holiday'] = df['SUBJECT'].str.contains('节前')

# Metrics
df['open_rate'] = df['email_open_rate']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open_rate'] = df['email_click_to_open_rate']
df['placed_order_rate'] = df['count_placed_order'] / df['count_received_email']
df['gmv_per_recipient'] = df['gmv_net_campaign'] / df['count_received_email']

# Outlier removal
Q1 = df['count_received_email'].quantile(0.25)
Q3 = df['count_received_email'].quantile(0.75)
IQR = Q3 - Q1
lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR
df_clean = df[(df['count_received_email'] >= lower) & (df['count_received_email'] <= upper)]
df_clean = df_clean[df_clean['open_rate'] <= 1]
df_clean = df_clean[df_clean['click_rate'] <= 1]

print(f"Total campaigns: {len(df)}")
print(f"Clean campaigns: {len(df_clean)}")

# Save aggregated tables
# 1. Keyword group summary
keyword_summary = df_clean.groupby('keyword_group').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean'),
    avg_gmv_per_recipient=('gmv_per_recipient', 'mean'),
    avg_audience=('total_count_unique_people', 'mean')
).round(5)
keyword_summary.to_csv('keyword_summary.csv')
print("Saved keyword_summary.csv")

# 2. Weekend vs weekday
weekend_summary = df_clean.groupby('is_weekend').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean'),
    avg_gmv_per_recipient=('gmv_per_recipient', 'mean')
).round(5)
weekend_summary.to_csv('weekend_summary.csv')

# 3. Time of day
tod_summary = df_clean.groupby('time_of_day').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean'),
    avg_gmv_per_recipient=('gmv_per_recipient', 'mean')
).round(5)
tod_summary.to_csv('tod_summary.csv')

# 4. Before holiday
holiday_summary = df_clean.groupby('is_before_holiday').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean'),
    avg_gmv_per_recipient=('gmv_per_recipient', 'mean')
).round(5)
holiday_summary.to_csv('holiday_summary.csv')

# 5. Interaction keyword x time_of_day
interaction1 = df_clean.groupby(['keyword_group', 'time_of_day']).agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean')
).round(5)
interaction1.to_csv('interaction_keyword_time.csv')

# 6. Interaction keyword x is_weekend
interaction2 = df_clean.groupby(['keyword_group', 'is_weekend']).agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean')
).round(5)
interaction2.to_csv('interaction_keyword_weekend.csv')

# 7. Interaction keyword x is_before_holiday
interaction3 = df_clean.groupby(['keyword_group', 'is_before_holiday']).agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean')
).round(5)
interaction3.to_csv('interaction_keyword_holiday.csv')

# 8. Variation and archived
variation_summary = df_clean.groupby(['is_archived', 'variation_id']).agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_order_rate=('placed_order_rate', 'mean')
).round(5)
variation_summary.to_csv('variation_archived_summary.csv')

# 9. Overall retention from persons
persons = pd.read_sql_query("""
    SELECT active_retention_rate_week, active_retention_rate_month
    FROM klaviyo__persons
    WHERE active_retention_rate_week IS NOT NULL
""", conn)
print(f"Overall weekly retention: {persons['active_retention_rate_week'].mean():.4f}")
print(f"Overall monthly retention: {persons['active_retention_rate_month'].mean():.4f}")

# 10. Maybe correlate campaign metrics with retention? Not possible.

conn.close()
print("All summary CSV files generated.")
