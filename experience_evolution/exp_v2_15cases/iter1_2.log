    AVG(average_revenue_per_user) as avg_arpu,
    SUM(revenue_last_30_days) as total_revenue,
    SUM(avg_active_devices) as total_active_devices
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor' AND average_revenue_per_user > 30
"""
high_df = pd.read_sql_query(q3_high, conn)

q3_low = """
SELECT 
    'Low ARPU (<10)' as segment,
    COUNT(*) as num_markets,
    AVG(overall_market_score) as avg_market_score,
    AVG(weekly_growth_rate) as avg_growth,
    AVG(day_30_retention_rate) as avg_retention,
    AVG(daily_churn_rate) as avg_churn,
    AVG(app_quality_score) as avg_app_quality,
    AVG(average_revenue_per_user) as avg_arpu,
    SUM(revenue_last_30_days) as total_revenue,
    SUM(avg_active_devices) as total_active_devices
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor' AND average_revenue_per_user < 10
"""
low_df = pd.read_sql_query(q3_low, conn)
segment_df = pd.concat([high_df, low_df], ignore_index=True)
print("High vs Low ARPU markets:")
print(segment_df.to_string(index=False))
print()

# 4. Monthly revenue trends across regions (using finance report)
q4 = """
SELECT 
    SUBSTR(date_day,1,7) as month,
    region,
    SUM(net_amount) as monthly_revenue,
    SUM(transactions) as total_transactions,
    COUNT(DISTINCT country_short) as countries
FROM google_play__finance_report f 
JOIN google_play__geo_market_analysis g 
    ON f.country_short = g.country AND f.package_name = g.package_name 
WHERE f.package_name = 'com.dev.photoeditor'
GROUP BY month, region 
ORDER BY month, region
"""
trend_df = pd.read_sql_query(q4, conn)
print("Monthly revenue per region (first 30 rows):")
print(trend_df.head(30).to_string(index=False))
print()

# 5. Quality and growth correlation
q5 = """
SELECT 
    country,
    region,
    average_revenue_per_user,
    overall_market_score,
    weekly_growth_rate,
    app_quality_score,
    revenue_last_30_days
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor' 
ORDER BY average_revenue_per_user DESC
"""
detail_df = pd.read_sql_query(q5, conn)
print("Detail per country:")
print(detail_df.to_string(index=False))
print()

# 6. Research budget aggregate
q6 = """
SELECT 
    SUM(research_budget_usd) as total_research_budget,
    AVG(research_budget_usd) as avg_monthly_budget,
    COUNT(*) as months
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor'
"""
budget_df = pd.read_sql_query(q6, conn)
print("Research budget summary:")
print(budget_df.to_string(index=False))

conn.close()
