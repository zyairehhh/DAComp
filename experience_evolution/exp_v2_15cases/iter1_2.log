import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from datetime import datetime

# Connect to database
db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-070/stage2_env/dacomp-070.sqlite'
conn = sqlite3.connect(db_path)

# Query for region-level monthly conversion rates
query = """
SELECT DATE(date_day) as month, region, 
       AVG(store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__country_report
WHERE date_day >= '2024-04-01' AND date_day < '2024-10-01'
GROUP BY strftime('%Y-%m', date_day), region
ORDER BY month, region;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Convert month to datetime
df['month'] = pd.to_datetime(df['month'])
pivot = df.pivot(index='month', columns='region', values='avg_conversion_rate')
regions = pivot.columns.tolist()

# Plot
plt.figure(figsize=(10,6))
for region in regions:
    plt.plot(pivot.index, pivot[region], marker='o', label=region, linewidth=2)
plt.title('Store Listing Conversion Rate Trends by Region (Apr-Sep 2024)', fontsize=16)
plt.xlabel('Month', fontsize=14)
plt.ylabel('Average Conversion Rate', fontsize=14)
plt.legend(title='Region')
plt.grid(True, which='both', linestyle='--', linewidth=0.5)
plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%b'))
plt.gca().xaxis.set_major_locator(mdates.MonthLocator())
plt.tight_layout()
plt.savefig('/workspace/region_conversion_trends.png', dpi=300)
plt.close()
```
