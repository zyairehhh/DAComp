Now we need to compute conversion rates per path. Let's write a script to compute conversion rates and average stage durations.

We'll compute:

- Total conversations per path.
- Number of conversations with stage = 'demo_booked' -> conversion rate demo.
- Number of conversations with stage = 'trial_activated' -> conversion rate trial activation.
- Number of conversations with stage = 'closed_won' -> conversion rate payment.

But note that we need conversion after booking a demo: i.e., percentage of customers who activate a trial after booking a demo. Since each conversation is independent, we cannot track sequences directly. However we can approximate by looking at conversations with stage 'demo_booked' vs 'trial_activated' as separate events. But we need to compute conditional probability: given a conversation with stage demo_booked, what's probability that the same customer later has a conversation with stage trial_activated? That requires linking conversations per contact.

Let's first compute some basic metrics.

Action: CreateFile(filepath="/workspace/compute_conversion.py"):
```
import sqlite3
import pandas as pd
import numpy as np
import os

db_path = 'dacomp-098.sqlite'
conn = sqlite3.connect(db_path)

# Load conversations with tags and response times
query = """
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.conversation_initiated_type,
    ce.all_conversation_tags,
    ce.all_conversation_contacts as contact_id,
    cm.first_admin_response_at,
    cm.time_to_first_response_minutes,
    cm.first_contact_reply_at
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
 ON ce.conversation_id = cm.conversation_id
"""
df = pd.read_sql_query(query, conn)

def parse_tags(tag_str):
    if not tag_str:
        return {}
    tags = {}
    for pair in tag_str.split('|'):
        if ':' in pair:
            key, value = pair.split(':', 1)
            tags[key.strip()] = value.strip()
    return tags

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['path'] = df['tags_dict'].apply(lambda d: d.get('path', ''))
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['topic'] = df['tags_dict'].apply(lambda d: d.get('topic', ''))
df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))
df['lifecycle'] = df['tags_dict'].apply(lambda d: d.get('lifecycle', ''))

print("Basic counts:")
print("Human-first:", df[df['conversation_initiated_type']=='human_first'].shape[0])
print("Bot-first:", df[df['conversation_initiated_type']=='bot_first'].shape[0])

# Conversion rates per path
for path_type in ['human_first', 'bot_first']:
    subset = df[df['conversation_initiated_type']==path_type]
    total = subset.shape[0]
    demo_booked = subset[subset['stage']=='demo_booked'].shape[0]
    trial_activated = subset[subset['stage']=='trial_activated'].shape[0]
    trial_started = subset[subset['stage']=='trial_started'].shape[0]
    closed_won = subset[subset['stage']=='closed_won'].shape[0]
    closed_lost = subset[subset['stage']=='closed_lost'].shape[0]
    print(f"\n--- {path_type} ---")
    print(f"Total conversations: {total}")
    print(f"Demo booked: {demo_booked} ({demo_booked/total*100:.1f}%)")
    print(f"Trial activated: {trial_activated} ({trial_activated/total*100:.1f}%)")
    print(f"Trial started: {trial_started} ({trial_started/total*100:.1f}%)")
    print(f"Closed won: {closed_won} ({closed_won/total*100:.1f}%)")
    print(f"Closed lost: {closed_lost} ({closed_lost/total*100:.1f}%)")

# Compute average time to first response per path
df['first_admin_response_at'] = pd.to_datetime(df['first_admin_response_at'])
df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
df['response_time_minutes'] = (df['first_admin_response_at'] - df['conversation_created_at']).dt.total_seconds() / 60
print("\nAverage time to first response (minutes):")
print(df.groupby('conversation_initiated_type')['response_time_minutes'].describe())

# For demo_booked conversations, compute time from conversation start to first response
demo = df[df['stage']=='demo_booked']
print("\nFor demo booked conversations:")
print(demo.groupby('conversation_initiated_type')['response_time_minutes'].describe())

# Compute per intent/topic/segment/region conversion rates
print("\n--- Conversion by intent ---")
for intent in df['intent'].unique():
    if intent:
        sub = df[df['intent']==intent]
        total = sub.shape[0]
        demo_booked = sub[sub['stage']=='demo_booked'].shape[0]
        if total > 0:
            print(f"{intent}: total {total}, demo booked {demo_booked} ({demo_booked/total*100:.1f}%)")

print("\n--- Conversion by topic ---")
for topic in df['topic'].unique():
    if topic:
        sub = df[df['topic']==topic]
        total = sub.shape[0]
        demo_booked = sub[sub['stage']=='demo_booked'].shape[0]
        if total > 0:
            print(f"{topic}: total {total}, demo booked {demo_booked} ({demo_booked/total*100:.1f}%)")

conn.close()
```
