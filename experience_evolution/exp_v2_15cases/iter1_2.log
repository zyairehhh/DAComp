df_metrics = pd.merge(df_cv, df_growth, on='customer_id', how='left')

# 4. Behavioral features from customer_analytics
query = """
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation, lifecycle_stage, customer_value_segment
FROM quickbooks__customer_analytics 
WHERE customer_id IN ({})
""".format(','.join(['?']*len(high_vol_customers)))
df_behav = pd.read_sql(query, conn, params=high_vol_customers)
df_metrics = pd.merge(df_metrics, df_behav, on='customer_id', how='left')

# 5. Contribution to overall business_health_score and collection_rate_percentage from financial_dashboard
# Compute average business_health_score and collection_rate_percentage across all months
query = "SELECT AVG(business_health_score) as avg_health, AVG(collection_rate_percentage) as avg_collection FROM quickbooks__financial_dashboard"
df_avg = pd.read_sql(query, conn)
avg_health = df_avg['avg_health'].iloc[0]
avg_collection = df_avg['avg_collection'].iloc[0]

# For high-vol customers, we need their invoice totals and collected amounts over time to compute contribution
query = """
SELECT p.customer_id, p.transaction_date, p.invoice_total, p.collected_amount
FROM quickbooks__profitability_analysis p
WHERE p.customer_id IN ({})
""".format(','.join(['?']*len(high_vol_customers)))
df_all = pd.read_sql(query, conn, params=high_vol_customers)
df_all['transaction_date'] = pd.to_datetime(df_all['transaction_date'])
df_all['year_month'] = df_all['transaction_date'].dt.to_period('M')

# Aggregate monthly totals
monthly = df_all.groupby('year_month').agg({'invoice_total':'sum', 'collected_amount':'sum'}).reset_index()
# Compute overall totals across all customers and months
query_overall = """
SELECT SUM(invoice_total) as total_invoice_all, SUM(collected_amount) as total_collected_all 
FROM quickbooks__profitability_analysis
"""
df_overall = pd.read_sql(query_overall, conn)
total_invoice_all = df_overall['total_invoice_all'].iloc[0]
total_collected_all = df_overall['total_collected_all'].iloc[0]

# Contribution of high-vol customers to total invoice and collected
highvol_invoice = df_all['invoice_total'].sum()
highvol_collected = df_all['collected_amount'].sum()
contrib_invoice = highvol_invoice / total_invoice_all if total_invoice_all != 0 else 0
contrib_collected = highvol_collected / total_collected_all if total_collected_all != 0 else 0

print(f"High-vol customers invoice contribution: {contrib_invoice:.2%}")
print(f"High-vol customers collected contribution: {contrib_collected:.2%}")

# 6. Risk exposure from balance_sheet accounts receivable structure
query = """
SELECT account_name, SUM(amount) as total_amount
FROM quickbooks__balance_sheet 
WHERE account_class = 'Accounts Receivable' OR account_name LIKE '%Receivable%'
GROUP BY account_name
"""
df_ar = pd.read_sql(query, conn)
print("Accounts Receivable structure:")
print(df_ar)

conn.close()

