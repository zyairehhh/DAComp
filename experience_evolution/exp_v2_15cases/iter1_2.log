import pandas as pd
import sqlite3

conn = sqlite3.connect('dacomp-069.sqlite')
df = pd.read_sql_query("""
    SELECT strftime('%Y-%m', date_day) as month, region, SUM(net_amount) as total_revenue
    FROM google_play__finance_report 
    WHERE package_name = 'com.dev.photoeditor'
    GROUP BY month, region
    ORDER BY month, region
""", conn)

pivot = df.pivot(index='month', columns='region', values='total_revenue')
pivot = pivot.fillna(0)

# Calculate change from Jan to Dec for each region
jan = pivot.loc['2024-01']
dec = pivot.loc['2024-12']
change = (dec - jan) / jan * 100

print("Revenue per region (first few months):")
print(pivot.head())
print("\nRevenue in Jan 2024:")
print(jan)
print("\nRevenue in Dec 2024:")
print(dec)
print("\nPercentage change from Jan to Dec:")
print(change)

conn.close()
```
