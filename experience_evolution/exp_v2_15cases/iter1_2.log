import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

# Connect to database
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Filter for vocational school or above education requirement
# Note: The column name includes spaces: "Education Requirement"
vocational_keywords = ["Vocational school or above", "Vocational school", "Vocational"]
mask = df['Education Requirement'].astype(str).str.contains('|'.join(vocational_keywords), case=False, na=False)
df_voc = df[mask].copy()
print(f"Total rows with vocational school requirement: {len(df_voc)}")

# Extract lower bound salary from Salary Range column
def extract_lower_bound(salary_str):
    if pd.isna(salary_str):
        return np.nan
    # Look for patterns like "3000-4000 yuan/month" or "5000-10000 RMB/month"
    # Also handle "5000-10000 RMB/month (Base salary: 4000-5000 RMB/month + commission)"
    # We'll take the first number before a dash or the first number in the string.
    # Remove commas and other non-digit except dash and decimal
    s = str(salary_str)
    # Find all numbers (including decimals)
    numbers = re.findall(r'\d+\.?\d*', s)
    if numbers:
        # Convert to float, take the smallest as lower bound?
        # But salary ranges often have two numbers: lower-upper.
        # If there are at least two numbers, take the first as lower.
        # However, sometimes there are multiple numbers due to base + commission.
        # For simplicity, take the first number as lower bound.
        # This matches the Stage1 approach: lower bound of advertised salary range.
        return float(numbers[0])
    else:
        return np.nan

df_voc['lower_bound'] = df_voc['Salary Range'].apply(extract_lower_bound)
# Filter out NaN salaries
df_salary = df_voc.dropna(subset=['lower_bound'])
print(f"Rows with usable salary range: {len(df_salary)}")

# 1. Starting salary distribution histogram
plt.figure(figsize=(10, 6))
# Define bins similar to report: <2k, 2-3k, ..., >20k
bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 100000]  # upper bounds
labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-7k', '7k-8k', '8k-9k', '9k-10k', '10k-15k', '15k-20k', '>20k']
df_salary['salary_bin'] = pd.cut(df_salary['lower_bound'], bins=bins, labels=labels, right=False)
counts = df_salary['salary_bin'].value_counts().sort_index()
ax = counts.plot(kind='bar', color='steelblue', edgecolor='black')
plt.title('Starting Salary Distribution for Vocational School Graduates')
plt.xlabel('Salary Range (RMB/month)')
plt.ylabel('Number of Job Postings')
plt.xticks(rotation=45)
# Add count labels on top of bars
for i, v in enumerate(counts):
    ax.text(i, v + 50, str(int(v)), ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('starting_salary_distribution.png', dpi=300)
plt.close()

# 2. Benefits distribution
# Parse benefits column into list of standardized categories
# Stage1 report used a predefined list of benefits; we'll mimic that by extracting keywords.
benefit_keywords = {
    'Five social insurances': ['Five social insurances', 'Five insurances'],
    'Paid annual leave': ['Paid annual leave'],
    'Holiday benefits': ['Holiday benefits'],
    'Performance bonus': ['Performance bonus'],
    'Meal allowance': ['Meal allowance'],
    'Full attendance bonus': ['Full attendance bonus'],
    'Housing provident fund': ['Housing provident fund'],
    'Double pay': ['Double pay', 'double salary'],
    'Employee travel': ['Employee travel'],
    'Professional training': ['Professional training'],
    'Overtime pay': ['Overtime pay'],
    'Commercial insurance': ['Commercial insurance'],
    'Work uniform': ['Work uniform'],
    'Business trip allowance': ['Business trip allowance'],
    'Accommodation provided': ['Accommodation provided']
}
# We'll count occurrences in the Benefits column (case-insensitive)
benefit_counts = {benefit: 0 for benefit in benefit_keywords}
total_with_benefits = df_voc['Benefits'].notna().sum()
print(f"Rows with benefits info: {total_with_benefits}")
for idx, row in df_voc.iterrows():
    benefits_str = str(row['Benefits']).lower()
    for benefit, keywords in benefit_keywords.items():
        for kw in keywords:
            if kw.lower() in benefits_str:
                benefit_counts[benefit] += 1
                break  # count once per benefit per job
# Sort by prevalence
benefit_counts_series = pd.Series(benefit_counts).sort_values(ascending=False)

plt.figure(figsize=(12, 6))
ax = benefit_counts_series.plot(kind='bar', color='darkorange', edgecolor='black')
plt.title('Benefits Prevalence in Job Postings for Vocational School Graduates')
plt.xlabel('Benefit Category')
plt.ylabel('Number of Job Postings')
plt.xticks(rotation=45, ha='right')
# Add count labels
for i, v in enumerate(benefit_counts_series):
    ax.text(i, v + 100, str(int(v)), ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('benefits_distribution.png', dpi=300)
plt.close()

# 3. Work experience requirement vs salary
# Map work experience categories from the Stage1 report
def categorize_exp(exp_str):
    if pd.isna(exp_str):
        return 'No limit'
    s = str(exp_str).lower()
    if 'five years' in s or '5 years' in s:
        return 'Five years or more'
    elif 'four years' in s or '4 years' in s:
        return 'Four years or more'
    elif 'three years' in s or '3 years' in s:
        return 'Three years or more'
    elif 'two years' in s or '2 years' in s:
        return 'Two years or more'
    elif 'one year' in s or '1 year' in s:
        return 'More than one year'
    elif 'fresh' in s or 'graduate' in s:
        return 'Fresh graduates'
    elif 'no limit' in s or 'unlimited' in s or '不限' in s:
        return 'No limit'
    else:
        return 'Other'

df_salary['exp_category'] = df_salary['Work Experience Requirement'].apply(categorize_exp)
exp_salary = df_salary.groupby('exp_category')['lower_bound'].mean().sort_values(ascending=False)
# Reorder categories as per report
exp_order = ['Five years or more', 'Four years or more', 'Three years or more', 'Two years or more', 'No limit', 'More than one year', 'Fresh graduates']
exp_salary = exp_salary.reindex(exp_order).dropna()

plt.figure(figsize=(10, 6))
ax = exp_salary.plot(kind='bar', color='forestgreen', edgecolor='black')
plt.title('Average Starting Salary by Work Experience Requirement')
plt.xlabel('Work Experience Requirement')
plt.ylabel('Average Starting Salary (RMB/month)')
plt.xticks(rotation=45, ha='right')
# Add salary labels
for i, v in enumerate(exp_salary):
    ax.text(i, v + 50, f'{v:,.0f}', ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('salary_by_experience.png', dpi=300)
plt.close()

# 4. Industry vs salary (top N industries by count)
# Clean industry column: may contain multiple industries separated by commas.
# For simplicity, take the first industry listed.
def get_first_industry(industry_str):
    if pd.isna(industry_str):
        return 'Unknown'
    # Split by commas and take the first
    parts = str(industry_str).split(',')
    return parts[0].strip()

df_salary['industry_clean'] = df_salary['Industry'].apply(get_first_industry)
# Filter industries with at least 20 postings for reliability
industry_counts = df_salary['industry_clean'].value_counts()
top_industries = industry_counts[industry_counts >= 20].index.tolist()
df_top = df_salary[df_salary['industry_clean'].isin(top_industries)]
industry_salary = df_top.groupby('industry_clean')['lower_bound'].mean().sort_values(ascending=False)
# Limit to top 10 for readability
industry_salary_top = industry_salary.head(10)

plt.figure(figsize=(12, 6))
ax = industry_salary_top.plot(kind='bar', color='purple', edgecolor='black')
plt.title('Average Starting Salary by Industry (Top 10 by Count)')
plt.xlabel('Industry')
plt.ylabel('Average Starting Salary (RMB/month)')
plt.xticks(rotation=45, ha='right')
# Add salary labels
for i, v in enumerate(industry_salary_top):
    ax.text(i, v + 50, f'{v:,.0f}', ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('salary_by_industry.png', dpi=300)
plt.close()

# 5. Age requirement vs salary (optional)
def categorize_age(age_str):
    if pd.isna(age_str):
        return 'No limit'
    s = str(age_str).lower()
    # Map common patterns
    if '18-25' in s:
        return '18-25 years old'
    elif '30-40' in s:
        return '30-40 years old'
    elif '25-38' in s:
        return '25-38 years old'
    elif '30-45' in s:
        return '30-45 years old'
    elif '28-45' in s:
        return '28-45 years old'
    else:
        return 'Other age range'

df_salary['age_category'] = df_salary['Age Requirement'].apply(categorize_age)
age_salary = df_salary.groupby('age_category')['lower_bound'].mean()
# Filter to categories of interest
age_categories_of_interest = ['18-25 years old', '30-40 years old', '25-38 years old', '30-45 years old', '28-45 years old', 'No limit']
age_salary_filtered = age_salary[age_salary.index.isin(age_categories_of_interest)].sort_values(ascending=False)

plt.figure(figsize=(10, 6))
ax = age_salary_filtered.plot(kind='bar', color='teal', edgecolor='black')
plt.title('Average Starting Salary by Age Requirement')
plt.xlabel('Age Requirement')
plt.ylabel('Average Starting Salary (RMB/month)')
plt.xticks(rotation=45, ha='right')
for i, v in enumerate(age_salary_filtered):
    ax.text(i, v + 50, f'{v:,.0f}', ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('salary_by_age.png', dpi=300)
plt.close()

print("Plots generated successfully.")
