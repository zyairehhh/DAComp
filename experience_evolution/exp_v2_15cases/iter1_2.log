import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-094.sqlite')
df_persons = pd.read_sql_query("SELECT person_id, active_retention_rate_week, active_retention_rate_month FROM klaviyo__persons", conn)
df_flow = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)
df_events = pd.read_sql_query("SELECT DISTINCT last_touch_campaign_id, campaign_subject_line FROM klaviyo__events", conn)
conn.close()

df = df_flow.merge(df_events, on='last_touch_campaign_id', how='left')
df = df.merge(df_persons, on='person_id', how='left')

df['open_rate'] = df['email_open_rate_touch']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open'] = df['email_click_to_open_rate_touch']
df['click_rate'] = df['click_rate'].fillna(0)
df['open_rate'] = df['open_rate'].fillna(0)
df['click_to_open'] = df['click_to_open'].fillna(0)

def categorize_subject(subject):
    if pd.isna(subject):
        return 'unknown'
    subject_lower = str(subject).lower()
    if 'product launch' in subject_lower:
        return 'new_product_launch'
    elif 'seasonal' in subject_lower or 'discount' in subject_lower or 'offer' in subject_lower:
        return 'discount_related'
    else:
        return 'storytelling'

df['subject_theme'] = df['campaign_subject_line'].apply(categorize_subject)

df['first_event_at'] = pd.to_datetime(df['first_event_at'])
df['weekday'] = df['first_event_at'].dt.weekday
df['is_weekend'] = df['weekday'].isin([5,6])
df['hour'] = df['first_event_at'].dt.hour
df['is_morning'] = df['hour'] < 12
df['time_of_day'] = np.where(df['is_morning'], 'Morning', 'Afternoon')

holidays = [
    datetime(2023,1,1), datetime(2023,1,16), datetime(2023,2,20), datetime(2023,5,29),
    datetime(2023,7,4), datetime(2023,9,4), datetime(2023,10,9), datetime(2023,11,11),
    datetime(2023,11,23), datetime(2023,12,25),
    datetime(2024,1,1), datetime(2024,1,15), datetime(2024,2,19), datetime(2024,5,27),
    datetime(2024,7,4), datetime(2024,9,2), datetime(2024,10,14), datetime(2024,11,11),
    datetime(2024,11,28), datetime(2024,12,25)
]

def days_from_nearest_holiday(dt):
    diffs = [(dt.date() - h.date()).days for h in holidays]
    abs_diffs = [abs(d) for d in diffs]
    if not abs_diffs:
        return None
    min_diff = min(abs_diffs)
    idx = abs_diffs.index(min_diff)
    sign = diffs[idx]
    return sign

df['holiday_offset_days'] = df['first_event_at'].apply(days_from_nearest_holiday)
df['holiday_window'] = 'none'
df.loc[df['holiday_offset_days'].between(-3, -1), 'holiday_window'] = 'before_3'
df.loc[df['holiday_offset_days'].between(1, 3), 'holiday_window'] = 'after_3'

# Compute statistics
theme_stats = df.groupby('subject_theme').agg(
    count=('person_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()

weekend_stats = df.groupby('is_weekend').agg(
    count=('person_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
weekend_stats['is_weekend'] = weekend_stats['is_weekend'].map({True: 'Weekend', False: 'Weekday'})

time_stats = df.groupby('time_of_day').agg(
    count=('person_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()

combined = df.groupby(['subject_theme', 'is_weekend']).agg(
    count=('person_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
combined['is_weekend'] = combined['is_weekend'].map({True: 'Weekend', False: 'Weekday'})

corr_week = df['open_rate'].corr(df['active_retention_rate_week'])
corr_month = df['open_rate'].corr(df['active_retention_rate_month'])

# Write markdown
