).reset_index()
combined['is_weekend'] = combined['is_weekend'].map({True: 'Weekend', False: 'Weekday'})
print(combined.to_string(index=False))
print()

print('Note: Sample size is very small (4 interactions). Findings are suggestive but not statistically significant.')
