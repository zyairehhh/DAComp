print(f"Total conversations: {df.shape[0]}")
print(f"Unique contacts: {df['contact_id'].nunique()}")

# Group by contact
contact_sequences = defaultdict(list)
for row in df.itertuples():
    contact_sequences[row.contact_id].append((row.conversation_created_at, row.stage, row.conversation_initiated_type, row.path))

# Compute funnel per contact
funnel_data = []
for contact, convs in contact_sequences.items():
