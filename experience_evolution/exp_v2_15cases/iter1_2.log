import sqlite3
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# Load region conversion trend
region_df = pd.read_sql_query("""
    SELECT region, date_day, 
           AVG(store_listing_conversion_rate) as avg_conversion_rate,
           SUM(active_devices_last_30_days) as total_active_devices,
           AVG(rolling_total_average_rating) as avg_rating,
           SUM(store_listing_acquisitions) as total_acquisitions,
           SUM(store_listing_visitors) as total_visitors
    FROM google_play__country_report
    GROUP BY region, date_day
    ORDER BY region, date_day
""", conn)
region_df['date_day'] = pd.to_datetime(region_df['date_day'])
region_df['month'] = region_df['date_day'].dt.to_period('M')
print("Region conversion trend shape:", region_df.shape)
print(region_df.head())

# Load device-level data
device_df = pd.read_sql_query("""
    SELECT device, date_day,
           SUM(active_devices_last_30_days) as total_active_devices,
           AVG(average_rating) as avg_rating
    FROM google_play__device_report
    GROUP BY device, date_day
    ORDER BY device, date_day
""", conn)
device_df['date_day'] = pd.to_datetime(device_df['date_day'])
device_df['month'] = device_df['date_day'].dt.to_period('M')
print("\nDevice trend shape:", device_df.shape)
print(device_df.head())

# Load time series trends (package level)
package_df = pd.read_sql_query("""
    SELECT date_day, package_name,
           daily_installs, daily_uninstalls,
           active_devices, daily_revenue,
           quality_score, crash_rate_per_1k,
           anr_rate_per_1k, revenue_per_active_device
    FROM google_play__time_series_trends
    ORDER BY date_day, package_name
""", conn)
package_df['date_day'] = pd.to_datetime(package_df['date_day'])
package_df['month'] = package_df['date_day'].dt.to_period('M')
print("\nPackage trend shape:", package_df.shape)
print(package_df.head())

# Combine region and package? Need to join on package_name and date_day.
# Let's aggregate package-level metrics across regions and devices.
# First compute monthly averages per package
package_monthly = package_df.groupby(['package_name', 'month']).agg({
    'daily_installs': 'sum',
    'daily_uninstalls': 'sum',
    'active_devices': 'mean',
    'daily_revenue': 'sum',
    'quality_score': 'mean',
    'crash_rate_per_1k': 'mean',
    'anr_rate_per_1k': 'mean',
    'revenue_per_active_device': 'mean'
}).reset_index()
print("\nPackage monthly shape:", package_monthly.shape)

# Now join with region_monthly and device_monthly? We'll need to analyze relationships.
# Let's compute decay of conversion rate over time per region.
region_monthly = region_df.groupby(['region', 'month']).agg({
    'avg_conversion_rate': 'mean',
    'total_active_devices': 'sum',
    'avg_rating': 'mean',
    'total_acquisitions': 'sum',
    'total_visitors': 'sum'
}).reset_index()

# Compute efficiency metric: conversion rate maybe inverse of cost? Assume conversion rate correlates with acquisition cost efficiency (higher conversion -> lower cost per acquisition).
# Compute month-over-month change
region_monthly = region_monthly.sort_values(['region', 'month'])
region_monthly['prev_conversion'] = region_monthly.groupby('region')['avg_conversion_rate'].shift(1)
region_monthly['conversion_decay'] = region_monthly['avg_conversion_rate'] - region_monthly['prev_conversion']
region_monthly['months_since_start'] = (region_monthly['month'] - region_monthly['month'].min()).apply(lambda x: x.n)

# Fit linear decay slope per region using numpy polyfit
decay_slopes = {}
for region in region_monthly['region'].unique():
    sub = region_monthly[region_monthly['region'] == region].dropna()
    if len(sub) > 1:
        x = sub['months_since_start'].values
        y = sub['avg_conversion_rate'].values
        # linear regression using polyfit
        coef = np.polyfit(x, y, 1)
        slope = coef[0]
        # compute R^2
        p = np.poly1d(coef)
        yhat = p(x)
        ybar = np.sum(y)/len(y)
        ssreg = np.sum((yhat - ybar)**2)
        sstot = np.sum((y - ybar)**2)
        r_squared = ssreg / sstot if sstot != 0 else 0
        decay_slopes[region] = {'slope': slope, 'r2': r_squared}
        print(f"Region {region}: slope={slope:.5f}, R2={r_squared:.4f}")

# Similarly for device types (no conversion rate, maybe use active devices growth)
device_monthly = device_df.groupby(['device', 'month']).agg({
    'total_active_devices': 'sum',
    'avg_rating': 'mean'
}).reset_index()
device_monthly = device_monthly.sort_values(['device', 'month'])
device_monthly['prev_active'] = device_monthly.groupby('device')['total_active_devices'].shift(1)
device_monthly['growth_rate'] = (device_monthly['total_active_devices'] - device_monthly['prev_active']) / device_monthly['prev_active'].replace(0, np.nan)

# Compute decay of active devices (negative growth) per device using linear trend
device_growth_slopes = {}
for device in device_monthly['device'].unique():
    sub = device_monthly[device_monthly['device'] == device].dropna()
    if len(sub) > 1:
        sub['months_since_start'] = (sub['month'] - sub['month'].min()).apply(lambda x: x.n)
        x = sub['months_since_start'].values
        y = sub['total_active_devices'].values
        coef = np.polyfit(x, y, 1)
        slope = coef[0]
        p = np.poly1d(coef)
        yhat = p(x)
        ybar = np.sum(y)/len(y)
        ssreg = np.sum((yhat - ybar)**2)
        sstot = np.sum((y - ybar)**2)
        r_squared = ssreg / sstot if sstot != 0 else 0
        device_growth_slopes[device] = {'slope': slope, 'r2': r_squared}
        print(f"Device {device}: slope={slope:.2f}, R2={r_squared:.4f}")

# Analyze non-linear relationship between store_listing_conversion_rate and quality_score / crash_rate_per_1k
# Need data at package-region level? We have package-level quality and crash, country_report has conversion rate per region per package per day.
# Let's join at package-region-date level.
conversion_quality = pd.read_sql_query("""
    SELECT c.date_day, c.region, c.package_name,
           c.store_listing_conversion_rate as conversion_rate,
           c.active_devices_last_30_days as active_devices,
           t.quality_score,
           t.crash_rate_per_1k,
           t.anr_rate_per_1k,
           t.revenue_per_active_device
    FROM google_play__country_report c
    JOIN google_play__time_series_trends t
    ON c.date_day = t.date_day AND c.package_name = t.package_name
    WHERE c.store_listing_conversion_rate IS NOT NULL
    AND t.quality_score IS NOT NULL
    AND t.crash_rate_per_1k IS NOT NULL
""", conn)
print("\nConversion-quality join shape:", conversion_quality.shape)
print(conversion_quality.head())

# Save intermediate dataframes for later use
region_monthly.to_csv('region_monthly.csv', index=False)
device_monthly.to_csv('device_monthly.csv', index=False)
conversion_quality.to_csv('conversion_quality.csv', index=False)

conn.close()
```
