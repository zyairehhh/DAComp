'''
import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-078.sqlite')
# read account table
account_df = pd.read_sql_query('SELECT * FROM pendo__account', conn)
# read visitor daily metrics and join with visitor to get account_id
visitor_df = pd.read_sql_query('SELECT visitor_id, account_id FROM pendo__visitor', conn)
daily_df = pd.read_sql_query('SELECT * FROM pendo__visitor_daily_metrics', conn)
daily_df['date_day'] = pd.to_datetime(daily_df['date_day'])
# merge to get account_id
daily_df = daily_df.merge(visitor_df, on='visitor_id', how='left')
# define cutoff
cutoff = pd.Timestamp('2024-07-01')
# aggregate per account: pre-cutoff features
pre = daily_df[daily_df['date_day'] < cutoff]
pre_agg = pre.groupby('account_id').agg(
    pre_sum_minutes=('sum_minutes', 'sum'),
    pre_sum_events=('sum_events', 'sum'),
    pre_count_days=('date_day', 'nunique'),
    pre_count_pages_viewed=('count_pages_viewed', 'sum'),
    pre_count_features_clicked=('count_features_clicked', 'sum')
).reset_index()
# aggregate post-cutoff (future)
post = daily_df[daily_df['date_day'] >= cutoff]
post_agg = post.groupby('account_id').agg(
    post_sum_minutes=('sum_minutes', 'sum'),
    post_sum_events=('sum_events', 'sum'),
    post_count_days=('date_day', 'nunique'),
    post_count_pages_viewed=('count_pages_viewed', 'sum'),
    post_count_features_clicked=('count_features_clicked', 'sum')
).reset_index()
# merge with account
df = account_df.merge(pre_agg, left_on='account_id', right_on='account_id', how='left')
df = df.merge(post_agg, on='account_id', how='left')
# fill NaNs with 0 for post (if no future activity)
df.fillna(0, inplace=True)
# define label: high-value if post_sum_minutes > 75th percentile of non-zero? 
# Let's compute percentile of post_sum_minutes among accounts with some post activity
post_active = df[df['post_sum_minutes'] > 0]
if len(post_active) > 0:
    threshold = post_active['post_sum_minutes'].quantile(0.75)
    df['high_value'] = (df['post_sum_minutes'] >= threshold).astype(int)
else:
    # fallback: use top 25% of all accounts by pre_sum_minutes? Not ideal.
    threshold = df['pre_sum_minutes'].quantile(0.75)
    df['high_value'] = (df['pre_sum_minutes'] >= threshold).astype(int)
print("Data shape:", df.shape)
print("High value counts:", df['high_value'].value_counts())
print("Compute accuracy of simple model using pre_sum_minutes and pre_count_days")
# Simple model: predict high_value if pre_sum_minutes > median and pre_count_days > median
median_minutes = df['pre_sum_minutes'].median()
median_days = df['pre_count_days'].median()
pred = ((df['pre_sum_minutes'] > median_minutes) & (df['pre_count_days'] > median_days)).astype(int)
from sklearn.metrics import accuracy_score
accuracy = accuracy_score(df['high_value'], pred)
print(f"Accuracy using duration & frequency: {accuracy:.2%}")
# Let's also compute baseline (random)
baseline = max(df['high_value'].mean(), 1 - df['high_value'].mean())
print(f"Baseline (majority class): {baseline:.2%}")
''')
