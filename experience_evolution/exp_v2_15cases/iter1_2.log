    print(f"   Average revenue per active device: Mature = {rev_by_maturity.get('Mature',0):.5f}, Growing = {rev_by_maturity.get('Growing',0):.5f}")

# 4. Interaction effect of app update frequency on active devices and rating
print("\n4. Update Frequency Interaction")
# Load update events from DB
import sqlite3
conn = sqlite3.connect('dacomp-070.sqlite')
update_region = pd.read_sql_query("SELECT region, date_day, SUM(update_events) as total_updates FROM google_play__country_report GROUP BY region, date_day", conn)
update_region['date_day'] = pd.to_datetime(update_region['date_day'])
update_region['month'] = update_region['date_day'].dt.to_period('M')
update_region_monthly = update_region.groupby(['region','month']).agg({'total_updates':'sum'}).reset_index()
region_full = region_full.merge(update_region_monthly, on=['region','month'], how='left')
region_full['updates_per_device'] = region_full['total_updates'] / region_full['total_active_devices'].replace(0,np.nan)
# Correlation
corr_updates_active = region_full['updates_per_device'].corr(region_full['total_active_devices'])
corr_updates_rating = region_full['updates_per_device'].corr(region_full['avg_rating'])
print(f"   Region-level correlation updates per device vs active devices: {corr_updates_active:.3f}")
print(f"   Region-level correlation updates per device vs rating: {corr_updates_rating:.3f}")
# Quantile analysis
region_full['update_quartile'] = pd.qcut(region_full['updates_per_device'], q=4, labels=['Q1','Q2','Q3','Q4'])
quartile_means = region_full.groupby('update_quartile').agg({'total_active_devices':'mean','avg_rating':'mean'})
print("   Average active devices and rating by update frequency quartile:")
for q in ['Q1','Q2','Q3','Q4']:
    if q in quartile_means.index:
        print(f"      {q}: active devices {quartile_means.loc[q,'total_active_devices']:.0f}, rating {quartile_means.loc[q,'avg_rating']:.3f}")

conn.close()

print("\n--- Analysis Complete ---")
''')
