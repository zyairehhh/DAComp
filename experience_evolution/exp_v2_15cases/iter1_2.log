看到乱码再次出现，可能是系统编码问题。我决定直接编写一个简单脚本来计算贬损率，不要过度过滤。首先检查原始数据中的价格是否有异常。

Action: CreateFile(filepath='simple_analysis.py'):
```
import sqlite3
import pandas as pd
import re

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query('SELECT * FROM autohome;', conn)
conn.close()

print(f"Total rows: {len(df)}")

# 简单清理新价格
def clean_price_simple(s):
    if pd.isna(s):
        return None
    # 移除逗号和"yuan"，然后提取数字部分
    s = str(s).replace(',', '').replace('yuan', '').strip()
    # 可能有空格，直接取数字部分
    # 使用正则提取所有数字（包括小数点）
    match = re.search(r'(\d+(?:\.\d+)?)', s)
    if match:
        try:
            return float(match.group(1))
        except:
            return None
    else:
        return None

df['New_Price'] = df['New Car Price (incl. tax)'].apply(clean_price_simple)
print(f"Missing New_Price: {df['New_Price'].isna().sum()}")

# 检查Price列是否有缺失
print(f"Missing Price: {df['Price'].isna().sum()}")
print(f"Price min: {df['Price'].min()}, max: {df['Price'].max()}")

# 计算贬损率（折旧率）= 二手车价格 / 新车价格
df['Depreciation_Ratio'] = df['Price'] / df['New_Price']

print(f"Depreciation Ratio min: {df['Depreciation_Ratio'].min()}, max: {df['Depreciation_Ratio'].max()}")
print(f"Depreciation Ratio describe:")
print(df['Depreciation_Ratio'].describe())

# 过滤掉无效值（比率>1.5或<0.01）
valid = df[(df['Depreciation_Ratio'] > 0.01) & (df['Depreciation_Ratio'] < 1.5)]
print(f"Valid rows after ratio filter: {len(valid)}")

# 保存清理后的数据
valid.to_csv('cleaned_cars.csv', index=False)
print("Cleaned data saved to cleaned_cars.csv")
```

