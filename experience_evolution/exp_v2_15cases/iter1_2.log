import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query('SELECT * FROM sheet1', conn)
conn.close()

# Filter only completed rides
df_completed = df[df['Booking Status'] == 'Completed'].copy()

# Compute PKR (Per-kilometer ride fare)
df_completed['PKR'] = df_completed['Booking Value'] / df_completed['Ride Distance']

# Remove outliers where PKR is unrealistic (e.g., > 1000 or < 0.1)
df_completed = df_completed[(df_completed['PKR'] > 0.1) & (df_completed['PKR'] < 1000)]

# 1. Vehicle Type Impact on PKR
vehicle_order = ['Bike', 'eBike', 'Auto', 'Go Mini', 'Go Sedan', 'Premier Sedan', 'Uber XL']
vehicle_pkr = df_completed.groupby('Vehicle Type')['PKR'].mean().reindex(vehicle_order)
plt.figure(figsize=(10,6))
vehicle_pkr.plot(kind='bar', color='skyblue')
plt.title('Average Per-Kilometer Fare (PKR) by Vehicle Type')
plt.xlabel('Vehicle Type')
plt.ylabel('PKR (Booking Value / Distance)')
plt.tight_layout()
plt.savefig('vehicle_type_pkr.png', dpi=300)
plt.close()

print("Chart 1 saved as vehicle_type_pkr.png")

# 2. Service Quality Rating vs PKR
# Driver Ratings is the service quality rating (driver side)
# Filter valid ratings
df_ratings = df_completed.dropna(subset=['Driver Ratings'])
# Bin ratings into groups
bins = [0, 3.5, 4.0, 4.5, 4.7, 5.0]
labels = ['<3.5', '3.5-4.0', '4.0-4.5', '4.5-4.7', '>4.7']
df_ratings['Rating Group'] = pd.cut(df_ratings['Driver Ratings'], bins=bins, labels=labels, include_lowest=True)
rating_pkr = df_ratings.groupby('Rating Group')['PKR'].mean()
plt.figure(figsize=(10,6))
rating_pkr.plot(kind='line', marker='o')
plt.axvline(x=3, color='red', linestyle='--', label='Threshold 4.7')  # >4.7 group index ~3.5
plt.title('Average PKR by Driver Rating Group')
plt.xlabel('Driver Rating Group')
plt.ylabel('PKR')
plt.legend()
plt.tight_layout()
plt.savefig('rating_pkr.png', dpi=300)
plt.close()

print("Chart 2 saved as rating_pkr.png")

# 3. Time-of-Day Patterns (extract hour from Time column)
def extract_hour(t):
    if pd.isna(t):
        return np.nan
    # Time format 'HH:MM:SS'
    try:
        return int(t.split(':')[0])
    except:
        return np.nan

df_completed['Hour'] = df_completed['Time'].apply(extract_hour)
df_hour = df_completed.dropna(subset=['Hour'])
hourly_pkr = df_hour.groupby('Hour')['PKR'].mean()
plt.figure(figsize=(12,6))
hourly_pkr.plot(kind='line', color='green')
plt.axvspan(7, 9, alpha=0.3, color='yellow', label='AM Peak 7-9')
plt.axvspan(17, 19, alpha=0.3, color='orange', label='PM Peak 5-7')
plt.title('Average PKR by Hour of Day')
plt.xlabel('Hour of Day')
plt.ylabel('PKR')
plt.xticks(range(0,24))
plt.legend()
plt.tight_layout()
plt.savefig('hourly_pkr.png', dpi=300)
plt.close()

print("Chart 3 saved as hourly_pkr.png")

# 4. Geographic Variation - we need to infer urban vs suburban from Pickup Location
# Since we don't have zone classification, we'll assume locations with many pickups are urban centers.
# Let's compute average PKR per pickup location and take top vs bottom.
pickup_counts = df_completed['Pickup Location'].value_counts()
top_locations = pickup_counts.head(10).index.tolist()
df_top = df_completed[df_completed['Pickup Location'].isin(top_locations)]
location_pkr = df_top.groupby('Pickup Location')['PKR'].mean().sort_values(ascending=False)
plt.figure(figsize=(12,6))
location_pkr.plot(kind='bar', color='purple')
plt.title('Average PKR for Top 10 Pickup Locations')
plt.xlabel('Pickup Location')
plt.ylabel('PKR')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('location_pkr.png', dpi=300)
plt.close()

print("Chart 4 saved as location_pkr.png")

# 5. Driver Tenure effect – we don't have tenure data, maybe we can approximate by driver ID count of rides?
# Since we lack driver tenure, we'll skip this chart and instead do a scatter of Driver Ratings vs PKR.
plt.figure(figsize=(10,6))
sample = df_ratings.sample(n=5000, random_state=42)
plt.scatter(sample['Driver Ratings'], sample['PKR'], alpha=0.5, s=1)
plt.axvline(x=4.7, color='red', linestyle='--', label='Rating 4.7 threshold')
plt.title('Driver Rating vs PKR (Sampled Rides)')
plt.xlabel('Driver Rating')
plt.ylabel('PKR')
plt.legend()
plt.tight_layout()
plt.savefig('rating_scatter.png', dpi=300)
plt.close()

print("Chart 5 saved as rating_scatter.png")
