Let's analyze keyword level: we already saw match type distribution. Need to compute expected CVR per ad group based on campaign average or something. Let's compute expected CVR per campaign (average CVR of all ad groups within same campaign) and then compute Intent Match Ratio = actual CVR / expected CVR. That might be more meaningful.

Let's write a script to compute campaign-level expected CVR and see if problematic ad groups underperform relative to their campaign peers.

Action: CreateFile(filepath='/workspace/intent_match_ratio.py':
'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-060.sqlite')

# Aggregate ad_group_report per ad group with campaign
agg_query = """
SELECT
    ad_group_id,
    campaign_name,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions
FROM google_ads__ad_group_report
GROUP BY ad_group_id, campaign_name
HAVING total_impressions > 0 AND total_clicks > 0
"""
df = pd.read_sql_query(agg_query, conn)
df['CTR'] = df['total_clicks'] / df['total_impressions']
df['CVR'] = df['total_conversions'] / df['total_clicks']

# Compute campaign-level average CVR (expected CVR)
campaign_cvr = df.groupby('campaign_name')['CVR'].mean().reset_index()
campaign_cvr.rename(columns={'CVR': 'expected_cvr'}, inplace=True)

df = pd.merge(df, campaign_cvr, on='campaign_name', how='left')
df['Intent_Match_Ratio'] = df['CVR'] / df['expected_cvr']

# Identify problematic ad groups based on CTR > 75th percentile and CVR < 25th percentile (overall)
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()

print("=== Campaign-level Expected CVR Analysis ===")
print(f"Number of problematic ad groups: {len(problematic)}")
print(f"Average Intent Match Ratio (campaign baseline): {problematic['Intent_Match_Ratio'].mean():.4f}")
print(f"Median Intent Match Ratio: {problematic['Intent_Match_Ratio'].median():.4f}")
print()

# Show top 10 campaigns with highest number of problematic ad groups
top_campaigns = problematic['campaign_name'].value_counts().head(10)
print("Top Campaigns with problematic ad groups:")
print(top_campaigns)
print()

# For each top campaign, compute average IMR
for campaign, count in top_campaigns.items():
    camp_data = problematic[problematic['campaign_name'] == campaign]
    avg_imr = camp_data['Intent_Match_Ratio'].mean()
    print(f"Campaign: {campaign}, Problematic ads: {count}, Avg IMR: {avg_imr:.4f}")

# Compare IMR distribution with non-problematic
non_problematic = df[~((df['CTR'] > ctr_75) & (df['CVR'] < cvr_25))]
print(f"\nAverage IMR - Problematic: {problematic['Intent_Match_Ratio'].mean():.4f}, Non-problematic: {non_problematic['Intent_Match_Ratio'].mean():.4f}")
print(f"Median IMR - Problematic: {problematic['Intent_Match_Ratio'].median():.4f}, Non-problematic: {non_problematic['Intent_Match_Ratio'].median():.4f}")

# Save results
problematic.to_csv('problematic_campaign_imr.csv', index=False)

conn.close()
''')
