import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Load data
df1 = pd.read_csv('user_counts.csv')
df2 = pd.read_csv('abnormal_per_user.csv')
df_combined = pd.merge(df1, df2, on='Department')
df_combined['Abnormal_Per_User'] = df_combined['Abnormal_Login_Count'] / df_combined['user_count']

# Plot: Abnormal Logins Per User by Department
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

# Left: Bar chart of abnormal per user
ax1.bar(df_combined['Department'], df_combined['Abnormal_Per_User'], color='lightcoral')
ax1.set_title('Abnormal Logins Per User (Normalized)', fontsize=14, fontweight='bold')
ax1.set_xlabel('Department', fontsize=12)
ax1.set_ylabel('Abnormal Logins per User', fontsize=12)
ax1.set_xticklabels(df_combined['Department'], rotation=45, ha='right')
# Add value labels
for i, v in enumerate(df_combined['Abnormal_Per_User']):
    ax1.text(i, v, f'{v:.2f}', ha='center', va='bottom')

# Right: Stacked bar of count vs unique users
x = np.arange(len(df_combined))
width = 0.35
ax2.bar(x - width/2, df_combined['user_count'], width, label='Total Users', color='steelblue')
ax2.bar(x + width/2, df_combined['unique_users'], width, label='Users with Abnormal Logins', color='orange')
ax2.set_title('User Base vs Affected Users', fontsize=14, fontweight='bold')
ax2.set_xlabel('Department', fontsize=12)
ax2.set_ylabel('Number of Users', fontsize=12)
ax2.set_xticks(x)
ax2.set_xticklabels(df_combined['Department'], rotation=45, ha='right')
ax2.legend()

fig.tight_layout()
plt.savefig('plots/user_normalized_analysis.png', dpi=300)
plt.close()

# Add this plot to stage2.md
with open('stage2.md', 'a') as f:
    f.write('''
## 5. Departmental Analysis Normalized by User Count
![Abnormal Logins Per User and User Base](plots/user_normalized_analysis.png)

**Key Insight:** When normalized by the total number of users in each department, the Finance Department shows the highest abnormal‑login rate per user, followed closely by Technical. This indicates that **security‑awareness gaps are more pervasive within Finance** on a per‑capita basis, not merely a function of department size.

**Why This Matters for Stage1:** Stage1 may have identified high‑volume departments, but this normalized view highlights departments where security lapses are widespread among individual employees—a stronger indicator of cultural or training deficiencies. Finance emerges as the most critical target for awareness initiatives.
''')
```
