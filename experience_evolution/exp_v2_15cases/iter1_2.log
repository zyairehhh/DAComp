import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
import os

# Connect to database
conn = sqlite3.connect('dacomp-092.sqlite')

# 1. Identify high-volatility customers (top 25% by customer_margin_volatility)
query = """
SELECT DISTINCT customer_id, customer_margin_volatility 
FROM quickbooks__profitability_analysis 
WHERE customer_margin_volatility IS NOT NULL
"""
df_vol = pd.read_sql(query, conn)
# Compute 75th percentile
threshold = df_vol['customer_margin_volatility'].quantile(0.75)
high_vol_customers = df_vol[df_vol['customer_margin_volatility'] >= threshold]['customer_id'].tolist()
print(f"High-volatility customers threshold: {threshold:.5f}, count: {len(high_vol_customers)}")

# 2. For these customers, compute coefficient of variation of gross_profit over past 12 months
# Determine latest date
max_date = pd.read_sql("SELECT MAX(transaction_date) FROM quickbooks__profitability_analysis", conn).iloc[0,0]
max_date = pd.to_datetime(max_date)
start_date = max_date - pd.DateOffset(months=12)

query = """
SELECT customer_id, transaction_date, gross_profit 
FROM quickbooks__profitability_analysis 
WHERE customer_id IN ({}) 
    AND transaction_date >= ? 
    AND transaction_date <= ?
""".format(','.join(['?']*len(high_vol_customers)))
params = high_vol_customers + [start_date.strftime('%Y-%m-%d'), max_date.strftime('%Y-%m-%d')]
df_profit = pd.read_sql(query, conn, params=params)
df_profit['transaction_date'] = pd.to_datetime(df_profit['transaction_date'])

# Group by customer and compute stats
coeff_vars = []
for cust in high_vol_customers:
    sub = df_profit[df_profit['customer_id'] == cust]['gross_profit']
    if len(sub) > 0:
        mean = sub.mean()
        std = sub.std()
        coeff = std / mean if mean != 0 else np.nan
        coeff_vars.append({'customer_id': cust, 'coeff_var': coeff, 'mean_gp': mean, 'std_gp': std})
    else:
        coeff_vars.append({'customer_id': cust, 'coeff_var': np.nan, 'mean_gp': np.nan, 'std_gp': np.nan})
df_cv = pd.DataFrame(coeff_vars)

# 3. Variance of quarter-over-quarter invoice_total growth rate
# First, get quarter-level invoice totals for high-volatility customers
query = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as total_invoice
FROM quickbooks__profitability_analysis 
WHERE customer_id IN ({})
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
""".format(','.join(['?']*len(high_vol_customers)))
df_q = pd.read_sql(query, conn, params=high_vol_customers)

# Compute quarter-over-quarter growth rate per customer
growth_variances = []
for cust in high_vol_customers:
    sub = df_q[df_q['customer_id'] == cust].sort_values(['revenue_year', 'revenue_quarter'])
    sub = sub.reset_index(drop=True)
    if len(sub) > 1:
        sub['prev_total'] = sub['total_invoice'].shift(1)
        sub['growth_rate'] = (sub['total_invoice'] - sub['prev_total']) / sub['prev_total']
        variance = sub['growth_rate'].var()
        growth_variances.append({'customer_id': cust, 'growth_var': variance})
    else:
        growth_variances.append({'customer_id': cust, 'growth_var': np.nan})
df_growth = pd.DataFrame(growth_variances)

# Merge with coefficient of variation
df_metrics = pd.merge(df_cv, df_growth, on='customer_id', how='left')

# 4. Behavioral features from customer_analytics
query = """
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation, lifecycle_stage, customer_value_segment
FROM quickbooks__customer_analytics 
WHERE customer_id IN ({})
""".format(','.join(['?']*len(high_vol_customers)))
df_behav = pd.read_sql(query, conn, params=high_vol_customers)
df_metrics = pd.merge(df_metrics, df_behav, on='customer_id', how='left')

# 5. Contribution to overall business_health_score and collection_rate_percentage from financial_dashboard
# Compute average business_health_score and collection_rate_percentage across all months
query = "SELECT AVG(business_health_score) as avg_health, AVG(collection_rate_percentage) as avg_collection FROM quickbooks__financial_dashboard"
df_avg = pd.read_sql(query, conn)
avg_health = df_avg['avg_health'].iloc[0]
avg_collection = df_avg['avg_collection'].iloc[0]

# For high-vol customers, we need their invoice totals and collected amounts over time to compute contribution
query = """
SELECT p.customer_id, p.transaction_date, p.invoice_total, p.collected_amount
FROM quickbooks__profitability_analysis p
WHERE p.customer_id IN ({})
""".format(','.join(['?']*len(high_vol_customers)))
df_all = pd.read_sql(query, conn, params=high_vol_customers)
df_all['transaction_date'] = pd.to_datetime(df_all['transaction_date'])
df_all['year_month'] = df_all['transaction_date'].dt.to_period('M')

# Aggregate monthly totals
monthly = df_all.groupby('year_month').agg({'invoice_total':'sum', 'collected_amount':'sum'}).reset_index()
# Compute overall totals across all customers and months
query_overall = """
SELECT SUM(invoice_total) as total_invoice_all, SUM(collected_amount) as total_collected_all 
FROM quickbooks__profitability_analysis
"""
df_overall = pd.read_sql(query_overall, conn)
total_invoice_all = df_overall['total_invoice_all'].iloc[0]
total_collected_all = df_overall['total_collected_all'].iloc[0]

# Contribution of high-vol customers to total invoice and collected
highvol_invoice = df_all['invoice_total'].sum()
highvol_collected = df_all['collected_amount'].sum()
contrib_invoice = highvol_invoice / total_invoice_all if total_invoice_all != 0 else 0
contrib_collected = highvol_collected / total_collected_all if total_collected_all != 0 else 0

print(f"High-vol customers invoice contribution: {contrib_invoice:.2%}")
print(f"High-vol customers collected contribution: {contrib_collected:.2%}")

# 6. Risk exposure from balance_sheet accounts receivable structure
query = """
SELECT account_name, SUM(amount) as total_amount
FROM quickbooks__balance_sheet 
WHERE account_class = 'Accounts Receivable' OR account_name LIKE '%Receivable%'
GROUP BY account_name
"""
df_ar = pd.read_sql(query, conn)
print("Accounts Receivable structure:")
print(df_ar)

conn.close()

# VISUALIZATIONS
sns.set_style("whitegrid")
plt.rcParams['figure.figsize'] = (12,8)

# 1. Distribution of customer_margin_volatility with threshold
plt.figure()
sns.histplot(df_vol['customer_margin_volatility'], kde=True)
plt.axvline(threshold, color='red', linestyle='--', label=f'75th percentile = {threshold:.3f}')
plt.xlabel('Customer Margin Volatility')
plt.ylabel('Frequency')
plt.title('Distribution of Customer Margin Volatility')
plt.legend()
plt.tight_layout()
plt.savefig('volatility_distribution.png')
plt.close()

# 2. Coefficient of Variation vs Growth Variance scatter with behavioral segments
df_plot = df_metrics.dropna(subset=['coeff_var', 'growth_var'])
if not df_plot.empty:
    plt.figure()
    # Use rfm_segment for color
    unique_segments = df_plot['rfm_segment'].dropna().unique()
    color_map = {seg: plt.cm.tab10(i) for i, seg in enumerate(unique_segments)}
    for seg in unique_segments:
        subset = df_plot[df_plot['rfm_segment'] == seg]
        plt.scatter(subset['coeff_var'], subset['growth_var'], label=seg, alpha=0.7)
    plt.xlabel('Coefficient of Variation of Gross Profit (12 months)')
    plt.ylabel('Variance of Quarter-over-Quarter Invoice Growth')
    plt.title('High-Volatility Customers: Profit Stability vs Growth Volatility')
    plt.legend(title='RFM Segment')
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig('cv_vs_growth_scatter.png')
    plt.close()

# 3. Payment behavior composition among high-vol customers
plt.figure()
df_behav['payment_behavior'].value_counts().plot(kind='bar', color='skyblue')
plt.xlabel('Payment Behavior')
plt.ylabel('Count')
plt.title('Payment Behavior Distribution among High-Volatility Customers')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('payment_behavior_bar.png')
plt.close()

# 4. Lifecycle stage composition
plt.figure()
df_behav['lifecycle_stage'].value_counts().plot(kind='bar', color='lightgreen')
plt.xlabel('Lifecycle Stage')
plt.ylabel('Count')
plt.title('Lifecycle Stage Distribution among High-Volatility Customers')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('lifecycle_stage_bar.png')
plt.close()

# 5. Contribution to overall invoice total vs collection rate
labels = ['High-Vol Customers', 'Other Customers']
invoice_vals = [highvol_invoice, total_invoice_all - highvol_invoice]
collected_vals = [highvol_collected, total_collected_all - highvol_collected]
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12,5))
ax1.pie(invoice_vals, labels=labels, autopct='%1.1f%%', startangle=90)
ax1.set_title('Invoice Total Contribution')
ax2.pie(collected_vals, labels=labels, autopct='%1.1f%%', startangle=90)
ax2.set_title('Collected Amount Contribution')
plt.suptitle('High-Volatility Customers vs Others: Contribution to Revenue')
plt.tight_layout()
plt.savefig('contribution_pie.png')
plt.close()

# 6. Accounts Receivable breakdown
plt.figure()
df_ar_sorted = df_ar.sort_values('total_amount', ascending=False)
sns.barplot(x='total_amount', y='account_name', data=df_ar_sorted, palette='viridis')
plt.xlabel('Amount')
plt.ylabel('Account Name')
plt.title('Accounts Receivable Structure (Risk Exposure)')
plt.tight_layout()
plt.savefig('ar_structure.png')
plt.close()

print("Visualizations saved.")
