```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import os

# Load database
db_path = "/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter1/dacomp-035/stage2_env/dacomp-035.sqlite"
conn = sqlite3.connect(db_path)

# Get user information with department
query_users = """
SELECT "User ID" as user_id, Department 
FROM user_information_table 
WHERE Department IN ('Marketing', 'Finance', 'Sales', 'Technical')
"""
users_df = pd.read_sql_query(query_users, conn)

# Get login records and abnormal logins
query_logs = """
SELECT 
    lr."User ID" as user_id,
    lr."Login Record ID" as login_record_id,
    al."Anomaly ID",
    al."Anomaly Type",
    al."Risk Level",
    al."Anomaly Score",
    al."Confirmation Status"
FROM login_records_table lr
LEFT JOIN abnormal_logins_table al ON lr."Login Record ID" = al."Login Record ID"
"""
logs_df = pd.read_sql_query(query_logs, conn)

# Merge with department info
logs_dept_df = logs_df.merge(users_df, on="user_id", how="inner")

# Calculate metrics per department
departments = ['Marketing', 'Finance', 'Sales', 'Technical']
metrics = []

for dept in departments:
    dept_users = users_df[users_df['Department'] == dept]
    dept_logs = logs_dept_df[logs_dept_df['Department'] == dept]
    
    # Basic counts
    employees = dept_users['user_id'].nunique()
    total_logins = dept_logs['login_record_id'].nunique()
    abnormal_logins = dept_logs['Anomaly ID'].notna().sum()
    
    # Filter abnormal logs
    abnormal_df = dept_logs[dept_logs['Anomaly ID'].notna()]
    
    # Risk level counts
    high_severe_count = abnormal_df[abnormal_df['Risk Level'].isin(['High', 'Severe'])].shape[0]
    
    # Calculate anomaly scores for high/severe
    high_severe_df = abnormal_df[abnormal_df['Risk Level'].isin(['High', 'Severe'])]
    avg_high_severe_score = high_severe_df['Anomaly Score'].mean() if not high_severe_df.empty and high_severe_df['Anomaly Score'].notna().any() else 0
    
    # Anomaly type distribution
    anomaly_types = abnormal_df['Anomaly Type'].value_counts(normalize=True).to_dict()
    
    # Risk-weighted index
    risk_weights = {'Severe': 5, 'High': 3, 'Medium': 2, 'Low': 1}
    abnormal_df['risk_weight'] = abnormal_df['Risk Level'].map(risk_weights)
    risk_weighted_index = abnormal_df['risk_weight'].sum() / employees if not abnormal_df.empty else 0
    
    metrics.append({
        'Department': dept,
        'Employees': employees,
        'Total_Logins': total_logins,
        'Total_Abnormal': abnormal_logins,
        'Abnormal_per_Employee': abnormal_logins / employees if employees > 0 else 0,
        'High_Severe_per_Employee': high_severe_count / employees if employees > 0 else 0,
        'Avg_High_Severe_Score': avg_high_severe_score,
        'Abnormal_Rate': (abnormal_logins / total_logins * 100) if total_logins > 0 else 0,
        'Risk_Weighted_Index': risk_weighted_index,
        'Anomaly_Types': anomaly_types
    })

metrics_df = pd.DataFrame(metrics)
print("Calculated Metrics:")
print(metrics_df[['Department', 'Employees', 'Total_Abnormal', 'High_Severe_per_Employee', 'Avg_High_Severe_Score', 'Risk_Weighted_Index']])

# Set style
plt.style.use('seaborn-v0_8-darkgrid')
matplotlib.rcParams['font.size'] = 10

# Create visualization directory
plot_dir = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter1/dacomp-035/stage2_env/plots'
os.makedirs(plot_dir, exist_ok=True)

# 1. High+Severe per Employee by Department
plt.figure(figsize=(10, 6))
bars = plt.bar(metrics_df['Department'], metrics_df['High_Severe_per_Employee'], 
               color=['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4'])
plt.title('High+Severe Abnormal Logins per Employee by Department', fontsize=14, fontweight='bold')
plt.xlabel('Department', fontsize=12)
plt.ylabel('High+Severe Logins per Employee', fontsize=12)
plt.grid(axis='y', alpha=0.3)

# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.005,
             f'{height:.3f}', ha='center', va='bottom', fontweight='bold')

plt.tight_layout()
plt.savefig(f'{plot_dir}/high_severe_per_employee.png', dpi=300, bbox_inches='tight')
plt.close()

# 2. Average High+Severe Score by Department
plt.figure(figsize=(10, 6))
bars = plt.bar(metrics_df['Department'], metrics_df['Avg_High_Severe_Score'], 
               color=['#4ECDC4', '#FF6B6B', '#45B7D1', '#96CEB4'])
plt.title('Average High+Severe Anomaly Score by Department', fontsize=14, fontweight='bold')
plt.xlabel('Department', fontsize=12)
plt.ylabel('Average Anomaly Score', fontsize=12)
plt.grid(axis='y', alpha=0.3)

# Add value labels
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.2,
             f'{height:.1f}', ha='center', va='bottom', fontweight='bold')

plt.tight_layout()
plt.savefig(f'{plot_dir}/avg_high_severe_score.png', dpi=300, bbox_inches='tight')
plt.close()

# 3. Risk-Weighted Index by Department
plt.figure(figsize=(10, 6))
bars = plt.bar(metrics_df['Department'], metrics_df['Risk_Weighted_Index'], 
               color=['#45B7D1', '#FF6B6B', '#4ECDC4', '#96CEB4'])
plt.title('Risk-Weighted Index by Department', fontsize=14, fontweight='bold')
plt.xlabel('Department', fontsize=12)
plt.ylabel('Risk-Weighted Index', fontsize=12)
plt.grid(axis='y', alpha=0.3)

# Add value labels
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.005,
             f'{height:.3f}', ha='center', va='bottom', fontweight='bold')

plt.tight_layout()
plt.savefig(f'{plot_dir}/risk_weighted_index.png', dpi=300, bbox_inches='tight')
plt.close()

# 4. Anomaly Type Distribution by Department (Stacked Bar Chart)
# Prepare anomaly type data
anomaly_types_list = ['Device anomaly', 'Multiple IPs in short time', 'Frequent login', 'Remote Login']
type_data = []

for dept in departments:
    dept_metrics = next(m for m in metrics if m['Department'] == dept)
    type_row = []
    for anomaly_type in anomaly_types_list:
        type_row.append(dept_metrics['Anomaly_Types'].get(anomaly_type, 0) * 100)  # Convert to percentage
    type_data.append(type_row)

type_data = np.array(type_data)

plt.figure(figsize=(12, 7))
bottom = np.zeros(len(departments))
colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFE66D']

for i, anomaly_type in enumerate(anomaly_types_list):
    plt.bar(departments, type_data[:, i], bottom=bottom, label=anomaly_type, color=colors[i], edgecolor='white')
    bottom += type_data[:, i]

plt.title('Anomaly Type Distribution by Department', fontsize=14, fontweight='bold')
plt.xlabel('Department', fontsize=12)
plt.ylabel('Percentage of Abnormal Logins (%)', fontsize=12)
plt.legend(title='Anomaly Type', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(axis='y', alpha=0.3)

# Add percentage labels
for i, dept in enumerate(departments):
    bottom_val = 0
    for j in range(len(anomaly_types_list)):
        if type_data[i, j] > 5:  # Only label if >5% for readability
            plt.text(i, bottom_val + type_data[i, j]/2, f'{type_data[i, j]:.1f}%', 
                    ha='center', va='center', color='black', fontsize=9)
        bottom_val += type_data[i, j]

plt.tight_layout()
plt.savefig(f'{plot_dir}/anomaly_type_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# 5. Total Abnormal Logins vs Employees (Bubble Chart)
plt.figure(figsize=(10, 6))
for i, row in metrics_df.iterrows():
    plt.scatter(row['Employees'], row['Total_Abnormal'], 
                s=row['High_Severe_per_Employee'] * 1500,  # Bubble size based on critical risk
                alpha=0.6, label=row['Department'])
    
# Add labels and connection line to origin for visual reference
plt.plot([0, max(metrics_df['Employees']) * 1.1], [0, max(metrics_df['Total_Abnormal']) * 1.1], 
        'k--', alpha=0.3, label='Linear Reference')

plt.title('Total Abnormal Logins vs Employees', fontsize=14, fontweight='bold')
plt.xlabel('Number of Employees', fontsize=12)
plt.ylabel('Total Abnormal Logins', fontsize=12)
plt.legend(title='Department')
plt.grid(True, alpha=0.3)

# Add department labels next to bubbles
for i, row in metrics_df.iterrows():
    plt.annotate(row['Department'], 
                (row['Employees'], row['Total_Abnormal']),
                xytext=(5, 5), textcoords='offset points',
                fontsize=10, fontweight='bold')

plt.tight_layout()
plt.savefig(f'{plot_dir}/abnormal_vs_employees.png', dpi=300, bbox_inches='tight')
plt.close()

print(f"Plots saved to {plot_dir}")
```
