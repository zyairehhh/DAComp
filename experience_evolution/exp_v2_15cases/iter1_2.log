        WHEN avg_transaction_value < 3 THEN 'Low-Revenue Market'
        ELSE 'Mid' 
    END as segment,
    COUNT(DISTINCT country) as country_count,
    AVG(app_quality_score) as avg_quality_score,
    AVG(app_crash_rate_per_1k) as avg_crash_rate,
    AVG(day_1_retention_rate) as avg_day1_retention,
    AVG(daily_churn_rate) as avg_daily_churn,
    AVG(store_conversion_rate) as avg_conversion_rate,
    AVG(weekly_growth_rate) as avg_weekly_growth
