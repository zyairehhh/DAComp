    s = str(mileage_str).strip()
    # remove any trailing "(no space)"
    s = s.replace('(no space)', '').strip()
    # pattern for ten thousand km
    match = re.search(r'([\d.]+)\s*ten thousand km', s)
    if match:
        value = float(match.group(1))
        return value * 10000
    # pattern for km with commas
    match2 = re.search(r'([\d,]+)\s*km', s)
    if match2:
        return float(match2.group(1).replace(',', ''))
    # if just a number? fallback
    try:
        return float(s.split()[0])
    except:
        return np.nan

def parse_date(date_str):
    try:
        return pd.to_datetime(date_str)
    except:
        return pd.NaT

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome", conn)
conn.close()

# Process
df['new_price_yuan'] = df['New Car Price (incl. tax)'].apply(parse_price)
df['used_price_yuan'] = df['Price'] * 10000
df['retention_rate'] = df['used_price_yuan'] / df['new_price_yuan']
df['mileage_km'] = df['Mileage'].apply(parse_mileage)
df['reg_date'] = df['Registration Date'].apply(parse_date)
df['post_date'] = df['Posting Date'].apply(parse_date)
df['age_years'] = (df['post_date'] - df['reg_date']).dt.days / 365.25

# Clean
df = df[(df['retention_rate'] <= 1) & (df['retention_rate'] > 0) & (df['age_years'] >= 0)]
df = df.dropna(subset=['new_price_yuan', 'mileage_km'])

# Price segments
bins = [0, 100000, 200000, 300000, 500000, 1000000, float('inf')]
labels = ['<100k', '100k-200k', '200k-300k', '300k-500k', '500k-1M', '>1M']
df['price_segment'] = pd.cut(df['new_price_yuan'], bins=bins, labels=labels)

segment_stats = df.groupby('price_segment').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    median_retention=('retention_rate', 'median'),
    avg_new_price=('new_price_yuan', 'mean'),
    avg_used_price=('used_price_yuan', 'mean'),
    avg_mileage=('mileage_km', 'mean'),
    avg_age=('age_years', 'mean')
).sort_values('avg_retention', ascending=False)

print("=== Retention by New Price Segment (¥) ===")
print(segment_stats)

# Top models per segment with at least 3 listings
def extract_model(title):
    # Take first three words as model
    words = str(title).split()
    return ' '.join(words[:3])

df['model'] = df['Title'].apply(extract_model)

top_by_segment = {}
for segment in labels:
    seg_df = df[df['price_segment'] == segment]
    if len(seg_df) < 3:
        continue
    model_stats = seg_df.groupby('model').agg(
        count=('retention_rate', 'size'),
        avg_retention=('retention_rate', 'mean'),
        median_used_price=('used_price_yuan', 'median'),
        avg_age=('age_years', 'mean'),
        avg_mileage=('mileage_km', 'mean')
    )
    model_stats = model_stats[model_stats['count'] >= 3]
    if len(model_stats) > 0:
        top = model_stats.sort_values('avg_retention', ascending=False).head(5)
        top_by_segment[segment] = top

for seg, top in top_by_segment.items():
    print(f"\n=== Top models in segment {seg} (¥) ===")
    print(top)

# Overall top models (all segments) with min 5 listings
print("\n=== Overall Top Models (min 5 listings) ===")
overall_model_stats = df.groupby('model').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    median_used_price=('used_price_yuan', 'median'),
    avg_age=('age_years', 'mean'),
    avg_mileage=('mileage_km', 'mean')
).sort_values('avg_retention', ascending=False)
overall_model_stats = overall_model_stats[overall_model_stats['count'] >= 5]
print(overall_model_stats.head(20))

# Depreciation per year and per 10k km
df['annual_depreciation_pct'] = (1 - df['retention_rate']) / df['age_years']
df['depreciation_per_10k_km'] = (1 - df['retention_rate']) / (df['mileage_km'] / 10000)

# Find models with lowest depreciation per year (good buyback)
df_low_depr = df[(df['annual_depreciation_pct'] > 0) & (df['annual_depreciation_pct'] < 1)]
low_depr_models = df_low_depr.groupby('model').agg(
    count=('annual_depreciation_pct', 'size'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
    avg_retention=('retention_rate', 'mean'),
    avg_age=('age_years', 'mean'),
    avg_mileage=('mileage_km', 'mean')
).sort_values('avg_annual_depr')
low_depr_models = low_depr_models[low_depr_models['count'] >= 3]
print("\n=== Models with Lowest Annual Depreciation (min 3 listings) ===")
print(low_depr_models.head(10))

# Save final dataset for reference
df.to_csv('final_processed.csv', index=False)
print("\nFinal processed data saved to final_processed.csv")
''')
