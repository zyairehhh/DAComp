'''
import pandas as pd
import numpy as np
import sqlite3
import math

# Connect to database
db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-076/stage1_env/dacomp-076.sqlite'
conn = sqlite3.connect(db_path)
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
conn.close()

# Compute segment average retention
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'seg_avg_retention']
df = pd.merge(df, segment_avg, on='profitability_segment')
df['deviation'] = abs(df['retention_probability'] - df['seg_avg_retention'])
df['is_anomaly'] = df['deviation'] > 0.15

# Derived dimensions
# 1. Transaction stability: ratio of transaction_count to expected annual transactions
df['expected_annual_trans'] = df['avg_transactions_per_month'] * 12
df['trans_stability_ratio'] = df['transaction_count'] / (df['expected_annual_trans'] + 1e-9)
# volatility column already exists (transaction_value_volatility)

# 2. Seasonal balance: compute Gini coefficient of Q1-Q4 transactions
def gini(array):
    """Compute Gini coefficient."""
    array = array.astype(float)
    if np.all(array == 0):
        return 0
    array = array.flatten()
    array = np.sort(array)
    n = len(array)
    index = np.arange(1, n + 1)
    return (np.sum((2 * index - n - 1) * array)) / (n * np.sum(array))

season_cols = ['q1_transactions', 'q2_transactions', 'q3_transactions', 'q4_transactions']
season_array = df[season_cols].values
df['seasonal_gini'] = np.apply_along_axis(gini, 1, season_array)

# 3. Value realization alignment: score per revenue
df['score_per_revenue'] = df['comprehensive_customer_score'] / (df['total_revenue'] + 1e-9)

# Compute correlation between these derived dimensions and anomaly flag
