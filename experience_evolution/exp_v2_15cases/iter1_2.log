import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from datetime import datetime
from scipy import stats

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 3. Non-linear relationship between conversion rate and quality/crash
# Get per-app per-day conversion rate from country_report
query_conv = """
SELECT date_day, package_name, 
       AVG(store_listing_conversion_rate) as avg_conversion_rate
FROM google_play__country_report 
WHERE store_listing_conversion_rate IS NOT NULL 
GROUP BY date_day, package_name
ORDER BY date_day, package_name
"""
df_conv = pd.read_sql_query(query_conv, conn)
df_conv['date_day'] = pd.to_datetime(df_conv['date_day'])

# Get quality and crash from time_series_trends
query_quality = """
SELECT date_day, package_name, quality_score, crash_rate_per_1k
FROM google_play__time_series_trends 
WHERE quality_score IS NOT NULL AND crash_rate_per_1k IS NOT NULL
"""
df_quality = pd.read_sql_query(query_quality, conn)
df_quality['date_day'] = pd.to_datetime(df_quality['date_day'])

# Join
df_merge = pd.merge(df_conv, df_quality, on=['date_day', 'package_name'], how='inner')

# Plot conversion vs quality (quadratic)
fig, axes = plt.subplots(2, 4, figsize=(16, 8))
apps = df_merge['package_name'].unique()
for idx, app in enumerate(apps):
    ax = axes[idx//4, idx%4]
    sub = df_merge[df_merge['package_name']==app]
    if len(sub) < 3:
        continue
    x = sub['quality_score'].values
    y = sub['avg_conversion_rate'].values
    # Quadratic fit
    coeffs = np.polyfit(x, y, 2)
    poly = np.poly1d(coeffs)
    x_fit = np.linspace(np.min(x), np.max(x), 100)
    y_fit = poly(x_fit)
    ax.scatter(x, y, alpha=0.5, s=20)
    ax.plot(x_fit, y_fit, color='red', linewidth=2)
    r_squared = np.corrcoef(y, poly(x))[0,1]**2
    ax.set_title(f'{app}\\nR²={r_squared:.4f}', fontsize=8)
    if idx//4 == 1:
        ax.set_xlabel('Quality Score')
    if idx%4 == 0:
        ax.set_ylabel('Conversion Rate')
plt.suptitle('Conversion Rate vs Quality Score (Quadratic Fit per App)')
plt.tight_layout()
plt.savefig('conversion_vs_quality.png', dpi=300)
plt.close()

# Plot conversion vs crash rate (quadratic)
fig, axes = plt.subplots(2, 4, figsize=(16, 8))
for idx, app in enumerate(apps):
    ax = axes[idx//4, idx%4]
    sub = df_merge[df_merge['package_name']==app]
    if len(sub) < 3:
        continue
    x = sub['crash_rate_per_1k'].values
    y = sub['avg_conversion_rate'].values
    # Quadratic fit
    coeffs = np.polyfit(x, y, 2)
    poly = np.poly1d(coeffs)
    x_fit = np.linspace(np.min(x), np.max(x), 100)
    y_fit = poly(x_fit)
    ax.scatter(x, y, alpha=0.5, s=20)
    ax.plot(x_fit, y_fit, color='red', linewidth=2)
    r_squared = np.corrcoef(y, poly(x))[0,1]**2
    ax.set_title(f'{app}\\nR²={r_squared:.4f}', fontsize=8)
    if idx//4 == 1:
        ax.set_xlabel('Crash Rate per 1k')
    if idx%4 == 0:
        ax.set_ylabel('Conversion Rate')
plt.suptitle('Conversion Rate vs Crash Rate per 1k (Quadratic Fit per App)')
plt.tight_layout()
plt.savefig('conversion_vs_crash.png', dpi=300)
plt.close()

# 4. Revenue per active device vs active devices by market maturity
# Compute cumulative installs per app per day as maturity proxy
query_cum = """
SELECT date_day, package_name, 
       SUM(daily_installs) OVER (PARTITION BY package_name ORDER BY date_day) as cum_installs,
       revenue_per_active_device,
       active_devices
FROM google_play__time_series_trends
WHERE active_devices > 0 AND revenue_per_active_device IS NOT NULL
"""
df_maturity = pd.read_sql_query(query_cum, conn)
df_maturity['date_day'] = pd.to_datetime(df_maturity['date_day'])
# Determine median cumulative installs per app
median_vals = df_maturity.groupby('package_name')['cum_installs'].median().reset_index()
median_vals =median_vals.rename(columns={'cum_installs':'median_cum_installs'})
df_maturity = df_maturity.merge(median_vals, on='package_name')
df_maturity['maturity'] = np.where(df_maturity['cum_installs'] < df_maturity['median_cum_installs'], 'low', 'high')

# Plot for low maturity
low = df_maturity[df_maturity['maturity']=='low']
plt.figure(figsize=(10, 6))
# Color by app
for app in low['package_name'].unique():
    app_data = low[low['package_name']==app]
    plt.scatter(app_data['active_devices'], app_data['revenue_per_active_device'], alpha=0.6, s=20, label=app)
plt.xlabel('Active Devices')
plt.ylabel('Revenue per Active Device')
r_low, p_low = stats.pearsonr(low['active_devices'], low['revenue_per_active_device'])
plt.title(f'Low Maturity Periods (cumulative installs < median)\\nCorrelation = {r_low:.3f}')
plt.legend(fontsize=8, ncol=2)
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('revenue_vs_active_low_maturity.png', dpi=300)
plt.close()

# Plot for high maturity
high = df_maturity[df_maturity['maturity']=='high']
plt.figure(figsize=(10, 6))
for app in high['package_name'].unique():
    app_data = high[high['package_name']==app]
    plt.scatter(app_data['active_devices'], app_data['revenue_per_active_device'], alpha=0.6, s=20, label=app)
plt.xlabel('Active Devices')
plt.ylabel('Revenue per Active Device')
r_high, p_high = stats.pearsonr(high['active_devices'], high['revenue_per_active_device'])
plt.title(f'High Maturity Periods (cumulative installs >= median)\\nCorrelation = {r_high:.3f}')
plt.legend(fontsize=8, ncol=2)
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('revenue_vs_active_high_maturity.png', dpi=300)
plt.close()

# 5. Interaction effect of app update frequency
# Compute update frequency (7‑day moving average of update_events) per app per day from device_report?
# Actually, we can get update events from country_report (aggregated per day per region) but better from device_report across all devices.

# Use device_report aggregated per day per app
query_update = """
SELECT date_day, package_name, 
       SUM(update_events) as total_update_events,
       AVG(rolling_total_average_rating) as avg_rating,
       SUM(active_devices_last_30_days) as total_active_devices
FROM google_play__device_report
WHERE update_events IS NOT NULL AND active_devices_last_30_days > 0
GROUP BY date_day, package_name
"""
df_update = pd.read_sql_query(query_update, conn)
df_update['date_day'] = pd.to_datetime(df_update['date_day'])
# Compute 7‑day moving average per app
df_update['update_ma7'] = df_update.groupby('package_name')['total_update_events'].transform(lambda x: x.rolling(7, min_periods=1).mean())

# Plot update frequency vs active devices
plt.figure(figsize=(10, 6))
for app in df_update['package_name'].unique():
    app_data = df_update[df_update['package_name']==app]
    plt.scatter(app_data['update_ma7'], app_data['total_active_devices'], alpha=0.6, s=20, label=app)
plt.xlabel('Update Frequency (7‑day MA of daily update events)')
plt.ylabel('Active Devices (last 30 days)')
r_active, p_active = stats.pearsonr(df_update['update_ma7'], df_update['total_active_devices'])
plt.title(f'Update Frequency vs Active Devices (All Apps)\\nOverall correlation = {r_active:.4f}')
plt.legend(fontsize=8, ncol=2)
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('update_vs_active_devices.png', dpi=300)
plt.close()

# Plot update frequency vs rolling average rating
plt.figure(figsize=(10, 6))
for app in df_update['package_name'].unique():
    app_data = df_update[df_update['package_name']==app]
    plt.scatter(app_data['update_ma7'], app_data['avg_rating'], alpha=0.6, s=20, label=app)
plt.xlabel('Update Frequency (7‑day MA of daily update events)')
plt.ylabel('Rolling Total Average Rating')
r_rating, p_rating = stats.pearsonr(df_update['update_ma7'], df_update['avg_rating'])
plt.title(f'Update Frequency vs Rating (All Apps)\\nOverall correlation = {r_rating:.4f}')
plt.legend(fontsize=8, ncol=2)
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('update_vs_rating.png', dpi=300)
plt.close()

conn.close()
