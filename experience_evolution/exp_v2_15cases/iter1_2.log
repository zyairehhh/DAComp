    FROM netsuite2_customer_analytics
    GROUP BY profitability_segment
),
anomaly_flag AS (
    SELECT 
        *,
        ABS(retention_probability - seg_avg_retention) AS deviation,
        CASE WHEN ABS(retention_probability - seg_avg_retention) > 0.15 THEN 1 ELSE 0 END AS is_anomaly
    FROM netsuite2_customer_analytics n
    JOIN seg_avg s ON n.profitability_segment = s.profitability_segment
)
SELECT 
    profitability_segment,
    is_anomaly,
    COUNT(*) AS count,
    AVG(transaction_value_volatility) AS avg_volatility,
    AVG(transaction_count) AS avg_trans_count,
    AVG(avg_transactions_per_month) AS avg_trans_per_month,
    AVG(comprehensive_customer_score) AS avg_score,
    AVG(total_revenue) AS avg_revenue,
    AVG(retention_probability) AS avg_retention
FROM anomaly_flag
GROUP BY profitability_segment, is_anomaly
