import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-093.sqlite')
df = pd.read_sql_query("SELECT * FROM klaviyo__campaigns", conn)
conn.close()

# Compute derived metrics
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open'] = df['count_clicked_email'] / df['count_opened_email']

# Extract categories from SUBJECT
def extract_subject_category(subject):
    if isinstance(subject, str):
        if '限时折扣' in subject:
            return 'discount'
        elif '新品上新' in subject:
            return 'new'
        elif '品牌故事' in subject:
            return 'storytelling'
    return None

df['subject_category'] = df['SUBJECT'].apply(extract_subject_category)

def extract_weekday_weekend(subject):
    if isinstance(subject, str):
        if '工作日' in subject:
            return 'weekday'
        elif '周末' in subject:
            return 'weekend'
    return None

df['weekday_weekend'] = df['SUBJECT'].apply(extract_weekday_weekend)

def extract_time_of_day(subject):
    if isinstance(subject, str):
        if '上午' in subject:
            return 'morning'
        elif '下午' in subject:
            return 'afternoon'
        elif '晚间' in subject:
            return 'evening'
    return None

df['time_of_day'] = df['SUBJECT'].apply(extract_time_of_day)

def extract_holiday(subject):
    if isinstance(subject, str):
        if '节前' in subject:
            return 'pre-holiday'
        elif '节后' in subject:
            return 'post-holiday'
        else:
            return 'non-holiday'
    return None

df['holiday'] = df['SUBJECT'].apply(extract_holiday)

# Filter out missing categories
df_clean = df.dropna(subset=['subject_category', 'weekday_weekend', 'time_of_day', 'holiday'])

# Summary statistics by subject category
subject_summary = df_clean.groupby('subject_category').agg(
    count=('open_rate', 'size'),
    mean_open_rate=('open_rate', 'mean'),
    mean_click_rate=('click_rate', 'mean'),
    mean_cto=('click_to_open', 'mean')
).round(4)

# Summary by weekday/weekend and time of day
time_summary = df_clean.groupby(['weekday_weekend', 'time_of_day']).agg(
    count=('open_rate', 'size'),
    mean_open_rate=('open_rate', 'mean'),
    mean_click_rate=('click_rate', 'mean')
).round(4)

# Summary by holiday
holiday_summary = df_clean.groupby('holiday').agg(
    count=('open_rate', 'size'),
    mean_open_rate=('open_rate', 'mean'),
    mean_click_rate=('click_rate', 'mean')
).round(4)

print("=== Subject Category Summary ===")
print(subject_summary)
print("\n=== Weekday/Weekend & Time of Day Summary ===")
print(time_summary)
print("\n=== Holiday Timing Summary ===")
print(holiday_summary)

# Save summary to CSV
subject_summary.to_csv('subject_summary.csv')
time_summary.to_csv('time_summary.csv')
holiday_summary.to_csv('holiday_summary.csv')
```

