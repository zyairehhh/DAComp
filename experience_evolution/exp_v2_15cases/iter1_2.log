import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Function to parse salary range
def parse_salary_range(salary_str):
    if pd.isna(salary_str):
        return None, None
    # Remove spaces and convert to lowercase
    s = salary_str.lower().replace(',', '').replace('，', '')
    
    # Look for patterns like "3000-4000 yuan/month" or "5000-10000 rmb/month"
    # Also handle cases with base salary + commission
    match = re.search(r'(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)', s)
    if match:
        low = float(match.group(1))
        high = float(match.group(2))
        # Ensure low <= high
        if low > high:
            low, high = high, low
        return low, high
    # If single number like "3000 yuan/month"
    match_single = re.search(r'(\d+(?:\.\d+)?)\s*(?:yuan|rmb)', s)
    if match_single:
        val = float(match_single.group(1))
        return val, val
    return None, None

# Parse salary ranges
salary_ranges = df['Salary Range'].apply(parse_salary_range)
df['Salary_low'] = salary_ranges.apply(lambda x: x[0] if x else None)
df['Salary_high'] = salary_ranges.apply(lambda x: x[1] if x else None)
df['Salary_mid'] = (df['Salary_low'] + df['Salary_high']) / 2

# Identify vocational school graduates
# Look for 'vocational school' in education requirement (case-insensitive)
voc_mask = df['Education Requirement'].str.contains('vocational school', case=False, na=False)
df_voc = df[voc_mask].copy()

print(f"Total records: {len(df)}")
print(f"Vocational school-related records: {len(df_voc)}")

# Save sample data
df_voc.head(20).to_csv('vocational_sample.csv', index=False)

# Some basic statistics
print("\nSalary mid-point statistics for vocational school jobs:")
print(df_voc['Salary_mid'].describe())

# Let's also look at benefits distribution
print("\nTop benefits for vocational school jobs:")
benefits = df_voc['Benefits'].dropna()
all_benefits = []
for b in benefits:
    # Split by commas, semicolons, etc.
    items = re.split(r'[,，、;；]', b)
    for item in items:
        item = item.strip()
        if item:
            all_benefits.append(item)
from collections import Counter
benefit_counts = Counter(all_benefits)
print(benefit_counts.most_common(20))
```
