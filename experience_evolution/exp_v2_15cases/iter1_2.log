import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
matplotlib.use('Agg')  # non-interactive backend
import os

# Connect to the database
conn = sqlite3.connect('dacomp-022.sqlite')

# Query to compute metrics per vehicle type
query = '''
SELECT 
    "Vehicle Type",
    COUNT(*) as total_bookings,
    SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) as completed,
    SUM(CASE WHEN "Cancelled Rides by Driver" = 1 THEN 1 ELSE 0 END) as driver_cancelled,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" ELSE NULL END) as avg_booking_value,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Ride Distance" ELSE NULL END) as avg_ride_distance,
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" / "Ride Distance" ELSE NULL END) as avg_per_km_fare
FROM sheet1
GROUP BY "Vehicle Type"
ORDER BY avg_per_km_fare DESC;
'''
df_type = pd.read_sql_query(query, conn)

# Calculate rates
df_type['completion_rate'] = df_type['completed'] / df_type['total_bookings']
df_type['driver_cancellation_rate'] = df_type['driver_cancelled'] / df_type['total_bookings']

print("Vehicle Type Metrics:")
print(df_type)

# Plot 1: Per-km Fare by Vehicle Type (bar chart)
plt.figure(figsize=(10, 6))
bars = plt.bar(df_type['Vehicle Type'], df_type['avg_per_km_fare'], color='steelblue')
plt.ylabel('Average Fare per Kilometer (units/km)')
plt.xlabel('Vehicle Type')
plt.title('Per‑Kilometer Fare by Vehicle Type')
plt.xticks(rotation=45)
# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.02,
             f'{height:.2f}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('per_km_fare_by_vehicle.png', dpi=300)
plt.close()

# Plot 2: Completion Rate vs Driver Cancellation Rate by Vehicle Type (grouped bar)
plt.figure(figsize=(10, 6))
x = range(len(df_type['Vehicle Type']))
width = 0.35
plt.bar([i - width/2 for i in x], df_type['completion_rate']*100, width, label='Completion Rate (%)', color='green')
plt.bar([i + width/2 for i in x], df_type['driver_cancellation_rate']*100, width, label='Driver Cancellation Rate (%)', color='red')
plt.ylabel('Percentage (%)')
plt.xlabel('Vehicle Type')
plt.title('Completion Rate vs Driver Cancellation Rate by Vehicle Type')
plt.xticks(x, df_type['Vehicle Type'], rotation=45)
plt.legend()
plt.tight_layout()
plt.savefig('completion_vs_cancellation.png', dpi=300)
plt.close()

# Plot 3: Expected Annual Earnings (as per Stage1 simulation) - we need to compute or use provided numbers.
# From Stage1 report: Uber XL 420,954 ... eBike 410,754. Let's extract those.
vehicle_order = ['Uber XL', 'Bike', 'Premier Sedan', 'Go Mini', 'Go Sedan', 'Auto', 'eBike']
