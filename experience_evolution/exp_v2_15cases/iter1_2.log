'''
import sqlite3
import pandas as pd
import re

conn = sqlite3.connect('dacomp-093.sqlite')
df = pd.read_sql_query('SELECT * FROM klaviyo__campaigns', conn)
conn.close()

# Compute metrics
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open'] = df['count_clicked_email'] / df['count_opened_email']

# Extract timing from campaign_name
def extract_timing(campaign_name):
    if isinstance(campaign_name, str):
        m = re.search(r'\[([^\]]+)\]', campaign_name)
        if m:
            inside = m.group(1)
            ww = None
            if '工作日' in inside:
                ww = 'weekday'
            elif '周末' in inside:
                ww = 'weekend'
            elif '节前' in inside:
                ww = 'pre-holiday'
            elif '节后' in inside:
                ww = 'post-holiday'
            tod = None
            if '上午' in inside:
                tod = 'morning'
            elif '下午' in inside:
                tod = 'afternoon'
            elif '晚间' in inside:
                tod = 'evening'
            hol = 'non-holiday'
            if '节前' in inside:
                hol = 'pre-holiday'
            elif '节后' in inside:
                hol = 'post-holiday'
            return ww, tod, hol
    return None, None, None

df[['weekday_weekend', 'time_of_day', 'holiday']] = df['campaign_name'].apply(lambda x: pd.Series(extract_timing(x)))

# Extract subject category from SUBJECT
def extract_subject_category(subject):
    if isinstance(subject, str):
        if '限时折扣' in subject:
            return 'discount'
        elif '新品上新' in subject:
            return 'new'
        elif '品牌故事' in subject:
            return 'storytelling'
    return None

df['subject_category'] = df['SUBJECT'].apply(extract_subject_category)

# Filter valid rows
df = df.dropna(subset=['subject_category', 'weekday_weekend', 'time_of_day', 'open_rate', 'click_rate'])

# Summary statistics
print("=== Overall Average Metrics ===")
print(f"Average open rate: {df['open_rate'].mean():.3f}")
print(f"Average click rate: {df['click_rate'].mean():.3f}")
print(f"Average click-to-open rate: {df['click_to_open'].mean():.3f}")
print()

print("=== By Subject Category ===")
cat_stats = df.groupby('subject_category').agg(
    count=('open_rate', 'size'),
    mean_open=('open_rate', 'mean'),
    mean_click=('click_rate', 'mean')
).round(4)
print(cat_stats)
print()

print("=== By Weekday/Weekend ===")
ww_stats = df.groupby('weekday_weekend').agg(
    count=('open_rate', 'size'),
    mean_open=('open_rate', 'mean'),
    mean_click=('click_rate', 'mean')
).round(4)
print(ww_stats)
print()

print("=== By Time of Day ===")
tod_stats = df.groupby('time_of_day').agg(
    count=('open_rate', 'size'),
    mean_open=('open_rate', 'mean'),
    mean_click=('click_rate', 'mean')
).round(4)
print(tod_stats)
print()

print("=== By Holiday Timing ===")
hol_stats = df.groupby('holiday').agg(
    count=('open_rate', 'size'),
    mean_open=('open_rate', 'mean'),
    mean_click=('click_rate', 'mean')
).round(4)
print(hol_stats)
print()

print("=== By Archived Status ===")
arch_stats = df.groupby('is_archived').agg(
    count=('open_rate', 'size'),
    mean_open=('open_rate', 'mean'),
    mean_click=('click_rate', 'mean')
).round(4)
print(arch_stats)
print()

print("=== By Variation ID ===")
var_stats = df.groupby('variation_id').agg(
    count=('open_rate', 'size'),
    mean_open=('open_rate', 'mean'),
    mean_click=('click_rate', 'mean')
).round(4)
print(var_stats)
''')
