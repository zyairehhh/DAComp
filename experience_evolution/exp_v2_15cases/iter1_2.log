import pandas as pd
import numpy as np
from datetime import datetime

def main():
    conn = sqlite3.connect('dacomp-098.sqlite')
    # Get conversations with tags and company
    query = '''
    SELECT 
        c.conversation_id,
        c.conversation_initiated_type as responder_type,
        c.all_conversation_tags,
        c.all_contact_company_names as company,
        c.conversation_created_at,
        c.first_close_at,
        m.first_admin_response_at,
        c.conversation_rating,
        c.conversation_subject
    FROM intercom__conversation_enhanced c
    JOIN intercom__conversation_metrics m 
        ON c.conversation_id = m.conversation_id
    WHERE c.all_contact_company_names IS NOT NULL 
        AND c.all_contact_company_names != ''
    '''
    df = pd.read_sql_query(query, conn)
    print(f"Loaded {len(df)} conversations")
    
    # Extract stage from tags
    def get_stage(tags):
        if not isinstance(tags, str):
            return None
        if 'stage:' not in tags:
            return None
        after = tags.split('stage:')[1]
        stage = after.split('|')[0]
        return stage
    df['stage'] = df['all_conversation_tags'].apply(get_stage)
    
    # Extract other features
    def extract(tags, prefix):
        if not isinstance(tags, str) or prefix not in tags:
            return None
        after = tags.split(prefix)[1]
        val = after.split('|')[0]
        return val
    for feat in ['intent', 'topic', 'segment', 'region', 'lifecycle']:
        df[feat] = df['all_conversation_tags'].apply(lambda x: extract(x, f'{feat}:'))
    
    # Convert timestamps
    for col in ['conversation_created_at', 'first_close_at', 'first_admin_response_at']:
        df[col] = pd.to_datetime(df[col], errors='coerce')
    
    # Calculate response to close days
    df['response_to_close_days'] = (df['first_close_at'] - df['first_admin_response_at']).dt.total_seconds() / 86400
    
    # Determine company-level responder group (bot if any bot_first)
    company_groups = df.groupby('company').agg(
        responder_group=('responder_type', lambda x: 'bot' if (x == 'bot_first').any() else 'human')
    ).reset_index()
    
    # Company-level conversion flags
    company_stages = df.groupby('company')['stage'].apply(list).reset_index()
    company_stages['has_demo'] = company_stages['stage'].apply(lambda x: 'demo_booked' in x)
    company_stages['has_trial'] = company_stages['stage'].apply(lambda x: 'trial_activated' in x)
    company_stages['has_paid'] = company_stages['stage'].apply(lambda x: 'closed_won' in x)
    
    company_data = pd.merge(company_groups, company_stages, on='company')
    
    # Conversion rates
    conv_summary = company_data.groupby('responder_group').agg(
        total_companies=('company', 'count'),
        demo_count=('has_demo', 'sum'),
        trial_count=('has_trial', 'sum'),
        paid_count=('has_paid', 'sum')
    ).reset_index()
    
    conv_summary['demo_rate'] = conv_summary['demo_count'] / conv_summary['total_companies']
    conv_summary['trial_rate_given_demo'] = conv_summary['trial_count'] / conv_summary['demo_count'].replace(0, np.nan)
    conv_summary['paid_rate_given_trial'] = conv_summary['paid_count'] / conv_summary['trial_count'].replace(0, np.nan)
    
    # Stage durations per responder group (using conversation-level)
    df['responder_group'] = df['company'].map(dict(zip(company_groups['company'], company_groups['responder_group'])))
    duration_summary = {}
    for stage in ['demo_booked', 'trial_activated', 'closed_won']:
        sub = df[df['stage'] == stage]
        dur = sub.groupby('responder_group')['response_to_close_days'].mean()
        duration_summary[stage] = dur
    
    # Conversation content analysis: intent distribution
    intent_dist = df.groupby(['responder_group', 'intent']).size().unstack(fill_value=0)
    
    # Write report
    with open('/workspace/stage1.md', 'w') as f:
        f.write("# Impact of Bot-led First Response Strategy on Sales Funnel\n\n")
        f.write("## Data Overview\n")
        f.write(f"- Conversations with company info: {len(df)}\n")
        f.write(f"- Unique companies: {len(company_data)}\n")
        f.write(f"- Bot-led companies (at least one bot-first conversation): {len(company_data[company_data['responder_group']=='bot'])}\n")
        f.write(f"- Human-led companies: {len(company_data[company_data['responder_group']=='human'])}\n\n")
