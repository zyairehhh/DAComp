    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
print(time_stats.to_string(index=False))
print()

print('=== Holiday Window Performance (3 days before vs after) ===')
holiday_stats = df[df['holiday_window'] != 'none'].groupby('holiday_window').agg(
    count=('person_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_retention_week=('active_retention_rate_week', 'mean'),
    avg_retention_month=('active_retention_rate_month', 'mean')
).reset_index()
if len(holiday_stats) == 0:
    print('No campaign starts within 3 days of a major holiday.')
else:
    print(holiday_stats.to_string(index=False))
print()

# Correlation analysis
print('=== Correlation between Open Rate and Retention ===')
corr_week = df['open_rate'].corr(df['active_retention_rate_week'])
corr_month = df['open_rate'].corr(df['active_retention_rate_month'])
