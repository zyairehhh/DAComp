median_days = account_df['count_active_days'].median()
pred_baseline = ((account_df['sum_minutes'] > median_minutes) & (account_df['count_active_days'] > median_days)).astype(int)
acc_baseline = (pred_baseline == high).mean()
print(f'Baseline accuracy (duration+frequency) predicting strict high-value: {acc_baseline:.2%}')
# correlation-weighted composite
last_date = pd.to_datetime('2024-09-28')
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['recency_days'] = (last_date - account_df['last_event_on']).dt.days.clip(lower=0)
recency_inv = 1 / (account_df['recency_days'] + 1)
def minmax_scale(series):
    min_val = series.min()
    max_val = series.max()
    if max_val - min_val == 0:
        return pd.Series([0.5] * len(series))
    return (series - min_val) / (max_val - min_val)
scaled_features = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating']:
    scaled_features[col] = minmax_scale(account_df[col])
scaled_features['recency'] = minmax_scale(recency_inv)
scaled_features['consistency'] = minmax_scale(account_df['average_daily_minutes'])
# compute correlations with strict high-value
correlations = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating', 'average_daily_minutes']:
    correlations[col] = np.corrcoef(account_df[col], high)[0,1]
correlations['recency_days'] = np.corrcoef(account_df['recency_days'], high)[0,1]
weights_corr = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 'count_page_viewing_visitors', 'avg_nps_rating', 'average_daily_minutes']:
    weights_corr[col] = abs(correlations[col])
weights_corr['recency'] = abs(correlations['recency_days'])
total = sum(weights_corr.values())
for k in weights_corr:
    weights_corr[k] = weights_corr[k] / total
print('weights:', weights_corr)
composite_score = np.zeros(len(account_df))
for key, weight in weights_corr.items():
    if key == 'recency':
        composite_score += scaled_features['recency'] * weight
    elif key == 'average_daily_minutes':
        composite_score += scaled_features['consistency'] * weight
    else:
        composite_score += scaled_features[key] * weight
threshold = np.percentile(composite_score, 70)
pred_corr = (composite_score >= threshold).astype(int)
acc_corr = (pred_corr == high).mean()
print(f'Correlation-weighted composite accuracy (strict high-value): {acc_corr:.2%}')
''')
