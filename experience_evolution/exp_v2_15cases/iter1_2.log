import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')

# Connect to database
conn = sqlite3.connect('dacomp-058.sqlite')

# Load problematic campaigns data with health scores
df = pd.read_csv('health_scores.csv')
df['year_month'] = pd.to_datetime(df['year_month'])

# Plot 6: Scatter plot of Cost vs ROI colored by Health Score
plt.figure(figsize=(12, 8))
scatter = plt.scatter(df['cost'], df['roas'], c=df['health_score'], 
                      cmap='RdYlGn_r', s=100, alpha=0.7, edgecolor='black', vmin=0, vmax=100)
plt.colorbar(scatter, label='Health Score')
plt.axhline(y=0.8, color='red', linestyle='--', linewidth=2, label='ROI Threshold (0.8)')
plt.axvline(x=1000, color='blue', linestyle='--', linewidth=2, label='Cost Threshold ($1000)')
plt.title('Campaign Health: Cost vs ROI (Color = Health Score)', fontsize=16, fontweight='bold')
plt.xlabel('Cost ($)', fontsize=14)
plt.ylabel('ROI', fontsize=14)
plt.grid(True, alpha=0.3)
plt.legend(loc='best')
plt.tight_layout()
plt.savefig('plot6_scatter_cost_vs_roi.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 7: Geographic Performance Heatmap (Top 10 locations)
geo_query = """
SELECT g.geo_target, g.campaign_id, g.cost, g.roas, g.impression_share, g.ctr,
       c.campaign_type, c.bidding_strategy, c.industry
FROM google_ads__geo_report g
JOIN (
    SELECT DISTINCT campaign_id, campaign_type, bidding_strategy, industry
    FROM google_ads__campaign_report
) c ON g.campaign_id = c.campaign_id
WHERE g.cost > 1000 AND g.roas < 0.8
"""
geo_df = pd.read_sql_query(geo_query, conn)

# Calculate health score for geographic data (simplified)
geo_df['health_score_geo'] = (0.4 * (1 - geo_df['roas']/geo_df['roas'].max()) + 
                               0.35 * (geo_df['ctr']/geo_df['ctr'].max()) +
                               0.25 * (geo_df['impression_share']/100)) * 100

top_geo = geo_df.groupby('geo_target').agg({
    'health_score_geo': 'mean',
    'campaign_id': 'count'
}).sort_values('campaign_id', ascending=False).head(10)

plt.figure(figsize=(14, 6))
bars = plt.barh(top_geo.index, top_geo['health_score_geo'], color='teal', edgecolor='black')
plt.title('Average Health Score by Geographic Target (Top 10 by Campaign Count)', fontsize=16, fontweight='bold')
plt.xlabel('Average Health Score', fontsize=14)
plt.ylabel('Geographic Target', fontsize=14)
plt.grid(axis='x', alpha=0.3)
# Add count labels
for i, (score, count) in enumerate(zip(top_geo['health_score_geo'], top_geo['campaign_id'])):
    plt.text(score + 1, i, f'n={count}', va='center', fontsize=10)
plt.xlim(0, 100)
plt.tight_layout()
plt.savefig('plot7_health_by_geographic.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 8: Device Type Performance
device_query = """
SELECT d.device_type, d.cost, d.roas, d.impression_share, d.ctr,
       c.campaign_type, c.bidding_strategy, c.industry
FROM google_ads__device_report d
JOIN (
    SELECT DISTINCT campaign_id, campaign_type, bidding_strategy, industry
    FROM google_ads__campaign_report
) c ON d.campaign_id = c.campaign_id
WHERE d.cost > 1000 AND d.roas < 0.8
"""
device_df = pd.read_sql_query(device_query, conn)

# Calculate health score for device data
device_df['health_score_device'] = (0.4 * (1 - device_df['roas']/device_df['roas'].max()) + 
                                     0.35 * (device_df['ctr']/device_df['ctr'].max()) +
                                     0.25 * (device_df['impression_share']/100)) * 100

device_stats = device_df.groupby('device_type').agg({
    'health_score_device': ['mean', 'std'],
    'cost': 'mean',
    'campaign_type': 'count'
}).round(2)

device_stats.columns = ['_'.join(col).strip() for col in device_stats.columns.values]
device_stats = device_stats.sort_values('health_score_device_mean', ascending=False)

plt.figure(figsize=(10, 6))
x = range(len(device_stats))
bars = plt.bar(x, device_stats['health_score_device_mean'], yerr=device_stats['health_score_device_std'], 
               capsize=5, color='orange', edgecolor='black')
plt.title('Average Health Score by Device Type', fontsize=16, fontweight='bold')
plt.xlabel('Device Type', fontsize=14)
plt.ylabel('Average Health Score', fontsize=14)
plt.xticks(x, device_stats.index, rotation=45, ha='right')
plt.grid(axis='y', alpha=0.3)
for i, count in enumerate(device_stats['campaign_type_count']):
    plt.text(i, device_stats['health_score_device_mean'].iloc[i] + device_stats['health_score_device_std'].iloc[i] + 2, 
             f'n={count}', ha='center', fontsize=10)
plt.ylim(0, 100)
plt.tight_layout()
plt.savefig('plot8_health_by_device_type.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 9: Health Components Correlation Heatmap
health_components = df[['cost_efficiency_component', 'conversion_quality_component', 
                        'competitiveness_component', 'health_score', 'roas', 'ctr', 
                        'conversion_rate', 'impression_share', 'quality_score']]

# Rename columns for readability
health_components.columns = ['Cost Efficiency', 'Conversion Quality', 'Competitiveness', 
                             'Health Score', 'ROI', 'CTR', 'Conversion Rate', 
                             'Impression Share', 'Quality Score']

corr_matrix = health_components.corr()

plt.figure(figsize=(12, 10))
sns.heatmap(corr_matrix, annot=True, fmt='.2f', cmap='coolwarm', center=0,
            square=True, linewidths=1, cbar_kws={'shrink': 0.8})
plt.title('Correlation Heatmap: Health Score Components & Key Metrics', fontsize=16, fontweight='bold')
plt.tight_layout()
plt.savefig('plot9_correlation_heatmap.png', dpi=300, bbox_inches='tight')
plt.close()

# Plot 10: Health Score vs Cost per Conversion (bubble chart)
plt.figure(figsize=(12, 8))
bubble_sizes = df['conversions'].fillna(0) + 1  # To avoid zero size
scatter = plt.scatter(df['cost_per_conversion'], df['health_score'], 
                      s=bubble_sizes * 20, alpha=0.6, c=df['roas'], 
                      cmap='RdYlGn_r', edgecolor='black')
cbar = plt.colorbar(scatter, label='ROI')
cbar.ax.axhline(y=0.8, color='red', linestyle='--', linewidth=2)

# Add reference lines
plt.axhline(y=40, color='orange', linestyle='--', linewidth=1, alpha=0.5, label='Medium/High Risk Threshold')
plt.axhline(y=70, color='green', linestyle='--', linewidth=1, alpha=0.5, label='Low/Medium Risk Threshold')

plt.title('Health Score vs Cost per Conversion (Bubble Size = Conversions)', fontsize=16, fontweight='bold')
plt.xlabel('Cost per Conversion ($)', fontsize=14)
plt.ylabel('Health Score', fontsize=14)
plt.grid(True, alpha=0.3)
plt.legend(loc='best')
plt.tight_layout()
plt.savefig('plot10_health_vs_cost_per_conversion.png', dpi=300, bbox_inches='tight')
plt.close()

conn.close()
print("Additional 5 plots created successfully:")
print("6. plot6_scatter_cost_vs_roi.png - Scatter: Cost vs ROI colored by Health Score")
print("7. plot7_health_by_geographic.png - Geographic health scores (Top 10)")
print("8. plot8_health_by_device_type.png - Device type performance")
print("9. plot9_correlation_heatmap.png - Correlation heatmap of components")
print("10. plot10_health_vs_cost_per_conversion.png - Health vs Cost per Conversion (bubbles)")
''')
