print("\nDrivetrain analysis:")
print(drivetrain_stats.head(10))

# Extract Brand from Title (first word)
df_clean['Brand'] = df_clean['Title'].apply(lambda x: str(x).split()[0] if pd.notna(x) else '')
brand_stats = df_clean.groupby('Brand')['Depreciation_Ratio']\
    .agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nTop Brands by Depreciation Ratio:")
