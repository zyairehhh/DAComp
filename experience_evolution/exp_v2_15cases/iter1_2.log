import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-060.sqlite')

# Load problematic ad groups from CSV (or recompute)
# Recompute
agg_query = """
SELECT
    ad_group_id,
    ad_group_name,
    ad_group_type,
    status,
    campaign_name,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions,
    SUM(spend) AS total_spend
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name, ad_group_type, status, campaign_name
HAVING total_impressions > 0 AND total_clicks > 0
"""
df = pd.read_sql_query(agg_query, conn)
df['CTR'] = df['total_clicks'] / df['total_impressions']
df['CVR'] = df['total_conversions'] / df['total_clicks']
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)].copy()
expected_cvr = df['CVR'].mean()
problematic['Intent_Match_Ratio'] = problematic['CVR'] / expected_cvr

print("=== Problematic Ad Groups Summary ===")
print(f"Count: {len(problematic)}")
print(f"Proportion of all ad groups: {len(problematic)/len(df):.2%}")
print(f"Average CTR: {problematic['CTR'].mean():.4f}")
print(f"Average CVR: {problematic['CVR'].mean():.4f}")
print(f"Average Intent Match Ratio: {problematic['Intent_Match_Ratio'].mean():.4f}")
print(f"Median Intent Match Ratio: {problematic['Intent_Match_Ratio'].median():.4f}")
print()

# Distribution of ad_group_type
print("Ad Group Type distribution:")
print(problematic['ad_group_type'].value_counts(dropna=False).head(10))
print()

# Status distribution
print("Status distribution:")
print(problematic['status'].value_counts(dropna=False))
print()

# Campaign name maybe top campaigns
print("Top Campaigns with problematic ad groups:")
print(problematic['campaign_name'].value_counts().head(10))
print()

# Traffic quality: join with keyword_report to get match type distribution
keyword_query = """
SELECT
    ad_group_id,
    keyword_match_type,
    SUM(clicks) AS keyword_clicks,
    SUM(conversions) AS keyword_conversions
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
keyword_df = pd.read_sql_query(keyword_query, conn)

# Merge with problematic
problematic_keyword = keyword_df[keyword_df['ad_group_id'].isin(problematic['ad_group_id'])]
# Compute proportions
total_clicks_problematic = problematic_keyword.groupby('keyword_match_type')['keyword_clicks'].sum().reset_index()
total_clicks_problematic['prop'] = total_clicks_problematic['keyword_clicks'] / total_clicks_problematic['keyword_clicks'].sum()
print("Keyword Match Type distribution (by clicks) for problematic ad groups:")
print(total_clicks_problematic.sort_values('keyword_clicks', ascending=False))
print()

# For comparison, overall distribution across all ad groups
total_clicks_all = keyword_df.groupby('keyword_match_type')['keyword_clicks'].sum().reset_index()
total_clicks_all['prop'] = total_clicks_all['keyword_clicks'] / total_clicks_all['keyword_clicks'].sum()
print("Keyword Match Type distribution across all ad groups:")
print(total_clicks_all.sort_values('keyword_clicks', ascending=False))
print()

# Intent Match Ratio vs traffic quality: compute average IMR per match type for problematic ad groups
# Merge keyword-level data with problematic to get IMR per ad group
problematic_imr = problematic[['ad_group_id', 'Intent_Match_Ratio']]
keyword_imr = problematic_keyword.merge(problematic_imr, on='ad_group_id', how='left')
match_type_imr = keyword_imr.groupby('keyword_match_type').agg(
    avg_imr=('Intent_Match_Ratio', 'mean'),
    total_clicks=('keyword_clicks', 'sum')
).reset_index()
print("Average Intent Match Ratio by keyword match type (problematic ad groups):")
print(match_type_imr.sort_values('avg_imr'))
print()

# Additional metric: maybe analyze spend efficiency
problematic['CPC'] = problematic['total_spend'] / problematic['total_clicks']
problematic['CPA'] = problematic['total_spend'] / problematic['total_conversions'].replace(0, np.nan)
print("Average CPC for problematic ad groups:", problematic['CPC'].mean())
print("Average CPA for problematic ad groups:", problematic['CPA'].mean())
print()

# Save problematic ad groups with metrics
problematic.to_csv('problematic_ad_groups_detailed.csv', index=False)

conn.close()
```
