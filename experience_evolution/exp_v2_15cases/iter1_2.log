    if campaign_id in ['CMP0002', 'CMP0016']:
        return 'discount_related'
    elif campaign_id == 'CMP0001':
        return 'new_product_launch'
    elif campaign_id == 'CMP0012':
        return 'unknown'
    else:
        return 'unknown'

