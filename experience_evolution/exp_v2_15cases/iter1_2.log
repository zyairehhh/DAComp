import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# Connect to SQLite database
con = sqlite3.connect("dacomp-076.sqlite")
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", con)
con.close()

# Compute transaction stability ratio
df['transaction_stability_ratio'] = df['transaction_count'] / (df['avg_transactions_per_month'] * 12)

# Compute seasonal Gini coefficient
quarters = df[['q1_transactions','q2_transactions','q3_transactions','q4_transactions']].values
def gini(row):
    if np.sum(row) == 0:
        return 0.0
    n = len(row)
    sum_abs = 0
    for i in range(n):
        for j in range(n):
            sum_abs += abs(row[i] - row[j])
    return sum_abs / (2 * n * np.sum(row))

df['seasonal_gini'] = np.apply_along_axis(gini, 1, quarters)

# Compute score per revenue ratio
df['score_per_revenue'] = df['comprehensive_customer_score'] / df['total_revenue'].replace(0, np.nan)

# Segment average retention probability
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'segment_avg_retention']
df = df.merge(segment_avg, on='profitability_segment', how='left')
# Anomaly flag: deviation > 0.15
df['anomaly'] = (abs(df['retention_probability'] - df['segment_avg_retention']) > 0.15).astype(int)

# Plot 1: Anomaly Count and Rate per Segment
fig, ax1 = plt.subplots(figsize=(8,5))
segments = df['profitability_segment'].unique()
segments = sorted(segments)  # alphabetical order: Basic, Growing, High Value, Premium, Standard
segment_counts = df.groupby('profitability_segment').size()
anomaly_counts = df.groupby('profitability_segment')['anomaly'].sum()
anomaly_rates = anomaly_counts / segment_counts

x = np.arange(len(segments))
width = 0.35
bars1 = ax1.bar(x - width/2, segment_counts, width, label='Total Customers', color='skyblue')
bars2 = ax1.bar(x + width/2, anomaly_counts, width, label='Anomaly Customers', color='salmon')
ax1.set_xlabel('Profitability Segment')
ax1.set_ylabel('Customer Count')
ax1.set_title('Classification Anomalies per Segment')
ax1.set_xticks(x)
ax1.set_xticklabels(segments, rotation=45)
ax1.legend()

ax2 = ax1.twinx()
ax2.plot(x, anomaly_rates * 100, color='green', marker='o', linewidth=2, label='Anomaly Rate (%)')
ax2.set_ylabel('Anomaly Rate (%)', color='green')
ax2.tick_params(axis='y', labelcolor='green')
# combine legends
lines1, labels1 = ax1.get_legend_handles_labels()
lines2, labels2 = ax2.get_legend_handles_labels()
ax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left')

plt.tight_layout()
plt.savefig('anomalies_per_segment.png', dpi=300)
plt.close()

# Plot 2: Seasonal Gini Distribution by Anomaly Group
fig, ax = plt.subplots(figsize=(6,4))
box_data = [df.loc[df['anomaly']==0, 'seasonal_gini'].dropna(),
            df.loc[df['anomaly']==1, 'seasonal_gini'].dropna()]
box = ax.boxplot(box_data, tick_labels=['Non-Anomaly', 'Anomaly'], patch_artist=True)
box['boxes'][0].set_facecolor('lightblue')
box['boxes'][1].set_facecolor('lightcoral')
ax.set_ylabel('Seasonal Gini Coefficient')
ax.set_title('Seasonal Concentration: Anomaly vs Non-Anomaly Customers')
plt.tight_layout()
plt.savefig('seasonal_gini_boxplot.png', dpi=300)
plt.close()

# Plot 3: Score per Revenue Ratio Distribution by Anomaly Group
fig, ax = plt.subplots(figsize=(6,4))
box_data = [df.loc[df['anomaly']==0, 'score_per_revenue'].dropna(),
            df.loc[df['anomaly']==1, 'score_per_revenue'].dropna()]
box = ax.boxplot(box_data, tick_labels=['Non-Anomaly', 'Anomaly'], patch_artist=True)
box['boxes'][0].set_facecolor('lightblue')
box['boxes'][1].set_facecolor('lightcoral')
ax.set_ylabel('Score per Revenue Ratio')
ax.set_title('Score-Revenue Misalignment: Anomaly vs Non-Anomaly')
plt.tight_layout()
plt.savefig('score_per_revenue_boxplot.png', dpi=300)
plt.close()

# Plot 4: Anomaly Rate by Seasonal Preference
seasonal_order = ['Q1 Peak', 'Q3 Peak', 'Q4 Peak', 'Balanced']
seasonal_counts = df.groupby('seasonal_preference').size()
seasonal_anomaly = df.groupby('seasonal_preference')['anomaly'].sum()
seasonal_rate = (seasonal_anomaly / seasonal_counts) * 100
seasonal_rate = seasonal_rate.reindex(seasonal_order)

fig, ax1 = plt.subplots(figsize=(7,5))
bars = ax1.bar(seasonal_rate.index, seasonal_rate, color='teal')
ax1.set_xlabel('Seasonal Preference')
ax1.set_ylabel('Anomaly Rate (%)')
ax1.set_title('Anomaly Rate by Seasonal Preference')
ax1.set_ylim([0, 45])
# Add count labels on top
for i, (idx, val) in enumerate(seasonal_rate.items()):
    count = seasonal_counts[idx]
    ax1.text(i, val + 1, f'n={count}', ha='center', va='bottom', fontsize=9)
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('anomaly_rate_seasonal_preference.png', dpi=300)
plt.close()

# Additional plot: Anomaly Rate by Lifecycle Stage (optional)
lifecycle_order = ['Growth', 'Mature', 'At Risk']
lifecycle_counts = df.groupby('lifecycle_stage').size()
lifecycle_anomaly = df.groupby('lifecycle_stage')['anomaly'].sum()
lifecycle_rate = (lifecycle_anomaly / lifecycle_counts) * 100
lifecycle_rate = lifecycle_rate.reindex(lifecycle_order)

fig, ax = plt.subplots(figsize=(6,4))
bars = ax.bar(lifecycle_rate.index, lifecycle_rate, color='purple')
ax.set_xlabel('Lifecycle Stage')
ax.set_ylabel('Anomaly Rate (%)')
ax.set_title('Anomaly Rate by Lifecycle Stage')
ax.set_ylim([0, 60])
for i, (idx, val) in enumerate(lifecycle_rate.items()):
    count = lifecycle_counts[idx]
    ax.text(i, val + 1, f'n={count}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('anomaly_rate_lifecycle_stage.png', dpi=300)
plt.close()

print("Plots saved.")
```
