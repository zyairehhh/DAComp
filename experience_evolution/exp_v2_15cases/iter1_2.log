import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

# Connect to database
conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome", conn)
conn.close()

# Helper functions to parse numeric values
def parse_price(price_str):
    """Convert '551,400 yuan' to float 551400"""
    if isinstance(price_str, str):
        # Remove commas and 'yuan'
        num = re.sub(r'[^\d.]', '', price_str)
        try:
            return float(num)
        except:
            return None
    elif isinstance(price_str, (int, float)):
        return float(price_str)
    else:
        return None

def parse_mileage(mileage_str):
    """Convert '0.41 ten thousand km' to km (4100)"""
    if isinstance(mileage_str, str):
        # Extract number before 'ten thousand km'
        match = re.search(r'([\d.]+)', mileage_str)
        if match:
            try:
                return float(match.group(1)) * 10000
            except:
                return None
    elif isinstance(mileage_str, (int, float)):
        return float(mileage_str)
    return None

# Convert columns
df['used_price_yuan'] = df['Price'] * 10000  # Price column is already in 10k yuan
df['new_price_yuan'] = df['New Car Price (incl. tax)'].apply(parse_price)
df['mileage_km'] = df['Mileage'].apply(parse_mileage)

# Parse registration date
df['reg_date'] = pd.to_datetime(df['Registration Date'], errors='coerce')
df['post_date'] = pd.to_datetime(df['Posting Date'], errors='coerce')
df['age_years'] = (df['post_date'] - df['reg_date']).dt.days / 365.25

# Compute retention rate
df['retention'] = df['used_price_yuan'] / df['new_price_yuan']

# Filter out invalid rows (missing price, retention >1 or <0.1, age negative etc.)
valid = df[
    df['new_price_yuan'].notna() & 
    df['used_price_yuan'].notna() &
    df['retention'].between(0.1, 1.5) &
    df['age_years'].between(0, 20)
].copy()

print(f"Total rows: {len(df)}, valid rows: {len(valid)}")

# 1. Retention by price segment
def price_segment(price):
    if price < 100000:
        return '<100k'
    elif price < 200000:
        return '100k-200k'
    elif price < 300000:
        return '200k-300k'
    elif price < 500000:
        return '300k-500k'
    elif price < 1000000:
        return '500k-1M'
    else:
        return '>1M'

valid['price_seg'] = valid['new_price_yuan'].apply(price_segment)
segment_stats = valid.groupby('price_seg').agg(
    count=('retention', 'size'),
    avg_retention=('retention', 'mean'),
    avg_age=('age_years', 'mean'),
    avg_mileage=('mileage_km', 'mean')
).reset_index()

# Reorder segments
order = ['<100k', '100k-200k', '200k-300k', '300k-500k', '500k-1M', '>1M']
segment_stats['price_seg'] = pd.Categorical(segment_stats['price_seg'], categories=order, ordered=True)
segment_stats = segment_stats.sort_values('price_seg')

# Plot 1: Bar chart of average retention by price segment
fig, ax = plt.subplots(figsize=(8,5))
bars = ax.bar(segment_stats['price_seg'], segment_stats['avg_retention']*100, color='skyblue')
ax.set_ylabel('Average Retention Rate (%)')
ax.set_xlabel('New Car Price Segment (yuan)')
ax.set_title('Retention Rate by Price Segment')
ax.set_ylim(0, 100)
# Add count labels on bars
for bar, count in zip(bars, segment_stats['count']):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2, height + 1, f'n={int(count)}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('retention_by_price_segment.png', dpi=150)
plt.close()

# 2. Top models by retention (>=5 listings)
model_stats = valid.groupby('Title').agg(
    count=('retention', 'size'),
    avg_retention=('retention', 'mean'),
    avg_age=('age_years', 'mean'),
    avg_mileage=('mileage_km', 'mean')
).reset_index()
model_stats = model_stats[model_stats['count'] >= 5].sort_values('avg_retention', ascending=False).head(10)

# Plot 2: Top models bar chart
fig, ax = plt.subplots(figsize=(10,6))
bars = ax.barh(range(len(model_stats)), model_stats['avg_retention']*100, color='lightgreen')
ax.set_yticks(range(len(model_stats)))
# Truncate long model names for display
display_names = [name[:30] + '...' if len(name) > 30 else name for name in model_stats['Title']]
ax.set_yticklabels(display_names)
ax.set_xlabel('Average Retention Rate (%)')
ax.set_title('Top Models by Retention (≥5 listings)')
ax.set_xlim(0, 100)
# Add count labels
for i, (bar, count) in enumerate(zip(bars, model_stats['count'])):
    ax.text(bar.get_width() + 1, bar.get_y() + bar.get_height()/2, f'n={int(count)}', va='center', fontsize=9)
plt.tight_layout()
plt.savefig('top_models_retention.png', dpi=150)
plt.close()

# 3. Scatter plot: Retention vs Age
fig, ax = plt.subplots(figsize=(7,5))
scatter = ax.scatter(valid['age_years'], valid['retention']*100, alpha=0.6, s=20, edgecolors='none')
ax.set_xlabel('Age (years)')
ax.set_ylabel('Retention Rate (%)')
ax.set_title('Retention vs Vehicle Age')
ax.set_ylim(0, 100)
# Add trend line
z = np.polyfit(valid['age_years'], valid['retention']*100, 1)
p = np.poly1d(z)
x_range = np.linspace(valid['age_years'].min(), valid['age_years'].max(), 100)
ax.plot(x_range, p(x_range), 'r--', linewidth=2, label=f'Trend: y={z[0]:.1f}x+{z[1]:.1f}')
ax.legend()
plt.tight_layout()
plt.savefig('retention_vs_age.png', dpi=150)
plt.close()

# 4. Retention by Vehicle Class (filter classes with >=5 listings)
class_stats = valid.groupby('Vehicle Class').agg(
    count=('retention', 'size'),
    avg_retention=('retention', 'mean')
).reset_index()
class_stats = class_stats[class_stats['count'] >= 5].sort_values('avg_retention', ascending=False)

fig, ax = plt.subplots(figsize=(9,5))
bars = ax.bar(range(len(class_stats)), class_stats['avg_retention']*100, color='orange')
ax.set_xticks(range(len(class_stats)))
ax.set_xticklabels(class_stats['Vehicle Class'], rotation=45, ha='right')
ax.set_ylabel('Average Retention Rate (%)')
ax.set_title('Retention by Vehicle Class (≥5 listings)')
ax.set_ylim(0, 100)
for bar, count in zip(bars, class_stats['count']):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2, height + 1, f'n={int(count)}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('retention_by_vehicle_class.png', dpi=150)
plt.close()

# 5. Retention by Fuel Type (similarly filter >=5)
fuel_stats = valid.groupby('Fuel Type').agg(
    count=('retention', 'size'),
    avg_retention=('retention', 'mean')
).reset_index()
fuel_stats = fuel_stats[fuel_stats['count'] >= 5].sort_values('avg_retention', ascending=False)

fig, ax = plt.subplots(figsize=(6,4))
bars = ax.bar(fuel_stats['Fuel Type'], fuel_stats['avg_retention']*100, color='purple')
ax.set_ylabel('Average Retention Rate (%)')
ax.set_title('Retention by Fuel Type')
ax.set_ylim(0, 100)
for bar, count in zip(bars, fuel_stats['count']):
    height = bar.get_height()
    ax.text(bar.get_x() + bar.get_width()/2, height + 1, f'n={int(count)}', ha='center', va='bottom', fontsize=9)
plt.tight_layout()
plt.savefig('retention_by_fuel_type.png', dpi=150)
plt.close()

print("Plots saved.")
