import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import re

# Connect to database
conn = sqlite3.connect('dacomp-093.sqlite')

# Load campaigns
query = """
SELECT 
    campaign_id,
    SUBJECT,
    scheduled_to_send_at,
    SENT_AT,
    is_archived,
    variation_id,
    total_count_unique_people,
    count_received_email,
    count_opened_email,
    count_clicked_email,
    count_placed_order,
    email_open_rate,
    email_click_to_open_rate,
    active_days,
    total_placed_orders,
    gmv_net_campaign
FROM klaviyo__campaigns
WHERE total_count_unique_people > 0
"""
df = pd.read_sql_query(query, conn)
print(f"Loaded {len(df)} campaigns")

# Parse subject for keyword group
def get_keyword_group(subject):
    if pd.isna(subject):
        return 'unknown'
    if '限时折扣' in subject:
        return 'discount'
    elif '新品上新' in subject:
        return 'new'
    elif '品牌故事' in subject:
        return 'storytelling'
    else:
        return 'other'

df['keyword_group'] = df['SUBJECT'].apply(get_keyword_group)

# Parse subject for time window label
def get_time_label_from_subject(subject):
    if pd.isna(subject):
        return None
    # patterns after '，'
    parts = subject.split('，')
    if len(parts) > 1:
        label = parts[-1].strip()
        # remove '开启' or '加持' or '优先'
        label = label.replace('开启', '').replace('加持', '').replace('优先', '')
        return label
    return None

df['time_label'] = df['SUBJECT'].apply(get_time_label_from_subject)

# Parse scheduled_to_send_at to datetime
df['scheduled_dt'] = pd.to_datetime(df['scheduled_to_send_at'])
df['sent_dt'] = pd.to_datetime(df['SENT_AT'])

# Extract weekday/weekend
df['weekday'] = df['scheduled_dt'].dt.weekday  # Monday=0, Sunday=6
df['is_weekend'] = df['weekday'].isin([5,6])  # Sat, Sun

# Extract hour of day
df['hour'] = df['scheduled_dt'].dt.hour
def time_of_day(hour):
    if 5 <= hour < 12:
        return 'morning'
    elif 12 <= hour < 17:
        return 'afternoon'
    elif 17 <= hour < 22:
        return 'evening'
    else:
        return 'night'
df['time_of_day'] = df['hour'].apply(time_of_day)

# Determine if before holiday (subject contains '节前' or '节前灵感加持' or '会员节前优先')
df['is_before_holiday'] = df['SUBJECT'].str.contains('节前')

# Compute derived metrics
# open rate = count_opened_email / count_received_email (but email_open_rate already present)
# click rate = count_clicked_email / count_received_email
df['open_rate'] = df['email_open_rate']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
# click-to-open rate provided as email_click_to_open_rate
df['click_to_open_rate'] = df['email_click_to_open_rate']

# Filter anomalies: exclude where count_received_email is extremely low or high? Use IQR method.
# For simplicity, exclude campaigns where count_received_email < 100? Let's examine distribution.
print("Count received email stats:")
print(df['count_received_email'].describe())

# IQR method
Q1 = df['count_received_email'].quantile(0.25)
Q3 = df['count_received_email'].quantile(0.75)
IQR = Q3 - Q1
lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR
df_clean = df[(df['count_received_email'] >= lower_bound) & (df['count_received_email'] <= upper_bound)]
print(f"Removed {len(df) - len(df_clean)} outliers by count_received_email")

# Also exclude campaigns where open_rate > 1 or click_rate > 1 (should not happen)
df_clean = df_clean[df_clean['open_rate'] <= 1]
df_clean = df_clean[df_clean['click_rate'] <= 1]

print(f"Final campaigns: {len(df_clean)}")

# Now group by various dimensions
# 1. Keyword group
group_keyword = df_clean.groupby('keyword_group').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_orders_per_received=('count_placed_order', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum()),
    avg_gmv_per_received=('gmv_net_campaign', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum()),
    avg_audience=('total_count_unique_people', 'mean')
).reset_index()
print("\n=== By Keyword Group ===")
print(group_keyword)

# 2. Time window: weekend vs weekday
group_weekend = df_clean.groupby('is_weekend').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_orders_per_received=('count_placed_order', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum()),
    avg_gmv_per_received=('gmv_net_campaign', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum())
).reset_index()
print("\n=== Weekend vs Weekday ===")
print(group_weekend)

# 3. Time of day
group_time_of_day = df_clean.groupby('time_of_day').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_orders_per_received=('count_placed_order', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum()),
    avg_gmv_per_received=('gmv_net_campaign', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum())
).reset_index()
print("\n=== Time of Day ===")
print(group_time_of_day)

# 4. Before holiday vs not
group_holiday = df_clean.groupby('is_before_holiday').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_orders_per_received=('count_placed_order', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum()),
    avg_gmv_per_received=('gmv_net_campaign', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum())
).reset_index()
print("\n=== Before Holiday vs Not ===")
print(group_holiday)

# 5. Interaction: keyword group x time_of_day
group_interaction = df_clean.groupby(['keyword_group', 'time_of_day']).agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_orders_per_received=('count_placed_order', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum())
).reset_index()
print("\n=== Keyword Group x Time of Day ===")
print(group_interaction)

# 6. By is_archived
group_archived = df_clean.groupby('is_archived').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_orders_per_received=('count_placed_order', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum())
).reset_index()
print("\n=== Archived vs Non-Archived ===")
print(group_archived)

# 7. By variation_id
group_variation = df_clean.groupby('variation_id').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean'),
    avg_placed_orders_per_received=('count_placed_order', lambda x: x.sum() / df_clean.loc[x.index, 'count_received_email'].sum())
).reset_index()
print("\n=== Variation ID (single vs variant) ===")
print(group_variation)

# 8. Combined: is_archived and variation_id
group_archived_variation = df_clean.groupby(['is_archived', 'variation_id']).agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_click_to_open=('click_to_open_rate', 'mean')
).reset_index()
print("\n=== Archived x Variation ===")
print(group_archived_variation)

# Now we need to analyze retention from persons table. Since we cannot join, we can compute overall retention rates by time period after campaign sends? Not possible.
# Instead we can compute average active retention rates across all persons and see if there is variation by campaign timing? Not causal.
# Maybe we can approximate by checking if campaigns with higher open rates correlate with higher retention? Not directly.
# We'll skip retention analysis for now due to lack of linkage.
# However, we can compute average active_retention_rate_week/month from persons table overall as baseline.
person_query = """
SELECT 
    active_retention_rate_week,
    active_retention_rate_month
FROM klaviyo__persons
WHERE active_retention_rate_week IS NOT NULL
"""
persons = pd.read_sql_query(person_query, conn)
print("\n=== Overall Person Retention Rates ===")
print(f"Weekly retention mean: {persons['active_retention_rate_week'].mean():.4f}")
print(f"Monthly retention mean: {persons['active_retention_rate_month'].mean():.4f}")

conn.close()
