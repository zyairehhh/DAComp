import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-078.sqlite')

# Load account data
df = pd.read_sql_query("SELECT * FROM pendo__account", conn)

# Parse date columns
df['first_event_on'] = pd.to_datetime(df['first_event_on'])
df['last_event_on'] = pd.to_datetime(df['last_event_on'])

# Calculate composite target as described in Stage1
# Standardize sum_minutes, sum_events, and avg_nps_rating, then sum them
for col in ['sum_minutes', 'sum_events', 'avg_nps_rating']:
    df[f'{col}_z'] = (df[col] - df[col].mean()) / df[col].std()

# Create composite score
df['composite_score'] = df['sum_minutes_z'] + df['sum_events_z'] + df['avg_nps_rating_z']

# Define high-value customers as top 20%
threshold = df['composite_score'].quantile(0.8)
df['high_value'] = df['composite_score'] >= threshold

# 1. Distribution of Composite Score with High-value Threshold
plt.figure(figsize=(10, 6))
# Plot histogram
plt.hist(df['composite_score'], bins=50, alpha=0.7, color='steelblue', 
         edgecolor='black', linewidth=0.5, label='All Customers')

# Add vertical line for high-value threshold
plt.axvline(x=threshold, color='red', linestyle='--', linewidth=2,
            label=f'High-value threshold (80th percentile: {threshold:.2f})')

plt.title('Distribution of Customer Composite Scores', fontsize=14)
plt.xlabel('Composite Score (Z-score sum of minutes, events, and NPS)', fontsize=12)
plt.ylabel('Frequency', fontsize=12)
plt.legend()
plt.grid(alpha=0.3)

plt.tight_layout()
plt.savefig('composite_score_distribution.png', dpi=300)
plt.close()

# 2. Scatter Plot: sum_minutes vs sum_events colored by high-value status
plt.figure(figsize=(10, 6))

# Create scatter plot
scatter = plt.scatter(df['sum_minutes'], df['sum_events'],
                      c=df['high_value'].map({True: 'red', False: 'blue'}),
                      alpha=0.6, s=30)

# Add labels and title
plt.title('Customer Usage Patterns: Minutes vs Events', fontsize=14)
plt.xlabel('Total Minutes', fontsize=12)
plt.ylabel('Total Events', fontsize=12)
plt.xscale('log')
plt.yscale('log')

# Create custom legend
from matplotlib.patches import Patch
legend_elements = [Patch(facecolor='red', edgecolor='red', alpha=0.6, label='High-value (Top 20%)'),
                   Patch(facecolor='blue', edgecolor='blue', alpha=0.6, label='Not High-value')]
plt.legend(handles=legend_elements, loc='upper left')

plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('usage_patterns_scatter.png', dpi=300)
plt.close()

conn.close()
print("Additional visualizations generated!")
print("1. composite_score_distribution.png")
print("2. usage_patterns_scatter.png")
''')
