'''
import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-078.sqlite')
account_df = pd.read_sql_query('SELECT * FROM pendo__account', conn)
# fill missing avg_nps_rating with median
median_nps = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating'] = account_df['avg_nps_rating'].fillna(median_nps)
# compute recency: days from last_event_on to max date in dataset (maybe 2024-09-28)
last_date = pd.to_datetime('2024-09-28')
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['recency_days'] = (last_date - account_df['last_event_on']).dt.days
# normalize columns
from sklearn.preprocessing import MinMaxScaler
scaled_features = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating']:
    scaler = MinMaxScaler()
    scaled = scaler.fit_transform(account_df[[col]])
    scaled_features[col] = scaled.flatten()
# recency: smaller is better, invert
recency_inv = 1 / (account_df['recency_days'] + 1)  # avoid division by zero
scaler = MinMaxScaler()
scaled_recency = scaler.fit_transform(recency_inv.values.reshape(-1,1)).flatten()
scaled_features['recency'] = scaled_recency
# consistency: average_daily_minutes
scaler = MinMaxScaler()
scaled_consistency = scaler.fit_transform(account_df[['average_daily_minutes']]).flatten()
scaled_features['consistency'] = scaled_consistency
# combine with equal weights (each out of 1)
weights = {
    'sum_minutes': 0.2,
    'count_active_days': 0.2,
    'count_feature_clicking_visitors': 0.15,
    'count_page_viewing_visitors': 0.1,
    'avg_nps_rating': 0.15,
    'recency': 0.1,
    'consistency': 0.1
}
composite_score = np.zeros(len(account_df))
for key, weight in weights.items():
    composite_score += scaled_features[key] * weight
account_df['composite_score'] = composite_score
# define high-value as top 30% of composite_score
threshold = np.percentile(composite_score, 70)
account_df['high_value'] = (composite_score >= threshold).astype(int)
print("High value counts:", account_df['high_value'].value_counts())
print("Proportion high value:", account_df['high_value'].mean())
# simple model using only sum_minutes and count_active_days
median_minutes = account_df['sum_minutes'].median()
median_days = account_df['count_active_days'].median()
pred_simple = ((account_df['sum_minutes'] > median_minutes) & (account_df['count_active_days'] > median_days)).astype(int)
accuracy_simple = (pred_simple == account_df['high_value']).mean()
print(f"Accuracy using duration & frequency: {accuracy_simple:.2%}")
# multi-dimensional model: if at least 4 out of 7 dimensions above median
median_feature = account_df['count_feature_clicking_visitors'].median()
median_page = account_df['count_page_viewing_visitors'].median()
median_nps = account_df['avg_nps_rating'].median()
median_recency = account_df['recency_days'].median()  # lower is better, so we need to invert condition
median_consistency = account_df['average_daily_minutes'].median()
conditions = [
    account_df['sum_minutes'] > median_minutes,
    account_df['count_active_days'] > median_days,
    account_df['count_feature_clicking_visitors'] > median_feature,
    account_df['count_page_viewing_visitors'] > median_page,
    account_df['avg_nps_rating'] > median_nps,
    account_df['recency_days'] < median_recency,  # recency smaller is better
    account_df['average_daily_minutes'] > median_consistency
]
# count true conditions
count_above = sum(conditions)
pred_multi = (count_above >= 4).astype(int)
accuracy_multi = (pred_multi == account_df['high_value']).mean()
print(f"Accuracy using multi-dimensional (4/7 rule): {accuracy_multi:.2%}")
''')
