df['earnings_per_minute'] = df['avg_booking'] / df['total_time_minutes']
df['earnings_per_hour'] = df['earnings_per_minute'] * 60
df['annual_earnings_8h_250d'] = df['earnings_per_hour'] * 8 * 250

print(df[["Vehicle Type", "avg_booking", "avg_distance", "earnings_per_hour", "annual_earnings_8h_250d"]].to_string())
