'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-070/stage2_env/dacomp-070.sqlite'
conn = sqlite3.connect(db_path)

# Query revenue per active device by region
query = """
SELECT c.region, AVG(t.revenue_per_active_device) as avg_revenue_per_device
FROM google_play__time_series_trends t
JOIN google_play__country_report c ON t.date_day = c.date_day AND t.package_name = c.package_name
WHERE t.revenue_per_active_device IS NOT NULL 
  AND c.region IS NOT NULL
GROUP BY c.region
ORDER BY avg_revenue_per_device DESC;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Plot bar chart
plt.figure(figsize=(8,5))
bars = plt.bar(df['region'], df['avg_revenue_per_device'], color=['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728'])
plt.title('Average Revenue per Active Device by Region', fontsize=16)
plt.xlabel('Region', fontsize=14)
plt.ylabel('Revenue per Active Device (USD)', fontsize=14)
# Add value labels on bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, height + 0.01,
             f'{height:.2f}', ha='center', va='bottom', fontsize=10)
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('revenue_per_device_by_region.png', dpi=300)
plt.close()
''')
