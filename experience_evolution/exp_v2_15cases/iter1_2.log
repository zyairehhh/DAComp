    plt.scatter(subset['count_total_interviews'], subset['overall_conversion_rate'], 
                alpha=0.6, label=dept, c=color)

plt.title('Overall Conversion Rate vs Total Interviews')
plt.xlabel('Total Interviews per Job')
plt.ylabel('Overall Conversion Rate')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('conversion_vs_total_interviews.png')
plt.close()

