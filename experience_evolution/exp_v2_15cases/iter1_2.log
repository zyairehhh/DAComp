'''
import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-078.sqlite')
# query monthly minutes per account for Jan-Jun
query = '''
SELECT account_id, 
       strftime('%m', date_day) as month, 
       SUM(dm.sum_minutes) as total_minutes
FROM pendo__visitor_daily_metrics dm 
JOIN pendo__visitor v ON dm.visitor_id = v.visitor_id 
WHERE month IN ('01','02','03','04','05','06')
GROUP BY account_id, month
ORDER BY account_id, month
'''
df = pd.read_sql_query(query, conn)
# pivot to have months as columns
pivot = df.pivot(index='account_id', columns='month', values='total_minutes')
pivot = pivot.fillna(0)
# ensure month columns order
month_cols = ['01','02','03','04','05','06']
for col in month_cols:
    if col not in pivot.columns:
        pivot[col] = 0
pivot = pivot[month_cols]
# compute linear regression slope (simple)
def compute_slope(row):
    y = row.values
    x = np.arange(len(y))
    # ignore zero values? Use all
    if np.all(y == 0):
        return 0
    # simple trend: (last - first) / time span
    if y[0] == 0:
        return 0
    return (y[-1] - y[0]) / (len(y) - 1)
pivot['trend_slope'] = pivot.apply(compute_slope, axis=1)
pivot['percent_change'] = (pivot['06'] - pivot['01']) / (pivot['01'] + 1e-9)
# categorize
def categorize(row):
    if row['trend_slope'] > 100:
        return 'strong_growth'
    elif row['trend_slope'] > 10:
        return 'moderate_growth'
    elif row['trend_slope'] > -10:
        return 'stable'
    else:
        return 'decline'
pivot['trend_category'] = pivot.apply(categorize, axis=1)
print('Trend category counts:')
print(pivot['trend_category'].value_counts())
print(pivot.head())
# join with account table for high-value composite
account_df = pd.read_sql_query('SELECT * FROM pendo__account', conn)
median_nps = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating'] = account_df['avg_nps_rating'].fillna(median_nps)
# compute composite score (correlation-weighted)
last_date = pd.to_datetime('2024-09-28')
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['recency_days'] = (last_date - account_df['last_event_on']).dt.days.clip(lower=0)
recency_inv = 1 / (account_df['recency_days'] + 1)
def minmax_scale(series):
    min_val = series.min()
    max_val = series.max()
    if max_val - min_val == 0:
        return pd.Series([0.5] * len(series))
    return (series - min_val) / (max_val - min_val)
scaled_features = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating']:
    scaled_features[col] = minmax_scale(account_df[col])
scaled_features['recency'] = minmax_scale(recency_inv)
scaled_features['consistency'] = minmax_scale(account_df['average_daily_minutes'])
# correlations computed earlier (use those from previous script)
weights = {'sum_minutes': 0.142, 'count_active_days': 0.125, 'count_feature_clicking_visitors': 0.191,
           'count_page_viewing_visitors': 0.193, 'avg_nps_rating': 0.111, 'average_daily_minutes': 0.119,
           'recency': 0.119}
composite_score = np.zeros(len(account_df))
for key, weight in weights.items():
    if key == 'recency':
        composite_score += scaled_features['recency'] * weight
    elif key == 'average_daily_minutes':
        composite_score += scaled_features['consistency'] * weight
    else:
        composite_score += scaled_features[key] * weight
account_df['composite_score'] = composite_score
threshold = np.percentile(composite_score, 70)
account_df['high_value'] = (composite_score >= threshold).astype(int)
# merge
account_df.set_index('account_id', inplace=True)
merged = account_df[['high_value']].join(pivot[['trend_slope', 'trend_category']], how='inner')
print('High value vs trend category:')
print(pd.crosstab(merged['high_value'], merged['trend_category']))
print('Correlation between high_value and trend_slope:', merged['high_value'].corr(merged['trend_slope']))
''')
