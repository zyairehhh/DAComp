import pandas as pd
import sqlite3
import numpy as np
import matplotlib.pyplot as plt
import matplotlib

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# Load ad group report data
df = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)
conn.close()

# Compute aggregated metrics per ad group (sum over dates)
agg = df.groupby(['ad_group_id', 'ad_group_name', 'ad_group_type', 'status']).agg({
    'clicks': 'sum',
    'impressions': 'sum',
    'conversions': 'sum',
    'spend': 'sum'
}).reset_index()

# Compute CTR and CVR
agg['CTR'] = agg['clicks'] / agg['impressions']
agg['CVR'] = agg['conversions'] / agg['clicks']
# Replace infinite or NaN values with 0
agg.replace([np.inf, -np.inf], np.nan, inplace=True)
agg.fillna(0, inplace=True)

# Compute percentiles
ctr_75 = agg['CTR'].quantile(0.75)
cvr_25 = agg['CVR'].quantile(0.25)

print(f"CTR 75th percentile: {ctr_75:.4f}")
print(f"CVR 25th percentile: {cvr_25:.4f}")

# Identify problematic ad groups
problematic = agg[(agg['CTR'] > ctr_75) & (agg['CVR'] < cvr_25)]
print(f"Number of problematic ad groups: {len(problematic)}")

# Save problematic ad groups to CSV for reference
problematic.to_csv('problematic_ad_groups.csv', index=False)

# Also compute overall dataset size
print(f"Total ad groups: {len(agg)}")

# Plot 1: Scatter plot of CTR vs CVR with quadrant highlighting
plt.figure(figsize=(10, 6))
plt.scatter(agg['CTR'], agg['CVR'], alpha=0.6, s=30, label='All Ad Groups')
# Highlight problematic ones
plt.scatter(problematic['CTR'], problematic['CVR'], color='red', s=50, label='High CTR, Low CVR')
# Add percentile lines
plt.axvline(x=ctr_75, color='grey', linestyle='--', linewidth=1, label='CTR 75th percentile')
plt.axhline(y=cvr_25, color='grey', linestyle='--', linewidth=1, label='CVR 25th percentile')
plt.xlabel('Click-Through Rate (CTR)')
plt.ylabel('Conversion Rate (CVR)')
plt.title('Ad Group Performance: CTR vs CVR')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('ctr_cvr_scatter.png', dpi=300)
plt.close()

# Plot 2: Distribution of CTR and CVR (histograms)
fig, axes = plt.subplots(1, 2, figsize=(12, 5))
axes[0].hist(agg['CTR'], bins=50, edgecolor='black', alpha=0.7)
axes[0].axvline(x=ctr_75, color='red', linestyle='--', label=f'75th percentile: {ctr_75:.4f}')
axes[0].set_xlabel('CTR')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Distribution of CTR')
axes[0].legend()
axes[0].grid(True, linestyle='--', alpha=0.5)

axes[1].hist(agg['CVR'], bins=50, edgecolor='black', alpha=0.7)
axes[1].axvline(x=cvr_25, color='green', linestyle='--', label=f'25th percentile: {cvr_25:.4f}')
axes[1].set_xlabel('CVR')
axes[1].set_ylabel('Frequency')
axes[1].set_title('Distribution of CVR')
axes[1].legend()
axes[1].grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('ctr_cvr_distribution.png', dpi=300)
plt.close()

# Plot 3: Bar chart of count of problematic ad groups by ad_group_type
if len(problematic) > 0:
    problem_by_type = problematic['ad_group_type'].value_counts().reset_index()
    problem_by_type.columns = ['ad_group_type', 'count']
    plt.figure(figsize=(8, 5))
    plt.bar(problem_by_type['ad_group_type'], problem_by_type['count'], color='orange')
    plt.xlabel('Ad Group Type')
    plt.ylabel('Count of Problematic Ad Groups')
    plt.title('High-CTR, Low-CVR Ad Groups by Type')
    for i, v in enumerate(problem_by_type['count']):
        plt.text(i, v + 0.1, str(v), ha='center', va='bottom')
    plt.tight_layout()
    plt.savefig('problematic_by_type.png', dpi=300)
    plt.close()

# Plot 4: Intent Match Ratio (Actual CVR / Expected CVR) - need expected CVR
# We don't have expected CVR in the data. Maybe we can approximate by average CVR per campaign or something.
# Let's compute average CVR per campaign and then compute ratio per ad group.
# We'll need to compute expected CVR from campaign level (maybe from keyword level?).
# For simplicity, we could compute expected CVR as the overall median CVR.
# Alternatively, we can compute expected CVR as the average CVR of ad groups with similar CTR? Not now.
# Since we don't have an expected CVR column, we'll skip this plot for now.

print("Plots generated.")
```
