Now I need to compute conversion rate trend per role. Let's write a Python script to analyze this. First, I'll create a script that extracts role, then computes average conversion rate by month.

Action: CreateFile(filepath="extract_roles.py"):
```
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-066.sqlite')

query = """
SELECT
    r.job_id,
    r.job_title,
    r.job_created_at,
    r.interview_rate,
    j.departments,
    j.hiring_managers
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced j ON r.job_id = j.job_id
WHERE j.departments = 'Engineering'
"""

df = pd.read_sql_query(query, conn)
conn.close()

# Extract role from job_title (assumes pattern "Role - Company")
df['role'] = df['job_title'].apply(lambda x: x.split(' - ')[0] if ' - ' in x else x)

# Extract month from job_created_at
df['month'] = pd.to_datetime(df['job_created_at']).dt.to_period('M')

# Compute average conversion rate by role and month
role_month_avg = df.groupby(['role', 'month'])['interview_rate'].mean().reset_index()
role_month_avg = role_month_avg.sort_values(['role', 'month'])

# Calculate decline: difference between last month and first month for each role
def compute_decline(group):
    if len(group) >= 2:
        # Ensure months are sorted
        group = group.sort_values('month')
        first = group.iloc[0]['interview_rate']
        last = group.iloc[-1]['interview_rate']
        decline = first - last
        # Percentage change
        pct_change = (last - first) / first * 100
        return pd.Series({
            'first_month': group.iloc[0]['month'],
            'last_month': group.iloc[-1]['month'],
            'first_rate': first,
            'last_rate': last,
            'decline_abs': decline,
            'decline_pct': pct_change
        })
    else:
        return pd.Series({
            'first_month': None,
            'last_month': None,
            'first_rate': None,
            'last_rate': None,
            'decline_abs': None,
            'decline_pct': None
        })

decline_summary = df.groupby('role').apply(
    lambda grp: compute_decline(grp.groupby('month')['interview_rate'].mean().reset_index())
).reset_index()

print("Role-Month Average Conversion Rates:")
print(role_month_avg.to_string())
print("\nDecline Summary (First vs Last Month):")
print(decline_summary[['role', 'first_month', 'last_month', 'first_rate', 'last_rate', 'decline_abs', 'decline_pct']].to_string())

# Optionally, save to CSV for later inspection
role_month_avg.to_csv('engineering_role_month_conversion.csv', index=False)
decline_summary.to_csv('engineering_role_decline_summary.csv', index=False)
```
