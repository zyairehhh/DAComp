df_main['demo_to_trial_days'] = (df_main['trial_activated_at'] - df_main['demo_booked_at']).dt.total_seconds() / (24*3600)
df_main['trial_to_paid_days'] = (df_main['paid_at'] - df_main['trial_activated_at']).dt.total_seconds() / (24*3600)

# Summary statistics
