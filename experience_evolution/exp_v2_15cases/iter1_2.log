Action: LOCAL_DB_SQL(file_path="/workspace/dacomp-035.sqlite", command="SELECT 
    ui.Department,
    COUNT(DISTINCT ui.[User ID]) as employees,
    SUM(al.[Anomaly Score]) as total_score,
    SUM(al.[Anomaly Score]) * 1.0 / COUNT(DISTINCT ui.[User ID]) as score_per_employee,
    COUNT(DISTINCT al.[Anomaly ID]) as total_abnormal,
    COUNT(DISTINCT al.[Anomaly ID]) * 1.0 / COUNT(DISTINCT ui.[User ID]) as abnormal_per_employee
FROM user_information_table ui
LEFT JOIN login_records_table lr ON ui.[User ID] = lr.[User ID]
LEFT JOIN abnormal_logins_table al ON lr.[Login Record ID] = al.[Login Record ID]
GROUP BY ui.Department
ORDER BY score_per_employee DESC;", output="direct")

