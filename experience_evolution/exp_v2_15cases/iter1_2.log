import pandas as pd
import numpy as np

df = pd.read_csv('health_scores.csv')

print("=== PROBLEMATIC CAMPAIGNS SUMMARY ===")
print(f"Total problematic campaigns (cost > $1000, ROI < 0.8): {len(df)}")
print(f"Date range: {df['year_month'].min()} to {df['year_month'].max()}")
print()

print("=== HEALTH SCORE DISTRIBUTION ===")
print(f"Health Score Range: {df['health_score'].min():.1f} - {df['health_score'].max():.1f}")
print(f"Average Health Score: {df['health_score'].mean():.1f}")
print(f"Median Health Score: {df['health_score'].median():.1f}")
print()

print("=== RISK LEVEL BREAKDOWN ===")
risk_counts = df['risk_level'].value_counts()
for level, count in risk_counts.items():
    percentage = 100 * count / len(df)
    print(f"{level}: {count} campaigns ({percentage:.1f}%)")
print()

print("=== BY CAMPAIGN TYPE ===")
campaign_type_summary = df.groupby('campaign_type').agg({
    'health_score': ['mean', 'count'],
    'cost': 'mean',
    'roas': 'mean'
}).round(2)
print(campaign_type_summary)
print()

print("=== BY BIDDING STRATEGY ===")
bidding_summary = df.groupby('bidding_strategy').agg({
    'health_score': ['mean', 'count'],
    'cost': 'mean',
    'roas': 'mean'
}).round(2)
print(bidding_summary)
print()

print("=== BY INDUSTRY ===")
industry_summary = df.groupby('industry').agg({
    'health_score': ['mean', 'count'],
    'cost': 'mean',
    'roas': 'mean'
}).round(2)
print(industry_summary)
print()

print("=== KEY METRICS FOR PROBLEMATIC CAMPAIGNS ===")
print(f"Average Cost: ${df['cost'].mean():.2f}")
print(f"Average ROI: {df['roas'].mean():.3f}")
print(f"Average CTR: {df['ctr'].mean():.4f}")
print(f"Average Conversion Rate: {df['conversion_rate'].mean():.4f}")
print(f"Average Impression Share: {df['impression_share'].mean():.3f}")
print(f"Average Quality Score: {df['quality_score'].mean():.2f}")
```
