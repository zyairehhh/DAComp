import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib import rcParams
import os

# Set matplotlib style
plt.style.use('seaborn-v0_8-whitegrid')
rcParams.update({'figure.autolayout': True})

# Connect to database
conn = sqlite3.connect('dacomp-078.sqlite')

# Load account data
df = pd.read_sql_query("SELECT * FROM pendo__account", conn)

# Prepare dimensions as described in Stage1
# We need to compute recency (days since last activity) and consistency (average daily minutes)
# From the table structure, we have: count_active_days, sum_minutes, avg_nps_rating,
# count_page_viewing_visitors, count_feature_clicking_visitors, last_event_on

# Convert date columns
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
df['first_event_on'] = pd.to_datetime(df['first_event_on'])

# Calculate recency (days since last activity) - inverse recency as mentioned in report
# Using last_event_on, assuming 'now' is the max date in dataset
reference_date = df['last_event_on'].max()
df['days_since_last'] = (reference_date - df['last_event_on']).dt.days
df['recency_inverse'] = 1 / (df['days_since_last'] + 1)  # Add 1 to avoid division by zero

# Calculate consistency (average_daily_minutes is already available)
df['consistency'] = df['average_daily_minutes']

# Prepare all 7 dimensions
dimensions = {
    'duration': df['sum_minutes'],
    'frequency': df['count_active_days'],
    'feature_engagement': df['count_feature_clicking_visitors'],
    'page_engagement': df['count_page_viewing_visitors'],
    'satisfaction': df['avg_nps_rating'],
    'recency': df['recency_inverse'],
    'consistency': df['consistency']
}

# Create composite ground truth (top 30% as high value)
# Follow Stage1 approach: equal weights for composite
dimension_names = list(dimensions.keys())
dimension_data = np.column_stack([(d - d.min()) / (d.max() - d.min() + 1e-10) for d in dimensions.values()])
composite_score = dimension_data.mean(axis=1)
df['composite_score'] = composite_score

# Define high-value as top 30%
threshold = np.percentile(composite_score, 70)
df['high_value'] = composite_score >= threshold

# Calculate correlations with high-value label
correlations = {}
for name, data in dimensions.items():
    corr = np.corrcoef(data, df['high_value'].astype(float))[0, 1]
    correlations[name] = corr

print("Correlations with high-value label:")
for name, corr in correlations.items():
    print(f"{name}: {corr:.3f}")

# Calculate weights based on absolute correlations (as in Stage1)
abs_corrs = np.abs(list(correlations.values()))
weights = abs_corrs / abs_corrs.sum()
weight_dict = dict(zip(dimension_names, weights))

print("\nWeights based on absolute correlations:")
for name, weight in weight_dict.items():
    print(f"{name}: {weight:.3f} ({weight*100:.1f}%)")

# Calculate weighted composite score
weighted_score = np.sum(dimension_data * weights.reshape(1, -1), axis=1)
df['weighted_score'] = weighted_score

# Accuracy calculation
# Baseline model: using only duration and frequency (median thresholds)
duration_threshold = df['sum_minutes'].median()
frequency_threshold = df['count_active_days'].median()
baseline_pred = (df['sum_minutes'] >= duration_threshold) & (df['count_active_days'] >= frequency_threshold)
baseline_accuracy = (baseline_pred == df['high_value']).mean()

# Enhanced model: using weighted composite (top 30%)
weighted_threshold = np.percentile(weighted_score, 70)
enhanced_pred = weighted_score >= weighted_threshold
enhanced_accuracy = (enhanced_pred == df['high_value']).mean()

print(f"\nBaseline model accuracy: {baseline_accuracy:.3f}")
print(f"Enhanced model accuracy: {enhanced_accuracy:.3f}")

# Trend analysis: calculate monthly trends from daily metrics
# First, get visitor_daily_metrics and aggregate by account and month
daily_df = pd.read_sql_query("""
    SELECT vdm.account_id, 
           DATE(vdm.date) as date,
