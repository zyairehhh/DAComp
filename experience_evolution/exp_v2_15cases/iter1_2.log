import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-022.sqlite')

# Read relevant columns for completed rides
query = """
SELECT 
    "Vehicle Type",
    "Booking Value",
    "Ride Distance",
    "Driver Ratings",
    "Date",
    "Time",
    "Pickup Location"
FROM sheet1
WHERE "Booking Status" = 'Completed'
    AND "Booking Value" IS NOT NULL
    AND "Ride Distance" IS NOT NULL
    AND "Ride Distance" > 0;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Compute PKR
df['PKR'] = df['Booking Value'] / df['Ride Distance']

# Vehicle type classification
def classify_vehicle(vtype):
    if vtype in ['Auto', 'Bike', 'eBike']:
        return 'Economy'
    elif vtype in ['Go Mini', 'Go Sedan']:
        return 'Premium'
    elif vtype in ['Premier Sedan', 'Uber XL']:
        return 'Luxury'
    else:
        return 'Other'

df['Vehicle Category'] = df['Vehicle Type'].apply(classify_vehicle)

# 1. Box plot of PKR by Vehicle Category
plt.figure(figsize=(10, 6))
categories_order = ['Economy', 'Premium', 'Luxury']
box_data = [df[df['Vehicle Category'] == cat]['PKR'] for cat in categories_order]
plt.boxplot(box_data, labels=categories_order)
plt.title('Per-Kilometer Ride Fare (PKR) by Vehicle Category')
plt.ylabel('PKR (currency per km)')
plt.grid(True, alpha=0.3)
plt.savefig('pkr_by_vehicle_category.png', dpi=300)
plt.close()

# 2. Scatter plot of Driver Rating vs PKR, with threshold line at 4.7
plt.figure(figsize=(10, 6))
plt.scatter(df['Driver Ratings'], df['PKR'], alpha=0.5, s=5)
plt.axvline(x=4.7, color='red', linestyle='--', label='Rating 4.7 threshold')
plt.xlabel('Driver Rating')
plt.ylabel('PKR (currency per km)')
plt.title('Driver Rating vs Per-Kilometer Ride Fare')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('rating_vs_pkr.png', dpi=300)
plt.close()

# 3. Time-of-day analysis: extract hour from Time column (format "HH:MM:SS")
def extract_hour(t):
    try:
        return int(t.split(':')[0])
    except:
        return None
df['Hour'] = df['Time'].apply(extract_hour)
hourly_pkr = df.groupby('Hour')['PKR'].mean().reset_index()
plt.figure(figsize=(10, 6))
plt.plot(hourly_pkr['Hour'], hourly_pkr['PKR'], marker='o')
plt.xlabel('Hour of Day')
plt.ylabel('Average PKR (currency per km)')
plt.title('Average PKR by Hour of Day')
plt.xticks(range(0, 24))
plt.grid(True, alpha=0.3)
plt.savefig('pkr_by_hour.png', dpi=300)
plt.close()

# 4. Geographic variation: we need to classify Pickup Location as urban vs suburban/rural.
# Since we lack zone classification, we can create a simple approximation: 
# assume locations with many pickups are urban centers.
# Compute average PKR by pickup location and sort by count
location_stats = df.groupby('Pickup Location').agg(
    avg_pkr=('PKR', 'mean'),
    count=('PKR', 'size')
).reset_index().sort_values('count', ascending=False)
# Take top 10 locations with most pickups as "Urban", next 10 as "Suburban", rest as "Rural"
top10 = location_stats.head(10)['Pickup Location'].tolist()
next10 = location_stats.iloc[10:20]['Pickup Location'].tolist()
def classify_zone(loc):
    if loc in top10:
        return 'Urban'
    elif loc in next10:
        return 'Suburban'
    else:
        return 'Rural'
df['Zone'] = df['Pickup Location'].apply(classify_zone)
zone_pkr = df.groupby('Zone')['PKR'].mean().reindex(['Urban', 'Suburban', 'Rural'])
plt.figure(figsize=(8,5))
zone_pkr.plot(kind='bar', color=['blue', 'orange', 'green'])
plt.title('Average PKR by Zone Type (Urban/Suburban/Rural)')
plt.ylabel('Average PKR (currency per km)')
plt.xlabel('Zone Type')
plt.grid(True, alpha=0.3)
plt.savefig('pkr_by_zone.png', dpi=300)
plt.close()

# 5. Driver tenure not available; we can skip.

# Additional: average PKR by vehicle type (detailed) bar chart
vehicle_pkr = df.groupby('Vehicle Type')['PKR'].mean().sort_values()
plt.figure(figsize=(10,6))
vehicle_pkr.plot(kind='barh')
plt.title('Average PKR by Vehicle Type')
plt.xlabel('Average PKR (currency per km)')
plt.tight_layout()
plt.grid(True, alpha=0.3)
plt.savefig('pkr_by_vehicle_type.png', dpi=300)
plt.close()

print('Visualizations generated.')
