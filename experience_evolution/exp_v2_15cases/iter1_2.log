import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib
from datetime import datetime
import re

# Connect to database
conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome", conn)
conn.close()

# Data cleaning and preprocessing
def clean_mileage(mileage_str):
    """
    Convert mileage string to numeric value in km.
    Examples:
      "0.41 ten thousand km" -> 4100
      "68,000 km" -> 68000
      "1.9 ten thousand km" -> 19000
    """
    if pd.isna(mileage_str):
        return np.nan
    
    # Remove commas and spaces
    s = str(mileage_str).strip()
    
    # Check for "ten thousand km" pattern
    if 'ten thousand km' in s:
        # Extract the number before "ten thousand km"
        match = re.search(r'([\d\.]+)', s.split('ten thousand km')[0])
        if match:
            value = float(match.group(1))
            return value * 10000  # Convert to km
    
    # Check for raw km values (with comma as thousands separator)
    if 'km' in s:
        # Extract numbers (including commas)
        match = re.search(r'([\d,]+)', s.split('km')[0])
        if match:
            # Remove commas and convert to float
            value = match.group(1).replace(',', '')
            return float(value)
    
    # If pattern not recognized, try to extract any number
    match = re.search(r'([\d\.]+)', s)
    if match:
        return float(match.group(1))
    
    return np.nan

def extract_brand(title):
    """Extract brand from title (first word before space)"""
    if pd.isna(title):
        return "Unknown"
    # Split by space and take first token
    parts = str(title).split()
    if parts:
        return parts[0]
    return "Unknown"

def calculate_age(registration_date_str):
    """Calculate age in years from registration date"""
    if pd.isna(registration_date_str):
        return np.nan
    
    try:
        # Parse the date string (format seems to be YYYY-MM-DD HH:MM:SS)
        reg_date = datetime.strptime(str(registration_date_str), '%Y-%m-%d %H:%M:%S')
        current_date = datetime.now()
        age_days = (current_date - reg_date).days
        return age_days / 365.25  # Convert to years
    except:
        return np.nan

# Apply cleaning functions
df['mileage_km'] = df['Mileage'].apply(clean_mileage)
df['brand'] = df['Title'].apply(extract_brand)
df['age_years'] = df['Registration Date'].apply(calculate_age)

# Filter out extreme outliers (keep 1st to 99th percentile for price and mileage)
price_q1 = df['Price'].quantile(0.01)
price_q99 = df['Price'].quantile(0.99)
mileage_q1 = df['mileage_km'].quantile(0.01)
mileage_q99 = df['mileage_km'].quantile(0.99)

df_clean = df[
    (df['Price'] >= price_q1) & (df['Price'] <= price_q99) &
    (df['mileage_km'] >= mileage_q1) & (df['mileage_km'] <= mileage_q99) &
    (df['age_years'] >= 0) & (df['age_years'] <= 30)  # Reasonable age range
]

print(f"Original rows: {len(df)}")
print(f"Cleaned rows: {len(df_clean)}")

# Visualization 1: Price distribution by vehicle class
plt.figure(figsize=(12, 8))

# 1. Price distribution histogram
plt.subplot(2, 2, 1)
plt.hist(df_clean['Price'], bins=30, edgecolor='black', alpha=0.7)
plt.xlabel('Price (¥10,000)')
plt.ylabel('Frequency')
plt.title('Distribution of Used Car Prices')
plt.grid(True, alpha=0.3)

# 2. Average price by brand (top 15 brands)
brand_price = df_clean.groupby('brand')['Price'].agg(['mean', 'count']).reset_index()
brand_price = brand_price[brand_price['count'] >= 5]  # Only brands with at least 5 listings
brand_price = brand_price.sort_values('mean', ascending=False).head(15)

plt.subplot(2, 2, 2)
bars = plt.barh(brand_price['brand'], brand_price['mean'])
plt.xlabel('Average Price (¥10,000)')
plt.title('Top 15 Brands by Average Price\n(min 5 listings)')
plt.gca().invert_yaxis()  # Highest at top
# Add value labels on bars
for bar in bars:
    width = bar.get_width()
    plt.text(width, bar.get_y() + bar.get_height()/2, f'{width:.1f}', 
             ha='left', va='center')

# 3. Price vs Mileage scatter plot
plt.subplot(2, 2, 3)
plt.scatter(df_clean['mileage_km']/10000, df_clean['Price'], alpha=0.6, s=20)
plt.xlabel('Mileage (10,000 km)')
plt.ylabel('Price (¥10,000)')
plt.title('Price vs Mileage')
plt.grid(True, alpha=0.3)

# Add trend line
z = np.polyfit(df_clean['mileage_km']/10000, df_clean['Price'], 1)
p = np.poly1d(z)
x_range = np.linspace(df_clean['mileage_km'].min()/10000, df_clean['mileage_km'].max()/10000, 100)
plt.plot(x_range, p(x_range), "r--", alpha=0.8, label=f'Trend: y = {z[0]:.2f}x + {z[1]:.2f}')
plt.legend()

# 4. Price vs Age scatter plot
plt.subplot(2, 2, 4)
plt.scatter(df_clean['age_years'], df_clean['Price'], alpha=0.6, s=20)
plt.xlabel('Age (years)')
plt.ylabel('Price (¥10,000)')
plt.title('Price vs Vehicle Age')
plt.grid(True, alpha=0.3)

# Add trend line
z_age = np.polyfit(df_clean['age_years'], df_clean['Price'], 1)
p_age = np.poly1d(z_age)
x_range_age = np.linspace(df_clean['age_years'].min(), df_clean['age_years'].max(), 100)
plt.plot(x_range_age, p_age(x_range_age), "r--", alpha=0.8, label=f'Trend: y = {z_age[0]:.2f}x + {z_age[1]:.2f}')
plt.legend()

plt.tight_layout()
plt.savefig('price_analysis_overview.png', dpi=150, bbox_inches='tight')
print("Saved price_analysis_overview.png")

# Visualization 2: Detailed analysis by vehicle class
plt.figure(figsize=(14, 10))

# 1. Vehicle class distribution
vehicle_class_counts = df_clean['Vehicle Class'].value_counts().head(10)
plt.subplot(2, 2, 1)
bars = plt.bar(range(len(vehicle_class_counts)), vehicle_class_counts.values)
plt.xticks(range(len(vehicle_class_counts)), vehicle_class_counts.index, rotation=45, ha='right')
plt.ylabel('Number of Listings')
plt.title('Top 10 Vehicle Classes by Listing Count')
# Add count labels
for i, bar in enumerate(bars):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, height, str(int(height)), 
             ha='center', va='bottom')

# 2. Price by vehicle class (box plot)
plt.subplot(2, 2, 2)
# Get top 8 vehicle classes by count for box plot (for readability)
top_classes = df_clean['Vehicle Class'].value_counts().head(8).index
df_top_classes = df_clean[df_clean['Vehicle Class'].isin(top_classes)]
# Create box plot
class_data = [df_top_classes[df_top_classes['Vehicle Class'] == cls]['Price'].values for cls in top_classes]
box = plt.boxplot(class_data, labels=top_classes)
plt.xticks(rotation=45, ha='right')
plt.ylabel('Price (¥10,000)')
plt.title('Price Distribution by Vehicle Class\n(Top 8 by listing count)')

# 3. Average price retention by age (grouped by vehicle class)
plt.subplot(2, 2, 3)
# Calculate average price by age group and vehicle class
df_clean['age_group'] = pd.cut(df_clean['age_years'], bins=[0, 2, 5, 8, 15, 30], 
                               labels=['0-2', '2-5', '5-8', '8-15', '15+'])
# Get top 5 vehicle classes
top5_classes = df_clean['Vehicle Class'].value_counts().head(5).index
df_top5 = df_clean[df_clean['Vehicle Class'].isin(top5_classes)]

for vehicle_class in top5_classes:
    class_data = df_top5[df_top5['Vehicle Class'] == vehicle_class]
    price_by_age = class_data.groupby('age_group')['Price'].mean()
    plt.plot(price_by_age.index.astype(str), price_by_age.values, marker='o', label=vehicle_class)

plt.xlabel('Age Group (years)')
plt.ylabel('Average Price (¥10,000)')
plt.title('Price Retention by Age Group\n(Top 5 vehicle classes)')
plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(True, alpha=0.3)

# 4. Fuel type analysis
plt.subplot(2, 2, 4)
fuel_price = df_clean.groupby('Fuel Type')['Price'].agg(['mean', 'count']).reset_index()
fuel_price = fuel_price.sort_values('mean', ascending=False)
bars = plt.bar(range(len(fuel_price)), fuel_price['mean'])
plt.xticks(range(len(fuel_price)), fuel_price['Fuel Type'], rotation=45, ha='right')
plt.ylabel('Average Price (¥10,000)')
plt.title('Average Price by Fuel Type')
# Add value labels
for i, bar in enumerate(bars):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, height, f'{height:.1f}', 
             ha='center', va='bottom')

plt.tight_layout()
plt.savefig('vehicle_class_analysis.png', dpi=150, bbox_inches='tight')
