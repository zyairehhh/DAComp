            'seasonal_preference_cat','transaction_consistency_cat',
            'growth_potential_cat','lifecycle_stage_cat','activity_status_cat']
X = df[features].fillna(0)
y = df['is_anomaly']

tree = DecisionTreeClassifier(max_depth=4, random_state=42)
tree.fit(X, y)
print("=== Decision Tree Rules for Predicting Anomaly ===")
print("Feature importances:")
for feat, imp in zip(features, tree.feature_importances_):
