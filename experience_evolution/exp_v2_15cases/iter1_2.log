import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re
import os

# Ensure output directory exists
os.makedirs('plots', exist_ok=True)

# Load data
conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Salary parsing function
def parse_salary_range(salary_str):
    if pd.isna(salary_str):
        return None, None
    s = salary_str.lower().replace(',', '').replace('，', '')
    match = re.search(r'(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)', s)
    if match:
        low = float(match.group(1))
        high = float(match.group(2))
        if low > high:
            low, high = high, low
        return low, high
    match_single = re.search(r'(\d+(?:\.\d+)?)\s*(?:yuan|rmb)', s)
    if match_single:
        val = float(match_single.group(1))
        return val, val
    return None, None

# Apply parsing
salary_ranges = df['Salary Range'].apply(parse_salary_range)
df['Salary_low'] = salary_ranges.apply(lambda x: x[0] if x else None)
df['Salary_high'] = salary_ranges.apply(lambda x: x[1] if x else None)
df['Salary_mid'] = (df['Salary_low'] + df['Salary_high']) / 2

# Filter vocational school
voc_mask = df['Education Requirement'].str.contains('vocational school', case=False, na=False)
df_voc = df[voc_mask].copy()

# 1. Salary distribution histogram
plt.figure(figsize=(10, 6))
salary_mid = df_voc['Salary_mid'].dropna()
plt.hist(salary_mid, bins=50, edgecolor='black', alpha=0.7)
plt.xlabel('Monthly Salary Mid-point (Yuan)', fontsize=12)
plt.ylabel('Frequency', fontsize=12)
plt.title('Distribution of Starting Salaries for Vocational School Graduates', fontsize=14)
plt.grid(axis='y', alpha=0.5)
plt.tight_layout()
plt.savefig('plots/salary_distribution.png', dpi=300)
plt.close()

# 2. Benefits frequency bar chart (top 15)
benefits = df_voc['Benefits'].dropna()
all_benefits = []
for b in benefits:
    items = re.split(r'[,，、;；]', b)
    for item in items:
        item = item.strip()
        if item and item not in ['', 'and ', '.']:
            # Clean common trailing punctuation
            if item.endswith('.'):
                item = item[:-1]
            if item.startswith('and '):
                item = item[4:]
            all_benefits.append(item)

from collections import Counter
benefit_counts = Counter(all_benefits)
top_benefits = benefit_counts.most_common(15)

plt.figure(figsize=(12, 8))
benefit_names = [b[0] for b in top_benefits]
benefit_freq = [b[1] for b in top_benefits]
y_pos = np.arange(len(benefit_names))
bars = plt.barh(y_pos, benefit_freq, color='steelblue', edgecolor='black')
plt.gca().invert_yaxis()
plt.xlabel('Frequency', fontsize=12)
plt.title('Top 15 Benefits for Vocational School Graduate Positions', fontsize=14)
plt.yticks(y_pos, benefit_names, fontsize=10)
# Add frequency labels on bars
for i, v in enumerate(benefit_freq):
    plt.text(v + 10, i, str(v), va='center', fontsize=9)
plt.tight_layout()
plt.savefig('plots/benefits_distribution.png', dpi=300)
plt.close()

# 3. Analyze factors that might affect salary
# Industry vs Salary
industry_salary = df_voc.groupby('Industry')['Salary_mid'].agg(['mean', 'count']).reset_index()
industry_salary = industry_salary[industry_salary['count'] >= 10].sort_values('mean', ascending=False).head(15)

plt.figure(figsize=(12, 6))
y_pos = np.arange(len(industry_salary))
bars = plt.barh(y_pos, industry_salary['mean'], color='coral', edgecolor='black')
plt.gca().invert_yaxis()
plt.xlabel('Average Monthly Salary (Yuan)', fontsize=12)
plt.title('Top 15 Industries by Average Salary for Vocational School Graduates (min 10 jobs)', fontsize=14)
plt.yticks(y_pos, industry_salary['Industry'], fontsize=9)
# Add labels
for i, v in enumerate(industry_salary['mean']):
    plt.text(v + 20, i, f'{v:.0f}', va='center', fontsize=8)
plt.tight_layout()
plt.savefig('plots/industry_salary.png', dpi=300)
plt.close()

# 4. Job Title word cloud? Not needed; instead, look at Work Experience Requirement
exp_salary = df_voc.groupby('Work Experience Requirement')['Salary_mid'].agg(['mean', 'count']).reset_index()
exp_salary = exp_salary[exp_salary['count'] >= 5].sort_values('mean', ascending=False)

plt.figure(figsize=(10, 6))
y_pos = np.arange(len(exp_salary))
bars = plt.barh(y_pos, exp_salary['mean'], color='lightgreen', edgecolor='black')
plt.gca().invert_yaxis()
plt.xlabel('Average Monthly Salary (Yuan)', fontsize=12)
plt.title('Average Salary by Work Experience Requirement (min 5 jobs)', fontsize=14)
plt.yticks(y_pos, exp_salary['Work Experience Requirement'], fontsize=9)
for i, v in enumerate(exp_salary['mean']):
    plt.text(v + 20, i, f'{v:.0f}', va='center', fontsize=8)
plt.tight_layout()
plt.savefig('plots/experience_salary.png', dpi=300)
plt.close()

print("Visualizations created in plots/ directory.")

# Summary statistics for report
print(f"\nVocational school jobs: {len(df_voc)}")
print(f"Jobs with salary info: {df_voc['Salary_mid'].count()}")
print(f"Mean salary: {df_voc['Salary_mid'].mean():.0f} yuan")
print(f"Median salary: {df_voc['Salary_mid'].median():.0f} yuan")
print(f"Top benefit: {benefit_counts.most_common(1)[0][0]} ({benefit_counts.most_common(1)[0][1]} mentions)")
```
