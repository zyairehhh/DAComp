import sqlite3
import pandas as pd
from datetime import datetime
import numpy as np

def analyze_campaigns():
    # Connect to database
    conn = sqlite3.connect('dacomp-094.sqlite')
    
    # Read tables
    events_df = pd.read_sql_query("SELECT * FROM klaviyo__events", conn)
    persons_df = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
    campaign_flow_df = pd.read_sql_query("SELECT * FROM klaviyo__person_campaign_flow", conn)
    
    # Close connection
    conn.close()
    
    print("Data Overview:")
    print(f"Events records: {len(events_df)}")
    print(f"Persons records: {len(persons_df)}")
    print(f"Campaign-Flow records: {len(campaign_flow_df)}")
    
    # Analyze subject line keywords
    print("\n--- Subject Line Analysis ---")
    
    # Check available subject lines
    unique_subjects = events_df['campaign_subject_line'].unique()
    print(f"Unique subject lines: {unique_subjects}")
    
    # Categorize subject lines by keywords
    def categorize_subject(subject):
        subject_lower = str(subject).lower()
        if 'discount' in subject_lower or 'offer' in subject_lower or 'sale' in subject_lower:
            return 'discount-related'
        elif 'product' in subject_lower and 'launch' in subject_lower:
            return 'new product launch'
        elif 'story' in subject_lower or 'storytelling' in subject_lower:
            return 'storytelling'
        elif 'new' in subject_lower or 'launch' in subject_lower:
            return 'new product launch'
        else:
            return 'other'
    
    events_df['subject_category'] = events_df['campaign_subject_line'].apply(categorize_subject)
    
    # Combine with campaign_flow data (join on campaign_id)
    # First extract campaign_id from events
    events_df['campaign_id'] = events_df['last_touch_campaign_id']
    
    # Merge with campaign flow data
    merged_df = pd.merge(events_df, campaign_flow_df, 
                         left_on=['person_id', 'campaign_id'],
                         right_on=['person_id', 'last_touch_campaign_id'],
                         how='left')
    
    # Analyze timing windows
    print("\n--- Timing Window Analysis ---")
    
    # Convert time columns
    if not merged_df.empty:
        merged_df['occurred_at'] = pd.to_datetime(merged_df['occurred_at'])
        merged_df['first_event_at'] = pd.to_datetime(merged_df['first_event_at'])
        
        # Extract day of week (0=Monday, 6=Sunday)
        merged_df['day_of_week'] = merged_df['occurred_at'].dt.dayofweek
        merged_df['is_weekday'] = merged_df['day_of_week'] < 5  # Monday-Friday
        
        # Extract hour of day
        merged_df['hour_of_day'] = merged_df['occurred_at'].dt.hour
        merged_df['time_window'] = merged_df['hour_of_day'].apply(
            lambda x: 'morning' if x < 12 else 'afternoon'
        )
        
        # Calculate metrics by timing windows
        print("Metrics by Weekday vs Weekend:")
        if 'is_weekday' in merged_df.columns:
            weekday_metrics = merged_df.groupby('is_weekday').agg({
                'day_opened_email': 'mean',
                'day_clicked_email': 'mean',
                'day_click_to_open_rate': 'mean'
            }).reset_index()
            print(weekday_metrics)
        
        print("\nMetrics by Time of Day (Morning vs Afternoon):")
        if 'time_window' in merged_df.columns and 'time_window' in merged_df.columns:
            time_metrics = merged_df.groupby('time_window').agg({
                'day_opened_email': 'mean',
                'day_clicked_email': 'mean',
                'day_click_to_open_rate': 'mean'
            }).reset_index()
            print(time_metrics)
    
    # Analyze subject line impact
    print("\n--- Subject Line Category Impact ---")
    if not merged_df.empty and 'subject_category' in merged_df.columns:
        subject_metrics = merged_df.groupby('subject_category').agg({
            'day_opened_email': ['count', 'mean', 'std'],
            'day_clicked_email': ['mean', 'std'],
            'day_click_to_open_rate': ['mean', 'std']
        }).reset_index()
        print(subject_metrics)
    
    # Analyze with persons data for retention rates
    print("\n--- Retention Analysis ---")
    
    # Merge with persons data for retention rates
    persons_campaign_df = pd.merge(campaign_flow_df, persons_df[['person_id', 'active_retention_rate_week', 
                                                                'active_retention_rate_month', 
                                                                'email_open_rate']],
                                  on='person_id', how='left')
    
    print("Average retention rates by campaign:")
    retention_metrics = persons_campaign_df.groupby('last_touch_campaign_id').agg({
        'active_retention_rate_week': 'mean',
        'active_retention_rate_month': 'mean',
        'email_open_rate_touch': 'mean',
        'email_click_to_open_rate_touch': 'mean'
    }).reset_index()
    print(retention_metrics)
    
    # Create recommendations based on analysis
    print("\n--- Key Findings and Recommendations ---")
    
    if not merged_df.empty:
        print("\n1. Timing Impact Analysis:")
        if 'is_weekday' in merged_df.columns:
            weekday_results = merged_df.groupby('is_weekday')['day_opened_email'].mean()
            if len(weekday_results) > 0:
                best_day = "Weekdays" if weekday_results.get(True, 0) > weekday_results.get(False, 0) else "Weekends"
                print(f"   - Highest open rates observed on: {best_day}")
        
        if 'time_window' in merged_df.columns:
            time_results = merged_df.groupby('time_window')['day_opened_email'].mean()
            if len(time_results) > 0:
                best_time = time_results.idxmax() if not time_results.empty else "N/A"
                print(f"   - Best time window for opens: {best_time}")
    
    # Save results to file
    with open('campaign_analysis_results.txt', 'w') as f:
        f.write("Campaign Performance Analysis Report\n")
        f.write("=" * 50 + "\n\n")
        f.write("Based on analysis of email campaigns and user behavior data.\n\n")
        
        # Write key metrics
        f.write("Data Summary:\n")
        f.write(f"- Total persons: {len(persons_df)}\n")
        f.write(f"- Campaign events: {len(events_df)}\n")
        f.write(f"- Campaign-flow records: {len(campaign_flow_df)}\n\n")
        
        f.write("Subject Line Categories Found:\n")
        if not merged_df.empty and 'subject_category' in merged_df.columns:
            categories = merged_df['subject_category'].value_counts()
            for cat, count in categories.items():
                f.write(f"- {cat}: {count} events\n")
    
if __name__ == "__main__":
    analyze_campaigns()
```
