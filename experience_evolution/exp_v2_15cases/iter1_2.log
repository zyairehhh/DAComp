-- Query 1: Overall per-km fare by vehicle type with completion rates
SELECT 
  "Vehicle Type",
  COUNT(*) as total_bookings,
  SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) as completed,
  CAST(SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) AS FLOAT) * 100.0 / COUNT(*) as completion_rate,
  AVG(CASE WHEN "Booking Status" = 'Completed' AND "Ride Distance" > 0 THEN "Booking Value" / "Ride Distance" ELSE NULL END) as avg_per_km_fare
FROM sheet1
GROUP BY "Vehicle Type"
ORDER BY avg_per_km_fare DESC;

-- Query 2: Per-km fare by vehicle and driver rating segments
SELECT 
  "Vehicle Type",
  CASE 
    WHEN "Driver Ratings" >= 4.5 THEN 'High (4.5-5.0)'
    WHEN "Driver Ratings" >= 4.0 THEN 'Medium (4.0-4.5)'
    ELSE 'Low (<4.0)'
  END as rating_segment,
  COUNT(*) as num_rides,
  AVG("Booking Value" / "Ride Distance") as avg_per_km_fare,
  AVG("Driver Ratings") as avg_driver_rating,
  AVG("Customer Rating") as avg_customer_rating
FROM sheet1
WHERE "Booking Status" = 'Completed' AND "Ride Distance" > 0
GROUP BY "Vehicle Type", rating_segment
ORDER BY "Vehicle Type", rating_segment;

-- Query 3: Average ride distance and booking value by vehicle type
SELECT 
  "Vehicle Type",
  AVG("Ride Distance") as avg_ride_distance,
  AVG("Booking Value") as avg_booking_value,
  COUNT(*) as num_completed
FROM sheet1
WHERE "Booking Status" = 'Completed' AND "Ride Distance" > 0
GROUP BY "Vehicle Type"
ORDER BY avg_booking_value DESC;

-- Query 4: Relationship between driver ratings and customer ratings
SELECT 
  "Driver Ratings",
  AVG("Customer Rating") as avg_customer_rating,
  COUNT(*) as num_rides
FROM sheet1
WHERE "Booking Status" = 'Completed'
GROUP BY "Driver Ratings"
ORDER BY "Driver Ratings";
```
