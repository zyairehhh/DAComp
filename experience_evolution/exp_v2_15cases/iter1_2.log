import sqlite3
import pandas as pd
import numpy as np
import re

def main():
    conn = sqlite3.connect('dacomp-093.sqlite')
    
    # 1. Load campaigns
    campaigns = pd.read_sql_query("SELECT * FROM klaviyo__campaigns", conn)
    print(f"Loaded {len(campaigns)} campaigns")
    
    # 2. Parse time window from campaign_name
    # pattern: [工作日-上午], [节前-下午], etc.
    def extract_window(name):
        match = re.search(r'\[([^\]]+)\]', name)
        if match:
            return match.group(1)
        else:
            return None
    campaigns['time_window_raw'] = campaigns['campaign_name'].apply(extract_window)
    # Split into day_part and period? We'll keep raw for now.
    
    # 3. Parse subject type
    def extract_subject_type(subject):
        if not isinstance(subject, str):
            return 'unknown'
        if '限时折扣' in subject:
            return 'discount'
        elif '新品上新' in subject:
            return 'new'
        elif '品牌故事' in subject:
            return 'storytelling'
        else:
            return 'other'
    campaigns['subject_type'] = campaigns['SUBJECT'].apply(extract_subject_type)
    
    # 4. Parse brand from campaign_name
    def extract_brand(name):
        # after bracket and space, before dash
        match = re.search(r'\]\s*([^-]+)', name)
        if match:
            return match.group(1).strip()
        else:
            return None
    campaigns['brand'] = campaigns['campaign_name'].apply(extract_brand)
    
    # 5. Clean data: exclude anomalous spikes in count_received_email
    # Use IQR method
    q1 = campaigns['count_received_email'].quantile(0.25)
    q3 = campaigns['count_received_email'].quantile(0.75)
    iqr = q3 - q1
    lower_bound = q1 - 1.5 * iqr
    upper_bound = q3 + 1.5 * iqr
    campaigns_clean = campaigns[(campaigns['count_received_email'] >= lower_bound) & 
                                 (campaigns['count_received_email'] <= upper_bound)].copy()
    print(f"Removed {len(campaigns) - len(campaigns_clean)} outliers based on count_received_email")
    
    # 6. Load persons
    persons = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
    print(f"Loaded {len(persons)} persons")
    
    # 7. Compute average retention per brand (active_retention_rate_week, month)
    brand_retention = persons.groupby('ORGANIZATION').agg(
        avg_active_retention_rate_week=pd.NamedAgg(column='active_retention_rate_week', aggfunc='mean'),
        avg_active_retention_rate_month=pd.NamedAgg(column='active_retention_rate_month', aggfunc='mean'),
        person_count=pd.NamedAgg(column='person_id', aggfunc='count')
    ).reset_index()
    brand_retention.rename(columns={'ORGANIZATION': 'brand'}, inplace=True)
    
    # 8. Merge campaigns with brand retention
    campaigns_with_retention = pd.merge(campaigns_clean, brand_retention, on='brand', how='left')
    
    # 9. Analysis grouping by time_window, subject_type, is_archived, variation_id
    # Compute weighted averages (weighted by total_count_unique_people)
    def weighted_average(df, value_col, weight_col):
        return np.average(df[value_col], weights=df[weight_col])
    
    grouping_cols = ['time_window_raw', 'subject_type', 'is_archived', 'variation_id']
    
    # Ensure numeric columns
    campaigns_with_retention['total_count_unique_people'] = pd.to_numeric(campaigns_with_retention['total_count_unique_people'], errors='coerce')
    campaigns_with_retention['email_open_rate'] = pd.to_numeric(campaigns_with_retention['email_open_rate'], errors='coerce')
    campaigns_with_retention['email_click_to_open_rate'] = pd.to_numeric(campaigns_with_retention['email_click_to_open_rate'], errors='coerce')
    
    # Create summary
    summary_list = []
    for name, group in campaigns_with_retention.groupby(grouping_cols):
        if len(group) == 0:
            continue
        time_window, subject, archived, variation = name
        weighted_open = weighted_average(group, 'email_open_rate', 'total_count_unique_people')
        weighted_click = weighted_average(group, 'email_click_to_open_rate', 'total_count_unique_people')
        weighted_retention_week = weighted_average(group, 'avg_active_retention_rate_week', 'total_count_unique_people')
        weighted_retention_month = weighted_average(group, 'avg_active_retention_rate_month', 'total_count_unique_people')
        count_campaigns = len(group)
        total_people = group['total_count_unique_people'].sum()
        summary_list.append({
            'time_window': time_window,
            'subject_type': subject,
            'is_archived': archived,
            'variation_id': variation,
            'campaign_count': count_campaigns,
            'total_unique_people': total_people,
            'weighted_open_rate': weighted_open,
            'weighted_click_to_open_rate': weighted_click,
            'weighted_active_retention_week': weighted_retention_week,
            'weighted_active_retention_month': weighted_retention_month
        })
    
    summary_df = pd.DataFrame(summary_list)
    print("Summary grouped by time_window, subject_type, is_archived, variation_id:")
    print(summary_df.to_string())
    
    # 10. Write summary to CSV for further inspection
    summary_df.to_csv('campaign_summary.csv', index=False)
    
    # 11. Additional analysis: time window effect ignoring subject, etc.
    # Let's produce a pivot for open rate by time_window and subject_type (aggregated across archived/variation)
    pivot_open = pd.pivot_table(campaigns_with_retention, values='email_open_rate', index='time_window_raw', columns='subject_type', aggfunc='mean', margins=True)
    print("\nPivot table of average open rate by time window and subject type:")
    print(pivot_open)
    
    pivot_click = pd.pivot_table(campaigns_with_retention, values='email_click_to_open_rate', index='time_window_raw', columns='subject_type', aggfunc='mean', margins=True)
    print("\nPivot table of average click-to-open rate by time window and subject type:")
    print(pivot_click)
    
    # 12. Compute retention by time_window and subject_type via brand aggregation (maybe we need average per brand)
    # We'll compute average retention per brand and then join with campaigns to get average retention per time_window/subject
    # But we already have campaigns_with_retention, we can compute weighted retention per time_window/subject
    retention_by_time_subject = campaigns_with_retention.groupby(['time_window_raw', 'subject_type']).apply(
        lambda x: pd.Series({
            'avg_retention_week': np.average(x['avg_active_retention_rate_week'], weights=x['total_count_unique_people']),
            'avg_retention_month': np.average(x['avg_active_retention_rate_month'], weights=x['total_count_unique_people']),
            'campaign_count': len(x)
        })
    ).reset_index()
    print("\nRetention by time window and subject type:")
    print(retention_by_time_subject.to_string())
    
    # 13. Write analysis results to markdown file
    with open('stage1.md', 'w') as f:
        f.write("# Campaign Analysis: Effects of Send Timing and Subject Copy\n\n")
        f.write("## Data Overview\n")
        f.write(f"- Total campaigns: {len(campaigns)}\n")
        f.write(f"- Total persons: {len(persons)}\n")
        f.write(f"- Brands: {', '.join(brand_retention['brand'].tolist())}\n\n")
        f.write("## Methodology\n")
        f.write("- Time window extracted from campaign_name (e.g., '工作日-上午')\n")
        f.write("- Subject type categorized as discount, new, or storytelling based on subject prefix.\n")
        f.write("- De-noising: removed outliers in count_received_email using IQR (1.5*IQR rule).\n")
        f.write("- Weighted averages computed using total_count_unique_people as weight.\n")
        f.write("- Active retention metrics averaged across persons per brand, then weighted by campaign audience size.\n\n")
        f.write("## Summary Statistics\n")
        f.write("### Open Rate and Click-to-Open Rate by Time Window and Subject Type\n")
        f.write(pivot_open.to_markdown())
        f.write("\n\n")
        f.write(pivot_click.to_markdown())
        f.write("\n\n")
        f.write("### Detailed Breakdown (Including is_archived and variation_id)\n")
        f.write(summary_df.to_markdown(index=False))
        f.write("\n\n")
        f.write("### Retention Rates by Time Window and Subject Type\n")
        f.write(retention_by_time_subject.to_markdown(index=False))
        f.write("\n\n")
        f.write("## Key Insights\n")
        f.write("**To be filled after analysis**\n")
    
    conn.close()
    print("Analysis complete.")

if __name__ == '__main__':
    main()
```
