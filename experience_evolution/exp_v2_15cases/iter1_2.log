                                'q1_prop','q2_prop','q3_prop','q4_prop',
                                'comprehensive_customer_score','total_revenue']].copy()
# Fill any NaN with 0
anomaly_features = anomaly_features.fillna(0)
scaler = StandardScaler()
scaled_features = scaler.fit_transform(anomaly_features)

# Determine optimal k using elbow method (simplified: try 2-5)
inertias = []
for k in range(2, 6):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(scaled_features)
    inertias.append(kmeans.inertia_)
# Choose k=3 for simplicity (or could compute silhouette)
k = 3
kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
anomaly_df['cluster'] = kmeans.fit_predict(scaled_features)

print("\n=== Cluster Analysis on Anomaly Customers (k=3) ===")
print("Cluster sizes:")
print(anomaly_df['cluster'].value_counts().sort_index())
print("\nCluster centroids (original scale):")
for cl in range(k):
    print(f"Cluster {cl}:")
    cluster_data = anomaly_df[anomaly_df['cluster']==cl]
    print(f"  Size: {len(cluster_data)}")
    print(f"  Avg transaction_count: {cluster_data['transaction_count'].mean():.2f}")
    print(f"  Avg transaction_value_volatility: {cluster_data['transaction_value_volatility'].mean():.3f}")
    print(f"  Avg seasonal preference (Q1-Q4 proportions): {cluster_data['q1_prop'].mean():.3f}, {cluster_data['q2_prop'].mean():.3f}, {cluster_data['q3_prop'].mean():.3f}, {cluster_data['q4_prop'].mean():.3f}")
    print(f"  Avg comprehensive_customer_score: {cluster_data['comprehensive_customer_score'].mean():.2f}")
    print(f"  Avg total_revenue: {cluster_data['total_revenue'].mean():.2f}")
    print(f"  Avg retention_probability: {cluster_data['retention_probability'].mean():.3f}")
    print(f"  Dominant profitability_segment: {cluster_data['profitability_segment'].value_counts().index[0]}")
    print()

# 5. Decision tree to predict anomaly vs normal using candidate new dimensions
# Features: trans_consistency_score, transaction_value_volatility, seasonal preference (maybe max quarter), lifecycle_stage, activity_status, growth_potential etc.
# Encode categoricals
df['seasonal_preference_cat'] = df['seasonal_preference'].astype('category').cat.codes
df['transaction_consistency_cat'] = df['transaction_consistency'].astype('category').cat.codes
df['growth_potential_cat'] = df['growth_potential'].astype('category').cat.codes
df['lifecycle_stage_cat'] = df['lifecycle_stage'].astype('category').cat.codes
df['activity_status_cat'] = df['activity_status'].astype('category').cat.codes

features = ['trans_consistency_score','transaction_value_volatility',
            'q1_prop','q2_prop','q3_prop','q4_prop',
            'seasonal_preference_cat','transaction_consistency_cat',
            'growth_potential_cat','lifecycle_stage_cat','activity_status_cat']
X = df[features].fillna(0)
y = df['is_anomaly']

tree = DecisionTreeClassifier(max_depth=4, random_state=42)
tree.fit(X, y)
print("=== Decision Tree Rules for Predicting Anomaly ===")
print("Feature importances:")
for feat, imp in zip(features, tree.feature_importances_):
    if imp > 0:
        print(f"  {feat}: {imp:.3f}")
print("\nTree structure (simplified):")
tree_rules = export_text(tree, feature_names=features)
print(tree_rules)

# 6. Recommendations
print("\n=== Recommendations ===")
print("1. Transactional Consistency: Anomaly customers have lower/higher transaction consistency?")
print("2. Seasonal Distribution: Anomaly customers show skewed quarter distribution.")
print("3. Value Realization: Correlation between score and revenue is different for anomalies.")
print("4. Clusters reveal distinct subgroups within anomalies.")
print("5. Decision tree highlights which dimensions are most predictive of classification anomaly.")
print("Consider adding transaction stability (volatility), seasonal concentration, and lifecycle stage into segmentation model.")
