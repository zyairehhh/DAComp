'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-098.sqlite')

# Load data
query = """
SELECT 
    c.conversation_id,
    c.conversation_initiated_type,
    c.time_to_first_response_minutes,
    e.all_conversation_tags
FROM intercom__conversation_metrics c
LEFT JOIN intercom__conversation_enhanced e ON c.conversation_id = e.conversation_id
WHERE c.conversation_initiated_type IN ('bot_first', 'human_first')
"""
df = pd.read_sql_query(query, conn)

# Parse tags
def parse_tags(tag_str):
    d = {}
    if tag_str:
        for kv in tag_str.split('|'):
            if ':' in kv:
                k, v = kv.split(':', 1)
                d[k] = v
    return d

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
for key in ['stage', 'region', 'intent', 'lifecycle']:
    df[key] = df['tags_dict'].apply(lambda d: d.get(key, None))

# 1. Conversion rate (closed_won) by region
df_closed = df[df['stage'] == 'closed_won']
grouped = df.groupby(['conversation_initiated_type', 'region']).size().unstack(fill_value=0)
total = df.groupby('conversation_initiated_type').size()
conversion_by_region = (df_closed.groupby(['conversation_initiated_type', 'region']).size() / grouped).reset_index()
conversion_by_region = conversion_by_region.rename(columns={0: 'conversion_rate'})
pivot = conversion_by_region.pivot(index='region', columns='conversation_initiated_type', values='conversion_rate')
pivot.dropna(inplace=True)

fig, ax = plt.subplots(figsize=(10,6))
pivot.plot(kind='bar', ax=ax)
ax.set_xlabel('Region')
ax.set_ylabel('Conversion Rate (Closed Won)')
ax.set_title('Conversion Rate by Region and First Response Type')
ax.legend(title='First Response')
plt.tight_layout()
plt.savefig('conversion_by_region.png', dpi=300)
plt.close()

# 2. Average time to first response by region
avg_time_by_region = df.groupby(['region', 'conversation_initiated_type'])['time_to_first_response_minutes'].mean().unstack()
avg_time_by_region.dropna(inplace=True)
avg_time_by_region.plot(kind='bar', figsize=(10,6))
plt.xlabel('Region')
plt.ylabel('Average Time to First Response (minutes)')
plt.title('Average First Response Time by Region and Responder Type')
plt.legend(title='First Response')
plt.tight_layout()
plt.savefig('avg_response_time_by_region.png', dpi=300)
plt.close()

# 3. Conversion funnel by initiator type: stack bars for each stage count
funnel_stages = ['demo_booked', 'trial_activated', 'closed_won']
funnel_data = df.groupby('conversation_initiated_type')['stage'].value_counts().unstack()
funnel_data = funnel_data[funnel_stages]
funnel_data.plot(kind='bar', stacked=True, figsize=(10,6))
plt.xlabel('First Response Type')
plt.ylabel('Number of Conversations')
plt.title('Funnel Stage Counts by First Response Type')
plt.legend(title='Stage')
plt.tight_layout()
plt.savefig('funnel_stage_counts.png', dpi=300)
plt.close()

print("Additional plots saved.")
''')
