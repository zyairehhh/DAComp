Let's create a Python script to compute health scores and generate insights.

First, compute aggregated avg_position per campaign-quarter.

Action: CreateFile(filepath='compute_health.py':
```
import sqlite3
import pandas as pd
import numpy as np

# Connect
conn = sqlite3.connect('dacomp-058.sqlite')

# Load campaign report
campaign = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)
campaign['roi'] = campaign['roas'] - 1

# Load keyword report and aggregate avg_position per campaign-quarter
keyword = pd.read_sql_query("SELECT campaign_id, year_quarter, AVG(avg_position) as avg_position, COUNT(*) as keyword_count FROM google_ads__keyword_report GROUP BY campaign_id, year_quarter", conn)

# Function to map month to quarter
def month_to_quarter(ym):
    year, month = map(int, ym.split('-'))
    quarter = (month - 1) // 3 + 1
    return f"{year}-Q{quarter}"

campaign['year_quarter'] = campaign['year_month'].apply(month_to_quarter)

# Merge avg_position
campaign = campaign.merge(keyword[['campaign_id', 'year_quarter', 'avg_position']], on=['campaign_id', 'year_quarter'], how='left')

# Fill missing avg_position with overall average (if any)
campaign['avg_position'].fillna(campaign['avg_position'].mean(), inplace=True)

# Define health score components
# Normalize metrics across the whole dataset (min-max scaling)
def min_max_scale(series, reverse=False):
    min_val = series.min()
    max_val = series.max()
    if max_val == min_val:
        return pd.Series([0.5] * len(series), index=series.index)
    scaled = (series - min_val) / (max_val - min_val)
    if reverse:
        scaled = 1 - scaled
    return scaled

# Cost Efficiency: ROAS (higher better) + cost_per_conversion (lower better)
campaign['roas_scaled'] = min_max_scale(campaign['roas'])
campaign['cpc_scaled'] = min_max_scale(campaign['cpc'], reverse=True)  # lower is better
campaign['cost_per_conv_scaled'] = min_max_scale(campaign['cost_per_conversion'], reverse=True)
campaign['cost_efficiency'] = 0.7 * campaign['roas_scaled'] + 0.3 * campaign['cost_per_conv_scaled']

# Conversion Quality: conversion_rate (higher better) + quality_score (higher better)
campaign['conv_rate_scaled'] = min_max_scale(campaign['conversion_rate'])
campaign['quality_scaled'] = min_max_scale(campaign['quality_score'])
campaign['conversion_quality'] = 0.5 * campaign['conv_rate_scaled'] + 0.5 * campaign['quality_scaled']

# Competitiveness: impression_share (higher better) + ctr (higher better) + avg_position (lower better)
campaign['imp_share_scaled'] = min_max_scale(campaign['impression_share'])
campaign['ctr_scaled'] = min_max_scale(campaign['ctr'])
campaign['avg_pos_scaled'] = min_max_scale(campaign['avg_position'], reverse=True)  # lower position better
campaign['competitiveness'] = 0.4 * campaign['imp_share_scaled'] + 0.3 * campaign['ctr_scaled'] + 0.3 * campaign['avg_pos_scaled']

# Overall health score
campaign['health_score'] = 0.4 * campaign['cost_efficiency'] + 0.35 * campaign['conversion_quality'] + 0.25 * campaign['competitiveness']
campaign['health_score_pct'] = campaign['health_score'] * 100

# Classify risk levels
def risk_level(score):
    if score >= 70:
        return 'Low Risk'
    elif score >= 50:
        return 'Medium Risk'
    else:
        return 'High Risk'

campaign['risk_level'] = campaign['health_score_pct'].apply(risk_level)

# Filter unhealthy campaigns (ROI < 0.8)
unhealthy = campaign[campaign['roi'] < 0.8].copy()
print(f"Unhealthy campaign-months: {unhealthy.shape[0]}")
print(f"Unique campaigns: {unhealthy['campaign_id'].nunique()}")

# Save to CSV for inspection
campaign.to_csv('campaign_health_scores.csv', index=False)
unhealthy.to_csv('unhealthy_campaigns.csv', index=False)

conn.close()
print("Health scores computed. Files saved.")
```
