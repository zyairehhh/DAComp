import pandas as pd
import re
import numpy as np

# Load the full vocational dataset
df = pd.read_csv('vocational_all.csv')
print(f"Rows: {len(df)}")

# Clean column names (they may have leading spaces)
df.columns = [c.strip() for c in df.columns]
print("Columns:", df.columns.tolist())

# Extract lower bound salary
def extract_lower_salary(salary_str):
    if pd.isnull(salary_str):
        return None
    s = str(salary_str).replace(',', '')
    main_part = s.split('(')[0].strip()
    match = re.search(r'(\d+)-\d+', main_part)
    if match:
        return int(match.group(1))
    return None

df['salary_lower'] = df['Salary Range'].apply(extract_lower_salary)
print(f"Rows with salary lower extracted: {df['salary_lower'].notnull().sum()}")

# Step 1: Starting salary distribution
bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 50000]
labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-7k', '7k-8k', '8k-9k', '9k-10k', '10k-15k', '15k-20k', '>20k']
df['salary_bin'] = pd.cut(df['salary_lower'], bins=bins, labels=labels, right=False)
salary_dist = df['salary_bin'].value_counts().sort_index()
print("\n=== STARTING SALARY DISTRIBUTION (lower bound) ===")
for bin_label, count in salary_dist.items():
    pct = count / salary_dist.sum() * 100
    print(f"{bin_label}: {count} ({pct:.1f}%)")

avg_salary = df['salary_lower'].mean()
median_salary = df['salary_lower'].median()
print(f"\nAverage lower salary: {avg_salary:.2f} RMB")
print(f"Median lower salary: {median_salary:.2f} RMB")

# Step 2: Benefits distribution
# Benefit categories mapping (simplified)
benefit_keywords = {
    'Five social insurances': 'Five social insurances',
    'Five insurances': 'Five social insurances',
    'social insurances': 'Five social insurances',
    'housing provident fund': 'Housing provident fund',
    'housing fund': 'Housing provident fund',
    'paid annual leave': 'Paid annual leave',
    'annual leave': 'Paid annual leave',
    'double pay': 'Double pay',
    'year-end bonus': 'Double pay',
    'performance bonus': 'Performance bonus',
    'meal allowance': 'Meal allowance',
    'meals provided': 'Meal allowance',
    'holiday benefits': 'Holiday benefits',
    'professional training': 'Professional training',
    'employee travel': 'Employee travel',
    'full attendance bonus': 'Full attendance bonus',
    'overtime pay': 'Overtime pay',
    'communication allowance': 'Communication allowance',
    'transportation allowance': 'Transportation allowance',
    'business trip allowance': 'Business trip allowance',
    'high temperature allowance': 'High temperature allowance',
    'housing allowance': 'Housing allowance',
    'commercial insurance': 'Commercial insurance',
    'medical check-ups': 'Medical check-ups',
    'no overtime': 'No overtime',
    'flexible working hours': 'Flexible working hours',
    'salary adjustments': 'Salary adjustments',
    'promotion opportunities': 'Promotion opportunities',
    'work uniform': 'Work uniform',
    'profit sharing': 'Profit sharing',
    'accommodation provided': 'Accommodation provided'
}

def extract_benefits(benefit_str):
    if pd.isnull(benefit_str):
        return []
    s = str(benefit_str).lower()
    categories = set()
    for kw, cat in benefit_keywords.items():
        if kw.lower() in s:
            categories.add(cat)
    # Also split by commas to catch any missed
    parts = re.split(r'[,\\.;，；、\s]+', s)
    for part in parts:
        for kw, cat in benefit_keywords.items():
            if kw.lower() in part:
                categories.add(cat)
    return list(categories)

df['benefit_list'] = df['Benefits'].apply(extract_benefits)
benefits_series = df['Benefits'].dropna()
print(f"\nRows with benefits info: {len(benefits_series)}")

benefit_counts = {}
for lst in df['benefit_list']:
    for cat in lst:
        benefit_counts[cat] = benefit_counts.get(cat, 0) + 1

print("\n=== BENEFITS DISTRIBUTION (Top 15) ===")
sorted_counts = sorted(benefit_counts.items(), key=lambda x: x[1], reverse=True)
for cat, count in sorted_counts[:15]:
    pct = count / len(benefits_series) * 100
    print(f"{cat}: {count} ({pct:.1f}%)")

# Step 3: Qualities that significantly increase starting salaries
# We consider columns: Work Experience Requirement, Foreign Language Requirement, Age Requirement, Gender Requirement, Industry, Company Type, Employment Type, etc.
# For each categorical column, compute average salary per category and compare to overall average.
qualities_cols = ['Work Experience Requirement', 'Foreign Language Requirement', 'Age Requirement', 'Gender Requirement', 'Industry', 'Company Type', 'Employment Type']
# Filter rows with valid salary
df_valid = df.dropna(subset=['salary_lower'])
print(f"\n=== QUALITIES ANALYSIS (salary influence) ===")

for col in qualities_cols:
    if col not in df_valid.columns:
        print(f"Column {col} not found.")
        continue
    # Group by category, ignoring NaN categories
    group = df_valid.groupby(col)['salary_lower'].agg(['count', 'mean', 'median']).sort_values('mean', ascending=False)
    # Only consider categories with at least 10 rows for statistical significance
    group = group[group['count'] >= 10]
    if len(group) > 0:
        print(f"\n--- {col} ---")
        print("Top 5 categories by average salary:")
        print(group.head(5))
        # Also compute bottom 5 to see contrast
        print("\nBottom 5 categories by average salary:")
        print(group.tail(5))
    else:
        print(f"\n--- {col} --- insufficient data")

# Additionally, we can examine interaction with Industry or Company Type
# Let's perform a simple regression-like analysis: compute average salary delta for each category.
# We'll create a function to compute effect size (difference from overall mean) for each category.
print("\n=== SIGNIFICANT QUALITIES (difference from overall mean) ===")
overall_mean = df_valid['salary_lower'].mean()
print(f"Overall mean salary: {overall_mean:.2f}")
for col in qualities_cols:
    if col not in df_valid.columns:
        continue
    # Compute mean per category, count, and difference
    group = df_valid.groupby(col)['salary_lower'].agg(['count', 'mean'])
    group = group[group['count'] >= 20]  # minimum sample size
    group['diff'] = group['mean'] - overall_mean
    # Sort by absolute difference
    group['abs_diff'] = group['diff'].abs()
    top_diff = group.sort_values('abs_diff', ascending=False).head(5)
    if len(top_diff) > 0:
        print(f"\n{col}:")
        for idx, row in top_diff.iterrows():
            print(f"  '{idx}': mean={row['mean']:.2f}, diff={row['diff']:.2f}, n={row['count']}")

# Let's also compute statistical significance using t-test for top categories (simple approach: compare group mean vs overall)
# We'll skip for simplicity due to time, but we can note that larger differences are likely indicative.

print("\nAnalysis complete.")
```
