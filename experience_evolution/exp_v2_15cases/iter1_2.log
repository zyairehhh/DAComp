import pandas as pd
import numpy as np

df = pd.read_csv('/workspace/joined_data.csv')

# Convert date columns to datetime again (since CSV lost dtype)
date_cols = ['initiated_at', 'first_response_at', 'demo_booked_at', 'trial_activated_at', 'paid_at']
for col in date_cols:
    df[col] = pd.to_datetime(df[col], errors='coerce')

# Ensure responder_type is cleaned
df['responder_type'] = df['responder_type'].str.strip().str.lower()
print("Responder types:", df['responder_type'].unique())

# Group by responder_type
grouped = df.groupby('responder_type')

# Counts
counts = grouped.size().reset_index(name='total_conversations')
demo_counts = grouped['demo_booked'].sum().reset_index(name='demo_booked')
trial_counts = grouped['trial_activated'].sum().reset_index(name='trial_activated')
paid_counts = grouped['paid'].sum().reset_index(name='paid')

# Merge
summary = pd.merge(counts, demo_counts, on='responder_type')
summary = pd.merge(summary, trial_counts, on='responder_type')
summary = pd.merge(summary, paid_counts, on='responder_type')

# Conversion rates
summary['demo_rate'] = summary['demo_booked'] / summary['total_conversations'] * 100
summary['trial_rate_given_demo'] = summary['trial_activated'] / summary['demo_booked'].replace(0, np.nan) * 100
summary['paid_rate_given_trial'] = summary['paid'] / summary['trial_activated'].replace(0, np.nan) * 100

print("\n=== Conversion Rates by Responder Type ===")
print(summary)

# Average stage durations (excluding nulls)
duration_cols = ['first_response_to_demo_days', 'demo_to_trial_days', 'trial_to_paid_days']
for col in duration_cols:
    mean_vals = df[df[col].notnull()].groupby('responder_type')[col].mean()
    print(f"\nAverage {col} (days):")
    print(mean_vals)

# Analyze conversation content features
print("\n=== Conversation Template ID Distribution by Responder ===")
template_counts = df.groupby(['responder_type', 'conversation_template_id']).size().reset_index(name='count')
print(template_counts.head(20))

print("\n=== Intent Label Distribution by Responder ===")
intent_counts = df.groupby(['responder_type', 'intent_label']).size().reset_index(name='count')
print(intent_counts.head(20))

# Segment by lead_source, industry, region
segments = ['lead_source', 'industry', 'region']
for seg in segments:
    print(f"\n=== Conversion Rates by {seg} and Responder Type ===")
    seg_summary = df.groupby([seg, 'responder_type']).agg(
        total=('conversation_id', 'count'),
        demo_booked=('demo_booked', 'sum'),
        trial_activated=('trial_activated', 'sum'),
        paid=('paid', 'sum')
    ).reset_index()
    seg_summary['demo_rate'] = seg_summary['demo_booked'] / seg_summary['total'] * 100
    seg_summary['trial_rate_given_demo'] = seg_summary['trial_activated'] / seg_summary['demo_booked'].replace(0, np.nan) * 100
    seg_summary['paid_rate_given_trial'] = seg_summary['paid'] / seg_summary['trial_activated'].replace(0, np.nan) * 100
    print(seg_summary.sort_values([seg, 'responder_type']).head(30))
```



