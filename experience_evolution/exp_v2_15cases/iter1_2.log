bars2 = ax.bar([i + width/2 for i in x], df2['dec_revenue'], width, label='Dec 2024', color='salmon')
ax.set_xlabel('Region', fontsize=14)
ax.set_ylabel('Revenue (USD)', fontsize=14)
ax.set_title('Revenue by Region: Jan vs Dec 2024', fontsize=16)
ax.set_xticks(x)
ax.set_xticklabels(df2['region'], rotation=45, ha='right')
ax.legend()
ax.grid(axis='y', alpha=0.3)

# Add change percentage on top
for i, row in df2.iterrows():
    ax.text(i, max(row['jan_revenue'], row['dec_revenue']) + 5000, f"{row['change_pct']:.1f}%", ha='center', fontsize=10)

