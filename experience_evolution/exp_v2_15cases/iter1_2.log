import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-066.sqlite')

# Combine tables
query = """
SELECT
    r.job_id,
    r.interview_rate as conversion_rate,
    r.total_interviews,
    r.completed_interviews,
    r.total_scorecards,
    r.avg_interview_score,
    r.has_good_interview_quality,
    j.hiring_managers,
    j.count_total_interviews,
    j.count_completed_interviews,
    j.avg_interviews_per_application,
    j.avg_job_rating,
    j.rating_completion_rate,
    j.application_to_interview_rate,
    j.interview_to_hire_rate,
    j.overall_conversion_rate,
    j.days_since_created,
    r.job_created_at
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced j ON r.job_id = j.job_id
WHERE j.departments = 'Engineering'
"""

df = pd.read_sql_query(query, conn)
conn.close()

# Create derived features
# Hiring manager experience: months since first job? Compute per manager
df['job_created_at'] = pd.to_datetime(df['job_created_at'])
manager_first = df.groupby('hiring_managers')['job_created_at'].min().reset_index()
manager_first.columns = ['hiring_managers', 'first_job_date']
df = df.merge(manager_first, on='hiring_managers', how='left')
df['months_active'] = (df['job_created_at'] - df['first_job_date']).dt.days / 30.0  # approximate months

# Number of interviewers? Not present. Use total_interviews per application maybe
# total_scorecards maybe is number of candidates interviewed? Use interviews per candidate
df['interviews_per_candidate'] = df['total_interviews'] / df['total_scorecards']

# Compute correlation matrix for numeric features against conversion_rate
numeric_cols = ['conversion_rate',
                'total_interviews',
                'completed_interviews',
                'total_scorecards',
                'avg_interview_score',
                'count_total_interviews',
                'count_completed_interviews',
                'avg_interviews_per_application',
                'avg_job_rating',
                'rating_completion_rate',
                'days_since_created',
                'months_active',
                'interviews_per_candidate'
                ]

# Fill missing values with median for columns
for col in numeric_cols:
    if df[col].isnull().any():
        df[col].fillna(df[col].median(), inplace=True)

corr_matrix = df[numeric_cols].corr()
print("Correlation with conversion_rate:")
print(corr_matrix['conversion_rate'].sort_values(ascending=False))

# Print top correlations (absolute value > 0.2)
corr_series = corr_matrix['conversion_rate'].drop('conversion_rate')
print("\nTop positive correlations (|corr| > 0.2):")
print(corr_series[abs(corr_series) > 0.2].sort_values(ascending=False))

# Group by hiring manager to see experience effect
manager_exp = df.groupby('hiring_managers').agg(
    avg_conversion=('conversion_rate', 'mean'),
    min_job_date=('job_created_at', 'min'),
    max_job_date=('job_created_at', 'max'),
    job_count=('job_id', 'count'),
    avg_months_active=('months_active', 'mean')
).reset_index()
manager_exp['tenure_days'] = (manager_exp['max_job_date'] - manager_exp['min_job_date']).dt.days
print("\nManager Experience vs Conversion:")
print(manager_exp[['hiring_managers', 'avg_conversion', 'job_count', 'tenure_days']])

# Correlation between manager's job_count and avg_conversion
print("\nCorrelation between manager's job_count and avg_conversion:")
print(np.corrcoef(manager_exp['job_count'], manager_exp['avg_conversion'])[0,1])
print("Correlation between tenure_days and avg_conversion:")
print(np.corrcoef(manager_exp['tenure_days'], manager_exp['avg_conversion'])[0,1])

# Impact of number of interviewers? proxy via avg_interviews_per_application
print("\n\nImpact of avg_interviews_per_application on conversion_rate:")
print("Correlation:", df['avg_interviews_per_application'].corr(df['conversion_rate']))
# Maybe bucket into groups:
df['interview_intensity'] = pd.qcut(df['avg_interviews_per_application'], q=3, labels=['Low', 'Medium', 'High'])
group_stats = df.groupby('interview_intensity')['conversion_rate'].agg(['mean', 'std', 'count'])
print("Mean conversion by interview intensity:")
print(group_stats)
```
