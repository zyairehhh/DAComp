```
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-069.sqlite')

# 1. Overall performance score trend
perf = pd.read_sql_query("""
SELECT date_day, overall_performance_score, research_budget_usd 
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor' 
ORDER BY date_day
""", conn)
print("Overall Performance Score Trend:")
print(perf)
print()

# 2. Region-level summary
region_summary = pd.read_sql_query("""
SELECT region, 
       COUNT(*) as num_countries,
       AVG(average_revenue_per_user) as avg_arpu,
       AVG(avg_transaction_value) as avg_transaction,
       AVG(weekly_growth_rate) as avg_growth,
       AVG(overall_market_score) as avg_market_score,
       AVG(day_30_retention_rate) as avg_retention_30d,
       AVG(daily_churn_rate) as avg_churn,
       AVG(app_quality_score) as avg_app_quality,
       SUM(revenue_last_30_days) as total_revenue_30d,
       SUM(avg_active_devices) as total_active_devices
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor'
GROUP BY region
ORDER BY avg_arpu DESC
""", conn)
print("Region-level Summary:")
print(region_summary.to_string())
print()

# 3. High vs Low ARPU segments (ARPU >30 vs ARPU <10)
segments = pd.read_sql_query("""
SELECT 
    CASE WHEN average_revenue_per_user > 30 THEN 'High ARPU (>30)'
         WHEN average_revenue_per_user < 10 THEN 'Low ARPU (<10)'
         ELSE 'Mid ARPU' END AS segment,
    COUNT(*) as num_markets,
    AVG(average_revenue_per_user) as avg_arpu,
    AVG(overall_market_score) as avg_market_score,
    AVG(weekly_growth_rate) as avg_weekly_growth,
    AVG(day_30_retention_rate) as avg_retention_30d,
    AVG(daily_churn_rate) as avg_churn,
    AVG(app_quality_score) as avg_app_quality,
    AVG(revenue_last_30_days) as avg_revenue_30d
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor'
GROUP BY segment
ORDER BY avg_arpu DESC
""", conn)
print("Segment Analysis (ARPU thresholds):")
print(segments.to_string())
print()

# 4. Monthly revenue trend by region (using finance report)
monthly_region = pd.read_sql_query("""
SELECT 
    substr(date_day,1,7) as month,
    region,
    SUM(net_amount) as revenue,
    SUM(transactions) as transactions,
    AVG(net_amount*1.0/transactions) as avg_transaction_value
FROM google_play__finance_report f
JOIN google_play__geo_market_analysis g 
    ON f.country_short = g.country AND f.package_name = g.package_name
WHERE f.package_name = 'com.dev.photoeditor'
GROUP BY month, region
ORDER BY month, region
""", conn)
print("Monthly Revenue by Region (first 30 rows):")
print(monthly_region.head(30).to_string())
print()

# 5. Calculate percent change in revenue per region from first to last month
if not monthly_region.empty:
    pivot = monthly_region.pivot(index='month', columns='region', values='revenue')
    print("Revenue pivot table (first few months):")
    print(pivot.head())
    # compute growth from first to last month for each region
    first_month = pivot.index.min()
    last_month = pivot.index.max()
    growth = (pivot.loc[last_month] - pivot.loc[first_month]) / pivot.loc[first_month] * 100
    print("\nRevenue Growth % from", first_month, "to", last_month)
    print(growth)
else:
    print("No monthly region data")

conn.close()
```
