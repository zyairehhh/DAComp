import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import numpy as np
import seaborn as sns
from datetime import datetime
import os

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

# Connect to database
conn = sqlite3.connect('/workspace/dacomp-093.sqlite')

# Load campaigns data
query = """
SELECT 
    campaign_id,
    SUBJECT,
    scheduled_to_send_at,
    is_archived,
    variation_id,
    total_count_unique_people,
    count_received_email,
    count_opened_email,
    count_clicked_email,
    count_placed_order,
    gmv_net_campaign,
    email_open_rate,
    email_click_to_open_rate
FROM klaviyo__campaigns
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Ensure datetime
df['scheduled_to_send_at'] = pd.to_datetime(df['scheduled_to_send_at'])

# Feature extraction as per Stage1
# Keyword group
def keyword_group(subject):
    subject_lower = subject.lower()
    if '折扣' in subject_lower or '券' in subject_lower or 'discount' in subject_lower:
        return 'Discount'
    elif '新品' in subject_lower or '上新' in subject_lower or 'new' in subject_lower:
        return 'New'
    elif '品牌故事' in subject_lower or '故事' in subject_lower or 'story' in subject_lower:
        return 'Storytelling'
    else:
        return 'Other'

df['keyword_group'] = df['SUBJECT'].apply(keyword_group)

# Time window
df['weekday'] = df['scheduled_to_send_at'].dt.dayofweek < 5  # Monday=0 .. Friday=4
df['time_of_day'] = df['scheduled_to_send_at'].dt.hour.apply(
    lambda h: 'Morning' if h < 12 else ('Afternoon' if h < 18 else 'Evening')
)

# Holiday flag (subject contains "节前")
df['before_holiday'] = df['SUBJECT'].str.contains('节前')

# Archived flag
df['is_archived'] = df['is_archived'].map({'true': True, 'false': False})

# Variation type
df['variation_type'] = df['variation_id'].apply(lambda x: 'Single' if x == 'single' else ('Variant A' if x == 'variant_a' else 'Variant B'))

# Compute derived metrics
df['open_rate'] = df['count_opened_email'] / df['count_received_email']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['conversion_rate'] = df['count_placed_order'] / df['count_received_email']
df['gmv_per_email'] = df['gmv_net_campaign'] / df['count_received_email']

# Remove outliers (using IQR on count_received_email)
Q1 = df['count_received_email'].quantile(0.25)
Q3 = df['count_received_email'].quantile(0.75)
IQR = Q3 - Q1
lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR
df = df[(df['count_received_email'] >= lower) & (df['count_received_email'] <= upper)]

print(f"Processed {len(df)} campaigns")
```
