Now we have enough insights for report. Let's also examine keyword strategy: maybe problematic ad groups have a higher proportion of broad match keywords? We already saw distribution earlier, but maybe broad match proportion is higher. Let's compute proportion of clicks from broad match (including BROAD and BROAD_MATCH_MODIFIER) for problematic vs non-problematic.

Action: CreateFile(filepath='/workspace/keyword_match_analysis.py':
'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-060.sqlite')

# Identify problematic ad groups (same as before)
agg_query = """
SELECT
    ad_group_id,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions
FROM google_ads__ad_group_report
GROUP BY ad_group_id
HAVING total_impressions > 0 AND total_clicks > 0
"""
agg_df = pd.read_sql_query(agg_query, conn)
agg_df['CTR'] = agg_df['total_clicks'] / agg_df['total_impressions']
agg_df['CVR'] = agg_df['total_conversions'] / agg_df['total_clicks']
ctr_75 = agg_df['CTR'].quantile(0.75)
cvr_25 = agg_df['CVR'].quantile(0.25)
problematic_ids = set(agg_df[(agg_df['CTR'] > ctr_75) & (agg_df['CVR'] < cvr_25)]['ad_group_id'])

# Get keyword-level data
keyword_query = """
SELECT
    ad_group_id,
    keyword_match_type,
    SUM(clicks) AS clicks
FROM google_ads__keyword_report
GROUP BY ad_group_id, keyword_match_type
"""
keyword_df = pd.read_sql_query(keyword_query, conn)

# Mark problematic
keyword_df['problematic'] = keyword_df['ad_group_id'].isin(problematic_ids)

# Compute clicks by match type and problematic flag
match_type_summary = keyword_df.groupby(['problematic', 'keyword_match_type'])['clicks'].sum().reset_index()
# Compute proportion within each group
def compute_proportion(df):
    total = df['clicks'].sum()
    df['proportion'] = df['clicks'] / total
    return df

match_type_summary = match_type_summary.groupby('problematic').apply(compute_proportion).reset_index(drop=True)
print("Clicks proportion by keyword match type:")
print(match_type_summary)

# Broad match proportion (BROAD + BROAD_MATCH_MODIFIER)
broad_types = ['BROAD', 'BROAD_MATCH_MODIFIER']
broad_summary = keyword_df[keyword_df['keyword_match_type'].isin(broad_types)].groupby('problematic')['clicks'].sum().reset_index()
broad_summary['total_clicks'] = keyword_df.groupby('problematic')['clicks'].sum().reset_index()['clicks']
broad_summary['broad_proportion'] = broad_summary['clicks'] / broad_summary['total_clicks']
print("\nBroad match (BROAD + BROAD_MATCH_MODIFIER) proportion:")
print(broad_summary)

conn.close()
''')
