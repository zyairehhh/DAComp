```python
import pandas as pd
import re
import numpy as np
import json

# Load the CSV
df = pd.read_csv('vocational_salaries_benefits.csv')
print(f"Total rows: {len(df)}")
# Show first few rows
print(df.head())
# Check missing values
print(f"Missing salary range: {df['Salary Range'].isnull().sum()}")
print(f"Missing benefits: {df['Benefits'].isnull().sum()}")

# Helper function to extract lower bound salary
def extract_lower_salary(salary_str):
    if pd.isnull(salary_str):
        return None
    # Remove commas for thousands
    s = str(salary_str).replace(',', '')
    # Find first number before dash (or before dash but possibly after parentheses)
    # Pattern: first number before dash that is part of the main range (before any parentheses)
    # Some strings have extra text like "8000-12000 RMB/month (Base salary: 4500-6000 RMB/month + commission)"
    # We'll consider the first number before dash before parentheses as the advertised lower bound.
    # Regex: capture digits before dash (and optional dash) but ignore after parentheses start?
    # Let's find the substring before '(' if exists, else whole string
    main_part = s.split('(')[0].strip()
    # Find pattern digits-dash-digits
    match = re.search(r'(\d+)-\d+', main_part)
    if match:
        return int(match.group(1))
    # If pattern digits to digits not found, maybe single number? not common.
    # Return None if not found
    return None

# Apply extraction
df['salary_lower'] = df['Salary Range'].apply(extract_lower_salary)
print(f"Successfully extracted lower salary for {df['salary_lower'].notnull().sum()} rows")

# Distribution of starting salary
# Bin into ranges
bins = [0, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 15000, 20000, 50000]
labels = ['<2k', '2k-3k', '3k-4k', '4k-5k', '5k-6k', '6k-7k', '7k-8k', '8k-9k', '9k-10k', '10k-15k', '15k-20k', '>20k']
df['salary_bin'] = pd.cut(df['salary_lower'], bins=bins, labels=labels, right=False)
salary_dist = df['salary_bin'].value_counts().sort_index()
print("Starting Salary Distribution (lower bound):")
print(salary_dist)
print("\nPercentage:")
print(salary_dist / salary_dist.sum() * 100)

# Compute average starting salary
avg_salary = df['salary_lower'].mean()
median_salary = df['salary_lower'].median()
print(f"\nAverage lower salary: {avg_salary:.2f} RMB")
print(f"Median lower salary: {median_salary:.2f} RMB")

# Benefits distribution
# Parse benefits column: each row may have multiple benefits separated by commas or other delimiters.
# Let's examine common benefit keywords
benefits_series = df['Benefits'].dropna()
# Split by commas or Chinese punctuation? Let's manually inspect common patterns.
# We'll create a list of known benefit keywords based on earlier sample.
# Write to file to examine
with open('benefit_sample.txt', 'w', encoding='utf-8') as f:
    for i, b in enumerate(benefits_series.head(100)):
        f.write(f"{i}: {b}\n")

print("\nBenefit sample written to benefit_sample.txt")
```
