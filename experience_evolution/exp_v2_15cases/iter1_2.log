# Filter for vehicles with age > 1 year to get meaningful depreciation
df_depreciation = df_clean[df_clean['age_years'] > 1]
# Group by brand and calculate average price per year (higher = better retention)
brand_retention = df_depreciation.groupby('brand').agg({
    'price_per_year': 'mean',
