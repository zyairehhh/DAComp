print("=== Geo Target Performance ===")
geo_stats = geo_merged.groupby('geo_target').agg(
    avg_health=('health_score', 'mean'),
    count=('campaign_id', 'count'),
    avg_roi=('roi', 'mean'),
    avg_cost=('cost', 'mean')
).round(4).sort_values('avg_health', ascending=False)
