import sqlite3
import pandas as pd
import numpy as np

# Connect to database
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-058/stage1_env/dacomp-058.sqlite')

# Load campaign report
df = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)
print(f"Total campaign-month rows: {len(df)}")

# Monthly cost > $1000 and ROI < 0.8 (ROAS < 1.8)
df_filtered = df[(df['cost'] > 1000) & (df['roas'] < 1.8)].copy()
print(f"Rows after filter (cost>1000, roas<1.8): {len(df_filtered)}")

if len(df_filtered) == 0:
    print("No rows meet criteria")
else:
    # Compute additional metrics
    df_filtered['roi'] = df_filtered['roas'] - 1
    # Conversion value per conversion (if conversions > 0)
    df_filtered['conversion_value_per_conversion'] = np.where(
        df_filtered['conversions'] > 0,
        df_filtered['conversion_value'] / df_filtered['conversions'],
        0
    )
    # avg_position not in campaign_report, we need from keyword_report aggregated? ignore for now
    # Compute health sub-scores
    # Normalize each metric across filtered dataset
    
    # Normalization function
    def normalize(series, higher_better=True):
        if higher_better:
            return (series - series.min()) / (series.max() - series.min() + 1e-10)
        else:
            return (series.max() - series) / (series.max() - series.min() + 1e-10)
    
    # Ensure no missing values
    for col in ['roas', 'cost_per_conversion', 'conversion_rate', 'quality_score', 'impression_share', 'ctr']:
        df_filtered[col] = df_filtered[col].fillna(df_filtered[col].median())
    
    # Sub-score 1: Cost Efficiency
    df_filtered['ce_roas'] = normalize(df_filtered['roas'], higher_better=True)
    df_filtered['ce_cost_per_conversion'] = normalize(df_filtered['cost_per_conversion'], higher_better=False)
    df_filtered['ce_conversion_rate'] = normalize(df_filtered['conversion_rate'], higher_better=True)
    df_filtered['cost_efficiency_score'] = (df_filtered['ce_roas'] + df_filtered['ce_cost_per_conversion'] + df_filtered['ce_conversion_rate']) / 3
    
    # Sub-score 2: Conversion Quality
    # Use quality_score, conversion_rate, conversion_value_per_conversion
    df_filtered['cq_quality_score'] = normalize(df_filtered['quality_score'], higher_better=True)
    df_filtered['cq_conversion_rate'] = normalize(df_filtered['conversion_rate'], higher_better=True)
    df_filtered['cq_value_per_conv'] = normalize(df_filtered['conversion_value_per_conversion'], higher_better=True)
    df_filtered['conversion_quality_score'] = (df_filtered['cq_quality_score'] + df_filtered['cq_conversion_rate'] + df_filtered['cq_value_per_conv']) / 3
    
    # Sub-score 3: Competitiveness
    # Use impression_share, ctr, avg_position (not available), quality_score (again)
    # Since avg_position missing, we can use ctr and impression_share and maybe quality_score
    df_filtered['cp_impression_share'] = normalize(df_filtered['impression_share'], higher_better=True)
    df_filtered['cp_ctr'] = normalize(df_filtered['ctr'], higher_better=True)
    df_filtered['cp_quality_score'] = normalize(df_filtered['quality_score'], higher_better=True)
    df_filtered['competitiveness_score'] = (df_filtered['cp_impression_share'] + df_filtered['cp_ctr'] + df_filtered['cp_quality_score']) / 3
    
    # Overall health score (weighted)
    df_filtered['health_score'] = (
        df_filtered['cost_efficiency_score'] * 0.4 +
        df_filtered['conversion_quality_score'] * 0.35 +
        df_filtered['competitiveness_score'] * 0.25
    )
    
    # Risk level categorization based on health score quartiles
    # Define risk levels: Low (top 25%), Medium (middle 50%), High (bottom 25%)
    q25 = df_filtered['health_score'].quantile(0.25)
    q75 = df_filtered['health_score'].quantile(0.75)
    def risk_level(score):
        if score >= q75:
            return 'Low'
        elif score >= q25:
            return 'Medium'
        else:
            return 'High'
    df_filtered['risk_level'] = df_filtered['health_score'].apply(risk_level)
    
    # Save results to CSV
    df_filtered.to_csv('high_risk_campaigns.csv', index=False)
    print("Saved filtered campaigns with health scores to high_risk_campaigns.csv")
    
    # Summary statistics
    print("\nHealth score distribution:")
    print(df_filtered['health_score'].describe())
    print("\nRisk level counts:")
    print(df_filtered['risk_level'].value_counts())

conn.close()
