import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

# Connect
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-058/stage1_env/dacomp-058.sqlite')

# 1. Load filtered high-risk campaigns (already computed)
df_high_risk = pd.read_csv('high_risk_campaigns.csv')
print(f"High-risk campaigns count: {len(df_high_risk)}")

# 2. Compare across dimensions
dimensions = ['campaign_type', 'bidding_strategy', 'industry']
for dim in dimensions:
    if dim in df_high_risk.columns:
        grouped = df_high_risk.groupby(dim).agg(
            campaign_count=('campaign_id', 'nunique'),
            avg_health_score=('health_score', 'mean'),
            avg_cost=('cost', 'mean'),
            avg_roas=('roas', 'mean'),
            avg_conversion_rate=('conversion_rate', 'mean'),
            avg_impression_share=('impression_share', 'mean'),
            avg_quality_score=('quality_score', 'mean')
        ).round(3)
        print(f"\n--- Performance by {dim} ---")
        print(grouped.sort_values('avg_health_score', ascending=False))
        # Save to CSV
        grouped.to_csv(f'performance_by_{dim}.csv')

# 3. Geographic distribution
# Load geo_report aggregated by campaign-month (filtered)
# We need to join with filtered campaigns
geo = pd.read_sql_query("SELECT year_month, campaign_id, geo_target, cost, conversions, conversion_value, impression_share, quality_score FROM google_ads__geo_report", conn)
# Filter to campaigns in df_high_risk
high_risk_campaigns_set = set(df_high_risk['campaign_id'])
geo_filtered = geo[geo['campaign_id'].isin(high_risk_campaigns_set)]
if not geo_filtered.empty:
    geo_grouped = geo_filtered.groupby('geo_target').agg(
        total_cost=('cost', 'sum'),
        avg_impression_share=('impression_share', 'mean'),
        avg_quality_score=('quality_score', 'mean'),
        total_conversions=('conversions', 'sum'),
        total_conversion_value=('conversion_value', 'sum')
    ).round(2).sort_values('total_cost', ascending=False)
    print("\n--- Geographic Performance (High-risk campaigns) ---")
    print(geo_grouped.head())
    geo_grouped.to_csv('geo_performance.csv')

# 4. Device distribution
device = pd.read_sql_query("SELECT year_month, campaign_id, device_type, cost, conversions, conversion_value, impression_share, quality_score FROM google_ads__device_report", conn)
device_filtered = device[device['campaign_id'].isin(high_risk_campaigns_set)]
if not device_filtered.empty:
    device_grouped = device_filtered.groupby('device_type').agg(
        total_cost=('cost', 'sum'),
        avg_impression_share=('impression_share', 'mean'),
        avg_quality_score=('quality_score', 'mean'),
        total_conversions=('conversions', 'sum'),
        total_conversion_value=('conversion_value', 'sum')
    ).round(2).sort_values('total_cost', ascending=False)
    print("\n--- Device Performance (High-risk campaigns) ---")
    print(device_grouped)
    device_grouped.to_csv('device_performance.csv')

# 5. Incorporate avg_position from keyword_report
keyword = pd.read_sql_query("SELECT year_quarter, campaign_id, avg_position FROM google_ads__keyword_report", conn)
# Aggregate by campaign_id (or campaign-month? year_quarter is quarter). We'll average per campaign.
keyword_agg = keyword.groupby('campaign_id').agg(avg_position_overall=('avg_position', 'mean')).reset_index()
# Merge with high-risk campaigns
df_high_risk_with_pos = pd.merge(df_high_risk, keyword_agg, on='campaign_id', how='left')
# Fill missing with overall median
median_pos = keyword_agg['avg_position_overall'].median()
df_high_risk_with_pos['avg_position_overall'] = df_high_risk_with_pos['avg_position_overall'].fillna(median_pos)
print(f"\nAverage position for high-risk campaigns: {df_high_risk_with_pos['avg_position_overall'].mean():.2f}")
# Save enriched data
df_high_risk_with_pos.to_csv('high_risk_campaigns_with_position.csv', index=False)

# 6. Trend analysis over time - YoY growth and seasonal fluctuations
# Parse year_month
df_high_risk['year_month'] = pd.to_datetime(df_high_risk['year_month'])
df_high_risk['year'] = df_high_risk['year_month'].dt.year
df_high_risk['month'] = df_high_risk['year_month'].dt.month
# Aggregate metrics per month across all high-risk campaigns
monthly = df_high_risk.groupby('year_month').agg(
    total_cost=('cost', 'sum'),
    total_conversions=('conversions', 'sum'),
    total_conversion_value=('conversion_value', 'sum'),
    avg_roas=('roas', 'mean'),
    avg_health_score=('health_score', 'mean'),
    campaign_count=('campaign_id', 'nunique')
).reset_index()
# Compute YoY growth: compare each month with same month previous year
monthly['prev_year_month'] = monthly['year_month'] - pd.DateOffset(years=1)
merged = pd.merge(monthly, monthly, left_on='year_month', right_on='prev_year_month', suffixes=('', '_prev'), how='left')
# YoY growth rate for total_cost
merged['cost_yoy_growth'] = (merged['total_cost'] - merged['total_cost_prev']) / merged['total_cost_prev']
merged['roas_yoy_growth'] = (merged['avg_roas'] - merged['avg_roas_prev']) / merged['avg_roas_prev']
merged['health_yoy_growth'] = (merged['avg_health_score'] - merged['avg_health_score_prev']) / merged['avg_health_score_prev']
# Keep relevant columns
trend = merged[['year_month', 'total_cost', 'total_cost_prev', 'cost_yoy_growth', 'avg_roas', 'avg_roas_prev', 'roas_yoy_growth', 'avg_health_score', 'avg_health_score_prev', 'health_yoy_growth']]
print("\n--- Trend Analysis (YoY Growth) ---")
print(trend[['year_month', 'cost_yoy_growth', 'roas_yoy_growth', 'health_yoy_growth']].tail(12))
