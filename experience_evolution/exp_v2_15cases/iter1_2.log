import sqlite3
import pandas as pd
import numpy as np
from sklearn.cluster import KMeans
from sklearn.tree import DecisionTreeClassifier, export_text
from sklearn.preprocessing import StandardScaler, LabelEncoder
import warnings
warnings.filterwarnings('ignore')

db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter1/dacomp-076/stage1_env/dacomp-076.sqlite'
conn = sqlite3.connect(db_path)
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
conn.close()

# Compute segment averages
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'seg_avg_retention']
df = df.merge(segment_avg, on='profitability_segment')
df['retention_diff'] = abs(df['retention_probability'] - df['seg_avg_retention'])
df['is_anomaly'] = df['retention_diff'] > 0.15

anomaly_df = df[df['is_anomaly']]
normal_df = df[~df['is_anomaly']]

print("=== Overview ===")
print(f"Total customers: {len(df)}")
print(f"Anomaly customers: {len(anomaly_df)} ({len(anomaly_df)/len(df):.2%})")
print("\nSegment distribution of anomalies:")
print(anomaly_df['profitability_segment'].value_counts())
print("\nSegment distribution of normals:")
print(normal_df['profitability_segment'].value_counts())

# 1. Transactional behavior analysis
# Consistency between transaction_count and avg_transactions_per_month
df['trans_consistency_score'] = df.apply(lambda row: row['transaction_count'] / (row['avg_transactions_per_month'] * 12) if row['avg_transactions_per_month'] > 0 else 0, axis=1)
# transaction_value_volatility

print("\n=== Transactional Behavior ===")
print("Anomaly vs Normal - Transaction Count:")
print(f"Anomaly mean: {anomaly_df['transaction_count'].mean():.2f}")
print(f"Normal mean: {normal_df['transaction_count'].mean():.2f}")
print("\nAvg Transactions per Month:")
print(f"Anomaly mean: {anomaly_df['avg_transactions_per_month'].mean():.2f}")
print(f"Normal mean: {normal_df['avg_transactions_per_month'].mean():.2f}")
print("\nTransaction Value Volatility:")
print(f"Anomaly mean: {anomaly_df['transaction_value_volatility'].mean():.3f}")
print(f"Normal mean: {normal_df['transaction_value_volatility'].mean():.3f}")
print("\nTrans Consistency Score (transaction_count / (avg_transactions_per_month*12)):")
print(f"Anomaly mean: {anomaly_df['trans_consistency_score'].mean():.3f}")
print(f"Normal mean: {normal_df['trans_consistency_score'].mean():.3f}")

# 2. Seasonal patterns: Q1-Q4 distribution
df['total_quarter_trans'] = df[['q1_transactions','q2_transactions','q3_transactions','q4_transactions']].sum(axis=1)
for q in ['q1','q2','q3','q4']:
    df[f'{q}_prop'] = df[f'{q}_transactions'] / df['total_quarter_trans'].replace(0,1)

print("\n=== Seasonal Patterns ===")
quarters = ['q1','q2','q3','q4']
for q in quarters:
    print(f"{q} proportion - Anomaly mean: {anomaly_df[f'{q}_prop'].mean():.3f}, Normal mean: {normal_df[f'{q}_prop'].mean():.3f}")

# 3. Value realization: alignment between comprehensive_customer_score and total_revenue
# Compute correlation per segment?
print("\n=== Value Realization ===")
print("Correlation between comprehensive_customer_score and total_revenue:")
print(f"Overall correlation: {df['comprehensive_customer_score'].corr(df['total_revenue']):.3f}")
print(f"Anomaly correlation: {anomaly_df['comprehensive_customer_score'].corr(anomaly_df['total_revenue']):.3f}")
print(f"Normal correlation: {normal_df['comprehensive_customer_score'].corr(normal_df['total_revenue']):.3f}")

# 4. Cluster analysis on anomaly customers to see if natural subgroups exist
# Features: trans_consistency_score, transaction_value_volatility, q1_prop, q2_prop, q3_prop, q4_prop, comprehensive_customer_score, total_revenue (maybe scaled)
anomaly_features = anomaly_df[['trans_consistency_score','transaction_value_volatility',
                                'q1_prop','q2_prop','q3_prop','q4_prop',
                                'comprehensive_customer_score','total_revenue']].copy()
# Fill any NaN with 0
anomaly_features = anomaly_features.fillna(0)
scaler = StandardScaler()
scaled_features = scaler.fit_transform(anomaly_features)

# Determine optimal k using elbow method (simplified: try 2-5)
inertias = []
for k in range(2, 6):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(scaled_features)
    inertias.append(kmeans.inertia_)
# Choose k=3 for simplicity (or could compute silhouette)
k = 3
kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
anomaly_df['cluster'] = kmeans.fit_predict(scaled_features)

print("\n=== Cluster Analysis on Anomaly Customers (k=3) ===")
print("Cluster sizes:")
print(anomaly_df['cluster'].value_counts().sort_index())
print("\nCluster centroids (original scale):")
for cl in range(k):
    print(f"Cluster {cl}:")
    cluster_data = anomaly_df[anomaly_df['cluster']==cl]
    print(f"  Size: {len(cluster_data)}")
    print(f"  Avg transaction_count: {cluster_data['transaction_count'].mean():.2f}")
    print(f"  Avg transaction_value_volatility: {cluster_data['transaction_value_volatility'].mean():.3f}")
    print(f"  Avg seasonal preference (Q1-Q4 proportions): {cluster_data['q1_prop'].mean():.3f}, {cluster_data['q2_prop'].mean():.3f}, {cluster_data['q3_prop'].mean():.3f}, {cluster_data['q4_prop'].mean():.3f}")
    print(f"  Avg comprehensive_customer_score: {cluster_data['comprehensive_customer_score'].mean():.2f}")
    print(f"  Avg total_revenue: {cluster_data['total_revenue'].mean():.2f}")
    print(f"  Avg retention_probability: {cluster_data['retention_probability'].mean():.3f}")
    print(f"  Dominant profitability_segment: {cluster_data['profitability_segment'].value_counts().index[0]}")
    print()

# 5. Decision tree to predict anomaly vs normal using candidate new dimensions
# Features: trans_consistency_score, transaction_value_volatility, seasonal preference (maybe max quarter), lifecycle_stage, activity_status, growth_potential etc.
# Encode categoricals
df['seasonal_preference_cat'] = df['seasonal_preference'].astype('category').cat.codes
df['transaction_consistency_cat'] = df['transaction_consistency'].astype('category').cat.codes
df['growth_potential_cat'] = df['growth_potential'].astype('category').cat.codes
df['lifecycle_stage_cat'] = df['lifecycle_stage'].astype('category').cat.codes
df['activity_status_cat'] = df['activity_status'].astype('category').cat.codes

features = ['trans_consistency_score','transaction_value_volatility',
            'q1_prop','q2_prop','q3_prop','q4_prop',
            'seasonal_preference_cat','transaction_consistency_cat',
            'growth_potential_cat','lifecycle_stage_cat','activity_status_cat']
X = df[features].fillna(0)
y = df['is_anomaly']

tree = DecisionTreeClassifier(max_depth=4, random_state=42)
tree.fit(X, y)
print("=== Decision Tree Rules for Predicting Anomaly ===")
print("Feature importances:")
for feat, imp in zip(features, tree.feature_importances_):
    if imp > 0:
        print(f"  {feat}: {imp:.3f}")
print("\nTree structure (simplified):")
tree_rules = export_text(tree, feature_names=features)
print(tree_rules)

# 6. Recommendations
print("\n=== Recommendations ===")
print("1. Transactional Consistency: Anomaly customers have lower/higher transaction consistency?")
print("2. Seasonal Distribution: Anomaly customers show skewed quarter distribution.")
print("3. Value Realization: Correlation between score and revenue is different for anomalies.")
print("4. Clusters reveal distinct subgroups within anomalies.")
print("5. Decision tree highlights which dimensions are most predictive of classification anomaly.")
print("Consider adding transaction stability (volatility), seasonal concentration, and lifecycle stage into segmentation model.")
