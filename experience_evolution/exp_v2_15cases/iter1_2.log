axes[1,0].bar(intent_subset.index, intent_subset.get('pricing', 0), label='pricing', color='orange')
axes[1,0].bar(intent_subset.index, intent_subset.get('billing', 0), bottom=intent_subset.get('pricing', 0), label='billing', color='red')
# For other intents, stack
