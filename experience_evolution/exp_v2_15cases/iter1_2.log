```
import sqlite3
import pandas as pd
import numpy as np
import datetime
import sys

def main():
    conn = sqlite3.connect('dacomp-098.sqlite')
    # Fetch conversations with necessary fields
    query = """
    SELECT 
        c.conversation_id,
        c.conversation_initiated_type,
        c.all_conversation_tags,
        c.all_contact_company_names as company_name,
        c.conversation_created_at,
        c.first_close_at,
        m.first_admin_response_at,
        c.conversation_rating,
        c.conversation_subject
    FROM intercom__conversation_enhanced c
    JOIN intercom__conversation_metrics m ON c.conversation_id = m.conversation_id
    WHERE c.all_contact_company_names IS NOT NULL 
        AND c.all_contact_company_names != ''
    """
    df = pd.read_sql_query(query, conn)
    print(f"Total conversations with company name: {len(df)}")
    
    # Parse tags
    def extract_tag(tags, prefix):
        if not isinstance(tags, str):
            return None
        start = tags.find(prefix)
        if start == -1:
            return None
        start += len(prefix)
        end = tags.find('|', start)
        if end == -1:
            return tags[start:]
        return tags[start:end]
    
    df['stage'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage:'))
    df['intent'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent:'))
    df['topic'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'topic:'))
    df['segment'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'segment:'))
    df['region'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'region:'))
    df['lifecycle'] = df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'lifecycle:'))
    
    # Convert timestamps
    for col in ['conversation_created_at', 'first_close_at', 'first_admin_response_at']:
        df[col] = pd.to_datetime(df[col], errors='coerce')
    
    # Compute responder type per company: Bot-led if any conversation is bot_first
    company_bot = df.groupby('company_name')['conversation_initiated_type'].apply(lambda x: (x == 'bot_first').any()).reset_index()
    company_bot['responder_type'] = company_bot['conversation_initiated_type'].map({True: 'bot', False: 'human'})
    company_bot = company_bot.drop(columns=['conversation_initiated_type'])
    
    # For each company, compute conversion flags
    stage_df = df.groupby('company_name')['stage'].apply(list).reset_index()
    stage_df['demo_booked'] = stage_df['stage'].apply(lambda x: 'demo_booked' in x)
    stage_df['trial_activated'] = stage_df['stage'].apply(lambda x: 'trial_activated' in x)
    stage_df['closed_won'] = stage_df['stage'].apply(lambda x: 'closed_won' in x)
    
    # Merge with responder type
    company_stats = pd.merge(company_bot, stage_df.drop(columns=['stage']), on='company_name', how='inner')
    
    # Total companies per responder type
    total_counts = company_stats['responder_type'].value_counts()
    print("Companies by responder type:")
    print(total_counts)
    
    # Conversion rates
    conv_rates = company_stats.groupby('responder_type').agg(
        total_companies=('company_name', 'count'),
        demo_booked=('demo_booked', 'sum'),
        trial_activated=('trial_activated', 'sum'),
        closed_won=('closed_won', 'sum')
    ).reset_index()
    conv_rates['demo_booked_rate'] = conv_rates['demo_booked'] / conv_rates['total_companies']
    # conditional rates
    conv_rates['trial_activation_rate_given_demo'] = conv_rates['trial_activated'] / conv_rates['demo_booked'].replace(0, np.nan)
    conv_rates['closed_won_rate_given_trial'] = conv_rates['closed_won'] / conv_rates['trial_activated'].replace(0, np.nan)
    print("\nConversion Rates per responder type:")
    print(conv_rates)
    
    # Stage durations: compute average time from first_admin_response_at to first_close_at per stage per responder type
    df['response_to_close_days'] = (df['first_close_at'] - df['first_admin_response_at']).dt.total_seconds() / (24*60*60)
    # Filter by stage and responder type
    demo_durations = df[df['stage'] == 'demo_booked'].groupby('conversation_initiated_type')['response_to_close_days'].mean()
    trial_durations = df[df['stage'] == 'trial_activated'].groupby('conversation_initiated_type')['response_to_close_days'].mean()
    won_durations = df[df['stage'] == 'closed_won'].groupby('conversation_initiated_type')['response_to_close_days'].mean()
    
    print("\nAverage days from first response to close per stage:")
    print("Demo booked:", demo_durations)
    print("Trial activated:", trial_durations)
    print("Closed won:", won_durations)
    
    # Analyze conversation content features
    # Intent, topic, segment, region, lifecycle distribution per responder type
    content_df = df.groupby(['conversation_initiated_type', 'intent']).size().unstack(fill_value=0)
    print("\nIntent distribution:")
    print(content_df)
    
    # Save results to CSV for reporting
    conv_rates.to_csv('/workspace/conversion_rates.csv', index=False)
    # Also save durations
    durations = pd.DataFrame({
        'stage': ['demo_booked', 'trial_activated', 'closed_won'],
        'bot_first': [demo_durations.get('bot_first', np.nan), trial_durations.get('bot_first', np.nan), won_durations.get('bot_first', np.nan)],
        'human_first': [demo_durations.get('human_first', np.nan), trial_durations.get('human_first', np.nan), won_durations.get('human_first', np.nan)]
    })
    durations.to_csv('/workspace/stage_durations.csv', index=False)
    
    # Write markdown report
    with open('/workspace/stage1.md', 'w') as f:
        f.write("# Impact of Bot-led First Response Strategy on Sales Funnel\n")
        f.write("\n## Executive Summary\n")
        f.write("Based on analysis of conversation data, segmentation of companies into bot-first vs human-first response reveals key differences in conversion rates and stage durations.\n")
        f.write("\n## Data Overview\n")
        f.write(f"- Total conversations with company name: {len(df)}\n")
        f.write(f"- Distinct companies: {len(company_stats)}\n")
        f.write(f"- Bot-led companies (at least one bot-first conversation): {len(company_stats[company_stats['responder_type']=='bot'])}\n")
        f.write(f"- Human-led companies: {len(company_stats[company_stats['responder_type']=='human'])}\n")
        f.write("\n## Conversion Rates\n")
        f.write(conv_rates.to_markdown(index=False))
        f.write("\n\n## Average Stage Durations (Days from First Response to Close)\n")
        f.write(durations.to_markdown(index=False))
        f.write("\n\n## Conversation Content Analysis\n")
        f.write("Intent distribution:\n")
        f.write(content_df.to_markdown())
        f.write("\n\n## Conclusions and Recommendations\n")
        f.write("To be expanded after deeper analysis.\n")
    
    print("Analysis complete. Report saved.")
    
    conn.close()

if __name__ == '__main__':
    main()
