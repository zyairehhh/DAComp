import sqlite3
import pandas as pd
import numpy as np
import json

conn = sqlite3.connect('/workspace/dacomp-098.sqlite')

# Load conversations with tags
query = """
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.conversation_last_updated_at,
    ce.conversation_initiated_type,
    ce.all_conversation_tags,
    ce.first_admin_close_at,
    ce.first_close_at,
    ce.first_close_by_admin_id,
    ce.conversation_rating,
    ce.all_conversation_contacts as contact_id,
    cm.first_admin_response_at,
    cm.time_to_first_response_minutes,
    cm.first_contact_reply_at
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
 ON ce.conversation_id = cm.conversation_id
"""
df = pd.read_sql_query(query, conn)

print(f"Total conversations: {len(df)}")
print(df['conversation_initiated_type'].value_counts())
print(df.head())

# Parse tags into dictionary
def parse_tags(tag_str):
    if not tag_str:
        return {}
    tags = {}
    for pair in tag_str.split('|'):
        if ':' in pair:
            key, value = pair.split(':', 1)
            tags[key.strip()] = value.strip()
    return tags

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['path'] = df['tags_dict'].apply(lambda d: d.get('path', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['topic'] = df['tags_dict'].apply(lambda d: d.get('topic', ''))
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))
df['lifecycle'] = df['tags_dict'].apply(lambda d: d.get('lifecycle', ''))

# Check mapping of path vs conversation_initiated_type
print(df[['conversation_initiated_type','path']].head(10))

# Load contacts
contacts = pd.read_sql_query("SELECT contact_id, contact_role, all_contact_company_names FROM intercom__contact_enhanced", conn)
df = df.merge(contacts, left_on='contact_id', right_on='contact_id', how='left')
# Load companies
companies = pd.read_sql_query("SELECT company_name, industry FROM intercom__company_enhanced", conn)
# merge via company name
df = df.merge(companies, left_on='all_contact_company_names', right_on='company_name', how='left')

print(df.head())

conn.close()
```
