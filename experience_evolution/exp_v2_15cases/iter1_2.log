    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(scaled_features)
    inertias.append(kmeans.inertia_)
# Choose k=3 for simplicity (or could compute silhouette)
k = 3
kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
anomaly_df['cluster'] = kmeans.fit_predict(scaled_features)

print("\n=== Cluster Analysis on Anomaly Customers (k=3) ===")
print("Cluster sizes:")
print(anomaly_df['cluster'].value_counts().sort_index())
print("\nCluster centroids (original scale):")
for cl in range(k):
    print(f"Cluster {cl}:")
    cluster_data = anomaly_df[anomaly_df['cluster']==cl]
    print(f"  Size: {len(cluster_data)}")
    print(f"  Avg transaction_count: {cluster_data['transaction_count'].mean():.2f}")
    print(f"  Avg transaction_value_volatility: {cluster_data['transaction_value_volatility'].mean():.3f}")
    print(f"  Avg seasonal preference (Q1-Q4 proportions): {cluster_data['q1_prop'].mean():.3f}, {cluster_data['q2_prop'].mean():.3f}, {cluster_data['q3_prop'].mean():.3f}, {cluster_data['q4_prop'].mean():.3f}")
    print(f"  Avg comprehensive_customer_score: {cluster_data['comprehensive_customer_score'].mean():.2f}")
    print(f"  Avg total_revenue: {cluster_data['total_revenue'].mean():.2f}")
    print(f"  Avg retention_probability: {cluster_data['retention_probability'].mean():.3f}")
    print(f"  Dominant profitability_segment: {cluster_data['profitability_segment'].value_counts().index[0]}")
    print()

# 5. Decision tree to predict anomaly vs normal using candidate new dimensions
# Features: trans_consistency_score, transaction_value_volatility, seasonal preference (maybe max quarter), lifecycle_stage, activity_status, growth_potential etc.
