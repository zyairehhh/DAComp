import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-066.sqlite')

query = """
SELECT
    r.job_id,
    r.interview_rate,
    j.departments,
    j.hiring_managers,
    r.job_created_at,
    r.job_title
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced j ON r.job_id = j.job_id
WHERE j.departments = 'Engineering'
"""

df = pd.read_sql_query(query, conn)
conn.close()

# Extract role
df['role'] = df['job_title'].apply(lambda x: x.split(' - ')[0] if ' - ' in x else x)

# Aggregate by hiring manager
manager_stats = df.groupby('hiring_managers').agg(
    job_count=('job_id', 'count'),
    avg_conversion=('interview_rate', 'mean'),
    std_conversion=('interview_rate', 'std'),
    median_conversion=('interview_rate', 'median')
).reset_index()

# Sort by avg conversion
manager_stats = manager_stats.sort_values('avg_conversion')

print("Hiring Manager Performance (Engineering):")
print(manager_stats.to_string())

# Identify managers with significantly lower conversion rates
# Let's compute overall average for Engineering
overall_avg = df['interview_rate'].mean()
print(f"\nOverall average conversion rate for Engineering: {overall_avg:.2f}%")
print("\nManagers below overall average:")
below_avg = manager_stats[manager_stats['avg_conversion'] < overall_avg]
print(below_avg.to_string())

# For each manager, also check trend over time
df['month'] = pd.to_datetime(df['job_created_at']).dt.to_period('M')
manager_month = df.groupby(['hiring_managers', 'month'])['interview_rate'].mean().reset_index()
# Compute slope (simplified: last month - first month)
def compute_trend(group):
    if len(group) >= 2:
        group = group.sort_values('month')
        first = group.iloc[0]['interview_rate']
        last = group.iloc[-1]['interview_rate']
        change = last - first
        return pd.Series({'trend': change, 'first': first, 'last': last})
    else:
        return pd.Series({'trend': None, 'first': None, 'last': None})
manager_trend = manager_month.groupby('hiring_managers').apply(compute_trend).reset_index()
manager_trend = manager_trend.sort_values('trend')
print("\nManager Trend (change over time):")
print(manager_trend.to_string())

# Merge with manager_stats
manager_full = manager_stats.merge(manager_trend, on='hiring_managers', how='left')
manager_full = manager_full.sort_values('avg_conversion')
print("\nCombined Manager Stats:")
print(manager_full.to_string())
'''
