import pandas as pd

conn = sqlite3.connect('dacomp-066.sqlite')
query = """
SELECT 
    e.departments,
    r.application_year,
    r.application_quarter,
    SUM(r.total_applications) as total_apps,
    SUM(r.total_interviews) as total_ints
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced e ON r.job_id = e.job_id
WHERE r.total_applications > 0
GROUP BY e.departments, r.application_year, r.application_quarter
ORDER BY e.departments, r.application_year, r.application_quarter
"""
df = pd.read_sql_query(query, conn)
conn.close()
df['conversion_rate'] = df['total_ints'] / df['total_apps']
print(df)
