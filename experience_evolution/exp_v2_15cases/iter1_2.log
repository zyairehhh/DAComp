Action: EditFile(filepath='/workspace/account_features.py'):
```
import pandas as pd
import sqlite3
import numpy as np
from datetime import datetime

conn = sqlite3.connect('dacomp-078.sqlite')
df = pd.read_sql('SELECT * FROM pendo__account', conn)
# Convert date strings to datetime
df['first_event_on'] = pd.to_datetime(df['first_event_on'])
df['last_event_on'] = pd.to_datetime(df['last_event_on'])
# Compute total months active (as integer)
df['total_months'] = ((df['last_event_on'] - df['first_event_on']).dt.days / 30.44).clip(lower=1)
df['activity_density'] = df['count_active_months'] / df['total_months']  # ratio of months with activity
# Compute average minutes per active day
df['avg_minutes_per_active_day'] = df['sum_minutes'] / df['count_active_days'].replace(0, np.nan)
# Compute average events per active day
df['avg_events_per_active_day'] = df['sum_events'] / df['count_active_days'].replace(0, np.nan)
# Fill NaN
df.fillna(0, inplace=True)

# Manual min-max scaling
def minmax(series):
    return (series - series.min()) / (series.max() - series.min())

features_to_scale = ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors', 'activity_density', 'avg_minutes_per_active_day']
scaled = pd.DataFrame()
for col in features_to_scale:
    scaled[col] = minmax(df[col])

weights = [0.2, 0.15, 0.15, 0.1, 0.15, 0.1, 0.15]
df['value_score'] = scaled.dot(weights)

# Define high-value as top 20% of value_score
threshold = df['value_score'].quantile(0.8)
df['high_value_new'] = (df['value_score'] >= threshold).astype(int)
# Compare with old high-value (based solely on sum_minutes top20%)
df['high_value_old'] = (df['sum_minutes'] >= df['sum_minutes'].quantile(0.8)).astype(int)
# Compute accuracy improvement
old_acc = (df['high_value_old'] == df['high_value_new']).mean()
print('Old vs New high-value agreement:', old_acc)
# Compute confusion
print('Confusion matrix old (row) vs new (col):')
print(pd.crosstab(df['high_value_old'], df['high_value_new'], rownames=['old'], colnames=['new']))
# Compute correlation of value_score with sum_minutes
corr = df['value_score'].corr(df['sum_minutes'])
print('Correlation value_score vs sum_minutes:', corr)
# Compute other correlations
for col in features_to_scale:
    corr = df['value_score'].corr(df[col])
    print(f'Correlation value_score vs {col}: {corr:.3f}')

# Compute new high-value counts
print('High-value new count:', df['high_value_new'].sum())
print('High-value old count:', df['high_value_old'].sum())
```
