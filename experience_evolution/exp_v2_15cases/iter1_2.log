def minmax_scale(series):
    min_val = series.min()
    max_val = series.max()
    print(f'Scale {series.name}: min={min_val}, max={max_val}, diff={max_val-min_val}')
    if max_val - min_val == 0:
        return pd.Series([0.5] * len(series))
    return (series - min_val) / (max_val - min_val)
scaled_features = {}
