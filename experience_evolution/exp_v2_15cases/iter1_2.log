Action: LOCAL_DB_SQL(file_path="/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-076/stage1_env/dacomp-076.sqlite", command="
WITH seg_avg AS (
    SELECT profitability_segment, AVG(retention_probability) AS seg_avg_retention
    FROM netsuite2_customer_analytics
    GROUP BY profitability_segment
)
SELECT 
    n.customer_id,
    n.customer_name,
    n.profitability_segment,
    n.retention_probability,
    s.seg_avg_retention,
    ABS(n.retention_probability - s.seg_avg_retention) AS deviation,
    n.transaction_count,
    n.avg_transactions_per_month,
    n.transaction_value_volatility,
    n.comprehensive_customer_score,
    n.total_revenue,
    n.q1_transactions,
    n.q2_transactions,
    n.q3_transactions,
    n.q4_transactions,
    n.lifecycle_stage,
    n.seasonal_preference,
    n.transaction_consistency,
    n.growth_potential
FROM netsuite2_customer_analytics n
JOIN seg_avg s ON n.profitability_segment = s.profitability_segment
WHERE ABS(n.retention_probability - s.seg_avg_retention) > 0.15
ORDER BY deviation DESC;
", output="anomaly_customers.csv")
