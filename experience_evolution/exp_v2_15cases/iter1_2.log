import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib import cm
import warnings
warnings.filterwarnings('ignore')

# Set style
sns.set_style("whitegrid")
plt.rcParams['figure.figsize'] = (12, 8)
plt.rcParams['font.size'] = 12

# Load data with health scores (already computed)
df = pd.read_csv('campaign_health_scores.csv')
df['year_month'] = pd.to_datetime(df['year_month'])

# 1. Distribution of health scores with risk levels
plt.figure(figsize=(10, 6))
colors = {'High': 'red', 'Medium': 'orange', 'Low': 'green'}
for risk, color in colors.items():
    subset = df[df['risk_level'] == risk]
    plt.hist(subset['health_score'], bins=30, alpha=0.7, label=risk, color=color)
plt.xlabel('Health Score')
plt.ylabel('Frequency')
plt.title('Distribution of Campaign Health Scores by Risk Level')
plt.legend()
plt.tight_layout()
plt.savefig('health_score_distribution.png', dpi=300)
plt.close()

# 2. Health score breakdown by campaign type
plt.figure(figsize=(12, 6))
sns.boxplot(x='campaign_type', y='health_score', hue='risk_level', data=df, palette=colors)
plt.xlabel('Campaign Type')
plt.ylabel('Health Score')
plt.title('Health Score Distribution by Campaign Type and Risk Level')
plt.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('health_by_campaign_type.png', dpi=300)
plt.close()

# 3. Health score breakdown by bidding strategy
plt.figure(figsize=(12, 6))
sns.boxplot(x='bidding_strategy', y='health_score', hue='risk_level', data=df, palette=colors)
plt.xlabel('Bidding Strategy')
plt.ylabel('Health Score')
plt.title('Health Score Distribution by Bidding Strategy and Risk Level')
plt.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('health_by_bidding_strategy.png', dpi=300)
plt.close()

# 4. Health score breakdown by industry
plt.figure(figsize=(14, 7))
sns.boxplot(x='industry', y='health_score', hue='risk_level', data=df, palette=colors)
plt.xlabel('Industry')
plt.ylabel('Health Score')
plt.title('Health Score Distribution by Industry and Risk Level')
plt.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('health_by_industry.png', dpi=300)
plt.close()

# 5. Time series trend of average health score (monthly)
monthly_avg = df.groupby('year_month').agg({'health_score': 'mean', 'risk_level': lambda x: (x == 'High').mean() * 100}).reset_index()
monthly_avg.rename(columns={'risk_level': 'percent_high_risk'}, inplace=True)

fig, axes = plt.subplots(2, 1, figsize=(14, 10))
axes[0].plot(monthly_avg['year_month'], monthly_avg['health_score'], marker='o', linewidth=2, color='blue')
axes[0].set_xlabel('Month')
axes[0].set_ylabel('Average Health Score')
axes[0].set_title('Monthly Average Health Score Trend')
axes[0].grid(True, alpha=0.3)

axes[1].plot(monthly_avg['year_month'], monthly_avg['percent_high_risk'], marker='s', linewidth=2, color='red')
axes[1].set_xlabel('Month')
axes[1].set_ylabel('Percentage High Risk Campaigns (%)')
axes[1].set_title('Monthly High Risk Campaign Percentage Trend')
axes[1].grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('health_trends_monthly.png', dpi=300)
plt.close()

# 6. Scatter plot: cost vs ROAS colored by health score
plt.figure(figsize=(12, 8))
scatter = plt.scatter(df['cost'], df['roas'], c=df['health_score'], cmap='RdYlGn', alpha=0.7, edgecolors='k', linewidth=0.5)
plt.colorbar(scatter, label='Health Score')
plt.xlabel('Monthly Cost ($)')
plt.ylabel('ROAS')
plt.title('Cost vs ROAS Colored by Health Score')
plt.xscale('log')
plt.tight_layout()
plt.savefig('cost_vs_roas_health.png', dpi=300)
plt.close()

# 7. Correlation heatmap of health dimensions and metrics
corr_columns = ['cost_efficiency', 'conversion_quality', 'competitiveness', 'health_score', 
                'roas', 'conversion_rate', 'quality_score', 'impression_share', 'ctr', 'cost']
corr_matrix = df[corr_columns].corr()

plt.figure(figsize=(12, 10))
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', center=0, fmt='.2f', linewidths=0.5)
plt.title('Correlation Heatmap of Health Dimensions and Key Metrics')
plt.tight_layout()
plt.savefig('correlation_heatmap.png', dpi=300)
plt.close()

# 8. Risk composition by campaign type (stacked bar)
risk_by_type = pd.crosstab(df['campaign_type'], df['risk_level'], normalize='index')
risk_by_type.plot(kind='bar', stacked=True, color=[colors['High'], colors['Medium'], colors['Low']])
plt.xlabel('Campaign Type')
plt.ylabel('Proportion')
plt.title('Risk Level Composition by Campaign Type')
plt.legend(title='Risk Level')
plt.tight_layout()
plt.savefig('risk_composition_by_campaign_type.png', dpi=300)
plt.close()

print("Visualizations saved as PNG files.")
''')
