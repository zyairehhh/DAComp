Action: CreateFile(filepath='/workspace/plot5_update_frequency.py'):
```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-070/stage2_env/dacomp-070.sqlite'
conn = sqlite3.connect(db_path)

# Query monthly update events, active devices, rating per region (or overall)
query = """
SELECT strftime('%Y-%m', date_day) as month,
       SUM(update_events) as total_updates,
       AVG(active_devices_last_30_days) as avg_active_devices,
       AVG(rolling_total_average_rating) as avg_rating
FROM google_play__country_report
WHERE date_day >= '2024-04-01' AND date_day < '2024-10-01'
GROUP BY month
ORDER BY month;
"""
df = pd.read_sql_query(query, conn)
conn.close()
df['month'] = pd.to_datetime(df['month'] + '-01')

# Create subplots
fig, ax1 = plt.subplots(figsize=(10,6))
color = 'tab:blue'
ax1.set_xlabel('Month')
ax1.set_ylabel('Total Update Events', color=color)
line1 = ax1.plot(df['month'], df['total_updates'], color=color, marker='o', linewidth=2, label='Update Events')
ax1.tick_params(axis='y', labelcolor=color)
ax1.xaxis.set_major_formatter(mdates.DateFormatter('%b'))
ax1.xaxis.set_major_locator(mdates.MonthLocator())

ax2 = ax1.twinx()
color = 'tab:red'
ax2.set_ylabel('Average Active Devices (millions)', color=color)
line2 = ax2.plot(df['month'], df['avg_active_devices']/1e6, color=color, marker='s', linewidth=2, label='Active Devices')
ax2.tick_params(axis='y', labelcolor=color)

ax3 = ax1.twinx()
color = 'tab:green'
# Move third axis to the right side
ax3.spines['right'].set_position(('outward', 60))
ax3.set_ylabel('Average Rating', color=color)
line3 = ax3.plot(df['month'], df['avg_rating'], color=color, marker='^', linewidth=2, label='Rating')
ax3.tick_params(axis='y', labelcolor=color)

# Legend
lines = line1 + line2 + line3
labels = [l.get_label() for l in lines]
ax1.legend(lines, labels, loc='upper left')

plt.title('Monthly Update Frequency vs Active Devices and Rating', fontsize=16)
fig.tight_layout()
plt.savefig('update_frequency_impact.png', dpi=300)
plt.close()
```
