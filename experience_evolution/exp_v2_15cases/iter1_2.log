Action: LOCAL_DB_SQL(file_path="/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-076/stage1_env/dacomp-076.sqlite", command="WITH seg_avg AS (
    SELECT profitability_segment, AVG(retention_probability) AS seg_avg_retention
    FROM netsuite2_customer_analytics
    GROUP BY profitability_segment
),
anomaly_flag AS (
    SELECT 
        *,
        ABS(retention_probability - seg_avg_retention) AS deviation,
        CASE WHEN ABS(retention_probability - seg_avg_retention) > 0.15 THEN 1 ELSE 0 END AS is_anomaly
    FROM netsuite2_customer_analytics n
    JOIN seg_avg s ON n.profitability_segment = s.profitability_segment
)
SELECT 
    is_anomaly,
    COUNT(*) AS customer_count,
    AVG(retention_probability) AS avg_retention,
    AVG(deviation) AS avg_deviation,
    AVG(transaction_count) AS avg_transaction_count,
    AVG(avg_transactions_per_month) AS avg_trans_per_month,
    AVG(transaction_value_volatility) AS avg_volatility,
    AVG(comprehensive_customer_score) AS avg_score,
    AVG(total_revenue) AS avg_revenue,
    AVG(q1_transactions + q2_transactions + q3_transactions + q4_transactions) AS avg_total_seasonal_transactions,
    AVG(q1_transactions * 1.0 / (q1_transactions + q2_transactions + q3_transactions + q4_transactions + 0.001)) AS avg_q1_proportion,
    AVG(q2_transactions * 1.0 / (q1_transactions + q2_transactions + q3_transactions + q4_transactions + 0.001)) AS avg_q2_proportion,
    AVG(q3_transactions * 1.0 / (q1_transactions + q2_transactions + q3_transactions + q4_transactions + 0.001)) AS avg_q3_proportion,
    AVG(q4_transactions * 1.0 / (q1_transactions + q2_transactions + q3_transactions + q4_transactions + 0.001)) AS avg_q4_proportion
FROM anomaly_flag
GROUP BY is_anomaly;", output="anomaly_summary.csv")
