import pandas as pd
import sqlite3

# Use sqlite3 directly
import sqlite3
conn = sqlite3.connect('dacomp-078.sqlite')
df = pd.read_sql('SELECT * FROM pendo__account', conn)
print('Total accounts:', len(df))
# Define high-value based on top 20% of sum_minutes
threshold = df['sum_minutes'].quantile(0.8)
print('Threshold sum_minutes for top 20%:', threshold)
df['high_value'] = (df['sum_minutes'] >= threshold).astype(int)
print('High-value count:', df['high_value'].sum())

# Examine correlation between high-value and other metrics
corr_cols = ['sum_events', 'avg_nps_rating', 'count_active_days', 'count_active_months', 
             'count_feature_clicking_visitors', 'count_page_viewing_visitors', 'count_associated_visitors']
for col in corr_cols:
    corr = df['high_value'].corr(df[col])
    print(f'Correlation high_value vs {col}: {corr:.3f}')

# Compute distribution of high-value across avg_nps_rating categories
print('\nAvg NPS rating distribution among high-value:')
print(df[df['high_value']==1]['avg_nps_rating'].describe())
print('\nAvg NPS rating distribution among low-value:')
print(df[df['high_value']==0]['avg_nps_rating'].describe())

# Let's also compute a multi-dimensional score: maybe combine normalized metrics
from sklearn.preprocessing import StandardScaler
import numpy as np
scaler = StandardScaler()
features = ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors']
X = df[features].fillna(0)
X_scaled = scaler.fit_transform(X)
# Simple weighted sum
weights = [0.3, 0.2, 0.2, 0.15, 0.15]
df['multi_score'] = np.dot(X_scaled, weights)
print('\nMulti-score stats:')
print(df['multi_score'].describe())

# Compute correlation of multi_score with high_value
print('\nCorrelation multi_score vs high_value:', df['multi_score'].corr(df['high_value']))

# Check if any account with high multi_score but low sum_minutes (i.e., model improvement)
df['pred_high'] = (df['multi_score'] >= df['multi_score'].quantile(0.8)).astype(int)
from sklearn.metrics import confusion_matrix, accuracy_score
acc = accuracy_score(df['high_value'], df['pred_high'])
print('Accuracy of multi-dimensional model vs single dimension:', acc)
''')
