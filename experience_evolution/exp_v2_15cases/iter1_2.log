```python
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
import os

# Connect to the database
conn = sqlite3.connect('/workspace/dacomp-069.sqlite')

# 1. Overall performance score trend
query1 = """
SELECT date_day, overall_performance_score 
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor' 
ORDER BY date_day;
"""
df1 = pd.read_sql_query(query1, conn)
df1['date_day'] = pd.to_datetime(df1['date_day'])
df1.sort_values('date_day', inplace=True)

# Plot line chart
plt.figure(figsize=(10, 6))
plt.plot(df1['date_day'], df1['overall_performance_score'], marker='o', linewidth=2)
plt.title('Overall Performance Score Trend for com.dev.photoeditor', fontsize=14)
plt.xlabel('Month', fontsize=12)
plt.ylabel('Overall Performance Score', fontsize=12)
plt.grid(True, linestyle='--', alpha=0.6)
plt.tight_layout()
plt.savefig('/workspace/performance_score_trend.png', dpi=300)
plt.close()

# 2. Comparison of markets by revenue metric (avg_transaction_value)
# Define thresholds: high > 40, low < 10
query2 = """
SELECT 
    country,
    region,
    avg_transaction_value,
    overall_market_score,
    app_quality_score,
    day_30_retention_rate,
    daily_churn_rate,
    revenue_opportunity_score,
    weekly_growth_rate,
    market_tier
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor';
"""
df2 = pd.read_sql_query(query2, conn)

# Classify each country into high/low based on avg_transaction_value
df2['revenue_group'] = df2['avg_transaction_value'].apply(lambda x: 'High (> $40)' if x > 40 else 'Low (< $10)' if x < 10 else 'Medium')
# Focus on High and Low groups
df_group = df2[df2['revenue_group'].isin(['High (> $40)', 'Low (< $10)'])]

# Compute average metrics for each group
group_avg = df_group.groupby('revenue_group').agg({
    'overall_market_score': 'mean',
    'app_quality_score': 'mean',
    'day_30_retention_rate': 'mean',
    'daily_churn_rate': 'mean',
    'revenue_opportunity_score': 'mean',
    'weekly_growth_rate': 'mean'
}).reset_index()

# Plot grouped bar chart
metrics = ['overall_market_score', 'app_quality_score', 'day_30_retention_rate', 
           'revenue_opportunity_score', 'weekly_growth_rate']
metric_labels = ['Overall Market Score', 'App Quality Score', 'Day‑30 Retention Rate',
                 'Revenue Opportunity Score', 'Weekly Growth Rate']
x = range(len(metrics))
width = 0.35

plt.figure(figsize=(12, 6))
high_vals = group_avg[group_avg['revenue_group'] == 'High (> $40)'][metrics].values.flatten()
low_vals = group_avg[group_avg['revenue_group'] == 'Low (< $10)'][metrics].values.flatten()

plt.bar([i - width/2 for i in x], high_vals, width, label='High Revenue (avg transaction > $40)', color='steelblue')
plt.bar([i + width/2 for i in x], low_vals, width, label='Low Revenue (avg transaction < $10)', color='lightcoral')

plt.xticks(x, metric_labels, rotation=15, ha='right')
plt.ylabel('Score / Rate', fontsize=12)
plt.title('Performance Metrics: High‑ vs Low‑Revenue Markets', fontsize=14)
plt.legend()
plt.grid(axis='y', linestyle='--', alpha=0.6)
plt.tight_layout()
plt.savefig('/workspace/high_low_revenue_comparison.png', dpi=300)
plt.close()

# 3. Regional performance divergence using region aggregates
query3 = """
SELECT 
    region,
    AVG(avg_transaction_value) as avg_transaction,
    AVG(overall_market_score) as avg_market_score,
    AVG(app_quality_score) as avg_quality_score,
    AVG(day_30_retention_rate) as avg_retention,
    AVG(daily_churn_rate) as avg_churn
FROM google_play__geo_market_analysis 
WHERE package_name = 'com.dev.photoeditor'
GROUP BY region
"""
df3 = pd.read_sql_query(query3, conn)

# Bar chart per region
regions = df3['region'].tolist()
x = range(len(regions))
plt.figure(figsize=(10, 6))
plt.bar(x, df3['avg_market_score'], color='skyblue', label='Avg Market Score')
plt.xticks(x, regions, rotation=45, ha='right')
plt.ylabel('Average Score')
plt.xlabel('Region')
plt.title('Average Market Score by Region')
plt.grid(axis='y', linestyle='--', alpha=0.6)
plt.tight_layout()
plt.savefig('/workspace/region_market_score.png', dpi=300)
plt.close()

# 4. Scatter plot of avg_transaction_value vs overall_market_score, colored by region
plt.figure(figsize=(10, 6))
scatter = plt.scatter(df2['avg_transaction_value'], df2['overall_market_score'], 
                      c=pd.Categorical(df2['region']).codes, cmap='tab10', s=80, edgecolor='black')
plt.colorbar(scatter, label='Region')
for i, txt in enumerate(df2['country']):
    plt.annotate(txt, (df2['avg_transaction_value'].iloc[i], df2['overall_market_score'].iloc[i]), 
                 fontsize=8, alpha=0.7)
plt.xlabel('Average Transaction Value ($)')
plt.ylabel('Overall Market Score')
plt.title('Market Score vs Transaction Value by Country (Size indicates revenue opportunity)')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('/workspace/scatter_score_vs_transaction.png', dpi=300)
plt.close()

conn.close()
print('Plots saved to /workspace')
```
