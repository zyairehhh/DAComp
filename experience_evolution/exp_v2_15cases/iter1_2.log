import sqlite3
import pandas as pd
import numpy as np

db_path = 'dacomp-098.sqlite'
conn = sqlite3.connect(db_path)

# Load data
query = """
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.conversation_initiated_type,
    ce.all_conversation_tags,
    ce.all_conversation_contacts as contact_id,
    cm.first_admin_response_at,
    cm.time_to_first_response_minutes
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
 ON ce.conversation_id = cm.conversation_id
"""
df = pd.read_sql_query(query, conn)

def parse_tags(tag_str):
    if not tag_str:
        return {}
    tags = {}
    for pair in tag_str.split('|'):
        if ':' in pair:
            key, value = pair.split(':', 1)
            tags[key.strip()] = value.strip()
    return tags

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['path'] = df['tags_dict'].apply(lambda d: d.get('path', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['topic'] = df['tags_dict'].apply(lambda d: d.get('topic', ''))
df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))

# Convert datetimes
df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
df['first_admin_response_at'] = pd.to_datetime(df['first_admin_response_at'])
df['response_time_minutes'] = (df['first_admin_response_at'] - df['conversation_created_at']).dt.total_seconds() / 60

# Compute conversation-level conversion rates
print("# Conversion Rates per Path (Conversation Level)")
for path_type in ['human_first', 'bot_first']:
    sub = df[df['conversation_initiated_type']==path_type]
    total = sub.shape[0]
    demo = sub[sub['stage']=='demo_booked'].shape[0]
    trial = sub[sub['stage']=='trial_activated'].shape[0]
    won = sub[sub['stage']=='closed_won'].shape[0]
    print(f"\n**{path_type}** (n={total})")
    print(f"- Demo booked: {demo} ({demo/total*100:.1f}%)")
    print(f"- Trial activated: {trial} ({trial/total*100:.1f}%)")
    print(f"- Closed won: {won} ({won/total*100:.1f}%)")
    print(f"- Avg response time (minutes): {sub['response_time_minutes'].mean():.2f}")

print("\n# Conversion Rates per Segment (Startup only)")
sub = df[df['segment']=='Startup']
human = sub[sub['conversation_initiated_type']=='human_first']
bot = sub[sub['conversation_initiated_type']=='bot_first']
print(f"Human-first demo: {human[human['stage']=='demo_booked'].shape[0]}/{human.shape[0]} ({human[human['stage']=='demo_booked'].shape[0]/human.shape[0]*100:.1f}%)")
print(f"Bot-first demo: {bot[bot['stage']=='demo_booked'].shape[0]}/{bot.shape[0]} ({bot[bot['stage']=='demo_booked'].shape[0]/bot.shape[0]*100:.1f}%)")

print("\n# Regional Variation (Demo Booked Rate)")
for reg in df['region'].unique():
    if reg:
        sub = df[df['region']==reg]
        total = sub.shape[0]
        if total < 500:
            continue
        human = sub[sub['conversation_initiated_type']=='human_first']
        bot = sub[sub['conversation_initiated_type']=='bot_first']
        human_demo = human[human['stage']=='demo_booked'].shape[0]
        bot_demo = bot[bot['stage']=='demo_booked'].shape[0]
        print(f"**{reg}**")
        print(f"  Human-first: {human_demo}/{human.shape[0]} ({human_demo/human.shape[0]*100 if human.shape[0] else 0:.1f}%)")
        print(f"  Bot-first: {bot_demo}/{bot.shape[0]} ({bot_demo/bot.shape[0]*100 if bot.shape[0] else 0:.1f}%)")

print("\n# Intent Analysis (Demo Booked Rate)")
for intent in ['pricing', 'billing']:
    sub = df[df['intent']==intent]
    human = sub[sub['conversation_initiated_type']=='human_first']
    bot = sub[sub['conversation_initiated_type']=='bot_first']
    human_demo = human[human['stage']=='demo_booked'].shape[0]
    bot_demo = bot[bot['stage']=='demo_booked'].shape[0]
    print(f"**{intent}**")
    print(f"  Human-first: {human_demo}/{human.shape[0]} ({human_demo/human.shape[0]*100 if human.shape[0] else 0:.1f}%)")
    print(f"  Bot-first: {bot_demo}/{bot.shape[0]} ({bot_demo/bot.shape[0]*100 if bot.shape[0] else 0:.1f}%)")

# Compute stage durations (contact-level)
print("\n# Stage Durations (Days Between Events)")

# Load transition data from earlier analysis (re-run)
query2 = """
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.all_conversation_tags,
    ce.all_conversation_contacts as contact_id
FROM intercom__conversation_enhanced ce
ORDER BY contact_id, conversation_created_at
"""
df2 = pd.read_sql_query(query2, conn)
df2['tags_dict'] = df2['all_conversation_tags'].apply(parse_tags)
df2['stage'] = df2['tags_dict'].apply(lambda d: d.get('stage', ''))
df2['path'] = df2['tags_dict'].apply(lambda d: d.get('path', ''))
df2['conversation_created_at'] = pd.to_datetime(df2['conversation_created_at'])

transition_data = []
for contact, group in df2.groupby('contact_id'):
    group = group.sort_values('conversation_created_at')
    stages = group['stage'].tolist()
    created = group['conversation_created_at'].tolist()
    path = group['path'].iloc[0] if not group['path'].isna().all() else ''
    demo_indices = [i for i, s in enumerate(stages) if s == 'demo_booked']
    for i in demo_indices:
        for j in range(i+1, len(stages)):
            if stages[j] == 'trial_activated':
                days = (created[j] - created[i]).total_seconds() / (24*3600)
                transition_data.append({
                    'path': path,
                    'from': 'demo_booked',
                    'to': 'trial_activated',
                    'days': days
                })
                break
        for j in range(i+1, len(stages)):
            if stages[j] == 'closed_won':
                days = (created[j] - created[i]).total_seconds() / (24*3600)
                transition_data.append({
                    'path': path,
                    'from': 'demo_booked',
                    'to': 'closed_won',
                    'days': days
                })
                break
    trial_indices = [i for i, s in enumerate(stages) if s == 'trial_activated']
    for i in trial_indices:
        for j in range(i+1, len(stages)):
            if stages[j] == 'closed_won':
                days = (created[j] - created[i]).total_seconds() / (24*3600)
                transition_data.append({
                    'path': path,
                    'from': 'trial_activated',
                    'to': 'closed_won',
                    'days': days
                })
                break

if transition_data:
    trans_df = pd.DataFrame(transition_data)
    for path in ['human_first', 'bot_first']:
        print(f"\n**{path}**")
        for from_to in [('demo_booked','trial_activated'), ('demo_booked','closed_won'), ('trial_activated','closed_won')]:
            sub = trans_df[(trans_df['path']==path) & (trans_df['from']==from_to[0]) & (trans_df['to']==from_to[1])]
            if sub.shape[0] > 0:
                avg_days = sub['days'].mean()
                count = sub.shape[0]
                print(f"  {from_to[0]} → {from_to[1]}: {avg_days:.1f} days (n={count})")
            else:
                print(f"  {from_to[0]} → {from_to[1]}: insufficient data")
else:
    print("No transition data.")

conn.close()
```
