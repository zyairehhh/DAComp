import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-066.sqlite')
query = """
SELECT 
    e.overall_conversion_rate,
    e.count_total_interviews,
    e.avg_job_rating,
    e.application_to_interview_rate,
    e.interview_to_hire_rate,
    r.total_applications,
    r.total_interviews,
    r.avg_interview_score,
    r.avg_process_days,
    e.departments
FROM greenhouse__job_enhanced e
JOIN greenhouse__recruitment_performance r ON e.job_id = r.job_id
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Filter engineering only
eng_df = df[df['departments'] == 'Engineering'].copy()
print("Engineering rows:", len(eng_df))

# Select numeric columns for correlation
numeric_cols = ['overall_conversion_rate', 'count_total_interviews', 'avg_job_rating', 
                'application_to_interview_rate', 'interview_to_hire_rate',
                'total_applications', 'total_interviews', 'avg_interview_score', 
                'avg_process_days']

corr = eng_df[numeric_cols].corr()

print("Correlation matrix for Engineering metrics:")
print(corr)

# Save correlation matrix as text
corr.to_csv('engineering_correlation_matrix.csv')
print("Saved correlation matrix to engineering_correlation_matrix.csv")

# Plot scatter: overall_conversion_rate vs count_total_interviews, colored by avg_job_rating
plt.figure(figsize=(10,6))
scatter = plt.scatter(eng_df['count_total_interviews'], eng_df['overall_conversion_rate'], 
                      c=eng_df['avg_job_rating'], cmap='viridis', alpha=0.7)
plt.colorbar(scatter, label='Avg Job Rating')
plt.title('Engineering: Overall Conversion Rate vs Total Interviews (colored by Job Rating)')
plt.xlabel('Total Interviews per Job')
plt.ylabel('Overall Conversion Rate')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('conversion_vs_interviews_rating.png')
plt.close()

# Bar chart showing correlation coefficients with overall_conversion_rate
corr_with_conversion = corr['overall_conversion_rate'].drop('overall_conversion_rate')
corr_with_conversion = corr_with_conversion.sort_values(key=abs, ascending=False)

plt.figure(figsize=(10,6))
bars = plt.bar(corr_with_conversion.index, corr_with_conversion.values, color='steelblue')
plt.axhline(y=0, color='black', linestyle='-', alpha=0.3)
plt.title('Correlation of Metrics with Overall Conversion Rate (Engineering)')
plt.xlabel('Metric')
plt.ylabel('Correlation Coefficient')
plt.xticks(rotation=45, ha='right')
# Add value labels
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height,
             f'{height:.2f}', ha='center', va='bottom' if height >=0 else 'top')
plt.tight_layout()
plt.savefig('correlation_with_conversion_rate.png')
plt.close()

print("Correlation coefficients:")
print(corr_with_conversion)
''')
