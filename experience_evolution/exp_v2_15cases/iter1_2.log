print("\nTop 20 Models by Average Used Price (yuan):")
print(model_price.head(20))

# For buyback recommendations, we may want models with high depreciation ratio AND reasonable age/mileage.
# Compute a combined score: maybe ratio adjusted for age and mileage.
# We can compute a simple metric: Depreciation ratio per year (ratio / age)
df_clean['Ratio_per_year'] = df_clean['Depreciation_Ratio'] / df_clean['Age_years']
# Higher ratio per year indicates better value retention over time.

# Filter for cars less than 5 years old and less than 100,000 km
