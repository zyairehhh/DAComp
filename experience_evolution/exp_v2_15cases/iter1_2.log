import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversations
conv_query = """
    SELECT company_id,
           all_conversation_tags,
           conversation_created_at,
           conversation_last_updated_at
    FROM intercom__conversation_enhanced
    WHERE company_id IS NOT NULL AND company_id != ''
"""
conv_df = pd.read_sql_query(conv_query, conn)

# Parse tags
def extract_tag(tags, key):
    if not isinstance(tags, str):
        return None
    start = tags.find(key + ':')
    if start == -1:
        return None
    start += len(key) + 1
    end = tags.find('|', start)
    if end == -1:
        return tags[start:]
    else:
        return tags[start:end]

conv_df['path'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'path'))
conv_df['intent'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent'))
conv_df['stage'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage'))

# Identify responder group per company: bot-led if any conversation path='bot_first'
company_first_response = conv_df.groupby('company_id')['path'].apply(lambda x: 'bot' if (x == 'bot_first').any() else ('human' if (x == 'human_first').any() else None)).reset_index()
company_first_response = company_first_response.dropna()
company_first_response.columns = ['company_id', 'responder_group']

# Get stage timestamps per company
# We'll assume the latest conversation with each stage tag as the timestamp for that stage
# Actually we need timestamps for demo_booked, trial_activated, closed_won
# For simplicity, we'll take the max conversation_last_updated_at where stage contains the keyword.
def get_stage_timestamp(df, stage_keyword):
    stage_rows = df[df['stage'].notna() & df['stage'].str.contains(stage_keyword)]
    if stage_rows.empty:
        return None
    # take earliest timestamp? stage1 used first_response_at etc. We'll use conversation_created_at as proxy.
    # Use min conversation_created_at for that stage.
    return stage_rows['conversation_created_at'].min()

company_stages = conv_df.groupby('company_id').apply(lambda grp: pd.Series({
    'demo_booked_at': get_stage_timestamp(grp, 'demo_booked'),
    'trial_activated_at': get_stage_timestamp(grp, 'trial_activated'),
    'closed_won_at': get_stage_timestamp(grp, 'closed_won')
})).reset_index()

# Merge responder group
company_data = pd.merge(company_first_response, company_stages, on='company_id', how='left')

# Determine conversion flags
company_data['has_demo'] = company_data['demo_booked_at'].notna()
company_data['has_trial'] = company_data['trial_activated_at'].notna()
company_data['has_paid'] = company_data['closed_won_at'].notna()

# Compute conversion rates per responder group
group_stats = company_data.groupby('responder_group').agg(
    total_companies=('company_id', 'count'),
    demo_count=('has_demo', 'sum'),
    trial_count=('has_trial', 'sum'),
    paid_count=('has_paid', 'sum')
).reset_index()

group_stats['demo_rate'] = group_stats['demo_count'] / group_stats['total_companies']
group_stats['trial_rate_given_demo'] = group_stats['trial_count'] / group_stats['demo_count']
group_stats['paid_rate_given_trial'] = group_stats['paid_count'] / group_stats['trial_count']

print("Conversion rates:")
print(group_stats.to_string())

# Plot conversion rates
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Bar chart: demo_rate, trial_rate_given_demo, paid_rate_given_trial
x = np.arange(len(group_stats))
width = 0.25
axes[0,0].bar(x - width, group_stats['demo_rate'], width, label='Demo Rate', color='skyblue')
axes[0,0].bar(x, group_stats['trial_rate_given_demo'], width, label='Trial Rate (given demo)', color='lightgreen')
axes[0,0].bar(x + width, group_stats['paid_rate_given_trial'], width, label='Paid Rate (given trial)', color='salmon')
axes[0,0].set_xticks(x)
axes[0,0].set_xticklabels(group_stats['responder_group'])
axes[0,0].set_ylabel('Rate')
axes[0,0].set_title('Conversion Rates by Responder Group')
axes[0,0].legend()
axes[0,0].grid(axis='y', linestyle='--', alpha=0.7)

# Count of companies
axes[0,1].bar(group_stats['responder_group'], group_stats['total_companies'], color='teal')
axes[0,1].set_ylabel('Number of Companies')
axes[0,1].set_title('Company Count by Responder Group')
axes[0,1].grid(axis='y', linestyle='--', alpha=0.7)

# Intent distribution
intent_counts = conv_df[conv_df['intent'].notna()].groupby(['path', 'intent']).size().unstack(fill_value=0)
# Sum across paths
intent_totals = intent_counts.sum(axis=0).sort_values(ascending=False)
top_intents = intent_totals.head(8).index.tolist()
intent_subset = intent_counts[top_intents]

axes[1,0].bar(intent_subset.index, intent_subset.get('pricing', 0), label='pricing', color='orange')
axes[1,0].bar(intent_subset.index, intent_subset.get('billing', 0), bottom=intent_subset.get('pricing', 0), label='billing', color='red')
# For other intents, stack
bottom = np.zeros(len(intent_subset))
for intent in top_intents:
    if intent not in ['pricing', 'billing']:
        axes[1,0].bar(intent_subset.index, intent_subset.get(intent, 0), bottom=bottom, label=intent)
        bottom += intent_subset.get(intent, 0).values
axes[1,0].set_xlabel('Responder Group')
axes[1,0].set_ylabel('Conversation Count')
axes[1,0].set_title('Top Intents by Responder Group')
axes[1,0].legend(loc='upper left', fontsize=8)
axes[1,0].tick_params(axis='x', rotation=45)

# Stage durations (simplified)
# Compute average days between stages per responder group
# We'll need first_response_at from conversation? Use conversation_created_at as proxy.
# For each company, compute time differences between timestamps.
# We'll align with Stage1: time from first response to demo, demo to trial, trial to paid.
# Since we don't have first_response_at, we'll skip for now.
# Instead plot count of each stage per responder group
stage_counts = conv_df[conv_df['stage'].notna()].groupby(['path', 'stage']).size().unstack(fill_value=0)
common_stages = ['demo_booked', 'trial_activated', 'closed_won', 'closed_lost', 'proposal_sent']
stage_subset = stage_counts[common_stages]
stage_subset.plot(kind='bar', ax=axes[1,1], stacked=True)
axes[1,1].set_xlabel('Responder Group')
axes[1,1].set_ylabel('Count')
axes[1,1].set_title('Conversation Stages by Responder Group')
axes[1,1].legend(title='Stage', loc='upper left', fontsize=8)
axes[1,1].tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.savefig('conversion_summary.png', dpi=300)
print("Saved conversion_summary.png")

# Second figure: Intent distribution bar chart (more detailed)
fig2, ax2 = plt.subplots(figsize=(10,6))
intent_agg = conv_df[conv_df['intent'].notna()].groupby('intent').size().sort_values(ascending=False)
intent_agg.plot(kind='bar', ax=ax2, color='steelblue')
ax2.set_xlabel('Intent')
ax2.set_ylabel('Conversation Count')
ax2.set_title('Overall Intent Distribution')
ax2.tick_params(axis='x', rotation=45)
plt.tight_layout()
plt.savefig('intent_distribution.png', dpi=300)
print("Saved intent_distribution.png")

# Third figure: Funnel velocity (stage durations) from Stage1 report (hardcoded)
stage_durations = pd.DataFrame({
    'stage': ['demo_booked', 'trial_activated', 'closed_won'],
    'bot_days': [0.090476, 0.087945, 0.093916],
    'human_days': [0.14375, 0.109954, 0.163194]
})
fig3, ax3 = plt.subplots(figsize=(8,5))
x = np.arange(len(stage_durations))
width = 0.35
ax3.bar(x - width/2, stage_durations['bot_days'], width, label='Bot-led', color='lightblue')
ax3.bar(x + width/2, stage_durations['human_days'], width, label='Human-led', color='orange')
ax3.set_xticks(x)
ax3.set_xticklabels(stage_durations['stage'])
ax3.set_ylabel('Average Days')
ax3.set_title('Average Time from First Response to Stage Close')
ax3.legend()
ax3.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('stage_durations.png', dpi=300)
print("Saved stage_durations.png")

# Fourth figure: Inter-stage durations
inter_stage = pd.DataFrame({
    'responder_group': ['bot', 'human'],
    'demo_to_trial': [2.608803, 23.271528],
    'trial_to_paid': [-2.722305, np.nan]
})
fig4, ax4 = plt.subplots(figsize=(7,5))
x = np.arange(len(inter_stage))
width = 0.3
ax4.bar(x - width/2, inter_stage['demo_to_trial'], width, label='Demo → Trial', color='lightgreen')
ax4.bar(x + width/2, inter_stage['trial_to_paid'], width, label='Trial → Paid', color='salmon')
ax4.set_xticks(x)
ax4.set_xticklabels(inter_stage['responder_group'])
ax4.set_ylabel('Average Days')
ax4.set_title('Average Inter-Stage Durations')
ax4.legend()
ax4.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('inter_stage_durations.png', dpi=300)
print("Saved inter_stage_durations.png")

print("Visualization generation complete.")
conn.close()
```

