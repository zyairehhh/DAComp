import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# Load previously saved data
region_monthly = pd.read_csv('region_monthly.csv')
device_monthly = pd.read_csv('device_monthly.csv')
conversion_quality = pd.read_csv('conversion_quality.csv')

print("=== Decay Patterns of User Acquisition Cost-Efficiency ===")
print("\nRegion-level conversion rate trend slopes (monthly change):")
for region in region_monthly['region'].unique():
    sub = region_monthly[region_monthly['region'] == region]
    if len(sub) > 1:
        slope = np.polyfit(sub['months_since_start'], sub['avg_conversion_rate'], 1)[0]
        print(f"  {region}: {slope:.6f}")

print("\nDevice-level active devices trend slopes (monthly change, negative indicates decay):")
device_slopes = []
for device in device_monthly['device'].unique():
    sub = device_monthly[device_monthly['device'] == device]
    if len(sub) > 1:
        slope = np.polyfit(sub['months_since_start'], sub['total_active_devices'], 1)[0]
        device_slopes.append((device, slope))
device_slopes.sort(key=lambda x: x[1])
for device, slope in device_slopes:
    print(f"  {device}: {slope:,.0f}")

print("\n=== Non-linear Relationship: Conversion Rate vs Quality & Crash Rate ===")
# Calculate correlation
corr_quality = conversion_quality['conversion_rate'].corr(conversion_quality['quality_score'])
corr_crash = conversion_quality['conversion_rate'].corr(conversion_quality['crash_rate_per_1k'])
print(f"Pearson correlation between conversion_rate and quality_score: {corr_quality:.4f}")
print(f"Pearson correlation between conversion_rate and crash_rate_per_1k: {corr_crash:.4f}")

# Fit polynomial (quadratic) relationships
# For quality_score
X_q = conversion_quality['quality_score'].values
y = conversion_quality['conversion_rate'].values
# Remove NaNs
mask = ~np.isnan(X_q) & ~np.isnan(y)
X_q = X_q[mask]
y = y[mask]
if len(X_q) > 10:
    coeff_q = np.polyfit(X_q, y, 2)
    print(f"Quadratic fit: conversion_rate = {coeff_q[0]:.4f}*quality^2 + {coeff_q[1]:.4f}*quality + {coeff_q[2]:.4f}")
    # Evaluate at typical quality values
    qual_range = np.linspace(X_q.min(), X_q.max(), 5)
    pred = np.polyval(coeff_q, qual_range)
    print("  Sample predictions:", list(zip(np.round(qual_range,2), np.round(pred,5))))

# For crash_rate_per_1k
X_c = conversion_quality['crash_rate_per_1k'].values
mask = ~np.isnan(X_c) & ~np.isnan(y)
X_c = X_c[mask]
y_c = y[mask]
if len(X_c) > 10:
    coeff_c = np.polyfit(X_c, y_c, 2)
    print(f"Quadratic fit: conversion_rate = {coeff_c[0]:.4f}*crash^2 + {coeff_c[1]:.4f}*crash + {coeff_c[2]:.4f}")
    crash_range = np.linspace(X_c.min(), X_c.max(), 5)
    pred_c = np.polyval(coeff_c, crash_range)
    print("  Sample predictions:", list(zip(np.round(crash_range,2), np.round(pred_c,5))))

print("\n=== Multi-dimensional User Value Decay Model ===")
# Let's define user value as revenue per active device (RPA)
# We'll create a dataset with features: region, device, quality_score, crash_rate, conversion_rate, update_frequency, market maturity
# Build a simple linear regression to see drivers of RPA.

# Need to aggregate data at region-device-month level.
# We'll load original tables again, but we can compute from joined data.
# Let's load update events from country_report and device_report.
import sqlite3
conn = sqlite3.connect('dacomp-070.sqlite')

# Get update events per region per month
update_region = pd.read_sql_query("""
    SELECT region, date_day, SUM(update_events) as total_updates
    FROM google_play__country_report
    GROUP BY region, date_day
""", conn)
update_region['date_day'] = pd.to_datetime(update_region['date_day'])
update_region['month'] = update_region['date_day'].dt.to_period('M')
update_region_monthly = update_region.groupby(['region', 'month']).agg({'total_updates': 'sum'}).reset_index()

# Get update events per device per month
update_device = pd.read_sql_query("""
    SELECT device, date_day, SUM(update_events) as total_updates
    FROM google_play__device_report
    GROUP BY device, date_day
""", conn)
update_device['date_day'] = pd.to_datetime(update_device['date_day'])
update_device['month'] = update_device['date_day'].dt.to_period('M')
update_device_monthly = update_device.groupby(['device', 'month']).agg({'total_updates': 'sum'}).reset_index()

# Merge with region_monthly and device_monthly
region_monthly = region_monthly.merge(update_region_monthly, on=['region', 'month'], how='left')
device_monthly = device_monthly.merge(update_device_monthly, on=['device', 'month'], how='left')

# Compute update frequency as updates per active device
region_monthly['updates_per_device'] = region_monthly['total_updates'] / region_monthly['total_active_devices'].replace(0, np.nan)
device_monthly['updates_per_device'] = device_monthly['total_updates'] / device_monthly['total_active_devices'].replace(0, np.nan)

# Compute market maturity: classify region by total_active_devices growth over time.
# We'll define maturity as slope of active devices over months (negative slope -> mature/declining?)
region_maturity = {}
for region, group in region_monthly.groupby('region'):
    if len(group) > 1:
        slope = np.polyfit(group['months_since_start'], group['total_active_devices'], 1)[0]
        region_maturity[region] = slope

print("Region maturity (slope of active devices):")
for region, slope in region_maturity.items():
    print(f"  {region}: {slope:,.0f}")

# Classify as mature (slope <= -1000) vs growing (slope > -1000)
region_monthly['maturity'] = region_monthly['region'].map(lambda r: 'Mature' if region_maturity.get(r, 0) <= -1000 else 'Growing')

# Now we need revenue per active device per region-month? Not directly available.
# Instead we can use conversion_quality which has revenue_per_active_device per region per day.
# Aggregate by region-month
if 'revenue_per_active_device' in conversion_quality.columns:
    conversion_quality['date_day'] = pd.to_datetime(conversion_quality['date_day'])
    conversion_quality['month'] = conversion_quality['date_day'].dt.to_period('M')
    revenue_region = conversion_quality.groupby(['region', 'month']).agg({
        'revenue_per_active_device': 'mean',
        'quality_score': 'mean',
        'crash_rate_per_1k': 'mean',
        'conversion_rate': 'mean'
    }).reset_index()
    # Merge with region_monthly
    region_monthly = region_monthly.merge(revenue_region, on=['region', 'month'], how='left')
    print("\nRevenue per active device by region (sample):")
    print(region_monthly[['region', 'month', 'revenue_per_active_device']].head())

# Build simple multivariate regression for revenue per active device
# Use only rows with no missing values
regression_df = region_monthly[['revenue_per_active_device', 'avg_conversion_rate', 'avg_rating', 'updates_per_device', 'quality_score', 'crash_rate_per_1k']].dropna()
if len(regression_df) > 10:
    X = regression_df[['avg_conversion_rate', 'avg_rating', 'updates_per_device', 'quality_score', 'crash_rate_per_1k']]
    y = regression_df['revenue_per_active_device']
    # Add constant
    X = np.column_stack([np.ones(len(X)), X])
    coeff = np.linalg.lstsq(X, y, rcond=None)[0]
    print("\nRegression coefficients for revenue per active device:")
    predictors = ['Intercept', 'ConversionRate', 'AvgRating', 'UpdatesPerDevice', 'QualityScore', 'CrashRate']
    for name, val in zip(predictors, coeff):
        print(f"  {name}: {val:.6f}")

print("\n=== Interaction Effect of Update Frequency on Active Devices & Rating ===")
# Compute correlation between updates_per_device and active_devices growth, and rating
device_corr_active = device_monthly['updates_per_device'].corr(device_monthly['total_active_devices'])
device_corr_rating = device_monthly['updates_per_device'].corr(device_monthly['avg_rating'])
print(f"Device-level correlation updates_per_device vs total_active_devices: {device_corr_active:.4f}")
print(f"Device-level correlation updates_per_device vs avg_rating: {device_corr_rating:.4f}")

region_corr_active = region_monthly['updates_per_device'].corr(region_monthly['total_active_devices'])
region_corr_rating = region_monthly['updates_per_device'].corr(region_monthly['avg_rating'])
print(f"Region-level correlation updates_per_device vs total_active_devices: {region_corr_active:.4f}")
print(f"Region-level correlation updates_per_device vs avg_rating: {region_corr_rating:.4f}")

# Compute interaction effect by grouping high vs low update frequency
device_monthly['update_quartile'] = pd.qcut(device_monthly['updates_per_device'], q=4, labels=['Q1','Q2','Q3','Q4'])
group_effect = device_monthly.groupby('update_quartile').agg({
    'total_active_devices': 'mean',
    'avg_rating': 'mean'
})
print("\nDevice-level average active devices and rating by update frequency quartile:")
print(group_effect)

region_monthly['update_quartile'] = pd.qcut(region_monthly['updates_per_device'], q=4, labels=['Q1','Q2','Q3','Q4'])
group_effect_r = region_monthly.groupby('update_quartile').agg({
    'total_active_devices': 'mean',
    'avg_rating': 'mean'
})
print("\nRegion-level average active devices and rating by update frequency quartile:")
print(group_effect_r)

conn.close()

print("\n=== Summary Insights ===")
