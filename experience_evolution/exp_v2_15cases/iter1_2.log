Action: Bash(code="cat > /workspace/compute_metrics.sql << 'EOF'
WITH dept_users AS (
    SELECT Department, COUNT(DISTINCT "User ID") as total_users
    FROM user_information_table
    WHERE Department IS NOT NULL
    GROUP BY Department
),
dept_abnormal AS (
    SELECT ui.Department, COUNT(*) as abnormal_count
    FROM abnormal_logins_table al
    LEFT JOIN login_records_table lr ON al.\"Login Record ID\" = lr.\"Login Record ID\"
    LEFT JOIN user_information_table ui ON lr.\"User ID\" = ui.\"User ID\"
    WHERE ui.Department IS NOT NULL
    GROUP BY ui.Department
)
SELECT d.Department, 
       d.total_users, 
       COALESCE(a.abnormal_count, 0) as abnormal_count,
       ROUND(CAST(COALESCE(a.abnormal_count, 0) AS FLOAT) / d.total_users, 2) as abnormal_per_user
FROM dept_users d
LEFT JOIN dept_abnormal a ON d.Department = a.Department
ORDER BY abnormal_per_user DESC;
EOF")
