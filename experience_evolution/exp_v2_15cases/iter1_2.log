plt.savefig(f'{plot_dir}/risk_weighted_index.png', dpi=300, bbox_inches='tight')
plt.close()

# 4. Anomaly Type Distribution by Department (Stacked Bar Chart)
# Prepare anomaly type data
anomaly_types_list = ['Device anomaly', 'Multiple IPs in short time', 'Frequent login', 'Remote Login']
type_data = []

for dept in departments:
    dept_metrics = next(m for m in metrics if m['Department'] == dept)
    type_row = []
    for anomaly_type in anomaly_types_list:
        type_row.append(dept_metrics['Anomaly_Types'].get(anomaly_type, 0) * 100)  # Convert to percentage
    type_data.append(type_row)

type_data = np.array(type_data)

plt.figure(figsize=(12, 7))
bottom = np.zeros(len(short_departments))
colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFE66D']

for i, anomaly_type in enumerate(anomaly_types_list):
    plt.bar(short_departments, type_data[:, i], bottom=bottom, label=anomaly_type, color=colors[i], edgecolor='white')
    bottom += type_data[:, i]

plt.title('Anomaly Type Distribution by Department', fontsize=14, fontweight='bold')
plt.xlabel('Department', fontsize=12)
plt.ylabel('Percentage of Abnormal Logins (%)', fontsize=12)
plt.legend(title='Anomaly Type', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(axis='y', alpha=0.3)

# Add percentage labels
for i, dept in enumerate(short_departments):
    bottom_val = 0
    for j in range(len(anomaly_types_list)):
        if type_data[i, j] > 5:  # Only label if >5% for readability
            plt.text(i, bottom_val + type_data[i, j]/2, f'{type_data[i, j]:.1f}%', 
                    ha='center', va='center', color='black', fontsize=9)
        bottom_val += type_data[i, j]

plt.tight_layout()
plt.savefig(f'{plot_dir}/anomaly_type_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# 5. Total Abnormal Logins vs Employees (Bubble Chart)
plt.figure(figsize=(10, 6))
for i, row in metrics_df.iterrows():
    plt.scatter(row['Employees'], row['Total_Abnormal'], 
                s=row['High_Severe_per_Employee'] * 1500,  # Bubble size based on critical risk
                alpha=0.6, label=row['Dept_Short'])
    
# Add labels and connection line to origin for visual reference
plt.plot([0, max(metrics_df['Employees']) * 1.1], [0, max(metrics_df['Total_Abnormal']) * 1.1], 
        'k--', alpha=0.3, label='Linear Reference')

plt.title('Total Abnormal Logins vs Employees', fontsize=14, fontweight='bold')
plt.xlabel('Number of Employees', fontsize=12)
plt.ylabel('Total Abnormal Logins', fontsize=12)
plt.legend(title='Department')
plt.grid(True, alpha=0.3)

# Add department labels next to bubbles
for i, row in metrics_df.iterrows():
    plt.annotate(row['Dept_Short'], 
                (row['Employees'], row['Total_Abnormal']),
                xytext=(5, 5), textcoords='offset points',
                fontsize=10, fontweight='bold')

plt.tight_layout()
plt.savefig(f'{plot_dir}/abnormal_vs_employees.png', dpi=300, bbox_inches='tight')
plt.close()

print(f"Plots saved to {plot_dir}")
