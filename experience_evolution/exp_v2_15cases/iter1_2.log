human_intents = intent_summary[intent_summary['responder_category']=='human'].sort_values('demo_rate', ascending=False)
print(human_intents.head(10))

# Template analysis
template_summary = df_main.groupby(['conversation_template_id', 'responder_category']).agg(
    total=('conversation_id', 'count'),
    demo_booked=('demo_booked', 'sum'),
    trial_activated=('trial_activated', 'sum'),
    paid=('paid', 'sum')
).reset_index()
template_summary['demo_rate'] = template_summary['demo_booked'] / template_summary['total'] * 100
template_summary['trial_rate_given_demo'] = template_summary['trial_activated'] / template_summary['demo_booked'].replace(0, np.nan) * 100
template_summary['paid_rate_given_trial'] = template_summary['paid'] / template_summary['trial_activated'].replace(0, np.nan) * 100

print("\n=== Top Templates by Demo Rate for Bot ===")
bot_templates = template_summary[template_summary['responder_category']=='bot'].sort_values('demo_rate', ascending=False)
print(bot_templates.head(10))

print("\n=== Top Templates by Demo Rate for Human ===")
human_templates = template_summary[template_summary['responder_category']=='human'].sort_values('demo_rate', ascending=False)
print(human_templates.head(10))

# Save key tables to CSV for reference
intent_summary.to_csv('/workspace/intent_summary.csv', index=False)
template_summary.to_csv('/workspace/template_summary.csv', index=False)
print("\nSaved intent_summary.csv and template_summary.csv")
```



