# merge to get account_id
daily_df = daily_df.merge(visitor_df, on='visitor_id', how='left')
# define cutoff
cutoff = pd.Timestamp('2024-07-01')
# aggregate per account: pre-cutoff features
pre = daily_df[daily_df['date_day'] < cutoff]
pre_agg = pre.groupby('account_id').agg(
    pre_sum_minutes=('sum_minutes', 'sum'),
    pre_sum_events=('sum_events', 'sum'),
    pre_count_days=('date_day', 'nunique'),
    pre_count_pages_viewed=('count_pages_viewed', 'sum'),
    pre_count_features_clicked=('count_features_clicked', 'sum')
).reset_index()
# aggregate post-cutoff (future)
post = daily_df[daily_df['date_day'] >= cutoff]
post_agg = post.groupby('account_id').agg(
    post_sum_minutes=('sum_minutes', 'sum'),
    post_sum_events=('sum_events', 'sum'),
    post_count_days=('date_day', 'nunique'),
    post_count_pages_viewed=('count_pages_viewed', 'sum'),
    post_count_features_clicked=('count_features_clicked', 'sum')
).reset_index()
# merge with account
df = account_df.merge(pre_agg, left_on='account_id', right_on='account_id', how='left')
df = df.merge(post_agg, on='account_id', how='left')
# fill NaNs with 0
