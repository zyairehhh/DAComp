Create a script to compute per role change between quarters.

Action: CreateFile(filepath='role_decline.py':
'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-066.sqlite')
query = """
SELECT 
    r.job_title,
    e.departments,
    r.application_year,
    r.application_quarter,
    r.total_applications,
    r.total_interviews,
    r.interview_rate,
    e.overall_conversion_rate
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced e ON r.job_id = e.job_id
WHERE e.departments = 'Engineering' AND r.total_applications > 0
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Extract role from job_title
def extract_role(title):
    lower = title.lower()
    if 'frontend' in lower:
        return 'Frontend'
    elif 'backend' in lower:
        return 'Backend'
    elif 'data' in lower or 'analytics' in lower:
        return 'Data Engineer'
    elif 'mobile' in lower:
        return 'Mobile Engineer'
    elif 'devops' in lower or 'sre' in lower:
        return 'DevOps/SRE'
    elif 'qa' in lower or 'quality' in lower:
        return 'QA Engineer'
    elif 'full stack' in lower:
        return 'Full Stack'
    elif 'engineer' in lower:
        return 'Other Engineer'
    else:
        return 'Other'

df['role'] = df['job_title'].apply(extract_role)

# Compute conversion rate
df['calc_rate'] = df['total_interviews'] / df['total_applications']

# Aggregate per role per quarter
group = df.groupby(['role', 'application_quarter']).agg(
    total_applications=('total_applications', 'sum'),
    total_interviews=('total_interviews', 'sum'),
    avg_interview_rate=('interview_rate', 'mean'),
    avg_overall_conversion=('overall_conversion_rate', 'mean')
).reset_index()
group['conv_rate'] = group['total_interviews'] / group['total_applications']

# Pivot to see change
pivot = group.pivot(index='role', columns='application_quarter', values='conv_rate')
pivot['change'] = pivot[4] - pivot[3]  # Q4 - Q3
pivot = pivot.sort_values('change')
print("Conversion rate per role per quarter (Q3 to Q4) with change:")
print(pivot)
print("\nRoles with largest decline:")
print(pivot.head(10))
''')
