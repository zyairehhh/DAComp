```
import pandas as pd
import numpy as np

df = pd.read_csv('/workspace/joined_data.csv')

# Convert dates
date_cols = ['initiated_at', 'first_response_at', 'demo_booked_at', 'trial_activated_at', 'paid_at']
for col in date_cols:
    df[col] = pd.to_datetime(df[col], errors='coerce')

df['responder_type'] = df['responder_type'].str.strip().str.lower()

# Focus on bot vs human
df['responder_category'] = df['responder_type'].apply(lambda x: 'bot' if 'bot' in str(x) else ('human' if 'human' in str(x) or 'agent' in str(x) else 'other'))
print("Responder categories:", df['responder_category'].value_counts())

# Filter to bot and human only
df_main = df[df['responder_category'].isin(['bot', 'human'])]

# Overall conversion rates
grouped = df_main.groupby('responder_category')
overall = grouped.agg(
    total=('conversation_id', 'count'),
    demo_booked=('demo_booked', 'sum'),
    trial_activated=('trial_activated', 'sum'),
    paid=('paid', 'sum')
).reset_index()
overall['demo_rate'] = overall['demo_booked'] / overall['total'] * 100
overall['trial_rate_given_demo'] = overall['trial_activated'] / overall['demo_booked'].replace(0, np.nan) * 100
overall['paid_rate_given_trial'] = overall['paid'] / overall['trial_activated'].replace(0, np.nan) * 100
print("\n=== Overall Conversion Rates ===")
print(overall)

# Stage durations
duration_cols = ['first_response_to_demo_days', 'demo_to_trial_days', 'trial_to_paid_days']
for col in duration_cols:
    mean_vals = df_main[df_main[col].notnull()].groupby('responder_category')[col].mean()
    print(f"\nAverage {col} (days):")
    print(mean_vals)

# Content features analysis
print("\n=== Conversation Template ID Top 5 by Category ===")
template_top = df_main.groupby(['responder_category', 'conversation_template_id']).size().reset_index(name='count')
template_top = template_top.sort_values(['responder_category', 'count'], ascending=[True, False])
for cat in ['bot', 'human']:
    print(f"\n{cat}:")
    print(template_top[template_top['responder_category']==cat].head(5))

print("\n=== Intent Label Top 5 by Category ===")
intent_top = df_main.groupby(['responder_category', 'intent_label']).size().reset_index(name='count')
intent_top = intent_top.sort_values(['responder_category', 'count'], ascending=[True, False])
for cat in ['bot', 'human']:
    print(f"\n{cat}:")
    print(intent_top[intent_top['responder_category']==cat].head(5))

# Segment analysis: lead_source, industry, region
segments = ['lead_source', 'industry', 'region']
for seg in segments:
    print(f"\n=== Segment: {seg} ===")
    seg_df = df_main.groupby([seg, 'responder_category']).agg(
        total=('conversation_id', 'count'),
        demo_booked=('demo_booked', 'sum'),
        trial_activated=('trial_activated', 'sum'),
        paid=('paid', 'sum')
    ).reset_index()
    seg_df['demo_rate'] = seg_df['demo_booked'] / seg_df['total'] * 100
    seg_df['trial_rate_given_demo'] = seg_df['trial_activated'] / seg_df['demo_booked'].replace(0, np.nan) * 100
    seg_df['paid_rate_given_trial'] = seg_df['paid'] / seg_df['trial_activated'] * 100  # note: may produce inf if trial_activated=0

    # Filter segments with at least 10 conversations per category
    seg_df = seg_df[seg_df['total'] >= 10]
    # Compute difference between bot and human within each segment
    pivoted = seg_df.pivot(index=seg, columns='responder_category', values=['demo_rate', 'trial_rate_given_demo', 'paid_rate_given_trial', 'total'])
    # Flatten columns
    pivoted.columns = ['_'.join(col).strip() for col in pivoted.columns.values]
    pivoted.reset_index(inplace=True)
    # Calculate difference: bot - human
    if 'demo_rate_bot' in pivoted.columns and 'demo_rate_human' in pivoted.columns:
        pivoted['demo_rate_diff'] = pivoted['demo_rate_bot'] - pivoted['demo_rate_human']
    if 'trial_rate_given_demo_bot' in pivoted.columns and 'trial_rate_given_demo_human' in pivoted.columns:
        pivoted['trial_rate_diff'] = pivoted['trial_rate_given_demo_bot'] - pivoted['trial_rate_given_demo_human']
    if 'paid_rate_given_trial_bot' in pivoted.columns and 'paid_rate_given_trial_human' in pivoted.columns:
        pivoted['paid_rate_diff'] = pivoted['paid_rate_given_trial_bot'] - pivoted['paid_rate_given_trial_human']
    print(pivoted.sort_values(by='demo_rate_diff', ascending=False).head(10))
```



