import sqlite3
import pandas as pd
import numpy as np
import re
from datetime import datetime

def clean_price(price_str):
    """Convert '551,400 yuan' to float 551400."""
    if pd.isna(price_str):
        return np.nan
    # Remove commas and 'yuan'
    s = str(price_str).replace(',', '').replace('yuan', '').strip()
    # Extract numbers and maybe decimal
    match = re.search(r'[\d,]+(?:\.\d+)?', s)
    if match:
        try:
            return float(match.group().replace(',', ''))
        except:
            return np.nan
    else:
        return np.nan

def clean_mileage(mileage_str):
    """Convert '0.41 ten thousand km' to km: 0.41 * 10000 = 4100 km.
       Convert '68,000 km' to 68000."""
    if pd.isna(mileage_str):
        return np.nan
    s = str(mileage_str).strip()
    # Check for 'ten thousand km'
    if 'ten thousand km' in s:
        # extract number before 'ten thousand km'
        match = re.search(r'[\d,]+(?:\.\d+)?', s)
        if match:
            try:
                val = float(match.group().replace(',', ''))
                return val * 10000
            except:
                return np.nan
    elif 'km' in s:
        # extract number before km, may have commas
        match = re.search(r'[\d,]+(?:\.\d+)?', s)
        if match:
            try:
                return float(match.group().replace(',', ''))
            except:
                return np.nan
    return np.nan

def clean_displacement(disp_str):
    """Convert '2L', '1.2L', '0L' to numeric liters."""
    if pd.isna(disp_str):
        return np.nan
    s = str(disp_str).strip()
    match = re.search(r'[\d,]+(?:\.\d+)?', s)
    if match:
        try:
            return float(match.group().replace(',', ''))
        except:
            return np.nan
    return np.nan

def compute_age(reg_date_str, ref_date='2025-01-01'):
    """Compute age in years from registration date to reference date.
       Registration Date format: '2022-10-01 00:00:00' or similar."""
    if pd.isna(reg_date_str):
        return np.nan
    try:
        reg = pd.to_datetime(reg_date_str)
        ref = pd.to_datetime(ref_date)
        age = (ref - reg).days / 365.25
        return age
    except:
        return np.nan

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome;", conn)
conn.close()

print(f"Total rows: {len(df)}")

# Clean numeric columns
df['Price_clean'] = df['Price']  # already numeric? It's REAL type, likely already float
df['New_Price_clean'] = df['New Car Price (incl. tax)'].apply(clean_price)
df['Mileage_km'] = df['Mileage'].apply(clean_mileage)
df['Displacement_L'] = df['Displacement'].apply(clean_displacement)
df['Age_years'] = df['Registration Date'].apply(lambda x: compute_age(x))

# Depreciation ratio: used price / new price
df['Depreciation_Ratio'] = df['Price_clean'] / df['New_Price_clean']

# Filter out unrealistic: ratio > 1 or < 0.1
df = df[(df['Depreciation_Ratio'] > 0.1) & (df['Depreciation_Ratio'] <= 1.5)]

print(f"Rows after filtering: {len(df)}")

# Basic stats
print("Depreciation ratio summary:")
print(df['Depreciation_Ratio'].describe())

# Group by vehicle class
class_stats = df.groupby('Vehicle Class')['Depreciation_Ratio'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nDepreciation ratio by Vehicle Class (higher mean = retains value better):")
print(class_stats.head(20))

# Group by fuel type
fuel_stats = df.groupby('Fuel Type')['Depreciation_Ratio'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nDepreciation ratio by Fuel Type:")
