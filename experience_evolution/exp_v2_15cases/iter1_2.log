import sqlite3
import pandas as pd
import numpy as np
import re
from datetime import datetime

def parse_price(price_str):
    """Parse price string like '551,400 yuan' to float value in yuan."""
    if pd.isna(price_str):
        return np.nan
    # remove commas and 'yuan' and any spaces
    match = re.search(r'([\d,.]+)', str(price_str))
    if match:
        num_str = match.group(1).replace(',', '')
        return float(num_str)
    else:
        return np.nan

def parse_mileage(mileage_str):
    """Parse mileage string like '0.41 ten thousand km' to km."""
    if pd.isna(mileage_str):
        return np.nan
    # pattern: number then ' ten thousand km'
    match = re.search(r'([\d.]+)\s*ten thousand km', str(mileage_str))
    if match:
        value = float(match.group(1))
        return value * 10000
    # maybe some entries are just '68,000 km' (like row 4)
    match2 = re.search(r'([\d,]+)\s*km', str(mileage_str))
    if match2:
        return float(match2.group(1).replace(',', ''))
    return np.nan

def parse_date(date_str):
    """Parse date string to datetime."""
    if pd.isna(date_str):
        return pd.NaT
    # Sometimes it's already datetime
    try:
        return pd.to_datetime(date_str)
    except:
        return pd.NaT

def main():
    conn = sqlite3.connect('dacomp-029.sqlite')
    df = pd.read_sql_query("SELECT * FROM autohome", conn)
    conn.close()
    
    print(f"Loaded {len(df)} rows")
    
    # Parse columns
    df['new_price_yuan'] = df['New Car Price (incl. tax)'].apply(parse_price)
    df['used_price_yuan'] = df['Price'] * 10000  # Price column appears to be in ten thousand yuan
    df['retention_rate'] = df['used_price_yuan'] / df['new_price_yuan']
    
    df['mileage_km'] = df['Mileage'].apply(parse_mileage)
    
    df['reg_date'] = df['Registration Date'].apply(parse_date)
    df['post_date'] = df['Posting Date'].apply(parse_date)
    # Calculate age at posting date (or current?) Use registration to posting
    df['age_years'] = (df['post_date'] - df['reg_date']).dt.days / 365.25
    
    # Filter out invalid rows where retention > 1 or age negative
    df = df[(df['retention_rate'] <= 1) & (df['retention_rate'] > 0)]
    df = df[df['age_years'] >= 0]
    
    # Basic stats
    print(f"Valid rows after cleaning: {len(df)}")
    print(f"Average retention rate: {df['retention_rate'].mean():.2%}")
    print(f"Median retention rate: {df['retention_rate'].median():.2%}")
    
    # Analyze by vehicle class
    print("\n=== Retention by Vehicle Class ===")
    class_stats = df.groupby('Vehicle Class').agg(
        count=('retention_rate', 'size'),
        avg_retention=('retention_rate', 'mean'),
        median_retention=('retention_rate', 'median'),
        avg_age_years=('age_years', 'mean'),
        avg_mileage_km=('mileage_km', 'mean')
    ).sort_values('avg_retention', ascending=False)
    print(class_stats.head(10))
    
    # Analyze by fuel type
    print("\n=== Retention by Fuel Type ===")
    fuel_stats = df.groupby('Fuel Type').agg(
        count=('retention_rate', 'size'),
        avg_retention=('retention_rate', 'mean'),
        median_retention=('retention_rate', 'median')
    ).sort_values('avg_retention', ascending=False)
    print(fuel_stats)
    
    # Analyze by transmission
    print("\n=== Retention by Transmission ===")
    trans_stats = df.groupby('Transmission').agg(
        count=('retention_rate', 'size'),
        avg_retention=('retention_rate', 'mean'),
        median_retention=('retention_rate', 'median')
    )
    print(trans_stats)
    
    # Top models with highest retention (extract model from Title)
    # Simple extraction: first few words before year?
    df['model'] = df['Title'].str.split().str[:3].str.join(' ')
    
    model_stats = df.groupby('model').agg(
        count=('retention_rate', 'size'),
        avg_retention=('retention_rate', 'mean'),
        median_retention=('retention_rate', 'median'),
        avg_age=('age_years', 'mean'),
        avg_mileage=('mileage_km', 'mean')
    ).sort_values('avg_retention', ascending=False)
    print("\n=== Top 10 Models by Average Retention ===")
    print(model_stats.head(10))
    
    # Regression: factors affecting retention
    # We'll compute correlation matrix for numeric features
    numeric_cols = ['used_price_yuan', 'new_price_yuan', 'mileage_km', 'age_years', 'retention_rate']
    corr = df[numeric_cols].corr()
    print("\n=== Correlation Matrix ===")
    print(corr)
    
    # Save processed data for further analysis
    df.to_csv('processed_cars.csv', index=False)
    print("\nProcessed data saved to processed_cars.csv")
    
if __name__ == '__main__':
    main()
