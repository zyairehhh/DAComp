```
import pandas as pd
import numpy as np
import sqlite3
import re
from datetime import datetime

def parse_price(price_str):
    if pd.isna(price_str):
        return np.nan
    match = re.search(r'([\d,.]+)', str(price_str))
    if match:
        num_str = match.group(1).replace(',', '')
        return float(num_str)
    return np.nan

def parse_mileage(mileage_str):
    if pd.isna(mileage_str):
        return np.nan
    match = re.search(r'([\d.]+)\s*ten thousand km', str(mileage_str))
    if match:
        value = float(match.group(1))
        return value * 10000
    match2 = re.search(r'([\d,]+)\s*km', str(mileage_str))
    if match2:
        return float(match2.group(1).replace(',', ''))
    return np.nan

def parse_date(date_str):
    try:
        return pd.to_datetime(date_str)
    except:
        return pd.NaT

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome", conn)
conn.close()

df['new_price_yuan'] = df['New Car Price (incl. tax)'].apply(parse_price)
df['used_price_yuan'] = df['Price'] * 10000
df['retention_rate'] = df['used_price_yuan'] / df['new_price_yuan']

df['mileage_km'] = df['Mileage'].apply(parse_mileage)
df['reg_date'] = df['Registration Date'].apply(parse_date)
df['post_date'] = df['Posting Date'].apply(parse_date)
df['age_years'] = (df['post_date'] - df['reg_date']).dt.days / 365.25

# Clean up
df = df[(df['retention_rate'] <= 1) & (df['retention_rate'] > 0)]
df = df[df['age_years'] >= 0]

# Compute annual depreciation rate: (1 - retention) / age
df['annual_depreciation_pct'] = (1 - df['retention_rate']) / df['age_years']
# Compute depreciation per 10,000 km
df['depreciation_per_10k_km'] = (1 - df['retention_rate']) / (df['mileage_km'] / 10000)

# Filter out extreme outliers (e.g., depreciation >100% per year)
df = df[(df['annual_depreciation_pct'] < 5) & (df['annual_depreciation_pct'] > 0)]

print(f"Dataset size after cleaning: {len(df)}")

# Group by Vehicle Class with at least 5 samples
class_counts = df['Vehicle Class'].value_counts()
valid_classes = class_counts[class_counts >= 5].index.tolist()
df_class = df[df['Vehicle Class'].isin(valid_classes)]

class_stats = df_class.groupby('Vehicle Class').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    median_retention=('retention_rate', 'median'),
    avg_age_years=('age_years', 'mean'),
    avg_mileage_km=('mileage_km', 'mean'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
    avg_depr_per_10k_km=('depreciation_per_10k_km', 'mean'),
).sort_values('avg_retention', ascending=False)

print("\n=== Vehicle Class Retention (min 5 samples) ===")
print(class_stats)

# Group by Fuel Type
fuel_stats = df.groupby('Fuel Type').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
).sort_values('avg_retention', ascending=False)
print("\n=== Fuel Type Retention ===")
print(fuel_stats)

# Extract brand from Title (first word)
df['brand'] = df['Title'].str.split().str[0]

brand_stats = df.groupby('brand').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
    avg_mileage=('mileage_km', 'mean'),
    avg_age=('age_years', 'mean'),
).sort_values('avg_retention', ascending=False)
print("\n=== Brand Retention (min 5 samples) ===")
brand_counts = brand_stats['count']
brand_stats = brand_stats[brand_counts >= 5]
print(brand_stats.head(20))

# Identify specific models with high retention and reasonable sample size
# Let's create a model column as first three words
df['model'] = df['Title'].str.split().str[:3].str.join(' ')
model_stats = df.groupby('model').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
    avg_age=('age_years', 'mean'),
    avg_mileage=('mileage_km', 'mean'),
    median_price=('used_price_yuan', 'median'),
).sort_values('avg_retention', ascending=False)

print("\n=== Top Models by Retention (min 3 samples) ===")
model_stats_filtered = model_stats[model_stats['count'] >= 3]
print(model_stats_filtered.head(20))

# Save to csv for further review
df.to_csv('processed_cars_detailed.csv', index=False)
print("\nDetailed data saved.")
```
