Action: CreateFile(filepath='compute_metrics.py':
'''
import sqlite3
import numpy as np
import pandas as pd
from datetime import datetime, timedelta

conn = sqlite3.connect('dacomp-092.sqlite')

# Load high-volatility customers
high_vol = pd.read_csv('high_vol_customers.csv')
high_vol_ids = high_vol['customer_id'].tolist()
print(f"Number of high-volatility customers: {len(high_vol_ids)}")

# Determine date range
max_date_query = "SELECT MAX(transaction_date) FROM quickbooks__profitability_analysis"
max_date = pd.read_sql_query(max_date_query, conn).iloc[0,0]
max_date = pd.to_datetime(max_date)
start_date = max_date - pd.DateOffset(months=12)
print(f"Analyzing period from {start_date.date()} to {max_date.date()}")

# For each high-volatility customer, compute monthly gross profit
# Let's fetch all relevant rows for these customers within the period
query = """
    SELECT customer_id, transaction_date, gross_profit
    FROM quickbooks__profitability_analysis
    WHERE customer_id IN ({placeholders})
    AND transaction_date >= ?
    AND transaction_date <= ?
""".format(placeholders=','.join(['?']*len(high_vol_ids)))

# Execute with parameters
params = high_vol_ids + [start_date.strftime('%Y-%m-%d'), max_date.strftime('%Y-%m-%d')]
df = pd.read_sql_query(query, conn, params=params)
df['transaction_date'] = pd.to_datetime(df['transaction_date'])
df['year_month'] = df['transaction_date'].dt.to_period('M')

# Aggregate monthly gross profit per customer
monthly = df.groupby(['customer_id', 'year_month'])['gross_profit'].sum().reset_index()
print(f"Monthly records for high-volatility customers: {monthly.shape[0]}")

# Compute coefficient of variation per customer
def coef_var(x):
    if len(x) < 2 or x.mean() == 0:
        return np.nan
    return x.std() / x.mean()

cv = monthly.groupby('customer_id')['gross_profit'].apply(coef_var).reset_index()
cv.columns = ['customer_id', 'cv_gross_profit']
print("Coefficient of variation computed.")

# Compute variance of quarter-over-quarter invoice_total growth rate
# We need invoice_total per quarter per customer
# Let's get invoice_total aggregated per quarter (fiscal quarter maybe based on transaction_date)
df_quarter = df.copy()  # but we need invoice_total, not gross_profit. We must query again.
# Let's query invoice_total as well
query2 = """
    SELECT customer_id, transaction_date, invoice_total
    FROM quickbooks__profitability_analysis
    WHERE customer_id IN ({placeholders})
    AND transaction_date >= ?
    AND transaction_date <= ?
""".format(placeholders=','.join(['?']*len(high_vol_ids)))
df2 = pd.read_sql_query(query2, conn, params=params)
df2['transaction_date'] = pd.to_datetime(df2['transaction_date'])
df2['quarter'] = df2['transaction_date'].dt.to_period('Q')

quarterly = df2.groupby(['customer_id', 'quarter'])['invoice_total'].sum().reset_index()
# Compute quarter-over-quarter growth rate per customer
quarterly['prev_quarter_total'] = quarterly.groupby('customer_id')['invoice_total'].shift(1)
quarterly['growth_rate'] = (quarterly['invoice_total'] - quarterly['prev_quarter_total']) / quarterly['prev_quarter_total']

# Compute variance of growth rates per customer (omit NaN)
var_growth = quarterly.groupby('customer_id')['growth_rate'].var().reset_index()
var_growth.columns = ['customer_id', 'var_qoq_growth']

print("Variance of quarter-over-quarter growth computed.")

# Combine metrics
metrics = pd.merge(cv, var_growth, on='customer_id', how='outer')
print(f"Metrics for {len(metrics)} customers.")

# Save to CSV
metrics.to_csv('high_vol_metrics.csv', index=False)
print("Metrics saved to high_vol_metrics.csv")

conn.close()
''')
