import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-098.sqlite')

query = """
SELECT 
    c.conversation_initiated_type,
    e.all_conversation_tags
FROM intercom__conversation_metrics c
LEFT JOIN intercom__conversation_enhanced e ON c.conversation_id = e.conversation_id
WHERE c.conversation_initiated_type IN ('bot_first', 'human_first')
"""
df = pd.read_sql_query(query, conn)

def parse_tags(tag_str):
    d = {}
    if tag_str:
        for kv in tag_str.split('|'):
            if ':' in kv:
                k, v = kv.split(':', 1)
                d[k] = v
    return d

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', None))

funnel_stages = ['demo_booked', 'trial_activated', 'closed_won']
# Ensure columns exist
stage_counts = df.groupby(['conversation_initiated_type', 'stage']).size().unstack(fill_value=0)
# Reindex to include only funnel stages
stage_counts = stage_counts.reindex(columns=funnel_stages, fill_value=0)

stage_counts.plot(kind='bar', stacked=True, figsize=(10,6))
plt.xlabel('First Response Type')
plt.ylabel('Number of Conversations')
plt.title('Funnel Stage Counts by First Response Type')
plt.legend(title='Stage')
plt.tight_layout()
plt.savefig('funnel_stage_counts.png', dpi=300)
plt.close()
```
