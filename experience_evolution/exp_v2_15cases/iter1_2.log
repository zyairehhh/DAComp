    'age_years': 'mean',
    'Title': 'count'
}).rename(columns={'Title': 'count'}).reset_index()
brand_retention = brand_retention[brand_retention['count'] >= 3].sort_values('price_per_year', ascending=False).head(15)

# Visualization 4: Best value retention brands
