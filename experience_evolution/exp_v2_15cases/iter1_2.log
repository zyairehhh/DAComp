import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query("""
    SELECT * FROM sheet1
    WHERE "Booking Status" = 'Completed'
          AND "Ride Distance" > 0
          AND "Booking Value" IS NOT NULL
          AND "Driver Ratings" IS NOT NULL
""", conn)
conn.close()

print(f"Total completed rides: {len(df)}")

# Compute per-km fare
df['fare_per_km'] = df['Booking Value'] / df['Ride Distance']

# Summary statistics
print("\nOverall fare per km stats:")
print(df['fare_per_km'].describe())

# Group by Vehicle Type
vehicle_summary = df.groupby('Vehicle Type').agg(
    rides=('Booking Value', 'count'),
    total_value=('Booking Value', 'sum'),
    total_distance=('Ride Distance', 'sum'),
    avg_fare_per_km=('fare_per_km', 'mean'),
    median_fare_per_km=('fare_per_km', 'median'),
    avg_driver_rating=('Driver Ratings', 'mean')
).round(2)
vehicle_summary = vehicle_summary.sort_values('avg_fare_per_km', ascending=False)
print("\nVehicle Type Summary:")
print(vehicle_summary)

# Group by Driver Ratings bins
bins = [3.0, 3.5, 4.0, 4.5, 5.0]
labels = ['3.0-3.5', '3.5-4.0', '4.0-4.5', '4.5-5.0']
df['rating_bin'] = pd.cut(df['Driver Ratings'], bins=bins, labels=labels, right=False)

rating_summary = df.groupby('rating_bin').agg(
    rides=('Booking Value', 'count'),
    total_value=('Booking Value', 'sum'),
    avg_fare_per_km=('fare_per_km', 'mean'),
    avg_distance=('Ride Distance', 'mean'),
    avg_rating=('Driver Ratings', 'mean')
).round(2)
print("\nDriver Rating Bins Summary:")
print(rating_summary)

# Combined: Vehicle Type and Rating bin
combined = df.groupby(['Vehicle Type', 'rating_bin']).agg(
    rides=('Booking Value', 'count'),
    avg_fare_per_km=('fare_per_km', 'mean'),
    total_value=('Booking Value', 'sum')
).round(2)
combined = combined.sort_values(['Vehicle Type', 'rating_bin'])
print("\nCombined (Vehicle Type + Rating Bin) Summary:")
print(combined)

# Compute annual earnings projection (assuming 12 months)
# Data covers from 2024-01-01 to 2024-09-09 (approx 8.3 months)
# Let's compute average monthly earnings per vehicle type
df['Date'] = pd.to_datetime(df['Date'], format='%Y/%m/%d')
monthly_earnings = df.groupby([df['Date'].dt.month, 'Vehicle Type'])['Booking Value'].sum().reset_index()
avg_monthly = monthly_earnings.groupby('Vehicle Type')['Booking Value'].mean().round(2)
print("\nAverage Monthly Earnings per Vehicle Type:")
print(avg_monthly)
annual_projection = avg_monthly * 12
print("\nProjected Annual Earnings per Vehicle Type (assuming 12 months):")
print(annual_projection)

# Save key results to CSV for reference
vehicle_summary.to_csv('vehicle_summary.csv')
rating_summary.to_csv('rating_summary.csv')
combined.to_csv('combined_vehicle_rating.csv')
```
