Action: CreateFile(filepath="compute_percentile.py"):
```
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-092.sqlite')
cursor = conn.cursor()

# Get distinct customer_margin_volatility per customer
cursor.execute("""
    SELECT DISTINCT customer_id, customer_margin_volatility
    FROM quickbooks__profitability_analysis
    WHERE customer_margin_volatility IS NOT NULL
""")
rows = cursor.fetchall()
volatilities = [row[1] for row in rows]

print(f"Number of distinct customers with volatility: {len(volatilities)}")

# Compute 75th percentile (top 25% high volatility)
threshold = np.percentile(volatilities, 75)
print(f"75th percentile (threshold for top 25% high volatility): {threshold}")

# Identify high-volatility customer IDs
high_vol_customers = [row[0] for row in rows if row[1] >= threshold]
print(f"Count of high-volatility customers: {len(high_vol_customers)}")

# Save to a temporary CSV for later use
import csv
with open('high_vol_customers.csv', 'w') as f:
    writer = csv.writer(f)
    writer.writerow(['customer_id'])
    writer.writerows([[cust] for cust in high_vol_customers])

conn.close()
```
