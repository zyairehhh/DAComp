import pandas as pd
import sqlite3
import numpy as np
import matplotlib.pyplot as plt
import matplotlib

# Connect to database
conn = sqlite3.connect('dacomp-060.sqlite')

# Load ad group report data
df_ag = pd.read_sql_query("SELECT * FROM google_ads__ad_group_report", conn)

# Aggregate per ad group
agg = df_ag.groupby(['ad_group_id', 'ad_group_name', 'ad_group_type', 'status', 'campaign_id', 'campaign_name']).agg({
    'clicks': 'sum',
    'impressions': 'sum',
    'conversions': 'sum',
    'spend': 'sum'
}).reset_index()
agg['CTR'] = agg['clicks'] / agg['impressions']
agg['CVR'] = agg['conversions'] / agg['clicks']
# Replace infinite or NaN values with 0
agg.replace([np.inf, -np.inf], np.nan, inplace=True)
agg.fillna(0, inplace=True)

# Compute expected CVR per campaign (average CVR across ad groups within campaign)
campaign_cvr = agg.groupby('campaign_id')['CVR'].mean().reset_index()
campaign_cvr.rename(columns={'CVR': 'expected_cvr'}, inplace=True)
agg = pd.merge(agg, campaign_cvr, on='campaign_id', how='left')
agg['intent_match_ratio'] = agg['CVR'] / agg['expected_cvr']
agg.replace([np.inf, -np.inf], np.nan, inplace=True)
agg.fillna(0, inplace=True)

# Compute percentiles
ctr_75 = agg['CTR'].quantile(0.75)
cvr_25 = agg['CVR'].quantile(0.25)
problematic = agg[(agg['CTR'] > ctr_75) & (agg['CVR'] < cvr_25)]

print(f"CTR 75th percentile: {ctr_75:.4f}")
print(f"CVR 25th percentile: {cvr_25:.4f}")
print(f"Number of problematic ad groups: {len(problematic)}")

# Plot 4: Intent Match Ratio distribution (problematic vs non-problematic)
fig, ax = plt.subplots(figsize=(8, 5))
ax.hist(agg.loc[~agg.index.isin(problematic.index), 'intent_match_ratio'], 
         bins=50, alpha=0.7, label='Non-Problematic', color='green', density=True)
ax.hist(problematic['intent_match_ratio'], bins=50, alpha=0.7, label='Problematic', color='red', density=True)
ax.set_xlabel('Intent Match Ratio (Actual CVR / Expected CVR)')
ax.set_ylabel('Density')
ax.set_title('Distribution of Intent Match Ratio')
ax.legend()
plt.tight_layout()
plt.savefig('intent_match_ratio_dist.png', dpi=300)
plt.close()

# Plot 5: Traffic quality metric: proportion of clicks from exact match keywords vs broad match
# Load keyword report data
df_kw = pd.read_sql_query("SELECT * FROM google_ads__keyword_report", conn)

# Aggregate clicks by ad_group and keyword_match_type
kw_agg = df_kw.groupby(['ad_group_id', 'keyword_match_type']).agg({'clicks': 'sum'}).reset_index()
# Pivot
kw_pivot = kw_agg.pivot(index='ad_group_id', columns='keyword_match_type', values='clicks').fillna(0)
# Ensure columns exist
for col in ['EXACT', 'PHRASE', 'BROAD', 'BROAD_MATCH_MODIFIER']:
    if col not in kw_pivot.columns:
        kw_pivot[col] = 0
# Compute total clicks per ad group
kw_pivot['total_clicks'] = kw_pivot.sum(axis=1)
# Compute proportion of exact match clicks
kw_pivot['exact_proportion'] = kw_pivot['EXACT'] / kw_pivot['total_clicks']
# Merge with agg data
agg = pd.merge(agg, kw_pivot[['exact_proportion']], left_on='ad_group_id', right_index=True, how='left')
agg['exact_proportion'] = agg['exact_proportion'].fillna(0)

# Plot proportion of exact clicks for problematic vs non-problematic
fig, ax = plt.subplots(figsize=(8, 5))
ax.hist(agg.loc[~agg.index.isin(problematic.index), 'exact_proportion'], 
         bins=30, alpha=0.7, label='Non-Problematic', color='blue', density=True)
ax.hist(problematic['exact_proportion'], bins=30, alpha=0.7, label='Problematic', color='orange', density=True)
ax.set_xlabel('Proportion of Clicks from Exact Match Keywords')
ax.set_ylabel('Density')
ax.set_title('Traffic Quality: Exact Match Proportion')
ax.legend()
plt.tight_layout()
plt.savefig('exact_match_proportion.png', dpi=300)
plt.close()

# Search term match type proportion
df_st = pd.read_sql_query("SELECT * FROM google_ads__search_term_report", conn)
conn.close()

# Aggregate clicks by ad_group and search_term_match_type
st_agg = df_st.groupby(['ad_group_id', 'search_term_match_type']).agg({'clicks': 'sum'}).reset_index()
st_pivot = st_agg.pivot(index='ad_group_id', columns='search_term_match_type', values='clicks').fillna(0)
# Ensure 'Exact' column exists (case-sensitive)
if 'Exact' not in st_pivot.columns:
    st_pivot['Exact'] = 0
st_pivot['total_clicks'] = st_pivot.sum(axis=1)
st_pivot['exact_proportion_st'] = st_pivot['Exact'] / st_pivot['total_clicks']
# Merge
agg = pd.merge(agg, st_pivot[['exact_proportion_st']], left_on='ad_group_id', right_index=True, how='left')
agg['exact_proportion_st'] = agg['exact_proportion_st'].fillna(0)

# Plot search term exact proportion
fig, ax = plt.subplots(figsize=(8, 5))
ax.hist(agg.loc[~agg.index.isin(problematic.index), 'exact_proportion_st'], 
         bins=30, alpha=0.7, label='Non-Problematic', color='cyan', density=True)
ax.hist(problematic['exact_proportion_st'], bins=30, alpha=0.7, label='Problematic', color='magenta', density=True)
ax.set_xlabel('Proportion of Clicks from Exact Match Search Terms')
ax.set_ylabel('Density')
ax.set_title('Traffic Quality: Exact Match Search Term Proportion')
ax.legend()
plt.tight_layout()
plt.savefig('exact_match_search_term_proportion.png', dpi=300)
plt.close()

# Plot 6: Problematic ad groups by status
status_counts = problematic['status'].value_counts().reset_index()
status_counts.columns = ['status', 'count']
plt.figure(figsize=(8,5))
plt.bar(status_counts['status'], status_counts['count'], color='purple')
plt.xlabel('Ad Group Status')
plt.ylabel('Count')
plt.title('Problematic Ad Groups by Status')
for i, v in enumerate(status_counts['count']):
    plt.text(i, v + 1, str(v), ha='center', va='bottom')
plt.tight_layout()
plt.savefig('problematic_by_status.png', dpi=300)
plt.close()

# Scatter plot of CTR vs CVR with color by intent_match_ratio (categorical)
# Categorize intent_match_ratio into quartiles
agg['intent_match_quartile'] = pd.qcut(agg['intent_match_ratio'], 4, labels=['Q1','Q2','Q3','Q4'])
# Create scatter with color mapping
color_map = {'Q1': 'red', 'Q2': 'orange', 'Q3': 'yellow', 'Q4': 'green'}
fig, ax = plt.subplots(figsize=(10,6))
for quartile, color in color_map.items():
    subset = agg[agg['intent_match_quartile'] == quartile]
    ax.scatter(subset['CTR'], subset['CVR'], alpha=0.6, s=30, color=color, label=f'IMR {quartile}')
ax.axvline(ctr_75, color='grey', linestyle='--', linewidth=1, label='CTR 75th percentile')
ax.axhline(cvr_25, color='grey', linestyle='--', linewidth=1, label='CVR 25th percentile')
ax.set_xlabel('CTR')
ax.set_ylabel('CVR')
ax.set_title('CTR vs CVR colored by Intent Match Ratio Quartiles')
ax.legend()
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('ctr_cvr_imr.png', dpi=300)
plt.close()

# Save aggregated data for reference
agg.to_csv('aggregated_adgroup_metrics.csv', index=False)
problematic.to_csv('problematic_ad_groups_detailed.csv', index=False)

print("All additional plots generated.")
