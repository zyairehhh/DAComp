Action: CreateFile(filepath='recommendations.py':
'''
import pandas as pd
import sqlite3
import re

def parse_price(price_str):
    if pd.isna(price_str):
        return None
    match = re.search(r'([\d,.]+)', str(price_str))
    if match:
        num_str = match.group(1).replace(',', '')
        return float(num_str)
    return None

def parse_mileage(mileage_str):
    if pd.isna(mileage_str):
        return None
    s = str(mileage_str).strip()
    s = s.replace('(no space)', '').strip()
    match = re.search(r'([\d.]+)\s*ten thousand km', s)
    if match:
        return float(match.group(1)) * 10000
    match2 = re.search(r'([\d,]+)\s*km', s)
    if match2:
        return float(match2.group(1).replace(',', ''))
    try:
        return float(s.split()[0])
    except:
        return None

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome", conn)
conn.close()

df['new_price_yuan'] = df['New Car Price (incl. tax)'].apply(parse_price)
df['used_price_yuan'] = df['Price'] * 10000
df['retention_rate'] = df['used_price_yuan'] / df['new_price_yuan']
df['mileage_km'] = df['Mileage'].apply(parse_mileage)
df['reg_date'] = pd.to_datetime(df['Registration Date'])
df['post_date'] = pd.to_datetime(df['Posting Date'])
df['age_years'] = (df['post_date'] - df['reg_date']).dt.days / 365.25
df['annual_depreciation_pct'] = (1 - df['retention_rate']) / df['age_years']

# Filter valid
df = df[(df['retention_rate'] <= 1) & (df['retention_rate'] > 0) & (df['age_years'] >= 0) & (df['annual_depreciation_pct'] > 0)]
df = df.dropna(subset=['new_price_yuan', 'mileage_km'])

# Compute a composite score: weight retention 0.6, depreciation 0.4 (inverse)
df['score'] = 0.6 * df['retention_rate'] + 0.4 * (1 - df['annual_depreciation_pct'] / df['annual_depreciation_pct'].max())

# For each price segment (<100k, 100k-200k, 200k-300k, >300k) pick top 2-3 listings
def segment_price(new_price):
    if new_price < 100000:
        return '<100k'
    elif new_price < 200000:
        return '100k-200k'
    elif new_price < 300000:
        return '200k-300k'
    else:
        return '>=300k'

df['price_segment'] = df['new_price_yuan'].apply(segment_price)

top_picks = pd.DataFrame()
for seg in df['price_segment'].unique():
    seg_df = df[df['price_segment'] == seg].copy()
    if len(seg_df) < 3:
        continue
    # Sort by score descending
    seg_df = seg_df.sort_values('score', ascending=False).head(3)
    top_picks = pd.concat([top_picks, seg_df])

# Select relevant columns
cols = ['Title', 'Price', 'New Car Price (incl. tax)', 'retention_rate', 'annual_depreciation_pct', 'age_years', 'mileage_km', 'Transmission', 'Fuel Type', 'Vehicle Class', 'price_segment', 'score']
top_picks = top_picks[cols].sort_values('score', ascending=False)

print("Top 10 Buyback Recommendations (based on retention and low depreciation):")
print(top_picks.head(10).to_string(index=False))

# Also list high-retention models with low mileage and age < 2 years
df['model'] = df['Title'].str.split().str[:3].str.join(' ')
model_stats = df.groupby('model').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    avg_depr=('annual_depreciation_pct', 'mean'),
    avg_age=('age_years', 'mean'),
    avg_mileage=('mileage_km', 'mean'),
).sort_values('avg_retention', ascending=False)
model_stats = model_stats[model_stats['count'] >= 5]
print("\n=== High Retention Models (min 5 listings) ===")
print(model_stats.head(10).to_string())
''')
