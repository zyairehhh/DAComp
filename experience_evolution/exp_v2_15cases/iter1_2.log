    r2_q = ssreg_q / sstot_q if sstot_q != 0 else 0
    # Fit quadratic for conversion_rate ~ crash_rate_per_1k
    X_c = sub['crash_rate_per_1k'].values
    y_c = sub['conversion_rate'].values
    coeffs_c = np.polyfit(X_c, y_c, 2)
    p_c = np.poly1d(coeffs_c)
    yhat_c = p_c(X_c)
    ssreg_c = np.sum((yhat_c - np.mean(y_c))**2)
    sstot_c = np.sum((y_c - np.mean(y_c))**2)
    r2_c = ssreg_c / sstot_c if sstot_c != 0 else 0
    results_nonlinear.append((pkg, r2_q, r2_c))
    print(f"{pkg}, {r2_q:.4f}, {r2_c:.4f}")

# 3. Construct a multi-dimensional user value decay model, predict optimization strategies for revenue_per_active_device under different market maturities.
query_rev = """
SELECT 
    date_day,
    package_name,
    revenue_per_active_device,
    active_devices,
    daily_installs,
    daily_uninstalls,
    daily_churn_rate,
    ma_7d_revenue,
    ma_30d_revenue,
    quality_score,
    crash_rate_per_1k
FROM google_play__time_series_trends
WHERE revenue_per_active_device IS NOT NULL AND active_devices > 0
ORDER BY package_name, date_day;
"""
df_rev = pd.read_sql_query(query_rev, conn, parse_dates=['date_day'])
print("\nRevenue per active device sample:")
print(df_rev.head())

# Compute cumulative installs per package as proxy for maturity
df_rev['cumulative_installs'] = df_rev.groupby('package_name')['daily_installs'].cumsum()
median_cum = df_rev['cumulative_installs'].median()
df_rev['maturity'] = df_rev['cumulative_installs'].apply(lambda x: 'high' if x > median_cum else 'low')

# Correlation matrix for low maturity
low = df_rev[df_rev['maturity'] == 'low'][['revenue_per_active_device', 'quality_score', 'crash_rate_per_1k', 'daily_churn_rate', 'active_devices']].corr()
high = df_rev[df_rev['maturity'] == 'high'][['revenue_per_active_device', 'quality_score', 'crash_rate_per_1k', 'daily_churn_rate', 'active_devices']].corr()
print("\nCorrelation with revenue_per_active_device for low maturity:")
print(low['revenue_per_active_device'].to_string())
print("\nCorrelation with revenue_per_active_device for high maturity:")
print(high['revenue_per_active_device'].to_string())

# 4. Quantify the interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating.
query_updates = """
SELECT 
    d.date_day,
    d.package_name,
    SUM(d.update_events) as daily_updates
FROM google_play__device_report d
GROUP BY d.date_day, d.package_name
ORDER BY d.date_day;
"""
df_updates = pd.read_sql_query(query_updates, conn, parse_dates=['date_day'])
# Join with country_report for active_devices_last_30_days and rolling_total_average_rating per package (aggregated across countries).
query_active_rating = """
SELECT 
    date_day,
    package_name,
    SUM(active_devices_last_30_days) as active_devices_last_30_days,
    AVG(rolling_total_average_rating) as avg_rolling_rating
FROM google_play__country_report
GROUP BY date_day, package_name;
"""
df_active_rating = pd.read_sql_query(query_active_rating, conn, parse_dates=['date_day'])
# Merge
df_interaction = pd.merge(df_updates, df_active_rating, on=['date_day', 'package_name'], how='inner')
print("\nInteraction data sample:")
print(df_interaction.head())
# Compute moving average of updates to get frequency (weekly average)
df_interaction['weekly_update_freq'] = df_interaction.groupby('package_name')['daily_updates'].transform(lambda x: x.rolling(window=7, min_periods=1).mean())
# Drop NA
df_interaction.dropna(subset=['weekly_update_freq', 'active_devices_last_30_days', 'avg_rolling_rating'], inplace=True)
# Correlation between weekly_update_freq and active_devices_last_30_days, avg_rolling_rating
corr_active = df_interaction['weekly_update_freq'].corr(df_interaction['active_devices_last_30_days'])
corr_rating = df_interaction['weekly_update_freq'].corr(df_interaction['avg_rolling_rating'])
print(f"\nCorrelation between update frequency and active devices: {corr_active:.4f}")
print(f"Correlation between update frequency and average rating: {corr_rating:.4f}")

# Additionally, we can compute interaction effect via regression with interaction term, but for simplicity we'll compute correlation per package and average.
print("\nInteraction effect per package (correlation between weekly_update_freq and active_devices_last_30_days):")
package_corrs = []
for pkg in df_interaction['package_name'].unique():
    sub = df_interaction[df_interaction['package_name'] == pkg]
    if len(sub) > 5:
        corr = sub['weekly_update_freq'].corr(sub['active_devices_last_30_days'])
        if not np.isnan(corr):
            package_corrs.append(corr)
print(f"Average correlation across packages: {np.mean(package_corrs):.4f}")
print(f"Std correlation: {np.std(package_corrs):.4f}")

conn.close()
```
