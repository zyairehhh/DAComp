```
import sqlite3
import pandas as pd

conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-022/stage1_env/dacomp-022.sqlite')
# Get completion rate per vehicle
df_rates = pd.read_sql_query('SELECT "Vehicle Type", COUNT(*) as total, SUM(CASE WHEN "Booking Status" = "Completed" THEN 1 ELSE 0 END) as completed FROM sheet1 GROUP BY "Vehicle Type"', conn)
df_rates['completion_rate'] = df_rates['completed'] / df_rates['total']

# Get earnings per ride (completed) and time metrics
df_earn = pd.read_sql_query('SELECT "Vehicle Type", AVG("Booking Value") as avg_booking, AVG("Ride Distance") as avg_distance, AVG("Voice Talk Average Time") as avg_voice, AVG("Customer Technical Assistance Time") as avg_tech FROM sheet1 WHERE "Booking Status" = "Completed" AND "Ride Distance" > 0 GROUP BY "Vehicle Type"', conn)

# Merge
df = pd.merge(df_earn, df_rates[['Vehicle Type', 'completion_rate']], on='Vehicle Type')

# Assume average speed 30 km/h (0.5 km/minute)
df['ride_time_minutes'] = df['avg_distance'] / 0.5
df['total_time_minutes'] = df['ride_time_minutes'] + df['avg_voice'] + df['avg_tech']
# Earnings per minute for completed ride
df['earnings_per_minute_completed'] = df['avg_booking'] / df['total_time_minutes']
# Expected earnings per minute accounting for completion rate (cancelled rides yield 0 earnings and waste time? Assume cancelled rides consume same time? Let's assume cancelled rides waste only some time, maybe 2 minutes? We'll ignore for simplicity)
# Instead, compute expected earnings per hour: earnings_per_minute_completed * 60 * completion_rate (since fraction of time leads to earnings)
