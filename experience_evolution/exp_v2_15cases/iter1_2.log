import pandas as pd
import numpy as np

# Load data
ad_metrics = pd.read_csv('ad_group_metrics.csv')
high = pd.read_csv('high_ctr_low_cvr_detailed.csv')
keyword_agg = pd.read_csv('keyword_agg.csv')
search_agg = pd.read_csv('search_term_agg.csv')
campaign_adgroup = pd.read_csv('campaign_adgroup.csv')

# compute overall averages
avg_ctr = ad_metrics['ctr'].mean()
avg_cvr = ad_metrics['cvr'].mean()
print('Overall average CTR:', avg_ctr)
print('Overall average CVR:', avg_cvr)
print('High CTR low CVR average CTR:', high['ctr'].mean())
print('High CTR low CVR average CVR:', high['cvr'].mean())
print('High CTR low CVR average intent match ratio:', high['intent_match_ratio'].mean())

# Intent match ratio distribution
print('\\nIntent match ratio quartiles for high group:')
print(high['intent_match_ratio'].describe())

# Traffic quality: search term match type distribution vs overall
all_search = search_agg.groupby('search_term_match_type')['clicks'].sum().reset_index()
all_search['share'] = all_search['clicks'] / all_search['clicks'].sum()
print('\\nOverall search term match type share:')
print(all_search)

# For high group, compute share
high_search = search_agg[search_agg['ad_group_id'].isin(high['ad_group_id'])]
high_search_sum = high_search.groupby('search_term_match_type')['clicks'].sum().reset_index()
high_search_sum['share'] = high_search_sum['clicks'] / high_search_sum['clicks'].sum()
print('\\nHigh CTR low CVR search term match type share:')
print(high_search_sum)

# Keyword match type distribution
keyword_all = keyword_agg.groupby('keyword_match_type')['clicks'].sum().reset_index()
keyword_all['share'] = keyword_all['clicks'] / keyword_all['clicks'].sum()
print('\\nOverall keyword match type share:')
print(keyword_all)

high_keyword = keyword_agg[keyword_agg['ad_group_id'].isin(high['ad_group_id'])]
high_keyword_sum = high_keyword.groupby('keyword_match_type')['clicks'].sum().reset_index()
high_keyword_sum['share'] = high_keyword_sum['clicks'] / high_keyword_sum['clicks'].sum()
print('\\nHigh CTR low CVR keyword match type share:')
print(high_keyword_sum)

# Campaign analysis: count of problematic ad groups per campaign
campaign_counts = campaign_adgroup[campaign_adgroup['ad_group_id'].isin(high['ad_group_id'])].groupby('campaign_id').size().reset_index(name='problematic_ad_groups')
campaign_counts = campaign_counts.sort_values('problematic_ad_groups', ascending=False)
print('\\nTop 10 campaigns with most problematic ad groups:')
print(campaign_counts.head(10))

# Merge campaign names
campaign_names = campaign_adgroup[['campaign_id', 'campaign_name']].drop_duplicates()
campaign_counts = campaign_counts.merge(campaign_names, on='campaign_id', how='left')
print('Top campaigns with names:')
print(campaign_counts.head(10))

# Landing page analysis: load url report (sample)
import sqlite3
conn = sqlite3.connect('dacomp-060.sqlite')
url_agg = pd.read_sql_query('''
    SELECT ad_group_id, base_url, SUM(clicks) as clicks, SUM(conversions) as conversions
    FROM google_ads__url_report
    GROUP BY ad_group_id, base_url
''', conn)
conn.close()

# For high group, aggregate base_url
high_url = url_agg[url_agg['ad_group_id'].isin(high['ad_group_id'])]
high_url['cvr'] = high_url['conversions'] / high_url['clicks']
high_url = high_url.sort_values('clicks', ascending=False)
print('\\nTop landing pages by clicks in high CTR low CVR ad groups:')
print(high_url.head(10))

# Compute conversion rate per landing page across all ad groups
overall_url = url_agg.groupby('base_url').agg(
    total_clicks=('clicks', 'sum'),
    total_conversions=('conversions', 'sum')
).reset_index()
overall_url['cvr'] = overall_url['total_conversions'] / overall_url['total_clicks']
# Merge with high_url to compare
merged_url = high_url.merge(overall_url, on='base_url', suffixes=('_high','_overall'))
merged_url['cvr_diff'] = merged_url['cvr_high'] - merged_url['cvr_overall']
print('\\nLanding pages with largest CVR gap (high group vs overall):')
print(merged_url.sort_values('cvr_diff').head(10))

# Save insights to CSV for reference
high.to_csv('problematic_ad_groups_analysis.csv', index=False)
''')
