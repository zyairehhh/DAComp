```
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os

# Connect to database
conn = sqlite3.connect('/workspace/dacomp-058.sqlite')

# Load campaign data
query = """
SELECT 
    year_month,
    campaign_id,
    campaign_name,
    campaign_type,
    bidding_strategy,
    industry,
    impressions,
    clicks,
    cost,
    conversions,
    conversion_value,
    ctr,
    cpc,
    conversion_rate,
    cost_per_conversion,
    roas,
    quality_score,
    impression_share
FROM google_ads__campaign_report
WHERE cost > 1000 AND roas < 0.8
"""
df = pd.read_sql_query(query, conn)

# Add derived metrics
df['roi'] = df['roas']  # For consistency with task description

# Define health score components
# 1. Cost Efficiency (40%): based on cost per conversion and ROI
df['cost_efficiency_score'] = 1 - (df['cost_per_conversion'] / df['cost_per_conversion'].max())
df['roi_score'] = df['roi'] / df['roi'].max() if df['roi'].max() > 0 else 0
df['cost_efficiency_component'] = 0.7 * df['cost_efficiency_score'] + 0.3 * df['roi_score']

# 2. Conversion Quality (35%): based on conversion rate and quality score
df['conversion_rate_score'] = df['conversion_rate'] / df['conversion_rate'].max() if df['conversion_rate'].max() > 0 else 0
df['quality_score_norm'] = df['quality_score'] / 10  # Assuming quality_score is 1-10 scale
df['conversion_quality_component'] = 0.6 * df['conversion_rate_score'] + 0.4 * df['quality_score_norm']

# 3. Competitiveness (25%): based on impression share and CTR
df['impression_share_score'] = df['impression_share'] / 100  # Convert percentage to decimal
df['ctr_score'] = df['ctr'] / df['ctr'].max() if df['ctr'].max() > 0 else 0
df['competitiveness_component'] = 0.5 * df['impression_share_score'] + 0.5 * df['ctr_score']

# Calculate overall health score (weighted sum)
df['health_score'] = (
    0.4 * df['cost_efficiency_component'] +
    0.35 * df['conversion_quality_component'] +
    0.25 * df['competitiveness_component']
) * 100  # Scale to 0-100

# Classify risk levels
def classify_risk(score):
    if score >= 70:
        return 'Low Risk'
    elif score >= 40:
        return 'Medium Risk'
    else:
        return 'High Risk'

df['risk_level'] = df['health_score'].apply(classify_risk)

# Save health scores for reference
df.to_csv('/workspace/health_scores.csv', index=False)

print(f"Analyzed {len(df)} problematic campaigns (cost > $1000, ROI < 0.8)")
print(f"Health score range: {df['health_score'].min():.1f} - {df['health_score'].max():.1f}")
print(f"Risk distribution:")
print(df['risk_level'].value_counts())
```
