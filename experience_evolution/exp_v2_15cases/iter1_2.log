import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# Load data
df = pd.read_csv('all_ad_groups_with_expected_cvr.csv')
problematic = pd.read_csv('problematic_ad_groups_with_expected_cvr.csv')

# Ensure numeric
df['ctr'] = df['ctr'].astype(float)
df['cvr'] = df['cvr'].astype(float)
problematic['ctr'] = problematic['ctr'].astype(float)
problematic['cvr'] = problematic['cvr'].astype(float)

# 1. Scatter plot: CTR vs CVR with percentiles and highlighting problematic groups
p75_ctr = df['ctr'].quantile(0.75)
p25_cvr = df['cvr'].quantile(0.25)

plt.figure(figsize=(10, 6))
plt.scatter(df['ctr'], df['cvr'], s=5, alpha=0.5, label='Normal ad groups', color='gray')
plt.scatter(problematic['ctr'], problematic['cvr'], s=10, alpha=0.8, label='Problematic ad groups (High CTR, Low CVR)', color='red')
# Add percentile lines
plt.axvline(x=p75_ctr, color='blue', linestyle='--', linewidth=1, label=f'75th percentile CTR = {p75_ctr:.3f}')
plt.axhline(y=p25_cvr, color='orange', linestyle='--', linewidth=1, label=f'25th percentile CVR = {p25_cvr:.3f}')
plt.xlabel('Click-Through Rate (CTR)')
plt.ylabel('Conversion Rate (CVR)')
plt.title('CTR vs CVR across Ad Groups (Highlighting High-CTR, Low-CVR Groups)')
plt.legend(fontsize='small')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('ctr_vs_cvr_scatter.png', dpi=300)
plt.close()

# 2. Distribution of Intent Match Ratio for problematic ad groups
plt.figure(figsize=(10, 6))
plt.hist(problematic['intent_match_ratio'].dropna(), bins=30, edgecolor='black', alpha=0.7)
plt.xlabel('Intent Match Ratio (Actual CVR / Expected CVR)')
plt.ylabel('Frequency')
plt.title('Distribution of Intent Match Ratio for High-CTR, Low-CVR Ad Groups')
plt.grid(True, alpha=0.3)
plt.axvline(x=1, color='red', linestyle='--', linewidth=2, label='Ratio = 1 (Expected CVR)')
plt.legend()
plt.tight_layout()
plt.savefig('intent_match_ratio_histogram.png', dpi=300)
plt.close()

# 3. Boxplot comparison: CTR and CVR for problematic vs non-problematic
df['is_problematic'] = df['ad_group_id'].isin(problematic['ad_group_id'])

fig, axes = plt.subplots(1, 2, figsize=(14, 6))
# CTR boxplot
sns.boxplot(x='is_problematic', y='ctr', data=df, ax=axes[0])
axes[0].set_xticklabels(['Non-problematic', 'Problematic'])
axes[0].set_xlabel('Ad Group Category')
axes[0].set_ylabel('CTR')
axes[0].set_title('CTR Distribution: Problematic vs Non-problematic Ad Groups')
# CVR boxplot
sns.boxplot(x='is_problematic', y='cvr', data=df, ax=axes[1])
axes[1].set_xticklabels(['Non-problematic', 'Problematic'])
axes[1].set_xlabel('Ad Group Category')
axes[1].set_ylabel('CVR')
axes[1].set_title('CVR Distribution: Problematic vs Non-problematic Ad Groups')
plt.tight_layout()
plt.savefig('ctr_cvr_boxplots.png', dpi=300)
plt.close()

# 4. Maybe a scatter of Intent Match Ratio vs CTR for problematic groups
plt.figure(figsize=(10, 6))
plt.scatter(problematic['ctr'], problematic['intent_match_ratio'], s=10, alpha=0.6)
plt.xlabel('CTR')
plt.ylabel('Intent Match Ratio')
plt.title('CTR vs Intent Match Ratio for High-CTR, Low-CVR Ad Groups')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('ctr_vs_intent_match_ratio.png', dpi=300)
plt.close()

print("Plots saved.")
```
