import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime

# Connect to database
conn = sqlite3.connect('/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-058/stage1_env/dacomp-058.sqlite')

# Load campaign report
df_campaign = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)

# Filter high-cost low-ROI (same as before)
df_filtered = df_campaign[(df_campaign['cost'] > 1000) & (df_campaign['roas'] < 1.8)].copy()

# Normalization function
def normalize(series, higher_better=True):
    if higher_better:
        return (series - series.min()) / (series.max() - series.min() + 1e-10)
    else:
        return (series.max() - series) / (series.max() - series.min() + 1e-10)

# Compute health scores (same as health_score.py)
df_filtered['conversion_value_per_conversion'] = np.where(
    df_filtered['conversions'] > 0,
    df_filtered['conversion_value'] / df_filtered['conversions'],
    0
)
for col in ['roas', 'cost_per_conversion', 'conversion_rate', 'quality_score', 'impression_share', 'ctr']:
    df_filtered[col] = df_filtered[col].fillna(df_filtered[col].median())

df_filtered['ce_roas'] = normalize(df_filtered['roas'], higher_better=True)
df_filtered['ce_cost_per_conversion'] = normalize(df_filtered['cost_per_conversion'], higher_better=False)
df_filtered['ce_conversion_rate'] = normalize(df_filtered['conversion_rate'], higher_better=True)
df_filtered['cost_efficiency_score'] = (df_filtered['ce_roas'] + df_filtered['ce_cost_per_conversion'] + df_filtered['ce_conversion_rate']) / 3

df_filtered['cq_quality_score'] = normalize(df_filtered['quality_score'], higher_better=True)
df_filtered['cq_conversion_rate'] = normalize(df_filtered['conversion_rate'], higher_better=True)
df_filtered['cq_value_per_conv'] = normalize(df_filtered['conversion_value_per_conversion'], higher_better=True)
df_filtered['conversion_quality_score'] = (df_filtered['cq_quality_score'] + df_filtered['cq_conversion_rate'] + df_filtered['cq_value_per_conv']) / 3

df_filtered['cp_impression_share'] = normalize(df_filtered['impression_share'], higher_better=True)
df_filtered['cp_ctr'] = normalize(df_filtered['ctr'], higher_better=True)
df_filtered['cp_quality_score'] = normalize(df_filtered['quality_score'], higher_better=True)
df_filtered['competitiveness_score'] = (df_filtered['cp_impression_share'] + df_filtered['cp_ctr'] + df_filtered['cp_quality_score']) / 3

df_filtered['health_score'] = (
    df_filtered['cost_efficiency_score'] * 0.4 +
    df_filtered['conversion_quality_score'] * 0.35 +
    df_filtered['competitiveness_score'] * 0.25
)

q25 = df_filtered['health_score'].quantile(0.25)
q75 = df_filtered['health_score'].quantile(0.75)
def risk_level(score):
    if score >= q75:
        return 'Low'
    elif score >= q25:
        return 'Medium'
    else:
        return 'High'
df_filtered['risk_level'] = df_filtered['health_score'].apply(risk_level)

print(f"High-risk campaigns (health score bottom 25%): {len(df_filtered[df_filtered['risk_level'] == 'High'])}")
print(f"Medium-risk: {len(df_filtered[df_filtered['risk_level'] == 'Medium'])}")
print(f"Low-risk: {len(df_filtered[df_filtered['risk_level'] == 'Low'])}")

# 1. Compare across campaign_type
print("\n=== Performance by Campaign Type ===")
campaign_type_summary = df_filtered.groupby('campaign_type').agg({
    'cost': 'sum',
    'conversions': 'sum',
    'roas': 'mean',
    'health_score': 'mean',
    'risk_level': lambda x: (x == 'High').sum()
}).round(2)
campaign_type_summary = campaign_type_summary.rename(columns={'risk_level': 'high_risk_count'})
print(campaign_type_summary)

# 2. Compare across bidding_strategy
print("\n=== Performance by Bidding Strategy ===")
bidding_summary = df_filtered.groupby('bidding_strategy').agg({
    'cost': 'sum',
    'conversions': 'sum',
    'roas': 'mean',
    'health_score': 'mean',
    'risk_level': lambda x: (x == 'High').sum()
}).round(2)
bidding_summary = bidding_summary.rename(columns={'risk_level': 'high_risk_count'})
print(bidding_summary)

# 3. Compare across industry
print("\n=== Performance by Industry ===")
industry_summary = df_filtered.groupby('industry').agg({
    'cost': 'sum',
    'conversions': 'sum',
    'roas': 'mean',
    'health_score': 'mean',
    'risk_level': lambda x: (x == 'High').sum()
}).round(2)
industry_summary = industry_summary.rename(columns={'risk_level': 'high_risk_count'})
print(industry_summary)

# 4. Geographic distribution (need geo_report)
df_geo = pd.read_sql_query("SELECT * FROM google_ads__geo_report", conn)
# Filter to same campaign-month pairs that are high-risk? Let's join with df_filtered on year_month and campaign_id
df_geo_merged = pd.merge(df_geo, df_filtered[['year_month', 'campaign_id', 'risk_level']], on=['year_month', 'campaign_id'], how='inner')
geo_summary = df_geo_merged.groupby('geo_target').agg({
    'cost': 'sum',
    'conversions': 'sum',
    'roas': 'mean',
    'risk_level': lambda x: (x == 'High').sum()
}).round(2)
geo_summary = geo_summary.rename(columns={'risk_level': 'high_risk_count'})
print("\n=== Performance by Geo Target (high-risk campaign-months) ===")
print(geo_summary)

# 5. Device type
df_device = pd.read_sql_query("SELECT * FROM google_ads__device_report", conn)
df_device_merged = pd.merge(df_device, df_filtered[['year_month', 'campaign_id', 'risk_level']], on=['year_month', 'campaign_id'], how='inner')
device_summary = df_device_merged.groupby('device_type').agg({
    'cost': 'sum',
    'conversions': 'sum',
    'roas': 'mean',
    'risk_level': lambda x: (x == 'High').sum()
}).round(2)
device_summary = device_summary.rename(columns={'risk_level': 'high_risk_count'})
print("\n=== Performance by Device Type (high-risk campaign-months) ===")
print(device_summary)

# 6. Avg_position from keyword_report (aggregate by campaign-month)
df_keyword = pd.read_sql_query("SELECT year_quarter, campaign_id, avg_position FROM google_ads__keyword_report", conn)
# year_quarter format like '2023-Q1'. Need to map to year_month? For simplicity, ignore quarter and aggregate by campaign_id only.
keyword_avg_pos = df_keyword.groupby('campaign_id')['avg_position'].mean().reset_index()
# Merge with filtered campaigns (campaign level, not monthly)
# We'll compute campaign-level health scores? Already have monthly; can average health score per campaign.
campaign_health = df_filtered.groupby('campaign_id').agg({
    'health_score': 'mean',
    'risk_level': lambda x: (x == 'High').mean()
}).reset_index()
campaign_health['risk_percentage'] = campaign_health['risk_level'] * 100
campaign_health = campaign_health.merge(keyword_avg_pos, on='campaign_id', how='left')
print("\n=== Avg Position vs Campaign Health (campaign level) ===")
print(campaign_health[['campaign_id', 'health_score', 'risk_percentage', 'avg_position']].head(10))
corr = campaign_health['health_score'].corr(campaign_health['avg_position'])
print(f"Correlation between health score and avg_position: {corr:.3f}")

# 7. Trend analysis: YoY growth rates
# Parse year_month to datetime
df_campaign['year_month_dt'] = pd.to_datetime(df_campaign['year_month'] + '-01', format='%Y-%m-%d')
df_campaign['year'] = df_campaign['year_month_dt'].dt.year
df_campaign['month'] = df_campaign['year_month_dt'].dt.month

# Compute monthly aggregates across all campaigns (or for high-risk campaigns?)
monthly_agg = df_campaign.groupby(['year', 'month']).agg({
    'cost': 'sum',
    'conversions': 'sum',
    'conversion_value': 'sum',
    'roas': 'mean'
}).reset_index()
# Compute YoY growth for same month
monthly_agg['roas_ly'] = monthly_agg.groupby('month')['roas'].shift(1)  # previous year same month
monthly_agg['yoy_growth_roas'] = (monthly_agg['roas'] - monthly_agg['roas_ly']) / monthly_agg['roas_ly']
monthly_agg['cost_ly'] = monthly_agg.groupby('month')['cost'].shift(1)
monthly_agg['yoy_growth_cost'] = (monthly_agg['cost'] - monthly_agg['cost_ly']) / monthly_agg['cost_ly']

print("\n=== YoY Growth Rates (all campaigns) ===")
print(monthly_agg[['year', 'month', 'roas', 'yoy_growth_roas', 'cost', 'yoy_growth_cost']].tail(12))

# Seasonal patterns: compute average roas by month across years
seasonal = monthly_agg.groupby('month').agg({
    'roas': 'mean',
    'cost': 'mean'
}).round(2)
print("\n=== Seasonal Patterns (average ROAS by month) ===")
print(seasonal)

conn.close()
```

