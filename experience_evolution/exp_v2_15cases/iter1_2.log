conn = sqlite3.connect('dacomp-093.sqlite')

# Load campaigns
query = """
SELECT 
    campaign_id,
    SUBJECT,
    scheduled_to_send_at,
    SENT_AT,
    is_archived,
    variation_id,
    total_count_unique_people,
    count_received_email,
    count_opened_email,
    count_clicked_email,
    count_placed_order,
    email_open_rate,
    email_click_to_open_rate,
    active_days,
    total_placed_orders,
    gmv_net_campaign
FROM klaviyo__campaigns
WHERE total_count_unique_people > 0
"""
df = pd.read_sql_query(query, conn)
print(f"Campaigns: {len(df)}")

# Feature engineering
def keyword_group(subject):
    if pd.isna(subject):
        return 'unknown'
    if '限时折扣' in subject:
        return 'discount'
    elif '新品上新' in subject:
        return 'new'
    elif '品牌故事' in subject:
        return 'storytelling'
    else:
        return 'other'

df['keyword_group'] = df['SUBJECT'].apply(keyword_group)

# Time window from subject
df['time_label'] = df['SUBJECT'].apply(lambda x: x.split('，')[-1].strip() if '，' in str(x) else '')

df['scheduled_dt'] = pd.to_datetime(df['scheduled_to_send_at'])
df['weekday'] = df['scheduled_dt'].dt.weekday
df['is_weekend'] = df['weekday'].isin([5,6])
df['hour'] = df['scheduled_dt'].dt.hour
def time_of_day(hour):
    if 5 <= hour < 12:
        return 'morning'
    elif 12 <= hour < 17:
        return 'afternoon'
    elif 17 <= hour < 22:
        return 'evening'
    else:
        return 'night'
df['time_of_day'] = df['hour'].apply(time_of_day)
df['is_before_holiday'] = df['SUBJECT'].str.contains('节前')

# Metrics
df['open_rate'] = df['email_open_rate']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open_rate'] = df['email_click_to_open_rate']
df['conversion_rate'] = df['count_placed_order'] / df['count_received_email']
df['gmv_per_email'] = df['gmv_net_campaign'] / df['count_received_email']

# Remove outliers in count_received_email (IQR)
Q1 = df['count_received_email'].quantile(0.25)
Q3 = df['count_received_email'].quantile(0.75)
IQR = Q3 - Q1
lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR
df_clean = df[(df['count_received_email'] >= lower) & (df['count_received_email'] <= upper)]
print(f"After outlier removal: {len(df_clean)} campaigns")

