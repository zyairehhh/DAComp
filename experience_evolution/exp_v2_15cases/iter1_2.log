Action: CreateFile(filepath="compute_percentile.py"):
```
import sqlite3
import pandas as pd

# Connect to database
conn = sqlite3.connect('dacomp-092.sqlite')
query = """
SELECT DISTINCT customer_id, customer_margin_volatility
FROM quickbooks__profitability_analysis
WHERE customer_margin_volatility IS NOT NULL;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Compute 75th percentile (top 25% highest volatility)
threshold = df['customer_margin_volatility'].quantile(0.75)
print(f"75th percentile threshold: {threshold}")

high_vol_customers = df[df['customer_margin_volatility'] >= threshold]
print(f"Number of high-volatility customers: {len(high_vol_customers)}")
print("First few high-volatility customers:")
print(high_vol_customers.head())
# Save to CSV for further use
high_vol_customers.to_csv('high_volatility_customers.csv', index=False)
```


