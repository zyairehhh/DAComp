Action: CreateFile(filepath='/workspace/durations.py':
'''
import sqlite3
import pandas as pd
import numpy as np

db_path = 'dacomp-098.sqlite'
conn = sqlite3.connect(db_path)

query = """
SELECT 
    ce.conversation_id,
    ce.conversation_initiated_type,
    ce.all_conversation_tags,
    cm.first_admin_response_at,
    ce.conversation_created_at,
    cm.time_to_first_response_minutes
FROM intercom__conversation_enhanced ce
LEFT JOIN intercom__conversation_metrics cm
 ON ce.conversation_id = cm.conversation_id
"""
df = pd.read_sql_query(query, conn)

def parse_tags(tag_str):
    if not tag_str:
        return {}
    tags = {}
    for pair in tag_str.split('|'):
        if ':' in pair:
            key, value = pair.split(':', 1)
            tags[key.strip()] = value.strip()
    return tags

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['topic'] = df['tags_dict'].apply(lambda d: d.get('topic', ''))

# Convert to datetime
df['first_admin_response_at'] = pd.to_datetime(df['first_admin_response_at'])
df['conversation_created_at'] = pd.to_datetime(df['conversation_created_at'])
df['response_time_minutes'] = (df['first_admin_response_at'] - df['conversation_created_at']).dt.total_seconds() / 60

print("Average response time (minutes) by stage and path:")
print(pd.pivot_table(df, values='response_time_minutes', index='stage', columns='conversation_initiated_type', aggfunc='mean'))

print("\nCount of conversations by stage and path:")
print(pd.crosstab(df['stage'], df['conversation_initiated_type']))

# Compute conversion rates (as before)
for path in ['human_first', 'bot_first']:
    sub = df[df['conversation_initiated_type']==path]
    total = sub.shape[0]
    print(f"\n--- {path} ---")
    for stage in ['demo_booked', 'trial_activated', 'closed_won']:
        cnt = sub[sub['stage']==stage].shape[0]
        print(f"{stage}: {cnt} ({cnt/total*100:.1f}%)")
    # Average response time
    print(f"Mean response time: {sub['response_time_minutes'].mean():.2f} minutes")

# Intent-topic combined analysis
print("\n--- Intent-Topic combination for bot_first vs human_first ---")
for intent in df['intent'].unique():
    if intent:
        for topic in df['topic'].unique():
            if topic:
                sub = df[(df['intent']==intent) & (df['topic']==topic)]
                if sub.shape[0] > 30:
                    human = sub[sub['conversation_initiated_type']=='human_first']
                    bot = sub[sub['conversation_initiated_type']=='bot_first']
                    human_demo = human[human['stage']=='demo_booked'].shape[0]
                    bot_demo = bot[bot['stage']=='demo_booked'].shape[0]
                    if human.shape[0] > 10 and bot.shape[0] > 10:
                        print(f"{intent}/{topic}: human demo {human_demo}/{human.shape[0]} ({human_demo/human.shape[0]*100:.1f}%), bot demo {bot_demo}/{bot.shape[0]} ({bot_demo/bot.shape[0]*100:.1f}%)")

conn.close()
''')
