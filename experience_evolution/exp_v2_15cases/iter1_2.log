print(f"Anomaly correlation: {anomaly_df['comprehensive_customer_score'].corr(anomaly_df['total_revenue']):.3f}")
print(f"Normal correlation: {normal_df['comprehensive_customer_score'].corr(normal_df['total_revenue']):.3f}")

# 4. Cluster analysis on anomaly customers to see if natural subgroups exist
# Features: trans_consistency_score, transaction_value_volatility, q1_prop, q2_prop, q3_prop, q4_prop, comprehensive_customer_score, total_revenue (maybe scaled)
anomaly_features = anomaly_df[['trans_consistency_score','transaction_value_volatility',
