```
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

# Connect to database
db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-070/stage2_env/dacomp-070.sqlite'
conn = sqlite3.connect(db_path)

# Query device-level monthly active devices
query = """
SELECT DATE(date_day) as month, device, 
       AVG(active_devices_last_30_days) as avg_active_devices
FROM google_play__device_report
WHERE date_day >= '2024-04-01' AND date_day < '2024-10-01'
GROUP BY strftime('%Y-%m', date_day), device
ORDER BY month, device;
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Convert month to datetime
df['month'] = pd.to_datetime(df['month'])
# Compute overall average per device to select top 6 devices (by total avg)
device_avg = df.groupby('device')['avg_active_devices'].mean().sort_values(ascending=False)
top_devices = device_avg.head(6).index.tolist()
df_top = df[df['device'].isin(top_devices)]

# Plot
plt.figure(figsize=(12,6))
for device in top_devices:
    sub = df_top[df_top['device']==device]
    plt.plot(sub['month'], sub['avg_active_devices'], marker='o', label=device, linewidth=2)
plt.title('Monthly Active Devices (Last 30 Days) - Top Devices (Apr-Sep 2024)', fontsize=16)
plt.xlabel('Month', fontsize=14)
plt.ylabel('Average Active Devices (millions)', fontsize=14)
# Format y axis to millions
ticks = plt.gca().get_yticks()
plt.gca().set_yticklabels([f'{int(tick/1e6)}M' for tick in ticks])
plt.legend(title='Device')
plt.grid(True, which='both', linestyle='--', linewidth=0.5)
plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%b'))
plt.gca().xaxis.set_major_locator(mdates.MonthLocator())
plt.tight_layout()
plt.savefig('device_active_decay.png', dpi=300)
plt.close()
```
