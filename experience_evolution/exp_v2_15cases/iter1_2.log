'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

conn = sqlite3.connect('dacomp-098.sqlite')

# Load data
query = """
SELECT 
    c.conversation_id,
    c.conversation_initiated_type,
    c.time_to_first_response_minutes,
    e.all_conversation_tags
FROM intercom__conversation_metrics c
LEFT JOIN intercom__conversation_enhanced e ON c.conversation_id = e.conversation_id
WHERE c.conversation_initiated_type IN ('bot_first', 'human_first')
"""
df = pd.read_sql_query(query, conn)

# Parse tags
def parse_tags(tag_str):
    d = {}
    if tag_str:
        for kv in tag_str.split('|'):
            if ':' in kv:
                k, v = kv.split(':', 1)
                d[k] = v
    return d

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
for key in ['stage', 'region', 'intent', 'lifecycle']:
    df[key] = df['tags_dict'].apply(lambda d: d.get(key, None))

# Drop rows with missing region
df_region = df.dropna(subset=['region'])
print("Regions present:", df_region['region'].unique())

# Compute conversion rate (closed_won) per region and init type
conversion_rates = df_region.groupby(['region', 'conversation_initiated_type']).apply(
    lambda g: (g['stage'] == 'closed_won').mean()
).reset_index(name='conv_rate')

# Pivot for plotting
pivot = conversion_rates.pivot(index='region', columns='conversation_initiated_type', values='conv_rate')
pivot = pivot.dropna()
print(pivot)

# Plot
ax = pivot.plot(kind='bar', figsize=(10,6))
ax.set_xlabel('Region')
ax.set_ylabel('Conversion Rate (Closed Won)')
ax.set_title('Conversion Rate by Region and First Response Type')
ax.legend(title='First Response')
plt.tight_layout()
plt.savefig('conversion_by_region_fixed.png', dpi=300)
plt.show()

# Also average response time by region
avg_time = df_region.groupby(['region', 'conversation_initiated_type'])['time_to_first_response_minutes'].mean().reset_index()
pivot_time = avg_time.pivot(index='region', columns='conversation_initiated_type', values='time_to_first_response_minutes')
pivot_time = pivot_time.dropna()
print(pivot_time)
pivot_time.plot(kind='bar', figsize=(10,6))
plt.xlabel('Region')
plt.ylabel('Average Time to First Response (minutes)')
plt.title('Average First Response Time by Region and Responder Type')
plt.legend(title='First Response')
plt.tight_layout()
plt.savefig('avg_response_time_by_region_fixed.png', dpi=300)
plt.show()
''')
