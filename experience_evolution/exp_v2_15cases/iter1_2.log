"""
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import re

conn = sqlite3.connect('dacomp-048.sqlite')
df = pd.read_sql_query("SELECT * FROM sheet1", conn)
conn.close()

# Function to parse salary range
def parse_salary_range(salary_str):
    if pd.isna(salary_str):
        return None, None
    s = salary_str.lower().replace(',', '').replace('，', '')
    match = re.search(r'(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)', s)
    if match:
        low = float(match.group(1))
        high = float(match.group(2))
        if low > high:
            low, high = high, low
        return low, high
    match_single = re.search(r'(\d+(?:\.\d+)?)\s*(?:yuan|rmb)', s)
    if match_single:
        val = float(match_single.group(1))
        return val, val
    return None, None

salary_ranges = df['Salary Range'].apply(parse_salary_range)
df['Salary_low'] = salary_ranges.apply(lambda x: x[0] if x else None)
df['Salary_high'] = salary_ranges.apply(lambda x: x[1] if x else None)
df['Salary_mid'] = (df['Salary_low'] + df['Salary_high']) / 2

# Filter vocational school
voc_mask = df['Education Requirement'].str.contains('vocational school', case=False, na=False)
df_voc = df[voc_mask].copy()

# Remove outliers: salary > 20000 likely errors or special cases
df_voc_clean = df_voc[df_voc['Salary_mid'] <= 20000].copy()

# 1. Salary distribution histogram
plt.figure(figsize=(10, 6))
n, bins, patches = plt.hist(df_voc_clean['Salary_mid'].dropna(), bins=30, edgecolor='black', alpha=0.7)
plt.xlabel('Monthly Salary Midpoint (yuan)', fontsize=12)
plt.ylabel('Frequency', fontsize=12)
plt.title('Starting Salary Distribution for Vocational School Graduates', fontsize=14)
plt.grid(True, alpha=0.3)
plt.savefig('salary_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# 2. Top benefits bar chart
benefits = df_voc['Benefits'].dropna()
all_benefits = []
for b in benefits:
    items = re.split(r'[,，、;；]', b)
    for item in items:
        item = item.strip()
        if item:
            all_benefits.append(item)
from collections import Counter
benefit_counts = Counter(all_benefits)
top_benefits = benefit_counts.most_common(15)

benefit_names = [b[0] for b in top_benefits]
benefit_values = [b[1] for b in top_benefits]

plt.figure(figsize=(12, 6))
bars = plt.barh(benefit_names, benefit_values, color='skyblue')
plt.xlabel('Count', fontsize=12)
plt.title('Top 15 Benefits for Vocational School Graduates', fontsize=14)
plt.gca().invert_yaxis()
for i, v in enumerate(benefit_values):
    plt.text(v + 10, i, str(v), va='center')
plt.tight_layout()
plt.savefig('benefits_distribution.png', dpi=300, bbox_inches='tight')
plt.close()

# 3. Salary by industry (top 10 industries)
industry_counts = df_voc_clean['Industry'].dropna().value_counts()
top_industries = industry_counts.head(10).index
df_top_ind = df_voc_clean[df_voc_clean['Industry'].isin(top_industries)]

plt.figure(figsize=(12, 7))
box_data = [df_top_ind[df_top_ind['Industry']==ind]['Salary_mid'].dropna().values for ind in top_industries]
bp = plt.boxplot(box_data, labels=top_industries, patch_artist=True)
for patch in bp['boxes']:
    patch.set_facecolor('lightblue')
plt.ylabel('Monthly Salary Midpoint (yuan)', fontsize=12)
plt.title('Salary Distribution by Top 10 Industries (Vocational School Graduates)', fontsize=14)
plt.xticks(rotation=45, ha='right')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('salary_by_industry.png', dpi=300, bbox_inches='tight')
plt.close()

# 4. Salary by work experience requirement
exp_counts = df_voc_clean['Work Experience Requirement'].dropna().value_counts()
top_exp = exp_counts.head(8).index
df_top_exp = df_voc_clean[df_voc_clean['Work Experience Requirement'].isin(top_exp)]

plt.figure(figsize=(10, 6))
exp_data = [df_top_exp[df_top_exp['Work Experience Requirement']==exp]['Salary_mid'].dropna().values for exp in top_exp]
bp = plt.boxplot(exp_data, labels=top_exp, patch_artist=True)
for patch in bp['boxes']:
    patch.set_facecolor('lightgreen')
plt.ylabel('Monthly Salary Midpoint (yuan)', fontsize=12)
plt.title('Salary Distribution by Work Experience Requirement (Vocational School Graduates)', fontsize=14)
plt.xticks(rotation=45, ha='right')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('salary_by_experience.png', dpi=300, bbox_inches='tight')
plt.close()

print("Visualizations created: salary_distribution.png, benefits_distribution.png, salary_by_industry.png, salary_by_experience.png")
