import sqlite3
import pandas as pd
import numpy as np

# Connect to database
conn = sqlite3.connect('dacomp-070.sqlite')

# 1. Decay patterns of user acquisition cost-efficiency for each region and device type combination over past 6 months.
# Since device type lacks conversion data, we'll analyze separately.

# 1a. Region decay: compute daily conversion rate per region
query_region = """
SELECT 
    date_day,
    region,
    SUM(store_listing_acquisitions) * 1.0 / SUM(store_listing_visitors) AS conversion_rate,
    SUM(store_listing_acquisitions) as acquisitions,
    SUM(store_listing_visitors) as visitors
FROM google_play__country_report
WHERE store_listing_visitors > 0
GROUP BY date_day, region
ORDER BY region, date_day;
"""
df_region = pd.read_sql_query(query_region, conn, parse_dates=['date_day'])
print("Region conversion rate sample:")
print(df_region.head())
print("Unique regions:", df_region['region'].unique())
print()

# Compute decay metric: slope of conversion rate over time per region using linear regression via numpy polyfit
region_slopes = {}
region_r2 = {}
for region in df_region['region'].unique():
    sub = df_region[df_region['region'] == region].copy()
    sub = sub.sort_values('date_day')
    if len(sub) < 10:
        continue
    # convert date to numeric days since start
    sub['days'] = (sub['date_day'] - sub['date_day'].min()).dt.days
    X = sub['days'].values
    y = sub['conversion_rate'].values
    # linear regression using polyfit degree 1
    coeffs = np.polyfit(X, y, 1)
    slope = coeffs[0]
    # compute R-squared
    p = np.poly1d(coeffs)
    yhat = p(X)
    ybar = np.mean(y)
    ssreg = np.sum((yhat - ybar)**2)
    sstot = np.sum((y - ybar)**2)
    r2 = ssreg / sstot if sstot != 0 else 0
    region_slopes[region] = slope
    region_r2[region] = r2
    print(f"Region: {region}, slope: {slope:.6f}, R2: {r2:.4f}")

# 1b. Device type decay: we can compute installs per device? Use device_report install_events per device over time.
query_device = """
SELECT 
    date_day,
    device,
    SUM(install_events) as installs,
    SUM(update_events) as updates,
    SUM(active_devices_last_30_days) as active_devices
FROM google_play__device_report
GROUP BY date_day, device
ORDER BY device, date_day;
"""
df_device = pd.read_sql_query(query_device, conn, parse_dates=['date_day'])
print("\nDevice data sample:")
print(df_device.head())

# Compute decay of installs per device over time (maybe installs per active device)
df_device['installs_per_active'] = df_device['installs'] / df_device['active_devices']
# Replace inf/nan
df_device.replace([np.inf, -np.inf], np.nan, inplace=True)
df_device.dropna(subset=['installs_per_active'], inplace=True)

device_slopes = {}
device_r2 = {}
for device in df_device['device'].unique()[:30]:  # limit to top devices
    sub = df_device[df_device['device'] == device].copy()
    sub = sub.sort_values('date_day')
    if len(sub) < 10:
        continue
    sub['days'] = (sub['date_day'] - sub['date_day'].min()).dt.days
    X = sub['days'].values
    y = sub['installs_per_active'].values
    coeffs = np.polyfit(X, y, 1)
    slope = coeffs[0]
    p = np.poly1d(coeffs)
    yhat = p(X)
    ybar = np.mean(y)
    ssreg = np.sum((yhat - ybar)**2)
    sstot = np.sum((y - ybar)**2)
    r2 = ssreg / sstot if sstot != 0 else 0
    device_slopes[device] = slope
    device_r2[device] = r2
    print(f"Device: {device[:30]}, slope: {slope:.6f}, R2: {r2:.4f}")

# 2. Non-linear relationship between store_listing_conversion_rate and quality_score / crash_rate_per_1k.
# Need to aggregate conversion rate per day and package globally.
query_global = """
SELECT 
    t.date_day,
    t.package_name,
    t.quality_score,
    t.crash_rate_per_1k,
    SUM(c.store_listing_acquisitions) * 1.0 / SUM(c.store_listing_visitors) AS conversion_rate
FROM google_play__time_series_trends t
LEFT JOIN google_play__country_report c ON t.date_day = c.date_day AND t.package_name = c.package_name
WHERE c.store_listing_visitors > 0
GROUP BY t.date_day, t.package_name
HAVING conversion_rate IS NOT NULL
ORDER BY t.date_day;
"""
df_global = pd.read_sql_query(query_global, conn, parse_dates=['date_day'])
print("\nGlobal conversion rate vs quality_score sample:")
print(df_global.head())
print(f"Rows: {df_global.shape[0]}")

# Drop rows where quality_score or crash_rate_per_1k is null
df_global.dropna(subset=['quality_score', 'crash_rate_per_1k', 'conversion_rate'], inplace=True)

# For each package, compute polynomial regression R2 for degree 2
packages = df_global['package_name'].unique()
print("\nNon-linear relationships per package (quadratic R2):")
print("Package, quality_R2, crash_R2")
results_nonlinear = []
for pkg in packages:
    sub = df_global[df_global['package_name'] == pkg].copy()
    if len(sub) < 30:
        continue
    # Fit quadratic regression for conversion_rate ~ quality_score using numpy polyfit
    X_q = sub['quality_score'].values
    y_q = sub['conversion_rate'].values
    coeffs_q = np.polyfit(X_q, y_q, 2)
    p_q = np.poly1d(coeffs_q)
    yhat_q = p_q(X_q)
    ssreg_q = np.sum((yhat_q - np.mean(y_q))**2)
    sstot_q = np.sum((y_q - np.mean(y_q))**2)
    r2_q = ssreg_q / sstot_q if sstot_q != 0 else 0
    # Fit quadratic for conversion_rate ~ crash_rate_per_1k
    X_c = sub['crash_rate_per_1k'].values
    y_c = sub['conversion_rate'].values
    coeffs_c = np.polyfit(X_c, y_c, 2)
    p_c = np.poly1d(coeffs_c)
    yhat_c = p_c(X_c)
    ssreg_c = np.sum((yhat_c - np.mean(y_c))**2)
    sstot_c = np.sum((y_c - np.mean(y_c))**2)
    r2_c = ssreg_c / sstot_c if sstot_c != 0 else 0
    results_nonlinear.append((pkg, r2_q, r2_c))
    print(f"{pkg}, {r2_q:.4f}, {r2_c:.4f}")

# 3. Construct a multi-dimensional user value decay model, predict optimization strategies for revenue_per_active_device under different market maturities.
query_rev = """
SELECT 
    date_day,
    package_name,
    revenue_per_active_device,
    active_devices,
    daily_installs,
    daily_uninstalls,
    daily_churn_rate,
    ma_7d_revenue,
    ma_30d_revenue,
    quality_score,
    crash_rate_per_1k
FROM google_play__time_series_trends
WHERE revenue_per_active_device IS NOT NULL AND active_devices > 0
ORDER BY package_name, date_day;
"""
df_rev = pd.read_sql_query(query_rev, conn, parse_dates=['date_day'])
print("\nRevenue per active device sample:")
print(df_rev.head())

# Compute cumulative installs per package as proxy for maturity
df_rev['cumulative_installs'] = df_rev.groupby('package_name')['daily_installs'].cumsum()
median_cum = df_rev['cumulative_installs'].median()
df_rev['maturity'] = df_rev['cumulative_installs'].apply(lambda x: 'high' if x > median_cum else 'low')

# Correlation matrix for low maturity
low = df_rev[df_rev['maturity'] == 'low'][['revenue_per_active_device', 'quality_score', 'crash_rate_per_1k', 'daily_churn_rate', 'active_devices']].corr()
high = df_rev[df_rev['maturity'] == 'high'][['revenue_per_active_device', 'quality_score', 'crash_rate_per_1k', 'daily_churn_rate', 'active_devices']].corr()
print("\nCorrelation with revenue_per_active_device for low maturity:")
print(low['revenue_per_active_device'].to_string())
print("\nCorrelation with revenue_per_active_device for high maturity:")
print(high['revenue_per_active_device'].to_string())

# 4. Quantify the interaction effect of app update frequency on active_devices_last_30_days and rolling_total_average_rating.
query_updates = """
SELECT 
    d.date_day,
    d.package_name,
    SUM(d.update_events) as daily_updates
FROM google_play__device_report d
GROUP BY d.date_day, d.package_name
ORDER BY d.date_day;
"""
df_updates = pd.read_sql_query(query_updates, conn, parse_dates=['date_day'])
# Join with country_report for active_devices_last_30_days and rolling_total_average_rating per package (aggregated across countries).
query_active_rating = """
SELECT 
    date_day,
    package_name,
    SUM(active_devices_last_30_days) as active_devices_last_30_days,
    AVG(rolling_total_average_rating) as avg_rolling_rating
FROM google_play__country_report
GROUP BY date_day, package_name;
"""
df_active_rating = pd.read_sql_query(query_active_rating, conn, parse_dates=['date_day'])
# Merge
df_interaction = pd.merge(df_updates, df_active_rating, on=['date_day', 'package_name'], how='inner')
print("\nInteraction data sample:")
print(df_interaction.head())
# Compute moving average of updates to get frequency (weekly average)
df_interaction['weekly_update_freq'] = df_interaction.groupby('package_name')['daily_updates'].transform(lambda x: x.rolling(window=7, min_periods=1).mean())
# Drop NA
df_interaction.dropna(subset=['weekly_update_freq', 'active_devices_last_30_days', 'avg_rolling_rating'], inplace=True)
# Correlation between weekly_update_freq and active_devices_last_30_days, avg_rolling_rating
corr_active = df_interaction['weekly_update_freq'].corr(df_interaction['active_devices_last_30_days'])
corr_rating = df_interaction['weekly_update_freq'].corr(df_interaction['avg_rolling_rating'])
print(f"\nCorrelation between update frequency and active devices: {corr_active:.4f}")
print(f"Correlation between update frequency and average rating: {corr_rating:.4f}")

# Additionally, we can compute interaction effect via regression with interaction term, but for simplicity we'll compute correlation per package and average.
print("\nInteraction effect per package (correlation between weekly_update_freq and active_devices_last_30_days):")
package_corrs = []
for pkg in df_interaction['package_name'].unique():
    sub = df_interaction[df_interaction['package_name'] == pkg]
    if len(sub) > 5:
        corr = sub['weekly_update_freq'].corr(sub['active_devices_last_30_days'])
        if not np.isnan(corr):
            package_corrs.append(corr)
print(f"Average correlation across packages: {np.mean(package_corrs):.4f}")
print(f"Std correlation: {np.std(package_corrs):.4f}")

conn.close()
```
