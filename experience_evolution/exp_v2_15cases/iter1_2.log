# Group by Drivetrain
drivetrain_stats = df.groupby('Drivetrain')['Depreciation_Ratio'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nDepreciation ratio by Drivetrain:")
print(drivetrain_stats)

# Extract brand from Title (first word)
df['Brand'] = df['Title'].apply(lambda x: str(x).split()[0] if pd.notna(x) else '')
brand_stats = df.groupby('Brand')['Depreciation_Ratio'].agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nDepreciation ratio by Brand (top 20):")
print(brand_stats.head(20))

# Consider age and mileage impact: compute correlation
corr_age = df[['Depreciation_Ratio', 'Age_years', 'Mileage_km']].corr()
print("\nCorrelation matrix (Depreciation_Ratio vs Age, Mileage):")
print(corr_age)

# High buyback value models: high depreciation ratio (holds value) and low age? Actually buyback value is the residual value. So we want high residual value (high used price relative to new). That's exactly depreciation ratio (higher is better). So we need to find models with high depreciation ratio, moderate mileage, etc.
# Let's compute average depreciation ratio by model (Title), but we need to group by model name (maybe first few words). We'll extract model by taking first 3 words? Let's examine.

def extract_model(title):
    words = str(title).split()
    # Take first 3 words if possible
    if len(words) >= 3:
        return ' '.join(words[:3])
    else:
        return ' '.join(words)

df['Model'] = df['Title'].apply(extract_model)
model_stats = df.groupby('Model')['Depreciation_Ratio'].agg(['mean', 'median', 'count', 'std']).sort_values('mean', ascending=False)
print("\nTop 20 models by Depreciation Ratio (holding value best):")
print(model_stats.head(20))

# Also compute absolute price retention: used price amount?
# We might also consider absolute price difference.
df['Price_Retention'] = df['Price_clean']  # used price
model_price = df.groupby('Model')['Price_clean'].agg(['mean', 'count']).sort_values('mean', ascending=False)
print("\nTop 20 models by average used price (high-end models):")
print(model_price.head(20))

# Save processed data for further exploration
df.to_csv('processed_cars.csv', index=False)
print("\nProcessed data saved to processed_cars.csv")
