# Visualization 3: Scatter of profit stability vs growth volatility colored by risk tier
plt.figure(figsize=(10,8))
sns.scatterplot(data=df_full, x='coeff_var', y='growth_var', hue='risk_tier', palette='viridis', s=80, alpha=0.7)
plt.xlabel('Coefficient of Variation of Gross Profit')
plt.ylabel('Variance of Invoice Growth Rate')
plt.title('Profit Stability vs Growth Volatility Colored by Risk Tier')
plt.legend(title='Risk Tier')
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('stability_vs_growth_risk.png')
plt.close()

# Visualization 4: Payment behavior across risk tiers
plt.figure(figsize=(10,6))
sns.countplot(data=df_full, x='risk_tier', hue='payment_behavior', palette='PuBu')
plt.xlabel('Risk Tier')
plt.ylabel('Count')
plt.title('Payment Behavior Distribution across Risk Tiers')
plt.legend(title='Payment Behavior', bbox_to_anchor=(1.05, 1))
plt.tight_layout()
plt.savefig('payment_by_risk_tier.png')
plt.close()

# Visualization 5: Overdue exposure across lifecycle stages
plt.figure(figsize=(10,6))
bp = sns.boxplot(data=df_full, x='lifecycle_stage', y='overdue_ratio', palette='coolwarm')
bp.set_xticklabels(bp.get_xticklabels(), rotation=45)
plt.xlabel('Lifecycle Stage')
plt.ylabel('Overdue Ratio (90+ days)')
plt.title('Overdue Exposure by Customer Lifecycle Stage')
plt.tight_layout()
plt.savefig('overdue_by_lifecycle.png')
plt.close()

print("Risk model visualizations saved.")
print(df_full[['customer_id', 'coeff_var', 'growth_var', 'overdue_ratio', 'risk_tier']].head(20).to_string())
conn.close()
