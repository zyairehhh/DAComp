import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-076.sqlite')
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)
conn.close()

# Compute segment average retention
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.rename(columns={'retention_probability': 'segment_avg_retention'}, inplace=True)
df = df.merge(segment_avg, on='profitability_segment', how='left')
df['retention_deviation'] = df['retention_probability'] - df['segment_avg_retention']
df['anomaly'] = df['retention_deviation'].abs() > 0.15

# Plot 1: Anomaly counts per segment
anomaly_counts = df.groupby('profitability_segment')['anomaly'].agg(['sum', 'count'])
anomaly_counts['proportion'] = anomaly_counts['sum'] / anomaly_counts['count'] * 100

fig, ax = plt.subplots(1, 2, figsize=(12, 5))
anomaly_counts['sum'].plot(kind='bar', ax=ax[0], color='coral')
ax[0].set_title('Number of Anomaly Customers per Segment')
ax[0].set_xlabel('Segment')
ax[0].set_ylabel('Count')
ax[0].tick_params(axis='x', rotation=45)

anomaly_counts['proportion'].plot(kind='bar', ax=ax[1], color='skyblue')
ax[1].set_title('Anomaly Proportion per Segment (%)')
ax[1].set_xlabel('Segment')
ax[1].set_ylabel('Percentage')
ax[1].tick_params(axis='x', rotation=45)
plt.tight_layout()
plt.savefig('anomaly_by_segment.png', dpi=150)
plt.close()

# Plot 2: Seasonal quarterly transaction distribution
df['total_transactions'] = df[['q1_transactions','q2_transactions','q3_transactions','q4_transactions']].sum(axis=1)
# Normalize per quarter as proportion
for q in ['q1','q2','q3','q4']:
    df[f'{q}_proportion'] = df[f'{q}_transactions'] / df['total_transactions'].replace(0,1)

anomaly_df = df[df['anomaly']]
normal_df = df[~df['anomaly']]

quarter_cols = ['q1_proportion','q2_proportion','q3_proportion','q4_proportion']
anomaly_avg = anomaly_df[quarter_cols].mean()
normal_avg = normal_df[quarter_cols].mean()

fig, ax = plt.subplots(figsize=(8,6))
index = range(4)
width = 0.35
bars1 = ax.bar(index, normal_avg.values, width, label='Normal', color='steelblue')
bars2 = ax.bar([i+width for i in index], anomaly_avg.values, width, label='Anomaly', color='lightcoral')
ax.set_title('Average Quarterly Transaction Proportion: Normal vs Anomaly')
ax.set_xlabel('Quarter')
ax.set_ylabel('Proportion')
ax.set_xticks([i+width/2 for i in index])
ax.set_xticklabels(['Q1','Q2','Q3','Q4'])
ax.legend()
plt.tight_layout()
plt.savefig('seasonal_proportions.png', dpi=150)
plt.close()

# Plot 3: Transaction value volatility vs retention deviation colored by segment
fig, ax = plt.subplots(figsize=(10,6))
scatter = ax.scatter(df['transaction_value_volatility'], df['retention_deviation'],
                     c=pd.Categorical(df['profitability_segment']).codes, alpha=0.7, cmap='tab10')
ax.set_title('Retention Deviation vs Transaction Value Volatility')
ax.set_xlabel('Transaction Value Volatility')
ax.set_ylabel('Retention Deviation')
plt.colorbar(scatter, label='Segment')
plt.tight_layout()
plt.savefig('volatility_vs_deviation.png', dpi=150)
plt.close()

# Plot 4: Categorical features - compare anomaly vs normal for key categories
categorical_cols = ['growth_potential', 'lifecycle_stage', 'activity_status', 'transaction_consistency']
for col in categorical_cols:
    cross = pd.crosstab(df[col], df['anomaly'], normalize='index') * 100
    cross = cross[[True, False]]  # ensure order anomaly then normal
    cross.columns = ['Anomaly %', 'Normal %']
    ax = cross.plot(kind='bar', stacked=False, figsize=(10,6), colormap='Set2')
    ax.set_title(f'{col.replace("_"," ").title()} Distribution: Anomaly vs Normal')
    ax.set_xlabel(col.replace('_',' ').title())
    ax.set_ylabel('Percentage')
    ax.legend()
    plt.tight_layout()
    plt.savefig(f'{col}_distribution.png', dpi=150)
    plt.close()

