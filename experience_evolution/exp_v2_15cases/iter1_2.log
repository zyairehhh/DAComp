import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-066.sqlite')
query = """
SELECT 
    r.job_title,
    e.departments,
    r.application_year,
    r.application_quarter,
    r.total_applications,
    r.total_interviews
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced e ON r.job_id = e.job_id
WHERE e.departments = 'Engineering' AND r.total_applications > 0
"""
df = pd.read_sql_query(query, conn)
conn.close()

def extract_role(title):
    lower = title.lower()
    if 'frontend' in lower:
        return 'Frontend'
    elif 'backend' in lower:
        return 'Backend'
    elif 'data' in lower or 'analytics' in lower:
        return 'Data Engineer'
    elif 'mobile' in lower:
        return 'Mobile Engineer'
    elif 'devops' in lower or 'sre' in lower:
        return 'DevOps/SRE'
    elif 'qa' in lower or 'quality' in lower:
        return 'QA Engineer'
    elif 'full stack' in lower:
        return 'Full Stack'
    elif 'engineer' in lower:
        return 'Other Engineer'
    else:
        return 'Other'

df['role'] = df['job_title'].apply(extract_role)
df['calc_rate'] = df['total_interviews'] / df['total_applications']

# Aggregate per role per quarter
group = df.groupby(['role', 'application_quarter']).agg(
    total_applications=('total_applications', 'sum'),
    total_interviews=('total_interviews', 'sum')
).reset_index()
group['conversion_rate'] = group['total_interviews'] / group['total_applications']

# Pivot for bar chart
pivot = group.pivot(index='role', columns='application_quarter', values='conversion_rate')
pivot = pivot.sort_values(by=3, ascending=False)  # sort by Q3 rate

ax = pivot.plot(kind='bar', figsize=(12,7), color=['skyblue', 'salmon'])
plt.title('Engineering Role Conversion Rates: Q3 vs Q4')
plt.xlabel('Role')
plt.ylabel('Conversion Rate (Interviews / Applications)')
plt.xticks(rotation=45, ha='right')
plt.legend(['Q3', 'Q4'], title='Quarter')
plt.grid(axis='y', linestyle='--', alpha=0.7)

# Annotate change
for i, role in enumerate(pivot.index):
    q3 = pivot.loc[role, 3]
    q4 = pivot.loc[role, 4]
    change = q4 - q3
    ax.text(i, max(q3, q4) + 0.01, f'{change:.3f}', ha='center', fontsize=9,
             color='red' if change < 0 else 'green')

plt.tight_layout()
plt.savefig('engineering_role_decline_barchart.png')
plt.close()

print("Saved engineering_role_decline_barchart.png")
print(pivot)
''')
