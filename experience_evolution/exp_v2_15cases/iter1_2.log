import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversations
conv_query = """
    SELECT company_id,
           all_conversation_tags,
           conversation_created_at,
           conversation_last_updated_at
    FROM intercom__conversation_enhanced
    WHERE company_id IS NOT NULL AND company_id != ''
"""
conv_df = pd.read_sql_query(conv_query, conn)

# Parse tags
def extract_tag(tags, key):
    if not isinstance(tags, str):
        return None
    start = tags.find(key + ':')
    if start == -1:
        return None
    start += len(key) + 1
    end = tags.find('|', start)
    if end == -1:
        return tags[start:]
    else:
        return tags[start:end]

conv_df['path'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'path'))
conv_df['intent'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'intent'))
conv_df['stage'] = conv_df['all_conversation_tags'].apply(lambda x: extract_tag(x, 'stage'))

# Identify responder group per company: bot-led if any conversation path='bot_first'
company_first_response = conv_df.groupby('company_id')['path'].apply(lambda x: 'bot' if (x == 'bot_first').any() else ('human' if (x == 'human_first').any() else None)).reset_index()
company_first_response = company_first_response.dropna()
company_response_counts = conv_df.groupby('company_id')['path'].apply(lambda x: ((x == 'bot_first').any(), (x == 'human_first').any())).reset_index()
company_response_counts.columns = ['company_id', 'has_bot', 'has_human']
print("Companies with bot/human:", company_response_counts.head())

# Actually we need to classify as per Stage1: bot-led if any bot_first, else human-led.
conv_df['responder_group'] = conv_df['path'].apply(lambda x: 'bot' if x == 'bot_first' else ('human' if x == 'human_first' else None))
company_first_response = conv_df.dropna(subset=['responder_group']).groupby('company_id')['responder_group'].apply(lambda x: 'bot' if (x == 'bot').any() else ('human' if (x == 'human').any() else None)).reset_index()
company_first_response = company_first_response.dropna()
company_first_response.columns = ['company_id', 'responder_group']

# Get stage timestamps per company
# We'll assume the latest conversation with each stage tag as the timestamp for that stage
# Actually we need timestamps for demo_booked, trial_activated, closed_won
# For simplicity, we'll take the max conversation_last_updated_at where stage contains the keyword.
def get_stage_timestamp(df, stage_keyword):
    stage_rows = df[df['stage'].notna() & df['stage'].str.contains(stage_keyword)]
    if stage_rows.empty:
        return None
    # take earliest timestamp? stage1 used first_response_at etc. We'll use conversation_created_at as proxy.
    # Use min conversation_created_at for that stage.
    return stage_rows['conversation_created_at'].min()

