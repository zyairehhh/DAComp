'''
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

print("Computing insights...")
# Load data
region_monthly = pd.read_csv('region_monthly.csv')
device_monthly = pd.read_csv('device_monthly.csv')
conversion_quality = pd.read_csv('conversion_quality.csv')

# 1. Decay patterns of user acquisition cost-efficiency per region and device type
print("\n1. Decay Patterns (slopes)")
print("Region conversion rate change per month:")
for region in region_monthly['region'].unique():
    sub = region_monthly[region_monthly['region'] == region]
    if len(sub) > 1:
        x = sub['months_since_start'].values
        y = sub['avg_conversion_rate'].values
        slope = np.polyfit(x, y, 1)[0]
        print(f"   {region}: {slope:+.6f} (positive means improving conversion)")

print("\nDevice active devices change per month (negative indicates decay):")
for device in device_monthly['device'].unique():
    sub = device_monthly[device_monthly['device'] == device]
    if len(sub) > 1:
        x = sub['months_since_start'].values
        y = sub['total_active_devices'].values
        slope = np.polyfit(x, y, 1)[0]
        print(f"   {device[:20]:20s} {slope:+.0f}")

# 2. Non-linear relationship between store_listing_conversion_rate and quality_score / crash_rate_per_1k
print("\n2. Non-linear Relationships")
# Compute polynomial fits
X_q = conversion_quality['quality_score'].values
y = conversion_quality['conversion_rate'].values
mask = ~np.isnan(X_q) & ~np.isnan(y)
X_q = X_q[mask]; y_q = y[mask]
if len(X_q) > 10:
    coeff_q = np.polyfit(X_q, y_q, 2)
    print(f"   Conversion_rate ~ Quality_score quadratic: coef2={coeff_q[0]:.5f}, coef1={coeff_q[1]:.5f}, const={coeff_q[2]:.5f}")
    # Find optimum quality (vertex)
    if coeff_q[0] != 0:
        vertex = -coeff_q[1] / (2*coeff_q[0])
        print(f"   Vertex at quality_score = {vertex:.2f}")
X_c = conversion_quality['crash_rate_per_1k'].values
mask = ~np.isnan(X_c) & ~np.isnan(y)
X_c = X_c[mask]; y_c = y[mask]
if len(X_c) > 10:
    coeff_c = np.polyfit(X_c, y_c, 2)
    print(f"   Conversion_rate ~ Crash_rate quadratic: coef2={coeff_c[0]:.5f}, coef1={coeff_c[1]:.5f}, const={coeff_c[2]:.5f}")
    if coeff_c[0] != 0:
        vertex_c = -coeff_c[1] / (2*coeff_c[0])
        print(f"   Vertex at crash_rate = {vertex_c:.2f}")

# 3. Multi-dimensional user value decay model & revenue per active device optimization
print("\n3. User Value Decay Model")
# Merge region_monthly with revenue per active device from conversion_quality
conversion_quality['date_day'] = pd.to_datetime(conversion_quality['date_day'])
conversion_quality['month'] = conversion_quality['date_day'].dt.to_period('M')
revenue_region = conversion_quality.groupby(['region', 'month']).agg({'revenue_per_active_device': 'mean'}).reset_index()
region_full = region_monthly.merge(revenue_region, on=['region','month'], how='left')
# Compute correlation of revenue with conversion, rating, etc.
if not region_full['revenue_per_active_device'].isnull().all():
    corr_conv = region_full['revenue_per_active_device'].corr(region_full['avg_conversion_rate'])
    corr_rate = region_full['revenue_per_active_device'].corr(region_full['avg_rating'])
    print(f"   Revenue per active device correlation with conversion rate: {corr_conv:.3f}")
    print(f"   Revenue per active device correlation with average rating: {corr_rate:.3f}")
    # Market maturity classification (using region slopes from active devices)
    region_growth = {}
    for region in region_monthly['region'].unique():
        sub = region_monthly[region_monthly['region'] == region]
        if len(sub) > 1:
            slope = np.polyfit(sub['months_since_start'], sub['total_active_devices'], 1)[0]
            region_growth[region] = slope
    print("   Market maturity (active device growth per month):")
    for region, slope in region_growth.items():
        maturity = "Mature" if slope < -100000 else "Growing" if slope > 0 else "Stable"
        print(f"      {region}: {slope:+.0f} ({maturity})")
    # Revenue per active device by maturity
    region_full['maturity'] = region_full['region'].map(lambda r: "Mature" if region_growth.get(r,0) < -100000 else "Growing")
    rev_by_maturity = region_full.groupby('maturity')['revenue_per_active_device'].mean()
    print(f"   Average revenue per active device: Mature = {rev_by_maturity.get('Mature',0):.5f}, Growing = {rev_by_maturity.get('Growing',0):.5f}")

# 4. Interaction effect of app update frequency on active devices and rating
print("\n4. Update Frequency Interaction")
# Load update events from DB
import sqlite3
conn = sqlite3.connect('dacomp-070.sqlite')
update_region = pd.read_sql_query("SELECT region, date_day, SUM(update_events) as total_updates FROM google_play__country_report GROUP BY region, date_day", conn)
update_region['date_day'] = pd.to_datetime(update_region['date_day'])
update_region['month'] = update_region['date_day'].dt.to_period('M')
update_region_monthly = update_region.groupby(['region','month']).agg({'total_updates':'sum'}).reset_index()
region_full = region_full.merge(update_region_monthly, on=['region','month'], how='left')
region_full['updates_per_device'] = region_full['total_updates'] / region_full['total_active_devices'].replace(0,np.nan)
# Correlation
corr_updates_active = region_full['updates_per_device'].corr(region_full['total_active_devices'])
corr_updates_rating = region_full['updates_per_device'].corr(region_full['avg_rating'])
print(f"   Region-level correlation updates per device vs active devices: {corr_updates_active:.3f}")
print(f"   Region-level correlation updates per device vs rating: {corr_updates_rating:.3f}")
# Quantile analysis
region_full['update_quartile'] = pd.qcut(region_full['updates_per_device'], q=4, labels=['Q1','Q2','Q3','Q4'])
quartile_means = region_full.groupby('update_quartile').agg({'total_active_devices':'mean','avg_rating':'mean'})
print("   Average active devices and rating by update frequency quartile:")
for q in ['Q1','Q2','Q3','Q4']:
    if q in quartile_means.index:
        print(f"      {q}: active devices {quartile_means.loc[q,'total_active_devices']:.0f}, rating {quartile_means.loc[q,'avg_rating']:.3f}")

conn.close()

print("\n--- Analysis Complete ---")
''')
