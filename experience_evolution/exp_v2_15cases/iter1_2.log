import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query("""
    SELECT * FROM sheet1
    WHERE "Booking Status" = 'Completed'
          AND "Ride Distance" > 0
          AND "Booking Value" IS NOT NULL
          AND "Driver Ratings" IS NOT NULL
""", conn)
conn.close()

df['fare_per_km'] = df['Booking Value'] / df['Ride Distance']

# Correlation between driver rating and fare per km overall
corr_overall = df['Driver Ratings'].corr(df['fare_per_km'])
print(f"Overall correlation (rating vs fare per km): {corr_overall:.4f}")
print()

# Correlation per vehicle type
for vtype in df['Vehicle Type'].unique():
    subset = df[df['Vehicle Type'] == vtype]
    if len(subset) > 10:
        corr = subset['Driver Ratings'].corr(subset['fare_per_km'])
        print(f"{vtype}: correlation = {corr:.4f} (n={len(subset)})")
print()

# Examine relationship: average fare per km per rating (rounded to 1 decimal)
df['rating_rounded'] = df['Driver Ratings'].round(1)
rating_fare = df.groupby('rating_rounded')['fare_per_km'].agg(['mean', 'count']).round(3)
print("Average fare per km by rating (rounded to 0.1):")
print(rating_fare.head(20))
print()

# Check if higher rating leads to more rides (already known)
rating_rides = df.groupby('rating_rounded').size().reset_index(name='rides')
print("Rides count by rating:")
print(rating_rides.head(20))
