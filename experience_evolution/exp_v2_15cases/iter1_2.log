'''
import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-066.sqlite')
query = """
SELECT 
    e.hiring_managers,
    e.departments,
    r.total_applications,
    r.total_interviews,
    r.interview_rate,
    e.overall_conversion_rate
FROM greenhouse__job_enhanced e
JOIN greenhouse__recruitment_performance r ON e.job_id = r.job_id
WHERE e.departments = 'Engineering' AND e.hiring_managers IS NOT NULL AND e.hiring_managers != ''
"""
df = pd.read_sql_query(query, conn)
conn.close()

df['calc_rate'] = df['total_interviews'] / df['total_applications']
df = df[df['total_applications'] > 0]

# Aggregate per hiring manager
hm_group = df.groupby('hiring_managers').agg(
    total_applications=('total_applications', 'sum'),
    total_interviews=('total_interviews', 'sum'),
    avg_interview_rate=('interview_rate', 'mean'),
    avg_overall_conversion=('overall_conversion_rate', 'mean'),
    job_count=('hiring_managers', 'count')
).reset_index()
hm_group['conversion_rate'] = hm_group['total_interviews'] / hm_group['total_applications']
hm_group = hm_group.sort_values('conversion_rate', ascending=False)

# Plot top and bottom 10
top10 = hm_group.head(10)
bottom10 = hm_group.tail(10)

fig, axes = plt.subplots(2, 1, figsize=(12,10))
axes[0].barh(top10['hiring_managers'], top10['conversion_rate'], color='green')
axes[0].set_title('Top 10 Engineering Hiring Managers by Interview Conversion Rate')
axes[0].set_xlabel('Conversion Rate (Interviews/Applications)')
axes[0].invert_yaxis()

axes[1].barh(bottom10['hiring_managers'], bottom10['conversion_rate'], color='red')
axes[1].set_title('Bottom 10 Engineering Hiring Managers by Interview Conversion Rate')
axes[1].set_xlabel('Conversion Rate (Interviews/Applications)')
axes[1].invert_yaxis()

plt.tight_layout()
plt.savefig('engineering_hiring_managers_conversion.png')
plt.close()

print("Saved engineering_hiring_managers_conversion.png")
print("Overall engineering average conversion rate:", hm_group['conversion_rate'].mean())
print("Lowest conversion rate managers:")
print(bottom10[['hiring_managers', 'conversion_rate', 'job_count']])
''')
