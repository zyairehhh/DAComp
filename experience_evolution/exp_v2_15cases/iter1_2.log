for intent in top_intents:
    if intent not in ['pricing', 'billing']:
        axes[1,0].bar(intent_subset.index, intent_subset.get(intent, 0), bottom=bottom, label=intent)
        bottom += intent_subset.get(intent, 0).values
axes[1,0].set_xlabel('Responder Group')
axes[1,0].set_ylabel('Conversation Count')
axes[1,0].set_title('Top Intents by Responder Group')
axes[1,0].legend(loc='upper left', fontsize=8)
axes[1,0].tick_params(axis='x', rotation=45)

# Stage counts per responder group (conversation level)
stage_counts = conv_df[conv_df['stage'].notna()].groupby(['responder_group_conv', 'stage']).size().unstack(fill_value=0)
common_stages = ['demo_booked', 'trial_activated', 'closed_won', 'closed_lost', 'proposal_sent']
available_stages = [s for s in common_stages if s in stage_counts.columns]
