import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os

# Connect to database
conn = sqlite3.connect('dacomp-066.sqlite')

# Query to get department, quarter, conversion rate
query = """
SELECT 
    e.departments,
    r.application_year,
    r.application_quarter,
    r.total_applications,
    r.total_interviews,
    r.interview_rate,
    e.overall_conversion_rate,
    r.job_title
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced e ON r.job_id = e.job_id
"""
df = pd.read_sql_query(query, conn)
conn.close()

print(df.head())
print(f"Total rows: {len(df)}")

# Compute conversion rate as total_interviews / total_applications
df['calc_interview_rate'] = df['total_interviews'] / df['total_applications']
df['calc_interview_rate'] = df['calc_interview_rate'].fillna(0)

# Filter out zero applications
df = df[df['total_applications'] > 0]

# Data range
print("Unique quarters:", df[['application_year', 'application_quarter']].drop_duplicates())

# 1. Plot conversion rate trend over quarters for Engineering vs Marketing
plt.figure(figsize=(10,6))
for dept in df['departments'].unique():
    sub = df[df['departments'] == dept]
    # group by quarter
    group = sub.groupby(['application_year', 'application_quarter'])['calc_interview_rate'].mean().reset_index()
    group['quarter_label'] = group['application_year'].astype(str) + 'Q' + group['application_quarter'].astype(str)
    plt.plot(group['quarter_label'], group['calc_interview_rate'], marker='o', label=dept)

plt.title('Average Interview Rate (Applications to Interviews) by Department')
plt.xlabel('Quarter')
plt.ylabel('Interview Rate (Interviews / Applications)')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('interview_rate_by_dept.png')
plt.close()

# 2. Identify specific roles within Engineering with worst decline
engineer_df = df[df['departments'] == 'Engineering'].copy()
# Extract role from job_title: assume pattern like "Frontend Engineer", "Backend Engineer", "Data Engineer"
# We'll try to categorize by keywords
roles = []
for title in engineer_df['job_title']:
    title_lower = title.lower()
    if 'frontend' in title_lower:
        roles.append('Frontend')
    elif 'backend' in title_lower:
        roles.append('Backend')
    elif 'data' in title_lower or 'analytics' in title_lower:
        roles.append('Data Engineer')
    elif 'mobile' in title_lower:
        roles.append('Mobile Engineer')
    elif 'devops' in title_lower or 'sre' in title_lower:
        roles.append('DevOps/SRE')
    elif 'qa' in title_lower or 'quality' in title_lower:
        roles.append('QA Engineer')
    elif 'full stack' in title_lower:
        roles.append('Full Stack')
    elif 'engineer' in title_lower:
        roles.append('Other Engineer')
    else:
        roles.append('Other')

engineer_df['role'] = roles
print("Role counts:", engineer_df['role'].value_counts())

# Compute conversion rate per role per quarter
engineer_df['calc_interview_rate'] = engineer_df['total_interviews'] / engineer_df['total_applications']
engineer_df = engineer_df.dropna(subset=['calc_interview_rate'])

# Pivot for line plot
role_pivot = engineer_df.pivot_table(index=['application_year', 'application_quarter'], columns='role', values='calc_interview_rate', aggfunc='mean')
role_pivot = role_pivot.reset_index()
role_pivot['quarter_label'] = role_pivot['application_year'].astype(str) + 'Q' + role_pivot['application_quarter'].astype(str)

plt.figure(figsize=(12,7))
for col in role_pivot.columns:
    if col not in ['application_year', 'application_quarter', 'quarter_label']:
        plt.plot(role_pivot['quarter_label'], role_pivot[col], marker='o', label=col)

plt.title('Interview Rate by Engineering Role Over Time')
plt.xlabel('Quarter')
plt.ylabel('Interview Rate')
plt.legend(title='Role')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('interview_rate_by_engineering_role.png')
plt.close()

# 3. Hiring managers conversion rate analysis
# Get hiring managers from enhanced table
conn = sqlite3.connect('dacomp-066.sqlite')
hm_query = """
SELECT 
    e.hiring_managers,
    e.departments,
    r.application_year,
    r.application_quarter,
    r.total_applications,
    r.total_interviews,
    r.interview_rate,
    e.overall_conversion_rate
FROM greenhouse__job_enhanced e
JOIN greenhouse__recruitment_performance r ON e.job_id = r.job_id
WHERE e.hiring_managers IS NOT NULL AND e.hiring_managers != ''
"""
hm_df = pd.read_sql_query(hm_query, conn)
conn.close()

hm_df['calc_interview_rate'] = hm_df['total_interviews'] / hm_df['total_applications']
hm_df = hm_df[hm_df['total_applications'] > 0]

# Aggregate per hiring manager, compute avg conversion rate across quarters
hm_agg = hm_df.groupby(['hiring_managers', 'departments']).agg(
    total_applications=('total_applications', 'sum'),
    total_interviews=('total_interviews', 'sum'),
    avg_interview_rate=('calc_interview_rate', 'mean'),
    count_jobs=('hiring_managers', 'count')
).reset_index()
hm_agg['overall_interview_rate'] = hm_agg['total_interviews'] / hm_agg['total_applications']
hm_agg = hm_agg.sort_values('overall_interview_rate')

# Plot top and bottom hiring managers (limited to 10 each for clarity)
top_managers = hm_agg.nlargest(10, 'overall_interview_rate')
bottom_managers = hm_agg.nsmallest(10, 'overall_interview_rate')

fig, axes = plt.subplots(2, 1, figsize=(12,10))
axes[0].barh(top_managers['hiring_managers'], top_managers['overall_interview_rate'], color='green')
axes[0].set_title('Top 10 Hiring Managers by Interview Rate')
axes[0].set_xlabel('Interview Rate')
axes[0].invert_yaxis()

axes[1].barh(bottom_managers['hiring_managers'], bottom_managers['overall_interview_rate'], color='red')
axes[1].set_title('Bottom 10 Hiring Managers by Interview Rate')
axes[1].set_xlabel('Interview Rate')
axes[1].invert_yaxis()

plt.tight_layout()
plt.savefig('hiring_managers_interview_rate.png')
plt.close()

# 4. Impact of number of interviewers and hiring manager experience
