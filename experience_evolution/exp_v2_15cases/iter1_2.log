```
import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-060.sqlite')

query = """
SELECT ad_group_id, ad_group_name, clicks, impressions, conversions,
       CASE WHEN impressions > 0 THEN CAST(clicks AS REAL) / impressions ELSE NULL END AS ctr,
       CASE WHEN clicks > 0 THEN CAST(conversions AS REAL) / clicks ELSE NULL END AS cvr
FROM google_ads__ad_group_report
WHERE impressions > 0 AND clicks > 0
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Ensure numeric
df['ctr'] = df['ctr'].astype(float)
df['cvr'] = df['cvr'].astype(float)

# compute percentiles
p75_ctr = df['ctr'].quantile(0.75)
p25_cvr = df['cvr'].quantile(0.25)

print(f"75th percentile CTR: {p75_ctr:.4f}")
print(f"25th percentile CVR: {p25_cvr:.4f}")

# Filter problematic ad groups: high CTR (> p75) and low CVR (< p25)
problematic = df[(df['ctr'] > p75_ctr) & (df['cvr'] < p25_cvr)]
print(f"Number of problematic ad groups: {problematic.shape[0]}")

# Save for later use
problematic.to_csv('problematic_ad_groups.csv', index=False)
df.to_csv('all_ad_groups.csv', index=False)

# Compute additional metrics: Intent Match Ratio = Actual CVR / Expected CVR
# Expected CVR can be average CVR across all ad groups, or maybe we can compute per campaign average later.
# For simplicity, use overall average CVR as baseline expectations.
avg_cvr = df['cvr'].mean()
problematic['intent_match_ratio'] = problematic['cvr'] / avg_cvr
# Save with additional metric
problematic.to_csv('problematic_with_intent_ratio.csv', index=False)

print("Average CVR:", avg_cvr)
print(problematic[['ad_group_id', 'ad_group_name', 'ctr', 'cvr', 'intent_match_ratio']].head())
```
