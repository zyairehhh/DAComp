import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-060.sqlite')

# Get problematic ad_group_ids (based on aggregated metrics)
agg_query = """
SELECT
    ad_group_id,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions
FROM google_ads__ad_group_report
GROUP BY ad_group_id
HAVING total_impressions > 0 AND total_clicks > 0
"""
agg_df = pd.read_sql_query(agg_query, conn)
agg_df['CTR'] = agg_df['total_clicks'] / agg_df['total_impressions']
agg_df['CVR'] = agg_df['total_conversions'] / agg_df['total_clicks']
ctr_75 = agg_df['CTR'].quantile(0.75)
cvr_25 = agg_df['CVR'].quantile(0.25)
problematic_ids = set(agg_df[(agg_df['CTR'] > ctr_75) & (agg_df['CVR'] < cvr_25)]['ad_group_id'])

# Get search term data for those ad groups
search_query = """
SELECT
    ad_group_id,
    search_term,
    search_term_match_type,
    SUM(clicks) AS clicks,
    SUM(conversions) AS conversions
FROM google_ads__search_term_report
GROUP BY ad_group_id, search_term, search_term_match_type
"""
search_df = pd.read_sql_query(search_query, conn)

# Filter problematic vs non-problematic
search_df['problematic'] = search_df['ad_group_id'].isin(problematic_ids)

# Compute conversion rate per search term
search_df['search_term_cvr'] = search_df['conversions'] / search_df['clicks']
# Aggregate by match type
match_type_summary = search_df.groupby(['problematic', 'search_term_match_type']).agg(
    total_clicks=('clicks', 'sum'),
    total_conversions=('conversions', 'sum')
).reset_index()
match_type_summary['cvr'] = match_type_summary['total_conversions'] / match_type_summary['total_clicks']

print("Search Term Match Type Performance:")
print(match_type_summary)

# Compute average CVR per search term for problematic vs non-problematic
avg_cvr = search_df.groupby(['problematic', 'search_term_match_type'])['search_term_cvr'].mean().reset_index()
print("\nAverage CVR per Search Term (by match type):")
print(avg_cvr)

# Compute proportion of clicks from irrelevant search terms
# Define irrelevant as search terms with zero conversions
irrelevant = search_df[search_df['conversions'] == 0]
irrelevant_clicks = irrelevant.groupby('problematic')['clicks'].sum().reset_index()
total_clicks = search_df.groupby('problematic')['clicks'].sum().reset_index()
irrelevant_merge = pd.merge(irrelevant_clicks, total_clicks, on='problematic', suffixes=('_irrelevant', '_total'))
irrelevant_merge['irrelevant_proportion'] = irrelevant_merge['clicks_irrelevant'] / irrelevant_merge['clicks_total']
print("\nProportion of clicks from search terms with zero conversions:")
print(irrelevant_merge)

conn.close()
''')
