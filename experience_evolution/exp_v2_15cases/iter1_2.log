    f.write(subject_perf[['subject_type','brand','campaign_count','weighted_open_rate','weighted_click_to_open_rate']].to_markdown(index=False))
    f.write("\n\n")
    
    f.write("### 2. Time‑Window Performance Within Each Subject Type\n")
    f.write("For each subject type, we compare the three time windows used by that brand.\n")
