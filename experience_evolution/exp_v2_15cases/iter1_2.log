import os
os.chdir('/workspace')
import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-060.sqlite')

# Aggregate ad_group_report per ad group
query = """
SELECT
    ad_group_id,
    ad_group_name,
    ad_group_type,
    status,
    campaign_name,
    SUM(clicks) AS total_clicks,
    SUM(impressions) AS total_impressions,
    SUM(conversions) AS total_conversions,
    SUM(spend) AS total_spend
FROM google_ads__ad_group_report
GROUP BY ad_group_id, ad_group_name, ad_group_type, status, campaign_name
HAVING total_impressions > 0 AND total_clicks > 0
"""
df = pd.read_sql_query(query, conn)

# Compute CTR and CVR
df['CTR'] = df['total_clicks'] / df['total_impressions']
df['CVR'] = df['total_conversions'] / df['total_clicks']

# Compute percentiles
ctr_75 = df['CTR'].quantile(0.75)
cvr_25 = df['CVR'].quantile(0.25)
print(f"75th percentile CTR: {ctr_75:.4f}")
print(f"25th percentile CVR: {cvr_25:.4f}")

# Identify problematic ad groups
problematic = df[(df['CTR'] > ctr_75) & (df['CVR'] < cvr_25)]
print(f"Number of problematic ad groups: {len(problematic)}")

# Compute overall average CVR as expected CVR
expected_cvr = df['CVR'].mean()
print(f"Overall average CVR (expected): {expected_cvr:.4f}")
problematic['Intent_Match_Ratio'] = problematic['CVR'] / expected_cvr

# Save problematic ad groups to CSV for further analysis
problematic.to_csv('/workspace/problematic_ad_groups.csv', index=False)
print(problematic[['ad_group_id', 'ad_group_name', 'campaign_name', 'CTR', 'CVR', 'Intent_Match_Ratio']].head())

conn.close()
```
