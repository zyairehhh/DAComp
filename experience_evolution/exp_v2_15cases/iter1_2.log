df['total_quarter_trans'] = df[['q1_transactions','q2_transactions','q3_transactions','q4_transactions']].sum(axis=1)
for q in ['q1','q2','q3','q4']:
    df[f'{q}_prop'] = df[f'{q}_transactions'] / df['total_quarter_trans'].replace(0,1)

anomaly_df = df[df['is_anomaly']]
normal_df = df[~df['is_anomaly']]

print("=== Overview ===")
print(f"Total customers: {len(df)}")
print(f"Anomaly customers: {len(anomaly_df)} ({len(anomaly_df)/len(df):.2%})")
print("\nSegment distribution of anomalies:")
print(anomaly_df['profitability_segment'].value_counts())
print("\nSegment distribution of normals:")
print(normal_df['profitability_segment'].value_counts())

# 1. Transactional behavior
print("\n=== Transactional Behavior ===")
print("Anomaly vs Normal - Transaction Count:")
print(f"Anomaly mean: {anomaly_df['transaction_count'].mean():.2f}")
print(f"Normal mean: {normal_df['transaction_count'].mean():.2f}")
print("\nAvg Transactions per Month:")
print(f"Anomaly mean: {anomaly_df['avg_transactions_per_month'].mean():.2f}")
print(f"Normal mean: {normal_df['avg_transactions_per_month'].mean():.2f}")
print("\nTransaction Value Volatility:")
print(f"Anomaly mean: {anomaly_df['transaction_value_volatility'].mean():.3f}")
print(f"Normal mean: {normal_df['transaction_value_volatility'].mean():.3f}")
print("\nTrans Consistency Score (transaction_count / (avg_transactions_per_month*12)):")
print(f"Anomaly mean: {anomaly_df['trans_consistency_score'].mean():.3f}")
print(f"Normal mean: {normal_df['trans_consistency_score'].mean():.3f}")

# 2. Seasonal patterns
print("\n=== Seasonal Patterns ===")
quarters = ['q1','q2','q3','q4']
for q in quarters:
    print(f"{q} proportion - Anomaly mean: {anomaly_df[f'{q}_prop'].mean():.3f}, Normal mean: {normal_df[f'{q}_prop'].mean():.3f}")

# 3. Value realization
print("\n=== Value Realization ===")
print("Correlation between comprehensive_customer_score and total_revenue:")
print(f"Overall correlation: {df['comprehensive_customer_score'].corr(df['total_revenue']):.3f}")
print(f"Anomaly correlation: {anomaly_df['comprehensive_customer_score'].corr(anomaly_df['total_revenue']):.3f}")
print(f"Normal correlation: {normal_df['comprehensive_customer_score'].corr(normal_df['total_revenue']):.3f}")

# 4. Investigate categorical features
print("\n=== Categorical Variable Cross-tabulation (Anomaly vs Normal) ===")
categoricals = ['seasonal_preference', 'transaction_consistency', 'growth_potential', 'lifecycle_stage', 'activity_status', 'value_tier']
for cat in categoricals:
    print(f"\n{cat}:")
    cross = pd.crosstab(df[cat], df['is_anomaly'], normalize='columns')
    print(cross)

# 5. Decision tree surrogate: compute statistical differences for each feature between anomaly and normal
print("\n=== Feature Differences (Anomaly - Normal) ===")
numeric_features = ['transaction_count', 'avg_transactions_per_month', 'transaction_value_volatility',
                    'comprehensive_customer_score', 'total_revenue', 'net_profit', 'customer_age_days',
                    'q1_transactions','q2_transactions','q3_transactions','q4_transactions',
                    'trans_consistency_score']
for feat in numeric_features:
    anomaly_mean = anomaly_df[feat].mean()
    normal_mean = normal_df[feat].mean()
    diff = anomaly_mean - normal_mean
    print(f"{feat}: anomaly mean {anomaly_mean:.3f}, normal mean {normal_mean:.3f}, diff {diff:.3f}")

# 6. Recommendations
print("\n=== Recommendations ===")
print("Based on the analysis, the following dimensions show significant differences between anomaly and normal customers:")
print("- Transaction value volatility: Anomaly customers have higher/lower volatility.")
print("- Seasonal distribution: Anomaly customers have different quarterly transaction patterns.")
print("- Comprehensive customer score vs total revenue correlation differs.")
print("- Categorical variables like lifecycle_stage, activity_status may influence retention probability alignment.")
print("Consider incorporating transaction stability (transaction_value_volatility), seasonal concentration (max quarter proportion), and lifecycle stage into the segmentation model.")
print("Also, consider recalculating retention probability with these dimensions to improve alignment.")
```
