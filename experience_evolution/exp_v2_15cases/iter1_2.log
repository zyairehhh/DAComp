import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-076.sqlite')
df = pd.read_sql_query("SELECT * FROM netsuite2_customer_analytics", conn)

# Compute segment averages
segment_avg = df.groupby('profitability_segment')['retention_probability'].mean().reset_index()
segment_avg.columns = ['profitability_segment', 'seg_avg_retention']

# Merge
df = df.merge(segment_avg, on='profitability_segment')
df['retention_diff'] = abs(df['retention_probability'] - df['seg_avg_retention'])
df['is_anomaly'] = df['retention_diff'] > 0.15

print("Segment averages:")
print(segment_avg)
print(f"\nTotal customers: {len(df)}")
print(f"Anomaly customers: {df['is_anomaly'].sum()}")
print(f"Anomaly proportion: {df['is_anomaly'].mean():.2%}")

# Save anomaly customers for further analysis
anomaly_df = df[df['is_anomaly']]
print("\nFirst few anomaly customers:")
print(anomaly_df[['customer_id', 'profitability_segment', 'retention_probability', 'seg_avg_retention', 'retention_diff']].head())
anomaly_df.to_csv('anomaly_customers.csv', index=False)
conn.close()
