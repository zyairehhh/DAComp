WHERE customer_margin_volatility IS NOT NULL
"""
df_vol = pd.read_sql(query, conn)
threshold = df_vol['customer_margin_volatility'].quantile(0.75)
high_vol_ids = df_vol[df_vol['customer_margin_volatility'] >= threshold]['customer_id'].tolist()

# Metrics for risk model
# 1. Profit stability: coefficient of variation of gross profit over last 12 months
max_date = pd.read_sql("SELECT MAX(transaction_date) FROM quickbooks__profitability_analysis", conn).iloc[0,0]
max_date = pd.to_datetime(max_date)
start_date = max_date - pd.DateOffset(months=12)

query = """
SELECT customer_id, transaction_date, gross_profit 
FROM quickbooks__profitability_analysis 
WHERE customer_id IN ({}) 
    AND transaction_date >= ? 
    AND transaction_date <= ?
""".format(','.join(['?']*len(high_vol_ids)))
params = high_vol_ids + [start_date.strftime('%Y-%m-%d'), max_date.strftime('%Y-%m-%d')]
df_profit = pd.read_sql(query, conn, params=params)
df_profit['transaction_date'] = pd.to_datetime(df_profit['transaction_date'])

coeff_vars = []
for cust in high_vol_ids:
    sub = df_profit[df_profit['customer_id'] == cust]['gross_profit']
    if len(sub) > 0:
        mean = sub.mean()
        std = sub.std()
        coeff = std / mean if mean != 0 else np.nan
        coeff_vars.append({'customer_id': cust, 'coeff_var': coeff, 'mean_gp': mean, 'std_gp': std})
    else:
        coeff_vars.append({'customer_id': cust, 'coeff_var': np.nan, 'mean_gp': np.nan, 'std_gp': np.nan})
df_cv = pd.DataFrame(coeff_vars)

# 2. Growth volatility: variance of quarter-over-quarter invoice_total growth rate
query = """
SELECT customer_id, revenue_year, revenue_quarter, SUM(invoice_total) as total_invoice
FROM quickbooks__profitability_analysis 
WHERE customer_id IN ({})
GROUP BY customer_id, revenue_year, revenue_quarter
ORDER BY customer_id, revenue_year, revenue_quarter
""".format(','.join(['?']*len(high_vol_ids)))
df_q = pd.read_sql(query, conn, params=high_vol_ids)

growth_vars = []
for cust in high_vol_ids:
    sub = df_q[df_q['customer_id'] == cust].sort_values(['revenue_year', 'revenue_quarter'])
    sub = sub.reset_index(drop=True)
    if len(sub) > 1:
        sub['prev_total'] = sub['total_invoice'].shift(1)
        sub['growth_rate'] = (sub['total_invoice'] - sub['prev_total']) / sub['prev_total']
        variance = sub['growth_rate'].var()
        growth_vars.append({'customer_id': cust, 'growth_var': variance})
    else:
        growth_vars.append({'customer_id': cust, 'growth_var': np.nan})
df_growth = pd.DataFrame(growth_vars)

# 3. Behavioral features from customer_analytics
query = """
SELECT customer_id, rfm_segment, payment_behavior, revenue_trend_correlation, 
       lifecycle_stage, customer_value_segment, credit_score, payment_timeliness_score,
       business_stability_score, transaction_volume_score, overall_customer_score
FROM quickbooks__customer_analytics 
WHERE customer_id IN ({})
""".format(','.join(['?']*len(high_vol_ids)))
df_behav = pd.read_sql(query, conn, params=high_vol_ids)

# Merge
df_metrics = pd.merge(df_cv, df_growth, on='customer_id', how='left')
df_metrics = pd.merge(df_metrics, df_behav, on='customer_id', how='left')

# 4. Financial risk from balance_sheet: exposure to overdue receivables
# We'll join with receivable data? Instead, we can compute each customer's overdue proportion.
query = """
SELECT customer_id, 
       SUM(CASE WHEN outstanding_balance > 0 AND (julianday(?) - julianday(transaction_date)) > 90 THEN outstanding_balance ELSE 0 END) as overdue_90,
       SUM(CASE WHEN outstanding_balance > 0 THEN outstanding_balance ELSE 0 END) as total_outstanding,
       SUM(invoice_total) as total_invoice
FROM quickbooks__profitability_analysis 
WHERE customer_id IN ({})
GROUP BY customer_id
""".format(','.join(['?']*len(high_vol_ids)))
params = high_vol_ids + [max_date.strftime('%Y-%m-%d')]
df_overdue = pd.read_sql(query, conn, params=params)
df_overdue['overdue_ratio'] = df_overdue['overdue_90'] / df_overdue['total_outstanding'].replace(0, np.nan)

# Merge
df_full = pd.merge(df_metrics, df_overdue, on='customer_id', how='left')

# 5. Risk rating model: combine metrics into a composite score
# Normalize each risk factor
risk_factors = df_full[['coeff_var', 'growth_var', 'overdue_ratio']].copy()
risk_factors.columns = ['profit_stability', 'growth_volatility', 'overdue_exposure']
risk_factors = risk_factors.fillna(risk_factors.median())

scaler = StandardScaler()
risk_factors_scaled = scaler.fit_transform(risk_factors)
# Higher values indicate higher risk. We'll invert profit_stability (since higher coeff var = higher risk) is already higher risk.
# No inversion needed.
df_full['risk_score'] = risk_factors_scaled.mean(axis=1)

# Add behavioral scores (higher score = lower risk)
behavioral_factors = df_full[['credit_score', 'payment_timeliness_score', 'business_stability_score', 'transaction_volume_score']].copy()
behavioral_factors = behavioral_factors.fillna(behavioral_factors.median())
scaler2 = StandardScaler()
behavioral_scaled = scaler2.fit_transform(behavioral_factors)
# Higher credit_score etc means lower risk, so invert
behavioral_risk = -behavioral_scaled.mean(axis=1)  # invert so higher is riskier
df_full['behavioral_risk_score'] = behavioral_risk

# Combine both
df_full['composite_risk_score'] = 0.6 * df_full['risk_score'] + 0.4 * df_full['behavioral_risk_score']

# Assign risk tiers
df_full['risk_tier'] = pd.qcut(df_full['composite_risk_score'], q=4, labels=['Low', 'Medium', 'High', 'Critical'])

# Visualization 1: Distribution of composite risk scores
plt.figure(figsize=(10,6))
sns.histplot(df_full['composite_risk_score'], kde=True, bins=30)
plt.xlabel('Composite Risk Score')
plt.ylabel('Frequency')
plt.title('Distribution of Composite Risk Scores among High-Volatility Customers')
plt.axvline(df_full['composite_risk_score'].median(), color='red', linestyle='--', label=f'Median = {df_full["composite_risk_score"].median():.2f}')
plt.legend()
plt.tight_layout()
plt.savefig('risk_distribution.png')
plt.close()

# Visualization 2: Risk tier vs RFM segment
cross = pd.crosstab(df_full['risk_tier'], df_full['rfm_segment'], normalize='index')
plt.figure(figsize=(12,6))
cross.plot(kind='bar', stacked=True, colormap='Set3')
plt.xlabel('Risk Tier')
plt.ylabel('Proportion')
plt.title('RFM Segment Composition within Each Risk Tier')
plt.legend(title='RFM Segment', bbox_to_anchor=(1.05, 1))
plt.tight_layout()
plt.savefig('risk_tier_rfm.png')
plt.close()

# Visualization 3: Scatter of profit stability vs growth volatility colored by risk tier
plt.figure(figsize=(10,8))
sns.scatterplot(data=df_full, x='coeff_var', y='growth_var', hue='risk_tier', palette='viridis', s=80, alpha=0.7)
plt.xlabel('Coefficient of Variation of Gross Profit')
plt.ylabel('Variance of Invoice Growth Rate')
plt.title('Profit Stability vs Growth Volatility Colored by Risk Tier')
plt.legend(title='Risk Tier')
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('stability_vs_growth_risk.png')
plt.close()

# Visualization 4: Payment behavior across risk tiers
plt.figure(figsize=(10,6))
sns.countplot(data=df_full, x='risk_tier', hue='payment_behavior', palette='PuBu')
plt.xlabel('Risk Tier')
plt.ylabel('Count')
plt.title('Payment Behavior Distribution across Risk Tiers')
plt.legend(title='Payment Behavior', bbox_to_anchor=(1.05, 1))
plt.tight_layout()
plt.savefig('payment_by_risk_tier.png')
plt.close()

# Visualization 5: Overdue exposure across lifecycle stages
plt.figure(figsize=(10,6))
bp = sns.boxplot(data=df_full, x='lifecycle_stage', y='overdue_ratio', palette='coolwarm')
bp.set_xticklabels(bp.get_xticklabels(), rotation=45)
plt.xlabel('Lifecycle Stage')
plt.ylabel('Overdue Ratio (90+ days)')
plt.title('Overdue Exposure by Customer Lifecycle Stage')
plt.tight_layout()
plt.savefig('overdue_by_lifecycle.png')
plt.close()

print("Risk model visualizations saved.")
print(df_full[['customer_id', 'coeff_var', 'growth_var', 'overdue_ratio', 'risk_tier']].head(20).to_string())
conn.close()
''')
