    AVG(q2_transactions * 1.0 / (q1_transactions + q2_transactions + q3_transactions + q4_transactions + 0.001)) AS avg_q2_proportion,
    AVG(q3_transactions * 1.0 / (q1_transactions + q2_transactions + q3_transactions + q4_transactions + 0.001)) AS avg_q3_proportion,
