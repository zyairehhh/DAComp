'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query("""
    SELECT * FROM sheet1
    WHERE "Booking Status" = 'Completed'
          AND "Ride Distance" > 0
          AND "Booking Value" IS NOT NULL
          AND "Driver Ratings" IS NOT NULL
""", conn)
conn.close()

# Average distance per ride by vehicle type
dist_summary = df.groupby('Vehicle Type').agg(
    rides=('Booking Value', 'count'),
    avg_distance=('Ride Distance', 'mean'),
    avg_fare_per_km=('Booking Value', lambda x: (x / df.loc[x.index, 'Ride Distance']).mean()),
    total_earnings=('Booking Value', 'sum')
).round(2)
dist_summary = dist_summary.sort_values('avg_fare_per_km', ascending=False)
print("Vehicle Type Performance:")
print(dist_summary)
print()

# Monthly earnings projection (data covers 8.3 months)
# Compute total earnings per month (assuming each month equal)
df['Date'] = pd.to_datetime(df['Date'], format='%Y/%m/%d')
earnings_by_month = df.groupby([df['Date'].dt.month, 'Vehicle Type'])['Booking Value'].sum().reset_index()
monthly_avg = earnings_by_month.groupby('Vehicle Type')['Booking Value'].mean().round(2)
print("Average Monthly Earnings per Vehicle Type:")
print(monthly_avg)
print("Projected Annual Earnings (12 months):")
print((monthly_avg * 12).round(2))
print()

# Rating impact: compute average rating per vehicle type, and total rides per rating bin
rating_dist = df.groupby(['Vehicle Type', 'Driver Ratings']).size().reset_index(name='count')
print("Sample rating distribution for Auto:")
print(rating_dist[rating_dist['Vehicle Type']=='Auto'].head())
print()

# Compute correlation between driver rating and per-km fare for each vehicle type
import scipy.stats as stats
for vtype in df['Vehicle Type'].unique():
    subset = df[df['Vehicle Type'] == vtype]
    if len(subset) > 10:
        corr = subset['Driver Ratings'].corr(subset['Booking Value'] / subset['Ride Distance'])
        print(f"{vtype}: correlation between rating and fare per km = {corr:.4f}")
''')
