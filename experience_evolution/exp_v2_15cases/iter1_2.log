    WHEN "Driver Ratings" >= 4.5 THEN "4.5-5.0"
    WHEN "Driver Ratings" >= 4.0 THEN "4.0-4.5"
    WHEN "Driver Ratings" >= 3.5 THEN "3.5-4.0"
