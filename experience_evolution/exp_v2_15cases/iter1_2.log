# Extract Model (first 3 words) for more granular analysis
def extract_model(title):
    words = str(title).split()
    if len(words) >= 3:
        return ' '.join(words[:3])
    else:
        return ' '.join(words)

df_clean['Model'] = df_clean['Title'].apply(extract_model)
model_stats = df_clean.groupby('Model')['Depreciation_Ratio']\
