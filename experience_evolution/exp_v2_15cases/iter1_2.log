'''
import sqlite3
import pandas as pd
import numpy as np
import re
from datetime import datetime

def clean_price(price_str):
    """Convert '551,400 yuan' to float 551400."""
    if pd.isna(price_str):
        return np.nan
    s = str(price_str).replace(',', '').replace('yuan', '').strip()
    match = re.search(r'[\d]+(?:\.\d+)?', s)
    if match:
        try:
            return float(match.group())
        except:
            return np.nan
    return np.nan

def clean_mileage(mileage_str):
    """Convert '0.41 ten thousand km' to km: 0.41 * 10000 = 4100 km.
       Convert '68,000 km' to 68000."""
    if pd.isna(mileage_str):
        return np.nan
    s = str(mileage_str).strip()
    if 'ten thousand km' in s:
        match = re.search(r'[\d,]+(?:\.\d+)?', s)
        if match:
            try:
                val = float(match.group().replace(',', ''))
                return val * 10000
            except:
                return np.nan
    elif 'km' in s:
        match = re.search(r'[\d,]+(?:\.\d+)?', s)
        if match:
            try:
                return float(match.group().replace(',', ''))
            except:
                return np.nan
    return np.nan

def compute_age(reg_date_str, ref_date='2025-01-01'):
    """Compute age in years from registration date to reference date."""
    if pd.isna(reg_date_str):
        return np.nan
    try:
        reg = pd.to_datetime(reg_date_str)
        ref = pd.to_datetime(ref_date)
        age = (ref - reg).days / 365.25
        return age
    except:
        return np.nan

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query("SELECT * FROM autohome;", conn)
conn.close()

print(f"Total rows: {len(df)}")

# Clean numeric columns
df['Price_yuan'] = df['Price'] * 10000  # Price column is in 10k yuan
df['NewPrice_yuan'] = df['New Car Price (incl. tax)'].apply(clean_price)
df['Mileage_km'] = df['Mileage'].apply(clean_mileage)
df['Age_years'] = df['Registration Date'].apply(lambda x: compute_age(x))

# Depreciation ratio: used price / new price
df['Depreciation_Ratio'] = df['Price_yuan'] / df['NewPrice_yuan']

# Remove outliers: ratio > 1.2 or < 0.1, also drop rows with missing values
df_clean = df.dropna(subset=['Depreciation_Ratio', 'Age_years', 'Mileage_km'])
df_clean = df_clean[(df_clean['Depreciation_Ratio'] >= 0.1) & (df_clean['Depreciation_Ratio'] <= 1.2)]
print(f"Rows after cleaning: {len(df_clean)}")

# Basic stats
print("\n=== Depreciation Ratio (Higher means higher buyback value) ===")
print(df_clean['Depreciation_Ratio'].describe())

# Group by Vehicle Class
class_stats = df_clean.groupby('Vehicle Class')['Depreciation_Ratio']\
    .agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nTop Vehicle Classes by Depreciation Ratio (retain value):")
print(class_stats.head(10))

# Group by Fuel Type
fuel_stats = df_clean.groupby('Fuel Type')['Depreciation_Ratio']\
    .agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nFuel Type analysis:")
print(fuel_stats)

# Group by Drivetrain
drivetrain_stats = df_clean.groupby('Drivetrain')['Depreciation_Ratio']\
    .agg(['mean', 'median', 'count']).sort_values('mean', ascending=False)
print("\nDrivetrain analysis:")
