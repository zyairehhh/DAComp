import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('dacomp-060.sqlite')

# Load ad group data with campaign info
query = """
SELECT campaign_id, ad_group_id, ad_group_name, clicks, impressions, conversions,
       CASE WHEN impressions > 0 THEN CAST(clicks AS REAL) / impressions ELSE NULL END AS ctr,
       CASE WHEN clicks > 0 THEN CAST(conversions AS REAL) / clicks ELSE NULL END AS cvr
FROM google_ads__ad_group_report
WHERE impressions > 0 AND clicks > 0
"""
df = pd.read_sql_query(query, conn)
conn.close()

df['ctr'] = df['ctr'].astype(float)
df['cvr'] = df['cvr'].astype(float)

# Percentiles
p75_ctr = df['ctr'].quantile(0.75)
p25_cvr = df['cvr'].quantile(0.25)

print(f"75th percentile CTR: {p75_ctr:.4f}")
print(f"25th percentile CVR: {p25_cvr:.4f}")

problematic = df[(df['ctr'] > p75_ctr) & (df['cvr'] < p25_cvr)]
print(f"Number of problematic ad groups: {problematic.shape[0]}")

# Compute campaign-level average CVR (expected CVR)
campaign_avg_cvr = df.groupby('campaign_id')['cvr'].mean().reset_index()
campaign_avg_cvr.rename(columns={'cvr':'expected_cvr'}, inplace=True)

# Merge expected CVR back to df
df = df.merge(campaign_avg_cvr, on='campaign_id', how='left')
problematic = problematic.merge(campaign_avg_cvr, on='campaign_id', how='left')

# Intent Match Ratio = Actual CVR / Expected CVR
problematic['intent_match_ratio'] = problematic['cvr'] / problematic['expected_cvr']

# Save problematic data with expected CVR and ratio
problematic.to_csv('problematic_ad_groups_with_expected_cvr.csv', index=False)
df.to_csv('all_ad_groups_with_expected_cvr.csv', index=False)

print("Average expected CVR across campaigns:", df['expected_cvr'].mean())
print(problematic[['ad_group_id', 'ad_group_name', 'ctr', 'cvr', 'expected_cvr', 'intent_match_ratio']].head())
''')
