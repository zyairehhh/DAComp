print("\n=== Vehicle Class Retention (min 5 samples) ===")
print(class_stats)

# Group by Fuel Type
fuel_stats = df.groupby('Fuel Type').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
).sort_values('avg_retention', ascending=False)
print("\n=== Fuel Type Retention ===")
print(fuel_stats)

# Extract brand from Title (first word)
df['brand'] = df['Title'].str.split().str[0]

brand_stats = df.groupby('brand').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
    avg_mileage=('mileage_km', 'mean'),
    avg_age=('age_years', 'mean'),
).sort_values('avg_retention', ascending=False)
print("\n=== Brand Retention (min 5 samples) ===")
brand_counts = brand_stats['count']
brand_stats = brand_stats[brand_counts >= 5]
print(brand_stats.head(20))

# Identify specific models with high retention and reasonable sample size
# Let's create a model column as first three words
df['model'] = df['Title'].str.split().str[:3].str.join(' ')
model_stats = df.groupby('model').agg(
    count=('retention_rate', 'size'),
    avg_retention=('retention_rate', 'mean'),
    avg_annual_depr=('annual_depreciation_pct', 'mean'),
    avg_age=('age_years', 'mean'),
    avg_mileage=('mileage_km', 'mean'),
    median_price=('used_price_yuan', 'median'),
).sort_values('avg_retention', ascending=False)

print("\n=== Top Models by Retention (min 3 samples) ===")
model_stats_filtered = model_stats[model_stats['count'] >= 3]
print(model_stats_filtered.head(20))

# Save to csv for further review
df.to_csv('processed_cars_detailed.csv', index=False)
print("\nDetailed data saved.")
''')
