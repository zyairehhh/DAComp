import pandas as pd
import sqlite3
import numpy as np

conn = sqlite3.connect('/workspace/dacomp-078.sqlite')
account_df = pd.read_sql_query("SELECT * FROM pendo__account", conn)
print("Account shape:", account_df.shape)

# Compute percentiles for sum_minutes
minutes = account_df['sum_minutes']
print("Percentiles for sum_minutes:")
for p in [10, 20, 30, 40, 50, 60, 70, 80, 90, 95]:
    val = np.percentile(minutes, p)
    print(f"  {p}%: {val}")

# Also for sum_events
events = account_df['sum_events']
print("\nPercentiles for sum_events:")
for p in [10, 20, 30, 40, 50, 60, 70, 80, 90, 95]:
    val = np.percentile(events, p)
    print(f"  {p}%: {val}")

# For avg_nps_rating
nps = account_df['avg_nps_rating']
print("\nAvg NPS rating distribution:")
print(nps.describe())

# We can define high-value as top 20% by combined score maybe.
# Let's create a simple baseline score: duration + frequency
# Normalize each metric
account_df['duration_norm'] = (minutes - minutes.min()) / (minutes.max() - minutes.min())
account_df['frequency_norm'] = (account_df['count_active_days'] - account_df['count_active_days'].min()) / (account_df['count_active_days'].max() - account_df['count_active_days'].min())
account_df['baseline_score'] = 0.5 * account_df['duration_norm'] + 0.5 * account_df['frequency_norm']

# Determine threshold for top 20%
threshold = np.percentile(account_df['baseline_score'], 80)
print(f"\nBaseline score (duration+frequency) top 20% threshold: {threshold}")
account_df['high_value_baseline'] = account_df['baseline_score'] >= threshold
print("High-value customers count:", account_df['high_value_baseline'].sum())

# Compute correlation between baseline score and other dimensions
corr_with_nps = account_df['baseline_score'].corr(account_df['avg_nps_rating'])
corr_with_events = account_df['baseline_score'].corr(account_df['sum_events'])
print(f"Correlation with avg NPS: {corr_with_nps:.3f}")
print(f"Correlation with total events: {corr_with_events:.3f}")

# Feature engineering ideas: add NPS, feature clicks, product area diversity, recency, etc.
# Let's join with visitor_feature to get feature engagement per account
visitor_df = pd.read_sql_query("SELECT account_id, visitor_id FROM pendo__visitor", conn)
feature_df = pd.read_sql_query("SELECT visitor_id, feature_id, sum_clicks, sum_minutes, count_active_days FROM pendo__visitor_feature", conn)
merged = pd.merge(visitor_df, feature_df, on='visitor_id', how='left')
# Aggregate per account
account_features = merged.groupby('account_id').agg(
    total_feature_clicks=('sum_clicks', 'sum'),
    total_feature_minutes=('sum_minutes', 'sum'),
    avg_feature_active_days=('count_active_days', 'mean')
).reset_index()
account_df = pd.merge(account_df, account_features, on='account_id', how='left')
print("\nAccount features shape after merge:", account_df.shape)

# Compute additional dimensions
account_df['feature_engagement'] = account_df['total_feature_clicks'] / account_df['sum_events']  # proportion of events that are feature clicks
account_df['avg_minutes_per_active_day'] = account_df['sum_minutes'] / account_df['count_active_days']
account_df['recency_days'] = (pd.to_datetime(account_df['last_event_on']) - pd.to_datetime(account_df['first_event_on'])).dt.days

print("\nSample high-value accounts (baseline):")
print(account_df[['account_id', 'sum_minutes', 'count_active_days', 'avg_nps_rating', 'baseline_score', 'high_value_baseline']].head(10))

conn.close()
```

