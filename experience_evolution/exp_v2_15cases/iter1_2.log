'''
import sqlite3
import pandas as pd

conn = sqlite3.connect('dacomp-066.sqlite')
# Engineering jobs only
query = """
SELECT
    r.*,
    j.departments,
    j.hiring_managers,
    j.avg_interviews_per_application,
    j.avg_job_rating,
    j.rating_completion_rate
FROM greenhouse__recruitment_performance r
JOIN greenhouse__job_enhanced j ON r.job_id = j.job_id
WHERE j.departments = 'Engineering'
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Role extraction
df['role'] = df['job_title'].apply(lambda x: x.split(' - ')[0] if ' - ' in x else x)

# 1. Role decline analysis
df['month'] = pd.to_datetime(df['job_created_at']).dt.to_period('M')
role_month = df.groupby(['role', 'month'])['interview_rate'].mean().reset_index()
role_pivot = role_month.pivot(index='role', columns='month', values='interview_rate')
role_pivot['decline_abs'] = role_pivot.iloc[:, -1] - role_pivot.iloc[:, 0]
role_pivot['decline_pct'] = role_pivot['decline_abs'] / role_pivot.iloc[:, 0] * 100
print("=== Role-wise Conversion Rate Monthly Average (%) ===")
print(role_pivot.round(2))
print("\n=== Roles with Most Severe Decline (absolute) ===")
print(role_pivot['decline_abs'].sort_values().head(3))

# 2. Hiring manager performance
manager_stats = df.groupby('hiring_managers').agg(
    job_count=('job_id', 'count'),
    avg_conversion=('interview_rate', 'mean'),
    std_conversion=('interview_rate', 'std'),
    total_interviews=('total_interviews', 'sum'),
    avg_interviews_per_app=('avg_interviews_per_application', 'mean')
).reset_index()
print("\n=== Hiring Manager Performance (Engineering) ===")
print(manager_stats.sort_values('avg_conversion').round(2))

# 3. Impact of interview intensity (avg_interviews_per_application)
df['intensity_group'] = pd.qcut(df['avg_interviews_per_application'], q=3, labels=['Low', 'Medium', 'High'])
group_impact = df.groupby('intensity_group')['interview_rate'].agg(['mean', 'std', 'count'])
print("\n=== Conversion Rate by Interview Intensity ===")
print(group_impact.round(2))

# 4. Average conversion for each role's interview intensity
role_intensity = df.groupby(['role', 'intensity_group'])['interview_rate'].mean().unstack()
print("\n=== Conversion Rate by Role and Interview Intensity ===")
print(role_intensity.round(2))

# 5. Statistical summary of overall conversion rates
print("\n=== Overall Engineering Conversion Rate Trend (Monthly) ===")
monthly = df.groupby('month')['interview_rate'].agg(['mean', 'std', 'count'])
print(monthly.round(2))

# Save to CSV for reference
role_pivot.to_csv('role_conversion.csv')
manager_stats.to_csv('manager_performance.csv')
''')
