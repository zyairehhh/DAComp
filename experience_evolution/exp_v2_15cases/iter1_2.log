```
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Connect to database
conn = sqlite3.connect('dacomp-058.sqlite')

# Load campaign report data
query = """
SELECT * FROM google_ads__campaign_report
"""
df = pd.read_sql_query(query, conn)

# Convert year_month to datetime
df['year_month'] = pd.to_datetime(df['year_month'], format='%Y-%m')

# Define health score dimensions
# 1. Cost Efficiency (40% weight) - based on ROAS (higher is better)
# Normalize ROAS to 0-100 scale
roas_min = df['roas'].min()
roas_max = df['roas'].max()
df['cost_efficiency'] = (df['roas'] - roas_min) / (roas_max - roas_min) * 100

# 2. Conversion Quality (35% weight) - based on conversion_rate and quality_score
# Normalize conversion_rate
conv_min = df['conversion_rate'].min()
conv_max = df['conversion_rate'].max()
df['conv_rate_norm'] = (df['conversion_rate'] - conv_min) / (conv_max - conv_min) * 100

# Normalize quality_score
qual_min = df['quality_score'].min()
qual_max = df['quality_score'].max()
df['qual_score_norm'] = (df['quality_score'] - qual_min) / (qual_max - qual_min) * 100

# Combined conversion quality score (average of normalized conversion rate and quality score)
df['conversion_quality'] = (df['conv_rate_norm'] + df['qual_score_norm']) / 2

# 3. Competitiveness (25% weight) - based on impression_share and ctr
# Normalize impression_share
imp_share_min = df['impression_share'].min()
imp_share_max = df['impression_share'].max()
df['imp_share_norm'] = (df['impression_share'] - imp_share_min) / (imp_share_max - imp_share_min) * 100

# Normalize ctr
ctr_min = df['ctr'].min()
ctr_max = df['ctr'].max()
df['ctr_norm'] = (df['ctr'] - ctr_min) / (ctr_max - ctr_min) * 100

# Combined competitiveness score (average of normalized impression share and CTR)
df['competitiveness'] = (df['imp_share_norm'] + df['ctr_norm']) / 2

# Compute overall health score with weights
df['health_score'] = (
    df['cost_efficiency'] * 0.4 + 
    df['conversion_quality'] * 0.35 + 
    df['competitiveness'] * 0.25
)

# Risk classification based on thresholds
# High-risk: health_score < 30 AND cost > 1000 AND roas < 0.8 (as per initial screening)
# Medium-risk: health_score between 30 and 60
# Low-risk: health_score >= 60
def classify_risk(row):
    if row['health_score'] < 30 and row['cost'] > 1000 and row['roas'] < 0.8:
        return 'High'
    elif row['health_score'] < 60:
        return 'Medium'
    else:
        return 'Low'

df['risk_level'] = df.apply(classify_risk, axis=1)

print("Health score statistics:")
print(df['health_score'].describe())

print("\nRisk level distribution:")
print(df['risk_level'].value_counts())

# Save the enriched dataframe to CSV for later use
df.to_csv('campaign_health_scores.csv', index=False)

conn.close()
```
