'''
import pandas as pd
import numpy as np

# Load enriched data
df = pd.read_csv('high_risk_campaigns_with_position.csv')
print(f"Total high-risk campaign-month rows: {len(df)}")

# Define thresholds for low performance (bottom 25% percentile)
thresholds = {}
for metric in ['cost_efficiency_score', 'conversion_quality_score', 'competitiveness_score']:
    thresholds[metric] = df[metric].quantile(0.25)

# For each row, identify which dimensions are below threshold
def diagnose(row):
    problems = []
    if row['cost_efficiency_score'] < thresholds['cost_efficiency_score']:
        problems.append('Cost Efficiency')
    if row['conversion_quality_score'] < thresholds['conversion_quality_score']:
        problems.append('Conversion Quality')
    if row['competitiveness_score'] < thresholds['competitiveness_score']:
        problems.append('Competitiveness')
    if not problems:
        return 'No major issues'
    else:
        return ', '.join(problems)

df['core_problems'] = df.apply(diagnose, axis=1)

# Recommendations mapping
def recommend(row):
    recs = []
    # Budget reallocation if cost efficiency low
    if row['cost_efficiency_score'] < thresholds['cost_efficiency_score']:
        recs.append('Consider reducing budget or shifting to higher-performing channels.')
    if row['conversion_quality_score'] < thresholds['conversion_quality_score']:
        recs.append('Improve landing page experience, adjust targeting to higher intent audiences.')
    if row['competitiveness_score'] < thresholds['competitiveness_score']:
        recs.append('Raise bids to increase impression share, improve ad relevance for better CTR.')
    # Device-specific: if device_type from device_report? Not in this df. We'll skip for now.
    # Geographic: if geo_target? not in df.
    # Keyword optimization if avg_position is high (bad)
    if 'avg_position_overall' in row and row['avg_position_overall'] > 3:
        recs.append('Optimize keywords: increase bids on high-intent keywords, add negative keywords.')
    # If impression_share low
    if row['impression_share'] < 0.5:
        recs.append('Increase budget or adjust bids to capture more impressions.')
    if row['quality_score'] < 5:
        recs.append('Improve ad relevance and landing page quality to raise Quality Score.')
    if row['ctr'] < 0.02:  # arbitrary threshold
        recs.append('Test new ad creatives, headlines to improve CTR.')
    if row['conversion_rate'] < 0.05:  # arbitrary
        recs.append('Optimize conversion funnel, offer stronger call-to-action.')
    return ' '.join(recs)

df['recommendations'] = df.apply(recommend, axis=1)

# Select columns for output
output_cols = ['year_month', 'campaign_id', 'campaign_name', 'campaign_type', 'bidding_strategy', 'industry',
               'cost', 'roas', 'health_score', 'risk_level', 'core_problems', 'recommendations']
result_df = df[output_cols].copy()
# Sort by risk_level (High first) and health_score ascending
risk_order = {'High': 0, 'Medium': 1, 'Low': 2}
result_df['risk_order'] = result_df['risk_level'].map(risk_order)
result_df = result_df.sort_values(['risk_order', 'health_score']).drop('risk_order', axis=1)

# Save to CSV
result_df.to_csv('campaign_optimization_plan.csv', index=False)
print("Saved optimization plan to campaign_optimization_plan.csv")
print("\nSample rows:")
print(result_df.head(10))

# Summary statistics
print("\n--- Problem Frequency ---")
print(result_df['core_problems'].value_counts())
print("\n--- Top Recommendations ---")
# Flatten recommendations and count common phrases (simplistic)
all_recs = ' '.join(result_df['recommendations']).split('.')
from collections import Counter
word_counts = Counter([rec.strip() for rec in all_recs if rec.strip()])
print("Most frequent recommendations:")
for rec, cnt in word_counts.most_common(10):
    if rec:
        print(f"{cnt}: {rec}")
''')
