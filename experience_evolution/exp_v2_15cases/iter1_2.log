import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib
matplotlib.use('Agg')

conn = sqlite3.connect('dacomp-022.sqlite')
query = '''
SELECT 
    "Vehicle Type",
    AVG(CASE WHEN "Booking Status" = 'Completed' THEN "Booking Value" / "Ride Distance" ELSE NULL END) as avg_per_km_fare,
    COUNT(*) as total_bookings,
    SUM(CASE WHEN "Booking Status" = 'Completed' THEN 1 ELSE 0 END) as completed,
    SUM(CASE WHEN "Cancelled Rides by Driver" = 1 THEN 1 ELSE 0 END) as driver_cancelled
FROM sheet1
GROUP BY "Vehicle Type";
'''
df = pd.read_sql_query(query, conn)
df['completion_rate'] = df['completed'] / df['total_bookings']
df['driver_cancellation_rate'] = df['driver_cancelled'] / df['total_bookings']
conn.close()

# Scatter plot: per-km fare vs completion rate, size by driver cancellation rate?
plt.figure(figsize=(8, 6))
colors = plt.cm.Set1(range(len(df)))
for idx, row in df.iterrows():
    plt.scatter(row['avg_per_km_fare'], row['completion_rate']*100, 
                s=row['driver_cancellation_rate']*500 + 50, 
                c=[colors[idx]], alpha=0.7, edgecolors='black')
    plt.text(row['avg_per_km_fare'], row['completion_rate']*100 + 0.1, 
             row['Vehicle Type'], fontsize=9, ha='center')
plt.xlabel('Average Fare per Kilometer (units/km)')
plt.ylabel('Completion Rate (%)')
plt.title('Trade-off: Per‑km Fare vs Completion Rate by Vehicle Type')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('fare_vs_completion_scatter.png', dpi=300)
plt.close()
print("Scatter plot saved as fare_vs_completion_scatter.png")
```)

