import sqlite3
import pandas as pd
import numpy as np

# Connect
conn = sqlite3.connect('dacomp-058.sqlite')

# Load campaign report
campaign_df = pd.read_sql_query("SELECT * FROM google_ads__campaign_report", conn)

# Load keyword report aggregated by campaign_id and year_quarter
keyword_agg = pd.read_sql_query("""
SELECT campaign_id, year_quarter,
       AVG(avg_position) as avg_position_agg,
       AVG(quality_score) as quality_score_keyword,
       AVG(impression_share) as impression_share_keyword,
       AVG(ctr) as ctr_keyword,
       AVG(conversion_rate) as conversion_rate_keyword
FROM google_ads__keyword_report
GROUP BY campaign_id, year_quarter
""", conn)

# Determine quarter from year_month (format YYYY-MM)
def month_to_quarter(ym):
    year, month = map(int, ym.split('-'))
    quarter = (month - 1) // 3 + 1
    return f"{year}-Q{quarter}"

campaign_df['year_quarter'] = campaign_df['year_month'].apply(month_to_quarter)

# Merge keyword aggregates
campaign_df = campaign_df.merge(keyword_agg, on=['campaign_id', 'year_quarter'], how='left')

# Fill missing avg_position with overall average
campaign_df['avg_position_agg'] = campaign_df['avg_position_agg'].fillna(campaign_df['avg_position_agg'].median())
campaign_df['quality_score_keyword'] = campaign_df['quality_score_keyword'].fillna(campaign_df['quality_score_keyword'].median())

# Define metrics for health score
# Cost Efficiency (40%): ROAS (higher better) and cost_per_conversion (lower better)
# Normalize each metric across dataset
def normalize(series, higher_better=True):
    if higher_better:
        return (series - series.min()) / (series.max() - series.min())
    else:
        return (series.max() - series) / (series.max() - series.min())

# Handle zeros to avoid division by zero
if campaign_df['roas'].std() == 0:
    campaign_df['roas_norm'] = 1
else:
    campaign_df['roas_norm'] = normalize(campaign_df['roas'], higher_better=True)

if campaign_df['cost_per_conversion'].std() == 0:
    campaign_df['cpcv_norm'] = 1
else:
    campaign_df['cpcv_norm'] = normalize(campaign_df['cost_per_conversion'], higher_better=False)

campaign_df['cost_efficiency'] = 0.7 * campaign_df['roas_norm'] + 0.3 * campaign_df['cpcv_norm']

# Conversion Quality (35%): conversion_rate, quality_score (from campaign)
if campaign_df['conversion_rate'].std() == 0:
    campaign_df['conv_rate_norm'] = 1
else:
    campaign_df['conv_rate_norm'] = normalize(campaign_df['conversion_rate'], higher_better=True)

if campaign_df['quality_score'].std() == 0:
    campaign_df['qual_score_norm'] = 1
else:
    campaign_df['qual_score_norm'] = normalize(campaign_df['quality_score'], higher_better=True)

campaign_df['conversion_quality'] = 0.5 * campaign_df['conv_rate_norm'] + 0.5 * campaign_df['qual_score_norm']

# Competitiveness (25%): impression_share, ctr, avg_position (from keyword)
if campaign_df['impression_share'].std() == 0:
    campaign_df['imp_share_norm'] = 1
else:
    campaign_df['imp_share_norm'] = normalize(campaign_df['impression_share'], higher_better=True)

if campaign_df['ctr'].std() == 0:
    campaign_df['ctr_norm'] = 1
else:
    campaign_df['ctr_norm'] = normalize(campaign_df['ctr'], higher_better=True)

if campaign_df['avg_position_agg'].std() == 0:
    campaign_df['avg_pos_norm'] = 1
else:
    campaign_df['avg_pos_norm'] = normalize(campaign_df['avg_position_agg'], higher_better=False)  # lower avg position is better

campaign_df['competitiveness'] = 0.4 * campaign_df['imp_share_norm'] + 0.3 * campaign_df['ctr_norm'] + 0.3 * campaign_df['avg_pos_norm']

# Overall health score weighted sum
campaign_df['health_score'] = 0.4 * campaign_df['cost_efficiency'] + 0.35 * campaign_df['conversion_quality'] + 0.25 * campaign_df['competitiveness']

# Risk level classification based on health score quartiles
def classify_risk(score):
    if score >= 0.7:
        return 'Low'
    elif score >= 0.4:
        return 'Medium'
    else:
        return 'High'

campaign_df['risk_level'] = campaign_df['health_score'].apply(classify_risk)

# Identify unhealthy campaigns (ROI < 0.8)
campaign_df['roi'] = campaign_df['roas'] - 1
unhealthy = campaign_df[campaign_df['roi'] < 0.8].copy()

print("Unhealthy campaigns count:", unhealthy.shape[0])
print("\nFirst few unhealthy rows:")
print(unhealthy[['campaign_id', 'year_month', 'roi', 'health_score', 'risk_level']].head())

# Save to CSV for inspection
campaign_df.to_csv('campaign_health_scores.csv', index=False)
unhealthy.to_csv('unhealthy_campaigns.csv', index=False)

conn.close()
```
