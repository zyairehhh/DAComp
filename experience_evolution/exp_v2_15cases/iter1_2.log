'''
import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-078.sqlite')
account_df = pd.read_sql_query('SELECT * FROM pendo__account', conn)
median_nps = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating'] = account_df['avg_nps_rating'].fillna(median_nps)
last_date = pd.to_datetime('2024-09-28')
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['recency_days'] = (last_date - account_df['last_event_on']).dt.days.clip(lower=0)
recency_inv = 1 / (account_df['recency_days'] + 1)
# composite as earlier
def minmax_scale(series):
    min_val = series.min()
    max_val = series.max()
    if max_val - min_val == 0:
        return pd.Series([0.5] * len(series))
    return (series - min_val) / (max_val - min_val)
scaled_features = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating']:
    scaled_features[col] = minmax_scale(account_df[col])
scaled_features['recency'] = minmax_scale(recency_inv)
scaled_features['consistency'] = minmax_scale(account_df['average_daily_minutes'])
weights = {
    'sum_minutes': 0.2,
    'count_active_days': 0.2,
    'count_feature_clicking_visitors': 0.15,
    'count_page_viewing_visitors': 0.1,
    'avg_nps_rating': 0.15,
    'recency': 0.1,
    'consistency': 0.1
}
composite_score = np.zeros(len(account_df))
for key, weight in weights.items():
    composite_score += scaled_features[key].values * weight
threshold_composite = np.percentile(composite_score, 70)
high_composite = (composite_score >= threshold_composite).astype(int)
account_df['high_composite'] = high_composite
# compute correlations with binary label
correlations = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating', 'average_daily_minutes']:
    correlations[col] = np.corrcoef(account_df[col], high_composite)[0,1]
correlations['recency_days'] = np.corrcoef(account_df['recency_days'], high_composite)[0,1]
for k, v in correlations.items():
    print(f'{k}: {v:.3f}')
# see if we can improve weight based on correlation magnitude
# normalize correlations
abs_corr = {k: abs(v) for k, v in correlations.items()}
abs_corr['recency_days'] = abs(correlations['recency_days'])  # we will invert later
# recency correlation sign negative? Let's see
print('Recency sign:', correlations['recency_days'])
''')
