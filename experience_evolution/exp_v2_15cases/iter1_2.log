import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-078.sqlite')
account_df = pd.read_sql_query('SELECT * FROM pendo__account', conn)
# fill missing avg_nps_rating with median
median_nps = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating'] = account_df['avg_nps_rating'].fillna(median_nps)
# define high-value as top 30% of sum_minutes (value proxy)
threshold = np.percentile(account_df['sum_minutes'], 70)
high_sum = (account_df['sum_minutes'] >= threshold).astype(int)
print('High value based on sum_minutes top 30%:', high_sum.sum())
# predict high-value using duration & frequency (median thresholds)
median_minutes = account_df['sum_minutes'].median()
median_days = account_df['count_active_days'].median()
pred = ((account_df['sum_minutes'] > median_minutes) & (account_df['count_active_days'] > median_days)).astype(int)
accuracy = (pred == high_sum).mean()
print(f'Accuracy using duration & frequency (median thresholds) predicting high sum_minutes: {accuracy:.2%}')
# multi-dimensional composite
def minmax_scale(series):
    min_val = series.min()
    max_val = series.max()
    if max_val - min_val == 0:
        return pd.Series([0.5] * len(series))
    return (series - min_val) / (max_val - min_val)
# recency
last_date = pd.to_datetime('2024-09-28')
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['recency_days'] = (last_date - account_df['last_event_on']).dt.days.clip(lower=0)
recency_inv = 1 / (account_df['recency_days'] + 1)
scaled_features = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating']:
    scaled_features[col] = minmax_scale(account_df[col])
scaled_features['recency'] = minmax_scale(recency_inv)
scaled_features['consistency'] = minmax_scale(account_df['average_daily_minutes'])
weights = {
    'sum_minutes': 0.2,
    'count_active_days': 0.2,
    'count_feature_clicking_visitors': 0.15,
    'count_page_viewing_visitors': 0.1,
    'avg_nps_rating': 0.15,
    'recency': 0.1,
    'consistency': 0.1
}
composite_score = np.zeros(len(account_df))
for key, weight in weights.items():
    composite_score += scaled_features[key].values * weight
threshold_composite = np.percentile(composite_score, 70)
high_composite = (composite_score >= threshold_composite).astype(int)
pred_dur_freq = ((account_df['sum_minutes'] > median_minutes) & (account_df['count_active_days'] > median_days)).astype(int)
accuracy_dur_freq = (pred_dur_freq == high_composite).mean()
print(f'Accuracy using duration & frequency (median) predicting high composite: {accuracy_dur_freq:.2%}')
# Multi-dimensional rule from earlier
median_feature = account_df['count_feature_clicking_visitors'].median()
median_page = account_df['count_page_viewing_visitors'].median()
median_nps = account_df['avg_nps_rating'].median()
median_recency = account_df['recency_days'].median()
median_consistency = account_df['average_daily_minutes'].median()
conditions = [
    account_df['sum_minutes'] > median_minutes,
    account_df['count_active_days'] > median_days,
    account_df['count_feature_clicking_visitors'] > median_feature,
    account_df['count_page_viewing_visitors'] > median_page,
    account_df['avg_nps_rating'] > median_nps,
    account_df['recency_days'] < median_recency,  # recency smaller is better
    account_df['average_daily_minutes'] > median_consistency
]
count_above = sum(conditions)
pred_multi = (count_above >= 4).astype(int)
accuracy_multi = (pred_multi == high_composite).mean()
print(f'Accuracy using multi-dimensional rule predicting high composite: {accuracy_multi:.2%}')
''')
