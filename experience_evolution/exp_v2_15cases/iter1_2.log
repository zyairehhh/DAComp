'''
import sqlite3
import pandas as pd
import numpy as np
conn = sqlite3.connect('dacomp-078.sqlite')
account_df = pd.read_sql_query('SELECT * FROM pendo__account', conn)
median_nps = account_df['avg_nps_rating'].median()
account_df['avg_nps_rating'] = account_df['avg_nps_rating'].fillna(median_nps)
last_date = pd.to_datetime('2024-09-28')
account_df['last_event_on'] = pd.to_datetime(account_df['last_event_on'])
account_df['recency_days'] = (last_date - account_df['last_event_on']).dt.days.clip(lower=0)
recency_inv = 1 / (account_df['recency_days'] + 1)
# compute correlation with high composite (as previous)
def minmax_scale(series):
    min_val = series.min()
    max_val = series.max()
    if max_val - min_val == 0:
        return pd.Series([0.5] * len(series))
    return (series - min_val) / (max_val - min_val)
scaled_features = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating']:
    scaled_features[col] = minmax_scale(account_df[col])
scaled_features['recency'] = minmax_scale(recency_inv)
scaled_features['consistency'] = minmax_scale(account_df['average_daily_minutes'])
weights = {
    'sum_minutes': 0.2,
    'count_active_days': 0.2,
    'count_feature_clicking_visitors': 0.15,
    'count_page_viewing_visitors': 0.1,
    'avg_nps_rating': 0.15,
    'recency': 0.1,
    'consistency': 0.1
}
composite_score = np.zeros(len(account_df))
for key, weight in weights.items():
    composite_score += scaled_features[key].values * weight
threshold_composite = np.percentile(composite_score, 70)
high_composite = (composite_score >= threshold_composite).astype(int)

# compute correlations for each raw feature (not scaled)
correlations = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 
            'count_page_viewing_visitors', 'avg_nps_rating', 'average_daily_minutes']:
    correlations[col] = np.corrcoef(account_df[col], high_composite)[0,1]
correlations['recency_days'] = np.corrcoef(account_df['recency_days'], high_composite)[0,1]
# recency correlation is negative; we want inverse relationship
print('Correlations:', correlations)
# define weight as absolute correlation
weights_corr = {}
for col in ['sum_minutes', 'count_active_days', 'count_feature_clicking_visitors', 'count_page_viewing_visitors', 'avg_nps_rating', 'average_daily_minutes']:
    # higher correlation, higher weight
    weights_corr[col] = abs(correlations[col])
# for recency, recency_days correlation negative, but we want recency_inv (positive effect), weight as absolute correlation
weights_corr['recency'] = abs(correlations['recency_days'])
# normalize weights to sum = 1
total = sum(weights_corr.values())
for k in weights_corr:
    weights_corr[k] = weights_corr[k] / total
print('Normalized correlation weights:', weights_corr)
# compute new composite score using normalized features and correlation weights
composite_score2 = np.zeros(len(account_df))
for key, weight in weights_corr.items():
    if key == 'recency':
        composite_score2 += scaled_features['recency'] * weight
    elif key == 'average_daily_minutes':
        composite_score2 += scaled_features['consistency'] * weight
    else:
        composite_score2 += scaled_features[key] * weight
threshold2 = np.percentile(composite_score2, 70)
high_composite2 = (composite_score2 >= threshold2).astype(int)
# accuracy of new score vs original composite? Not meaningful. Instead compute accuracy vs high_composite (ground truth)
accuracy_corr = (high_composite2 == high_composite).mean()
print(f'Accuracy of correlation-weighted composite: {accuracy_corr:.2%}')
# compare with duration+frequency baseline (median rule)
median_minutes = account_df['sum_minutes'].median()
median_days = account_df['count_active_days'].median()
pred_dur_freq = ((account_df['sum_minutes'] > median_minutes) & (account_df['count_active_days'] > median_days)).astype(int)
accuracy_baseline = (pred_dur_freq == high_composite).mean()
print(f'Baseline accuracy (duration & frequency): {accuracy_baseline:.2%}')
''')
