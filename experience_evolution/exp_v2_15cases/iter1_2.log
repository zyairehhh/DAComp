    if pd.isna(age_str):
        return 'No limit'
    s = str(age_str).lower()
    # Map common patterns
    if '18-25' in s:
        return '18-25 years old'
    elif '30-40' in s:
        return '30-40 years old'
    elif '25-38' in s:
        return '25-38 years old'
    elif '30-45' in s:
        return '30-45 years old'
    elif '28-45' in s:
        return '28-45 years old'
    else:
        return 'Other age range'

df_salary['age_category'] = df_salary['Age Requirement'].apply(categorize_age)
age_salary = df_salary.groupby('age_category')['lower_bound'].mean()
# Filter to categories of interest
age_categories_of_interest = ['18-25 years old', '30-40 years old', '25-38 years old', '30-45 years old', '28-45 years old', 'No limit']
age_salary_filtered = age_salary[age_salary.index.isin(age_categories_of_interest)].sort_values(ascending=False)

plt.figure(figsize=(10, 6))
ax = age_salary_filtered.plot(kind='bar', color='teal', edgecolor='black')
plt.title('Average Starting Salary by Age Requirement')
plt.xlabel('Age Requirement')
plt.ylabel('Average Starting Salary (RMB/month)')
plt.xticks(rotation=45, ha='right')
for i, v in enumerate(age_salary_filtered):
    ax.text(i, v + 50, f'{v:,.0f}', ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('salary_by_age.png', dpi=300)
plt.close()

print("Plots generated successfully.")
''')
