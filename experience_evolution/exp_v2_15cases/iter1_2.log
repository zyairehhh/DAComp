for bar, acc in zip(bars, accuracies):
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.005,
             f'{acc:.3f}', ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.savefig('model_comparison.png', dpi=300)
plt.close()

# 4. Confusion Matrix Heatmap
plt.figure(figsize=(8, 6))
confusion_matrix = np.array([[145, 26], [26, 803]])
labels = ['High-value', 'Not High-value']

sns.heatmap(confusion_matrix, annot=True, fmt='d', cmap='Blues',
            xticklabels=labels, yticklabels=labels)
plt.title('Confusion Matrix\n(Predicted vs Actual High-value Customers)', fontsize=14)
plt.xlabel('Predicted', fontsize=12)
plt.ylabel('Actual', fontsize=12)

plt.tight_layout()
plt.savefig('confusion_matrix.png', dpi=300)
plt.close()

print("Visualizations generated successfully!")
print("1. dimension_weights.png")
print("2. dimension_correlations.png")
print("3. model_comparison.png")
print("4. confusion_matrix.png")
