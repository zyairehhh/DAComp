Action: CreateFile(filepath='/workspace/plot3_nonlinear.py':
'''
import sqlite3
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression

db_path = '/Users/zhongyiliu/Desktop/data_agent/DAComp/methods/da-agent/output/deepseek-v3.2-evolve_exp_v2_15cases_iter2/dacomp-070/stage2_env/dacomp-070.sqlite'
conn = sqlite3.connect(db_path)

# Query conversion rate vs quality_score and crash_rate_per_1k
query = """
SELECT c.store_listing_conversion_rate as conversion, t.quality_score, t.crash_rate_per_1k
FROM google_play__country_report c 
JOIN google_play__time_series_trends t ON c.date_day = t.date_day AND c.package_name = t.package_name
WHERE c.store_listing_conversion_rate IS NOT NULL 
  AND t.quality_score IS NOT NULL 
  AND t.crash_rate_per_1k IS NOT NULL
LIMIT 5000;
"""  # limit to avoid memory
df = pd.read_sql_query(query, conn)
conn.close()

# Plot conversion vs quality_score
plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
x = df['quality_score'].values.reshape(-1,1)
y = df['conversion'].values
# Quadratic fit
poly = PolynomialFeatures(degree=2)
x_poly = poly.fit_transform(x)
model = LinearRegression()
model.fit(x_poly, y)
y_pred = model.predict(x_poly)
# Sort for smooth line
sorted_indices = np.argsort(x.flatten())
plt.scatter(x, y, alpha=0.1, s=5, color='blue', label='Data points')
plt.plot(x[sorted_indices], y_pred[sorted_indices], color='red', linewidth=2, label='Quadratic fit')
plt.title('Conversion Rate vs Quality Score', fontsize=14)
plt.xlabel('Quality Score', fontsize=12)
plt.ylabel('Store Listing Conversion Rate', fontsize=12)
plt.legend()
plt.grid(True, linestyle='--', alpha=0.5)

# Plot conversion vs crash_rate_per_1k
plt.subplot(1,2,2)
x2 = df['crash_rate_per_1k'].values.reshape(-1,1)
