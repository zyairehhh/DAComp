        sub = campaigns_clean[campaigns_clean['variation_id'] == var]
        w_open = weighted_avg(sub, 'email_open_rate', 'total_count_unique_people')
        w_click = weighted_avg(sub, 'email_click_to_open_rate', 'total_count_unique_people')
        print(f"variation_id={var}: campaigns={len(sub)}, weighted open={w_open:.4f}, click-to-open={w_click:.4f}")
    
    # 4. Retention by brand (from persons)
    persons = pd.read_sql_query("SELECT * FROM klaviyo__persons", conn)
    brand_retention = persons.groupby('ORGANIZATION').agg(
        avg_week=('active_retention_rate_week', 'mean'),
        avg_month=('active_retention_rate_month', 'mean'),
        person_count=('person_id', 'count')
    ).reset_index()
    brand_retention.rename(columns={'ORGANIZATION':'brand'}, inplace=True)
    print("\n=== Brand Retention Rates ===")
    print(brand_retention.to_string())
    
    # Merge to see correlation between campaign engagement and retention
    brand_perf = campaigns_clean.groupby('brand').apply(
        lambda x: pd.Series({
            'avg_open_rate': weighted_avg(x, 'email_open_rate', 'total_count_unique_people'),
            'avg_click_rate': weighted_avg(x, 'email_click_to_open_rate', 'total_count_unique_people'),
            'campaign_count': len(x)
        })
    ).reset_index()
    brand_merged = pd.merge(brand_perf, brand_retention, on='brand', how='inner')
    print("\n=== Brand-level Correlation ===")
    print(brand_merged[['brand','avg_open_rate','avg_click_rate','avg_week','avg_month']].to_string())
    # Compute correlation coefficients
    corr_open_week = np.corrcoef(brand_merged['avg_open_rate'], brand_merged['avg_week'])[0,1]
    corr_open_month = np.corrcoef(brand_merged['avg_open_rate'], brand_merged['avg_month'])[0,1]
    corr_click_week = np.corrcoef(brand_merged['avg_click_rate'], brand_merged['avg_week'])[0,1]
    corr_click_month = np.corrcoef(brand_merged['avg_click_rate'], brand_merged['avg_month'])[0,1]
    print(f"Correlation between open rate and week retention: {corr_open_week:.3f}")
    print(f"Correlation between open rate and month retention: {corr_open_month:.3f}")
    print(f"Correlation between click-to-open rate and week retention: {corr_click_week:.3f}")
    print(f"Correlation between click-to-open rate and month retention: {corr_click_month:.3f}")
    
    # 5. Top performing time windows overall (weighted open rate)
    overall_window = campaigns_clean.groupby('time_window').apply(
        lambda x: pd.Series({
            'weighted_open': weighted_avg(x, 'email_open_rate', 'total_count_unique_people'),
            'weighted_click': weighted_avg(x, 'email_click_to_open_rate', 'total_count_unique_people'),
            'campaign_count': len(x)
        })
    ).reset_index()
    overall_window = overall_window.sort_values('weighted_open', ascending=False)
    print("\n=== Time Window Performance (Overall) ===")
    print(overall_window.to_string())
    
    # 6. Write insights to markdown
    with open('stage1.md', 'w') as f:
        f.write("# Analysis of Email Send Timing and Subject Copy Effects\n\n")
        f.write("## Executive Summary\n")
        f.write("Based on 184 campaigns across 6 brands, we analyzed the impact of send time windows (weekday/weekend, morning/afternoon/evening, before holiday) and subject copy categories (Discount, New, Storytelling) on email engagement (open rate, click‑to‑open rate) and customer retention.\n\n")
        f.write("## Key Findings\n")
        f.write("1. **Subject copy is completely confounded with brand** – each brand uses only one subject type, so any differences in engagement or retention are inseparable from brand‑level characteristics.\n")
        f.write("2. **Time‑of‑send matters within each subject/brand** – certain windows consistently outperform others.\n")
        f.write("3. **Archived campaigns (is_archived = true) have slightly higher open rates** but represent a small subset of campaigns.\n")
        f.write("4. **A/B test variants (variation_id) show negligible differences** in engagement, indicating that variant copy or design changes had limited impact.\n")
        f.write("5. **Retention correlates positively with open/click rates** across brands, suggesting that brands with better email engagement retain customers better.\n\n")
        
        f.write("## Detailed Results\n")
        f.write("### 1. Engagement by Subject Type (Brand)\n")
        f.write("Weighted averages (weighted by audience size) of open rate and click‑to‑open rate for each subject category:\n")
        f.write("| Subject Type | Brand | Weighted Open Rate | Weighted Click‑to‑Open Rate |\n")
        f.write("|--------------|-------|-------------------|-----------------------------|\n")
        for st in subject_types:
            sub = campaigns_clean[campaigns_clean['subject_type'] == st]
            brand_name = sub['brand'].iloc[0] if len(sub) > 0 else ''
            w_open = weighted_avg(sub, 'email_open_rate', 'total_count_unique_people')
            w_click = weighted_avg(sub, 'email_click_to_open_rate', 'total_count_unique_people')
            f.write(f"| {st} | {brand_name} | {w_open:.3f} | {w_click:.3f} |\n")
        
        f.write("\n### 2. Time‑Window Performance Within Each Subject Type\n")
        f.write("For each subject type, we compare the three time windows used by that brand.\n")
        for st in subject_types:
            subset = campaigns_clean[campaigns_clean['subject_type'] == st]
            brand_name = subset['brand'].iloc[0] if len(subset) > 0 else ''
            f.write(f"\n**{st} ({brand_name})**\n")
            f.write("| Time Window | Campaigns | Weighted Open Rate | Weighted Click‑to‑Open Rate |\n")
            f.write("|-------------|-----------|-------------------|-----------------------------|\n")
            windows = subset['time_window'].unique()
            for w in windows:
                sub = subset[subset['time_window'] == w]
                w_open = weighted_avg(sub, 'email_open_rate', 'total_count_unique_people')
                w_click = weighted_avg(sub, 'email_click_to_open_rate', 'total_count_unique_people')
                f.write(f"| {w} | {len(sub)} | {w_open:.3f} | {w_click:.3f} |\n")
        
        f.write("\n### 3. Effect of is_archived and variation_id\n")
        f.write("| Group | Campaigns | Weighted Open Rate | Weighted Click‑to‑Open Rate |\n")
        f.write("|-------|-----------|-------------------|-----------------------------|\n")
        for archived in campaigns_clean['is_archived'].unique():
            sub = campaigns_clean[campaigns_clean['is_archived'] == archived]
            w_open = weighted_avg(sub, 'email_open_rate', 'total_count_unique_people')
            w_click = weighted_avg(sub, 'email_click_to_open_rate', 'total_count_unique_people')
            f.write(f"| is_archived={archived} | {len(sub)} | {w_open:.3f} | {w_click:.3f} |\n")
        for var in campaigns_clean['variation_id'].unique():
            sub = campaigns_clean[campaigns_clean['variation_id'] == var]
            w_open = weighted_avg(sub, 'email_open_rate', 'total_count_unique_people')
            w_click = weighted_avg(sub, 'email_click_to_open_rate', 'total_count_unique_people')
            f.write(f"| variation_id={var} | {len(sub)} | {w_open:.3f} | {w_click:.3f} |\n")
        
        f.write("\n### 4. Retention by Brand\n")
        f.write("Average active retention rates per brand (based on person‑level data):\n")
        f.write(brand_retention.to_markdown(index=False))
        
        f.write("\n\n### 5. Correlation Between Engagement and Retention\n")
        f.write("At brand level, open rate and click‑to‑open rate show moderate positive correlation with week‑ and month‑active retention.\n")
        f.write(f"- Open rate vs week retention correlation: {corr_open_week:.3f}\n")
        f.write(f"- Open rate vs month retention correlation: {corr_open_month:.3f}\n")
        f.write(f"- Click‑to‑open rate vs week retention correlation: {corr_click_week:.3f}\n")
        f.write(f"- Click‑to‑open rate vs month retention correlation: {corr_click_month:.3f}\n")
        
        f.write("\n### 6. Top‑Performing Time Windows (Overall)\n")
        f.write("Ranked by weighted open rate across all campaigns:\n")
        f.write(overall_window.to_markdown(index=False))
        
        f.write("\n## Recommendations\n")
        f.write("1. **Leverage best‑performing time windows** – “节前‑下午” (before‑holiday afternoon) consistently delivers the highest open and click rates across all subject types. Consider scheduling more campaigns in this window.\n")
        f.write("2. **Avoid low‑engagement windows** – “工作日‑下午” (weekday afternoon) yields the lowest engagement; shift those sends to morning or evening slots.\n")
        f.write("3. **Subject‑type selection is brand‑dependent** – Since each brand owns a distinct subject category, we cannot recommend switching subject types without cross‑brand experiments.\n")
        f.write("4. **Archived campaigns show slightly higher engagement** – Review archived campaign content for learnings that could be applied to active campaigns.\n")
        f.write("5. **A/B test variants have minimal impact** – Focus testing efforts on larger levers such as send timing or subject‑line wording within the same category.\n")
        f.write("6. **Improve retention via engagement** – The positive correlation between email engagement and retention suggests that boosting open/click rates (through better timing, personalization, or offer relevance) may also lift long‑term customer activity.\n")
        
        f.write("\n## Limitations\n")
        f.write("- **Confounding of subject and brand** – Each subject type is used by a single brand, making it impossible to isolate the effect of subject copy from brand‑specific factors.\n")
        f.write("- **Limited retention linkage** – Retention data is aggregated per person, not per campaign; we cannot attribute retention changes to specific send‑time or subject variations.\n")
        f.write("- **Small sample per cell** – Each time‑window × subject combination contains only 5–6 campaigns, limiting statistical power.\n")
        f.write("- **Holiday definition** – “节前” (before‑holiday) is not precisely defined; actual holiday periods may vary.\n")
    
    conn.close()
    print("\nDetailed report written to stage1.md")

if __name__ == '__main__':
    main()
