'''
import sqlite3
import pandas as pd
import numpy as np

# Load metrics
metrics = pd.read_csv('high_vol_metrics.csv')
print(f"Loaded metrics for {len(metrics)} customers")

# Connect to DB
conn = sqlite3.connect('dacomp-092.sqlite')

# Load relevant columns from customer_analytics
cols = ['customer_id', 'rfm_segment', 'payment_behavior', 'revenue_trend_correlation',
        'lifecycle_stage', 'credit_score', 'risk_assessment', 'customer_value_segment',
        'customer_maturity_stage', 'payment_timeliness_score', 'overdue_count_12m',
        'avg_payment_days_12m', 'days_since_last_invoice']
cust = pd.read_sql_query("SELECT " + ','.join(cols) + " FROM quickbooks__customer_analytics", conn)

# Merge
merged = pd.merge(metrics, cust, on='customer_id', how='left')
print(f"Merged rows: {merged.shape[0]}")

# Summary statistics of cv_gross_profit and var_qoq_growth
print("\\n--- Summary of volatility metrics ---")
print(merged[['cv_gross_profit', 'var_qoq_growth']].describe())

# Analyze distribution across rfm_segment
print("\\n--- RFM Segment distribution ---")
rfm_counts = merged['rfm_segment'].value_counts(dropna=False)
print(rfm_counts.head(20))
# Mean cv per segment
cv_by_rfm = merged.groupby('rfm_segment')['cv_gross_profit'].mean().sort_values(ascending=False)
print("\\nMean CV by RFM segment:")
print(cv_by_rfm.head(20))

# Analyze payment_behavior
print("\\n--- Payment Behavior distribution ---")
pay_counts = merged['payment_behavior'].value_counts(dropna=False)
print(pay_counts.head(20))
cv_by_pay = merged.groupby('payment_behavior')['cv_gross_profit'].mean().sort_values(ascending=False)
print("\\nMean CV by payment behavior:")
print(cv_by_pay.head(20))

# Analyze revenue_trend_correlation (continuous)
corr_cv = merged[['revenue_trend_correlation', 'cv_gross_profit']].corr().iloc[0,1]
print(f"\\nCorrelation between revenue_trend_correlation and cv_gross_profit: {corr_cv:.4f}")

# Analyze lifecycle_stage
print("\\n--- Lifecycle Stage distribution ---")
life_counts = merged['lifecycle_stage'].value_counts(dropna=False)
print(life_counts.head(20))
cv_by_life = merged.groupby('lifecycle_stage')['cv_gross_profit'].mean().sort_values(ascending=False)
print("\\nMean CV by lifecycle stage:")
print(cv_by_life.head(20))

# Save merged data for further analysis
merged.to_csv('high_vol_merged.csv', index=False)
print("\\nMerged dataset saved.")

conn.close()
''')
