import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
sns.set_style("whitegrid")

conn = sqlite3.connect('dacomp-098.sqlite')

# Load conversation metrics and enhanced
query = """
SELECT 
    c.conversation_id,
    c.conversation_initiated_type,
    c.conversation_created_at,
    c.first_admin_response_at,
    c.time_to_first_response_minutes,
    e.all_conversation_tags,
    e.all_contact_company_names
FROM intercom__conversation_metrics c
LEFT JOIN intercom__conversation_enhanced e ON c.conversation_id = e.conversation_id
WHERE c.conversation_initiated_type IN ('bot_first', 'human_first')
"""
df = pd.read_sql_query(query, conn)
print("Total conversations:", df.shape[0])
print(df.head())

# Parse tags into dictionary
def parse_tags(tag_str):
    d = {}
    if tag_str:
        for kv in tag_str.split('|'):
            if ':' in kv:
                k, v = kv.split(':', 1)
                d[k] = v
    return d

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
for key in ['path', 'intent', 'topic', 'stage', 'segment', 'region', 'lifecycle']:
    df[key] = df['tags_dict'].apply(lambda d: d.get(key, None))

# Check stages
print(df['stage'].value_counts())

# Define conversion events: stage = demo_booked, trial_activated, closed_won
# For each conversation, we have a stage, but we need per contact? Let's assume each conversation is independent.
# We'll compute conversion rates as proportion of conversations that reach each stage, given initiation type.

# Conversion rates per stage
grouped = df.groupby('conversation_initiated_type')['stage'].value_counts(normalize=False).unstack(fill_value=0)
print(grouped)
# Compute rates relative to total conversations per type
total_per_type = df['conversation_initiated_type'].value_counts()
conversion_rates = {}
for stage in ['demo_booked', 'trial_activated', 'closed_won']:
    if stage in grouped.columns:
        conversion_rates[stage] = grouped[stage] / total_per_type

print("Conversion rates:")
print(pd.DataFrame(conversion_rates))

# Plot conversion rates
fig, ax = plt.subplots(figsize=(10,6))
bar_width = 0.35
index = np.arange(len(conversion_rates.keys()))
bot_rates = [conversion_rates[stage].get('bot_first', 0) for stage in conversion_rates.keys()]
human_rates = [conversion_rates[stage].get('human_first', 0) for stage in conversion_rates.keys()]
bars1 = ax.bar(index, bot_rates, bar_width, label='Bot First', color='skyblue')
bars2 = ax.bar(index + bar_width, human_rates, bar_width, label='Human First', color='salmon')
ax.set_xlabel('Conversion Stage')
ax.set_ylabel('Conversion Rate (proportion of conversations)')
ax.set_title('Conversion Rate by First Response Type')
ax.set_xticks(index + bar_width / 2)
ax.set_xticklabels(conversion_rates.keys())
ax.legend()
plt.tight_layout()
plt.savefig('conversion_rates.png', dpi=300)
plt.close()

# Stage durations: we need timestamps for each stage transition.
# Since we don't have timestamps for each stage per conversation, we cannot compute durations.
# Instead, we can compute average time_to_first_response_minutes per type, perhaps.
# Also maybe we can compute time from conversation_created_at to first_admin_response_at (already time_to_first_response_minutes).
# But we need duration between stages. Not possible.
# Let's look at time_to_first_response_minutes distribution by type.
fig, ax = plt.subplots(figsize=(8,6))
for resp_type in ['bot_first', 'human_first']:
    subset = df[df['conversation_initiated_type'] == resp_type]
    subset['time_to_first_response_minutes'].dropna().hist(ax=ax, label=resp_type, alpha=0.7, bins=30)
ax.set_xlabel('Time to First Response (minutes)')
ax.set_ylabel('Frequency')
ax.set_title('Distribution of First Response Time by Responder Type')
ax.legend()
plt.savefig('first_response_time_dist.png', dpi=300)
plt.close()

# Also plot conversion rates by segment maybe.
if 'segment' in df.columns and df['segment'].notna().any():
    segment_conv = df.groupby(['conversation_initiated_type', 'segment'])['stage'].apply(lambda x: (x == 'demo_booked').mean()).reset_index()
    pivot = segment_conv.pivot(index='segment', columns='conversation_initiated_type', values='stage')
    pivot.plot(kind='bar', figsize=(10,6))
    plt.xlabel('Segment')
    plt.ylabel('Demo Booking Rate')
    plt.title('Demo Booking Rate by Segment and First Response Type')
    plt.legend(title='First Response')
    plt.tight_layout()
    plt.savefig('demo_booking_by_segment.png', dpi=300)
    plt.close()

# Intent analysis
if 'intent' in df.columns and df['intent'].notna().any():
    intent_counts = df.groupby(['conversation_initiated_type', 'intent']).size().unstack(fill_value=0)
    intent_counts.T.plot(kind='bar', stacked=True, figsize=(12,6))
    plt.xlabel('Intent')
    plt.ylabel('Number of Conversations')
    plt.title('Intent Distribution by First Response Type')
    plt.tight_layout()
    plt.savefig('intent_distribution.png', dpi=300)
    plt.close()

print("Plots saved.")
```



