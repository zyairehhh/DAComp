'''
import sqlite3
import pandas as pd
conn = sqlite3.connect('dacomp-022.sqlite')
df = pd.read_sql_query("""
    SELECT * FROM sheet1
    WHERE "Booking Status" = 'Completed'
          AND "Ride Distance" > 0
          AND "Booking Value" IS NOT NULL
          AND "Driver Ratings" IS NOT NULL
""", conn)
conn.close()
df['fare_per_km'] = df['Booking Value'] / df['Ride Distance']

def summary(rmin, rmax):
    sub = df[(df['Driver Ratings'] >= rmin) & (df['Driver Ratings'] < rmax)]
    return len(sub), sub['fare_per_km'].mean(), sub['Booking Value'].mean()

print("Bin\tRides\tAvg Fare/km\tAvg Booking")
print("3.0-3.5\t", *summary(3.0, 3.5))
print("3.5-4.0\t", *summary(3.5, 4.0))
print("4.0-4.5\t", *summary(4.0, 4.5))
print("4.5-5.0\t", *summary(4.5, 5.0))
print(">=4.5\t", len(df[df['Driver Ratings'] >= 4.5]), df[df['Driver Ratings'] >= 4.5]['fare_per_km'].mean(), df[df['Driver Ratings'] >= 4.5]['Booking Value'].mean())
''')
