'''
import pandas as pd
import numpy as np

# Load data
ad_metrics = pd.read_csv('ad_group_metrics.csv')
high_ctr_low_cvr = pd.read_csv('high_ctr_low_cvr.csv')
keyword_agg = pd.read_csv('keyword_agg.csv')
search_agg = pd.read_csv('search_term_agg.csv')

print('Ad groups total:', len(ad_metrics))
print('High CTR low CVR ad groups:', len(high_ctr_low_cvr))

# Compute overall CVR per match type from keyword_report (baseline)
keyword_overall = keyword_agg.groupby('keyword_match_type').agg(
    total_clicks=('clicks', 'sum'),
    total_conversions=('conversions', 'sum')
).reset_index()
keyword_overall['cvr'] = keyword_overall['total_conversions'] / keyword_overall['total_clicks']
print('Overall CVR per keyword match type:')
print(keyword_overall)

# Compute expected CVR per ad group based on keyword mix
# For each ad group, compute weighted expected CVR: sum(clicks_i * baseline_cvr_i) / sum(clicks_i)
baseline = dict(zip(keyword_overall['keyword_match_type'], keyword_overall['cvr']))
# Merge keyword_agg with baseline
keyword_agg['baseline_cvr'] = keyword_agg['keyword_match_type'].map(baseline)
keyword_agg['expected_conversions'] = keyword_agg['clicks'] * keyword_agg['baseline_cvr']
# Aggregate per ad_group_id
expected = keyword_agg.groupby('ad_group_id').agg(
    total_clicks=('clicks', 'sum'),
    total_expected_conversions=('expected_conversions', 'sum')
).reset_index()
expected['expected_cvr'] = expected['total_expected_conversions'] / expected['total_clicks']

# Merge with ad_metrics
ad_metrics = ad_metrics.merge(expected[['ad_group_id', 'expected_cvr']], on='ad_group_id', how='left')
ad_metrics['intent_match_ratio'] = ad_metrics['cvr'] / ad_metrics['expected_cvr']
print('Intent match ratio stats:')
print(ad_metrics['intent_match_ratio'].describe())

