import sqlite3
import pandas as pd
import numpy as np

db_path = 'dacomp-098.sqlite'
conn = sqlite3.connect(db_path)

query = """
SELECT 
    ce.conversation_id,
    ce.conversation_initiated_type,
    ce.all_conversation_tags
FROM intercom__conversation_enhanced ce
"""
df = pd.read_sql_query(query, conn)

def parse_tags(tag_str):
    if not tag_str:
        return {}
    tags = {}
    for pair in tag_str.split('|'):
        if ':' in pair:
            key, value = pair.split(':', 1)
            tags[key.strip()] = value.strip()
    return tags

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['segment'] = df['tags_dict'].apply(lambda d: d.get('segment', ''))
df['region'] = df['tags_dict'].apply(lambda d: d.get('region', ''))
df['intent'] = df['tags_dict'].apply(lambda d: d.get('intent', ''))
df['topic'] = df['tags_dict'].apply(lambda d: d.get('topic', ''))

print("Segment and region distribution:")
print(df['segment'].value_counts(dropna=False).head())
print(df['region'].value_counts(dropna=False).head())

# Conversion rates by segment
print("\n=== Demo booked rate by segment and path ===")
for seg in df['segment'].unique():
    if seg:
        sub = df[df['segment']==seg]
        total = sub.shape[0]
        human = sub[sub['conversation_initiated_type']=='human_first']
        bot = sub[sub['conversation_initiated_type']=='bot_first']
        human_demo = human[human['stage']=='demo_booked'].shape[0]
        bot_demo = bot[bot['stage']=='demo_booked'].shape[0]
        if total > 100:
            print(f"{seg}: total {total}, human demo {human_demo}/{human.shape[0]} ({human_demo/human.shape[0]*100 if human.shape[0] else 0:.1f}%), bot demo {bot_demo}/{bot.shape[0]} ({bot_demo/bot.shape[0]*100 if bot.shape[0] else 0:.1f}%)")

print("\n=== Trial activated rate by segment and path ===")
for seg in df['segment'].unique():
    if seg:
        sub = df[df['segment']==seg]
        human = sub[sub['conversation_initiated_type']=='human_first']
        bot = sub[sub['conversation_initiated_type']=='bot_first']
        human_trial = human[human['stage']=='trial_activated'].shape[0]
        bot_trial = bot[bot['stage']=='trial_activated'].shape[0]
        if human.shape[0] > 50 and bot.shape[0] > 50:
            print(f"{seg}: human {human_trial}/{human.shape[0]} ({human_trial/human.shape[0]*100:.1f}%), bot {bot_trial}/{bot.shape[0]} ({bot_trial/bot.shape[0]*100:.1f}%)")

print("\n=== Closed won rate by segment and path ===")
for seg in df['segment'].unique():
    if seg:
        sub = df[df['segment']==seg]
        human = sub[sub['conversation_initiated_type']=='human_first']
        bot = sub[sub['conversation_initiated_type']=='bot_first']
        human_won = human[human['stage']=='closed_won'].shape[0]
        bot_won = bot[bot['stage']=='closed_won'].shape[0]
        if human.shape[0] > 50 and bot.shape[0] > 50:
            print(f"{seg}: human {human_won}/{human.shape[0]} ({human_won/human.shape[0]*100:.1f}%), bot {bot_won}/{bot.shape[0]} ({bot_won/bot.shape[0]*100:.1f}%)")

# Region analysis
print("\n=== Region analysis (demo booked) ===")
for reg in df['region'].unique():
    if reg:
        sub = df[df['region']==reg]
        total = sub.shape[0]
        human = sub[sub['conversation_initiated_type']=='human_first']
        bot = sub[sub['conversation_initiated_type']=='bot_first']
        human_demo = human[human['stage']=='demo_booked'].shape[0]
        bot_demo = bot[bot['stage']=='demo_booked'].shape[0]
        if total > 100:
            print(f"{reg}: total {total}, human demo {human_demo}/{human.shape[0]} ({human_demo/human.shape[0]*100 if human.shape[0] else 0:.1f}%), bot demo {bot_demo}/{bot.shape[0]} ({bot_demo/bot.shape[0]*100 if bot.shape[0] else 0:.1f}%)")

# Intent analysis
print("\n=== Intent analysis (demo booked) ===")
for intent in df['intent'].unique():
    if intent:
        sub = df[df['intent']==intent]
        total = sub.shape[0]
        human = sub[sub['conversation_initiated_type']=='human_first']
        bot = sub[sub['conversation_initiated_type']=='bot_first']
        human_demo = human[human['stage']=='demo_booked'].shape[0]
        bot_demo = bot[bot['stage']=='demo_booked'].shape[0]
        if total > 50:
            print(f"{intent}: total {total}, human demo {human_demo}/{human.shape[0]} ({human_demo/human.shape[0]*100 if human.shape[0] else 0:.1f}%), bot demo {bot_demo}/{bot.shape[0]} ({bot_demo/bot.shape[0]*100 if bot.shape[0] else 0:.1f}%)")

conn.close()
