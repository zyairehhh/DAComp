import sqlite3
import pandas as pd
import re

conn = sqlite3.connect('dacomp-029.sqlite')
df = pd.read_sql_query('SELECT Title, Price, "New Car Price (incl. tax)", Mileage FROM autohome LIMIT 20;', conn)
conn.close()

def clean_price(price_str):
    if pd.isna(price_str):
        return None
    s = str(price_str).replace(',', '').replace('yuan', '').strip()
    match = re.search(r'[\d]+(?:\.\d+)?', s)
