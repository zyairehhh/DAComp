import sqlite3
import pandas as pd

# Connect to database
conn = sqlite3.connect('dacomp-035.sqlite')

# 1. Basic department size
dept_users = pd.read_sql("""
    SELECT Department, COUNT(DISTINCT "User ID") as total_users
    FROM user_information_table
    WHERE Department IS NOT NULL
    GROUP BY Department
""", conn)

# 2. Abnormal logins per department
dept_abnormal = pd.read_sql("""
    SELECT ui.Department, COUNT(*) as abnormal_count
    FROM abnormal_logins_table al
    LEFT JOIN login_records_table lr ON al."Login Record ID" = lr."Login Record ID"
    LEFT JOIN user_information_table ui ON lr."User ID" = ui."User ID"
    WHERE ui.Department IS NOT NULL
    GROUP BY ui.Department
""", conn)

# 3. Risk level and anomaly score
dept_risk = pd.read_sql("""
    SELECT ui.Department, al."Risk Level", al."Anomaly Score", al."Anomaly Type"
    FROM abnormal_logins_table al
    LEFT JOIN login_records_table lr ON al."Login Record ID" = lr."Login Record ID"
    LEFT JOIN user_information_table ui ON lr."User ID" = ui."User ID"
    WHERE ui.Department IS NOT NULL
""", conn)

# 4. Merge data
df = pd.merge(dept_users, dept_abnormal, on='Department', how='left')
df['abnormal_per_user'] = df['abnormal_count'] / df['total_users']

# 5. High+severe percentage
risk_summary = dept_risk.groupby('Department')['Risk Level'].apply(
    lambda x: (x.isin(['High','Severe']).sum() / len(x) * 100)
).reset_index(name='high_severe_percent')
risk_summary['high_severe_count'] = dept_risk.groupby('Department')['Risk Level'].apply(
    lambda x: (x.isin(['High','Severe']).sum())
).reset_index(name='high_severe_count')['high_severe_count']

# 6. Average anomaly score
score_summary = dept_risk.groupby('Department')['Anomaly Score'].mean().reset_index(name='avg_anomaly_score')

# 7. Merge
df = pd.merge(df, risk_summary, on='Department')
df = pd.merge(df, score_summary, on='Department')

# 8. Anomaly type distribution
type_counts = pd.crosstab(dept_risk['Department'], dept_risk['Anomaly Type'], normalize='index') * 100
type_counts = type_counts.round(2)

# 9. Combine
print("Department Security Metrics:")
print(df.to_string(index=False))
print("\nAnomaly Type Distribution (% per department):")
print(type_counts.to_string())

# 10. Compute composite risk score (weighted)
# Weight: abnormal_per_user (0.3), high_severe_percent (0.4), avg_anomaly_score normalized (0.3)
from sklearn.preprocessing import MinMaxScaler
scaler = MinMaxScaler()
df['abnormal_per_user_norm'] = scaler.fit_transform(df[['abnormal_per_user']])
df['high_severe_percent_norm'] = scaler.fit_transform(df[['high_severe_percent']])
df['avg_anomaly_score_norm'] = scaler.fit_transform(df[['avg_anomaly_score']])
df['composite_risk'] = df['abnormal_per_user_norm']*0.3 + df['high_severe_percent_norm']*0.4 + df['avg_anomaly_score_norm']*0.3
df = df.sort_values('composite_risk', ascending=False)

print("\nComposite Risk Score Ranking (higher = more risk):")
print(df[['Department','abnormal_per_user','high_severe_percent','avg_anomaly_score','composite_risk']].to_string(index=False))

# 11. Identify top risk departments
top_risk = df.iloc[0]
print(f"\nHighest risk department: {top_risk['Department']}")
print(f"Recommend prioritizing security awareness guidance for {top_risk['Department']}.")

conn.close()
```
