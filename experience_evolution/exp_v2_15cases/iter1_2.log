import sqlite3
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from datetime import datetime
import os

# Set style
sns.set_style("whitegrid")
plt.rcParams['figure.figsize'] = [12, 8]
plt.rcParams['font.size'] = 12

def query_data():
    """Query data from SQLite database for visualization"""
    conn = sqlite3.connect('dacomp-094.sqlite')
    
    # Join person_campaign_flow with persons to get retention metrics
    query = """
    SELECT 
        f.person_id,
        f.last_touch_campaign_id,
        f.first_event_at,
        f.email_open_rate_touch as open_rate,
        f.email_click_to_open_rate_touch as click_to_open_rate,
        f.count_received_email,
        f.count_opened_email,
        f.count_clicked_email,
        p.active_retention_rate_week,
        p.active_retention_rate_month
    FROM 
        klaviyo__person_campaign_flow f
    LEFT JOIN 
        klaviyo__persons p ON f.person_id = p.person_id
    """
    
    df = pd.read_sql_query(query, conn)
    
    # Add derived metrics
    df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
    
    # Add subject theme based on campaign_id
    def classify_subject(campaign_id):
        if campaign_id == 'CMP0001':
            return 'new_product_launch'  # "Unlock Product Launch Offers"
        elif campaign_id in ['CMP0002', 'CMP0016']:
            return 'discount_related'     # "Unlock Seasonal Offers"
        else:
            return 'unknown'              # CMP0012 or others
    
    df['subject_theme'] = df['last_touch_campaign_id'].apply(classify_subject)
    
    # Add time features
    df['first_event_at'] = pd.to_datetime(df['first_event_at'])
    df['is_weekend'] = df['first_event_at'].dt.dayofweek >= 5
    df['is_weekend'] = df['is_weekend'].map({True: 'Weekend', False: 'Weekday'})
    df['time_of_day'] = df['first_event_at'].dt.hour.apply(lambda x: 'Morning' if x < 12 else 'Afternoon')
    
    conn.close()
    return df

def create_theme_performance_plot(df):
    """Create bar plot comparing performance across subject themes"""
    theme_metrics = df.groupby('subject_theme').agg({
        'open_rate': 'mean',
        'click_rate': 'mean',
        'active_retention_rate_week': 'mean',
        'active_retention_rate_month': 'mean',
        'person_id': 'count'
    }).rename(columns={'person_id': 'count'}).reset_index()
    
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    
    # Plot 1: Open Rate by Theme
    axes[0, 0].bar(theme_metrics['subject_theme'], theme_metrics['open_rate'], 
                   color=['#2E86AB', '#A23B72', '#F18F01'])
    axes[0, 0].set_title('Average Open Rate by Subject Theme', fontweight='bold', fontsize=14)
    axes[0, 0].set_ylabel('Open Rate')
    axes[0, 0].set_ylim(0, 0.6)
    for i, v in enumerate(theme_metrics['open_rate']):
        axes[0, 0].text(i, v + 0.01, f'{v:.3f}', ha='center', va='bottom', fontweight='bold')
    
    # Plot 2: Click Rate by Theme
    axes[0, 1].bar(theme_metrics['subject_theme'], theme_metrics['click_rate'], 
                   color=['#2E86AB', '#A23B72', '#F18F01'])
    axes[0, 1].set_title('Average Click Rate by Subject Theme', fontweight='bold', fontsize=14)
    axes[0, 1].set_ylabel('Click Rate')
    axes[0, 1].set_ylim(0, 0.25)
    for i, v in enumerate(theme_metrics['click_rate']):
        axes[0, 1].text(i, v + 0.005, f'{v:.3f}', ha='center', va='bottom', fontweight='bold')
    
    # Plot 3: Weekly Retention by Theme
    axes[1, 0].bar(theme_metrics['subject_theme'], theme_metrics['active_retention_rate_week'], 
                   color=['#2E86AB', '#A23B72', '#F18F01'])
    axes[1, 0].set_title('Average Weekly Retention by Subject Theme', fontweight='bold', fontsize=14)
    axes[1, 0].set_ylabel('Weekly Retention Rate')
    axes[1, 0].set_ylim(0, 1.1)
    for i, v in enumerate(theme_metrics['active_retention_rate_week']):
        axes[1, 0].text(i, v + 0.02, f'{v:.3f}', ha='center', va='bottom', fontweight='bold')
    
    # Plot 4: Monthly Retention by Theme
    axes[1, 1].bar(theme_metrics['subject_theme'], theme_metrics['active_retention_rate_month'], 
                   color=['#2E86AB', '#A23B72', '#F18F01'])
    axes[1, 1].set_title('Average Monthly Retention by Subject Theme', fontweight='bold', fontsize=14)
    axes[1, 1].set_ylabel('Monthly Retention Rate')
    axes[1, 1].set_ylim(0, 1.1)
    for i, v in enumerate(theme_metrics['active_retention_rate_month']):
        axes[1, 1].text(i, v + 0.02, f'{v:.3f}', ha='center', va='bottom', fontweight='bold')
    
    plt.suptitle('Email Campaign Performance by Subject Line Theme', fontsize=16, fontweight='bold', y=1.02)
    plt.tight_layout()
    plt.savefig('theme_performance.png', dpi=300, bbox_inches='tight')
    plt.close()

def create_weekend_comparison_plot(df):
    """Create comparison plot for weekday vs weekend performance"""
    weekend_metrics = df.groupby('is_weekend').agg({
        'open_rate': 'mean',
        'click_rate': 'mean',
        'active_retention_rate_week': 'mean',
        'active_retention_rate_month': 'mean',
        'person_id': 'count'
    }).rename(columns={'person_id': 'count'}).reset_index()
    
    # Create grouped bar plot
    fig, axes = plt.subplots(1, 2, figsize=(12, 6))
    
    x = np.arange(len(weekend_metrics))
    width = 0.35
    
    axes[0].bar(x - width/2, weekend_metrics['open_rate'], width, label='Open Rate', color='#2E86AB')
    axes[0].bar(x + width/2, weekend_metrics['click_rate'], width, label='Click Rate', color='#A23B72')
    axes[0].set_title('Open & Click Rates: Weekday vs Weekend', fontweight='bold', fontsize=14)
    axes[0].set_xlabel('')
    axes[0].set_ylabel('Rate')
    axes[0].set_xticks(x)
    axes[0].set_xticklabels(weekend_metrics['is_weekend'])
    axes[0].set_ylim(0, 0.5)
    axes[0].legend()
    
    # Add value labels
    for i, (open_rate, click_rate) in enumerate(zip(weekend_metrics['open_rate'], weekend_metrics['click_rate'])):
        axes[0].text(i - width/2, open_rate + 0.01, f'{open_rate:.3f}', ha='center', va='bottom', fontsize=10)
        axes[0].text(i + width/2, click_rate + 0.01, f'{click_rate:.3f}', ha='center', va='bottom', fontsize=10)
    
    axes[1].bar(x - width/2, weekend_metrics['active_retention_rate_week'], width, 
                label='Weekly Retention', color='#2E86AB')
    axes[1].bar(x + width/2, weekend_metrics['active_retention_rate_month'], width, 
                label='Monthly Retention', color='#A23B72')
    axes[1].set_title('Retention Rates: Weekday vs Weekend', fontweight='bold', fontsize=14)
    axes[1].set_xlabel('')
    axes[1].set_ylabel('Retention Rate')
    axes[1].set_xticks(x)
    axes[1].set_xticklabels(weekend_metrics['is_weekend'])
    axes[1].set_ylim(0, 1.1)
    axes[1].legend()
    
    # Add value labels
    for i, (week_ret, month_ret) in enumerate(zip(weekend_metrics['active_retention_rate_week'], 
                                                  weekend_metrics['active_retention_rate_month'])):
        axes[1].text(i - width/2, week_ret + 0.02, f'{week_ret:.3f}', ha='center', va='bottom', fontsize=10)
        axes[1].text(i + width/2, month_ret + 0.02, f'{month_ret:.3f}', ha='center', va='bottom', fontsize=10)
    
    plt.suptitle('Email Campaign Performance: Weekday vs Weekend Sending', fontsize=16, fontweight='bold', y=1.05)
    plt.tight_layout()
    plt.savefig('weekend_comparison.png', dpi=300, bbox_inches='tight')
    plt.close()

def create_correlation_plot(df):
    """Create scatter plot showing correlation between open rate and retention"""
    fig, axes = plt.subplots(1, 2, figsize=(12, 6))
    
    # Calculate correlation coefficients
    corr_week = df['open_rate'].corr(df['active_retention_rate_week'])
    corr_month = df['open_rate'].corr(df['active_retention_rate_month'])
    
    # Plot weekly retention vs open rate
    scatter1 = axes[0].scatter(df['open_rate'], df['active_retention_rate_week'], 
                              c=df['click_rate'], cmap='viridis', s=100, alpha=0.8)
    axes[0].set_xlabel('Email Open Rate')
    axes[0].set_ylabel('Weekly Active Retention Rate')
    axes[0].set_title(f'Open Rate vs Weekly Retention\nCorrelation: r = {corr_week:.3f}', fontweight='bold', fontsize=14)
    
    # Add colorbar for click rate
    cbar1 = plt.colorbar(scatter1, ax=axes[0])
    cbar1.set_label('Click Rate')
    
    # Plot monthly retention vs open rate
    scatter2 = axes[1].scatter(df['open_rate'], df['active_retention_rate_month'], 
                               c=df['click_rate'], cmap='viridis', s=100, alpha=0.8)
    axes[1].set_xlabel('Email Open Rate')
    axes[1].set_ylabel('Monthly Active Retention Rate')
    axes[1].set_title(f'Open Rate vs Monthly Retention\nCorrelation: r = {corr_month:.3f}', fontweight='bold', fontsize=14)
    
    # Add colorbar for click rate
    cbar2 = plt.colorbar(scatter2, ax=axes[1])
    cbar2.set_label('Click Rate')
    
    # Add regression lines
    for ax, y_var in zip([axes[0], axes[1]], ['active_retention_rate_week', 'active_retention_rate_month']):
        z = np.polyfit(df['open_rate'], df[y_var], 1)
        p = np.poly1d(z)
        ax.plot(np.sort(df['open_rate']), p(np.sort(df['open_rate'])), "r--", alpha=0.8, linewidth=2)
    
    plt.suptitle('Correlation Between Email Engagement and Customer Retention', fontsize=16, fontweight='bold', y=1.02)
    plt.tight_layout()
    plt.savefig('correlation_analysis.png', dpi=300, bbox_inches='tight')
    plt.close()

def create_combined_effects_plot(df):
    """Create heatmap/grouped bar plot for combined effects (subject theme × weekend)"""
    combined_metrics = df.groupby(['subject_theme', 'is_weekend']).agg({
        'open_rate': 'mean',
        'click_rate': 'mean',
        'active_retention_rate_week': 'mean',
        'active_retention_rate_month': 'mean',
        'person_id': 'count'
    }).rename(columns={'person_id': 'count'}).reset_index()
    
    # Create grouped bar plot
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    
    # Get unique themes and weekends
    themes = combined_metrics['subject_theme'].unique()
    weekends = combined_metrics['is_weekend'].unique()
    x = np.arange(len(themes))
    
    for idx, (metric, title, ylabel) in enumerate([
        ('open_rate', 'Open Rate by Theme & Weekend Status', 'Open Rate'),
        ('click_rate', 'Click Rate by Theme & Weekend Status', 'Click Rate'),
        ('active_retention_rate_week', 'Weekly Retention by Theme & Weekend Status', 'Weekly Retention'),
        ('active_retention_rate_month', 'Monthly Retention by Theme & Weekend Status', 'Monthly Retention')
    ]):
        ax = axes[idx // 2, idx % 2]
        
        # Filter data for this metric
        metric_data = combined_metrics.pivot(index='subject_theme', columns='is_weekend', values=metric)
        
        # Plot grouped bars
        width = 0.35
        for i, weekend in enumerate(weekends):
            if weekend in metric_data.columns:
                values = metric_data[weekend].reindex(themes).values
                positions = x - width/2 + i*width if len(weekends) == 2 else x
                ax.bar(positions, values, width, label=weekend, 
                       color=['#2E86AB', '#A23B72', '#F18F01'][i])
        
        ax.set_title(title, fontweight='bold', fontsize=12)
        ax.set_xlabel('Subject Theme')
        ax.set_ylabel(ylabel)
        ax.set_xticks(x)
        ax.set_xticklabels(themes)
        ax.legend(title='Weekend Status')
        
        # Add value labels
        for weekend in weekends:
            if weekend in metric_data.columns:
                values = metric_data[weekend].reindex(themes).values
                positions = x - width/2 + i*width if len(weekends) == 2 else x
                for j, v in enumerate(values):
                    if not np.isnan(v):
                        ax.text(positions[j], v + 0.01, f'{v:.3f}', 
                               ha='center', va='bottom', fontsize=9)
    
    plt.suptitle('Combined Effects: Subject Theme × Weekend Sending', fontsize=16, fontweight='bold', y=1.02)
    plt.tight_layout()
    plt.savefig('combined_effects.png', dpi=300, bbox_inches='tight')
    plt.close()

def main():
    """Main function to create all visualizations"""
    print("Querying data from database...")
    df = query_data()
    print(f"Loaded {len(df)} rows of data")
    
    print("Creating theme performance plot...")
    create_theme_performance_plot(df)
    
    print("Creating weekend comparison plot...")
    create_weekend_comparison_plot(df)
    
    print("Creating correlation plot...")
    create_correlation_plot(df)
    
    print("Creating combined effects plot...")
    create_combined_effects_plot(df)
    
    print("All visualizations created successfully!")
    
    # Display some summary statistics
    print("\n=== Summary Statistics ===")
    print(f"Total observations: {len(df)}")
    print(f"\nSubject Theme Distribution:")
    print(df['subject_theme'].value_counts())
    print(f"\nWeekend Distribution:")
    print(df['is_weekend'].value_counts())
    print(f"\nAverage Open Rate: {df['open_rate'].mean():.4f}")
    print(f"Average Click Rate: {df['click_rate'].mean():.4f}")
    print(f"Average Weekly Retention: {df['active_retention_rate_week'].mean():.4f}")
    print(f"Average Monthly Retention: {df['active_retention_rate_month'].mean():.4f}")

if __name__ == "__main__":
    main()
