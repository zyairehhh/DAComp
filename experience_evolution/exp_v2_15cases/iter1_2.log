    avg_health=('health_score', 'mean'),
    count=('campaign_id', 'count'),
    avg_roi=('roi', 'mean'),
    avg_cost=('cost', 'mean')
).round(4)
print(type_stats)
print()

# 2. Bidding strategy
print("=== Bidding Strategy Performance ===")
bid_stats = campaign_df.groupby('bidding_strategy').agg(
    avg_health=('health_score', 'mean'),
    count=('campaign_id', 'count'),
    avg_roi=('roi', 'mean'),
    avg_cost=('cost', 'mean')
).round(4)
print(bid_stats)
print()

# 3. Industry
print("=== Industry Performance ===")
industry_stats = campaign_df.groupby('industry').agg(
    avg_health=('health_score', 'mean'),
    count=('campaign_id', 'count'),
    avg_roi=('roi', 'mean'),
    avg_cost=('cost', 'mean')
).round(4)
print(industry_stats)
print()

# 4. Geographic distribution
