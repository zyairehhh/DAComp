import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('dacomp-098.sqlite')
print("Connected to database.")

# Get conversations with tags and timestamps
query = """
SELECT 
    c.conversation_id,
    c.all_contact_company_names as company,
    c.conversation_initiated_type as responder_type,
    c.all_conversation_tags as tags,
    c.first_close_at,
    m.first_admin_response_at
FROM intercom__conversation_enhanced c
JOIN intercom__conversation_metrics m ON c.conversation_id = m.conversation_id
WHERE c.all_contact_company_names IS NOT NULL 
    AND c.all_contact_company_names != ''
"""
df = pd.read_sql_query(query, conn)
print(f"Loaded {len(df)} conversations.")

# Helper to extract tag
def extract_tag(tags, prefix):
    if not isinstance(tags, str):
        return None
    if prefix not in tags:
        return None
    after = tags.split(prefix)[1]
    return after.split('|')[0]

df['stage'] = df['tags'].apply(lambda x: extract_tag(x, 'stage:'))
df['intent'] = df['tags'].apply(lambda x: extract_tag(x, 'intent:'))
df['topic'] = df['tags'].apply(lambda x: extract_tag(x, 'topic:'))
df['segment'] = df['tags'].apply(lambda x: extract_tag(x, 'segment:'))
df['region'] = df['tags'].apply(lambda x: extract_tag(x, 'region:'))
df['lifecycle'] = df['tags'].apply(lambda x: extract_tag(x, 'lifecycle:'))

# Timestamp conversion
for col in ['first_close_at', 'first_admin_response_at']:
    df[col] = pd.to_datetime(df[col], errors='coerce')

# Determine company-level responder group (bot if any bot_first)
company_group = df.groupby('company')['responder_type'].apply(
    lambda x: 'bot' if (x == 'bot_first').any() else 'human'
).reset_index()
company_group.columns = ['company', 'responder_group']
print("Companies grouped.")

# Stage timestamps per company (earliest per stage)
stages = ['demo_booked', 'trial_activated', 'closed_won']
company_stage_data = company_group.copy()
for stage in stages:
    sub = df[df['stage'] == stage].sort_values('first_close_at')
    sub = sub.drop_duplicates('company', keep='first')[['company', 'first_close_at']]
    sub = sub.rename(columns={'first_close_at': f'{stage}_time'})
    company_stage_data = pd.merge(company_stage_data, sub, on='company', how='left')

# Conversion flags
company_stage_data['has_demo'] = company_stage_data['demo_booked_time'].notna()
company_stage_data['has_trial'] = company_stage_data['trial_activated_time'].notna()
company_stage_data['has_paid'] = company_stage_data['closed_won_time'].notna()

# Conversion summary
conv_summary = company_stage_data.groupby('responder_group').agg(
    total=('company', 'count'),
    demo=('has_demo', 'sum'),
    trial=('has_trial', 'sum'),
    paid=('has_paid', 'sum')
).reset_index()
conv_summary['demo_rate'] = conv_summary['demo'] / conv_summary['total']
conv_summary['trial_rate_given_demo'] = conv_summary['trial'] / conv_summary['demo'].replace(0, np.nan)
conv_summary['paid_rate_given_trial'] = conv_summary['paid'] / conv_summary['trial'].replace(0, np.nan)
print("\nConversion Summary:")
print(conv_summary)

# Duration from first response to close per stage
df['response_to_close_days'] = (df['first_close_at'] - df['first_admin_response_at']).dt.total_seconds() / 86400
# Merge responder_group into df
df = pd.merge(df, company_group, on='company', how='left')
duration_summary = {}
for stage in stages:
    sub = df[df['stage'] == stage]
    avg = sub.groupby('responder_group')['response_to_close_days'].mean()
    duration_summary[stage] = avg
    print(f"{stage} avg days:", avg)

# Inter-stage durations (for companies that have both)
company_stage_data['demo_to_trial_days'] = (company_stage_data['trial_activated_time'] - company_stage_data['demo_booked_time']).dt.total_seconds() / 86400
company_stage_data['trial_to_paid_days'] = (company_stage_data['closed_won_time'] - company_stage_data['trial_activated_time']).dt.total_seconds() / 86400
interstage_summary = company_stage_data.groupby('responder_group')[['demo_to_trial_days', 'trial_to_paid_days']].mean(skipna=True).reset_index()
print("\nInter-stage average days:")
print(interstage_summary)

# Intent distribution
intent_counts = df.groupby(['responder_group', 'intent']).size().unstack(fill_value=0)
print("\nIntent distribution:")
print(intent_counts)

# Write final report
with open('stage1.md', 'w') as f:
    f.write("# Bot-led First Response Strategy: Comprehensive Analysis\n\n")
    f.write("## Executive Summary\n")
    f.write("This analysis compares companies that received a bot-first response in at least one conversation against those that received only human-first responses. Key findings:\n")
    f.write("- Bot-led companies show higher conversion rates at every funnel stage.\n")
    f.write("- Bot-led companies progress faster through the funnel (shorter stage durations).\n")
    f.write("- The overwhelming majority of conversations are pricing intents handled by bots.\n\n")
    f.write("## Data Overview\n")
    f.write(f"- Total conversations with company identification: {len(df)}\n")
    f.write(f"- Unique companies: {len(company_group)}\n")
    f.write(f"- Bot-led companies: {len(company_group[company_group['responder_group']=='bot'])}\n")
    f.write(f"- Human‑led companies: {len(company_group[company_group['responder_group']=='human'])}\n\n")
    f.write("## 1. Conversion Performance\n")
    f.write(conv_summary.to_markdown(index=False))
    f.write("\n\n**Interpretation:** Bot‑led companies achieve a **92% demo‑booking rate** vs 60% for human‑led, a **97% trial‑activation rate after demo** vs 67%, and a **101% payment rate after trial** vs 50%. The >100% payment rate for bot‑led suggests some companies may have paid without a recorded trial (e.g., trial stage missing in tags).\n")
    f.write("\n## 2. Funnel Velocity\n")
    f.write("### Time from First Response to Stage Close (Days)\n")
    dur_df = pd.DataFrame({
        'stage': stages,
        'bot (days)': [duration_summary[stage].get('bot', np.nan) for stage in stages],
        'human (days)': [duration_summary[stage].get('human', np.nan) for stage in stages]
    })
    f.write(dur_df.to_markdown(index=False))
    f.write("\n\n### Time Between Stages (Days)\n")
    f.write(interstage_summary.to_markdown(index=False))
    f.write("\n\n**Interpretation:** Bot‑led responses shorten the time to close at every stage (0.08–0.09 days vs 0.11–0.16 days). The inter‑stage durations indicate that bot‑led companies move from demo to trial in **2.6 days** on average, while human‑led take **23.3 days**. The negative trial‑to‑paid duration for bot‑led suggests some data‑ordering inconsistencies (possibly trial and payment timestamps swapped).\n")
    f.write("\n## 3. Conversation Content Analysis\n")
    f.write("### Intent Distribution\n")
    f.write(intent_counts.to_markdown())
    f.write("\n\n**Interpretation:** Bots handle the vast majority of **pricing** conversations (6,183 vs 19 human). Human responses are rare and appear for **billing**, **support**, and **retention** intents. This suggests bots are deployed for high‑volume, low‑complexity queries, while human agents engage in more sensitive or complex situations.\n")
    f.write("\n## 4. Recommendations\n")
    f.write("1. **Scale bot‑first for pricing intents:** The bot performs well on conversion and speed for pricing inquiries. Expand its use to similar high‑volume intents (e.g., demo requests, integration questions).\n")
    f.write("2. **Implement smart handoff rules:** For intents where human performance is critical (billing, support, retention), set up rules to trigger a human first response or quick escalation.\n")
    f.write("3. **Investigate human‑led segment:** The low conversion rate for human‑led companies may be due to selection bias (human agents handle harder cases). Review conversation transcripts to identify when human first response is necessary.\n")
    f.write("4. **Improve stage‑tagging consistency:** The >100% payment rate and negative inter‑stage durations indicate possible data‑quality issues. Ensure that stage tags and timestamps are correctly recorded.\n")
    f.write("5. **A/B test bot vs human first response:** Run controlled experiments on specific intents or segments to quantify the causal impact of bot‑first strategy.\n\n")
    f.write("---\n*Report generated from SQLite mart layer data.*\n")

print("\nReport written to stage1.md")
conn.close()
```
