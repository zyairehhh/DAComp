print(f"Normal mean: {normal_df['transaction_value_volatility'].mean():.3f}")
print("\nTrans Consistency Score (transaction_count / (avg_transactions_per_month*12)):")
print(f"Anomaly mean: {anomaly_df['trans_consistency_score'].mean():.3f}")
print(f"Normal mean: {normal_df['trans_consistency_score'].mean():.3f}")

# 2. Seasonal patterns: Q1-Q4 distribution
df['total_quarter_trans'] = df[['q1_transactions','q2_transactions','q3_transactions','q4_transactions']].sum(axis=1)
for q in ['q1','q2','q3','q4']:
    df[f'{q}_prop'] = df[f'{q}_transactions'] / df['total_quarter_trans'].replace(0,1)

print("\n=== Seasonal Patterns ===")
quarters = ['q1','q2','q3','q4']
for q in quarters:
    print(f"{q} proportion - Anomaly mean: {anomaly_df[f'{q}_prop'].mean():.3f}, Normal mean: {normal_df[f'{q}_prop'].mean():.3f}")

# 3. Value realization: alignment between comprehensive_customer_score and total_revenue
# Compute correlation per segment?
print("\n=== Value Realization ===")
print("Correlation between comprehensive_customer_score and total_revenue:")
