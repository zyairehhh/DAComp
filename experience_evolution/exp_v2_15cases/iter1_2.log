plt.savefig('high_low_revenue_metrics.png', dpi=300)
plt.close()
print('Plot 3 saved as high_low_revenue_metrics.png')

# Plot 4: Version fragmentation over time
query4 = """
SELECT date_day, version_fragmentation 
FROM google_play__comprehensive_performance_dashboard 
WHERE package_name = 'com.dev.photoeditor' 
ORDER BY date_day;
"""
df4 = pd.read_sql_query(query4, conn)
df4['date_day'] = pd.to_datetime(df4['date_day'])
df4.set_index('date_day', inplace=True)

plt.figure(figsize=(10,6))
plt.plot(df4.index, df4['version_fragmentation'], marker='s', color='purple', linewidth=2)
plt.title('Version Fragmentation Over Time', fontsize=16)
plt.xlabel('Date', fontsize=14)
plt.ylabel('Version Fragmentation Count', fontsize=14)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('version_fragmentation_trend.png', dpi=300)
plt.close()
print('Plot 4 saved as version_fragmentation_trend.png')

# Plot 5: Crash rate vs quality score scatter by region (maybe top markets)
query5 = """
SELECT region, app_crash_rate_per_1k, app_quality_score, avg_transaction_value, revenue_last_30_days
FROM google_play__geo_market_analysis
WHERE package_name = 'com.dev.photoeditor' 
    AND region IS NOT NULL
"""
df5 = pd.read_sql_query(query5, conn)
df5 = df5.groupby('region').agg({
    'app_crash_rate_per_1k': 'mean',
    'app_quality_score': 'mean',
    'avg_transaction_value': 'mean',
    'revenue_last_30_days': 'sum'
}).reset_index()

plt.figure(figsize=(10,6))
scatter = plt.scatter(df5['app_crash_rate_per_1k'], df5['app_quality_score'], 
                      s=df5['revenue_last_30_days']/1000, c=df5['avg_transaction_value'], 
                      cmap='viridis', alpha=0.7, edgecolors='black')
plt.colorbar(scatter, label='Avg Transaction Value ($)')
plt.xlabel('Crash Rate (per 1k devices)', fontsize=14)
plt.ylabel('App Quality Score', fontsize=14)
plt.title('Regional Performance: Crash Rate vs Quality Score (Bubble Size = Revenue)', fontsize=16)
# Annotate top regions
for i, row in df5.iterrows():
    if row['revenue_last_30_days'] > 5000000:  # annotate high revenue regions
        plt.annotate(row['region'], (row['app_crash_rate_per_1k'], row['app_quality_score']), 
                     fontsize=10, ha='center')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('crash_vs_quality_scatter.png', dpi=300)
plt.close()
print('Plot 5 saved as crash_vs_quality_scatter.png')

conn.close()
print("All plots generated.")
