        )
        
        # 3. Holiday analysis - days before/after holiday
        events_df['is_near_holiday'] = 'no'
        for holiday in holiday_dates:
            before_start = holiday - timedelta(days=3)
            after_end = holiday + timedelta(days=3)
            mask = (events_df['occurred_at'] >= before_start) & (events_df['occurred_at'] <= after_end)
            events_df.loc[mask, 'is_near_holiday'] = 'yes'
            
            # Mark specifically before/after
            before_mask = (events_df['occurred_at'] >= before_start) & (events_df['occurred_at'] < holiday)
            after_mask = (events_df['occurred_at'] > holiday) & (events_df['occurred_at'] <= after_end)
            events_df.loc[before_mask, 'holiday_period'] = '3_days_before'
            events_df.loc[after_mask, 'holiday_period'] = '3_days_after'
        
        # Merge with campaign flow data for metrics
        events_df['campaign_id'] = events_df['last_touch_campaign_id']
