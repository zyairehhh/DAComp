       SUM(CASE WHEN strftime('%Y-%m', date_day) = '2024-01' THEN daily_net_revenue ELSE 0 END) as jan_revenue,
       SUM(CASE WHEN strftime('%Y-%m', date_day) = '2024-12' THEN daily_net_revenue ELSE 0 END) as dec_revenue
FROM google_play__finance_report 
WHERE package_name = 'com.dev.photoeditor' 
GROUP BY region;
"""
df2 = pd.read_sql_query(query2, conn)
df2 = df2[df2['region'].notna()]
df2['change_pct'] = (df2['dec_revenue'] - df2['jan_revenue']) / df2['jan_revenue'] * 100

# Bar chart
