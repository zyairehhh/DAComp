'''
import sqlite3
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

conn = sqlite3.connect('dacomp-066.sqlite')
query = """
SELECT 
    e.overall_conversion_rate,
    e.count_total_interviews,
    e.avg_job_rating,
    e.application_to_interview_rate,
    e.interview_to_hire_rate,
    r.total_applications,
    r.total_interviews,
    r.avg_interview_score,
    r.avg_process_days,
    e.departments
FROM greenhouse__job_enhanced e
JOIN greenhouse__recruitment_performance r ON e.job_id = r.job_id
"""
df = pd.read_sql_query(query, conn)
conn.close()

# Filter engineering only
eng_df = df[df['departments'] == 'Engineering'].copy()
print("Engineering rows:", len(eng_df))

# Select numeric columns for correlation
numeric_cols = ['overall_conversion_rate', 'count_total_interviews', 'avg_job_rating', 
                'application_to_interview_rate', 'interview_to_hire_rate',
                'total_applications', 'total_interviews', 'avg_interview_score', 
                'avg_process_days']

corr = eng_df[numeric_cols].corr()

# Plot heatmap
plt.figure(figsize=(10,8))
sns.heatmap(corr, annot=True, cmap='coolwarm', center=0, fmt='.2f', linewidths=0.5)
plt.title('Correlation Matrix for Engineering Metrics')
plt.tight_layout()
plt.savefig('engineering_correlation_heatmap.png')
plt.close()

# Scatter plot: overall_conversion_rate vs count_total_interviews (colored by avg_job_rating)
plt.figure(figsize=(10,6))
scatter = plt.scatter(eng_df['count_total_interviews'], eng_df['overall_conversion_rate'], 
                      c=eng_df['avg_job_rating'], cmap='viridis', alpha=0.7)
plt.colorbar(scatter, label='Avg Job Rating')
plt.title('Conversion Rate vs Total Interviews (Engineering)')
plt.xlabel('Total Interviews per Job')
plt.ylabel('Overall Conversion Rate')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.savefig('conversion_vs_interviews_rating.png')
plt.close()

# Compute regression and output insights
import statsmodels.api as sm
X = eng_df[['count_total_interviews', 'avg_job_rating', 'avg_process_days', 'total_applications']].copy()
X = X.fillna(X.mean())
X = sm.add_constant(X)
y = eng_df['overall_conversion_rate']
model = sm.OLS(y, X).fit()
print("Regression summary for Engineering conversion rate:")
print(model.summary())
''')
