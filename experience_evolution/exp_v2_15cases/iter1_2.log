```
import sqlite3
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import re

conn = sqlite3.connect('dacomp-093.sqlite')

# Load campaigns
query = """
SELECT 
    campaign_id,
    SUBJECT,
    scheduled_to_send_at,
    SENT_AT,
    is_archived,
    variation_id,
    total_count_unique_people,
    count_received_email,
    count_opened_email,
    count_clicked_email,
    count_placed_order,
    email_open_rate,
    email_click_to_open_rate,
    active_days,
    total_placed_orders,
    gmv_net_campaign
FROM klaviyo__campaigns
WHERE total_count_unique_people > 0
"""
df = pd.read_sql_query(query, conn)
print(f"Campaigns: {len(df)}")

# Feature engineering
def keyword_group(subject):
    if pd.isna(subject):
        return 'unknown'
    if '限时折扣' in subject:
        return 'discount'
    elif '新品上新' in subject:
        return 'new'
    elif '品牌故事' in subject:
        return 'storytelling'
    else:
        return 'other'

df['keyword_group'] = df['SUBJECT'].apply(keyword_group)

# Time window from subject
df['time_label'] = df['SUBJECT'].apply(lambda x: x.split('，')[-1].strip() if '，' in str(x) else '')

df['scheduled_dt'] = pd.to_datetime(df['scheduled_to_send_at'])
df['weekday'] = df['scheduled_dt'].dt.weekday
df['is_weekend'] = df['weekday'].isin([5,6])
df['hour'] = df['scheduled_dt'].dt.hour
def time_of_day(hour):
    if 5 <= hour < 12:
        return 'morning'
    elif 12 <= hour < 17:
        return 'afternoon'
    elif 17 <= hour < 22:
        return 'evening'
    else:
        return 'night'
df['time_of_day'] = df['hour'].apply(time_of_day)
df['is_before_holiday'] = df['SUBJECT'].str.contains('节前')

# Metrics
df['open_rate'] = df['email_open_rate']
df['click_rate'] = df['count_clicked_email'] / df['count_received_email']
df['click_to_open_rate'] = df['email_click_to_open_rate']
df['conversion_rate'] = df['count_placed_order'] / df['count_received_email']
df['gmv_per_email'] = df['gmv_net_campaign'] / df['count_received_email']

# Remove outliers in count_received_email (IQR)
Q1 = df['count_received_email'].quantile(0.25)
Q3 = df['count_received_email'].quantile(0.75)
IQR = Q3 - Q1
lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR
df_clean = df[(df['count_received_email'] >= lower) & (df['count_received_email'] <= upper)]
print(f"After outlier removal: {len(df_clean)} campaigns")

# Save to CSV for inspection
df_clean.to_csv('campaigns_cleaned.csv', index=False)

# 1. Keyword group summary
keyword_summary = df_clean.groupby('keyword_group').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_ctr=('click_to_open_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean'),
    avg_gmv_per_email=('gmv_per_email', 'mean'),
    avg_audience=('total_count_unique_people', 'mean')
).reset_index()
keyword_summary.to_csv('keyword_summary.csv', index=False)
print("\nKeyword group summary:")
print(keyword_summary.round(4))

# 2. Weekend vs weekday
weekend_summary = df_clean.groupby('is_weekend').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_ctr=('click_to_open_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean'),
    avg_gmv_per_email=('gmv_per_email', 'mean')
).reset_index()
weekend_summary.to_csv('weekend_summary.csv', index=False)
print("\nWeekend vs weekday:")
print(weekend_summary.round(4))

# 3. Time of day
tod_summary = df_clean.groupby('time_of_day').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_ctr=('click_to_open_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean'),
    avg_gmv_per_email=('gmv_per_email', 'mean')
).reset_index()
tod_summary.to_csv('time_of_day_summary.csv', index=False)
print("\nTime of day:")
print(tod_summary.round(4))

# 4. Before holiday
holiday_summary = df_clean.groupby('is_before_holiday').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_ctr=('click_to_open_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean'),
    avg_gmv_per_email=('gmv_per_email', 'mean')
).reset_index()
holiday_summary.to_csv('holiday_summary.csv', index=False)
print("\nBefore holiday:")
print(holiday_summary.round(4))

# 5. Interaction keyword x time_of_day
interaction_summary = df_clean.groupby(['keyword_group', 'time_of_day']).agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_ctr=('click_to_open_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean')
).reset_index()
interaction_summary.to_csv('interaction_summary.csv', index=False)
print("\nInteraction (keyword x time_of_day):")
print(interaction_summary.round(4))

# 6. Variation ID
variation_summary = df_clean.groupby('variation_id').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_ctr=('click_to_open_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean')
).reset_index()
variation_summary.to_csv('variation_summary.csv', index=False)
print("\nVariation ID:")
print(variation_summary.round(4))

# 7. Archived
archived_summary = df_clean.groupby('is_archived').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_ctr=('click_to_open_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean')
).reset_index()
archived_summary.to_csv('archived_summary.csv', index=False)
print("\nArchived:")
print(archived_summary.round(4))

# 8. Audience size control: bin by total_count_unique_people
bins = pd.qcut(df_clean['total_count_unique_people'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
df_clean['audience_quartile'] = bins
audience_summary = df_clean.groupby('audience_quartile').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean')
).reset_index()
audience_summary.to_csv('audience_summary.csv', index=False)
print("\nAudience size quartiles:")
print(audience_summary.round(4))

# Additional: combine weekend & time of day
df_clean['weekend_time'] = df_clean['is_weekend'].map({True: 'weekend', False: 'weekday'}) + '_' + df_clean['time_of_day']
weekend_time_summary = df_clean.groupby('weekend_time').agg(
    campaigns=('campaign_id', 'count'),
    avg_open_rate=('open_rate', 'mean'),
    avg_click_rate=('click_rate', 'mean'),
    avg_conversion_rate=('conversion_rate', 'mean')
).reset_index()
print("\nWeekend/Weekday x time of day:")
print(weekend_time_summary.round(4))

# Persons retention overall
person_query = """
SELECT 
    AVG(active_retention_rate_week) as avg_week_retention,
    AVG(active_retention_rate_month) as avg_month_retention,
    COUNT(*) as persons_count
FROM klaviyo__persons
WHERE active_retention_rate_week IS NOT NULL
"""
person_retention = pd.read_sql_query(person_query, conn)
print("\nOverall person retention:")
print(person_retention.round(4))

conn.close()
```


