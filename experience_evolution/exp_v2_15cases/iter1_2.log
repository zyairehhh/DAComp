inter_stage = pd.DataFrame({
    'responder_group': ['bot', 'human'],
    'demo_to_trial': [2.608803, 23.271528],
    'trial_to_paid': [-2.722305, np.nan]
})
fig4, ax4 = plt.subplots(figsize=(7,5))
x = np.arange(len(inter_stage))
width = 0.3
ax4.bar(x - width/2, inter_stage['demo_to_trial'], width, label='Demo → Trial', color='lightgreen')
ax4.bar(x + width/2, inter_stage['trial_to_paid'], width, label='Trial → Paid', color='salmon')
ax4.set_xticks(x)
ax4.set_xticklabels(inter_stage['responder_group'])
ax4.set_ylabel('Average Days')
ax4.set_title('Average Inter-Stage Durations')
ax4.legend()
ax4.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('inter_stage_durations.png', dpi=300)
print("Saved inter_stage_durations.png")

print("Visualization generation complete.")
conn.close()
