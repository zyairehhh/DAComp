import sqlite3
import pandas as pd
import numpy as np

conn = sqlite3.connect('./dacomp-066.sqlite')
eng = pd.read_sql_query('''
SELECT j.application_to_interview_rate as conv_rate,
       j.avg_interviews_per_application,
       j.count_total_interviews,
       r.total_interviews
FROM greenhouse__job_enhanced j
JOIN greenhouse__recruitment_performance r ON j.job_id = r.job_id
WHERE j.departments = "Engineering"
''', conn)
conn.close()

corr = np.corrcoef(eng["conv_rate"], eng["avg_interviews_per_application"])[0,1]
print(f'Correlation between conversion rate and avg interviews per app: {corr:.3f}')
corr2 = np.corrcoef(eng["conv_rate"], eng["count_total_interviews"])[0,1]
print(f'Correlation between conversion rate and total interviews: {corr2:.3f}')
```)

