trend['events_growth'] = (trend['second_events'] - trend['first_events']) / (trend['first_events'] + 1e-6)
print('Number of accounts with daily data:', len(trend))
print(trend.head())
# Merge with account features
accounts = pd.read_sql('SELECT account_id, sum_minutes, sum_events, avg_nps_rating, count_active_days, count_feature_clicking_visitors, count_active_months FROM pendo__account', conn)
trend = trend.merge(accounts, on='account_id', how='left')
# Compute correlations
print('Correlation with minutes_growth:')
for col in ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors', 'count_active_months']:
    corr = trend[col].corr(trend['minutes_growth'])
    print(f'{col}: {corr:.3f}')
# Also compute correlation with events_growth
print('Correlation with events_growth:')
for col in ['sum_minutes', 'sum_events', 'avg_nps_rating', 'count_active_days', 'count_feature_clicking_visitors', 'count_active_months']:
    corr = trend[col].corr(trend['events_growth'])
    print(f'{col}: {corr:.3f}')
''')
