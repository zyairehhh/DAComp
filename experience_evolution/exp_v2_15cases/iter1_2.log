We need to compute conversion rates between stages: conditional probability from demo booked to trial activated. Since conversations are independent, we need to link conversations per contact over time. Let's attempt to do a cohort analysis per contact: for each contact, find the sequence of conversations and see if a demo conversation leads to a trial activation and then payment.

We'll need to load conversations per contact, order by conversation_created_at, and map stages.

Let's write a script to compute conversion funnel per contact.

Action: CreateFile(filepath='/workspace/funnel.py':
'''
import sqlite3
import pandas as pd
import numpy as np
from collections import defaultdict

db_path = 'dacomp-098.sqlite'
conn = sqlite3.connect(db_path)

# Load conversations with contact_id and timestamps
query = """
SELECT 
    ce.conversation_id,
    ce.conversation_created_at,
    ce.conversation_initiated_type,
    ce.all_conversation_tags,
    ce.all_conversation_contacts as contact_id
FROM intercom__conversation_enhanced ce
ORDER BY contact_id, conversation_created_at
"""
df = pd.read_sql_query(query, conn)

def parse_tags(tag_str):
    if not tag_str:
        return {}
    tags = {}
    for pair in tag_str.split('|'):
        if ':' in pair:
            key, value = pair.split(':', 1)
            tags[key.strip()] = value.strip()
    return tags

df['tags_dict'] = df['all_conversation_tags'].apply(parse_tags)
df['stage'] = df['tags_dict'].apply(lambda d: d.get('stage', ''))
df['path'] = df['tags_dict'].apply(lambda d: d.get('path', ''))

print(f"Total conversations: {df.shape[0]}")
print(f"Unique contacts: {df['contact_id'].nunique()}")

# Group by contact
contact_sequences = defaultdict(list)
for row in df.itertuples():
    contact_sequences[row.contact_id].append((row.conversation_created_at, row.stage, row.conversation_initiated_type, row.path))

# Compute funnel per contact
funnel_data = []
for contact, convs in contact_sequences.items():
    convs_sorted = sorted(convs, key=lambda x: x[0])
    stages = [c[1] for c in convs_sorted]
    path = convs_sorted[0][3] if convs_sorted else ''
    init_type = convs_sorted[0][2] if convs_sorted else ''
    # Determine if contact ever reached demo_booked, trial_activated, closed_won
    demo_booked = 'demo_booked' in stages
    trial_activated = 'trial_activated' in stages
    closed_won = 'closed_won' in stages
    # Determine which stage was first, second etc.
    # We'll compute whether after demo booked, they activated trial
    # Find index of demo_booked
    if demo_booked:
        demo_idx = stages.index('demo_booked')
        after_demo = stages[demo_idx+1:] if demo_idx+1 < len(stages) else []
        trial_after_demo = 'trial_activated' in after_demo
    else:
        trial_after_demo = False
    if trial_activated:
        trial_idx = stages.index('trial_activated')
        after_trial = stages[trial_idx+1:] if trial_idx+1 < len(stages) else []
        won_after_trial = 'closed_won' in after_trial
    else:
        won_after_trial = False
    funnel_data.append({
        'contact_id': contact,
        'path': path,
        'init_type': init_type,
        'demo_booked': demo_booked,
