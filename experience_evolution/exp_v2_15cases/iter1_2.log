import sqlite3
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler

# Load high-volatility merged data (from earlier)
df = pd.read_csv('high_vol_merged.csv')
print(f"Rows: {df.shape[0]}")

# Define risk components
# 1. Volatility component: cv_gross_profit, var_qoq_growth (higher is riskier)
# 2. Payment behavior: payment_timeliness_score (higher is better), overdue_count_12m (higher is riskier), avg_payment_days_12m (higher is riskier)
# 3. Credit score: credit_score (higher is better)
# 4. Risk assessment categorical: map to numeric

# Clean missing values
df['cv_gross_profit'] = df['cv_gross_profit'].fillna(df['cv_gross_profit'].median())
df['var_qoq_growth'] = df['var_qoq_growth'].fillna(df['var_qoq_growth'].median())
df['credit_score'] = df['credit_score'].fillna(df['credit_score'].median())
df['payment_timeliness_score'] = df['payment_timeliness_score'].fillna(df['payment_timeliness_score'].median())
df['overdue_count_12m'] = df['overdue_count_12m'].fillna(0)
df['avg_payment_days_12m'] = df['avg_payment_days_12m'].fillna(df['avg_payment_days_12m'].median())

# Map risk_assessment to numeric (lower is better?)
risk_map = {'Low': 1, 'Medium': 2, 'High': 3}
df['risk_assessment_num'] = df['risk_assessment'].map(risk_map)
df['risk_assessment_num'] = df['risk_assessment_num'].fillna(2)

# Define normalized risk indicators (higher = riskier)
# For each variable, we will scale and assign direction.

# Scaling using StandardScaler (z-score)
scaler = StandardScaler()
# Variables where higher value means higher risk
risk_vars = ['cv_gross_profit', 'var_qoq_growth', 'overdue_count_12m', 'avg_payment_days_12m', 'risk_assessment_num']
# Variables where lower value means higher risk (reverse sign)
safety_vars = ['credit_score', 'payment_timeliness_score']

# Create scaled df
scaled = pd.DataFrame(scaler.fit_transform(df[risk_vars]), columns=[f'{v}_scaled' for v in risk_vars])
for v in safety_vars:
    # Reverse scaling so higher is riskier
    scaled[f'{v}_scaled'] = -scaler.fit_transform(df[[v]])  # negative sign

# Combine into overall risk score (simple average)
risk_components = [f'{v}_scaled' for v in risk_vars + safety_vars]
df[risk_components] = scaled
df['overall_risk_score'] = df[risk_components].mean(axis=1)

# Normalize overall risk score to 0-100 (percentile rank)
df['risk_percentile'] = df['overall_risk_score'].rank(pct=True) * 100

# Assign risk tiers
def risk_tier(p):
    if p >= 75:
        return 'High'
    elif p >= 25:
        return 'Medium'
    else:
        return 'Low'
df['risk_tier'] = df['risk_percentile'].apply(risk_tier)

print("Risk tier distribution:")
print(df['risk_tier'].value_counts())

# Show correlation between volatility metrics and risk tier
print("\nAverage cv_gross_profit by risk tier:")
print(df.groupby('risk_tier')['cv_gross_profit'].mean())
print("\nAverage var_qoq_growth by risk tier:")
print(df.groupby('risk_tier')['var_qoq_growth'].mean())

# Save risk ratings
df.to_csv('customer_risk_ratings.csv', index=False)
print("\nRisk ratings saved.")

# Propose management strategies per risk tier
print("\n--- Proposed Management Strategies ---")
print("High Risk Tier (top 25%):")
print("- Increase monitoring frequency")
print("- Require advance payments or shorter payment terms")
print("- Limit credit exposure")
print("- Personalized outreach to understand volatility causes")
print("\nMedium Risk Tier (25%-75%):")
print("- Standard monitoring")
print("- Consider moderate credit limits")
print("- Encourage loyalty programs to stabilize revenue")
print("\nLow Risk Tier (bottom 25%):")
print("- Maintain current favorable terms")
print("- Upsell and cross-sell opportunities")
print("- Recognize as strategic partners")
```
